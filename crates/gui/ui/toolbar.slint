import { Button, HorizontalBox, Slider } from "std-widgets.slint";
import { GlobalAppState } from "state.slint";
import { VerticalDivider } from "components/divider.slint";
import { ToolToggleButton } from "components/toggle_button.slint";
import { Theme, Appearance } from "style.slint";
import { ViewportState } from "editor/viewport_state.slint";
import { DialogType } from "state.slint";
import {
    ViewportObjectState,
    ToolState,
} from "editor/viewport_state.slint";
import { PipelinesPanelState } from "editor/pipelines_panel.slint";
import { ObjectListState } from "editor/object_list_panel.slint";
import { AiLearningState } from "dialogs/ai_learning_dialog.slint";

// Define the enum


export global ToolbarState {
    callback open_file_clicked();
    callback new_from_project_template_clicked();
    callback save_file_clicked();
    callback save_as_file_clicked();
    callback save_project_as_template_clicked();
    callback open_website();
    callback undo_clicked();
    callback redo_clicked();
    in-out property <bool> has_unsaved_changes: false;
    in-out property <bool> can_undo: false;
    in-out property <bool> can_redo: false;
}

export component Toolbar inherits Rectangle {
    height: 48px;
    background: Theme.bg;

    HorizontalLayout {
        padding-top: 5px;
        padding-left: 4px;
        padding-right: 8px;
        padding-bottom: 5px;
        spacing: 2px;

        ToolToggleButton {
            icon: @image-url("icons/regular-black/folder-open.svg");
            clicked => {
                ToolbarState.open_file_clicked();
            }
        }

        Rectangle {
            width: 36px;
            height: 36px;
            ToolToggleButton {
                icon: @image-url("icons/regular-black/floppy-disk.svg");
                clicked => {
                    ToolbarState.save_file_clicked();
                }
            }

            if ToolbarState.has_unsaved_changes: Rectangle {
                x: parent.width - 8px;
                y: 2px;
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: Theme.err;
            }
        }

        VerticalDivider { }

        ToolToggleButton {
            icon: @image-url("icons/regular-black/arrow-counter-clockwise.svg");
            enabled: ToolbarState.can_undo;
            clicked => {
                ToolbarState.undo_clicked();
            }
        }

        ToolToggleButton {
            icon: @image-url("icons/regular-black/arrow-clockwise.svg");
            enabled: ToolbarState.can_redo;
            clicked => {
                ToolbarState.redo_clicked();
            }
        }

        VerticalDivider { }

        ToolToggleButton {
            icon: @image-url("icons/regular-white/eye.svg");
            clicked => {
                PipelinesPanelState.dry-run();
            }
        }

        ToolToggleButton {
            icon: @image-url("icons/regular-black/person-simple-run.svg");
            clicked => {
                PipelinesPanelState.run-all();
            }
        }

        VerticalDivider { }

        ToolToggleButton {
            icon: @image-url("icons/regular-black/brain.svg");
            clicked => {
                AiLearningState.open_requested();
            }
        }

        ToolToggleButton {
            icon: @image-url("icons/regular-black/gear.svg");
            clicked => {
                GlobalAppState.active_dialog = DialogType.project_settings;
            }
        }

        VerticalDivider { }

        ToolToggleButton {
            icon: @image-url("icons/regular-black/hand.svg");
            checked: ViewportObjectState.act_tool_state == ToolState.Move;
            clicked => {
                ViewportObjectState.act_tool_state = ToolState.Move;
            }
        }

        ToolToggleButton {
            icon: @image-url("icons/regular-black/cursor.svg");
            checked: ViewportObjectState.act_tool_state == ToolState.Select;
            clicked => {
                ViewportObjectState.act_tool_state = ToolState.Select;
            }
        }

        ToolToggleButton {
            icon: @image-url("icons/regular-black/crosshair.svg");
            checked: ViewportObjectState.act_tool_state == ToolState.PaintMarker;
            clicked => {
                ViewportObjectState.act_tool_state = ToolState.PaintMarker;
            }
        }

        VerticalDivider { }

        ToolToggleButton {
            icon: @image-url("icons/regular-red/rectangle.svg");
            checked: ViewportObjectState.act_tool_state == ToolState.PaintRectangle;
            clicked => {
                ViewportObjectState.act_tool_state = ToolState.PaintRectangle;
            }
        }

        ToolToggleButton {
            icon: @image-url("icons/regular-red/circle.svg");
            checked: ViewportObjectState.act_tool_state == ToolState.PaintOval;
            clicked => {
                ViewportObjectState.act_tool_state = ToolState.PaintOval;
            }
        }

        ToolToggleButton {
            icon: @image-url("icons/regular-red/polygon.svg");
            checked: ViewportObjectState.act_tool_state == ToolState.PaintPolygon;
            clicked => {
                ViewportObjectState.act_tool_state = ToolState.PaintPolygon;
            }
        }

        VerticalDivider { }

        ToolToggleButton {
            icon: @image-url("icons/regular-black/sliders-horizontal.svg");
            checked: GlobalAppState.show_image_tools;
            clicked => {
                GlobalAppState.show_image_tools = !GlobalAppState.show_image_tools;
            }
        }

        ToolToggleButton {
            icon: @image-url("icons/regular-black/paint-bucket.svg");
            checked: ViewportObjectState.show_objects;
            clicked => {
                ViewportObjectState.show_objects = !ViewportObjectState.show_objects;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Slider {
            width: 150px;
            minimum: 0.0;
            maximum: 0.8;
            value: ViewportObjectState.object_transparency;
            changed(val) => {
                ViewportObjectState.object_transparency = val;
                ViewportObjectState.object_transparency_changed(ViewportObjectState.object_transparency);
            }
        }

        Text {
            text: "Zoom: \{round(ViewportState.zoom_factor * 100)}%";
            vertical-alignment: center;
            font-size: 14px;
        }

        VerticalDivider { }

        ToolToggleButton {
            icon: Theme.dark-mode ? @image-url("icons/regular-black/sun.svg") : @image-url("icons/regular-black/moon.svg");
            checked: Theme.dark-mode;
            clicked => {
                // Read `Theme.dark-mode` before either call - `apply()` flips
                // `Palette.color-scheme`, which `Theme.dark-mode` is bound to,
                // so evaluating `!Theme.dark-mode` again afterwards would
                // double-negate and report the stale, pre-click value.
                Appearance.dark-mode-toggled(!Theme.dark-mode);
                Appearance.apply(!Theme.dark-mode);
            }
        }
    }
}
