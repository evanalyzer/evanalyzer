// api/quick_export.slint — Results › Export…: the view shown as it is now,
// written once (table format 1), or added to the project's exports
// (design canvas "Quick export, open folder, run on", board 1 A, board 2).

export global QuickExportState {
    in property <bool> shown;
    // The view's name and what it shows: "a row per image · 22 columns · 3
    // classes · mean".
    in property <string> view-name;
    in property <string> what;
    // A table (CSV / XLSX); a plate layout is XLSX only.
    in property <bool> table;
    in-out property <int> format;
    in-out property <string> folder;
    // A name in front of the automatic file name ("" the automatic one).
    in-out property <string> file;
    in property <string> file-placeholder;

    // -- Written: the done step --
    in property <bool> done;
    // "Written: images.csv" / "Written: 3 files".
    in property <string> done-text;
    // Where: the file (one) or the folder.
    in property <string> done-path;
    // The folder is on this computer (not on a server): it can be opened.
    in property <bool> can-open-folder;

    in property <bool> busy;
    // What went wrong ("" nothing).
    in property <string> error;

    // Export… on the view shown (`open(-1)`, else the view's id).
    callback open(int);
    // A view's ⋯ › Save as export…: kept as a new export, opened in the
    // Exports tab.
    callback save-view(int);
    callback choose-folder();
    callback export();
    // Adds the view to the project's exports as a new export - nothing
    // written now; closes with a note.
    callback add-to-project();
    // The done step: the folder written into, in the file manager.
    callback open-folder();
    callback cancel();
}
