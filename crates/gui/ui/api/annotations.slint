// api/annotations.slint — the Rust interface of the manual-annotation
// actions: copying pipeline (preview) objects into the manual annotations
// (training data), deleting manual annotations in bulk, GeoJSON export and
// import.

// A class in the annotation dialogs: how many objects have it, whether it
// is ticked. id -1: objects without a class.
export struct AnnotationClassRow {
    id: int,
    name: string,
    color: color,
    count: int,
    checked: bool,
}

// A class name found in a file being imported, and where its shapes go.
export struct ImportClassRow {
    // "" - shapes without a class.
    name: string,
    count: int,
    color: color,
    target: int,
}

export global AnnotationState {
    // -- Copy pipeline objects as annotations (dialogs/copy_to_manual_dialog) --

    // The dialog for one pipeline object (row id as in ObjectListState):
    // `copy-single` set to it, `pipeline-classes` its classes.
    callback open-copy-dialog-for(int);
    // The dialog for all of the open image's pipeline objects:
    // `pipeline-classes` their classes (ticked), `copy-single` -1.
    callback open-copy-dialog();
    in-out property <[AnnotationClassRow]> pipeline-classes;
    // The one object the dialog copies (row id), -1: the ticked classes'.
    in-out property <int> copy-single: -1;
    // Copies (the one object, or the preview objects of the ticked
    // classes). target-class: the class the copies get, -1 their own. One
    // object's copy is selected then.
    callback copy-all-to-manual(int);

    // -- Delete manual annotations (dialogs/delete_manual_dialog) --

    // Fills `manual-classes` and `delete-summary`, then the dialog shows.
    callback open-delete-dialog();
    in-out property <[AnnotationClassRow]> manual-classes;
    // Ticks or scope changed: Rust updates `delete-summary`.
    callback delete-selection-changed(bool /* all images */);
    // "312 annotations on 14 images" - what Delete would delete.
    in property <string> delete-summary;
    in property <int> delete-count;
    // Deletes the manual annotations of the ticked classes, on the open
    // image (false) or all images (true).
    callback delete-manual(bool);

    // -- GeoJSON: the open image's annotations, to a file and back (from
    // EVAnalyzer or another tool) --

    // The open image's name, for the dialogs.
    in property <string> geojson-image;
    // Fills `export-classes` (the open image's manual annotations by class,
    // ticked), then the export dialog shows.
    callback open-export-dialog();
    in-out property <[AnnotationClassRow]> export-classes;
    // Asks where to save (a file name of the user's choosing), writes the
    // annotations of the ticked classes.
    callback export-geojson();

    // Asks for a .geojson file and reads it; then `import-file`,
    // `import-classes` and `import-shapes` are set and the import dialog
    // shows.
    callback pick-import-file();
    in property <string> import-file;
    in property <int> import-shapes;
    // Each class name found in the file and where it goes: `target` an index
    // into `import-targets` (0 a new class, 1 no class, 2 not imported, 3 + k
    // the project's class k).
    in-out property <[ImportClassRow]> import-classes;
    in property <[string]> import-targets;
    // The targets' colors (the project classes'; transparent for the first
    // three).
    in property <[color]> import-target-colors;
    // Measures the read shapes on the image and adds them to its manual
    // annotations - or replaces those (true).
    callback apply-import(bool);

    // Measures every manual annotation again on its image (all channels,
    // full resolution), in the background.
    callback remeasure();
}
