// api/ai_learning.slint — the Rust interface of dialogs/ai_learning_dialog.slint: the state Rust
// sets, the callbacks it answers.


// An image channel the pixel classifier may read (a chip above the
// feature table).
export struct ChannelChipSlint {
    name: string,
    color: color,
    selected: bool,
}

// A row of the pixel feature table: what it sees × the size columns
// (`AiLearningState.feature_sizes`). Built and changed by Rust - every
// click goes through a callback.
export struct FeatureGridRowSlint {
    label: string,
    hint: string,
    // Brightness only: an "as is" column (the raw pixel value).
    has_raw: bool,
    raw: bool,
    cells: [bool],
    // The row's choices (e.g. "median", "mean"); empty: none.
    options: [string],
    option: int,
}

// A checkbox in a list (shape metrics).
export struct ToggleRowSlint {
    label: string,
    selected: bool,
}

// A row of the brightness table: a statistic × the channels.
export struct BrightnessRowSlint {
    label: string,
    hint: string,
    cells: [bool],
}

export struct TrainingImageRowSlint {
    name: string,
    path: string,
    selected: bool,
    annotated_object_count: int,
}

// One manually-annotated (painted) object available as a training sample.
// `assigned_class_index` is an index into `AiLearningState.class_names`;
// -1 means unlabeled - unlabeled rows are excluded from training.
export struct TrainingObjectRowSlint {
    object_id: int,
    label: string,
    assigned_class_index: int,
    // Which project image this object belongs to, so assigning a class can
    // locate the right object even when training from multiple images.
    image_path: string,
    // Excludes this object from training even though it has a class
    // assigned (e.g. a bad/outlier annotation) - the label itself is kept,
    // only its use as a training sample is skipped. Persists on the
    // project's `ObjectMetricSettings::exclude_from_training`.
    excluded: bool,
}

// One of the project's classification classes, offered as a checkbox for
// which classes become prediction targets - shared by both pixel- and
// object-classifier training (`class_labels` is a deliberate user selection,
// not purely inferred from which classes happen to have data - see
// `pixel_class_labels_from_project`'s/`object_class_labels_from_project`'s
// doc comments). Pre-checked by default for classes with at least one
// labeled object (`sync_class_selection_to_slint`), but not restricted to
// them - a class can be selected ahead of labeling it.
export struct ClassSelectionRowSlint {
    class_index: int, // index into AiLearningState.class_names
    name: string,
    selected: bool,
    color: color,
    // Hand-drawn objects of this class, in all images.
    count: int,
}

export struct AiTrainingSettingsSlint {
    // 0 = Pixel Classifier, 1 = Object Classifier
    mode: int,
    // 0 = Random Forest, 1 = K-Nearest Neighbors, 2 = Neural Network (MLP)
    algorithm: int,
    model_name: string,
    // Non-empty once an existing model has been loaded for retraining.
    loaded_model_path: string,

    // -- Random Forest --
    rf_n_trees: int,
    rf_max_depth: int, // 0 = unlimited
    rf_min_samples_split: int,
    rf_min_samples_leaf: int,
    rf_criterion: int, // 0 = Gini, 1 = Entropy
    rf_max_features: int, // 0 = auto (sqrt of feature count)
    rf_seed: int,
    rf_out_of_bag_eval: bool,

    // -- K-Nearest Neighbors --
    knn_k: int,
    knn_distance: int, // 0 = Euclidean, 1 = Manhattan, 2 = Minkowski, 3 = Cosine, 4 = Hamming
    knn_minkowski_p: int, // order of the Minkowski norm - only shown/used when knn_distance == 2
    knn_search_algorithm: int, // 0 = Linear Search, 1 = Cover Tree
    knn_weight: int, // 0 = Uniform, 1 = Distance-weighted

    // -- Neural Network (MLP) --
    mlp_hidden_layers: string, // comma-separated node counts, e.g. "64, 32"
    mlp_activation: int, // 0 = ReLU, 1 = Sigmoid, 2 = Tanh
    mlp_max_iterations: int,
    mlp_epsilon: float, // convergence tolerance
    mlp_learning_rate: float,
    mlp_batch_size: int,
    mlp_seed: int,

    // -- Shared training options --
    // Off for Random Forest (scale-insensitive); should default on for KNN/MLP.
    normalize_features: bool,
    balance_classes: bool,
    validation_split: float, // fraction (0..1) held out to report accuracy

    // -- Training data source --
    use_other_images: bool,
}

export global AiLearningState {
    in-out property <AiTrainingSettingsSlint> settings: {
        mode: 0,
        algorithm: 0,
        model_name: "",
        loaded_model_path: "",
        // 50 trees capped at depth 20: enough for good pixel/object-classifier
        // accuracy without the runtime blowing up at inference time - a deep,
        // unbounded forest classifies fast to train (a handful of thousand
        // labeled pixels/objects) but scales tree-walk cost with both tree
        // count and depth at *prediction* time, which for a pixel classifier
        // means every pixel of every image, not just the training set.
        rf_n_trees: 50,
        rf_max_depth: 20,
        rf_min_samples_split: 2,
        rf_min_samples_leaf: 1,
        rf_criterion: 0,
        rf_max_features: 0,
        rf_seed: 0,
        rf_out_of_bag_eval: true,
        // k=5 (odd, avoids ties) with distance weighting: microscopy features
        // are noisy enough that a slightly larger, distance-weighted
        // neighborhood gives steadier decision boundaries than k=3 uniform.
        knn_k: 5,
        knn_distance: 0,
        knn_minkowski_p: 3,
        knn_search_algorithm: 1,
        knn_weight: 1,
        mlp_hidden_layers: "64, 32",
        mlp_activation: 0,
        mlp_max_iterations: 200,
        mlp_epsilon: 0.001,
        // Adam's own recommended default - 0.01 (the previous default) is on
        // the high side for Adam and risks unstable/oscillating convergence,
        // especially with full-batch gradient steps.
        mlp_learning_rate: 0.001,
        mlp_batch_size: 32,
        mlp_seed: 0,
        normalize_features: true,
        balance_classes: true,
        validation_split: 0.2,
        use_other_images: false,
    };

    // -- Features (built by Rust; changed through the callbacks below) --
    // The image channels the pixel classifier reads (several: features of
    // each). Z-stack handling isn't set here - training uses the project's.
    in property <[ChannelChipSlint]> pixel_channels: [];
    // The size columns, as headers ("1", "2", ...).
    in property <[string]> feature_sizes: [];
    in property <[FeatureGridRowSlint]> feature_grid: [];
    // 0 Simple, 1 Recommended, 2 All, -1 none (edited by hand).
    in property <int> pixel_preset: 1;
    in property <[ToggleRowSlint]> shape_metrics: [];
    in property <[BrightnessRowSlint]> brightness_rows: [];
    // 0 Shape only, 1 Recommended, 2 All, -1 none.
    in property <int> object_preset: 1;
    // "10 × 2 ch = 20", "16" - the features the model gets.
    in property <string> feature_count: "";
    // "0 DAPI · 1 FITC · ..." - under the brightness table when its
    // columns are too narrow for the names (they show the numbers then).
    in property <string> channel_legend: "";

    // -- What the panel tells about the examples (Rust) --
    // "This image + 2 more · 94"
    in property <string> examples_summary: "";
    // The footer's hint: 0 not yet (Train off), 1 trains but weak, 2 ready.
    in property <string> readiness_text: "";
    in property <int> readiness_tone: 0;

    in-out property <[TrainingImageRowSlint]> training_images: [];
    in-out property <[TrainingObjectRowSlint]> training_objects: [];
    // Which project classes to train on - see `ClassSelectionRowSlint`'s doc
    // comment. Shared by both pixel- and object-classifier training.
    in-out property <[ClassSelectionRowSlint]> class_selection: [];
    // Images with hand-drawn objects of a class - what training learns from.
    in property <int> annotated-image-count: 0;
    // Project's ObjectClass names, used as the label picker's options for
    // each training object row.
    in property <[string]> class_names: [];
    // Project's image channel names (the brightness table's columns).
    in property <[string]> channel_names: [];

    // Set by Rust for pre-flight check failures (e.g. no model name, no
    // labeled data) and for training progress/results - shown as an inline
    // banner instead of routing through the app-wide warning dialog, which
    // would replace this dialog entirely (hiding it, since only one dialog
    // can be active at a time) and lose the user's in-progress settings.
    // The dialog is never closed automatically, including when training
    // finishes, so the user can see the result and immediately retrain.
    // Empty message = no banner to show. Cleared on every `open_requested`
    // so a stale message never lingers into the next session.
    in-out property <string> training_status: "";
    in-out property <bool> training_status_is_error: false;
    // True from the moment `train_clicked` is handled until the background
    // job's `Finished`/cancelled/failed result comes back - drives disabling
    // the Train button, showing the Cancel button, and the banner's
    // in-progress color (see `training_status_is_error`'s sibling coloring
    // below). Reset by Rust on every terminal outcome, not just success.
    in-out property <bool> training_in_progress: false;
    // The model just trained isn't applied by any step yet: the result
    // offers "Add to pipeline".
    in property <bool> can_add_to_pipeline: false;

    // Fired by the toolbar button, before the dialog is shown, so Rust can
    // refresh class_names/object_metrics/training_images/training_objects
    // from the current project rather than showing stale data from the
    // last time the dialog was open.
    callback open_requested();
    // Fired by Rust whenever objects, classes or the image's channels change
    // (drawing, class edits, another image, ...): while the dialog is open it
    // refreshes its lists, keeping what the user ticked.
    callback project_changed();
    callback cancel_clicked();
    // Distinct from `cancel_clicked` (fired by the Close button, which just
    // hides the dialog) - this asks Rust to actually stop the in-flight
    // training job via its `Arc<AtomicBool>` cancel flag, same mechanism the
    // pipeline-run dialog's Cancel button uses.
    callback cancel_training_clicked();
    callback browse_existing_model_clicked();
    callback add_to_pipeline_clicked();
    callback toggle_pixel_channel(int);
    callback toggle_feature_cell(int, int); // (row, size column; -1: as is)
    callback set_feature_option(int, int); // (row, option)
    callback apply_pixel_preset(int);
    callback add_feature_size(string);
    callback remove_feature_size(int); // size column
    callback toggle_shape_metric(int);
    callback toggle_brightness_cell(int, int); // (statistic, channel)
    callback toggle_brightness_row(int);
    callback toggle_brightness_column(int);
    callback apply_object_preset(int);
    // A class ticked or unticked: the readiness hint follows.
    callback class_selection_changed();
    callback toggle_image_selected(int);
    callback assign_object_class(int, int); // (training_objects index, class_names index)
    callback toggle_object_excluded(int); // training_objects index
    // The features come from the tables above (Rust has them).
    callback train_clicked(AiTrainingSettingsSlint, [ClassSelectionRowSlint]);

    public function trigger_train() {
        train_clicked(root.settings, root.class_selection);
    }
}
