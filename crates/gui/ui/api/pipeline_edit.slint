// api/pipeline_edit.slint — the Rust interface of dialogs/pipeline_edit_dialog.slint: the state Rust
// sets, the callbacks it answers.

export global PipelineEditState {
    in property <int> pipeline-id: 0;
    in-out property <string> pipeline-name: "";
    // 0 = Scratchpad · 1 = Shared memory slot (ProjectCache) · 2 = Channel · 3 = None
    in-out property <int> source-type: 0;
    in-out property <int> source-slot: 1;
    in-out property <int> source-channel: 0;
    callback confirm();
    callback cancel();
}

export global PipelineDeleteConfirmState {
    in property <int> pipeline-id: 0;
    in property <string> pipeline-name: "";
    callback confirm();
    callback cancel();
}
