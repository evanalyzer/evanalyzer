// api/shortcuts.slint — the Rust interface of shortcuts.slint: the state Rust
// sets, the callbacks it answers.

import { Pipeline } from "pipelines.slint";

export struct ShortcutRow {
    combo: string,
    label: string,
}

export struct ShortcutSection {
    title: string,
    rows: [ShortcutRow],
}

export global ShortcutsDoc {
    out property <[ShortcutSection]> sections: [
        {
            title: "File",
            rows: [
                { combo: "Ctrl+S", label: "Save" },
                { combo: "Ctrl+Shift+S", label: "Save As" },
                { combo: "Ctrl+O", label: "Open" },
                { combo: "Ctrl+Shift+O", label: "Open an images folder" },
            ],
        },
        {
            title: "Edit",
            rows: [
                { combo: "Ctrl+Z", label: "Undo" },
                { combo: "Ctrl+Y / Ctrl+Shift+Z", label: "Redo" },
                { combo: "Delete", label: "Delete the selected object/ROI" },
            ],
        },
        {
            title: "Pipeline",
            rows: [
                { combo: "F5", label: "Refresh the preview" },
                { combo: "Shift+F5", label: "Preview the whole image, not just what is in view" },
                { combo: "F", label: "Focus on the selected pipeline (again: show all)" },
                { combo: "Alt+click", label: "Focus on a pipeline (again: show all)" },
                { combo: "Double-click", label: "Edit a pipeline's name and image source" },
                { combo: "Enter", label: "The selected step's settings" },
                { combo: "Ctrl+/", label: "Disable / enable the selected step" },
                { combo: "F9", label: "Breakpoint on the selected step" },
                { combo: "Ctrl+D", label: "Duplicate the selected step" },
                { combo: "Alt+↑ / Alt+↓", label: "Move the selected step" },
                { combo: "Delete", label: "Remove the selected step (no object selected)" },
            ],
        },
        {
            title: "Canvas tools",
            rows: [
                { combo: "M/Escape", label: "Move" },
                { combo: "S", label: "Select" },
                { combo: "K", label: "Paint marker" },
                { combo: "R", label: "Paint rectangle" },
                { combo: "E", label: "Paint ellipse" },
                { combo: "P", label: "Paint polygon" },
                { combo: "O", label: "Show / hide the objects" },
                { combo: "A", label: "Show / hide the annotate tool bar" },
            ],
        },
        {
            title: "Z stack and time series",
            rows: [
                { combo: "Page Up / Page Down", label: "The previous / next Z slice" },
                { combo: ", / .", label: "The previous / next frame" },
            ],
        },
        {
            title: "Navigation",
            rows: [
                { combo: "Ctrl+K", label: "Command palette: find an action, a step, a command" },
                { combo: "Ctrl+1", label: "Images" },
                { combo: "Ctrl+2", label: "Pipelines" },
                { combo: "Ctrl+3", label: "Results" },
                { combo: "Ctrl+F", label: "Jump to the image search field" },
                { combo: "Tab", label: "Hide / show all panels (nothing focused)" },
                { combo: "Alt+1…4", label: "Show / hide Steps, Classes, Image, Objects" },
            ],
        },
        {
            title: "Results, split with the image",
            rows: [
                { combo: "↑ / ↓", label: "The previous / next object" },
                { combo: "Escape", label: "Clear the selected object" },
            ],
        },
        {
            title: "Dialogs",
            rows: [
                { combo: "Escape", label: "Close the open dialog" },
                { combo: "F1", label: "Show this help" },
            ],
        },
    ];
}
