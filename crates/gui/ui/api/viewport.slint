// api/viewport.slint — the Rust interface of editor/viewport_state.slint: the state Rust
// sets, the callbacks it answers.

export enum ToolState {
    Move,
    Select,
    PaintRectangle,
    PaintOval,
    PaintPolygon,
    PaintMarker,
    // Paints a new object / erases pixels of the hand-drawn objects, along
    // the dragged stroke (`ViewportObjectState.brush-stroke`).
    Brush,
    Eraser,
}

export struct MarkerData {
    image-x: float,
    image-y: float,
    label: string,
}

// Bounding box (in image pixel coordinates) of an object to highlight in the
// viewport, e.g. when its row is selected in the results table.
export struct ObjectHighlightBox {
    x-px: float,
    y-px: float,
    w-px: float,
    h-px: float,
    active: bool,
    paint-as-rectangle: bool,
}

// An earlier high-res render kept for smoother pan/zoom - see
// `ViewportState.retained_tiles`. Rectangle in full-resolution image pixels.
export struct RetainedTile {
    image: image,
    img-x: float,
    img-y: float,
    img-w: float,
    img-h: float,
    zoom: float,
    generation: int,
    seq: int,
    bytes: int,
}

//
// Viewport
//
export global ViewportState {
    in-out property <length> offset_x: 0;
    in-out property <length> offset_y: 0;

    // Where each layer's buffer lies, in full-resolution image pixels. The
    // viewport places the layers with the live zoom/offset below, so panning
    // and zooming move the textures already on screen at display rate -
    // the workers only re-render once the gesture settles.
    in-out property <float> ghost_img_x: 0;
    in-out property <float> ghost_img_y: 0;
    in-out property <float> ghost_img_w: 0;
    in-out property <float> ghost_img_h: 0;

    in-out property <float> hr_img_x: 0;
    in-out property <float> hr_img_y: 0;
    in-out property <float> hr_img_w: 0;
    in-out property <float> hr_img_h: 0;
    // Zoom and content generation the current high-res buffer was rendered
    // with - what decides whether it may join `retained_tiles` once the next
    // one replaces it.
    in-out property <float> hr_zoom: 0;
    in-out property <int> hr_generation: 0;

    in-out property <float> obj_img_x: 0;
    in-out property <float> obj_img_y: 0;
    in-out property <float> obj_img_w: 0;
    in-out property <float> obj_img_h: 0;

    // Earlier high-res renders of the current content, drawn between the
    // overview and the current render (sharpest on top). Empty unless the
    // tile history is enabled in the viewport memory settings.
    in-out property <[RetainedTile]> retained_tiles: [];

    // Layers whose screen rectangle reaches past this are hidden. Unlimited
    // except with the software renderer (Windows), which stores scene
    // coordinates as i16 and misplaces anything beyond.
    in-out property <length> max_layer_extent: 1000000px;

    in-out property <bool> high_res_ready: true;
    in-out property <bool> object_ready: false;

    in-out property <float> zoom_factor: 1.0;
    callback report_viewport_size(float, float);
    callback report_viewport_moved(float, float);
    callback report_viewport_zoomed(float, float, float);
    callback report_mouse_moved(length, length);

    // Scale bar
    in-out property <length> scale_bar_width;
    in-out property <string> scale_bar_text;

    // Navigator
    in-out property <float> nav_x: 0;
    in-out property <float> nav_y: 0;
    in-out property <float> nav_width: 0;
    in-out property <float> nav_height: 0;
}

export struct PointSlint {
    x: length,
    y: length,
}

export global ViewportObjectState {
    callback object_paint_finished([PointSlint], ToolState, int);
    // A point of a brush or eraser stroke, in viewport coordinates: phase 0
    // the press, 1 a move, 2 the release (Rust paints or erases then).
    callback brush-stroke(length, length, int);
    // The stroke so far as path commands, drawn while dragging.
    in-out property <string> brush-path;
    callback object_transparency_changed(float);
    callback viewport_clicked(length, length);
    callback marker-placed(length, length);
    callback marker-remove-at(length, length);

    in-out property <[MarkerData]> markers: [];
    in-out property <ObjectHighlightBox> object_highlight: { active: false };
    // Before / after: the image without the preview's objects (left of
    // `compare-at`, a fraction of the width) and with them (right).
    in-out property <bool> compare: false;
    in-out property <float> compare-at: 0.5;
    // Space held: the whole image without them.
    in-out property <bool> show-before: false;
    in-out property <ToolState> act_tool_state:  ToolState.Move;
    in-out property <bool> is_drawing: false;
    in-out property <int> poly_idx:0;
    in-out property <float> object_transparency: 0.8;
    in-out property <bool> show_objects: true;
    in-out property <[PointSlint]> polygon_points: [
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
        { x: 0px, y: 0px },
    ];

    // Switching tools mid-draw (e.g. clicking a different paint tool before
    // finishing a rectangle) must abandon the in-progress shape - otherwise
    // the next click on any paint tool finalizes an object from the stale
    // `polygon_points`/`poly_idx` left over from the abandoned one.
    changed act_tool_state => {
        self.is_drawing = false;
        self.poly_idx = 0;
    }
}
