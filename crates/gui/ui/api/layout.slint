// api/layout.slint — what the window shows: the mode (Images, Pipelines,
// Results) and which panels float over the image. Kept by the views; Rust
// reads or sets it only to show something (and in tests).

export enum WorkspaceMode { images, pipelines, results }

export global LayoutState {
    in-out property <WorkspaceMode> mode: WorkspaceMode.pipelines;

    // -- Panels over the image (Images and Pipelines) --
    // Shown (EVA › View): the left panel (Steps, Images), and in the right
    // column Classes, Image (channels, histogram), Objects.
    in-out property <bool> steps-open: true;
    in-out property <bool> classes-open: true;
    in-out property <bool> image-open: true;
    in-out property <bool> objects-open: true;
    // The Measurements panel (only offered when the project measures).
    in-out property <bool> measurements-open: true;
    /// Folded to their head (a click on the title): Objects then takes the
    /// column's rest.
    in-out property <bool> classes-folded: false;
    in-out property <bool> image-folded: false;
    in-out property <bool> objects-folded: false;
    in-out property <bool> measurements-folded: false;
    /// The navigator: 0 auto (only while zoomed in), 1 always, 2 never.
    in-out property <int> navigator-mode: 0;
    /// The step rows' values on a second line under the name (not
    /// beside it, cut at the row's end).
    in-out property <bool> step-values-below: false;
    /// Tab: every panel away (the Z / T bar and Tuning stay).
    in-out property <bool> panels-hidden: false;
    /// The objects as a wide table at the bottom (design K), not as a list
    /// on the right.
    in-out property <bool> objects-as-table: false;
    /// A panel shown / hidden or folded, the bar folded, the pipelines list
    /// opened: Rust keeps it (per user).
    callback panels-changed();

    /// The bar at the bottom of the image (objects, Z, T) is folded to a
    /// pill.
    in-out property <bool> stack-bar-folded: false;
    /// The Pipelines panel shows the list of pipelines above the steps.
    in-out property <bool> pipelines-list-open: false;

    /// The Tuning panel (the pinned settings) is put away.
    in-out property <bool> tuning-hidden: false;

    /// The images as a plate of wells, not as a list.
    in-out property <bool> images-as-plate: false;


    /// Annotate mode: the tool bar for drawing objects is shown.
    in-out property <bool> annotate: false;
    /// Brush and eraser size, in screen pixels.
    in-out property <int> brush-size: 12;
}

// Where the floating panels are - for the workspace and for the dialogs that
// open beside them (next to the steps, left of the right-hand panels).
export global Places {
    out property <length> gap: 12px;
    out property <length> left-w: 360px;
    out property <length> right-w: 300px;
    // x of a dialog next to the steps panel.
    out property <length> beside-left: self.left-w + 2 * self.gap;
    // Distance from the window's right edge of a dialog left of the
    // right-hand panels.
    out property <length> beside-right: self.right-w + 2 * self.gap;
}
