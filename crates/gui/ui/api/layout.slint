// api/layout.slint — what the window shows: the mode (Images, Pipelines,
// Results) and which panels float over the image. Kept by the views; Rust
// reads or sets it only to show something (and in tests).

export enum WorkspaceMode { images, pipelines, results }

export global LayoutState {
    in-out property <WorkspaceMode> mode: WorkspaceMode.pipelines;

    // -- Panels over the image (Images and Pipelines) --
    in-out property <bool> classes-open: true;
    in-out property <bool> objects-open: false;
    /// The image panel: channels, histogram, Z/T, overlay.
    in-out property <bool> image-open: false;
    /// Pinned: it stays open when another panel opens.
    in-out property <bool> image-pinned: false;

    /// The Tuning panel (the pinned settings) is put away.
    in-out property <bool> tuning-hidden: false;

    /// The images as a plate of wells, not as a list.
    in-out property <bool> images-as-plate: false;

    /// The running analysis' card is put away (the bottom bar still shows
    /// its progress; a click there shows the card again).
    in-out property <bool> analysis-card-hidden: false;

    /// Annotate mode: the tool bar for drawing objects is shown.
    in-out property <bool> annotate: false;
    /// Brush and eraser size, in screen pixels.
    in-out property <int> brush-size: 12;
}
