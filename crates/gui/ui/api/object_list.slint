// api/object_list.slint — the Rust interface of editor/object_list_panel.slint: the state Rust
// sets, the callbacks it answers.

export struct ObjectItemDataSlint {
    id: int,
    name: string,
    display_color: color,
    display_name: string,
    class_names: [string],
    class_colors: [color],
    class_ids: [int],
    label_name: string,
    label_id: int,
    // A manual annotation: its class can be changed, it can be deleted.
    // Pipeline (preview) results are read-only - they can be copied into
    // the manual annotations (AnnotationState.copy-to-manual).
    editable: bool,
    // Metrics (empty string = not available). Every row: area, the mean
    // intensities, circularity - the objects table's columns. Only the
    // selected_object: area_nm2 and the sums.
    area: int,
    area_nm2: string,           // area in nm², formatted
    intensities: [string],      // sum intensity per channel
    intensity_avgs: [string],   // mean intensity per channel
    circularity: string,
    // The classes it colocalizes with and how many of their objects ("CY5
    // · 2, FITC · 1") - the selected object only; "" none.
    coloc-with: string,
    // The objects it belongs to ("Cell, Region") and its children per class
    // ("Spot · 7") - Relate Objects' links; the selected object only.
    parents: string,
    children: string,
    // Count of ROIs sharing the same segmentation label – populated for all rows
    label_count: int,
    // Its bounding box in full-image pixels - where the object card on the
    // image goes.
    bbox-x: float,
    bbox-y: float,
    bbox-w: float,
    bbox-h: float,
}

export global ObjectListState {
    in-out property <bool> is_scanning: false;
    in-out property <int> scroll_to_object_index: -1;
    // Filled by Rust from the open image's objects.
    in property <[ObjectItemDataSlint]> object_list: [];

    in-out property <ObjectItemDataSlint> selected_object;

    // The objects shown: of this class (-1 all) and matching the search
    // ("12" an id, "area > 50", "circ < 0.6", a class name; terms split by
    // commas). `filter-changed` after a change.
    in-out property <int> filter-class: -1;
    // Where they come from: 0 both, 1 the manual annotations, 2 the
    // pipeline's detections.
    in-out property <int> filter-source: 0;
    in-out property <string> filter-text;
    callback filter-changed();
    // Columns of the objects table hidden: "area", "circ", "ch<i>" each
    // between commas (",area,ch2,").
    in-out property <string> hidden-columns: ",";

    callback object_selected(int);
    callback object_delete(int);
    // Params: Adds the given class to the selected object (params are: object id, class id)
    callback object_add_class(int, int);
     // Params: Replaces all classed of the selected object by the given class (params are: object id, class id)
    callback object_replace_class(int, int);
    callback object_remove_class(int, int);
}
