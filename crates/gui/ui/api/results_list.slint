// api/results_list.slint — the Rust interface of editor/results_list_panel.slint: the state Rust
// sets, the callbacks it answers.

// ----------------------------------------------------------
export struct ResultItemData {
    name: string,
    path: string,
    file_size: string,
    modified: string,
}

export global ResultsListState {
    in property <bool> is_scanning: false;
    in-out property <bool> is_loading: false;
    in-out property <int> selected_result_index: -1;
    in property <[ResultItemData]> results_list: [];

    callback result_selected(string);
    callback refresh_clicked();
    callback open_folder_clicked();
    /// One analysis's own folder (its results file's `path`).
    callback show_in_folder(string);

    // Deleting an analysis from the disk (dialogs/delete_analysis_dialog.slint):
    // the one asked about, what is in its folder, sizes formatted.
    callback delete_requested(string);
    callback delete_confirmed();
    in property <string> delete_name;
    in property <string> delete_folder;
    in property <string> delete_results;
    in property <string> delete_images;
    in property <string> delete_images_size;
    in property <string> delete_settings;
    in property <string> delete_other;
    in property <string> delete_total;
    /// It is the one open in Results: closed first.
    in property <bool> delete_open_now;
    /// It is still being written: it can't be deleted.
    in property <bool> delete_running;
    in property <bool> delete_busy;
    /// Why it (or part of it) couldn't be deleted.
    in property <string> delete_error;
}
