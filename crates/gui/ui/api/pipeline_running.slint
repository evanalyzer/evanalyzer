// api/pipeline_running.slint — the progress of a running analysis
// (`PipelineRunningState`) and of the preview (`PreviewRunState`). Kept
// apart: with editing allowed during an analysis, a preview runs while the
// analysis does.

export global PipelineRunningState {
    // An analysis was started and its progress not yet closed: shown as a
    // card over the image (editing allowed during the analysis), or in the
    // running dialog (not allowed).
    in-out property <bool> active: false;
    in-out property <int> processed: 0;
    in-out property <int> total: 0;
    // True once every tile is done and the pipeline has moved on to
    // whole-image-scoped work (tile-merge, Voronoi, DB export, ...). The
    // remaining `processed`/`total` units no longer correspond 1:1 to
    // images, so the label switches to a phase description instead of a
    // counter that would otherwise look "stuck".
    in-out property <bool> whole-image-phase: false;
    in-out property <bool> done: false;
    in-out property <bool> has-error: false;
    in-out property <string> status-message: "";
    // Apart: images done of all, the tiles of the one image (a run of one
    // image goes tile by tile), the image in work (the oldest of those
    // running, "+N" for the others), the time left.
    in-out property <int> images-done: 0;
    in-out property <int> images-total: 0;
    in-out property <int> tiles-done: 0;
    in-out property <int> tiles-total: 0;
    in-out property <string> current-image;
    in-out property <string> eta;
    callback cancel();
    callback close();
    // Opens the results of the analysis that just finished.
    callback open-results();
}

// The preview of the current image (the overlay over the image while it
// renders).
export global PreviewRunState {
    // Its pill is on the image (not a dialog: dialogs stay open meanwhile).
    in-out property <bool> shown: false;
    in-out property <int> processed: 0;
    in-out property <int> total: 0;
    in-out property <bool> done: false;
    in-out property <bool> has-error: false;
    in-out property <string> status-message: "";
    // Of the whole image, not just what is in view: its note stays once it
    // is done, with the objects found - until a change makes it outdated.
    in-out property <bool> whole-image: false;
    in-out property <bool> outdated: false;
    in-out property <int> objects: 0;
    // A failed preview: the step it failed in ("cellpose › #1 Blur"; empty
    // if the error doesn't say), and that step (`failed-step` 0: none).
    in-out property <string> failed-where: "";
    in-out property <int> failed-pipeline: 0;
    in-out property <int> failed-step: 0;
    callback cancel();
    callback close();
    // Shows the step it failed in, in the Steps panel.
    callback show-step();
}
