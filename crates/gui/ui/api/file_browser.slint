// api/file_browser.slint — the Rust interface of dialogs/file_browser_dialog.slint: the state Rust
// sets, the callbacks it answers.

export enum FileBrowserMode { open-file, open-folder, save-file }

// kind: 0 home, 1 drive, 2 folder, 3 a folder the user added
export struct FileBrowserPlace {
    name: string,
    path: string,
    kind: int,
}

export struct FileBrowserCrumb {
    name: string,
    path: string,
}

// kind: 0 folder, 1 image, 2 project/template, 3 model, 4 results, 5 other
export struct FileBrowserEntry {
    name: string,
    path: string,
    is-dir: bool,
    size: string,
    modified: string,
    kind: int,
}

export global FileBrowserState {
    in-out property <bool> visible: false;
    in-out property <FileBrowserMode> mode: FileBrowserMode.open-file;
    in-out property <string> title: "Open";
    in-out property <string> accept-label: "Open";
    // Where the browsed files live, e.g. "This computer" / "Server ws://…".
    in-out property <string> location;
    in-out property <bool> remote: false;
    in-out property <string> current-path;
    in-out property <[FileBrowserCrumb]> crumbs;
    in-out property <[FileBrowserPlace]> places;
    // The backend's places are being read (drives can be slow on Windows).
    in-out property <bool> places-loading: false;
    // The folder shown is one of the places already.
    in-out property <bool> current-is-place: false;
    in-out property <[FileBrowserEntry]> entries;
    in-out property <int> selected: -1;
    in-out property <string> file-name;
    in-out property <[string]> filter-names;
    in-out property <string> filter-name;
    in-out property <string> search;
    in-out property <bool> show-hidden: false;
    in-out property <bool> loading: false;
    in-out property <string> error;
    in-out property <string> status;
    // Non-empty: ask whether to replace this existing file.
    in-out property <string> overwrite-name;
    in-out property <bool> can-accept: false;

    callback navigate(string);
    callback go-up();
    callback refresh();
    callback select(int);
    callback activate(int);
    callback accept();
    callback cancel();
    callback search-edited(string);
    callback filter-selected(string);
    callback hidden-toggled(bool);
    callback path-entered(string);
    callback create-folder(string);
    callback overwrite-answered(bool);
    // The folder shown added to the places / a place the user added removed.
    callback add-place();
    callback remove-place(string);
    callback file-name-edited(string);
}
