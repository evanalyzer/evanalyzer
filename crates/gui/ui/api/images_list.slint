// api/images_list.slint — the Rust interface of editor/images_list_panel.slint: the state Rust
// sets, the callbacks it answers.

// How far the images of a well are: none there, not looked at yet, seen
// in a preview, analysed.
export enum WellState { empty, new, preview, analysed }

// ----------------------------------------------------------
export struct ImageItemData {
    name: string,
    path: string,
    image_dimension: string,
    image_size: string,
    has_annotations: bool,
    // How far it is: new, previewed (this session), analysed (in the
    // analysis open in Results).
    state: WellState,
    // A folder's head row instead of an image (when the images lie in more
    // than one folder): `name` its last folder, `folder_parent` the folders
    // above it below the image folder ("Negative Control › "), `path` its
    // path relative to the image folder.
    folder: bool,
    folder_parent: string,
    // The folder's images (those matching the search) and how many of them
    // are analysed.
    count: int,
    analysed: int,
    // Folded: its images are not listed (never while searching).
    collapsed: bool,
    // An analysis leaves it out: a skipped folder or an unticked group
    // (head), or an image in one. Shown faded, still viewable.
    skipped: bool,
    // The row of its folder's head (a head: its own row); -1 without heads.
    // The list pins that head on top while the folder's images scroll by.
    head: int,
    // The user's review (an image): marker 0 none / 1-6, a note, left out
    // of the results.
    marker: int,
    has_note: bool,
    left_out: bool,
    // A group's head (listed by groups: the project's "Grouping"), not a
    // folder's: its box is ticked for this session only, not saved.
    group_head: bool,
    // A group's head: how many folders its images lie in ("2 folders"
    // when more than one).
    folders: int,
}

export global ImagesListState {
    in property <bool> is_scanning: false;
    in-out property <string> filter_text;
    in-out property <string> act_image_root_dir;

    callback new_image_root_folder_clicked();
    callback open_images_folder_clicked();
    callback refresh_images_clicked();
    // A folder's last name ("C14") and what comes before it ("/home/…/uni"),
    // for showing a long path: its start cut, its last folder whole.
    pure callback folder_name(string) -> string;
    pure callback folder_parent(string) -> string;
    callback image_selected(string);
    // Incremented (never read for its value) by the Ctrl+F global shortcut
    // (see shortcuts.slint) to move keyboard focus into the search field
    // below. A counter rather than a bool: `changed` below only fires on an
    // actual value change, and a plain bool would miss every second request
    // once it's already `true`. Handled directly in this file, not Rust -
    // it's pure UI focus, nothing to persist.
    in-out property <int> focus_search_requested: 0;
    callback image_filter_text_changed(string);
    // The markers the list and the chip's picker are narrowed to: bit n
    // for marker n (1-6), 0 none. Rust sets it, see `marker-filter-toggled`.
    in property <int> marker-filter: 0;
    // Some image has a marker (or a marker filter is on): the filter row shows.
    in property <bool> any-marker: false;
    // A colour of the filter clicked (1-6) - 0 clears the filter.
    callback marker-filter-toggled(int);

    in-out property <int> selected_image_index: -1;
    // Index to scroll into view (e.g. when an image is opened from the results
    // table or after a folder scan); -1 means "no scroll request".
    in-out property <int> scroll_to_image_index: -1;
    // Where the list is scrolled to: the panel is rebuilt when it is shown
    // again (Pipelines and back), and shows the same rows. UI only.
    in-out property <length> list-scroll-y: 0px;
    // The rows: images, and a head row per folder when there are several.
    in property <[ImageItemData]> images_list: [];
    // How many images `images_list` stands for (folded folders' too, no
    // head rows).
    in property <int> image-count: 0;
    // A folder's head row clicked: fold or unfold it (by its path).
    callback folder_toggled(string);
    // A head's box: analyse its images or skip them (by its path; a
    // group's head: by its `group:` path).
    callback folder_skip_toggled(string);
    // Every head of the open tab is ticked: the button unticks them all.
    in property <bool> all-ticked: true;
    // Unticks every head of the open tab, or ticks them all when one is
    // unticked.
    callback tick-all();
    // All the project's images, and those an analysis runs on (not in a
    // skipped folder; listed by groups: in a ticked group) - the search
    // doesn't change these.
    in property <int> total-images: 0;
    in property <int> run-images: 0;

    // Listed by folders (false) or by groups - the groups the project's
    // "Grouping" finds in the names (wells).
    in-out property <bool> by-groups: false;
    callback by-groups-changed(bool);
    // Every head (folder or group) is folded: the button unfolds them all.
    in property <bool> all-folded: false;
    // Folds every head, or unfolds them all when they all are folded.
    callback fold-all();

    // -- The quick picker of the editor's image chip --
    // The images matching the picker's search, at most `QUICK_PICK_LIMIT`.
    in property <[ImageItemData]> quick-images: [];
    // How many images match, also those not in `quick-images`.
    in property <int> quick-matches: 0;
    // Index into `quick-images` of the open image; -1 not among them.
    in property <int> quick-current: -1;
    // New search text (also "" when the picker opens).
    callback quick-search(string);
}
