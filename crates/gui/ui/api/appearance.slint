// api/appearance.slint — the color scheme. Rust applies the remembered one
// at start (`apply`), the views report a change (`scheme-changed`) and
// apply it themselves.

import { Palette } from "std-widgets.slint";
import { Ink, InkScheme } from "../ink/palette.slint";

// Sets `Palette.color-scheme` too, so std-widgets controls follow the
// scheme and not the OS theme. Each top-level window gets its own instance
// of this global: Rust calls `apply()` on every window.
export global Appearance {
    // The user picked another scheme - for Rust to remember it.
    callback scheme-changed(InkScheme);

    public function apply(scheme: InkScheme) {
        Ink.scheme = scheme;
        Palette.color-scheme = scheme == InkScheme.light ? ColorScheme.light : ColorScheme.dark;
    }

    // What a view calls: apply, and tell Rust.
    public function pick(scheme: InkScheme) {
        self.apply(scheme);
        self.scheme-changed(scheme);
    }
}
