// style.slint — the colors and sizes of the views not yet rebuilt on Ink,
// read from Ink: they follow the color scheme (light, dark, dim) like the
// rest. Goes away with the last of those views; new code uses `Ink`.

import { Ink } from "ink/palette.slint";

export global Theme {
    out property <bool> dark-mode: Ink.dark;

    // -- Surfaces --
    out property <color> bg: Ink.ground;
    out property <color> bg-viewport: Ink.viewport;
    out property <color> panel: Ink.panel;
    out property <color> raised: Ink.raised;
    out property <color> rail: Ink.raised;
    out property <color> list-row-alt-bg: Ink.field;

    // -- Lines --
    out property <color> border: Ink.border;
    out property <color> border-soft: Ink.border-soft;

    // -- Text --
    out property <color> text-bright: Ink.text;
    out property <color> text: Ink.text;
    out property <color> text-dim: Ink.text-dim;
    out property <color> text-mute: Ink.text-mute;
    out property <color> text-faint: Ink.text-faint;
    // On the image: always white.
    out property <color> text-pixel-info: #FFFFFF;
    out property <color> text-scalebar: #FFFFFF;

    // -- Accent and states --
    out property <color> accent: Ink.focus;
    out property <color> accent-dim: Ink.selection;
    out property <color> ok: Ink.ok;
    out property <color> warn: Ink.warn;
    out property <color> err: Ink.err;

    // -- Overlays --
    out property <color> modal-overlay: Ink.scrim;
    out property <color> modal-dim: Ink.scrim;
    out property <color> overlay-scrim: Ink.glass;
    out property <color> shadow: Ink.shadow;

    // -- Pipelines --
    out property <color> sidebar: Ink.panel;
    out property <color> sidebar-list: Ink.raised;
    out property <color> sidebar-step-active: Ink.selection;
    out property <color> sidebar-step-idle: Ink.field;
    out property <color> status-done: Ink.ok;
    out property <color> status-idle: Ink.text-faint;

    out property <color> icon-bg-default: Ink.warn-tint;
    out property <color> icon-bg-info: Ink.info;

    // BioRunner (the game): a warm paper look, the same in every scheme.
    out property <color> game-paper: #F0EDD6;
    out property <color> game-ink: #2a2a2a;
    out property <color> game-title: #C8C0A4;
    out property <color> game-subtitle: #C0BAA0;
    out property <color> game-green: #4aaa55;

    // -- Step categories --
    out property <color> cat-preprocess: Ink.cat-preprocess;
    out property <color> cat-segment: Ink.cat-segment;
    out property <color> cat-object: Ink.cat-object;
    out property <color> cat-measure: Ink.cat-measure;
    out property <color> cat-classify: Ink.cat-classify;
    out property <color> cat-dataset: Ink.cat-dataset;
    out property <color> cat-component: Ink.cat-component;

    // -- Default channel colors (data, the same in every scheme) --
    out property <color> ch-0: #22D3EE;
    out property <color> ch-1: #E879F9;
    out property <color> ch-2: #FACC15;
    out property <color> ch-3: #34D399;
    out property <color> ch-4: #F87171;

    // -- Sizes --
    out property <length> panel-content-padding: Ink.pad-panel;
    out property <length> radius-sm: Ink.radius-sm;
    out property <length> radius-md: Ink.radius-md;
    out property <length> radius-lg: Ink.radius-lg;

    out property <color> hover: Ink.hover;

    out property <length> list-row-height: 40px;
    out property <color> list-select-row-bg: Ink.selection;
    out property <color> list-select-row-border-color: Ink.focus;

    out property <string> font-sans: Ink.font-sans;
    out property <string> font-mono: Ink.font-mono;
}
