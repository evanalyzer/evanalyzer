// shell/annotate_bar.slint — the tool bar of annotate mode, floating over
// the image: the tools, the class painted into, the brush size.

import { Ink, InkIcons, InkIconButton, InkToolButton, InkBarSeparator, InkNumberField, InkMenuFrame, InkMenuItem, InkMenuSeparator, InkPickerRow, InkSwatchName } from "../ink/ink.slint";
import { ClassificationSettingsState } from "../api/classification_class_edit.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { LayoutState } from "../api/layout.slint";
import { ToolState, ViewportObjectState } from "../api/viewport.slint";
import { ClassificationState } from "../api/classification.slint";

export component AnnotateBar inherits Rectangle {
    property <ToolState> tool: ViewportObjectState.act_tool_state;
    // Shapes need a class to paint into.
    property <bool> has-class: ClassificationState.selected_class_id >= 0;
    // "+ New class…" was chosen here: the class it makes is picked.
    property <bool> waiting-for-class: false;
    property <int> created: ClassificationSettingsState.created-count;
    changed created => {
        if root.waiting-for-class {
            root.waiting-for-class = false;
            root.pick(ClassificationSettingsState.last-created-id, ClassificationSettingsState.settings.name);
        }
    }

    function pick(id: int, name: string) {
        ClassificationState.selected_class_name = name;
        ClassificationState.selected_class_id = id;
        ClassificationState.class_selected(id);
    }

    width: row.preferred-width + 12px;
    height: 44px;
    accessible-role: groupbox;
    accessible-label: "Annotate";

    glass := Rectangle {
        background: Ink.glass;
        border-radius: Ink.radius-lg;
        border-width: 1px;
        border-color: Ink.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Ink.shadow;

        TouchArea { }

        row := HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 2px;
            alignment: center;

            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 2px;
                    InkToolButton {
                        icon: InkIcons.move;
                        label: "Move";
                        keys: ["M"];
                        active: root.tool == ToolState.Move;
                        clicked => {
                            ViewportObjectState.act_tool_state = ToolState.Move;
                        }
                    }
                    InkToolButton {
                        icon: InkIcons.select;
                        label: "Select";
                        keys: ["S"];
                        active: root.tool == ToolState.Select;
                        clicked => {
                            ViewportObjectState.act_tool_state = ToolState.Select;
                        }
                    }
                    InkBarSeparator { }
                    InkToolButton {
                        icon: InkIcons.marker;
                        label: "Marker";
                        keys: ["K"];
                        active: root.tool == ToolState.PaintMarker;
                        clicked => {
                            ViewportObjectState.act_tool_state = ToolState.PaintMarker;
                        }
                    }
                    InkToolButton {
                        icon: InkIcons.rectangle;
                        label: "Rectangle";
                        keys: ["R"];
                        enabled: root.has-class;
                        disabled-reason: "Pick the class to paint as first";
                        active: root.tool == ToolState.PaintRectangle;
                        clicked => {
                            ViewportObjectState.act_tool_state = ToolState.PaintRectangle;
                        }
                    }
                    InkToolButton {
                        icon: InkIcons.ellipse;
                        label: "Ellipse";
                        keys: ["E"];
                        enabled: root.has-class;
                        disabled-reason: "Pick the class to paint as first";
                        active: root.tool == ToolState.PaintOval;
                        clicked => {
                            ViewportObjectState.act_tool_state = ToolState.PaintOval;
                        }
                    }
                    InkToolButton {
                        icon: InkIcons.polygon;
                        label: "Polygon";
                        keys: ["P"];
                        enabled: root.has-class;
                        disabled-reason: "Pick the class to paint as first";
                        active: root.tool == ToolState.PaintPolygon;
                        clicked => {
                            ViewportObjectState.act_tool_state = ToolState.PaintPolygon;
                        }
                    }
                    InkToolButton {
                        icon: InkIcons.brush;
                        label: "Brush";
                        enabled: root.has-class;
                        disabled-reason: "Pick the class to paint as first";
                        active: root.tool == ToolState.Brush;
                        clicked => {
                            ViewportObjectState.act_tool_state = ToolState.Brush;
                        }
                    }
                    InkToolButton {
                        icon: InkIcons.eraser;
                        label: "Eraser";
                        active: root.tool == ToolState.Eraser;
                        clicked => {
                            ViewportObjectState.act_tool_state = ToolState.Eraser;
                        }
                    }
                    InkBarSeparator { }
                }
            }

            // The class painted into.
            Text {
                text: "Paint as";
                font-size: Ink.fs-secondary;
                color: Ink.text-mute;
                vertical-alignment: center;
            }
            class-field := VerticalLayout {
                alignment: center;
                padding-left: 4px;
                padding-right: 8px;
                Rectangle {
                    height: Ink.control-h;
                    width: min(class-row.preferred-width + 16px, 180px);
                    border-radius: Ink.radius-sm;
                    border-width: 1px;
                    border-color: Ink.border;
                    background: Ink.field;
                    class-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        // The class's color, as in the menu: the selected
                        // one's of the list, all in one 9px box.
                        if root.has-class: Rectangle {
                            width: 9px;
                            for data in ClassificationState.classes_list: Rectangle {
                                visible: data.id == ClassificationState.selected_class_id;
                                y: (parent.height - self.height) / 2;
                                width: 9px;
                                height: 9px;
                                border-radius: 2px;
                                background: data.color;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.has-class ? ClassificationState.selected_class_name : "Pick a class";
                            font-size: Ink.fs-body;
                            color: root.has-class ? Ink.text : Ink.text-faint;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Image {
                            source: InkIcons.caret-down;
                            width: 10px;
                            colorize: Ink.text-mute;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            class-menu.show();
                        }
                    }
                }
            }

            if root.tool == ToolState.Brush || root.tool == ToolState.Eraser: HorizontalLayout {
                spacing: 6px;
                padding-right: 6px;
                Text {
                    text: "Size";
                    font-size: Ink.fs-secondary;
                    color: Ink.text-mute;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    InkNumberField {
                        width: 92px;
                        label: "Brush size";
                        value: LayoutState.brush-size;
                        min: 1;
                        max: 200;
                        unit: "px";
                        changed(text) => {
                            LayoutState.brush-size = text.to-float();
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                InkIconButton {
                    size: 28px;
                    icon: InkIcons.close;
                    label: "Leave annotate mode";
                    clicked => {
                        LayoutState.annotate = false;
                        ViewportObjectState.act_tool_state = ToolState.Move;
                    }
                }
            }
        }
    }

    // The classes to paint into; a new one is picked at once.
    class-menu := PopupWindow {
        x: class-field.x;
        y: root.height + 4px;
        InkMenuFrame {
            open-y: root.absolute-position.y + root.height + 4px;
            menu-width: 240px;
            for data in ClassificationState.classes_list: InkPickerRow {
                label: data.id < 10 ? "0" + data.id : data.id;
                selected: data.id == ClassificationState.selected_class_id;
                clicked => {
                    root.pick(data.id, data.name);
                    class-menu.close();
                }
                InkSwatchName {
                    color: data.color;
                    name: data.name;
                }
            }
            if ClassificationState.classes_list.length > 0: InkMenuSeparator { }
            InkMenuItem {
                icon: InkIcons.add;
                text: "New class…";
                clicked => {
                    root.waiting-for-class = true;
                    ClassificationSettingsState.reset_to_zero();
                    GlobalAppState.active_dialog = DialogType.classification-edit-class-dialog;
                }
            }
        }
    }
}
