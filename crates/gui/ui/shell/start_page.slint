// shell/start_page.slint — the start page (board AA): while nothing is open
// yet. Opening an image folder (the main way in), one image, a project, or
// an empty project; the projects opened before. Cells drift slowly in the
// background, as in About - stepped by a 10 Hz timer, not every frame, and
// still with Settings › Viewport › Reduce motion.

import {
    Ink,
    InkIcons,
    InkKbd,
    InkIconButton,
    InkSwitch,
} from "../ink/ink.slint";
import { ViewportMemoryState } from "../api/project_settings.slint";
import { FileBrowserState } from "../api/file_browser.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { RecentProjectRow, StartState } from "../api/start.slint";

// One way in: an icon, what it does, its shortcut.
component StartAction inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> text;
    in property <string> shortcut;
    // The main way in: outlined in the accent.
    in property <bool> main: false;
    callback clicked;

    height: action-row.preferred-height;
    border-radius: Ink.radius-lg;
    background: ta.has-hover ? Ink.hover : Ink.panel;
    border-width: root.main ? 1.5px : 1px;
    border-color: root.main ? Ink.focus : ta.has-hover ? Ink.text-faint : Ink.border;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.text;
    accessible-action-default => {
        root.clicked();
    }

    // The main one's soft ring.
    if root.main: Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: Ink.radius-lg + 4px;
        border-width: 4px;
        border-color: Ink.focus-ring;
    }

    action-row := HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 16px;
        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            border-radius: Ink.radius-lg;
            background: root.main ? Ink.info-tint : Ink.raised;
            Image {
                source: root.icon;
                width: 22px;
                colorize: root.main ? Ink.focus : Ink.text;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: Ink.fs-title;
                font-weight: 600;
                color: Ink.text;
            }

            Text {
                text: root.text;
                font-size: Ink.fs-body;
                color: Ink.text-dim;
                wrap: word-wrap;
            }
        }

        if root.shortcut != "": VerticalLayout {
            alignment: center;
            InkKbd {
                text: root.shortcut;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component StartLink inherits Text {
    callback clicked;
    font-size: Ink.fs-body;
    color: Ink.focus;
    accessible-role: button;
    accessible-label: self.text;
    accessible-action-default => {
        root.clicked();
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A project opened before: a click opens it; ✕ takes it off the list; a
// missing one is located again.
component RecentRow inherits Rectangle {
    in property <RecentProjectRow> project;
    callback open;
    callback locate;
    callback forget;

    height: 56px;
    border-radius: Ink.radius-md;
    background: ta.has-hover ? Ink.hover : transparent;
    accessible-role: button;
    accessible-label: root.project.name;
    accessible-description: root.project.missing ? "Not found: " + root.project.path : root.project.path;
    accessible-action-default => {
        if root.project.missing {
            root.locate();
        } else {
            root.open();
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if root.project.missing {
                root.locate();
            } else {
                root.open();
            }
        }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 10px;
            spacing: 12px;
            Rectangle {
                width: 32px;
                height: 32px;
                y: (parent.height - self.height) / 2;
                border-radius: Ink.radius-md;
                background: root.project.missing ? Ink.warn-tint : Ink.raised;
                Image {
                    source: root.project.missing ? InkIcons.warning : InkIcons.project;
                    width: 16px;
                    colorize: root.project.missing ? Ink.warn : Ink.text-dim;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                min-width: 80px;
                Text {
                    text: root.project.name;
                    font-size: Ink.fs-heading;
                    font-weight: 600;
                    color: Ink.text;
                    overflow: elide;
                }

                Text {
                    text: root.project.missing ? "Not found - " + root.project.path : root.project.path;
                    font-size: Ink.fs-secondary;
                    font-family: Ink.font-mono;
                    color: root.project.missing ? Ink.warn : Ink.text-mute;
                    overflow: elide;
                }
            }

            Text {
                text: root.project.meta;
                font-size: Ink.fs-body;
                color: Ink.text-dim;
                vertical-alignment: center;
                horizontal-alignment: right;
            }

            Text {
                width: 92px;
                text: root.project.when;
                font-size: Ink.fs-body;
                color: Ink.text-mute;
                vertical-alignment: center;
                horizontal-alignment: right;
            }

            Rectangle {
                width: 72px;
                if root.project.missing: Text {
                    x: parent.width - self.width;
                    text: "Locate…";
                    font-size: Ink.fs-body;
                    color: Ink.focus;
                    vertical-alignment: center;
                    height: parent.height;
                }
                // On hover (inside the row's touch area: no flicker).
                if !root.project.missing && ta.has-hover: InkIconButton {
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    icon: InkIcons.close;
                    label: "Remove from the list";
                    clicked => {
                        root.forget();
                    }
                }
            }
        }
    }
}

export component StartPage inherits Rectangle {
    // Cells drifting, as in About: their phase in seconds, stepped by the
    // timer (no animation at all with reduced motion).
    property <float> phase: 0;
    property <color> cell-a: #FF922B;
    property <color> cell-b: #22B8CF;

    background: Ink.ground;
    clip: true;
    accessible-role: groupbox;
    accessible-label: "Start";

    // The circles drift - only while nothing covers the page: on Windows
    // (drawn by the CPU) each step redraws most of the window, and a dialog
    // over it (the file browser) would wait for those redraws.
    Timer {
        interval: 100ms;
        running: !ViewportMemoryState.reduce_motion && !FileBrowserState.visible
            && GlobalAppState.active_dialog == DialogType.none;
        triggered => {
            root.phase += 0.1;
        }
    }

    for i in 22: Rectangle {
        property <length> r: (10 + mod(i, 5) * 7) * 1px;
        property <length> drift: 18px * sin((root.phase / (9 + mod(i, 6) * 2)) * 360deg + i * 40deg);
        x: mod(i * 197, 1000) / 1000 * root.width - 20px + self.drift;
        y: mod(i * 151, 700) / 700 * root.height - 20px - self.drift;
        width: self.r;
        height: self.r;
        border-radius: self.r / 2;
        border-width: 1.5px;
        border-color: (mod(i, 2) == 0 ? root.cell-a : root.cell-b).with-alpha(0.16);
    }

    // Clicks between the parts stay here (not on what is below).
    TouchArea { }

    HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: min(72px, max(16px, (parent.height - self.preferred-height) / 3));
        width: min(1120px, parent.width - 48px);
        height: min(self.preferred-height, parent.height - self.y - 16px);
        spacing: 48px;

        // -- The ways in --
        VerticalLayout {
            width: min(460px, parent.width * 0.42);
            spacing: 14px;
            alignment: start;

            HorizontalLayout {
                spacing: 16px;
                padding-bottom: 26px;
                Image {
                    source: @image-url("../icons/icon-orange.svg");
                    width: 56px;
                    height: 56px;
                    accessible-role: image;
                    accessible-label: "EVAnalyzer";
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "EVAnalyzer";
                        font-size: Ink.fs-display;
                        font-weight: 700;
                        color: Ink.text;
                    }

                    Text {
                        text: "Enhanced Visual Image Analyzer";
                        font-size: Ink.fs-dialog-title;
                        color: Ink.text-dim;
                    }
                }
            }

            Text {
                text: "START";
                font-size: Ink.fs-caption;
                font-weight: 600;
                letter-spacing: 0.6px;
                color: Ink.text-mute;
            }

            StartAction {
                main: true;
                icon: InkIcons.images;
                title: "Open image folder…";
                text: "Your microscopy images. A new project is made for them - save it when you like.";
                shortcut: "Ctrl Shift O";
                clicked => {
                    StartState.open-images-folder();
                }
            }

            StartAction {
                icon: InkIcons.image;
                title: "Open image…";
                text: "One image file, opened right away - the others of its folder are listed too.";
                shortcut: "Ctrl I";
                clicked => {
                    StartState.open-image();
                }
            }

            StartAction {
                icon: InkIcons.project;
                title: "Open project…";
                text: "An .evaproj file - its images, pipelines and results.";
                shortcut: "Ctrl O";
                clicked => {
                    StartState.open-project();
                }
            }

            StartAction {
                icon: InkIcons.project-empty;
                title: "Empty project";
                text: "No images yet - to look at a pipeline or build a simple one.";
                clicked => {
                    StartState.empty-project();
                }
            }

            HorizontalLayout {
                spacing: 18px;
                padding-top: 4px;
                padding-left: 2px;
                alignment: start;
                StartLink {
                    text: "New project from a template…";
                    clicked => {
                        StartState.from-template();
                    }
                }

                StartLink {
                    text: "Connect to a server…";
                    clicked => {
                        StartState.connect();
                    }
                }
            }
        }

        // -- The projects opened before (as tall as they are) --
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
        Rectangle {
            background: Ink.panel;
            border-radius: Ink.radius-lg;
            border-width: 1px;
            border-color: Ink.border;
            clip: true;

            VerticalLayout {
                Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text {
                            text: "Recent projects";
                            font-size: Ink.fs-heading;
                            font-weight: 600;
                            color: Ink.text;
                            vertical-alignment: center;
                        }

                        Text {
                            text: StartState.recent.length > 0 ? StartState.recent.length : "";
                            font-size: Ink.fs-secondary;
                            font-family: Ink.font-mono;
                            color: Ink.text-mute;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Ink.border-soft;
                    }
                }

                if StartState.recent.length == 0: VerticalLayout {
                    padding: 24px;
                    min-height: 120px;
                    Text {
                        text: "Projects you open or save show here, to pick up where you left off.";
                        font-size: Ink.fs-dialog-title;
                        color: Ink.text-mute;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if StartState.recent.length > 0: VerticalLayout {
                    padding: 6px;
                    for row[i] in StartState.recent: RecentRow {
                        project: row;
                        open => {
                            StartState.open-recent(i);
                        }
                        locate => {
                            StartState.locate-recent(i);
                        }
                        forget => {
                            StartState.forget-recent(i);
                        }
                    }
                }

                Rectangle {
                    height: 48px;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Ink.border-soft;
                    }

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            InkSwitch {
                                text: "Open the last project when EVAnalyzer starts";
                                checked: StartState.open-last;
                                toggled(on) => {
                                    StartState.open-last = on;
                                    StartState.open-last-changed(on);
                                }
                            }
                        }

                        if StartState.recent.length > 0: StartLink {
                            text: "Clear list";
                            color: Ink.text-dim;
                            vertical-alignment: center;
                            clicked => {
                                StartState.clear-recent();
                            }
                        }
                    }
                }
            }
        }
        }
    }
}
