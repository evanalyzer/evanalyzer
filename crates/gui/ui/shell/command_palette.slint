// shell/command_palette.slint — the command palette (Ctrl+K): type to find
// an action, a step of the shown pipeline or a command to add; ↑ / ↓
// choose, Enter runs, Esc closes.

import { CommandPaletteState, PaletteEntry, PaletteKind } from "../api/command_palette.slint";
import { Ink, InkIcons, InkSearchField, InkKbd, InkHint } from "../ink/ink.slint";

component PaletteRow inherits Rectangle {
    in property <PaletteEntry> entry;
    in property <bool> selected;
    callback clicked;
    callback hovered;

    height: 34px;
    accessible-role: list-item;
    accessible-label: root.entry.title;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    face := Rectangle {
        border-radius: Ink.radius-md;
        background: root.selected ? Ink.selection : transparent;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            Image {
                source: root.entry.kind == PaletteKind.step ? InkIcons.steps
                    : root.entry.kind == PaletteKind.command ? InkIcons.add
                    : InkIcons.run;
                width: 14px;
                colorize: root.selected ? Ink.text : Ink.text-mute;
            }
            Text {
                text: root.entry.title;
                font-size: Ink.fs-md;
                font-weight: root.selected ? 600 : 400;
                color: Ink.text;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                horizontal-stretch: 1;
                text: root.entry.detail;
                font-size: Ink.fs-sm;
                color: Ink.text-mute;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.entry.shortcut != "": Text {
                text: root.entry.shortcut;
                font-size: Ink.fs-sm;
                font-family: Ink.font-mono;
                color: Ink.text-faint;
                vertical-alignment: center;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        moved => {
            root.hovered();
        }
    }
}

export component CommandPalette inherits Rectangle {
    property <int> count: CommandPaletteState.entries.length;
    property <length> row-h: 34px;

    function close() {
        CommandPaletteState.open = false;
    }

    function run-selected() {
        if CommandPaletteState.selected >= 0 && CommandPaletteState.selected < root.count {
            CommandPaletteState.run(CommandPaletteState.entries[CommandPaletteState.selected].id);
        }
    }

    function move-selection(by: int) {
        if root.count > 0 {
            CommandPaletteState.selected = clamp(CommandPaletteState.selected + by, 0, root.count - 1);
            // Keep it in view.
            let top = CommandPaletteState.selected * root.row-h;
            if top + list.content-y < 0 {
                list.content-y = -top;
            } else if top + root.row-h + list.content-y > list.height {
                list.content-y = list.height - top - root.row-h;
            }
        }
    }

    background: Ink.scrim.with-alpha(0.25);

    // A click outside closes it.
    TouchArea {
        clicked => {
            root.close();
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            if event.text == Key.DownArrow {
                root.move-selection(1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.move-selection(-1);
                return accept;
            }
            reject
        }

        card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: 72px;
            width: min(600px, parent.width - 32px);
            height: layout.preferred-height;
            background: Ink.panel;
            border-radius: Ink.radius-lg;
            border-width: 1px;
            border-color: Ink.border;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: Ink.shadow;
            clip: true;
            accessible-role: groupbox;
            accessible-label: "Command palette";

            TouchArea { }

            layout := VerticalLayout {
                padding: 8px;
                spacing: 6px;

                search := InkSearchField {
                    placeholder: "Find an action, a step, a command…";
                    text <=> CommandPaletteState.query;
                    edited(text) => {
                        CommandPaletteState.query-changed(text);
                    }
                    accepted(text) => {
                        root.run-selected();
                    }
                }

                if root.count == 0: InkHint {
                    text: "Nothing found.";
                    horizontal-alignment: center;
                }

                list := Flickable {
                    height: min(root.count, 10) * root.row-h;
                    content-height: root.count * root.row-h;
                    VerticalLayout {
                        for entry[i] in CommandPaletteState.entries: PaletteRow {
                            entry: entry;
                            selected: i == CommandPaletteState.selected;
                            clicked => {
                                CommandPaletteState.run(entry.id);
                            }
                            hovered => {
                                CommandPaletteState.selected = i;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;
                    InkKbd { text: "↑↓"; }
                    Text {
                        text: "choose";
                        font-size: Ink.fs-xs;
                        color: Ink.text-faint;
                        vertical-alignment: center;
                    }
                    InkKbd { text: "Enter"; }
                    Text {
                        text: "run";
                        font-size: Ink.fs-xs;
                        color: Ink.text-faint;
                        vertical-alignment: center;
                    }
                    InkKbd { text: "Esc"; }
                    Text {
                        text: "close";
                        font-size: Ink.fs-xs;
                        color: Ink.text-faint;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    init => {
        CommandPaletteState.query = "";
        CommandPaletteState.query-changed("");
        search.focus-input();
    }
}
