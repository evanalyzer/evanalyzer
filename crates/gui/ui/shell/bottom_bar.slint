// shell/bottom_bar.slint — the bar at the bottom: the modes (Images,
// Pipelines, Results) and the status - where the work runs, what the
// viewport does, objects, zoom.

import { Ink, InkIcons, InkTone, InkModeTab, InkStatusItem, InkBarSeparator, InkKbd } from "../ink/ink.slint";
import { LayoutState, WorkspaceMode } from "../api/layout.slint";
import { ConnectionState, ImagePixelInfo } from "../api/state.slint";
import { ViewportObjectState, ViewportState } from "../api/viewport.slint";
import { ClassificationState } from "../api/classification.slint";
import { ResultsRailMode, ResultsState } from "../api/results.slint";
import { StartState } from "../api/start.slint";
import { PipelineRunningState } from "../api/pipeline_running.slint";

component HintText inherits Text {
    font-size: Ink.fs-secondary;
    color: Ink.text-dim;
    vertical-alignment: center;
}

export component BottomBar inherits Rectangle {
    property <bool> secure: ConnectionState.encrypted && ConnectionState.verified;
    property <bool> running: PipelineRunningState.active && !PipelineRunningState.done;

    height: Ink.status-h;
    background: Ink.panel;

    Rectangle {
        y: 0px;
        height: 1px;
        background: Ink.border;
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 2px;

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 2px;
                // The start page: nothing open - Images still opens (an
                // empty project, Images first as for any project),
                // Pipelines and Results need one.
                InkModeTab {
                    text: "Images";
                    active: !StartState.active && LayoutState.mode == WorkspaceMode.images;
                    clicked => {
                        if StartState.active {
                            StartState.empty-project();
                        }
                        LayoutState.mode = WorkspaceMode.images;
                    }
                }
                InkModeTab {
                    text: "Pipelines";
                    enabled: !StartState.active;
                    active: !StartState.active && LayoutState.mode == WorkspaceMode.pipelines;
                    clicked => {
                        LayoutState.mode = WorkspaceMode.pipelines;
                    }
                }
                InkModeTab {
                    text: "Results";
                    enabled: !StartState.active;
                    active: !StartState.active && LayoutState.mode == WorkspaceMode.results;
                    clicked => {
                        LayoutState.mode = WorkspaceMode.results;
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 2px;
                // A running analysis: what it's at.
                if root.running: InkStatusItem {
                    icon: InkIcons.busy;
                    mono: true;
                    text: "Analyzing"
                        + (PipelineRunningState.current-image != "" ? " · " + PipelineRunningState.current-image : "")
                        + (PipelineRunningState.images-total <= 1 && PipelineRunningState.tiles-total > 0 ? " · tile " + PipelineRunningState.tiles-done + " / " + PipelineRunningState.tiles-total : "")
                        + (PipelineRunningState.images-total > 0 ? " · image " + PipelineRunningState.images-done + " / " + PipelineRunningState.images-total : "");
                }
                // Idle over the image: how the panels go away.
                if !root.running && !StartState.active && LayoutState.mode != WorkspaceMode.results && ImagePixelInfo.mouse_pos == "": HorizontalLayout {
                    spacing: 4px;
                    padding-right: 6px;
                    HintText { text: "Click a panel's title to fold it ·"; }
                    VerticalLayout { alignment: center; InkKbd { text: "Tab"; } }
                    HintText { text: "hides all panels ·"; }
                    VerticalLayout { alignment: center; InkKbd { text: "O"; } }
                    HintText { text: "objects on/off"; }
                }

                // The start page: nothing open.
                if StartState.active: InkStatusItem {
                    text: "No project open";
                }
                // Results: the database shown.
                if !StartState.active && LayoutState.mode == WorkspaceMode.results: InkStatusItem {
                    icon: ResultsState.loading ? InkIcons.busy : InkIcons.table;
                    text: (ResultsState.loading ? "Loading" : "Ready") + (ResultsState.database-name == "" ? "" : " · " + ResultsState.database-name)
                        + (ResultsState.analysis-summary == "" ? "" : " · " + ResultsState.analysis-summary);
                }
                if !StartState.active && LayoutState.mode == WorkspaceMode.results && ResultsState.split && ResultsState.database-name != "" && ResultsState.rail-mode != ResultsRailMode.charts: InkStatusItem {
                    text: "Split view · " + (ResultsState.rail-mode == ResultsRailMode.matrix ? "plate" : "list") + " and image";
                }
                // Under the pointer.
                if !StartState.active && LayoutState.mode != WorkspaceMode.results: HorizontalLayout {
                    spacing: 2px;
                    InkStatusItem {
                        visible: ImagePixelInfo.mouse_pos != "";
                        text: ImagePixelInfo.mouse_pos;
                        mono: true;
                    }
                    InkStatusItem {
                        visible: ImagePixelInfo.pixel_value != "";
                        text: ImagePixelInfo.pixel_value;
                        mono: true;
                    }
                    InkBarSeparator {
                        y: (parent.height - self.height) / 2;
                    }
                    InkStatusItem {
                        icon: ViewportState.opening || !ViewportState.high_res_ready ? InkIcons.busy : InkIcons.check;
                        text: ViewportObjectState.is_drawing ? "Drawing" : ViewportState.opening ? "Opening" : !ViewportState.high_res_ready ? "Rendering" : "Ready";
                    }
                    InkStatusItem {
                        icon: InkIcons.objects;
                        text: ClassificationState.total_visible_objects + " objects";
                        mono: true;
                    }
                    InkStatusItem {
                        text: "Zoom " + round(ViewportState.zoom_factor * 100) + "%";
                        mono: true;
                    }
                }
                InkBarSeparator {
                    y: (parent.height - self.height) / 2;
                }
                InkStatusItem {
                    icon: !ConnectionState.remote ? InkIcons.computer : InkIcons.server;
                    tone: !ConnectionState.remote ? InkTone.neutral
                        : !ConnectionState.connected ? InkTone.err
                        : !root.secure ? InkTone.warn
                        : InkTone.ok;
                    text: !ConnectionState.remote ? ConnectionState.label
                        : !ConnectionState.connected ? ConnectionState.label + " - disconnected"
                        : !ConnectionState.encrypted ? ConnectionState.label + " - unencrypted"
                        : !ConnectionState.verified ? ConnectionState.label + " - server not verified"
                        : ConnectionState.label;
                }
            }
        }
    }
}
