// shell/workspace.slint — everything between the bars: the image, and
// floating over it the panels of the mode - steps on the left in
// Pipelines, images on the left in Images; classes, objects and the image
// controls on the right; the annotate tools on top. Results fill it.

import { Ink, InkIcons, InkPanel, InkPanelHead, InkIconButton } from "../ink/ink.slint";
import { Places, LayoutState, WorkspaceMode } from "../api/layout.slint";
import { GlobalAppState, DialogType } from "../api/state.slint";
import { Viewport } from "../editor/viewport.slint";
import { PreviewRendering } from "../dialogs/preview_rendering_dialog.slint";
import { PipelinesPanel, TuningPanel } from "../editor/pipelines_panel.slint";
import { PipelinesPanelState } from "../api/pipelines.slint";
import { ImagesListPanel } from "../editor/images_list_panel.slint";
import { ImageMetaPanel } from "../editor/image_meta_panel.slint";
import { ResultsListPanel } from "../editor/results_list_panel.slint";
import { ClassificationPanel } from "../editor/classification_panel.slint";
import { ObjectListPanel } from "../editor/object_list_panel.slint";
import { ObjectCard } from "../editor/object_card.slint";
import { ObjectListState } from "../api/object_list.slint";
import { ImageControlPanel } from "../editor/image_control_panel.slint";
import { AnnotateBar } from "annotate_bar.slint";
import { ResultsView } from "../results/results_view.slint";
import { AnalysisCard } from "../dialogs/pipeline_running_dialog.slint";
import { PipelineRunningState } from "../api/pipeline_running.slint";

// Gap between the panels and the edges.
global Float {
    out property <length> gap: Places.gap;
    out property <length> left-w: Places.left-w;
    out property <length> right-w: Places.right-w;
}

// The three switches for the right-hand panels.
component PanelSwitches inherits Rectangle {
    width: row.preferred-width + 8px;
    height: 36px;

    glass := Rectangle {
        background: Ink.glass;
        border-radius: Ink.radius-lg;
        border-width: 1px;
        border-color: Ink.border;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Ink.shadow;

        row := HorizontalLayout {
            padding: 4px;
            spacing: 2px;
            InkIconButton {
                icon: InkIcons.classes;
                label: "Classes";
                active: LayoutState.classes-open;
                clicked => {
                    LayoutState.classes-open = !LayoutState.classes-open;
                }
            }
            InkIconButton {
                icon: InkIcons.objects;
                label: "Objects";
                active: LayoutState.objects-open;
                clicked => {
                    LayoutState.objects-open = !LayoutState.objects-open;
                }
            }
            InkIconButton {
                icon: InkIcons.image-controls;
                label: "Image";
                active: LayoutState.image-open;
                clicked => {
                    LayoutState.image-open = !LayoutState.image-open;
                }
            }
        }
    }
}

export component Workspace inherits Rectangle {
    in property <image> display_image;
    in property <image> ghost_image;
    in property <image> object_image;

    property <bool> on-image: LayoutState.mode != WorkspaceMode.results;
    // The objects table at the bottom, and the room it takes there.
    property <bool> objects-table-shown: root.on-image && LayoutState.objects-open && LayoutState.objects-as-table;
    property <length> table-h: min(320px, root.height * 0.4);
    property <length> table-room: root.objects-table-shown ? root.table-h + Float.gap : 0px;
    property <length> table-x: LayoutState.mode == WorkspaceMode.pipelines ? Float.left-w + 2 * Float.gap : LayoutState.mode == WorkspaceMode.images ? Float.left-w + 20px + 2 * Float.gap : Float.gap;

    // A newly pinned setting shows the Tuning panel again.
    property <int> tuned-count: PipelinesPanelState.tuned-settings.length;
    changed tuned-count => {
        LayoutState.tuning-hidden = false;
    }

    // A new analysis shows its card again.
    property <bool> run-active: PipelineRunningState.active;
    changed run-active => {
        if self.run-active {
            LayoutState.analysis-card-hidden = false;
        }
    }

    background: Ink.viewport;
    clip: true;

    // Always there - switching modes keeps zoom and position.
    Viewport {
        display_image: root.display_image;
        ghost_image: root.ghost_image;
        object_image: root.object_image;
        width: 100%;
        height: 100%;
        // Also with a dialog open - only the analysis' waiting one blocks it.
        enabled: root.on-image && GlobalAppState.active_dialog != DialogType.pipeline-running;
        inset-left: LayoutState.mode == WorkspaceMode.results ? 0px : Float.left-w + 2 * Float.gap;
        inset-right: Float.right-w + 2 * Float.gap;
    }

    // Covers only the image, never the bars.
    if GlobalAppState.active_dialog == DialogType.preview-rendering: PreviewRendering {
        width: 100%;
        height: 100%;
    }

    // The selected object, next to it on the image (under the panels).
    if root.on-image && ObjectListState.selected_object.id != 0 && ObjectListState.selected_object.bbox-w > 0: ObjectCard {
        width: 100%;
        height: 100%;
        inset-left: LayoutState.mode == WorkspaceMode.results ? 0px : Float.left-w + 2 * Float.gap;
        inset-right: Float.right-w + 2 * Float.gap;
        inset-bottom: root.table-room;
    }

    // -- Left --
    if LayoutState.mode == WorkspaceMode.pipelines: InkPanel {
        x: Float.gap;
        y: Float.gap;
        width: Float.left-w;
        height: parent.height - 2 * Float.gap;
        PipelinesPanel {
            vertical-stretch: 1;
        }
    }

    if LayoutState.mode == WorkspaceMode.images: InkPanel {
        x: Float.gap;
        y: Float.gap;
        width: Float.left-w + 20px;
        height: parent.height - 2 * Float.gap;
        ImagesListPanel {
            vertical-stretch: 1;
        }
        Rectangle {
            height: 1px;
            background: Ink.border-soft;
        }
        ImageMetaPanel {
            vertical-stretch: 0;
        }
    }

    if LayoutState.mode == WorkspaceMode.results: Rectangle {
        background: Ink.ground;
        InkPanel {
            x: Float.gap;
            y: Float.gap;
            width: Float.left-w - 60px;
            height: parent.height - 2 * Float.gap;
            ResultsListPanel {
                vertical-stretch: 1;
            }
        }
        Rectangle {
            x: Float.left-w - 60px + 2 * Float.gap;
            y: Float.gap;
            width: parent.width - self.x - Float.gap;
            height: parent.height - 2 * Float.gap;
            border-radius: Ink.radius-lg;
            border-width: 1px;
            border-color: Ink.border;
            clip: true;
            ResultsView { }
        }
    }

    // -- Right --
    if root.on-image: VerticalLayout {
        x: parent.width - Float.right-w - Float.gap;
        y: Float.gap;
        width: Float.right-w;
        height: parent.height - 2 * Float.gap;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            alignment: end;
            PanelSwitches { }
        }

        if LayoutState.classes-open: InkPanel {
            max-height: 340px;
            ClassificationPanel { }
        }

        if LayoutState.image-open: InkPanel {
            vertical-stretch: 1;
            ImageControlPanel {
                vertical-stretch: 1;
            }
        }

        if LayoutState.objects-open && !LayoutState.objects-as-table: InkPanel {
            vertical-stretch: 1;
            ObjectListPanel {
                vertical-stretch: 1;
            }
        }
    }

    // -- The objects as a table: at the bottom, between the left and the
    // right panels (design K) --
    if root.objects-table-shown: InkPanel {
        x: root.table-x;
        width: parent.width - root.table-x - Float.right-w - 2 * Float.gap;
        height: root.table-h;
        y: parent.height - self.height - Float.gap;
        ObjectListPanel {
            vertical-stretch: 1;
            table: true;
        }
    }

    // -- The pinned settings, next to the steps --
    if LayoutState.mode == WorkspaceMode.pipelines && PipelinesPanelState.tuned-settings.length > 0 && !LayoutState.tuning-hidden: InkPanel {
        x: Float.left-w + 2 * Float.gap;
        width: min(420px, parent.width - Float.left-w - Float.right-w - 4 * Float.gap);
        // As high as its settings (at most what the image leaves).
        height: min(self.preferred-height, parent.height - 2 * Float.gap - root.table-room);
        y: parent.height - self.height - Float.gap - root.table-room;
        TuningPanel {
            close => {
                LayoutState.tuning-hidden = true;
            }
        }
    }

    // -- A running analysis, while the window stays usable --
    // Bottom right, beside the right-hand panels: the Tuning panel and the
    // steps keep their place on the left.
    if PipelineRunningState.active && !LayoutState.analysis-card-hidden && GlobalAppState.active_dialog != DialogType.pipeline-running: AnalysisCard {
        x: parent.width - self.width - (root.on-image ? Float.right-w + 2 * Float.gap : Float.gap);
        y: parent.height - self.height - Float.gap - root.table-room;
    }

    // -- Top --
    if LayoutState.annotate && root.on-image: AnnotateBar {
        x: (parent.width - self.width) / 2;
        y: Float.gap;
    }
}
