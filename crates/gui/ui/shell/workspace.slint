// shell/workspace.slint — everything between the bars: the image, and
// floating over it the panels of the mode - steps on the left in
// Pipelines, images on the left in Images; classes, objects and the image
// controls on the right; the annotate tools on top. Results fill it.

import { Ink, InkIcons, InkPanel, InkPanelHead, InkIconButton, InkDivider, InkButton, InkButtonKind } from "../ink/ink.slint";
import { Places, LayoutState, WorkspaceMode } from "../api/layout.slint";
import { ChannelState, GlobalAppState, DialogType } from "../api/state.slint";
import { Viewport } from "../editor/viewport.slint";
import { PreviewRendering } from "../dialogs/preview_rendering_dialog.slint";
import { PipelinesPanel, TuningPanel } from "../editor/pipelines_panel.slint";
import { PipelinesPanelState } from "../api/pipelines.slint";
import { ImagesListPanel } from "../editor/images_list_panel.slint";
import { ImageMetaPanel } from "../editor/image_meta_panel.slint";
import { ClassificationPanel } from "../editor/classification_panel.slint";
import { ObjectListPanel } from "../editor/object_list_panel.slint";
import { ObjectDetails } from "../editor/object_details.slint";
import { ObjectDetailsPlace } from "../editor/object_list_panel.slint";
import { ObjectListState } from "../api/object_list.slint";
import { ImageControlPanel } from "../editor/image_control_panel.slint";
import { AnnotateBar } from "annotate_bar.slint";
import { ResultsView } from "../results/results_view.slint";
import { SplitDivider, SplitFilmstrip, SplitHint, SplitImageHead, SplitSelection, SplitTracksBar } from "../results/results_split.slint";
import { ResultsPeek } from "results_peek.slint";
import { SeriesChooser } from "series_chooser.slint";
import { ImageMetaData } from "../api/image_meta.slint";
import { ResultsRailMode, ResultsState } from "../api/results.slint";
import { StartState } from "../api/start.slint";
import { StartPage } from "start_page.slint";
import { PipelineRunningState, PreviewRunState } from "../api/pipeline_running.slint";

// Gap between the panels and the edges.
global Float {
    out property <length> gap: Places.gap;
    out property <length> left-w: Places.left-w;
    out property <length> right-w: Places.right-w;
}

export component Workspace inherits Rectangle {
    in property <image> display_image;
    in property <image> ghost_image;
    in property <image> object_image;

    property <bool> on-image: LayoutState.mode != WorkspaceMode.results;
    // The panels over the image: the left one (Steps, Images), the right
    // column - away with Tab (`panels-hidden`).
    property <bool> left-shown: root.on-image && LayoutState.steps-open && !LayoutState.panels-hidden;
    property <bool> right-shown: root.on-image && !LayoutState.panels-hidden
        && (LayoutState.classes-open || LayoutState.image-open || LayoutState.objects-open);
    property <bool> objects-in-column: LayoutState.objects-open && !LayoutState.objects-as-table;
    // The Tuning dock (pinned settings) at the bottom, between the panels -
    // the full width with them hidden.
    property <bool> tuning-shown: LayoutState.mode == WorkspaceMode.pipelines && PipelinesPanelState.tuned-settings.length > 0 && !LayoutState.tuning-hidden;
    property <length> dock-h: 236px;
    property <length> dock-x: root.left-shown ? Float.left-w + 2 * Float.gap : Float.gap;
    property <length> dock-w: root.width - root.dock-x - (root.right-shown ? Float.right-w + 2 * Float.gap : Float.gap);
    // What the dock and the objects table take at the bottom of the image.
    property <length> bottom-room: root.tuning-shown ? root.dock-h + Float.gap : root.table-room;
    // Results, split with the image (board Z): the results left, the
    // viewer in a pane right - List and Plate, with an analysis open.
    // Tracks: always beside their image.
    property <bool> split: LayoutState.mode == WorkspaceMode.results && (ResultsState.split || ResultsState.rail-mode == ResultsRailMode.tracks) && ResultsState.database-name != "" && ResultsState.rail-mode != ResultsRailMode.charts;
    changed split => {
        ResultsState.split-shown(self.split);
    }
    property <length> split-min-left: 420px;
    property <length> split-max-left: max(root.split-min-left, root.width - 360px);
    property <length> split-left: clamp(ResultsState.split-w, root.split-min-left, root.split-max-left);
    // The image pane: right of the divider, 12 px from the edges.
    property <length> pane-x: root.split-left + 16px;
    property <length> pane-w: root.width - root.pane-x - 12px;
    property <length> pane-h: root.height - 24px;
    property <length> strip-h: ResultsState.rail-mode == ResultsRailMode.matrix && ResultsState.split-thumbs.length > 0 ? 76px : 0px;
    // The objects table at the bottom, and the room it takes there.
    property <bool> objects-table-shown: root.on-image && !LayoutState.panels-hidden && LayoutState.objects-open && LayoutState.objects-as-table;
    property <length> table-h: min(320px, root.height * 0.4);
    property <length> table-room: root.objects-table-shown ? root.table-h + Float.gap : 0px;
    property <length> table-x: LayoutState.mode == WorkspaceMode.pipelines ? Float.left-w + 2 * Float.gap : LayoutState.mode == WorkspaceMode.images ? Float.left-w + 20px + 2 * Float.gap : Float.gap;

    // A newly pinned setting shows the Tuning panel again.
    property <int> tuned-count: PipelinesPanelState.tuned-settings.length;
    changed tuned-count => {
        LayoutState.tuning-hidden = false;
    }


    // Split with the image: the panes on the ground.
    background: root.split ? Ink.ground : Ink.viewport;
    clip: true;

    // Always there - switching modes keeps zoom and position.
    Viewport {
        display_image: root.display_image;
        ghost_image: root.ghost_image;
        object_image: root.object_image;
        x: root.split ? root.pane-x : 0px;
        y: root.split ? 12px : 0px;
        width: root.split ? root.pane-w : root.width;
        height: root.split ? root.pane-h - root.strip-h : root.height;
        // Also with a dialog open - only the analysis' waiting one blocks it.
        enabled: root.on-image || root.split;
        split-mode: root.split;
        border-top-left-radius: root.split ? 10px : 0px;
        border-top-right-radius: root.split ? 10px : 0px;
        border-bottom-left-radius: root.split && root.strip-h == 0 ? 10px : 0px;
        border-bottom-right-radius: root.split && root.strip-h == 0 ? 10px : 0px;
        inset-left: root.left-shown ? Float.left-w + (LayoutState.mode == WorkspaceMode.images ? 20px : 0px) + 2 * Float.gap : 0px;
        inset-right: root.right-shown ? Float.right-w + 2 * Float.gap : 0px;
        // The right column down to the bottom: only Objects (open) takes
        // the column's rest - else the bottom right is free.
        inset-right-bottom: root.right-shown && root.objects-in-column && !LayoutState.objects-folded ? Float.right-w + 2 * Float.gap : 0px;
        // The bar (objects, Z, T) and the navigator sit on the dock / table.
        inset-bottom: root.bottom-room;
    }

    // Several series and none chosen for the project: asked once (until
    // "Decide later" for this session).
    property <bool> series-later: false;
    if root.on-image && ImageMetaData.nr_series > 1 && !ImageMetaData.series-chosen && !root.series-later: SeriesChooser {
        x: (parent.width - self.width) / 2;
        y: 64px;
        later => {
            root.series-later = true;
        }
    }

    // A result's object on its image: the way back (top of the image,
    // below the annotate bar when that is open).
    if ResultsState.peek && root.on-image: ResultsPeek {
        x: (parent.width - self.width) / 2;
        y: LayoutState.annotate ? Float.gap + 44px + 8px : 12px;
    }

    // Covers only the image, never the bars.
    if PreviewRunState.shown: PreviewRendering {
        width: 100%;
        height: 100%;
    }

    // -- Left --
    if root.left-shown && LayoutState.mode == WorkspaceMode.pipelines: InkPanel {
        x: Float.gap;
        y: Float.gap;
        width: Float.left-w;
        height: parent.height - 2 * Float.gap;
        PipelinesPanel {
            vertical-stretch: 1;
        }
    }

    if root.left-shown && LayoutState.mode == WorkspaceMode.images: InkPanel {
        x: Float.gap;
        y: Float.gap;
        width: Float.left-w + 20px;
        height: parent.height - 2 * Float.gap;
        ImagesListPanel {
            vertical-stretch: 1;
        }
        InkDivider { }
        ImageMetaPanel {
            vertical-stretch: 0;
        }
    }

    // The view's panels (boards H, L, M); the analysis is picked in the
    // top bar.
    if LayoutState.mode == WorkspaceMode.results: ResultsView {
        x: 0px;
        width: root.split ? root.split-left + 4px : root.width;
    }

    // -- Split with the image: around the viewer --
    if root.split: Rectangle {
        x: root.pane-x;
        y: 12px;
        width: root.pane-w;
        height: root.pane-h - root.strip-h;
        clip: true;
        if ResultsState.split-sel.active: SplitSelection { }
        SplitImageHead {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
        }
        // Tracks: their trails and colors.
        if ResultsState.rail-mode == ResultsRailMode.tracks: SplitTracksBar {
            x: parent.width - self.width - 10px;
            y: 10px + 36px + 8px;
        }
        // Above the bar at the bottom of the image (40 px, 10 px from the edge).
        SplitHint {
            x: 10px;
            y: parent.height - self.height - 10px - 40px - 8px;
        }
    }
    if root.split && root.strip-h > 0: SplitFilmstrip {
        x: root.pane-x;
        y: 12px + root.pane-h - root.strip-h;
        width: root.pane-w;
        height: root.strip-h;
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
        clip: true;
    }
    // Rounded corners and the edge of the pane, over all of it.
    if root.split: Rectangle {
        x: root.pane-x - 1px;
        y: 11px;
        width: root.pane-w + 2px;
        height: root.pane-h + 2px;
        border-radius: 11px;
        border-width: 1px;
        border-color: #2E2E33;
    }
    // The card's mean: of the channel picked there.
    property <int> picked-channel: ChannelState.selected_channel_index < ChannelState.channels.length ? ChannelState.channels[ChannelState.selected_channel_index].idx : 0;
    changed picked-channel => {
        ResultsState.split-channel = self.picked-channel;
        ResultsState.split-channel-changed(self.picked-channel);
    }

    if root.split: SplitDivider {
        x: root.split-left;
        y: 12px;
        width: 16px;
        height: root.pane-h;
        min-left: root.split-min-left;
        max-left: root.split-max-left;
    }

    // -- Right --
    // Results, split with the image: only the image controls, over the
    // image's right side (its head's "Image"), above the navigator - the
    // same panel, not a second one.
    property <bool> split-image-panel: root.split && ResultsState.split-image-panel;
    if root.right-shown || root.split-image-panel: VerticalLayout {
        x: root.split-image-panel ? root.pane-x + root.pane-w - Float.right-w - 10px : parent.width - Float.right-w - Float.gap;
        y: root.split-image-panel ? 12px + 56px : Float.gap;
        width: Float.right-w;
        height: root.split-image-panel ? max(160px, root.pane-h - root.strip-h - 56px - 150px) : parent.height - 2 * Float.gap;
        spacing: 8px;

        // A folded panel keeps its head; Objects (open) takes the rest.
        if LayoutState.classes-open && !root.split-image-panel: InkPanel {
            vertical-stretch: 0;
            max-height: 340px;
            ClassificationPanel { }
        }

        if LayoutState.image-open || root.split-image-panel: InkPanel {
            vertical-stretch: 1;
            // No taller than its channels need: the Objects panel takes the
            // rest.
            max-height: image-control.preferred-height;
            image-control := ImageControlPanel {
                in-split: root.split-image-panel;
                vertical-stretch: 1;
            }
        }

        if root.objects-in-column && !root.split-image-panel: InkPanel {
            vertical-stretch: LayoutState.objects-folded ? 0 : 1;
            ObjectListPanel {
                vertical-stretch: LayoutState.objects-folded ? 0 : 1;
            }
        }

        // Nothing to fill the column: the panels keep their size, at the top.
        if !(root.objects-in-column && !LayoutState.objects-folded && !root.split-image-panel): Rectangle {
            vertical-stretch: 1;
        }
    }

    // Tab hid the panels: how to get them back.
    if root.on-image && LayoutState.panels-hidden: Rectangle {
        x: (parent.width - self.width) / 2;
        y: LayoutState.annotate ? Float.gap + 44px + 8px : Float.gap;
        width: hidden-row.preferred-width;
        height: 34px;
        border-radius: 17px;
        background: #1C1D22EB;
        TouchArea { }
        hidden-row := HorizontalLayout {
            padding-left: 14px;
            padding-right: 5px;
            spacing: 10px;
            alignment: center;
            Text {
                text: "Panels hidden";
                font-size: Ink.fs-body;
                color: #F4F4F5;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: tab-key.preferred-width + 10px;
                    height: 18px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #44464E;
                    background: #2A2B31;
                    tab-key := Text {
                        text: "Tab";
                        font-family: Ink.font-mono;
                        font-size: Ink.fs-caption;
                        color: #E4E4E7;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: show-text.preferred-width + 20px;
                    height: 24px;
                    border-radius: 12px;
                    background: show-ta.has-hover ? #E4E4E7 : #FFFFFF;
                    accessible-role: button;
                    accessible-label: "Show the panels";
                    accessible-action-default => {
                        LayoutState.panels-hidden = false;
                    }
                    show-text := Text {
                        text: "Show";
                        font-size: Ink.fs-secondary;
                        font-weight: 600;
                        color: #1A1A1E;
                    }
                    show-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            LayoutState.panels-hidden = false;
                        }
                    }
                }
            }
        }
    }

    // -- The selected object's details: left of the Objects list, level
    // with its selected row (inside the window) --
    if root.right-shown && root.objects-in-column && !LayoutState.objects-folded && !root.tuning-shown && ObjectListState.selected_object.id != 0: ObjectDetails {
        x: parent.width - Float.right-w - 2 * Float.gap - self.width;
        // Above the bar at the bottom of the image (40 px).
        y: clamp(ObjectDetailsPlace.row-y - root.absolute-position.y - 8px, Float.gap, max(Float.gap, parent.height - 2 * Float.gap - 40px - root.bottom-room - self.height));
        width: 260px;
    }

    // -- The objects as a table: at the bottom, between the left and the
    // right panels (design K) --
    if root.objects-table-shown: InkPanel {
        x: root.table-x;
        width: parent.width - root.table-x - Float.right-w - 2 * Float.gap;
        height: root.table-h;
        y: parent.height - self.height - Float.gap;
        ObjectListPanel {
            vertical-stretch: 1;
            table: true;
        }
    }

    // -- The pinned settings: a dock at the bottom, between the panels --
    if root.tuning-shown: InkPanel {
        x: root.dock-x;
        width: root.dock-w;
        height: root.dock-h;
        y: parent.height - self.height - Float.gap;
        TuningPanel {
            close => {
                LayoutState.tuning-hidden = true;
            }
        }
    }

    // -- An analysis ended: a note under the top bar - gone after a few
    // seconds when it went well, kept until closed when it didn't --
    if PipelineRunningState.active && PipelineRunningState.done: Rectangle {
        x: (parent.width - self.width) / 2;
        y: Float.gap + (LayoutState.annotate ? 52px : 0px) + (LayoutState.panels-hidden && root.on-image ? 42px : 0px);
        width: toast-row.preferred-width;
        height: 36px;
        border-radius: Ink.radius-lg;
        background: Ink.glass;
        border-width: 1px;
        border-color: PipelineRunningState.has-error ? Ink.err : Ink.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Ink.shadow;
        accessible-role: text;
        accessible-label: toast-text.text;
        TouchArea { }
        Timer {
            interval: 6s;
            running: !PipelineRunningState.has-error;
            triggered => {
                PipelineRunningState.close();
            }
        }
        toast-row := HorizontalLayout {
            padding-left: 14px;
            padding-right: 4px;
            spacing: 10px;
            Image {
                width: 14px;
                source: PipelineRunningState.has-error ? InkIcons.error : InkIcons.check;
                colorize: PipelineRunningState.has-error ? Ink.err : Ink.ok;
                image-fit: contain;
            }
            toast-text := Text {
                text: PipelineRunningState.has-error ? "Analysis failed · " + PipelineRunningState.status-message
                    : PipelineRunningState.images-total > 0 && PipelineRunningState.images-done == PipelineRunningState.images-total
                        ? "Analysis finished · " + PipelineRunningState.images-total + (PipelineRunningState.images-total == 1 ? " image" : " images")
                    : PipelineRunningState.status-message;
                font-size: Ink.fs-body;
                color: Ink.text;
                vertical-alignment: center;
                max-width: 560px;
                overflow: elide;
            }
            if !PipelineRunningState.has-error: VerticalLayout {
                alignment: center;
                InkButton {
                    small: true;
                    kind: InkButtonKind.primary;
                    text: "Open results";
                    clicked => {
                        PipelineRunningState.open-results();
                        LayoutState.mode = WorkspaceMode.results;
                        PipelineRunningState.close();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                InkIconButton {
                    size: 26px;
                    icon: InkIcons.close;
                    label: "Close";
                    clicked => {
                        PipelineRunningState.close();
                    }
                }
            }
        }
    }

    // -- Top --
    if LayoutState.annotate && root.on-image: AnnotateBar {
        x: (parent.width - self.width) / 2;
        y: Float.gap;
    }

    // Nothing open yet (startup, File › New): the start page over it all.
    if StartState.active: StartPage {
        width: 100%;
        height: 100%;
    }
}
