// shell/top_bar.slint — the bar at the top: the EVA menu, the quick
// actions, the image shown, the project's name, preview and Run.

import { ViewportObjectState } from "../api/viewport.slint";
import { Ink, InkScheme, InkIcons, InkSegmented, InkButton, InkButtonKind, InkIconButton, InkBarSeparator, InkMenuFrame, InkMenuItem, InkMenuCaption, InkMenuSeparator } from "../ink/ink.slint";
import { Appearance } from "../api/appearance.slint";
import { LayoutState, WorkspaceMode } from "../api/layout.slint";
import { ToolbarState } from "../api/toolbar.slint";
import { GlobalAppState, DialogType, ConnectionState, ChannelState } from "../api/state.slint";
import { PipelinesPanelState } from "../api/pipelines.slint";
import { ImageMetaData } from "../api/image_meta.slint";
import { ImagesListState } from "../api/images_list.slint";
import { AiLearningState } from "../api/ai_learning.slint";
import { ResultsBarNav, ResultsBarActions } from "../results/results_bar.slint";
import { StartState } from "../api/start.slint";
import { PipelineRunningState } from "../api/pipeline_running.slint";

// The EVA menu's open submenu: 0 none, 1 Open recent, 2 View, 3 Help.
global EvaMenu {
    in-out property <int> sub: 0;
}

// An entry of the EVA menu. Hovering it opens its submenu (`opens`, with a
// ▸) or closes the one that is open - as in any desktop menu.
component EvaMenuItem inherits InkMenuItem {
    in property <int> opens: 0;
    submenu: self.opens != 0;
    changed has-hover => {
        if self.has-hover {
            EvaMenu.sub = self.enabled ? self.opens : 0;
        }
    }
    clicked => {
        if self.opens != 0 && self.enabled {
            EvaMenu.sub = self.opens;
        }
    }
}

// "EVA ▾": opens the app's one menu.
component EvaButton inherits Rectangle {
    callback clicked;

    width: row.preferred-width + 20px;
    height: 28px;
    accessible-role: button;
    accessible-label: "EVA menu";
    accessible-action-default => {
        root.clicked();
    }

    face := Rectangle {
        border-radius: Ink.radius-md;
        background: ta.has-hover ? Ink.selection : Ink.raised;
        row := HorizontalLayout {
            alignment: center;
            spacing: 5px;
            Text {
                text: "EVA";
                font-size: Ink.fs-heading;
                font-weight: 700;
                color: Ink.text;
                vertical-alignment: center;
            }
            Image {
                source: InkIcons.caret-down;
                width: 9px;
                colorize: Ink.text-dim;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The image shown: its name; a click goes to the images.
// The image shown: its name (a click goes to the images) and, with several
// series, which one - always in view, a click lists them with their sizes.
component ImageChip inherits Rectangle {
    property <bool> has-series: ImageMetaData.nr_series > 1;

    width: min(row.preferred-width, 420px);
    height: 26px;
    accessible-role: button;
    accessible-label: "Image: " + ImageMetaData.image_name;
    accessible-action-default => {
        LayoutState.mode = WorkspaceMode.images;
    }

    face := Rectangle {
        border-radius: Ink.radius-md;
        border-width: 1px;
        border-color: Ink.border;
        clip: true;
        row := HorizontalLayout {
            spacing: 0px;
            name-part := Rectangle {
                width: name-row.preferred-width;
                background: name-ta.has-hover ? Ink.hover : transparent;
                name-row := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Image {
                        y: (parent.height - self.height) / 2;
                        source: InkIcons.images;
                        width: 13px;
                        colorize: Ink.text-mute;
                    }
                    Text {
                        max-width: 240px;
                        text: ImageMetaData.image_name;
                        font-size: Ink.fs-body;
                        font-family: Ink.font-mono;
                        color: Ink.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                name-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        LayoutState.mode = WorkspaceMode.images;
                    }
                }
            }
            if root.has-series: Rectangle {
                width: 1px;
                background: Ink.border;
            }
            if root.has-series: Rectangle {
                width: series-row.preferred-width;
                background: series-ta.has-hover ? Ink.hover : transparent;
                accessible-role: button;
                accessible-label: "Series";
                series-row := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 5px;
                    Text {
                        text: "Series " + (ChannelState.selected_series + 1) + " of " + ImageMetaData.nr_series;
                        font-size: Ink.fs-body;
                        color: Ink.text;
                        vertical-alignment: center;
                    }
                    Image {
                        y: (parent.height - self.height) / 2;
                        source: InkIcons.caret-down;
                        width: 9px;
                        colorize: Ink.text-dim;
                    }
                }
                series-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        series-menu.show();
                    }
                }
            }
        }
    }

    series-menu := PopupWindow {
        x: name-part.width;
        y: root.height + 4px;
        InkMenuFrame {
            open-y: root.absolute-position.y + root.height + 4px;
            menu-width: 240px;
            InkMenuCaption {
                text: "SERIES · FOR EVERY IMAGE";
            }
            for s[i] in ImageMetaData.series_list: InkMenuItem {
                text: s.width > 0 && s.height > 0 ? "Series \{s.idx + 1} · \{s.width} × \{s.height}" : "Series \{s.idx + 1}";
                checked: ChannelState.selected_series == s.idx;
                clicked => {
                    ChannelState.selected_series = s.idx;
                    ChannelState.trigger_active_series_changed();
                }
            }
        }
    }
}

// "● Auto preview": on, the preview follows every change.
component AutoPreviewToggle inherits Rectangle {
    property <bool> on: PipelinesPanelState.auto-preview-enabled;

    width: row.preferred-width + 20px;
    height: 28px;
    accessible-role: switch;
    accessible-label: "Auto preview";
    accessible-checked: root.on;
    accessible-action-default => {
        root.flip();
    }

    function flip() {
        PipelinesPanelState.auto-preview-enabled = !root.on;
        PipelinesPanelState.auto-preview(PipelinesPanelState.auto-preview-enabled);
    }

    face := Rectangle {
        border-radius: Ink.radius-md;
        background: ta.has-hover ? Ink.hover : transparent;
        row := HorizontalLayout {
            alignment: center;
            spacing: 6px;
            Rectangle {
                width: 7px;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.on ? Ink.ok : Ink.text-faint;
                }
            }
            Text {
                text: "Auto preview";
                font-size: Ink.fs-body;
                font-weight: 500;
                color: root.on ? Ink.text : Ink.text-dim;
                vertical-alignment: center;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.flip();
        }
    }
}

// An analysis running: in place of Auto preview and Run - progress, the
// count and the time left, Stop.
export global RunText {
    // "23 / 81 · ~4 min" (one image: its tiles).
    pure public function count() -> string {
        (PipelineRunningState.images-total > 1 ? PipelineRunningState.images-done + " / " + PipelineRunningState.images-total
            : PipelineRunningState.tiles-total > 0 ? "tile " + PipelineRunningState.tiles-done + " / " + PipelineRunningState.tiles-total
            : "starting")
        + (PipelineRunningState.eta != "" ? " · " + PipelineRunningState.eta : "")
    }
    pure public function fraction() -> float {
        PipelineRunningState.images-total > 1 ? PipelineRunningState.images-done / PipelineRunningState.images-total
            : PipelineRunningState.tiles-total > 0 ? PipelineRunningState.tiles-done / PipelineRunningState.tiles-total
            : 0
    }
}

component RunStatus inherits Rectangle {
    height: 28px;
    width: row.preferred-width;
    border-radius: Ink.radius-md;
    border-width: 1px;
    border-color: Ink.focus.with-alpha(0.3);
    background: Ink.info-tint;
    accessible-role: progress-indicator;
    accessible-label: "Analysis running, " + RunText.count();
    accessible-value: round(RunText.fraction() * 100) + "%";

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 3px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Ink.focus;
                drop-shadow-blur: 4px;
                drop-shadow-color: Ink.focus.with-alpha(0.5);
            }
        }
        Text {
            text: "Analyzing";
            font-size: Ink.fs-body;
            font-weight: 600;
            color: Ink.focus;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 120px;
                height: 6px;
                border-radius: 3px;
                background: Ink.focus.with-alpha(0.18);
                clip: true;
                Rectangle {
                    x: 0px;
                    width: parent.width * RunText.fraction();
                    background: Ink.focus;
                    animate width { duration: 200ms; }
                }
            }
        }
        Text {
            text: RunText.count();
            font-family: Ink.font-mono;
            font-size: Ink.fs-secondary;
            color: Ink.focus;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 22px;
                width: stop-text.preferred-width + 16px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Ink.border;
                background: stop-ta.has-hover ? Ink.hover : Ink.panel;
                accessible-role: button;
                accessible-label: "Stop the analysis";
                accessible-action-default => {
                    PipelineRunningState.cancel();
                }
                stop-text := Text {
                    text: "Stop";
                    font-size: Ink.fs-secondary;
                    font-weight: 600;
                    color: Ink.err;
                }
                stop-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        PipelineRunningState.cancel();
                    }
                }
            }
        }
    }
}

export component TopBar inherits Rectangle {
    /// The project's name (and an unsaved-changes mark).
    in property <string> title;
    // Results: the view and the analysis here, Export on the right (boards
    // H, L, M) - no image, preview or Run.
    property <bool> results: !StartState.active && LayoutState.mode == WorkspaceMode.results;
    // Images and Pipelines: the image, preview and Run (not on the start
    // page - nothing is open there).
    property <bool> editing: !StartState.active && !root.results;
    // An analysis in work (not yet finished).
    property <bool> running: PipelineRunningState.active && !PipelineRunningState.done;

    height: Ink.bar-h;
    background: Ink.panel;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 2px;

        VerticalLayout {
            alignment: center;
            EvaButton {
                clicked => {
                    EvaMenu.sub = 0;
                    eva-menu.show();
                }
            }
        }

        InkBarSeparator {
            y: (Ink.bar-h - self.height) / 2;
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 2px;
                InkIconButton {
                    size: 30px;
                    icon: InkIcons.undo;
                    label: "Undo";
                    keys: ["Ctrl", "Z"];
                    enabled: ToolbarState.can_undo;
                    disabled-reason: "Nothing to undo";
                    clicked => {
                        ToolbarState.undo_clicked();
                    }
                }
                InkIconButton {
                    size: 30px;
                    icon: InkIcons.redo;
                    label: "Redo";
                    keys: ["Ctrl", "Y"];
                    enabled: ToolbarState.can_redo;
                    disabled-reason: "Nothing to redo";
                    clicked => {
                        ToolbarState.redo_clicked();
                    }
                }
                Rectangle {
                    width: 30px;
                    height: 30px;
                    InkIconButton {
                        size: 30px;
                        icon: InkIcons.save;
                        label: "Save";
                        keys: ["Ctrl", "S"];
                        clicked => {
                            ToolbarState.save_file_clicked();
                        }
                    }
                    // Unsaved changes.
                    Rectangle {
                        visible: ToolbarState.has_unsaved_changes;
                        x: 20px;
                        y: 5px;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Ink.warn;
                    }
                }
                if root.editing: InkIconButton {
                    size: 30px;
                    icon: InkIcons.refresh;
                    label: "Refresh preview";
                    keys: ["F5"];
                    clicked => {
                        PipelinesPanelState.dry-run();
                    }
                }
                if root.editing: InkIconButton {
                    size: 30px;
                    icon: InkIcons.annotate;
                    label: "Annotate";
                    active: LayoutState.annotate;
                    clicked => {
                        LayoutState.annotate = !LayoutState.annotate;
                    }
                }
            }
        }

        InkBarSeparator {
            y: (Ink.bar-h - self.height) / 2;
        }

        if root.editing: VerticalLayout {
            alignment: center;
            ImageChip { }
        }

        if root.results: ResultsBarNav {
            padding-left: 6px;
        }

        if !root.editing: Rectangle {
            horizontal-stretch: 1;
        }

        if root.editing: Text {
            horizontal-stretch: 1;
            text: root.title;
            font-size: Ink.fs-body;
            color: Ink.text-mute;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.results: ResultsBarActions { }

        if root.editing: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 6px;
                // Compare the breakpoint image with the original (hold
                // Space: the original) - with a breakpoint image.
                if PipelinesPanelState.has-breakpoint-image: InkIconButton {
                    size: 28px;
                    icon: InkIcons.compare;
                    label: "Compare with the original (hold Space: original)";
                    active: ViewportObjectState.compare;
                    clicked => {
                        ViewportObjectState.compare = !ViewportObjectState.compare;
                    }
                }
                // AI training - used far more than debug mode (that one,
                // for power users, is in the EVA menu).
                InkIconButton {
                    size: 28px;
                    icon: InkIcons.ai;
                    label: "AI training…";
                    clicked => {
                        AiLearningState.open_requested();
                    }
                }
                if !root.running: AutoPreviewToggle { }
                if !root.running: InkButton {
                    text: "Run";
                    kind: InkButtonKind.primary;
                    icon: InkIcons.run;
                    clicked => {
                        PipelinesPanelState.run-all();
                    }
                }
                if root.running: VerticalLayout {
                    alignment: center;
                    RunStatus { }
                }
                VerticalLayout {
                    alignment: center;
                    InkBarSeparator { }
                }
                // Every panel away / back (Tab).
                InkIconButton {
                    size: 30px;
                    icon: LayoutState.panels-hidden ? InkIcons.panels-show : InkIcons.panels-hide;
                    label: LayoutState.panels-hidden ? "Show the panels" : "Hide all panels";
                    keys: ["Tab"];
                    active: LayoutState.panels-hidden;
                    clicked => {
                        LayoutState.panels-hidden = !LayoutState.panels-hidden;
                    }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Ink.border;
    }

    // Running: a thin line along the bar's bottom edge, the whole width.
    if root.running: Rectangle {
        y: parent.height - 3px;
        height: 3px;
        width: parent.width * RunText.fraction();
        x: 0px;
        background: Ink.focus;
        animate width { duration: 200ms; }
    }

    // The EVA menu. Rarely used groups one level down (▸, on hover or a
    // click): Open recent, View, Help - the menu stays shorter than a
    // laptop screen. The submenus are panels inside this one popup, not
    // popups of their own: Slint gives the mouse only to the topmost popup,
    // so the menu under a nested one would stop reacting.
    eva-menu := PopupWindow {
        x: 6px;
        y: Ink.bar-h - 2px;

        box := Rectangle {
            // The menu, a gap, and room for the widest submenu beside it.
            property <length> gap: 4px;
            property <length> sub-x: main.width + box.gap;
            property <length> sub-width: 280px;
            property <length> recent-y: recent-item.y - 5px;
            property <length> view-y: view-item.y - 5px;
            property <length> help-y: help-item.y - 5px;
            // Inside the menu or the open submenu: a click there isn't "outside".
            pure function on-menu(x: length, y: length) -> bool {
                if x < main.width && y < main.height {
                    return true;
                }
                if x < box.sub-x || x >= box.sub-x + box.sub-width {
                    return false;
                }
                if EvaMenu.sub == 1 {
                    return y >= box.recent-y && y < box.recent-y + recent-menu.height;
                }
                if EvaMenu.sub == 2 {
                    return y >= box.view-y && y < box.view-y + view-menu.height;
                }
                if EvaMenu.sub == 3 {
                    return y >= box.help-y && y < box.help-y + help-menu.height;
                }
                false
            }

            min-width: box.sub-x + box.sub-width;
            max-width: box.sub-x + box.sub-width;
            min-height: max(main.height, box.recent-y + recent-menu.height, box.view-y + view-menu.height, box.help-y + help-menu.height);
            max-height: self.min-height;

            // The free room beside the menu: a click there closes it, as
            // anywhere outside.
            TouchArea {
                clicked => {
                    if !box.on-menu(self.mouse-x, self.mouse-y) {
                        eva-menu.close();
                    }
                }
            }

            main := InkMenuFrame {
                x: 0px;
                y: 0px;
                width: self.menu-width;
                height: self.min-height;
                open-y: root.absolute-position.y + Ink.bar-h - 2px;
                menu-width: 290px;

                InkMenuCaption { text: "PROJECT"; }
                EvaMenuItem {
                    icon: InkIcons.add;
                    text: "New";
                    clicked => {
                        ToolbarState.new_file_clicked();
                    }
                }
                EvaMenuItem {
                    icon: InkIcons.open;
                    text: "Open…";
                    shortcut: "Ctrl O";
                    clicked => {
                        ToolbarState.open_file_clicked();
                    }
                }
                recent-item := EvaMenuItem {
                    icon: InkIcons.project;
                    text: "Open recent";
                    opens: 1;
                    enabled: StartState.recent.length > 0;
                }
                EvaMenuItem {
                    icon: InkIcons.copy;
                    text: "New from template…";
                    clicked => {
                        ToolbarState.new_from_project_template_clicked();
                    }
                }
                // The images: their folder (as in the images panel).
                EvaMenuItem {
                    icon: InkIcons.folder;
                    text: "Open images folder…";
                    shortcut: "Ctrl Shift O";
                    clicked => {
                        ImagesListState.open_images_folder_clicked();
                    }
                }

                InkMenuSeparator { }
                EvaMenuItem {
                    icon: InkIcons.save;
                    text: "Save";
                    shortcut: "Ctrl S";
                    clicked => {
                        ToolbarState.save_file_clicked();
                    }
                }
                EvaMenuItem {
                    text: "Save as…";
                    clicked => {
                        ToolbarState.save_as_file_clicked();
                    }
                }
                EvaMenuItem {
                    text: "Save as template…";
                    clicked => {
                        ToolbarState.save_project_as_template_clicked();
                    }
                }

                InkMenuSeparator { }
                EvaMenuItem {
                    icon: InkIcons.settings;
                    text: "Project settings…";
                    clicked => {
                        GlobalAppState.active-dialog = DialogType.project-settings;
                    }
                }
                EvaMenuItem {
                    icon: InkIcons.link;
                    text: "Cite project";
                    clicked => {
                        ToolbarState.cite_project_clicked();
                    }
                }

                InkMenuSeparator { }
                view-item := EvaMenuItem {
                    icon: InkIcons.panels-hide;
                    text: "View";
                    opens: 2;
                }

                InkMenuSeparator { }
                InkMenuCaption { text: "TOOLS"; }
                EvaMenuItem {
                    icon: InkIcons.ai;
                    text: "AI training…";
                    clicked => {
                        AiLearningState.open_requested();
                    }
                }
                EvaMenuItem {
                    icon: InkIcons.debug;
                    text: "Debug mode";
                    checked: PipelinesPanelState.debug-mode;
                    clicked => {
                        PipelinesPanelState.debug-mode-toggled(!PipelinesPanelState.debug-mode);
                    }
                }
                EvaMenuItem {
                    icon: InkIcons.server;
                    text: ConnectionState.remote ? "Connect to other server…" : "Connect to server…";
                    clicked => {
                        ToolbarState.connect_clicked();
                    }
                }
                // Only while connected to a server.
                if ConnectionState.remote: EvaMenuItem {
                    icon: InkIcons.computer;
                    text: "Disconnect";
                    clicked => {
                        ToolbarState.disconnect_clicked();
                    }
                }

                InkMenuSeparator { }
                help-item := EvaMenuItem {
                    icon: InkIcons.help;
                    text: "Help";
                    opens: 3;
                }
            }

            // -- The submenus, beside their row --
            recent-menu := InkMenuFrame {
                x: box.sub-x;
                y: box.recent-y;
                width: self.menu-width;
                height: self.min-height;
                menu-width: box.sub-width;
                visible: EvaMenu.sub == 1;
                for project[i] in StartState.recent: InkMenuItem {
                    icon: project.missing ? InkIcons.warning : InkIcons.project;
                    text: project.name;
                    shortcut: project.when;
                    enabled: !project.missing;
                    clicked => {
                        eva-menu.close();
                        StartState.open-recent(i);
                    }
                }
                InkMenuSeparator { }
                InkMenuItem {
                    text: "Clear the list";
                    clicked => {
                        eva-menu.close();
                        StartState.clear-recent();
                    }
                }
            }

            view-menu := InkMenuFrame {
                x: box.sub-x;
                y: box.view-y;
                width: self.menu-width;
                height: self.min-height;
                menu-width: box.sub-width;
                visible: EvaMenu.sub == 2;
                InkMenuItem {
                    text: LayoutState.mode == WorkspaceMode.images ? "Images" : "Steps";
                    checked: LayoutState.steps-open;
                    shortcut: "Alt 1";
                    clicked => {
                        LayoutState.steps-open = !LayoutState.steps-open;
                        LayoutState.panels-hidden = false;
                        LayoutState.panels-changed();
                    }
                }
                InkMenuItem {
                    text: "Classes";
                    checked: LayoutState.classes-open;
                    shortcut: "Alt 2";
                    clicked => {
                        LayoutState.classes-open = !LayoutState.classes-open;
                        LayoutState.panels-hidden = false;
                        LayoutState.panels-changed();
                    }
                }
                InkMenuItem {
                    text: "Image";
                    checked: LayoutState.image-open;
                    shortcut: "Alt 3";
                    clicked => {
                        LayoutState.image-open = !LayoutState.image-open;
                        LayoutState.panels-hidden = false;
                        LayoutState.panels-changed();
                    }
                }
                InkMenuItem {
                    text: "Objects";
                    checked: LayoutState.objects-open;
                    shortcut: "Alt 4";
                    clicked => {
                        LayoutState.objects-open = !LayoutState.objects-open;
                        LayoutState.panels-hidden = false;
                        LayoutState.panels-changed();
                    }
                }
                InkMenuItem {
                    icon: LayoutState.panels-hidden ? InkIcons.panels-show : InkIcons.panels-hide;
                    text: LayoutState.panels-hidden ? "Show the panels" : "Hide all panels";
                    shortcut: "Tab";
                    clicked => {
                        LayoutState.panels-hidden = !LayoutState.panels-hidden;
                    }
                }
                InkMenuSeparator { }
                // The navigator: by itself (only zoomed in), always, never.
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 10px;
                    Text {
                        width: 70px;
                        text: "Navigator";
                        font-size: Ink.fs-body;
                        color: Ink.text;
                        vertical-alignment: center;
                    }
                    InkSegmented {
                        horizontal-stretch: 1;
                        label: "Navigator";
                        model: ["Auto", "Always", "Never"];
                        selected: LayoutState.navigator-mode;
                        picked(i) => {
                            LayoutState.navigator-mode = i;
                            LayoutState.panels-changed();
                        }
                    }
                }
                // The colors: one row.
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 10px;
                    Text {
                        width: 70px;
                        text: "Colors";
                        font-size: Ink.fs-body;
                        color: Ink.text;
                        vertical-alignment: center;
                    }
                    InkSegmented {
                        horizontal-stretch: 1;
                        label: "Colors";
                        model: ["Light", "Dark", "Dim"];
                        selected: Ink.scheme == InkScheme.dark ? 1 : Ink.scheme == InkScheme.dim ? 2 : 0;
                        picked(i) => {
                            Appearance.pick(i == 1 ? InkScheme.dark : i == 2 ? InkScheme.dim : InkScheme.light);
                        }
                    }
                }
            }

            help-menu := InkMenuFrame {
                x: box.sub-x;
                y: box.help-y;
                width: self.menu-width;
                height: self.min-height;
                menu-width: 240px;
                visible: EvaMenu.sub == 3;
                InkMenuItem {
                    icon: InkIcons.keyboard;
                    text: "Shortcuts";
                    shortcut: "F1";
                    clicked => {
                        eva-menu.close();
                        GlobalAppState.active-dialog = DialogType.shortcuts-help;
                    }
                }
                InkMenuItem {
                    icon: InkIcons.help;
                    text: "evanalyzer.org";
                    clicked => {
                        eva-menu.close();
                        ToolbarState.open_website();
                    }
                }
                InkMenuItem {
                    icon: InkIcons.info;
                    text: "About";
                    clicked => {
                        eva-menu.close();
                        GlobalAppState.active-dialog = DialogType.about;
                    }
                }
            }
        }
    }

}
