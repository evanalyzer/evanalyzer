// shell/top_bar.slint — the bar at the top: the EVA menu, the quick
// actions, the image shown, the project's name, preview and Run.

import { ViewportObjectState } from "../api/viewport.slint";
import { Ink, InkScheme, InkIcons, InkSegmented, InkButton, InkButtonKind, InkIconButton, InkBarSeparator, InkMenuFrame, InkMenuItem, InkMenuCaption, InkMenuSeparator } from "../ink/ink.slint";
import { Appearance } from "../api/appearance.slint";
import { LayoutState, WorkspaceMode } from "../api/layout.slint";
import { ToolbarState } from "../api/toolbar.slint";
import { GlobalAppState, DialogType, ConnectionState, ChannelState } from "../api/state.slint";
import { PipelinesPanelState } from "../api/pipelines.slint";
import { ImageMetaData } from "../api/image_meta.slint";
import { ImagesListState } from "../api/images_list.slint";
import { AiLearningState } from "../api/ai_learning.slint";
import { ResultsBarNav, ResultsBarActions } from "../results/results_bar.slint";
import { StartState } from "../api/start.slint";

// "EVA ▾": opens the app's one menu.
component EvaButton inherits Rectangle {
    callback clicked;

    width: row.preferred-width + 20px;
    height: 28px;
    accessible-role: button;
    accessible-label: "EVA menu";
    accessible-action-default => {
        root.clicked();
    }

    face := Rectangle {
        border-radius: Ink.radius-md;
        background: ta.has-hover ? Ink.selection : Ink.raised;
        row := HorizontalLayout {
            alignment: center;
            spacing: 5px;
            Text {
                text: "EVA";
                font-size: 13px;
                font-weight: 700;
                color: Ink.text;
                vertical-alignment: center;
            }
            Image {
                source: InkIcons.caret-down;
                width: 9px;
                colorize: Ink.text-dim;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The image shown: its name; a click goes to the images.
// The image shown: its name (a click goes to the images) and, with several
// series, which one - always in view, a click lists them with their sizes.
component ImageChip inherits Rectangle {
    property <bool> has-series: ImageMetaData.nr_series > 1;

    width: min(row.preferred-width, 420px);
    height: 26px;
    accessible-role: button;
    accessible-label: "Image: " + ImageMetaData.image_name;
    accessible-action-default => {
        LayoutState.mode = WorkspaceMode.images;
    }

    face := Rectangle {
        border-radius: Ink.radius-md;
        border-width: 1px;
        border-color: Ink.border;
        clip: true;
        row := HorizontalLayout {
            spacing: 0px;
            name-part := Rectangle {
                width: name-row.preferred-width;
                background: name-ta.has-hover ? Ink.hover : transparent;
                name-row := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Image {
                        y: (parent.height - self.height) / 2;
                        source: InkIcons.images;
                        width: 13px;
                        colorize: Ink.text-mute;
                    }
                    Text {
                        max-width: 240px;
                        text: ImageMetaData.image_name;
                        font-size: Ink.fs-md;
                        font-family: Ink.font-mono;
                        color: Ink.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                name-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        LayoutState.mode = WorkspaceMode.images;
                    }
                }
            }
            if root.has-series: Rectangle {
                width: 1px;
                background: Ink.border;
            }
            if root.has-series: Rectangle {
                width: series-row.preferred-width;
                background: series-ta.has-hover ? Ink.hover : transparent;
                accessible-role: button;
                accessible-label: "Series";
                series-row := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 5px;
                    Text {
                        text: "Series " + (ChannelState.selected_series + 1) + " of " + ImageMetaData.nr_series;
                        font-size: Ink.fs-md;
                        color: Ink.text;
                        vertical-alignment: center;
                    }
                    Image {
                        y: (parent.height - self.height) / 2;
                        source: InkIcons.caret-down;
                        width: 9px;
                        colorize: Ink.text-dim;
                    }
                }
                series-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        series-menu.show();
                    }
                }
            }
        }
    }

    series-menu := PopupWindow {
        x: name-part.width;
        y: root.height + 4px;
        InkMenuFrame {
            open-y: root.absolute-position.y + root.height + 4px;
            menu-width: 240px;
            InkMenuCaption {
                text: "SERIES · FOR EVERY IMAGE";
            }
            for s[i] in ImageMetaData.series_list: InkMenuItem {
                text: s.width > 0 && s.height > 0 ? "Series \{s.idx + 1} · \{s.width} × \{s.height}" : "Series \{s.idx + 1}";
                checked: ChannelState.selected_series == s.idx;
                clicked => {
                    ChannelState.selected_series = s.idx;
                    ChannelState.trigger_active_series_changed();
                }
            }
        }
    }
}

// "● Auto preview": on, the preview follows every change.
component AutoPreviewToggle inherits Rectangle {
    property <bool> on: PipelinesPanelState.auto-preview-enabled;

    width: row.preferred-width + 20px;
    height: 28px;
    accessible-role: switch;
    accessible-label: "Auto preview";
    accessible-checked: root.on;
    accessible-action-default => {
        root.flip();
    }

    function flip() {
        PipelinesPanelState.auto-preview-enabled = !root.on;
        PipelinesPanelState.auto-preview(PipelinesPanelState.auto-preview-enabled);
    }

    face := Rectangle {
        border-radius: Ink.radius-md;
        background: ta.has-hover ? Ink.hover : transparent;
        row := HorizontalLayout {
            alignment: center;
            spacing: 6px;
            Rectangle {
                width: 7px;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.on ? Ink.ok : Ink.text-faint;
                }
            }
            Text {
                text: "Auto preview";
                font-size: Ink.fs-md;
                font-weight: 500;
                color: root.on ? Ink.text : Ink.text-dim;
                vertical-alignment: center;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.flip();
        }
    }
}

export component TopBar inherits Rectangle {
    /// The project's name (and an unsaved-changes mark).
    in property <string> title;
    // Results: the view and the analysis here, Export on the right (boards
    // H, L, M) - no image, preview or Run.
    property <bool> results: !StartState.active && LayoutState.mode == WorkspaceMode.results;
    // Images and Pipelines: the image, preview and Run (not on the start
    // page - nothing is open there).
    property <bool> editing: !StartState.active && !root.results;

    height: Ink.bar-h;
    background: Ink.panel;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 2px;

        VerticalLayout {
            alignment: center;
            EvaButton {
                clicked => {
                    eva-menu.show();
                }
            }
        }

        InkBarSeparator {
            y: (Ink.bar-h - self.height) / 2;
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 2px;
                InkIconButton {
                    size: 30px;
                    icon: InkIcons.undo;
                    label: "Undo";
                    enabled: ToolbarState.can_undo;
                    clicked => {
                        ToolbarState.undo_clicked();
                    }
                }
                InkIconButton {
                    size: 30px;
                    icon: InkIcons.redo;
                    label: "Redo";
                    enabled: ToolbarState.can_redo;
                    clicked => {
                        ToolbarState.redo_clicked();
                    }
                }
                Rectangle {
                    width: 30px;
                    height: 30px;
                    InkIconButton {
                        size: 30px;
                        icon: InkIcons.save;
                        label: "Save";
                        clicked => {
                            ToolbarState.save_file_clicked();
                        }
                    }
                    // Unsaved changes.
                    Rectangle {
                        visible: ToolbarState.has_unsaved_changes;
                        x: 20px;
                        y: 5px;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Ink.warn;
                    }
                }
                if root.editing: InkIconButton {
                    size: 30px;
                    icon: InkIcons.refresh;
                    label: "Refresh preview";
                    clicked => {
                        PipelinesPanelState.dry-run();
                    }
                }
                if root.editing: InkIconButton {
                    size: 30px;
                    icon: InkIcons.annotate;
                    label: "Annotate";
                    active: LayoutState.annotate;
                    clicked => {
                        LayoutState.annotate = !LayoutState.annotate;
                    }
                }
            }
        }

        InkBarSeparator {
            y: (Ink.bar-h - self.height) / 2;
        }

        if root.editing: VerticalLayout {
            alignment: center;
            ImageChip { }
        }

        if root.results: ResultsBarNav {
            padding-left: 6px;
        }

        if !root.editing: Rectangle {
            horizontal-stretch: 1;
        }

        if root.editing: Text {
            horizontal-stretch: 1;
            text: root.title;
            font-size: Ink.fs-md;
            color: Ink.text-mute;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.results: ResultsBarActions { }

        if root.editing: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 6px;
                // Compare the breakpoint image with the original (hold
                // Space: the original) - with a breakpoint image.
                if PipelinesPanelState.has-breakpoint-image: InkIconButton {
                    size: 28px;
                    icon: InkIcons.compare;
                    label: "Compare with the original (hold Space: original)";
                    active: ViewportObjectState.compare;
                    clicked => {
                        ViewportObjectState.compare = !ViewportObjectState.compare;
                    }
                }
                InkIconButton {
                    size: 28px;
                    icon: InkIcons.debug;
                    label: "Debug mode";
                    active: PipelinesPanelState.debug-mode;
                    clicked => {
                        PipelinesPanelState.debug-mode-toggled(!PipelinesPanelState.debug-mode);
                    }
                }
                AutoPreviewToggle { }
                InkButton {
                    text: "Run";
                    kind: InkButtonKind.primary;
                    icon: InkIcons.run;
                    clicked => {
                        PipelinesPanelState.run-all();
                    }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Ink.border;
    }

    eva-menu := PopupWindow {
        x: 6px;
        y: Ink.bar-h - 2px;

        InkMenuFrame {
            open-y: root.absolute-position.y + Ink.bar-h - 2px;
            menu-width: 290px;

            InkMenuCaption { text: "PROJECT"; }
            InkMenuItem {
                icon: InkIcons.add;
                text: "New";
                clicked => {
                    ToolbarState.new_file_clicked();
                }
            }
            InkMenuItem {
                icon: InkIcons.open;
                text: "Open…";
                shortcut: "Ctrl O";
                clicked => {
                    ToolbarState.open_file_clicked();
                }
            }
            InkMenuItem {
                icon: InkIcons.copy;
                text: "New from template…";
                clicked => {
                    ToolbarState.new_from_project_template_clicked();
                }
            }
            // The images: their folder (as in the images panel).
            InkMenuItem {
                icon: InkIcons.folder;
                text: "Open images folder…";
                shortcut: "Ctrl Shift O";
                clicked => {
                    ImagesListState.open_images_folder_clicked();
                }
            }
            // The last projects (the start page's list), one click away.
            if StartState.recent.length > 0: InkMenuSeparator { }
            if StartState.recent.length > 0: InkMenuCaption { text: "RECENT"; }
            for project[i] in StartState.recent: InkMenuItem {
                visible: i < 5;
                height: i < 5 ? 28px : 0px;
                icon: project.missing ? InkIcons.warning : InkIcons.project;
                text: project.name;
                shortcut: project.when;
                enabled: !project.missing;
                clicked => {
                    StartState.open-recent(i);
                }
            }
            if StartState.recent.length > 0: InkMenuSeparator { }
            InkMenuItem {
                icon: InkIcons.save;
                text: "Save";
                shortcut: "Ctrl S";
                clicked => {
                    ToolbarState.save_file_clicked();
                }
            }
            InkMenuItem {
                text: "Save as…";
                clicked => {
                    ToolbarState.save_as_file_clicked();
                }
            }
            InkMenuItem {
                text: "Save as template…";
                clicked => {
                    ToolbarState.save_project_as_template_clicked();
                }
            }
            InkMenuItem {
                icon: InkIcons.settings;
                text: "Project settings…";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.project-settings;
                }
            }
            InkMenuItem {
                icon: InkIcons.link;
                text: "Cite project";
                clicked => {
                    ToolbarState.cite_project_clicked();
                }
            }

            InkMenuSeparator { }
            InkMenuCaption { text: "TOOLS"; }
            InkMenuItem {
                icon: InkIcons.ai;
                text: "AI training…";
                clicked => {
                    AiLearningState.open_requested();
                }
            }
            InkMenuItem {
                icon: InkIcons.debug;
                text: "Debug mode";
                checked: PipelinesPanelState.debug-mode;
                clicked => {
                    PipelinesPanelState.debug-mode-toggled(!PipelinesPanelState.debug-mode);
                }
            }
            InkMenuItem {
                icon: InkIcons.server;
                text: ConnectionState.remote ? "Connect to other server…" : "Connect to server…";
                clicked => {
                    ToolbarState.connect_clicked();
                }
            }
            InkMenuItem {
                icon: InkIcons.computer;
                text: "Disconnect";
                enabled: ConnectionState.remote;
                clicked => {
                    ToolbarState.disconnect_clicked();
                }
            }

            InkMenuSeparator { }
            // The colors: one row.
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 10px;
                Text {
                    text: "Colors";
                    font-size: Ink.fs-md;
                    color: Ink.text;
                    vertical-alignment: center;
                }
                InkSegmented {
                    horizontal-stretch: 1;
                    label: "Colors";
                    model: ["Light", "Dark", "Dim"];
                    selected: Ink.scheme == InkScheme.dark ? 1 : Ink.scheme == InkScheme.dim ? 2 : 0;
                    picked(i) => {
                        Appearance.pick(i == 1 ? InkScheme.dark : i == 2 ? InkScheme.dim : InkScheme.light);
                    }
                }
            }
            InkMenuSeparator { }
            InkMenuItem {
                icon: InkIcons.keyboard;
                text: "Shortcuts";
                shortcut: "F1";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.shortcuts-help;
                }
            }
            InkMenuItem {
                icon: InkIcons.help;
                text: "evanalyzer.org";
                clicked => {
                    ToolbarState.open_website();
                }
            }
            InkMenuItem {
                icon: InkIcons.info;
                text: "About";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.about;
                }
            }
        }
    }
}
