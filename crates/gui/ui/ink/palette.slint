// ink/palette.slint — every color the UI uses, once per color scheme.
//
// The UI never writes a color literal: it reads `Ink.<token>`. Each token
// has its value per scheme (light, dark, dim) right where it's defined; a
// new scheme is one more value per token. Data colors (channels, classes)
// are not here: they come with the data.
//
// Each token is its own property bound to plain values: a view's read is
// a property read. (Grouping them in a struct made every read build the
// whole struct - 14 MB more generated code.)

// The fonts, bundled: the same type on every system.
import "../fonts/IBMPlexSans-Regular.ttf";
import "../fonts/IBMPlexSans-Medium.ttf";
import "../fonts/IBMPlexSans-SemiBold.ttf";
import "../fonts/IBMPlexSans-Bold.ttf";
import "../fonts/IBMPlexMono-Regular.ttf";
import "../fonts/IBMPlexMono-Medium.ttf";
import "../fonts/IBMPlexMono-SemiBold.ttf";

/// Which palette is in use - set from the app settings.
export enum InkScheme { light, dark, dim }

/// The design system's tokens: colors of the scheme in use, sizes, type.
export global Ink {
    in-out property <InkScheme> scheme: InkScheme.light;
    /// The window's height - kept by the main window, so popups and menus
    /// can stay inside it.
    in-out property <length> window-height: 900px;
    in-out property <length> window-width: 1440px;

    // -- The colors, one property each: light, dark, dim. A view reads
    // `Ink.text`. A new scheme is one more value per color in `pick`.
    // -- Surfaces, back to front --
    /// Around the panels, and the results views' ground.
    out property <color> ground: root.pick(#F4F4F5, #0B0B0D, #1E1E22);
    /// Behind the image - black-ish in every scheme, so fluorescence reads.
    out property <color> viewport: root.pick(#0E0F12, #000000, #0A0A0C);
    /// Panels, bars, popovers.
    out property <color> panel: root.pick(#FFFFFF, #18181B, #2A2A30);
    /// A floating panel over the image (`panel`, a little see-through).
    out property <color> glass: root.pick(#FFFFFFF2, #18181BF0, #2A2A30F0);
    /// Raised elements on a panel: the EVA button, segmented tracks.
    out property <color> raised: root.pick(#F1F1F3, #27272A, #36363D);
    /// Text fields, spinners, pickers.
    out property <color> field: root.pick(#FAFAFA, #1F1F23, #303037);
    /// Hover over a row or a quiet button.
    out property <color> hover: root.pick(#F4F4F5, #232327, #34343B);
    /// The selected row, the active tab or chip.
    out property <color> selection: root.pick(#F1F1F3, #26262B, #3A3A42);
    /// A tint of `focus` - no longer the list selection (see `row-lift`;
    /// a selected step has only a semibold name).
    out property <color> selection-row: root.pick(#E5EDFB, #2D2D41, #3E3E5A);
    /// The selected (in use) row of a list - the open image, the picked
    /// class or channel, the shown pipeline: a row lifted above the panel
    /// (white in light, one step lighter in dim / dark) with a thin ring;
    /// on the pipelines area the ring is `tray-lift-ring`. Hover keeps
    /// its tone without a ring, so the two never look alike.
    out property <color> row-lift: root.pick(#FFFFFF, #2A2A2F, #3C3C44);
    out property <color> row-lift-ring: root.pick(#D4D4D8, #3F3F46, #50505A);
    out property <color> tray-lift-ring: root.pick(#C9C9CF, #3F3F46, #50505A);
    /// The pipelines area above the steps: a tone darker than `panel`,
    /// so where the pipelines end and the steps begin shows without a line
    /// of its own; `tray-edge` is its bottom line and the switcher's outline,
    /// `tray-hover` a hovered row on it. Muted text on it is `text-dim`
    /// (`text-mute` is below 4.5:1 there).
    out property <color> tray: root.pick(#E4E4E7, #111114, #222227);
    out property <color> tray-edge: root.pick(#C9C9CF, #2E2E33, #3E3E46);
    out property <color> tray-hover: root.pick(#D8D8DC, #1D1D21, #2E2E34);
    // -- Lines --
    out property <color> border: root.pick(#E4E4E7, #2E2E33, #3E3E46);
    out property <color> border-soft: root.pick(#F0F0F2, #232327, #34343B);
    // -- Text --
    out property <color> text: root.pick(#1A1A1E, #F4F4F5, #E8E8EA);
    out property <color> text-dim: root.pick(#5A5E6A, #A1A1AA, #A8A8B0);
    out property <color> text-mute: root.pick(#686C79, #71717A, #85858E);
    out property <color> text-faint: root.pick(#A1A1AA, #52525B, #62626B);
    // -- Actions --
    /// The primary button's fill, and the text on it.
    out property <color> primary: root.pick(#18181B, #FAFAFA, #E8E8EA);
    out property <color> on-primary: root.pick(#FFFFFF, #18181B, #1E1E22);
    out property <color> primary-hover: root.pick(#27272A, #E4E4E7, #D4D4D8);
    /// Focus ring and the selected row's edge - the one accent.
    out property <color> focus: root.pick(#2A6BDF, #8B8BF0, #9A9AF2);
    out property <color> focus-ring: root.pick(#2A6BDF2E, #8B8BF040, #9A9AF240);
    /// The app icon's outer ring (icons/icon.svg) - the same in every theme.
    out property <color> brand: #5C7CFA;
    // -- State --
    out property <color> err: root.pick(#DC2626, #F87171, #F28B8B);
    out property <color> err-tint: root.pick(#FDF2F2, #3A1D1F, #45282B);
    out property <color> warn: root.pick(#D97706, #FBBF24, #F2C14E);
    out property <color> warn-tint: root.pick(#FFF6E5, #3A2E14, #453A1E);
    out property <color> ok: root.pick(#16A34A, #4ADE80, #6BD69A);
    out property <color> info: root.pick(#2A6BDF, #8B8BF0, #9A9AF2);
    out property <color> info-tint: root.pick(#EEF4FF, #26264A, #34345A);
    /// "NEW" tags.
    out property <color> new: root.pick(#D97706, #FBBF24, #F2C14E);
    out property <color> on-new: root.pick(#FFFFFF, #18181B, #1E1E22);
    // -- Step categories (the stripe on a step) --
    out property <color> cat-preprocess: root.pick(#0EA5B7, #22C3D6, #3CC4D4);
    out property <color> cat-segment: root.pick(#C04BD6, #D77AE6, #D489E2);
    out property <color> cat-object: root.pick(#E0761F, #F08C3C, #EE9A57);
    out property <color> cat-extract: root.pick(#C9A313, #E0BE3A, #DDBE52);
    // A favourite's star.
    out property <color> favorite: root.pick(#C9A313, #E0BE3A, #DDBE52);
    out property <color> cat-classify: root.pick(#2FA37C, #3FBF92, #56C29C);
    out property <color> cat-measure: root.pick(#2F7BD9, #5B9BEA, #6FA6E8);
    out property <color> cat-dataset: root.pick(#6366F1, #8B8BF0, #9A9AF2);
    out property <color> cat-module: root.pick(#E06C8B, #E8849F, #E596AB);
    // A utility step (Script, Save Image, Image Cache): fits anywhere.
    out property <color> cat-utility: root.pick(#8A8F9C, #8B8F99, #9A9EA8);
    // -- Effects --
    out property <color> shadow: root.pick(#0E0F1247, #0000008C, #00000080);
    out property <color> scrim: root.pick(#0E0F1266, #00000099, #0000008C);

    out property <bool> dark: root.scheme != InkScheme.light;

    /// The `content-y` that puts a row (its top at `top` in the content,
    /// `h` high) in the middle of a scrolled view `view-h` high over
    /// content `content-h` high, as far as the content allows - a
    /// dropdown's chosen entry when it opens.
    public pure function center-row(top: length, h: length, view-h: length, content-h: length) -> length {
        -clamp(top - (view-h - h) / 2, 0px, max(0px, content-h - view-h))
    }

    // The value of the scheme in use.
    pure function pick(light: color, dark: color, dim: color) -> color {
        root.scheme == InkScheme.dark ? dark : root.scheme == InkScheme.dim ? dim : light
    }

    // -- Radii --
    out property <length> radius-xs: 3px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 10px;

    // -- Heights of controls --
    /// Fields, spinners, pickers, list rows in panels.
    out property <length> control-h: 26px;
    /// Buttons in panels and dialogs.
    out property <length> button-h: 28px;
    /// Panel and dialog heads.
    out property <length> head-h: 40px;
    /// The top bar.
    out property <length> bar-h: 40px;
    /// The status bar.
    out property <length> status-h: 30px;
    /// A step line, a class row.
    out property <length> row-h: 30px;

    // -- Spacing --
    out property <length> gap-xs: 4px;
    out property <length> gap-sm: 6px;
    out property <length> gap-md: 8px;
    out property <length> gap-lg: 12px;
    out property <length> pad-panel: 12px;
    out property <length> pad-dialog: 14px;
    /// Width of the label column of a form row.
    out property <length> label-w: 104px;

    // -- Type --
    out property <string> font-sans: "IBM Plex Sans";
    out property <string> font-mono: "IBM Plex Mono";
    // The type scale (logical px at 100 %): nothing a person reads is
    // below 11 px - only glyphs (carets, badges) are.
    /// Start and About headings (700).
    out property <length> fs-display: 26px;
    /// Start's action cards, a command's detail in Add step (600).
    out property <length> fs-title: 16px;
    /// Card titles, recent projects; big figures (600).
    out property <length> fs-heading: 14px;
    /// Dialog, step-settings and panel titles, the pipeline name (600).
    out property <length> fs-dialog-title: 13.5px;
    /// Inputs, list / step / class rows, menus, buttons (buttons 600).
    out property <length> fs-body: 13px;
    /// Setting labels, helper text, tooltips, the status bar, summaries.
    out property <length> fs-secondary: 12px;
    /// Uppercase section and column heads (600, +0.6 px tracking), the
    /// smallest mono.
    out property <length> fs-caption: 11px;
    /// Big numbers (a well's value, About's figures).
    out property <length> fs-figure: 20px;
}
