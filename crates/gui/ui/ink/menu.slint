// ink/menu.slint — menus: the EVA menu, ⋯ menus, context menus. A menu is
// a `PopupWindow` where it's opened, holding an `InkMenuFrame` with items.
//
//     menu := PopupWindow {
//         InkMenuFrame {
//             InkMenuItem { icon: InkIcons.open; text: "Open project…"; shortcut: "Ctrl O"; }
//             InkMenuSeparator { }
//             InkMenuItem { text: "Quit"; }
//         }
//     }

import { Ink } from "palette.slint";
import { InkIcons } from "icons.slint";
import { InkNewTag } from "marker.slint";

/// The menu's card; its items go inside, one under the other.
export component InkMenuFrame inherits Rectangle {
    in property <length> menu-width: 240px;
    /// Where the menu opens, in window coordinates - the caller's
    /// `absolute-position.y` plus the popup's `y` (not read from the popup
    /// itself: Slint moves popups to fit, which would tie this to the height).
    in property <length> open-y: 0px;
    /// At most this high; taller content scrolls. By default the window's
    /// height: a menu with too little room below where it opens isn't
    /// shrunk - Slint moves the popup up into the window. Only a menu taller
    /// than the window scrolls (with a scrollbar).
    in property <length> max-menu-height: max(120px, Ink.window-height - 24px);

    property <length> menu-height: min(items.preferred-height, root.max-menu-height);
    // Constraints, not a fixed geometry: the popup sizes itself from them,
    // and clicks and hover only reach what lies inside the popup.
    min-width: root.menu-width;
    max-width: root.menu-width;
    min-height: root.menu-height;
    max-height: root.menu-height;
    background: Ink.panel;
    border-radius: Ink.radius-lg;
    border-width: 1px;
    border-color: Ink.border;
    drop-shadow-blur: 20px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: Ink.shadow;
    clip: true;

    property <bool> scrolls: items.preferred-height > root.max-menu-height + 0.5px;

    list := Flickable {
        content-height: items.preferred-height;
        interactive: root.scrolls;
        items := VerticalLayout {
            padding: 4px;
            spacing: 0px;
            @children
        }
    }

    // Too tall for the window: a soft edge where more items are, and a
    // thin scrollbar.
    if root.scrolls && list.content-y < -1px: Rectangle {
        y: 0px;
        height: 18px;
        background: @linear-gradient(180deg, Ink.panel 0%, Ink.panel.transparentize(100%) 100%);
    }
    if root.scrolls && list.content-y > list.height - list.content-height + 1px: Rectangle {
        y: parent.height - self.height;
        height: 18px;
        background: @linear-gradient(0deg, Ink.panel 0%, Ink.panel.transparentize(100%) 100%);
    }
    if root.scrolls: Rectangle {
        property <float> shown: list.height / max(1px, list.content-height);
        property <float> at: -list.content-y / max(1px, list.content-height - list.height);
        x: parent.width - 6px;
        width: 3px;
        height: max(24px, (parent.height - 8px) * self.shown);
        y: 4px + (parent.height - 8px - self.height) * clamp(self.at, 0, 1);
        border-radius: 1.5px;
        background: Ink.text-faint;
    }
}

/// One entry: an icon, the text, the shortcut or a ▸ to a submenu.
export component InkMenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    /// "Ctrl S".
    in property <string> shortcut;
    in property <bool> enabled: true;
    /// A ✓ in place of the icon.
    in property <bool> checked: false;
    /// Red - deletes something.
    in property <bool> danger: false;
    /// Opens a submenu (a ▸ at the right).
    in property <bool> submenu: false;
    /// Highlighted as if hovered - the row whose submenu is open.
    in property <bool> active: false;
    in property <bool> is-new: false;
    out property <bool> has-hover: ta.has-hover;
    callback clicked;

    height: 28px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checked: root.checked;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    face := Rectangle {
        border-radius: Ink.radius-sm;
        background: (ta.has-hover || root.active) && root.enabled ? (root.danger ? Ink.err-tint : Ink.hover) : transparent;
        opacity: root.enabled ? 1.0 : 0.45;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 10px;
            Image {
                source: root.checked ? InkIcons.check : root.icon;
                width: 15px;
                colorize: root.danger ? Ink.err : root.checked ? Ink.text : Ink.text-dim;
            }
            Text {
                text: root.text;
                font-size: Ink.fs-body;
                color: root.danger ? Ink.err : Ink.text;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            Rectangle {
                width: root.is-new ? tag.width : 0px;
                tag := InkNewTag {
                    visible: root.is-new;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: root.shortcut;
                font-size: Ink.fs-secondary;
                font-family: Ink.font-mono;
                color: Ink.text-mute;
                vertical-alignment: center;
            }
            Image {
                visible: root.submenu;
                width: root.submenu ? 10px : 0px;
                source: InkIcons.caret-right;
                colorize: Ink.text-mute;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

/// A group's caption inside a menu: "RECENT".
export component InkMenuCaption inherits Text {
    height: 24px;
    font-size: Ink.fs-caption;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: Ink.text-mute;
    vertical-alignment: center;
    x: 8px;
}

/// A line between groups of items.
export component InkMenuSeparator inherits Rectangle {
    height: 9px;
    Rectangle {
        x: 4px;
        width: parent.width - 8px;
        height: 1px;
        background: Ink.border-soft;
    }
}
