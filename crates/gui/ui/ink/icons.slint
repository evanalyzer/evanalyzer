// ink/icons.slint — every icon the UI uses, by its meaning.
//
// One icon set (Phosphor, regular weight), drawn in one color and tinted
// where it's used (`InkIcon.color`). Another set later: change the paths
// here, nothing else.

export global InkIcons {
    // -- App and files --
    out property <image> open: @image-url("../icons/regular-white/folder-open.svg");
    out property <image> folder: @image-url("../icons/regular-white/folder.svg");
    out property <image> project: @image-url("../icons/regular-white/file-text.svg");
    out property <image> project-empty: @image-url("../icons/regular-white/file-dashed.svg");
    out property <image> save: @image-url("../icons/regular-white/floppy-disk.svg");
    out property <image> undo: @image-url("../icons/regular-white/arrow-counter-clockwise.svg");
    out property <image> redo: @image-url("../icons/regular-white/arrow-clockwise.svg");
    out property <image> refresh: @image-url("../icons/regular-white/arrows-clockwise.svg");
    out property <image> export: @image-url("../icons/regular-white/export.svg");
    out property <image> download: @image-url("../icons/regular-white/download-simple.svg");
    out property <image> link: @image-url("../icons/regular-white/link.svg");
    out property <image> settings: @image-url("../icons/regular-white/gear.svg");
    out property <image> debug: @image-url("../icons/regular-white/bug.svg");
    out property <image> ai: @image-url("../icons/regular-white/brain.svg");
    out property <image> keyboard: @image-url("../icons/regular-white/keyboard.svg");
    out property <image> help: @image-url("../icons/regular-white/question.svg");
    out property <image> server: @image-url("../icons/regular-white/plugs-connected.svg");
    out property <image> computer: @image-url("../icons/regular-white/desktop.svg");
    out property <image> moon: @image-url("../icons/regular-white/moon.svg");
    out property <image> sun: @image-url("../icons/regular-white/sun.svg");

    // -- Generic actions --
    out property <image> close: @image-url("../icons/regular-white/x.svg");
    out property <image> add: @image-url("../icons/regular-white/plus.svg");
    out property <image> panels-hide: @image-url("../icons/regular-white/corners-out.svg");
    out property <image> panels-show: @image-url("../icons/regular-white/corners-in.svg");
    out property <image> lock: @image-url("../icons/regular-white/lock-simple.svg");
    out property <image> unlock: @image-url("../icons/regular-white/lock-simple-open.svg");
    out property <image> tune: @image-url("../icons/regular-white/crosshair-simple.svg");
    out property <image> overlay: @image-url("../icons/regular-white/unite.svg");
    out property <image> sparkle: @image-url("../icons/regular-white/sparkle.svg");
    out property <image> remove: @image-url("../icons/regular-white/minus.svg");
    out property <image> check: @image-url("../icons/regular-white/check.svg");
    out property <image> more: @image-url("../icons/regular-white/dots-three.svg");
    out property <image> drag: @image-url("../icons/regular-white/dots-six-vertical.svg");
    out property <image> search: @image-url("../icons/regular-white/magnifying-glass.svg");
    out property <image> filter: @image-url("../icons/regular-white/funnel.svg");
    out property <image> copy: @image-url("../icons/regular-white/copy.svg");
    out property <image> delete: @image-url("../icons/regular-white/trash.svg");
    out property <image> edit: @image-url("../icons/regular-white/pencil-simple.svg");
    out property <image> pin: @image-url("../icons/regular-white/push-pin.svg");
    out property <image> unpin: @image-url("../icons/regular-white/push-pin-slash.svg");
    out property <image> expand: @image-url("../icons/regular-white/arrows-out-simple.svg");
    out property <image> collapse: @image-url("../icons/regular-white/arrows-in-simple.svg");
    out property <image> caret-down: @image-url("../icons/regular-white/caret-down.svg");
    out property <image> caret-up: @image-url("../icons/regular-white/caret-up.svg");
    out property <image> caret-right: @image-url("../icons/regular-white/caret-right.svg");
    out property <image> caret-left: @image-url("../icons/regular-white/caret-left.svg");

    // -- State --
    out property <image> visible: @image-url("../icons/regular-white/eye.svg");
    out property <image> hidden: @image-url("../icons/regular-white/eye-slash.svg");
    out property <image> warning: @image-url("../icons/regular-white/warning.svg");
    out property <image> error: @image-url("../icons/regular-white/warning-circle.svg");
    out property <image> info: @image-url("../icons/regular-white/info.svg");
    out property <image> busy: @image-url("../icons/regular-white/circle-notch.svg");
    out property <image> open-external: @image-url("../icons/regular-white/arrow-square-out.svg");

    // -- Analysis --
    out property <image> preview: @image-url("../icons/regular-white/eye.svg");
    // The whole image previewed, not just what is in view.
    out property <image> preview-whole: @image-url("../icons/regular-white/frame-corners.svg");
    out property <image> compare: @image-url("../icons/regular-white/square-split-horizontal.svg");
    // The orthogonal views of a z-stack (XZ, YZ).
    out property <image> ortho: @image-url("../icons/regular-white/cube-transparent.svg");
    // The 3D view of a z-stack.
    out property <image> volume: @image-url("../icons/regular-white/cube.svg");
    out property <image> run: @image-url("../icons/regular-white/play.svg");
    out property <image> play: @image-url("../icons/regular-white/play.svg");
    out property <image> pause: @image-url("../icons/regular-white/pause.svg");
    out property <image> stop: @image-url("../icons/regular-white/stop.svg");
    out property <image> focus: @image-url("../icons/regular-white/target.svg");
    out property <image> module: @image-url("../icons/regular-white/diamond.svg");
    out property <image> steps: @image-url("../icons/regular-white/list.svg");
    out property <image> images: @image-url("../icons/regular-white/images.svg");
    // One image (Open image…).
    out property <image> image: @image-url("../icons/regular-white/image.svg");
    out property <image> results: @image-url("../icons/regular-white/chart-bar.svg");
    out property <image> table: @image-url("../icons/regular-white/table.svg");
    out property <image> plate: @image-url("../icons/regular-white/squares-four.svg");
    out property <image> chart: @image-url("../icons/regular-white/chart-scatter.svg");
    out property <image> classes: @image-url("../icons/regular-white/tag.svg");
    out property <image> objects: @image-url("../icons/regular-white/bounding-box.svg");
    out property <image> image-controls: @image-url("../icons/regular-white/sliders-horizontal.svg");

    // -- Annotating --
    out property <image> annotate: @image-url("../icons/regular-white/pencil-simple.svg");
    out property <image> move: @image-url("../icons/regular-white/hand.svg");
    out property <image> select: @image-url("../icons/regular-white/cursor.svg");
    out property <image> marker: @image-url("../icons/regular-white/crosshair.svg");
    out property <image> rectangle: @image-url("../icons/regular-white/rectangle.svg");
    out property <image> ellipse: @image-url("../icons/regular-white/circle.svg");
    out property <image> polygon: @image-url("../icons/regular-white/polygon.svg");
    out property <image> brush: @image-url("../icons/regular-white/paint-brush.svg");
    out property <image> eraser: @image-url("../icons/regular-white/eraser.svg");
}
