// multi_select_dropdown.slint — generic single/multi-select dropdown field.
// Replaces the various one-off pill+popup pickers scattered through the
// Results window (class filter, column visibility, ...) with one reusable
// component.
//
// Self-containment: the state that matters (which items are selected) lives
// entirely on `items` (each entry carries its own `selected` flag) and is
// mutated in place via index assignment when a row is clicked — no Rust
// round-trip needed to pick or unpick something. The one thing Slint's
// expression language genuinely cannot do on its own is touch an unbounded
// number of items at once (it has no loops/array push in expressions), so
// `select-all`/`select-none` still fire a callback for Rust to rebuild and
// hand back `items`.
import { ScrollView, LineEdit } from "std-widgets.slint";
import { Theme } from "../style.slint";

export struct MultiSelectItem {
    key: string,
    value: string,
    // Leave at its default (transparent) to render no swatch.
    color: color,
    // "" = ungrouped. Only rendered as a section when the group's name also
    // appears in the dropdown's `groups` list.
    group: string,
    selected: bool,
}

component MultiSelectCheckMark inherits Rectangle {
    in property <bool> checked;
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border-width: 1.5px;
    border-color: root.checked ? Theme.accent : Theme.border;
    background: root.checked ? Theme.accent : transparent;
    if root.checked: Image {
        source: @image-url("../icons/regular-black/check.svg");
        width: 9px;
        height: 9px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: white;
    }
}

component MultiSelectRow inherits Rectangle {
    in property <MultiSelectItem> item;
    in property <bool> show-checkbox: true;
    callback activated();

    height: 26px;
    border-radius: 4px;
    background: row-ta.has-hover ? Theme.raised : transparent;

    row-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 7px;
        cross-axis-alignment: center;

        if root.show-checkbox: MultiSelectCheckMark {
            checked: root.item.selected;
        }

        if root.item.color.alpha > 0: Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.item.color;
        }

        Text {
            text: root.item.value;
            font-size: 12px;
            color: (!root.show-checkbox && root.item.selected) ? Theme.accent : Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

export component MultiSelectDropdown inherits Rectangle {
    // -------- Data --------
    // The selectable elements; each also carries whether it's currently
    // selected. Mutated in place by this component - treat it as owned by
    // whoever holds the two-way binding, not something to rebuild on every
    // click.
    in-out property <[MultiSelectItem]> items: [];
    // Optional ordered group names to render as sections. Leave empty for a
    // flat list (in which case every item's `group` field is ignored).
    in property <[string]> groups: [];
    in property <bool> multi-select: true;
    in property <bool> show-select-all: false;
    // Shows a search box above the list and fires `filter-changed` on every
    // keystroke instead of filtering `items` in here - Slint's expression
    // language has no array `.filter()` (see the file header note), so
    // narrowing thousands of entries down to the ones matching a query has
    // to happen in Rust, the same way `select-all`/`select-none` already
    // delegate there. Off by default so small pickers (color schema, plate
    // size, ...) don't grow an unneeded search box.
    in property <bool> show-search: false;
    in-out property <string> filter-text: "";
    // Grays the pill out and blocks opening the popup — for a control that's
    // temporarily meaningless given some other selection (e.g. the Matrix
    // view's Aggregate picker while its Column is "Count", see
    // results_matrix.slint) rather than never applicable at all.
    in property <bool> enabled: true;
    in property <length> pill-height: pill-content.preferred-height;

    // -------- Formatting --------
    in property <string> label: "";
    // Caller-supplied trigger text (e.g. "All classes", "3/12 columns",
    // "Nucleus, Cell"). Kept as plain input rather than derived internally
    // since summarizing an arbitrary selection (counts, joined labels)
    // needs iteration that Slint's expression language doesn't support.
    in property <string> summary-text: "";
    in property <length> pill-width: 150px;

    // key, value, new selected state - fires for every click-driven change.
    callback item-selected(string, string, bool);
    callback select-all();
    callback select-none();
    // New search text, fired on every keystroke - the caller is expected to
    // filter its own backing data and hand back a (smaller) `items` via the
    // existing two-way binding, same as a fresh `select-all`/`select-none`
    // push. Only meaningful when `show-search` is on.
    callback filter-changed(string);

    // Tracks which row is selected when multi-select is off, so toggle()
    // can clear the previous one. Slint's imperative functions have no
    // loops (see the file header note), so the "deselect everything else"
    // step can't scan `items` directly - instead each row seeds this via
    // its own `init` below (fired once per row when `items` is populated),
    // and toggle() keeps it up to date from then on.
    property <int> single-selected-index: -1;

    // -------- Manual virtualization (ungrouped list only) --------
    // Slint has no built-in virtualized list (its own `ListView`/
    // `StandardListView` in std-widgets use the exact same "one real
    // element per model row" `for` loop this component used to) - so with
    // thousands of `items` (one per image, say), a plain `for it in
    // root.items` instantiates thousands of live rows regardless of
    // scroll position, which is what made scrolling/opening this dropdown
    // janky. Below renders a small fixed WINDOW of rows positioned at
    // their real `y` (index * row-pitch) instead, sliding the window as
    // `popup-scroll.viewport-y` changes - full row count is preserved for
    // scrollbar/flick purposes by an explicitly-sized spacer, so this
    // looks and scrolls identically to a full render, just without ever
    // materializing more than WINDOW rows at once.
    //
    // Only applied to the ungrouped path: the grouped path (column
    // pickers) interleaves section headers of varying count with rows in
    // a way that's a substantially bigger job to window correctly, and in
    // practice never approaches the item counts (images) that motivated
    // this in the first place.
    property <length> row-height: 26px;
    property <length> row-pitch: 28px; // row-height + the 2px gap the old VerticalLayout's `spacing` used to add between rows
    // 300px popup / 28px pitch ~= 11 rows actually visible - 20 leaves a
    // several-row buffer both directions so fast/flick scrolling never
    // shows a blank row before this reacts, without rendering meaningfully
    // more than what's ever on screen.
    property <int> window-size: 20;
    // `first-visible-index` itself has to live on `popup-scroll` below (see
    // its own comment) - a `PopupWindow`'s internal state (its
    // `viewport-y`) can't be read from a property declared on the
    // *enclosing* component the way `root.toggle()` etc. can be called the
    // other way around.

    function toggle(idx: int) {
        if root.multi-select {
            root.items[idx].selected = !root.items[idx].selected;
        } else {
            if root.single-selected-index >= 0 && root.single-selected-index != idx {
                root.items[root.single-selected-index].selected = false;
            }
            root.items[idx].selected = true;
            root.single-selected-index = idx;
            popup.close();
        }
        root.item-selected(root.items[idx].key,root.items[idx].value, root.items[idx].selected);
    }

    // Seeds single-selected-index from whichever row starts out selected,
    // so the first click in single-select mode also clears it (otherwise a
    // caller-supplied default selection would linger forever alongside
    // whatever the user picks).
    function note-initial-selection(idx: int, selected: bool) {
        if !root.multi-select && selected {
            root.single-selected-index = idx;
        }
    }

    width: root.pill-width;
    height: root.pill-height;

    pill := Rectangle {
        x: 0;
        y: 0;
        width: root.pill-width;
        // A plain Rectangle never hugs its children's size the way a layout
        // does, so without this `pill` (now a direct, non-layout child of
        // `root` - see the popup-anchoring note above) would resolve to
        // height 0. Bind it to the inner layout's own computed preferred
        // height instead of hand-picking a pixel value, so it keeps working
        // whether or not `label` is set.
        height: root.pill-height;
        border-radius: Theme.radius-sm;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.border-soft;
        opacity: root.enabled ? 1.0 : 0.5;

        TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { popup.show(); }
        }

        pill-content := VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 2px;

            if root.label != "": Text {
                text: root.label;
                font-size: 9px;
                letter-spacing: 0.4px;
                color: Theme.text-mute;
            }

            HorizontalLayout {
                Text {
                    text: root.summary-text;
                    font-size: 12px;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Text {
                    text: "▾";
                    font-size: 9px;
                    color: Theme.text-mute;
                    vertical-alignment: center;
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: pill.height + 4px;
        width: max(root.pill-width, 320px);
        // Default close-policy is close-on-click, i.e. clicking *any* row
        // would immediately close the popup after toggling it - unusable
        // for multi-select, where picking several items needs the popup to
        // stay open. `toggle()` above already calls `popup.close()` itself
        // for the single-select case, so close-on-click-outside (rather
        // than no-auto-close) is right for both modes.
        close-policy: close-on-click-outside;
        // PopupWindow's own `height` must be set explicitly, matching its
        // content below - leaving it to be inferred from the content
        // Rectangle's height (as it was) throws off the popup's *position*
        // (not just its size): verified by isolating this exact PopupWindow
        // shape (trigger + PopupWindow, no other content) down to a
        // standalone example and screenshotting a real window - with an
        // explicit height here the popup lands exactly at `pill.height`
        // below the pill; without it, it renders tens to well over a
        // hundred pixels too high, which is what made the top rows look
        // unclickable (they were being drawn - and hit-tested - outside
        // where they visually appeared to be).
        height: 300px;

        Rectangle {
            width: max(root.pill-width, 320px);
            height: 300px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            clip: true;

            VerticalLayout {
                spacing: 0px;
                if root.show-select-all: Rectangle {
                    height: 32px;

                    HorizontalLayout {
                        padding: 8px;
                        spacing: 10px;

                        all-ta := TouchArea {
                            width: 24px;
                            mouse-cursor: pointer;
                            clicked => { root.select-all(); }
                            Text {
                                text: "All";
                                font-size: 10.5px;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                        }

                        none-ta := TouchArea {
                            width: 34px;
                            mouse-cursor: pointer;
                            clicked => { root.select-none(); }
                            Text {
                                text: "None";
                                font-size: 10.5px;
                                color: Theme.text-mute;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    Rectangle {
                        x: 0;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.border-soft;
                    }
                }

                if root.show-search: Rectangle {
                    height: 36px;

                    HorizontalLayout {
                        padding: 6px;
                        LineEdit {
                            placeholder-text: "Search…";
                            text <=> root.filter-text;
                            edited(text) => { root.filter-changed(text); }
                        }
                    }

                    Rectangle {
                        x: 0;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.border-soft;
                    }
                }

                popup-scroll := ScrollView {
                    vertical-stretch: 1;

                    property <int> max-first-visible-index: max(0, root.items.length - root.window-size);
                    // The window's starting index: `-viewport-y` grows as
                    // the user scrolls down (see std-widgets' own
                    // `StandardListViewBase.first-visible-item()`, which
                    // computes visibility the same way), so dividing by
                    // `row-pitch` converts that scroll offset into "rows
                    // scrolled past" - minus a few rows of lookback so the
                    // window's leading edge is already rendered before it
                    // scrolls into view instead of popping in.
                    property <int> first-visible-index: max(0, min(
                        self.max-first-visible-index,
                        floor(-self.viewport-y / root.row-pitch) - 4,
                    ));

                    VerticalLayout {
                        padding: 4px;
                        spacing: 2px;

                        if root.groups.length == 0: Rectangle {
                            // Sized to the FULL (unwindowed) item count so
                            // the scrollbar/flick range covers every item,
                            // even though only `window-size` of them are
                            // ever real children below - see the
                            // "Manual virtualization" note above.
                            width: 100%;
                            height: root.items.length * root.row-pitch;

                            for i in 20: row-slot := Rectangle {
                                property <int> item-index: popup-scroll.first-visible-index + i;
                                x: 0;
                                y: row-slot.item-index * root.row-pitch;
                                width: parent.width;
                                height: root.row-pitch;
                                if row-slot.item-index >= 0 && row-slot.item-index < root.items.length: MultiSelectRow {
                                    item: root.items[row-slot.item-index];
                                    show-checkbox: root.multi-select;
                                    activated => { root.toggle(row-slot.item-index); }
                                    init => { root.note-initial-selection(row-slot.item-index, root.items[row-slot.item-index].selected); }
                                }
                            }
                        }

                        if root.groups.length > 0: VerticalLayout {
                            // 0, not 2px: this layout's direct children are
                            // one `Rectangle` per item below (mostly 0-height
                            // - see that loop's comment) plus one
                            // `VerticalLayout` per group - `spacing` is added
                            // between *every* child regardless of its own
                            // size, so at 2px here it was adding a blank gap
                            // that scaled with the total item count (mostly
                            // 0-height rows, all still counted) instead of
                            // collapsing to nothing. Each group's own header
                            // Text below already separates one section from
                            // the next visually, so no replacement gap is
                            // needed here.
                            spacing: 0px;

                            for it[idx] in root.items: Rectangle {
                                // Slint's `for` can't skip an iteration
                                // outright (no loop body shorter than one
                                // element - see the file header note on why
                                // that matters), so a non-matching item
                                // still becomes a real, always-present
                                // child of this layout; that child must be
                                // sized to occupy nothing more than a
                                // matching item's own visual gap (2px, baked
                                // into the 28px below) rather than falling
                                // back on the layout's `spacing`, which
                                // can't tell a real row from an empty one.
                                height: it.group == "" ? 28px : 0px;
                                if it.group == "": MultiSelectRow {
                                    item: it;
                                    show-checkbox: root.multi-select;
                                    activated => { root.toggle(idx); }
                                    init => { root.note-initial-selection(idx, it.selected); }
                                }
                            }

                            for g in root.groups: VerticalLayout {
                                spacing: 0px;

                                Text {
                                    text: g;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                    color: Theme.text-mute;
                                    height: 22px;
                                    vertical-alignment: center;
                                }

                                for it[idx] in root.items: Rectangle {
                                    // Same reasoning as the ungrouped loop above.
                                    height: it.group == g ? 28px : 0px;
                                    if it.group == g: MultiSelectRow {
                                        item: it;
                                        show-checkbox: root.multi-select;
                                        activated => { root.toggle(idx); }
                                        init => { root.note-initial-selection(idx, it.selected); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
