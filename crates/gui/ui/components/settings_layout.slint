// settings_layout.slint
// The layout of a settings dialog (project settings, component settings): a
// section list on the left; on the right, sections of cards whose rows have
// the setting's name and explanation on the left, its control on the right.

import { Theme } from "../style.slint";

// -- Building blocks -----------------------------------------------------------

// One entry of the section list on the left.
export component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    // Searching, and nothing in this section matches.
    in property <bool> dimmed;
    callback clicked;

    height: 32px;
    border-radius: 6px;
    background: root.active ? Theme.accent-dim : (ta.has-hover ? Theme.hover : transparent);

    Rectangle {
        x: 0;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 1.5px;
        background: root.active ? Theme.accent : transparent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: root.active ? Theme.accent : (root.dimmed ? Theme.text-faint : Theme.text-dim);
            }
        }

        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 12px;
            font-weight: root.active ? 600 : 400;
            color: root.dimmed ? Theme.text-faint : (root.active ? Theme.text : Theme.text-dim);
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component NavGroupLabel inherits Text {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: Theme.text-mute;
}

// Title of a settings section, with where its settings are kept.
export component SectionHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <string> scope;

    spacing: 4px;

    HorizontalLayout {
        spacing: 10px;

        Text {
            text: root.title;
            font-size: 16px;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: scope-text.preferred-width + 14px;
                border-radius: 9px;
                background: Theme.raised;
                scope-text := Text {
                    text: root.scope;
                    font-size: 10px;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        @children
    }

    Text {
        text: root.subtitle;
        font-size: 11px;
        color: Theme.text-dim;
        wrap: word-wrap;
    }
}

// A rounded panel the rows of a section sit on.
export component SettingsCard inherits Rectangle {
    background: Theme.panel;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-soft;
    clip: true;

    VerticalLayout {
        @children
    }
}

// One setting: name and explanation on the left, its control on the right.
// The divider on top of the first row lies on the card's own border.
export component SettingRow inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    in property <bool> enabled: true;
    in property <length> control-width: 240px;

    Rectangle {
        height: 1px;
        background: Theme.border-soft;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 24px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;

            // `height` from the text's own width: inside a horizontal layout
            // Slint measures wrapped text at the whole row's width, so it
            // would count too few lines and the dialog's scroll range would
            // end before the last setting.
            Text {
                text: root.label;
                font-size: 12px;
                font-weight: 600;
                color: root.enabled ? Theme.text : Theme.text-mute;
                wrap: word-wrap;
                height: self.preferred-height;
            }

            if root.description != "": Text {
                text: root.description;
                font-size: 11px;
                color: root.enabled ? Theme.text-dim : Theme.text-mute;
                wrap: word-wrap;
                height: self.preferred-height;
            }
        }

        VerticalLayout {
            width: root.control-width;
            alignment: center;
            @children
        }
    }
}

// A setting whose control needs the card's full width (shown below its
// name and explanation).
export component SettingBlock inherits VerticalLayout {
    in property <string> label;
    in property <string> description;

    Rectangle {
        height: 1px;
        background: Theme.border-soft;
    }

    VerticalLayout {
        padding: 16px;
        padding-top: 12px;
        spacing: 10px;

        VerticalLayout {
            spacing: 3px;
            Text {
                text: root.label;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text;
            }

            if root.description != "": Text {
                text: root.description;
                font-size: 11px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
        }

        @children
    }
}

