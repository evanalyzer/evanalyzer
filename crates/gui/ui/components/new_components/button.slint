// components/button.slint — the buttons of the views not yet rebuilt on
// Ink: `AppButton` and `IconButton` are Ink's buttons under their old
// names (`primary`, `danger`, `ghost` pick the Ink kind). New code uses
// `InkButton` / `InkIconButton` directly.

import { InkButton, InkButtonKind, InkIconButton } from "../../ink/ink.slint";

export component AppButton inherits InkButton {
    in property <bool> primary: false;
    in property <bool> danger: false;
    // No frame, no fill until hovered: a quiet action next to the others.
    in property <bool> ghost: false;

    kind: root.danger ? InkButtonKind.danger
        : root.primary ? InkButtonKind.primary
        : root.ghost ? InkButtonKind.quiet
        : InkButtonKind.secondary;
}

export component IconButton inherits InkIconButton { }
