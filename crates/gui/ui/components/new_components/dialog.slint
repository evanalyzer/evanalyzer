// components/dialog.slint — the dialogs not yet rebuilt on Ink: `Dialog`
// is Ink's dialog under its old API (`dialog-width`, `dialog-height`,
// `tone`). New code uses `InkDialog` / `InkDialogFooter`.

import { Ink, InkDialog } from "../../ink/ink.slint";

// What the dialog is about - kept for the callers; the compact Ink head
// shows no icon for it.
export enum DialogTone { none, info, warning, danger, run }

// The old dialog API on Ink's dialog.
export component Dialog inherits InkDialog {
    in property <DialogTone> tone: DialogTone.none;
    in property <length> dialog-width: 440px;
    // 0px: as high as its content (at most the window's height).
    in property <length> dialog-height: 0px;

    card-width: root.dialog-width;
    card-height: root.dialog-height;
}

// A dialog's buttons, at its bottom right - the confirming one last.
// Something before them that stretches (`horizontal-stretch: 1`) goes left.
export component DialogFooter inherits HorizontalLayout {
    alignment: end;
    spacing: 6px;
    padding-top: 4px;
}
