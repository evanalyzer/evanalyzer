// -- Keyboard shortcuts ----------------------------------------
//
// Every keyboard shortcut in the application lives in this one file, split
// into the two contexts a shortcut can fire in:
//
// - `GlobalShortcuts` - the main editing surface. Wraps the whole app body
//   in `main.slint` (same technique that file's own comment already
//   documented: wrapping the content, rather than adding a sibling
//   `FocusScope`, makes this an ancestor of every focusable widget inside
//   it, so an unhandled key press bubbles up here instead of only firing
//   when nothing has focus). Gated on no dialog being open.
// - `DialogShortcuts` - wraps the "Overlay Manager" in `main.slint` (the
//   `if active_dialog == ...` switch that renders whichever dialog is
//   currently open). Handles Escape-closes-the-open-dialog centrally, so
//   each of the ~17 dialog files doesn't need its own copy of that logic.
//
// Adding a shortcut: find the right component below and add another
// `if (...) { ...; return accept; }` branch, following the existing ones,
// AND add a matching row to `ShortcutsDoc` further down - that table drives
// the "Keyboard Shortcuts" help dialog (F1 / Help menu,
// dialogs/shortcuts_help_dialog.slint) and isn't generated from the
// `key-pressed` handlers above (Slint callbacks aren't values, so there's no
// way to enumerate "every branch below" automatically) - it only stays
// accurate if every new shortcut updates both places.
import { ModuleSettingsState } from "api/create_module.slint";
import { LayoutState, WorkspaceMode } from "api/layout.slint";
import { CommandPaletteState } from "api/command_palette.slint";
import { AnalysisRunningCloseState, ConnectState, DialogType, GlobalAppState, UnsavedChangesState } from "api/state.slint";
import { ToolbarState } from "api/toolbar.slint";
import { ToolState, ViewportObjectState } from "api/viewport.slint";
import { ImagesListState } from "api/images_list.slint";
import { ObjectListState } from "api/object_list.slint";
import { PipelineCommand, PipelinesPanelState } from "api/pipelines.slint";
import { PipelineFocusState } from "api/pipeline_focus.slint";
import { StackSteps } from "editor/viewport_stack_bar.slint";
import { PipelineDeleteConfirmState, PipelineEditState } from "api/pipeline_edit.slint";
import { TemplateMetaState } from "api/template_meta.slint";
import { RunAnalysisState } from "api/run_analysis.slint";
import { AiLearningState } from "api/ai_learning.slint";
import { ProjectSettingsState } from "api/project_settings.slint";
import { ClassificationSettingsState } from "api/classification_class_edit.slint";
import { CommandPickerState } from "api/command_selection.slint";
import { ProjectTemplateState } from "api/project_template.slint";
import { ShortcutsDoc } from "api/shortcuts.slint";
import { ExportDialogState } from "api/export.slint";
import { ResultsState } from "api/results.slint";

export component GlobalShortcuts inherits FocusScope {
    // A step line is selected (and still there).
    property <bool> step-selected: PipelinesPanelState.selected-step-id >= 0 && PipelinesPanelState.selected-step-id < PipelinesPanelState.active-commands.length;
    property <PipelineCommand> step: root.step-selected ? PipelinesPanelState.active-commands[PipelinesPanelState.selected-step-id] : { id: -1 };

    // Ctrl+F both switches to the Images tab and focuses its search field.
    // Doing the focus part in the very same key-press as the tab switch is
    // unreliable: switching tabs mounts `ImagesListPanel` fresh, and its
    // `changed focus_search_mirror` handler only fires on a value
    // *transition* it observes after that binding already exists - not on
    // the value the binding happens to capture at its very first
    // evaluation. A 1ms timer pushes the increment to the next tick, after
    // the panel has definitely finished mounting, so the change is real.
    focus-search-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            ImagesListState.focus_search_requested += 1;
        }
    }

    // See the doc comment on `GlobalAppState.reclaim_focus_requested`
    // (state.slint) - a viewport drag can strand keyboard focus away from
    // this FocusScope with nothing left to bubble a key press back to it.
    // Mirrored + `changed`, not a direct binding: this needs to run every
    // time the counter changes, not just react to its current value.
    property <int> reclaim-focus-mirror: GlobalAppState.reclaim_focus_requested;
    changed reclaim-focus-mirror => {
        self.focus();
    }

    key-released(e) => {
        if (e.text == " " && ViewportObjectState.show-before) {
            ViewportObjectState.show-before = false;
            return accept;
        }
        return reject;
    }

    key-pressed(e) => {
        // -- Compare: hold Space for the whole original --
        if (e.text == " " && !e.modifiers.control && ViewportObjectState.compare && PipelinesPanelState.has-breakpoint-image) {
            ViewportObjectState.show-before = true;
            return accept;
        }

        // Esc: an open dialog first (dialogs don't block the window).
        if (e.text == Key.Escape && GlobalAppState.active_dialog != DialogType.none && DialogEscape.close()) {
            return accept;
        }
        if (e.text == Key.Escape && ExportDialogState.active && !ExportDialogState.is-exporting) {
            ExportDialogState.close-clicked();
            ExportDialogState.active = false;
            return accept;
        }

        // -- The command palette --
        if (e.modifiers.control && e.text == "k") {
            CommandPaletteState.open = true;
            return accept;
        }

        // -- File --
        if (e.modifiers.control && e.text == "s") {
            if (e.modifiers.shift) {
                ToolbarState.save_as_file_clicked();
            } else {
                ToolbarState.save_file_clicked();
            }
            return accept;
        }
        if (e.modifiers.control && (e.text == "i" || e.text == "I")) {
            ToolbarState.open_image_clicked();
            return accept;
        }
        if (e.modifiers.control && (e.text == "o" || e.text == "O")) {
            if (e.modifiers.shift) {
                ImagesListState.open_images_folder_clicked();
            } else {
                ToolbarState.open_file_clicked();
            }
            return accept;
        }

        // -- Edit --
        if (e.modifiers.control && (e.text == "z" || e.text == "y")) {
            if (e.text == "y" || e.modifiers.shift) {
                ToolbarState.redo_clicked();
            } else {
                ToolbarState.undo_clicked();
            }
            return accept;
        }

        // -- Results, split with the image: ↑ ↓ step through the objects,
        // Esc lets go of the selected one --
        if (LayoutState.mode == WorkspaceMode.results && ResultsState.split && !e.modifiers.control && !e.modifiers.alt) {
            if (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                ResultsState.split-step(e.text == Key.UpArrow ? -1 : 1);
                return accept;
            }
            if (e.text == Key.Escape && ResultsState.split-sel.active) {
                ResultsState.split-clear();
                return accept;
            }
        }

        // -- The selected step (a click on its line) --
        if (LayoutState.mode == WorkspaceMode.pipelines && root.step-selected && !PipelinesPanelState.steps-read-only) {
            if (e.text == Key.Return && !e.modifiers.control) {
                PipelinesPanelState.open-step-settings(root.step.step-id);
                return accept;
            }
            if (e.modifiers.control && e.text == "/") {
                PipelinesPanelState.toggle-step(root.step.id);
                return accept;
            }
            if (e.text == Key.F9) {
                PipelinesPanelState.toggle-breakpoint-at(root.step.step-id);
                return accept;
            }
            if (e.modifiers.control && e.text == "d") {
                PipelinesPanelState.duplicate-step(root.step.id);
                PipelinesPanelState.selected-step-id += 1;
                return accept;
            }
            if (e.modifiers.alt && e.text == Key.UpArrow && PipelinesPanelState.selected-step-id > 0) {
                PipelinesPanelState.move-step(PipelinesPanelState.selected-step-id, -1);
                PipelinesPanelState.selected-step-id -= 1;
                return accept;
            }
            if (e.modifiers.alt && e.text == Key.DownArrow && PipelinesPanelState.selected-step-id < PipelinesPanelState.active-commands.length - 1) {
                PipelinesPanelState.move-step(PipelinesPanelState.selected-step-id, 1);
                PipelinesPanelState.selected-step-id += 1;
                return accept;
            }
            // An object selected on the image comes first (below).
            if (e.text == Key.Delete && ObjectListState.selected_object.id == 0) {
                PipelinesPanelState.remove-step(root.step.id);
                PipelinesPanelState.selected-step-id = min(PipelinesPanelState.selected-step-id, PipelinesPanelState.active-commands.length - 2);
                return accept;
            }
        }

        // Delete the selected object/ROI - mirrors the trash-can button in
        // the object list panel's footer toolbar (same guard: nothing
        // selected = no-op), which opens the same confirm dialog rather
        // than deleting immediately.
        // A pipeline object is read-only: Delete does nothing to it.
        if (e.text == Key.Delete && ObjectListState.selected_object.id != 0) {
            if (ObjectListState.selected_object.editable) {
                GlobalAppState.active_dialog = DialogType.object_confirm_delete;
            }
            return accept;
        }

        // Re-run the pipeline preview once (the toolbar's "eye" button /
        // PipelinesPanel's "Preview" tap - a single dry-run, distinct from
        // toggling Auto Preview on/off).
        if (e.text == Key.F5 && e.modifiers.shift) {
            PipelinesPanelState.preview-whole-image();
            return accept;
        }
        if (e.text == Key.F5) {
            PipelinesPanelState.dry-run();
            return accept;
        }

        // Focus on the selected pipeline (again: show everything) - the
        // keyboard twin of Alt+click on a pipeline. Plain "f": Ctrl+F is the
        // image search below.
        if (!e.modifiers.control && !e.modifiers.alt && e.text == "f") {
            PipelineFocusState.toggle-pipeline-focus(PipelinesPanelState.active-pipeline-id);
            return accept;
        }

        // -- Panels -- Tab (nothing else focused: in a field or on a
        // button it moves the focus) hides / shows them all; Alt+1…4 shows
        // or hides one.
        if e.text == Key.Tab && !e.modifiers.shift && self.has-focus {
            LayoutState.panels-hidden = !LayoutState.panels-hidden;
            return accept;
        }
        if e.modifiers.alt && !e.modifiers.control && (e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4" || e.text == "5") {
            if e.text == "1" {
                LayoutState.steps-open = !LayoutState.steps-open;
            } else if e.text == "2" {
                LayoutState.classes-open = !LayoutState.classes-open;
            } else if e.text == "3" {
                LayoutState.image-open = !LayoutState.image-open;
            } else if e.text == "4" {
                LayoutState.objects-open = !LayoutState.objects-open;
            } else {
                LayoutState.measurements-open = !LayoutState.measurements-open;
            }
            LayoutState.panels-hidden = false;
            LayoutState.panels-changed();
            return accept;
        }

        // -- Z / T -- the stack bar's ◀ ▶ (the slice only while no
        // projection is shown).
        if (e.text == Key.PageUp || e.text == Key.PageDown) && !e.modifiers.control {
            StackSteps.step-z(e.text == Key.PageUp ? -1 : 1);
            return accept;
        }
        if (e.text == "," || e.text == ".") && !e.modifiers.control {
            StackSteps.step-t(e.text == "," ? -1 : 1);
            return accept;
        }

        // -- Canvas tool modes -- first-letter mnemonics, no modifier
        // (guarded explicitly, not just by branch ordering, so this stays
        // correct regardless of what's above) so they're reachable
        // one-handed while the other hand is on the mouse. Deliberately not
        // digits: 1-4 would silently mean two unrelated things depending on
        // whether Ctrl was actually registered as held (a missed modifier,
        // a remote-desktop client eating Ctrl+digit, etc.) since Ctrl+1..4
        // already means "switch sidebar tab" below - letters share no keys
        // with that at all. K (not M) for PaintMarker since M is already
        // Move, E (Ellipse) for PaintOval since O shows / hides the objects;
        // every other letter is the tool's own first letter.
        if (!e.modifiers.control && (e.text == "m" || e.text == Key.Escape)) {
            ViewportObjectState.act_tool_state = ToolState.Move;
            return accept;
        }
        if (!e.modifiers.control && e.text == "s") {
            ViewportObjectState.act_tool_state = ToolState.Select;
            return accept;
        }
        if (!e.modifiers.control && e.text == "k") {
            ViewportObjectState.act_tool_state = ToolState.PaintMarker;
            return accept;
        }
        if (!e.modifiers.control && e.text == "r") {
            ViewportObjectState.act_tool_state = ToolState.PaintRectangle;
            return accept;
        }
        if (!e.modifiers.control && e.text == "e") {
            ViewportObjectState.act_tool_state = ToolState.PaintOval;
            return accept;
        }
        if (!e.modifiers.control && e.text == "p") {
            ViewportObjectState.act_tool_state = ToolState.PaintPolygon;
            return accept;
        }
        // A: the annotate tool bar on / off - leaving it, like its ✕, back
        // to Move.
        if (!e.modifiers.control && !e.modifiers.alt && e.text == "a") {
            LayoutState.annotate = !LayoutState.annotate;
            if !LayoutState.annotate {
                ViewportObjectState.act_tool_state = ToolState.Move;
            }
            return accept;
        }
        // O (and the older #): the objects on the image on / off.
        if (!e.modifiers.control && (e.text == "o" || e.text == "#")) {
            ViewportObjectState.show_objects = !ViewportObjectState.show_objects;
            return accept;
        }

        // -- Modes -- Ctrl+1..3, the same convention browsers use for
        // switching between a fixed row of tabs.
        if (e.modifiers.control && e.text == "1") {
            LayoutState.mode = WorkspaceMode.images;
            return accept;
        }
        if (e.modifiers.control && e.text == "2") {
            LayoutState.mode = WorkspaceMode.pipelines;
            return accept;
        }
        if (e.modifiers.control && e.text == "3") {
            LayoutState.mode = WorkspaceMode.results;
            return accept;
        }

        // Jump to the image search field, switching to Images first if it
        // isn't already showing (otherwise the field the counter below is
        // meant to focus isn't even mounted yet).
        if (e.modifiers.control && e.text == "f") {
            LayoutState.mode = WorkspaceMode.images;
            focus-search-timer.running = true;
            return accept;
        }

        // -- Help --
        if (e.text == Key.F1) {
            GlobalAppState.active_dialog = DialogType.shortcuts_help;
            return accept;
        }
        return reject;
    }
}

export component DialogShortcuts inherits FocusScope {
    // The wrapping `if (active_dialog != none): DialogShortcuts { ... }` in
    // main.slint means a fresh instance is created every time a dialog
    // opens - grab focus right away so Escape actually reaches `key-pressed`
    // below instead of whatever held focus on the main editing surface
    // before the dialog opened.
    //
    // command_selection_dialog.slint and project_template_dialog.slint each
    // have their own internal `kbd := FocusScope` with the same Escape logic
    // - but nothing ever actually calls `.focus()` on it (`forward-focus`
    // only sets the *initial* target when a window is first created, it
    // doesn't reach in and grab focus for a component instantiated later),
    // so it has never actually fired; verified by testing Escape on
    // command_selection_dialog against an unmodified checkout. Grabbing
    // focus here fixes that as a side effect - clicking any field inside the
    // dialog (e.g. its search box) still works normally afterwards, since a
    // real click always transfers Slint's internal focus regardless of what
    // held it before.
    init => {
        self.focus();
    }
    // It covers the window, but the dialogs don't block it: a press that
    // no dialog takes belongs to the window. Without this a FocusScope
    // without focus takes the press to get focus (the image couldn't be
    // panned after a click anywhere else). Esc still works after such a
    // click - `GlobalShortcuts` closes the dialog then.
    focus-on-click: false;

    key-pressed(e) => {
        if (e.text != Key.Escape) {
            return reject;
        }
        return DialogEscape.close() ? accept : reject;
    }
}

// What Esc closes: the open dialog, with what its own Cancel does. Used by
// the dialogs' FocusScope and by `GlobalShortcuts` (after a click into the
// window, which dialogs don't block, the window has the keyboard).
export global DialogEscape {
    public function close() -> bool {
        if (GlobalAppState.active_dialog == DialogType.command_selection_dialog) {
            CommandPickerState.cancel();
        } else if (GlobalAppState.active_dialog == DialogType.project_template) {
            ProjectTemplateState.cancel();
        } else if (GlobalAppState.active_dialog == DialogType.project_settings) {
            ProjectSettingsState.project_settings_canceled();
        } else if (GlobalAppState.active_dialog == DialogType.classification_edit_class_dialog) {
            ClassificationSettingsState.reset_to_zero();
            ClassificationSettingsState.anchor-y = 96px;
        } else if (GlobalAppState.active_dialog == DialogType.pipeline_edit) {
            PipelineEditState.cancel();
        } else if (GlobalAppState.active_dialog == DialogType.pipeline_delete_confirm) {
            PipelineDeleteConfirmState.cancel();
        } else if (GlobalAppState.active_dialog == DialogType.template_meta) {
            TemplateMetaState.cancel();
        } else if (GlobalAppState.active_dialog == DialogType.unsaved_changes_confirm) {
            UnsavedChangesState.cancel();
        } else if (GlobalAppState.active_dialog == DialogType.analysis_running_close) {
            AnalysisRunningCloseState.back();
        } else if (GlobalAppState.active_dialog == DialogType.connect_server) {
            ConnectState.cancel();
        } else if (GlobalAppState.active_dialog == DialogType.run_analysis_confirm) {
            RunAnalysisState.cancel();
        } else if (GlobalAppState.active_dialog == DialogType.ai_learning) {
            AiLearningState.cancel_clicked();
        } else if (GlobalAppState.active_dialog == DialogType.module_settings) {
            // Like its Cancel: the module as it was when it opened.
            ModuleSettingsState.parameter-edit-cancelled();
            ModuleSettingsState.close();
        } else if (GlobalAppState.active_dialog == DialogType.none) {
            return false;
        }
        // Every remaining dialog type (about, missing_images,
        // classification_confirm_delete, classification_confirm_delete_all,
        // classification_confirm_auto_add_dialog,
        // object_confirm_delete, warning) closes with no other side effect
        // needed - same as their own Cancel/Close/OK button.

        // Always explicit, even for the callbacks above whose own Rust
        // handler already closes the dialog itself - redundant in that case,
        // but harmless, and it means this one line is correct regardless of
        // what a given callback does or doesn't do on its own.
        GlobalAppState.active_dialog = DialogType.none;
        return true;
    }
}

// -- Shortcuts reference (for the help dialog) -----------------
//
// Plain descriptive data, not wired to anything above - see the note at the
// top of this file on keeping the two in sync by hand.
