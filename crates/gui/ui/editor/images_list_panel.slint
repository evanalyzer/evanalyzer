// editor/images_list_panel.slint — the project's images (design G): the
// count and folder in the head, Plate / List, a search; as a plate the
// wells and the chosen well's images, as a list all of them (a virtual
// list: only the rows in view exist). Selecting one opens it.

import { ImageItemData, ImagesListState, WellState } from "../api/images_list.slint";
import { LayoutState } from "../api/layout.slint";
import { PlateView, WellColor } from "plate_view.slint";
import { ListView } from "std-widgets.slint";
import { Ink, InkIcons, InkCheckbox, InkSearchField, InkBusy, InkButton, InkButtonKind, InkIconButton, InkHint, InkSegmented, InkCaption, InkDivider, InkTipZone } from "../ink/ink.slint";

// How far an image is, as a dot: analysed filled, preview an amber ring,
// new a faint ring - the legend above the list says so.
component StateDot inherits Rectangle {
    in property <WellState> state;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.state == WellState.analysed ? Ink.ok : transparent;
    border-width: root.state == WellState.preview ? 2px : root.state == WellState.new ? 1.5px : 0px;
    border-color: root.state == WellState.preview ? Ink.warn : Ink.text-faint;
}

// An image on one line: a dark square, the name, ✎ when it has hand-drawn
// objects, and its state as a dot. Size and channels are in Image info.
component ImageRow inherits Rectangle {
    in property <ImageItemData> data;
    in property <bool> selected;
    callback clicked;

    accessible-role: list-item;
    accessible-label: root.data.name + (root.data.state == WellState.analysed ? ", analysed" : root.data.state == WellState.preview ? ", preview" : "");
    accessible-item-selected: root.selected;

    // Every list's rule (ink/row.slint): hovered `row-hover`, selected the
    // lifted row with a ring.
    background: root.selected ? Ink.row-lift : ta.has-hover ? Ink.row-hover : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Ink.row-lift-ring;
    border-radius: Ink.radius-sm;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 4px;
                background: Ink.viewport;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.data.name;
            font-size: Ink.fs-body;
            font-weight: root.selected ? 600 : 400;
            color: Ink.text;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.data.has_annotations: Image {
            y: (parent.height - self.height) / 2;
            source: InkIcons.annotate;
            width: 13px;
            height: 13px;
            colorize: Ink.text-dim;
            accessible-role: text;
            accessible-label: "Has hand-drawn objects";
        }
        VerticalLayout {
            alignment: center;
            StateDot {
                state: root.data.state;
            }
        }
    }
}

// A folder's head in the list: caret, the folders above it in grey and
// its own name, ✓ for analysed images, the image count. A click folds it.
component FolderRow inherits Rectangle {
    in property <ImageItemData> data;
    // Pinned on top of the list while its images scroll by: a shadow, so
    // it floats over them.
    in property <bool> pinned;
    callback clicked;
    callback skip-toggled;

    accessible-role: button;
    accessible-label: "Folder " + root.data.folder_parent + root.data.name + ", " + root.data.count + " images";
    accessible-expandable: true;
    accessible-expanded: !root.data.collapsed;
    accessible-action-default => { root.clicked(); }

    // A band (design F2): the tray grey, 2 px off the row's top and bottom
    // so bands next to each other stand 4 px apart - no lines, visible on
    // glass too. Muted text on it is `text-dim`.
    Rectangle {
        y: 2px;
        height: parent.height - 4px;
        border-radius: Ink.radius-sm;
        background: ta.has-hover ? Ink.tray-hover : Ink.tray;
        drop-shadow-blur: root.pinned ? 6px : 0px;
        drop-shadow-offset-y: root.pinned ? 3px : 0px;
        drop-shadow-color: root.pinned ? #0E0F1229 : transparent;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;
        Image {
            y: (parent.height - self.height) / 2;
            source: root.data.collapsed ? InkIcons.caret-right : InkIcons.caret-down;
            width: 10px;
            height: 10px;
            colorize: Ink.text-dim;
            accessible-role: none;
        }
        // Analyse this folder's images (unticked: skipped by Run).
        VerticalLayout {
            alignment: center;
            InkCheckbox {
                checked: !root.data.skipped;
                accessible-label: "Analyse folder " + root.data.name;
                toggled => {
                    root.skip-toggled();
                }
            }
        }
        // Skipped: only the name greys - box and count stay readable.
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            if root.data.folder_parent != "": Text {
                // Cut first: the folder's own name stays whole.
                horizontal-stretch: 1;
                max-width: self.preferred-width;
                text: root.data.folder_parent;
                font-size: Ink.fs-body;
                color: Ink.text-dim;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                horizontal-stretch: 0;
                text: root.data.name;
                font-size: Ink.fs-body;
                font-weight: 600;
                color: root.data.skipped ? Ink.text-dim : Ink.text;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 0.0001; }
        }
        if root.data.skipped: Text {
            text: "skipped";
            font-size: Ink.fs-caption;
            color: Ink.text-dim;
            vertical-alignment: center;
        }
        if root.data.analysed > 0: Text {
            text: root.data.analysed == root.data.count ? "✓ all" : "✓ " + root.data.analysed;
            font-size: Ink.fs-caption;
            color: Ink.ok;
            vertical-alignment: center;
        }
        Text {
            min-width: 24px;
            text: root.data.count;
            font-size: Ink.fs-caption;
            font-family: Ink.font-mono;
            color: Ink.text-dim;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

export component ImagesListPanel inherits Rectangle {
    property <length> row-h: 30px;
    property <bool> plate: LayoutState.images-as-plate;
    property <int> well: ImagesListState.selected-well;
    property <string> well-name: root.well >= 0 && root.well < ImagesListState.plate-wells.length ? ImagesListState.plate-wells[root.well].name : "";

    // Ctrl+F: the search field.
    property <int> focus-search-mirror: ImagesListState.focus_search_requested;
    changed focus-search-mirror => {
        search.focus-input();
    }

    VerticalLayout {
        spacing: 0px;

        // -- Head: count · folder, Plate / List, folder, refresh --
        HorizontalLayout {
            height: Ink.head-h;
            padding-left: Ink.pad-panel;
            padding-right: 6px;
            spacing: 8px;
            Text {
                text: "Images";
                font-size: Ink.fs-body;
                font-weight: 600;
                color: Ink.text;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: ImagesListState.image-count;
                font-size: Ink.fs-caption;
                font-family: Ink.font-mono;
                color: Ink.text-mute;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                InkSegmented {
                    width: 104px;
                    label: "Show the images as";
                    model: ["Plate", "List"];
                    selected: root.plate ? 0 : 1;
                    picked(i) => {
                        LayoutState.images-as-plate = i == 0;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                InkIconButton {
                    icon: InkIcons.open;
                    label: "Select the images folder";
                    clicked => {
                        ImagesListState.open_images_folder_clicked();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                InkIconButton {
                    icon: InkIcons.refresh;
                    label: "Refresh the image list";
                    clicked => {
                        ImagesListState.refresh_images_clicked();
                    }
                }
            }
        }

        // The folder, on a line of its own (it needs the width): its start,
        // cut when too long, and its last folder whole; the whole path in a
        // tip. Another folder: the head's folder button.
        if ImagesListState.act_image_root_dir != "": Rectangle {
          height: 20px;
          path-row := HorizontalLayout {
            padding-left: Ink.pad-panel;
            padding-right: Ink.pad-panel;
            spacing: 6px;
            Image {
                y: (parent.height - self.height) / 2;
                source: InkIcons.open;
                width: 12px;
                height: 12px;
                colorize: Ink.text-mute;
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                Text {
                    horizontal-stretch: 1;
                    min-width: 24px;
                    text: ImagesListState.folder_parent(ImagesListState.act_image_root_dir);
                    font-size: Ink.fs-caption;
                    font-family: Ink.font-mono;
                    color: Ink.text-mute;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    horizontal-stretch: 0;
                    max-width: path-row.width * 0.7;
                    text: ImagesListState.folder_name(ImagesListState.act_image_root_dir);
                    font-size: Ink.fs-caption;
                    font-family: Ink.font-mono;
                    color: Ink.text-dim;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    horizontal-stretch: 0;
                }
            }
          }
          path-ta := TouchArea { }
          InkTipZone {
              width: 100%;
              height: 100%;
              wanted: path-ta.has-hover;
              text: ImagesListState.act_image_root_dir;
          }
        }

        VerticalLayout {
            padding: Ink.pad-panel;
            padding-top: 6px;
            padding-bottom: 4px;
            search := InkSearchField {
                placeholder: "Search files… (Ctrl F)";
                text: ImagesListState.filter_text;
                edited(text) => {
                    ImagesListState.filter_text = text;
                    ImagesListState.image_filter_text_changed(text);
                }
            }
        }

        // What the dots in the rows mean.
        if ImagesListState.images_list.length > 0: HorizontalLayout {
            height: 22px;
            padding-left: Ink.pad-panel + 2px;
            spacing: 14px;
            alignment: start;
            for st[i] in [WellState.analysed, WellState.preview, WellState.new]: HorizontalLayout {
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    StateDot {
                        state: st;
                    }
                }
                Text {
                    text: i == 0 ? "analysed" : i == 1 ? "preview" : "new";
                    font-size: Ink.fs-caption;
                    color: Ink.text-dim;
                    vertical-alignment: center;
                }
            }
        }

        // -- Plate: the wells, the chosen well's images --
        if root.plate: VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            VerticalLayout {
                vertical-stretch: 0;
                padding: Ink.pad-panel;
                padding-top: 6px;
                PlateView { }
            }
            InkDivider { }
            if root.well-name != "": HorizontalLayout {
                padding-left: Ink.pad-panel;
                InkCaption {
                    height: 28px;
                    text: "WELL " + root.well-name + " · " + ImagesListState.well-images.length + " IMAGES";
                }
            }
            if root.well-name == "" && ImagesListState.plate-wells.length > 0: HorizontalLayout {
                padding-left: Ink.pad-panel;
                InkHint {
                    height: 28px;
                    text: "Pick a well to see its images.";
                }
            }
            ListView {
                vertical-stretch: 1;
                for data in ImagesListState.well-images: ImageRow {
                    x: 4px;
                    width: parent.width - 8px;
                    height: root.row-h;
                    data: data;
                    clicked => {
                        ImagesListState.image_selected(data.path);
                    }
                }
            }
        }

        if !root.plate: list-box := Rectangle {
            vertical-stretch: 1;

            // A row clicked here is in view: the list stays where it is.
            // Chosen elsewhere (the image chip's picker, results, a scan),
            // the row is centred - only when it is not fully in view.
            property <int> clicked-index: -1;
            property <int> scroll-index: ImagesListState.scroll_to_image_index;
            changed scroll-index => {
                self.reveal-requested();
            }

            // Brings the requested row into view (centred) unless it is
            // already fully shown, and consumes the request.
            function reveal-requested() {
                let index = ImagesListState.scroll_to_image_index;
                if index < 0 {
                    return;
                }
                // Consumed, so the same row can be asked for again.
                ImagesListState.scroll_to_image_index = -1;
                if index == self.clicked-index {
                    self.clicked-index = -1;
                    return;
                }
                self.clicked-index = -1;
                let top = index * root.row-h + list.content-y;
                if top >= 0px && top + root.row-h <= list.visible-height {
                    return;
                }
                list.content-y = clamp(
                    -(index * root.row-h) + list.visible-height / 2 - root.row-h / 2,
                    // From the rows, not `content-height`: right after the
                    // panel is built the rows are not made yet.
                    min(0px, list.visible-height - ImagesListState.images_list.length * root.row-h),
                    0px);
            }

            list := ListView {
                x: 4px;
                width: parent.width - 8px;
                // Shown again: scrolled as it was (within the rows there are
                // now, if the list changed meanwhile).
                init => {
                    self.content-y = clamp(
                        ImagesListState.list-scroll-y,
                        min(0px, -(ImagesListState.images_list.length * root.row-h)),
                        0px);
                    // An image picked while the panel was away (e.g. from the
                    // image chip in Pipelines): its row is shown now.
                    list-box.reveal-requested();
                }
                changed content-y => {
                    ImagesListState.list-scroll-y = self.content-y;
                }
                for data[index] in ImagesListState.images_list: Rectangle {
                    height: root.row-h;
                    if data.folder: FolderRow {
                        data: data;
                        clicked => {
                            ImagesListState.folder_toggled(data.path);
                        }
                        skip-toggled => {
                            ImagesListState.folder_skip_toggled(data.path);
                        }
                    }
                    if !data.folder: ImageRow {
                        // Indented under its folder's head.
                        x: ImagesListState.images_list[0].folder ? 16px : 0px;
                        width: parent.width - self.x;
                        opacity: data.skipped ? 0.5 : 1.0;
                        data: data;
                        selected: ImagesListState.selected_image_index == index;
                        clicked => {
                            list-box.clicked-index = index;
                            ImagesListState.selected_image_index = index;
                            ImagesListState.image_selected(data.path);
                        }
                    }
                }
            }

            // The folder of the top row stays pinned on top while its images
            // scroll by; the next folder's head pushes it out (design P1).
            property <int> top-row: clamp(floor(-list.content-y / root.row-h), 0, max(0, ImagesListState.images_list.length - 1));
            property <int> head-of-top: ImagesListState.images_list.length > 0 ? ImagesListState.images_list[list-box.top-row].head : -1;
            property <int> pinned-head: list-box.head-of-top >= 0 && list-box.head-of-top < ImagesListState.images_list.length && ImagesListState.images_list[list-box.head-of-top].folder ? list-box.head-of-top : -1;
            if list-box.pinned-head >= 0 && -list.content-y > list-box.pinned-head * root.row-h: FolderRow {
                x: list.x;
                // Pushed up by the next head as it reaches the top.
                y: list-box.top-row + 1 < ImagesListState.images_list.length && ImagesListState.images_list[list-box.top-row + 1].folder
                    ? min(0px, (list-box.top-row + 1) * root.row-h + list.content-y - root.row-h)
                    : 0px;
                width: list.visible-width;
                height: root.row-h;
                data: ImagesListState.images_list[list-box.pinned-head];
                pinned: true;
                clicked => {
                    // Its head to the top first: folded, the folder stays in
                    // view instead of the next one taking its place.
                    list.content-y = -(list-box.pinned-head * root.row-h);
                    ImagesListState.folder_toggled(self.data.path);
                }
                skip-toggled => {
                    ImagesListState.folder_skip_toggled(self.data.path);
                }
            }

            if ImagesListState.images_list.length == 0 && !ImagesListState.is_scanning: VerticalLayout {
                padding: 20px;
                spacing: 10px;
                alignment: start;
                Text {
                    text: "No images yet";
                    font-size: Ink.fs-dialog-title;
                    font-weight: 600;
                    color: Ink.text;
                    horizontal-alignment: center;
                }
                InkHint {
                    text: "Select the folder with the images - TIFF, OME-TIFF, CZI, VSI …";
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    InkButton {
                        text: "Select folder";
                        kind: InkButtonKind.primary;
                        icon: InkIcons.open;
                        clicked => {
                            ImagesListState.open_images_folder_clicked();
                        }
                    }
                }
            }

            if ImagesListState.is_scanning: Rectangle {
                background: Ink.glass;
                TouchArea { }
                InkBusy {
                    size: 18px;
                }
            }
        }
    }
}
