// editor/images_list_panel.slint — the project's images: the folder they
// come from, a search, and the list (a virtual list: only the rows in view
// exist). Selecting one opens it.

import { ImageItemData, ImagesListState } from "../api/images_list.slint";
import { ListView } from "std-widgets.slint";
import { Ink, InkIcons, InkPanelHead, InkSearchField, InkListRow, InkBusy, InkButton, InkButtonKind, InkIconButton, InkHint } from "../ink/ink.slint";

export component ImagesListPanel inherits Rectangle {
    property <length> row-h: 38px;

    // Ctrl+F: the search field.
    property <int> focus-search-mirror: ImagesListState.focus_search_requested;
    changed focus-search-mirror => {
        search.focus-input();
    }

    VerticalLayout {
        spacing: 0px;

        InkPanelHead {
            title: "Images";
            count: ImagesListState.images_list.length;
            closable: false;
            add-label: "Select the images folder";
            add => {
                ImagesListState.open_images_folder_clicked();
            }
        }

        VerticalLayout {
            padding: 8px;
            padding-bottom: 4px;
            spacing: 6px;

            HorizontalLayout {
                spacing: 4px;
                search := InkSearchField {
                    placeholder: "Search images";
                    text: ImagesListState.filter_text;
                    edited(text) => {
                        ImagesListState.filter_text = text;
                        ImagesListState.image_filter_text_changed(text);
                    }
                }
                InkIconButton {
                    size: Ink.control-h;
                    icon: InkIcons.refresh;
                    label: "Refresh the image list";
                    clicked => {
                        ImagesListState.refresh_images_clicked();
                    }
                }
            }

            if ImagesListState.act_image_root_dir != "": HorizontalLayout {
                spacing: 6px;
                Image {
                    source: InkIcons.folder;
                    width: 12px;
                    colorize: Ink.text-mute;
                }
                Text {
                    horizontal-stretch: 1;
                    text: ImagesListState.act_image_root_dir;
                    font-size: Ink.fs-sm;
                    font-family: Ink.font-mono;
                    color: Ink.text-mute;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            property <int> scroll-index: ImagesListState.scroll_to_image_index;
            changed scroll-index => {
                if ImagesListState.scroll_to_image_index >= 0 {
                    list.content-y = clamp(
                        -(ImagesListState.scroll_to_image_index * root.row-h) + list.visible-height / 2 - root.row-h / 2,
                        list.visible-height - list.content-height,
                        0px);
                }
            }

            list := ListView {
                x: 4px;
                width: parent.width - 8px;
                for data[index] in ImagesListState.images_list: InkListRow {
                    height: root.row-h;
                    title: data.name;
                    subtitle: data.image_dimension + " · " + data.image_size;
                    mono: true;
                    icon: InkIcons.images;
                    // Hand-annotated objects in it.
                    mark: data.has_annotations ? Ink.focus : transparent;
                    selected: ImagesListState.selected_image_index == index;
                    clicked => {
                        ImagesListState.selected_image_index = index;
                        ImagesListState.image_selected(data.path);
                    }
                }
            }

            if ImagesListState.images_list.length == 0 && !ImagesListState.is_scanning: VerticalLayout {
                padding: 20px;
                spacing: 10px;
                alignment: start;
                Text {
                    text: "No images yet";
                    font-size: Ink.fs-lg;
                    font-weight: 600;
                    color: Ink.text;
                    horizontal-alignment: center;
                }
                InkHint {
                    text: "Select the folder with the images - TIFF, OME-TIFF, CZI, VSI …";
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    InkButton {
                        text: "Select folder";
                        kind: InkButtonKind.primary;
                        icon: InkIcons.open;
                        clicked => {
                            ImagesListState.open_images_folder_clicked();
                        }
                    }
                }
            }

            if ImagesListState.is_scanning: Rectangle {
                background: Ink.glass;
                TouchArea { }
                InkBusy {
                    size: 18px;
                }
            }
        }
    }
}
