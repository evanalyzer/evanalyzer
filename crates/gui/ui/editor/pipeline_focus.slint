// pipeline_focus.slint
// EVAnalyzer - Pipeline focus: show only the selected pipeline's image
// channel and object classes. See `FocusController` on the Rust side.
import { PipelineFocusState } from "../api/pipeline_focus.slint";

import { Ink, InkIcons, InkIconButton } from "../ink/ink.slint";

// Shown above the channel and class lists while a pipeline is focused, so
// hidden channels/classes never look like a bug.
export component FocusBanner inherits Rectangle {
    property <bool> on: PipelineFocusState.focused-pipeline-name != "";

    height: root.on ? 26px : 0px;

    face := Rectangle {
        visible: root.on;
        border-radius: Ink.radius-md;
        background: Ink.info-tint;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 4px;
            spacing: 6px;

            Image {
                source: InkIcons.focus;
                width: 12px;
                colorize: Ink.focus;
            }

            Text {
                horizontal-stretch: 1;
                text: "Focused on “" + PipelineFocusState.focused-pipeline-name + "”";
                font-size: Ink.fs-secondary;
                color: Ink.text;
                vertical-alignment: center;
                overflow: elide;
            }

            show-all := Rectangle {
                width: show-all-text.preferred-width + 12px;
                border-radius: Ink.radius-sm;
                background: show-all-ta.has-hover ? Ink.focus-ring : transparent;
                accessible-role: button;
                accessible-label: "Show all";
                show-all-text := Text {
                    text: "Show all";
                    font-size: Ink.fs-secondary;
                    font-weight: 600;
                    color: Ink.focus;
                }
                show-all-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        PipelineFocusState.exit();
                    }
                }
            }
        }
    }
}

// Switches focus mode on/off; marked while on.
export component FocusModeButton inherits Rectangle {
    width: 24px;
    height: 24px;
    InkIconButton {
        size: 24px;
        icon: InkIcons.focus;
        label: "Focus mode";
        active: PipelineFocusState.enabled;
        tint: PipelineFocusState.enabled ? Ink.focus : transparent;
        clicked => {
            PipelineFocusState.toggle-mode();
        }
    }
}
