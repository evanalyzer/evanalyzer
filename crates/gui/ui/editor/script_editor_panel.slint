import { Places } from "../api/layout.slint";
// Script editor for `ParamType.script` step settings (Rhai scripts).
//
// Syntax highlighting: Slint's `TextInput` draws its text in one color, so
// the editable text is drawn in the default color and one `Text` layer per
// token kind is drawn on top of it. Each layer holds the whole script with
// every character that is not of its kind replaced by a space (newlines and
// tabs kept), so with a monospace font every layer lines up exactly with the
// `TextInput` underneath. The layers come from Rust (`highlight`), as do
// formatting, syntax check and the Tab/Enter/"}" editing helpers.
import { InkButton, InkButtonKind, InkDialog, InkDialogFooter, InkDialogPlacement } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { ScriptCommandDoc, ScriptDiagnostic, ScriptEdit, ScriptEditorState, ScriptFont, ScriptHighlight } from "../api/script_editor.slint";

import { ListView } from "std-widgets.slint";
import { LineEdit } from "../ink/std_compat.slint";
import { Ink } from "../ink/palette.slint";
// Embedded so the editor is monospace on every system - the highlight layers
// only line up with the text when every character has the same width.
import "../fonts/DejaVuSansMono.ttf";

component HighlightLayer inherits Text {
    font-family: ScriptFont.family;
    wrap: no-wrap;
    overflow: clip;
    horizontal-alignment: left;
    vertical-alignment: top;
}

export component ScriptEditorPanel inherits InkDialog {
    // Next to the steps panel.
    anchor-x: Places.beside-left;
    // Docked on the right; the image stays usable.
    placement: InkDialogPlacement.sheet;
    // Syntax colors, readable on both themes.
    property <color> c-keyword: Ink.dark ? #C586C0 : #AF00DB;
    property <color> c-function: Ink.dark ? #DCDCAA : #795E26;
    property <color> c-string: Ink.dark ? #CE9178 : #A31515;
    property <color> c-number: Ink.dark ? #B5CEA8 : #098658;
    property <color> c-comment: Ink.dark ? #6A9955 : #008000;
    property <length> code-font-size: Ink.fs-body;
    property <length> pad: 6px;
    // Distance the cursor keeps from the visible edge while scrolling.
    property <length> margin: 2 * root.code-font-size;

    property <ScriptHighlight> hl: ScriptEditorState.highlight(editor.text);
    property <ScriptDiagnostic> diag: ScriptEditorState.check(editor.text);
    property <[ScriptCommandDoc]> commands: ScriptEditorState.filter-commands(search.text);
    property <string> selected-key;
    property <string> selected-doc;

    function insert-command(key: string) {
        root.set-edit(ScriptEditorState.insert-command(editor.text, editor.cursor-position-byte-offset, key));
        editor.focus();
    }

    function set-edit(edit: ScriptEdit) {
        editor.text = edit.text;
        editor.set-selection-offsets(edit.cursor, edit.cursor);
    }

    function format-script() {
        editor.text = ScriptEditorState.format(editor.text);
        editor.set-selection-offsets(0, 0);
    }

    title: ScriptEditorState.title;
    card-width: 900px;
    card-height: 800px;
    // Deliberately no cancel on a click outside or Esc: neither may throw
    // away an edited script. ✕ is Cancel.
    close-on-escape: false;
    close => {
        ScriptEditorState.cancel();
    }

            // -- Title + toolbar --
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: "Tab indent · Ctrl+Shift+F format · Rhai";
                    font-size: Ink.fs-secondary;
                    color: Ink.text-mute;
                    vertical-alignment: center;
                }

                InkButton {
                    text: "Format";
                    clicked => {
                        root.format-script();
                    }
                }
            }

            HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;

            // -- Code area --
            Rectangle {
                horizontal-stretch: 1;
                background: Ink.ground;
                border-radius: 6px;
                border-width: 1px;
                border-color: editor.has-focus ? Ink.focus.with-alpha(0.6) : Ink.border;
                clip: true;

                HorizontalLayout {
                    padding: 1px;

                    // Line numbers, scrolled along with the code.
                    Rectangle {
                        width: 44px;
                        background: Ink.raised;
                        clip: true;
                        Text {
                            x: 0px;
                            y: flick.content-y + root.pad;
                            width: parent.width - 8px;
                            text: root.hl.line-numbers;
                            font-family: ScriptFont.family;
                            font-size: root.code-font-size;
                            color: Ink.text-mute;
                            horizontal-alignment: right;
                            vertical-alignment: top;
                            wrap: no-wrap;
                        }
                    }

                    flick := Flickable {
                        content-width: max(self.width, editor.preferred-width + 2 * root.pad + 40px);
                        content-height: max(self.height, editor.preferred-height + 2 * root.pad + 40px);

                        // Clicking below the last line still focuses the editor.
                        TouchArea {
                            mouse-cursor: text;
                            clicked => {
                                editor.focus();
                            }
                        }

                        editor := TextInput {
                            x: root.pad;
                            y: root.pad;
                            width: flick.content-width - 2 * root.pad;
                            height: flick.content-height - 2 * root.pad;
                            text: ScriptEditorState.source;
                            single-line: false;
                            wrap: no-wrap;
                            font-family: ScriptFont.family;
                            font-size: root.code-font-size;
                            color: Ink.text;
                            selection-background-color: Ink.focus.with-alpha(0.35);
                            selection-foreground-color: Ink.text;
                            init => {
                                self.focus();
                            }

                            // Keep the cursor in view.
                            cursor-position-changed(pos) => {
                                if (pos.x + flick.content-x + self.x < root.margin) {
                                    flick.content-x = min(0px, -(pos.x + self.x - root.margin));
                                } else if (pos.x + flick.content-x + self.x > flick.width - root.margin) {
                                    flick.content-x = max(flick.width - flick.content-width, -(pos.x + self.x + root.margin - flick.width));
                                }
                                if (pos.y + flick.content-y + self.y < root.margin) {
                                    flick.content-y = min(0px, -(pos.y + self.y - root.margin));
                                } else if (pos.y + flick.content-y + self.y > flick.height - root.margin) {
                                    flick.content-y = max(flick.height - flick.content-height, -(pos.y + self.y + root.margin - flick.height));
                                }
                            }

                            key-pressed(e) => {
                                if (e.modifiers.control && e.modifiers.shift && (e.text == "f" || e.text == "F")) {
                                    root.format-script();
                                    return accept;
                                }
                                if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta) {
                                    return reject;
                                }
                                // Tab with a selection is left to Slint (no block indent yet).
                                if (e.text == Key.Tab && !e.modifiers.shift
                                    && self.cursor-position-byte-offset == self.anchor-position-byte-offset) {
                                    root.set-edit(ScriptEditorState.indent(self.text, self.cursor-position-byte-offset));
                                    return accept;
                                }
                                if (e.text == Key.Return && !e.modifiers.shift
                                    && self.cursor-position-byte-offset == self.anchor-position-byte-offset) {
                                    root.set-edit(ScriptEditorState.newline(self.text, self.cursor-position-byte-offset));
                                    return accept;
                                }
                                if ((e.text == "}" || e.text == ")" || e.text == "]")
                                    && self.cursor-position-byte-offset == self.anchor-position-byte-offset) {
                                    root.set-edit(ScriptEditorState.close-bracket(self.text, self.cursor-position-byte-offset, e.text));
                                    return accept;
                                }
                                reject
                            }
                        }

                        // Highlight layers, drawn over the editor's own text.
                        HighlightLayer {
                            x: editor.x;
                            y: editor.y;
                            width: editor.width;
                            height: editor.height;
                            font-size: root.code-font-size;
                            text: root.hl.comments;
                            color: root.c-comment;
                        }

                        HighlightLayer {
                            x: editor.x;
                            y: editor.y;
                            width: editor.width;
                            height: editor.height;
                            font-size: root.code-font-size;
                            text: root.hl.strings;
                            color: root.c-string;
                        }

                        HighlightLayer {
                            x: editor.x;
                            y: editor.y;
                            width: editor.width;
                            height: editor.height;
                            font-size: root.code-font-size;
                            text: root.hl.numbers;
                            color: root.c-number;
                        }

                        HighlightLayer {
                            x: editor.x;
                            y: editor.y;
                            width: editor.width;
                            height: editor.height;
                            font-size: root.code-font-size;
                            text: root.hl.keywords;
                            color: root.c-keyword;
                        }

                        HighlightLayer {
                            x: editor.x;
                            y: editor.y;
                            width: editor.width;
                            height: editor.height;
                            font-size: root.code-font-size;
                            text: root.hl.functions;
                            color: root.c-function;
                        }
                    }
                }
            }

            // -- Command reference --
            VerticalLayout {
                width: 280px;
                spacing: 6px;

                search := LineEdit {
                    placeholder-text: "Search commands";
                    font-size: Ink.fs-secondary;
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Ink.border;
                    clip: true;

                    ListView {
                        for cmd in root.commands: Rectangle {
                            height: 34px;
                            background: cmd.key == root.selected-key ? Ink.focus.with-alpha(0.18) : (cmd-ta.has-hover ? Ink.raised : transparent);
                            VerticalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                Text {
                                    text: cmd.name;
                                    font-size: Ink.fs-secondary;
                                    color: Ink.text;
                                    overflow: elide;
                                }

                                Text {
                                    text: cmd.key;
                                    font-size: Ink.fs-caption;
                                    font-family: ScriptFont.family;
                                    color: Ink.text-mute;
                                    overflow: elide;
                                }
                            }

                            cmd-ta := TouchArea {
                                clicked => {
                                    root.selected-key = cmd.key;
                                    root.selected-doc = cmd.doc;
                                }
                                double-clicked => {
                                    root.insert-command(cmd.key);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 180px;
                    border-radius: 6px;
                    background: Ink.raised;
                    clip: true;
                    Flickable {
                        content-height: max(self.height, doc-text.preferred-height + 16px);
                        doc-text := Text {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            text: root.selected-key == "" ? "Select a command to see its parameters. Double-click or Insert adds it at the cursor." : root.selected-doc;
                            font-size: Ink.fs-caption;
                            color: Ink.text-dim;
                            wrap: word-wrap;
                            vertical-alignment: top;
                        }
                    }
                }

                InkButton {
                    text: "Insert at cursor";
                    enabled: root.selected-key != "";
                    disabled-reason: "Pick an entry first";
                    clicked => {
                        root.insert-command(root.selected-key);
                    }
                }
            }
            }

            // -- Syntax check --
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.diag.ok ? "✓" : "✕";
                    font-size: Ink.fs-body;
                    color: root.diag.ok ? Ink.ok : Ink.err;
                    vertical-alignment: center;
                }

                Text {
                    text: root.diag.ok ? "No syntax errors" : (root.diag.line > 0 ? "Line \{root.diag.line}: \{root.diag.message}" : root.diag.message);
                    font-size: Ink.fs-secondary;
                    color: root.diag.ok ? Ink.text-dim : Ink.err;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            // -- Footer --
            InkDialogFooter {
                InkButton {
                    text: "Cancel";
                    clicked => {
                        ScriptEditorState.cancel();
                    }
                }

                InkButton {
                    kind: InkButtonKind.primary;
                    text: "Apply";
                    clicked => {
                        ScriptEditorState.apply(editor.text);
                    }
                }
            }
}
