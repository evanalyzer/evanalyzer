// editor/classification_panel.slint — the Classes panel: every class with
// its color, id, object count and visibility. Select one to paint into it;
// ⋯ (or a right-click) on a class edits, copies, moves or deletes it; the
// head's ⋯ adds the classes found in the images.

import { DialogType, GlobalAppState } from "../api/state.slint";
import { ImagesListState } from "../api/images_list.slint";
import { ClassificationSettingsState } from "../api/classification_class_edit.slint";
import { ToolState, ViewportObjectState } from "../api/viewport.slint";
import { ClassItemData, ClassificationState } from "../api/classification.slint";
import { Ink, InkIcons, InkPanelHead, InkListRow, InkBusy, InkMenuFrame, InkMenuItem, InkMenuCaption, InkMenuSeparator, InkHint } from "../ink/ink.slint";
import { FocusBanner } from "pipeline_focus.slint";

export component ClassificationPanel inherits Rectangle {
    // The class the row menu is for.
    property <int> menu-class-id: -1;
    property <string> menu-class-name;
    property <length> menu-x;
    property <length> menu-y;

    function select(data: ClassItemData) {
        if data.id == ClassificationState.selected_class_id {
            ClassificationState.selected_class_name = "";
            ClassificationState.selected_class_id = -1;
            ClassificationState.class_selected(-1);
            ViewportObjectState.act_tool_state = ToolState.Move;
        } else {
            ClassificationState.selected_class_name = data.name;
            ClassificationState.selected_class_id = data.id;
            ClassificationState.class_selected(data.id);
        }
    }

    // Row actions act on the selected class (the Rust side and the dialogs
    // read it): select the menu's class first.
    function select-id(id: int, name: string) {
        if id != ClassificationState.selected_class_id {
            ClassificationState.selected_class_name = name;
            ClassificationState.selected_class_id = id;
            ClassificationState.class_selected(id);
        }
    }

    preferred-height: layout.preferred-height;

    layout := VerticalLayout {
        spacing: 0px;

        head := InkPanelHead {
            title: "Classes";
            count: ClassificationState.classes_list.length;
            closable: false;
            add-label: "New class";
            has-more: true;
            add => {
                ClassificationSettingsState.reset_to_zero();
                GlobalAppState.active_dialog = DialogType.classification-edit-class-dialog;
            }
            more(x, y) => {
                list-menu.show();
            }
        }

        VerticalLayout {
            padding: 4px;
            spacing: 4px;

            FocusBanner { }

            Rectangle {
                vertical-stretch: 1;
                min-height: 60px;
                preferred-height: rows.preferred-height;

                Flickable {
                    content-height: rows.preferred-height;
                    rows := VerticalLayout {
                        alignment: start;
                        spacing: 0px;
                        for data in ClassificationState.classes_list: InkListRow {
                            title: data.name;
                            tag: data.id < 10 ? "0" + data.id : data.id;
                            swatch: data.color;
                            trailing: data.count;
                            selected: ClassificationState.selected_class_id == data.id;
                            has-eye: true;
                            shown: data.visible;
                            has-more: data.id > 0;
                            clicked => {
                                root.select(data);
                            }
                            eye-toggled => {
                                ClassificationState.class_visibility_toggled(data.id);
                            }
                            context-menu(x, y) => {
                                if data.id > 0 {
                                    root.menu-class-id = data.id;
                                    root.menu-class-name = data.name;
                                    root.menu-x = max(0px, self.x + x - 190px);
                                    root.menu-y = self.y + y + head.height + 4px;
                                    row-menu.show();
                                }
                            }
                        }
                        if ClassificationState.classes_list.length == 0: VerticalLayout {
                            padding: 8px;
                            InkHint {
                                text: "No classes yet. + adds one; ⋯ adds the classes found in the images.";
                            }
                        }
                    }
                }

                // Scanning the images for classes.
                if ClassificationState.is_scanning: Rectangle {
                    background: Ink.glass;
                    TouchArea { }
                    InkBusy {
                        size: 18px;
                    }
                }
            }
        }
    }

    list-menu := PopupWindow {
        x: root.width - 250px;
        y: Ink.head-h;

        InkMenuFrame {
            menu-width: 250px;
            InkMenuCaption { text: "CLASSES"; }
            InkMenuItem {
                icon: InkIcons.add;
                text: "Add the classes found, merged";
                enabled: ImagesListState.images_list.length > 0;
                clicked => {
                    ClassificationState.class_auto_add_and_merge();
                }
            }
            InkMenuItem {
                text: "…replacing the list";
                enabled: ImagesListState.images_list.length > 0;
                clicked => {
                    // Background is always there: ask only when there are others.
                    if ClassificationState.classes_list.length > 1 {
                        GlobalAppState.active_dialog = DialogType.classification_confirm_auto_add_dialog;
                    } else {
                        ClassificationState.class_auto_add_and_replace();
                    }
                }
            }
            InkMenuSeparator { }
            InkMenuItem {
                icon: InkIcons.hidden;
                text: "Hide unclassified objects";
                checked: ClassificationState.hide_unclassified_objects;
                clicked => {
                    ClassificationState.hide_unclassified_objects = !ClassificationState.hide_unclassified_objects;
                    ClassificationState.hide_unclassified_toggled();
                }
            }
        }
    }

    row-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        InkMenuFrame {
            menu-width: 210px;
            InkMenuCaption { text: root.menu-class-name; }
            InkMenuItem {
                icon: InkIcons.edit;
                text: "Edit name, color, id…";
                clicked => {
                    root.select-id(root.menu-class-id, root.menu-class-name);
                    ClassificationState.class_edit(root.menu-class-id);
                    GlobalAppState.active_dialog = DialogType.classification-edit-class-dialog;
                }
            }
            InkMenuItem {
                icon: InkIcons.copy;
                text: "Copy";
                clicked => {
                    ClassificationState.class_copy(root.menu-class-id);
                }
            }
            InkMenuItem {
                icon: InkIcons.caret-up;
                text: "Move up";
                clicked => {
                    ClassificationState.class_move_up(root.menu-class-id);
                }
            }
            InkMenuItem {
                icon: InkIcons.caret-down;
                text: "Move down";
                clicked => {
                    ClassificationState.class_move_down(root.menu-class-id);
                }
            }
            InkMenuSeparator { }
            InkMenuItem {
                icon: InkIcons.delete;
                text: "Delete class…";
                danger: true;
                clicked => {
                    root.select-id(root.menu-class-id, root.menu-class-name);
                    GlobalAppState.active_dialog = DialogType.classification_confirm_delete;
                }
            }
        }
    }
}
