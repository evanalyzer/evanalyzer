// editor/object_list_panel.slint — the Objects panel: the objects of the
// open image (a virtual list: only the rows in view exist, so thousands
// stay fast), and below it the selected object - its classes, area,
// circularity, intensities - with what can be done to it.

import { ChannelState, DialogType, GlobalAppState } from "../api/state.slint";
import { ObjectItemDataSlint, ObjectListState } from "../api/object_list.slint";
import { ListView } from "std-widgets.slint";
import { Ink, InkIcons, InkPanelHead, InkListRow, InkBusy, InkButton, InkButtonKind, InkIconButton, InkChip, InkCaption, InkDivider, InkMenuFrame, InkMenuItem, InkHint } from "../ink/ink.slint";

// "Area   1 204 px²" - a label and a mono value.
component Fact inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> extra;

    height: 20px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            width: 80px;
            text: root.label;
            font-size: Ink.fs-sm;
            color: Ink.text-dim;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            font-size: Ink.fs-sm;
            font-family: Ink.font-mono;
            color: Ink.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.extra;
            font-size: Ink.fs-sm;
            font-family: Ink.font-mono;
            color: Ink.text-mute;
            vertical-alignment: center;
        }
    }
}

export component ObjectListPanel inherits Rectangle {
    property <length> row-h: Ink.row-h;
    property <ObjectItemDataSlint> sel: ObjectListState.selected_object;

    function unselect() {
        ObjectListState.selected_object = {
            id: 0,
            name: "",
            display_color: #000000,
            display_name: "",
            class_names: [],
            class_colors: [],
            class_ids: [],
            label_name: "",
            label_id: 0,
            intensities: [],
            intensity_avgs: [],
        };
        ObjectListState.object_selected(-1);
    }

    VerticalLayout {
        spacing: 0px;

        InkPanelHead {
            title: "Objects";
            count: ObjectListState.object_list.length;
            closable: false;
            has-more: true;
            more(x, y) => {
                list-menu.show();
            }
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 90px;

            // Follow a selection made on the image.
            property <int> scroll-index: ObjectListState.scroll_to_object_index;
            changed scroll-index => {
                if ObjectListState.scroll_to_object_index >= 0 {
                    list.content-y = clamp(
                        -(ObjectListState.scroll_to_object_index * root.row-h) + list.visible-height / 2 - root.row-h / 2,
                        list.visible-height - list.content-height,
                        0px);
                }
            }

            list := ListView {
                x: 4px;
                width: parent.width - 8px;
                for data in ObjectListState.object_list: InkListRow {
                    height: root.row-h;
                    title: data.label_name;
                    swatch: data.class_colors.length > 0 ? data.class_colors[0] : data.display_color;
                    tag: data.class_colors.length > 1 ? "+" + (data.class_colors.length - 1) : "";
                    trailing: data.label_count;
                    selected: root.sel.id == data.id;
                    clicked => {
                        if data.id == root.sel.id {
                            root.unselect();
                        } else {
                            ObjectListState.selected_object = data;
                            ObjectListState.object_selected(data.id);
                        }
                    }
                }
            }

            if ObjectListState.object_list.length == 0 && !ObjectListState.is_scanning: InkHint {
                x: 14px;
                width: parent.width - 28px;
                text: "No objects in this image yet. Run the preview, or draw some in annotate mode.";
            }

            if ObjectListState.is_scanning: Rectangle {
                background: Ink.glass;
                TouchArea { }
                InkBusy {
                    size: 18px;
                }
            }
        }

        // -- The selected object --
        if root.sel.id != 0: VerticalLayout {
            InkDivider { }
            VerticalLayout {
                padding: Ink.pad-panel;
                padding-top: 8px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 6px;
                    InkCaption {
                        horizontal-stretch: 1;
                        text: "OBJECT " + root.sel.label_name;
                        overflow: elide;
                    }
                    InkIconButton {
                        size: 22px;
                        icon: InkIcons.close;
                        label: "Unselect";
                        clicked => {
                            root.unselect();
                        }
                    }
                }

                if root.sel.display_name != "": Text {
                    text: root.sel.display_name;
                    font-size: Ink.fs-sm;
                    color: Ink.text-mute;
                    overflow: elide;
                }

                // Its classes, each removable.
                if root.sel.class_names.length > 0: HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    for name[i] in root.sel.class_names: InkChip {
                        text: name;
                        swatch: root.sel.class_colors[i];
                        removable: true;
                        remove => {
                            ObjectListState.object_remove_class(root.sel.id, root.sel.class_ids[i]);
                        }
                    }
                }

                Fact {
                    label: "Area";
                    value: root.sel.area > 0 ? root.sel.area + " px²" : "–";
                    extra: root.sel.area_nm2 != "" ? root.sel.area_nm2 + " nm²" : "";
                }
                Fact {
                    label: "Circularity";
                    value: root.sel.circularity != "" ? root.sel.circularity : "–";
                }
                Fact {
                    label: "Shared by";
                    value: root.sel.label_count + " objects";
                }
                for sum[i] in root.sel.intensities: Fact {
                    label: ChannelState.channels.length > i ? ChannelState.channels[i].name : "Ch " + (i + 1);
                    value: "μ " + (root.sel.intensity_avgs.length > i && root.sel.intensity_avgs[i] != "" ? root.sel.intensity_avgs[i] : "–");
                    extra: "Σ " + (sum != "" ? sum : "–");
                }

                HorizontalLayout {
                    spacing: 4px;
                    padding-top: 4px;
                    InkButton {
                        small: true;
                        text: "Set class…";
                        kind: InkButtonKind.primary;
                        clicked => {
                            GlobalAppState.active-dialog = DialogType.classification_selection_dialog;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    InkIconButton {
                        size: 24px;
                        icon: InkIcons.edit;
                        label: "Edit";
                        clicked => {
                            ObjectListState.object_edit(root.sel.id);
                        }
                    }
                    InkIconButton {
                        size: 24px;
                        icon: InkIcons.copy;
                        label: "Copy";
                        clicked => {
                            ObjectListState.object_copy(root.sel.id);
                        }
                    }
                    InkIconButton {
                        size: 24px;
                        icon: InkIcons.delete;
                        label: "Delete object";
                        clicked => {
                            GlobalAppState.active_dialog = DialogType.object_confirm_delete;
                        }
                    }
                }
            }
        }
    }

    list-menu := PopupWindow {
        x: root.width - 270px;
        y: Ink.head-h;
        InkMenuFrame {
            menu-width: 270px;
            InkMenuItem {
                icon: InkIcons.delete;
                text: "Delete all hand-annotated objects…";
                danger: true;
                clicked => {
                    GlobalAppState.active_dialog = DialogType.object_confirm_delete_manual_annotated;
                }
            }
        }
    }
}
