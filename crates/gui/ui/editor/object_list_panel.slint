// editor/object_list_panel.slint — the Objects panel: the objects of the
// open image (a virtual list: only the rows in view exist, so thousands
// stay fast). As a list on the right, with the selected object below it -
// its classes, area, circularity, intensities - and what can be done to it;
// or as a table at the bottom (`table`, design K): a line per object, a
// column per measurement. One component for both, so its code exists once.

import { ChannelState, DialogType, GlobalAppState } from "../api/state.slint";
import { ObjectItemDataSlint, ObjectListState } from "../api/object_list.slint";
import { ImageMetaData } from "../api/image_meta.slint";
import { LayoutState } from "../api/layout.slint";
import { ListView } from "std-widgets.slint";
import { Ink, InkIcons, InkPanelHead, InkListRow, InkBusy, InkButton, InkButtonKind, InkIconButton, InkChip, InkCaption, InkDivider, InkMenuFrame, InkMenuItem, InkMenuCaption, InkMenuSeparator, InkHint, InkSearchField, InkPickerRow, InkSwatchName, InkFact } from "../ink/ink.slint";
import { ClassificationState } from "../api/classification.slint";


// The widths of the table's fixed columns; the channels share the rest.
global TableCols {
    // Column `key` ("area", "circ", "ch<i>") is shown (see
    // `ObjectListState.hidden-columns`).
    pure public function shown(key: string) -> bool {
        ObjectListState.hidden-columns.replace-all("," + key + ",", ",") == ObjectListState.hidden-columns
    }
    public function toggle(key: string) {
        ObjectListState.hidden-columns = self.shown(key) ? ObjectListState.hidden-columns + key + "," : ObjectListState.hidden-columns.replace-all("," + key + ",", ",");
    }
    out property <length> id: 64px;
    out property <length> classes: 170px;
    out property <length> area: 72px;
    out property <length> circ: 80px;
    out property <length> more: 28px;
}

// A cell of the objects table: a mono value, right aligned.
component NumberCell inherits Text {
    font-size: Ink.fs-sm;
    font-family: Ink.font-mono;
    color: Ink.text-dim;
    horizontal-alignment: right;
    vertical-alignment: center;
    overflow: elide;
}

// The head of a column of the objects table.
component HeadCell inherits Text {
    font-size: Ink.fs-xs;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: Ink.text-mute;
    vertical-alignment: center;
    overflow: elide;
}

// What can be done to the selected object: set its class, edit, copy,
// delete - under the list's selected object, in the table's footer.
component ObjectActions inherits HorizontalLayout {
    spacing: 4px;
    InkButton {
        small: true;
        text: "Set class…";
        kind: InkButtonKind.primary;
        clicked => {
            GlobalAppState.active-dialog = DialogType.classification_selection_dialog;
        }
    }
    Rectangle {
        horizontal-stretch: 1;
    }
    InkIconButton {
        size: 24px;
        icon: InkIcons.edit;
        label: "Edit";
        clicked => {
            ObjectListState.object_edit(ObjectListState.selected_object.id);
        }
    }
    InkIconButton {
        size: 24px;
        icon: InkIcons.copy;
        label: "Copy";
        clicked => {
            ObjectListState.object_copy(ObjectListState.selected_object.id);
        }
    }
    InkIconButton {
        size: 24px;
        icon: InkIcons.delete;
        label: "Delete object";
        clicked => {
            GlobalAppState.active_dialog = DialogType.object_confirm_delete;
        }
    }
}

// The filter: a class, a search (in the list's own row, in the table's
// head).
component ObjectFilter inherits HorizontalLayout {
    in property <string> class-name;
    in property <color> class-color;
    callback class-clicked;
    spacing: 6px;
    InkChip {
        text: ObjectListState.filter-class < 0 ? "All classes ▾" : root.class-name;
        swatch: ObjectListState.filter-class < 0 ? transparent : root.class-color;
        removable: ObjectListState.filter-class >= 0;
        clicked => {
            root.class-clicked();
        }
        remove => {
            ObjectListState.filter-class = -1;
            ObjectListState.filter-changed();
        }
    }
    InkSearchField {
        placeholder: "id, area > 50 …";
        text: ObjectListState.filter-text;
        edited(text) => {
            ObjectListState.filter-text = text;
            ObjectListState.filter-changed();
        }
    }
}

// An object: a list row, or a line of the table.
component ObjectRow inherits Rectangle {
    in property <ObjectItemDataSlint> data;
    in property <bool> selected;
    in property <bool> table;
    callback clicked;

    if !root.table: InkListRow {
        title: root.data.label_name;
        swatch: root.data.class_colors.length > 0 ? root.data.class_colors[0] : root.data.display_color;
        tag: root.data.class_colors.length > 1 ? "+" + (root.data.class_colors.length - 1) : "";
        trailing: root.data.label_count;
        selected: root.selected;
        clicked => {
            root.clicked();
        }
    }

    if root.table: Rectangle {
        background: root.selected ? Ink.selection : line-ta.has-hover ? Ink.hover : transparent;

        line-ta := TouchArea {
            clicked => {
                root.clicked();
            }
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 8px;
            Text {
                width: TableCols.id;
                text: root.data.label_name;
                font-size: Ink.fs-sm;
                font-family: Ink.font-mono;
                color: Ink.text;
                vertical-alignment: center;
                overflow: elide;
            }
            HorizontalLayout {
                width: TableCols.classes;
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 2px;
                        background: root.data.class_colors.length > 0 ? root.data.class_colors[0] : root.data.display_color;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.data.class_names.length > 0 ? root.data.class_names[0] : "Unclassified";
                    font-size: Ink.fs-sm;
                    color: root.data.class_names.length > 0 ? Ink.text : Ink.text-mute;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.data.class_names.length > 1 ? "+" + (root.data.class_names.length - 1) : "";
                    font-size: Ink.fs-xs;
                    color: Ink.text-mute;
                    vertical-alignment: center;
                }
            }
            NumberCell {
                width: TableCols.shown("area") ? TableCols.area : 0px;
                text: root.data.area > 0 ? root.data.area : "–";
            }
            NumberCell {
                width: TableCols.shown("circ") ? TableCols.circ : 0px;
                text: root.data.circularity != "" ? root.data.circularity : "–";
            }
            for ch in ChannelState.channels: NumberCell {
                horizontal-stretch: TableCols.shown("ch\{ch.idx}") ? 1 : 0;
                min-width: TableCols.shown("ch\{ch.idx}") ? 40px : 0px;
                max-width: TableCols.shown("ch\{ch.idx}") ? 100000px : 0px;
                text: root.data.intensity_avgs.length > ch.idx && root.data.intensity_avgs[ch.idx] != "" ? root.data.intensity_avgs[ch.idx] : "–";
            }
            Rectangle {
                horizontal-stretch: ChannelState.channels.length == 0 ? 1 : 0;
            }
        }
    }
}

export component ObjectListPanel inherits Rectangle {
    /// The table at the bottom, not the list on the right.
    in property <bool> table: false;

    property <length> row-h: root.table ? 28px : Ink.row-h;
    property <ObjectItemDataSlint> sel: ObjectListState.selected_object;
    // The class filtered by, from the classes list.
    property <string> filter-class-name;
    property <color> filter-class-color;
    // The table's head: the filter's width, the room of ⋯ and ✕.
    property <length> table-filter-w: min(440px, root.width * 0.5);
    property <length> head-buttons-w: 72px;
    property <length> filter-row-h: 34px;

    function select(data: ObjectItemDataSlint) {
        ObjectListState.selected_object = data;
        ObjectListState.object_selected(data.id);
    }

    function unselect() {
        ObjectListState.selected_object = {
            id: 0,
            name: "",
            display_color: #000000,
            display_name: "",
            class_names: [],
            class_colors: [],
            class_ids: [],
            label_name: "",
            label_id: 0,
            intensities: [],
            intensity_avgs: [],
        };
        ObjectListState.object_selected(-1);
    }

    VerticalLayout {
        spacing: 0px;

        head := InkPanelHead {
            title: "Objects";
            subtitle: root.table ? ImageMetaData.image_name : "";
            count: ObjectListState.object_list.length;
            closable: root.table;
            has-more: true;
            close => {
                LayoutState.objects-open = false;
            }
            more(x, y) => {
                list-menu.show();
            }
        }

        // The list: room for the filter (below), a row of its own.
        if !root.table: Rectangle {
            height: root.filter-row-h;
        }

        // -- The table's column heads --
        if root.table: VerticalLayout {
            HorizontalLayout {
                height: 26px;
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                HeadCell {
                    width: TableCols.id;
                    text: "ID";
                }
                HeadCell {
                    width: TableCols.classes;
                    text: "CLASSES";
                }
                HeadCell {
                    width: TableCols.shown("area") ? TableCols.area : 0px;
                    text: "AREA PX²";
                    horizontal-alignment: right;
                }
                HeadCell {
                    width: TableCols.shown("circ") ? TableCols.circ : 0px;
                    text: "CIRCULARITY";
                    horizontal-alignment: right;
                }
                for ch in ChannelState.channels: HeadCell {
                    horizontal-stretch: TableCols.shown("ch\{ch.idx}") ? 1 : 0;
                    min-width: TableCols.shown("ch\{ch.idx}") ? 40px : 0px;
                    max-width: TableCols.shown("ch\{ch.idx}") ? 100000px : 0px;
                    text: ch.name.to-uppercase();
                    horizontal-alignment: right;
                }
                // Fills the line when there are no channel columns.
                Rectangle {
                    horizontal-stretch: ChannelState.channels.length == 0 ? 1 : 0;
                    min-width: TableCols.more;
                }
            }
            InkDivider { }
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 90px;

            // Follow a selection made on the image.
            property <int> scroll-index: ObjectListState.scroll_to_object_index;
            changed scroll-index => {
                if ObjectListState.scroll_to_object_index >= 0 {
                    list.content-y = clamp(
                        -(ObjectListState.scroll_to_object_index * root.row-h) + list.visible-height / 2 - root.row-h / 2,
                        list.visible-height - list.content-height,
                        0px);
                }
            }

            list := ListView {
                x: root.table ? 0px : 4px;
                width: parent.width - (root.table ? 0px : 8px);
                for data in ObjectListState.object_list: ObjectRow {
                    height: root.row-h;
                    data: data;
                    table: root.table;
                    selected: root.sel.id == data.id;
                    clicked => {
                        if data.id == root.sel.id {
                            root.unselect();
                        } else {
                            root.select(data);
                        }
                    }
                }
            }

            if ObjectListState.object_list.length == 0 && !ObjectListState.is_scanning: InkHint {
                x: 14px;
                width: parent.width - 28px;
                text: "No objects in this image yet. Run the preview, or draw some in annotate mode.";
            }

            if ObjectListState.is_scanning: Rectangle {
                background: Ink.glass;
                TouchArea { }
                InkBusy {
                    size: 18px;
                }
            }
        }

        // -- The selected object --
        // -- The table: the selected object's line and buttons --
        if root.table && root.sel.id != 0: VerticalLayout {
            InkDivider { }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 10px;
                // A click on its line again unselects it.
                InkCaption {
                    text: "OBJECT " + root.sel.label_name + " · " + root.sel.display_name;
                }
                ObjectActions {
                    horizontal-stretch: 1;
                }
            }
        }

        if !root.table && root.sel.id != 0: VerticalLayout {
            InkDivider { }
            VerticalLayout {
                padding: Ink.pad-panel;
                padding-top: 8px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 6px;
                    InkCaption {
                        horizontal-stretch: 1;
                        text: "OBJECT " + root.sel.label_name;
                        overflow: elide;
                    }
                    InkIconButton {
                        size: 22px;
                        icon: InkIcons.close;
                        label: "Unselect";
                        clicked => {
                            root.unselect();
                        }
                    }
                }

                if root.sel.display_name != "": Text {
                    text: root.sel.display_name;
                    font-size: Ink.fs-sm;
                    color: Ink.text-mute;
                    overflow: elide;
                }

                // Its classes, each removable.
                if root.sel.class_names.length > 0: HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    for name[i] in root.sel.class_names: InkChip {
                        text: name;
                        swatch: root.sel.class_colors[i];
                        removable: true;
                        remove => {
                            ObjectListState.object_remove_class(root.sel.id, root.sel.class_ids[i]);
                        }
                    }
                }

                InkFact {
                    label: "Area";
                    value: root.sel.area > 0 ? root.sel.area + " px²" : "–";
                    extra: root.sel.area_nm2 != "" ? root.sel.area_nm2 + " nm²" : "";
                }
                InkFact {
                    label: "Circularity";
                    value: root.sel.circularity != "" ? root.sel.circularity : "–";
                }
                InkFact {
                    label: "Shared by";
                    value: root.sel.label_count + " objects";
                }
                for sum[i] in root.sel.intensities: InkFact {
                    label: ChannelState.channels.length > i ? ChannelState.channels[i].name : "Ch " + (i + 1);
                    value: "μ " + (root.sel.intensity_avgs.length > i && root.sel.intensity_avgs[i] != "" ? root.sel.intensity_avgs[i] : "–");
                    extra: "Σ " + (sum != "" ? sum : "–");
                }

                ObjectActions {
                    padding-top: 4px;
                }
            }
        }
    }

    list-menu := PopupWindow {
        x: root.width - 270px;
        y: Ink.head-h;
        InkMenuFrame {
            open-y: root.absolute-position.y + Ink.head-h;
            menu-width: 270px;
            if root.table: InkMenuCaption {
                text: "COLUMNS";
            }
            if root.table: InkMenuItem {
                text: "Area";
                checked: TableCols.shown("area");
                clicked => {
                    TableCols.toggle("area");
                }
            }
            if root.table: InkMenuItem {
                text: "Circularity";
                checked: TableCols.shown("circ");
                clicked => {
                    TableCols.toggle("circ");
                }
            }
            for ch in ChannelState.channels: InkMenuItem {
                visible: root.table;
                height: root.table ? self.preferred-height : 0px;
                text: "Mean " + ch.name;
                checked: TableCols.shown("ch\{ch.idx}");
                clicked => {
                    TableCols.toggle("ch\{ch.idx}");
                }
            }
            if root.table: InkMenuSeparator { }
            InkMenuItem {
                icon: root.table ? InkIcons.objects : InkIcons.table;
                text: root.table ? "Show as a list" : "Show as a table";
                clicked => {
                    LayoutState.objects-as-table = !root.table;
                }
            }
            InkMenuItem {
                icon: InkIcons.delete;
                text: "Delete all hand-annotated objects…";
                danger: true;
                clicked => {
                    GlobalAppState.active_dialog = DialogType.object_confirm_delete_manual_annotated;
                }
            }
        }
    }

    // -- Filter: a class, a search - one, in the table's head (design K,
    // left of ⋯ ✕) or in the list's row below its head --
    ObjectFilter {
        x: root.table ? root.width - self.width - root.head-buttons-w : Ink.pad-panel;
        y: root.table ? (Ink.head-h - self.height) / 2 : Ink.head-h;
        width: root.table ? root.table-filter-w : root.width - 2 * Ink.pad-panel;
        height: 28px;
        class-name: root.filter-class-name;
        class-color: root.filter-class-color;
        class-clicked => {
            class-menu.show();
        }
    }

    // The class filter's choices.
    class-menu := PopupWindow {
        x: root.table ? root.width - root.table-filter-w - root.head-buttons-w : Ink.pad-panel;
        y: root.table ? Ink.head-h - 4px : Ink.head-h + 26px;
        InkMenuFrame {
            open-y: root.absolute-position.y + (root.table ? Ink.head-h - 4px : Ink.head-h + 26px);
            menu-width: 220px;
            InkMenuItem {
                text: "All classes";
                checked: ObjectListState.filter-class < 0;
                clicked => {
                    ObjectListState.filter-class = -1;
                    ObjectListState.filter-changed();
                }
            }
            for cls in ClassificationState.classes_list: InkPickerRow {
                label: cls.id < 10 ? "0" + cls.id : cls.id;
                selected: cls.id == ObjectListState.filter-class;
                clicked => {
                    root.filter-class-name = cls.name;
                    root.filter-class-color = cls.color;
                    ObjectListState.filter-class = cls.id;
                    ObjectListState.filter-changed();
                    class-menu.close();
                }
                InkSwatchName {
                    color: cls.color;
                    name: cls.name;
                }
            }
        }
    }
}
