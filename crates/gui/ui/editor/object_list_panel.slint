// editor/object_list_panel.slint — the Objects panel: the objects of the
// open image (a virtual list: only the rows in view exist, so thousands
// stay fast). As a list on the right, with the selected object below it -
// its classes, area, circularity, intensities - and what can be done to it;
// or as a table at the bottom (`table`, design K): a line per object, a
// column per measurement. One component for both, so its code exists once.

import { ChannelState, DialogType, GlobalAppState } from "../api/state.slint";
import { ObjectItemDataSlint, ObjectListState } from "../api/object_list.slint";
import { ImageMetaData } from "../api/image_meta.slint";
import { LayoutState } from "../api/layout.slint";
import { ListView } from "std-widgets.slint";
import {
    Ink,
    InkIcons,
    InkPanelHead,
    InkListRow,
    InkBusy,
    InkButton,
    InkButtonKind,
    InkIconButton,
    InkChip,
    InkCaption,
    InkDivider,
    InkMenuFrame,
    InkMenuItem,
    InkMenuCaption,
    InkMenuSeparator,
    InkHint,
    InkSearchField,
    InkPickerRow,
    InkSwatchName,
    InkSegmented,
} from "../ink/ink.slint";
import { ClassificationState } from "../api/classification.slint";
import { AnnotationState } from "../api/annotations.slint";


// The widths of the table's fixed columns; the channels share the rest.
global TableCols {
    // Column `key` ("area", "circ", "ch<i>") is shown (see
    // `ObjectListState.hidden-columns`).
    pure public function shown(key: string) -> bool {
        ObjectListState.hidden-columns.replace-all("," + key + ",", ",") == ObjectListState.hidden-columns
    }
    public function toggle(key: string) {
        ObjectListState.hidden-columns = self.shown(key) ? ObjectListState.hidden-columns + key + "," : ObjectListState.hidden-columns.replace-all("," + key + ",", ",");
    }
    out property <length> id: 64px;
    out property <length> classes: 170px;
    out property <length> area: 72px;
    out property <length> circ: 80px;
    out property <length> more: 28px;
}

// A cell of the objects table: a mono value, right aligned.
component NumberCell inherits Text {
    font-size: Ink.fs-secondary;
    font-family: Ink.font-mono;
    color: Ink.text-dim;
    horizontal-alignment: right;
    vertical-alignment: center;
    overflow: elide;
}

// The head of a column of the objects table.
component HeadCell inherits Text {
    font-size: Ink.fs-caption;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: Ink.text-mute;
    vertical-alignment: center;
    overflow: elide;
}

// Where the list's selected row is (its top, window coordinates): the
// details card beside the panel goes level with it.
export global ObjectDetailsPlace {
    in-out property <length> row-y;
}

// What can be done to the selected object, in the list's and the table's
// line of it: a manual annotation's class set, or it deleted (its shape is
// edited with the brush and eraser); a pipeline object (read-only) copied
// as an annotation (into the manual annotations).
export component ObjectActions inherits HorizontalLayout {
    in property <bool> editable;
    spacing: 4px;
    if root.editable: InkButton {
        small: true;
        text: "Set class";
        kind: InkButtonKind.primary;
        clicked => {
            GlobalAppState.active-dialog = DialogType.classification_selection_dialog;
        }
    }
    if !root.editable: InkButton {
        small: true;
        icon: InkIcons.copy;
        text: "Copy to annotation";
        tip: "An editable copy among the manual annotations - to change it or train with it";
        kind: InkButtonKind.primary;
        clicked => {
            AnnotationState.open-copy-dialog-for(ObjectListState.selected_object.id);
        }
    }
    Rectangle {
        horizontal-stretch: 1;
    }

    if root.editable: InkIconButton {
        size: 24px;
        icon: InkIcons.delete;
        label: "Delete object";
        clicked => {
            GlobalAppState.active_dialog = DialogType.object_confirm_delete;
        }
    }
}

// The filter: a class, a search (in the list's own row, in the table's
// head).
component ObjectFilter inherits HorizontalLayout {
    in property <string> class-name;
    in property <color> class-color;
    callback class-clicked;
    spacing: 6px;
    InkChip {
        text: (ObjectListState.filter-class < 0 ? "All classes" : root.class-name)
            + (ObjectListState.filter-source == 1 ? " · manual" : ObjectListState.filter-source == 2 ? " · detections" : "")
            + (ObjectListState.filter-class < 0 ? " ▾" : "");
        swatch: ObjectListState.filter-class < 0 ? transparent : root.class-color;
        removable: ObjectListState.filter-class >= 0 || ObjectListState.filter-source != 0;
        clicked => {
            root.class-clicked();
        }
        remove => {
            ObjectListState.filter-class = -1;
            ObjectListState.filter-source = 0;
            ObjectListState.filter-changed();
        }
    }

    InkSearchField {
        placeholder: "id, area > 50 …";
        text: ObjectListState.filter-text;
        edited(text) => {
            ObjectListState.filter-text = text;
            ObjectListState.filter-changed();
        }
    }
}

// A quiet text link in an opened row (design A); `accent` for the main one.
component RowLink inherits Text {
    in property <bool> accent: false;
    callback clicked;
    font-size: Ink.fs-secondary;
    color: ta.has-hover ? Ink.text : root.accent ? Ink.focus : Ink.text-dim;
    vertical-alignment: center;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// An object: a list row, or a line of the table.
// An object's classes as colour squares - one per class (an object can
// have several, e.g. a spot that is also an outside-cell spot), at most
// three, then "+n".
component ClassSwatches inherits HorizontalLayout {
    in property <[color]> colors;
    in property <color> fallback;
    spacing: 2px;
    alignment: start;
    if root.colors.length == 0: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 2px;
            background: root.fallback;
        }
    }
    for c[i] in root.colors: VerticalLayout {
        alignment: center;
        if i < 3: Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 2px;
            background: c;
        }
    }
    if root.colors.length > 3: Text {
        text: "+" + (root.colors.length - 3);
        font-size: Ink.fs-caption;
        color: Ink.text-dim;
        vertical-alignment: center;
    }
}

component ObjectRow inherits Rectangle {
    in property <ObjectItemDataSlint> data;
    // The channel whose mean the list shows.
    in property <int> ch-idx;
    in property <bool> selected;
    in property <bool> table;
    callback clicked;
    // ⤢ Details, or a double click: the details panel.
    callback details;
    // A colour image is measured as one channel, 0: its gray value
    // (R + G + B) / 3, as in the pipeline and the object card - not its red,
    // green and blue.
    property <bool> rgb: ImageMetaData.is-rgb;
    // A channel's column in the table: picked in ⋯, and of a colour image
    // only channel 0.
    function ch-shown(idx: int) -> bool {
        return TableCols.shown("ch\{idx}") && (!root.rgb || idx == 0);
    }
    // Selected in the list: the row opened in place - the line, the mean
    // intensity per channel, its buttons.
    out property <length> open-height: Ink.row-h + max(0, (root.rgb ? 1 : ChannelState.channels.length) - 1) * 18px + 34px;

    // The list: color, id, then area and circularity in columns under the
    // head's units (no unit in every row).
    if !root.table: Rectangle {
        border-radius: Ink.radius-sm;
        background: root.selected ? Ink.row-lift : row-ta.has-hover ? Ink.row-hover : transparent;
        border-width: root.selected ? 1px : 0px;
        border-color: Ink.row-lift-ring;
        accessible-role: list-item;
        accessible-label: "Object " + root.data.label_name;
        accessible-item-selected: root.selected;

        row-ta := TouchArea {
            clicked => {
                root.clicked();
            }
            double-clicked => {
                root.details();
            }
        }

        HorizontalLayout {
            y: 0px;
            height: Ink.row-h;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            ClassSwatches {
                colors: root.data.class_colors;
                fallback: root.data.display_color;
            }
            // The mean of the channel picked in Image (the class is the
            // colour; the id is in the details).
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                text: root.data.intensity_avgs.length > root.ch-idx && root.data.intensity_avgs[root.ch-idx] != "" ? root.data.intensity_avgs[root.ch-idx] : "–";
                font-size: Ink.fs-secondary;
                font-family: Ink.font-mono;
                font-weight: root.selected ? 600 : 400;
                color: Ink.text;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
            NumberCell {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                text: root.data.area > 0 ? root.data.area : "–";
            }
            NumberCell {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                text: root.data.circularity != "" ? root.data.circularity : "–";
            }
        }

        // Opened (design A): the other channels' means (the picked one is
        // the first column), then quiet links - Details › in the accent -
        // and the object's id at the right.
        if root.selected: VerticalLayout {
            y: Ink.row-h;
            height: root.height - Ink.row-h;
            padding-left: 24px;
            padding-right: 10px;
            padding-bottom: 8px;
            spacing: 0px;
            for ch in ChannelState.channels: HorizontalLayout {
                height: ch.idx == root.ch-idx || root.rgb ? 0px : 18px;
                visible: ch.idx != root.ch-idx && !root.rgb;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 2px;
                        background: ch.color;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: ch.name;
                    font-size: Ink.fs-caption;
                    color: Ink.text-dim;
                    vertical-alignment: center;
                    overflow: elide;
                }
                NumberCell {
                    font-size: Ink.fs-caption;
                    color: Ink.text;
                    text: root.data.intensity_avgs.length > ch.idx && root.data.intensity_avgs[ch.idx] != "" ? root.data.intensity_avgs[ch.idx] : "–";
                }
            }
            HorizontalLayout {
                padding-top: 8px;
                height: 26px;
                spacing: 14px;
                RowLink {
                    text: "Details ›";
                    accent: true;
                    clicked => {
                        root.details();
                    }
                }
                if !root.data.editable: RowLink {
                    text: "Copy to annotation";
                    clicked => {
                        AnnotationState.open-copy-dialog-for(root.data.id);
                    }
                }
                if root.data.editable: RowLink {
                    text: "Set class";
                    clicked => {
                        GlobalAppState.active-dialog = DialogType.classification_selection_dialog;
                    }
                }
                if root.data.editable: RowLink {
                    text: "Delete";
                    clicked => {
                        GlobalAppState.active_dialog = DialogType.object_confirm_delete;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: "#" + root.data.label_name;
                    font-size: Ink.fs-caption;
                    font-family: Ink.font-mono;
                    color: Ink.text-faint;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.table: Rectangle {
        background: root.selected ? Ink.row-lift : line-ta.has-hover ? Ink.row-hover : transparent;
        border-width: root.selected ? 1px : 0px;
        border-color: Ink.row-lift-ring;

        line-ta := TouchArea {
            clicked => {
                root.clicked();
            }
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 8px;
            Text {
                width: TableCols.id;
                text: root.data.label_name;
                font-size: Ink.fs-secondary;
                font-family: Ink.font-mono;
                color: Ink.text;
                vertical-alignment: center;
                overflow: elide;
            }

            HorizontalLayout {
                width: TableCols.classes;
                spacing: 5px;
                ClassSwatches {
                    colors: root.data.class_colors;
                    fallback: root.data.display_color;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.data.class_names.length == 0 ? "Unclassified"
                        : root.data.class_names.length == 1 ? root.data.class_names[0]
                        : root.data.class_names[0] + " +" + (root.data.class_names.length - 1);
                    font-size: Ink.fs-secondary;
                    color: root.data.class_names.length > 0 ? Ink.text : Ink.text-mute;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: root.data.class_names.length > 1 ? "+" + (root.data.class_names.length - 1) : "";
                    font-size: Ink.fs-caption;
                    color: Ink.text-mute;
                    vertical-alignment: center;
                }
            }

            NumberCell {
                width: TableCols.shown("area") ? TableCols.area : 0px;
                text: root.data.area > 0 ? root.data.area : "–";
            }

            NumberCell {
                width: TableCols.shown("circ") ? TableCols.circ : 0px;
                text: root.data.circularity != "" ? root.data.circularity : "–";
            }

            for ch in ChannelState.channels: NumberCell {
                horizontal-stretch: root.ch-shown(ch.idx) ? 1 : 0;
                min-width: root.ch-shown(ch.idx) ? 40px : 0px;
                max-width: root.ch-shown(ch.idx) ? 100000px : 0px;
                text: root.data.intensity_avgs.length > ch.idx && root.data.intensity_avgs[ch.idx] != "" ? root.data.intensity_avgs[ch.idx] : "–";
            }
            Rectangle {
                horizontal-stretch: ChannelState.channels.length == 0 ? 1 : 0;
            }
        }
    }
}

export component ObjectListPanel inherits Rectangle {
    /// The table at the bottom, not the list on the right.
    in property <bool> table: false;

    property <length> row-h: root.table ? 28px : Ink.row-h;
    property <ObjectItemDataSlint> sel: ObjectListState.selected_object;
    property <bool> folded: LayoutState.objects-folded && !root.table;
    // The selected object's row in the list shown (filtered), and its top
    // in the window - kept inside the list's view.
    property <int> sel-row: -1;
    property <length> sel-row-y: root.absolute-position.y + list-area.y
        + clamp(root.sel-row * root.row-h + list.content-y, 0px, max(0px, list-area.height - root.row-h));
    changed sel-row-y => {
        ObjectDetailsPlace.row-y = self.sel-row-y;
    }
    // The class filtered by, from the classes list.
    property <string> filter-class-name;
    property <color> filter-class-color;
    // The table's head: the filter's width, the room of ⋯ and ✕.
    property <length> table-filter-w: min(440px, root.width * 0.5);
    property <length> head-buttons-w: 72px;
    property <length> filter-row-h: 34px;

    function step-by(d: int) {
        let k = ObjectListState.selected-index + d;
        if k >= 0 && k < ObjectListState.object_list.length {
            ObjectListState.selected-index = k;
            ObjectListState.scroll_to_object_index = k;
            ObjectListState.scroll-seq += 1;
            root.select(ObjectListState.object_list[k]);
        }
    }
    // A colour image is measured as one channel, 0: its gray value
    // (R + G + B) / 3, as in the pipeline and the object card - not its red,
    // green and blue.
    property <bool> rgb: ImageMetaData.is-rgb;
    // The channel picked in Image: its mean in the list's first column (of
    // a colour image always its gray value).
    property <int> ch-idx: root.rgb ? 0 : ChannelState.selected_channel_index < ChannelState.channels.length ? ChannelState.channels[ChannelState.selected_channel_index].idx : 0;
    property <string> ch-name: root.rgb ? "Gray" : ChannelState.selected_channel_index < ChannelState.channels.length ? ChannelState.channels[ChannelState.selected_channel_index].name : "";
    // A channel's column in the table: picked in ⋯, and of a colour image
    // only channel 0.
    function ch-shown(idx: int) -> bool {
        return TableCols.shown("ch\{idx}") && (!root.rgb || idx == 0);
    }
    function ch-label(name: string) -> string {
        return root.rgb ? "Gray" : name;
    }
    // The details panel's ↑ ↓.
    property <int> step-seq: ObjectListState.step-seq;
    changed step-seq => {
        root.step-by(ObjectListState.step-delta);
    }
    // The class picked in Classes is the list's filter (none picked: all).
    property <int> picked-class: ClassificationState.selected_class_id;
    changed picked-class => {
        if !root.table {
            ObjectListState.filter-class = self.picked-class;
            ObjectListState.filter-changed();
        }
    }

    function select(data: ObjectItemDataSlint) {
        ObjectListState.selected_object = data;
        ObjectListState.object_selected(data.id);
    }

    function unselect() {
        ObjectListState.selected_object = {
            id: 0,
            name: "",
            display_color: #000000,
            display_name: "",
            class_names: [],
            class_colors: [],
            class_ids: [],
            label_name: "",
            label_id: 0,
            intensities: [],
            intensity_avgs: [],
        };
        ObjectListState.object_selected(-1);
    }

    VerticalLayout {
        spacing: 0px;

        head := InkPanelHead {
            title: "Objects";
            subtitle: root.table ? ImageMetaData.image_name
                : ObjectListState.filter-source == 1 ? "annotated" : ObjectListState.filter-source == 2 ? "pipeline" : "";
            closable: root.table;
            // The list folds to its head (a click on the title).
            foldable: !root.table;
            borderless: !root.table;
            folded: root.folded;
            // How many objects, folded or not (as Image shows its channel).
            summary: ObjectListState.object_list.length + (ObjectListState.object_list.length == 1 ? " object" : " objects");
            summary-always: !root.table;
            fold-toggled => {
                LayoutState.objects-folded = !LayoutState.objects-folded;
                LayoutState.panels-changed();
            }
            has-more: true;
            close => {
                LayoutState.objects-open = false;
            }
            more(x, y) => {
                list-menu.show();
            }
        }

        // The list: room for the filter (below), a row of its own; the
        // columns' heads.
        // No objects: no heads, only the placeholder below.
        if !root.table && !root.folded && ObjectListState.object_list.length > 0: HorizontalLayout {
            height: 20px;
            padding-left: 28px;
            padding-right: 12px;
            spacing: 8px;
            // Three equal columns, right-aligned (design T1).
            HeadCell {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                horizontal-alignment: right;
                text: "MEAN " + root.ch-name.to-uppercase();
                overflow: elide;
            }
            HeadCell {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                horizontal-alignment: right;
                text: "AREA PX²";
            }
            HeadCell {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                horizontal-alignment: right;
                text: "CIRC.";
            }
        }

        // -- The table's column heads --
        if root.table: VerticalLayout {
            HorizontalLayout {
                height: 26px;
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                HeadCell {
                    width: TableCols.id;
                    text: "ID";
                }

                HeadCell {
                    width: TableCols.classes;
                    text: "CLASSES";
                }

                HeadCell {
                    width: TableCols.shown("area") ? TableCols.area : 0px;
                    text: "AREA PX²";
                    horizontal-alignment: right;
                }

                HeadCell {
                    width: TableCols.shown("circ") ? TableCols.circ : 0px;
                    text: "CIRCULARITY";
                    horizontal-alignment: right;
                }

                for ch in ChannelState.channels: HeadCell {
                    horizontal-stretch: root.ch-shown(ch.idx) ? 1 : 0;
                    min-width: root.ch-shown(ch.idx) ? 40px : 0px;
                    max-width: root.ch-shown(ch.idx) ? 100000px : 0px;
                    text: root.ch-label(ch.name).to-uppercase();
                    horizontal-alignment: right;
                }
                // Fills the line when there are no channel columns.
                Rectangle {
                    horizontal-stretch: ChannelState.channels.length == 0 ? 1 : 0;
                    min-width: TableCols.more;
                }
            }

            InkDivider { }
        }

        list-area := Rectangle {
            vertical-stretch: root.folded ? 0 : 1;
            // At least six rows - the sections above give way first.
            min-height: root.folded ? 0px : 6 * root.row-h;
            max-height: root.folded ? 0px : 100000px;
            visible: !root.folded;

            // Follow a selection made on the image.
            property <int> scroll-seq: ObjectListState.scroll-seq;
            changed scroll-seq => {
                if ObjectListState.scroll_to_object_index >= 0 {
                    list.content-y = clamp(
                        -(ObjectListState.scroll_to_object_index * root.row-h) + list.visible-height / 2 - root.row-h / 2,
                        list.visible-height - list.content-height,
                        0px);
                }
            }

            list := ListView {
                x: root.table ? 0px : 4px;
                width: parent.width - (root.table ? 0px : 8px);
                for data[i] in ObjectListState.object_list: ObjectRow {
                    height: self.selected && !root.table ? self.open-height : root.row-h;
                    data: data;
                    ch-idx: root.ch-idx;
                    table: root.table;
                    selected: root.sel.id == data.id;
                    // Where the selected row is: the details card goes level
                    // with it.
                    init => {
                        if self.selected {
                            root.sel-row = i;
                            ObjectListState.selected-index = i;
                        }
                    }
                    changed selected => {
                        if self.selected {
                            root.sel-row = i;
                            ObjectListState.selected-index = i;
                        }
                    }
                    clicked => {
                        if data.id == root.sel.id {
                            root.unselect();
                        } else {
                            ObjectListState.selected-index = i;
                            root.select(data);
                        }
                    }
                    details => {
                        ObjectListState.selected-index = i;
                        if data.id != root.sel.id {
                            root.select(data);
                        }
                        ObjectListState.details-open = true;
                    }
                }
            }

            // Empty: the placeholder as everywhere (e.g. the pipelines'
            // "Pick a pipeline").
            if ObjectListState.object_list.length == 0 && !ObjectListState.is_scanning: VerticalLayout {
                x: 0px;
                width: parent.width;
                height: self.preferred-height;
                padding: 20px;
                padding-top: 32px;
                spacing: 8px;
                Image {
                    source: InkIcons.objects;
                    height: 14px;
                    colorize: Ink.text-faint;
                }
                Text {
                    text: "No objects in this image yet";
                    font-size: Ink.fs-dialog-title;
                    font-weight: 600;
                    color: Ink.text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                InkHint {
                    text: "Run the preview, or draw some in annotate mode.";
                    horizontal-alignment: center;
                }
            }

            if ObjectListState.is_scanning: Rectangle {
                background: Ink.glass;
                TouchArea { }

                InkBusy {
                    size: 18px;
                }
            }
        }

        // -- The table: the selected object's line and buttons --
        if root.table && root.sel.id != 0: VerticalLayout {
            InkDivider { }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 10px;
                // A click on its line again unselects it.
                InkCaption {
                    text: "OBJECT " + root.sel.label_name + " · " + root.sel.display_name;
                }

                ObjectActions {
                    horizontal-stretch: 1;
                    editable: root.sel.editable;
                }
            }
        }

    }

    list-menu := PopupWindow {
        x: root.width - 270px;
        y: Ink.head-h;
        InkMenuFrame {
            open-y: root.absolute-position.y + Ink.head-h;
            menu-width: 270px;
            if root.table: InkMenuCaption {
                text: "COLUMNS";
            }
            if root.table: InkMenuItem {
                text: "Area";
                checked: TableCols.shown("area");
                clicked => {
                    TableCols.toggle("area");
                }
            }
            if root.table: InkMenuItem {
                text: "Circularity";
                checked: TableCols.shown("circ");
                clicked => {
                    TableCols.toggle("circ");
                }
            }
            // A colour image: only its gray value (channel 0).
            for ch in ChannelState.channels: InkMenuItem {
                visible: root.table && (!root.rgb || ch.idx == 0);
                height: root.table && (!root.rgb || ch.idx == 0) ? 28px : 0px;
                text: root.rgb ? "Mean gray" : "Mean " + ch.name;
                checked: TableCols.shown("ch\{ch.idx}");
                clicked => {
                    TableCols.toggle("ch\{ch.idx}");
                }
            }
            if root.table: InkMenuSeparator { }
            // The list: where the objects come from (the table has its
            // filter in the head).
            if !root.table: InkMenuCaption {
                text: "SHOW";
            }
            for source[i] in ["All objects", "Annotated (hand-drawn)", "Pipeline (detections)"]: InkMenuItem {
                visible: !root.table;
                height: root.table ? 0px : 28px;
                text: source;
                checked: ObjectListState.filter-source == i;
                clicked => {
                    ObjectListState.filter-source = i;
                    ObjectListState.filter-changed();
                }
            }
            if !root.table: InkMenuSeparator { }
            InkMenuItem {
                icon: root.table ? InkIcons.objects : InkIcons.table;
                text: root.table ? "Show as a list" : "Show as a table";
                clicked => {
                    LayoutState.objects-as-table = !root.table;
                }
            }

            InkMenuSeparator { }

            InkMenuItem {
                icon: InkIcons.copy;
                text: "Copy all to annotations";
                clicked => {
                    AnnotationState.open-copy-dialog();
                }
            }

            InkMenuItem {
                icon: InkIcons.refresh;
                text: "Re-measure annotations";
                clicked => {
                    AnnotationState.remeasure();
                }
            }

            InkMenuSeparator { }

            InkMenuItem {
                icon: InkIcons.export;
                text: "Export as GeoJSON";
                clicked => {
                    AnnotationState.open-export-dialog();
                }
            }

            InkMenuItem {
                icon: InkIcons.download;
                text: "Import from GeoJSON";
                clicked => {
                    AnnotationState.pick-import-file();
                }
            }

            InkMenuSeparator { }

            InkMenuItem {
                icon: InkIcons.delete;
                text: "Delete annotations…";
                danger: true;
                clicked => {
                    AnnotationState.open-delete-dialog();
                }
            }
        }
    }

    // -- Filter: a class, a search - one, in the table's head (design K,
    // left of ⋯ ✕) or in the list's row below its head --
    if !root.folded && root.table: ObjectFilter {
        x: root.table ? root.width - self.width - root.head-buttons-w : Ink.pad-panel;
        y: root.table ? (Ink.head-h - self.height) / 2 : Ink.head-h;
        width: root.table ? root.table-filter-w : root.width - 2 * Ink.pad-panel;
        height: 28px;
        class-name: root.filter-class-name;
        class-color: root.filter-class-color;
        class-clicked => {
            class-menu.show();
        }
    }

    // The filter's choices: where the objects come from, their class.
    class-menu := PopupWindow {
        x: root.table ? root.width - root.table-filter-w - root.head-buttons-w : Ink.pad-panel;
        y: root.table ? Ink.head-h - 4px : Ink.head-h + 26px;
        class-frame := InkMenuFrame {
            open-y: root.absolute-position.y + (root.table ? Ink.head-h - 4px : Ink.head-h + 26px);
            menu-width: 220px;
            InkMenuCaption {
                text: "SHOW";
            }

            for source[i] in ["All", "Annotations", "Detections"]: InkMenuItem {
                text: source;
                checked: ObjectListState.filter-source == i;
                clicked => {
                    ObjectListState.filter-source = i;
                    ObjectListState.filter-changed();
                }
            }

            InkMenuSeparator { }

            InkMenuCaption {
                text: "CLASS";
            }

            InkMenuItem {
                text: "All classes";
                checked: ObjectListState.filter-class < 0;
                clicked => {
                    ObjectListState.filter-class = -1;
                    ObjectListState.filter-changed();
                }
            }

            for cls in ClassificationState.classes_list: InkPickerRow {
                label: cls.id < 10 ? "0" + cls.id : cls.id;
                selected: cls.id == ObjectListState.filter-class;
                init => {
                    if self.selected {
                        class-frame.reveal(self.absolute-position.y, self.height);
                    }
                }
                clicked => {
                    root.filter-class-name = cls.name;
                    root.filter-class-color = cls.color;
                    ObjectListState.filter-class = cls.id;
                    ObjectListState.filter-changed();
                    class-menu.close();
                }
                InkSwatchName {
                    color: cls.color;
                    name: cls.name;
                }
            }
        }
    }
}
