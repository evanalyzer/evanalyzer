// pipelines_panel.slint
// EVAnalyzer - Pipelines panel.
// Owns N pipelines; each pipeline is a flat, ordered list of commands.
// Category is a property of each step (colored stripe), not a hard bucket.
import { ClassItemData, ClassificationState } from "../api/classification.slint";
import { PipelineFocusState } from "../api/pipeline_focus.slint";
import { ScriptEditorState, ScriptFont } from "../api/script_editor.slint";
import { CardTable, Cat, ClassHelper, CommandParameter, ComponentClassesState, LeafParam, ParamType, Pipeline, PipelineCommand, PipelinesPanelState, ProblemItem, SectionView, Status, StepCategory } from "../api/pipelines.slint";

import { Dialog } from "../components/new_components/dialog.slint";
import { ScrollView } from "std-widgets.slint";
import { LineEdit, ComboBox, CheckBox } from "../ink/std_compat.slint";
import { Theme } from "../style.slint";
import {
    ImageAddressPicker,
    ChannelPicker,
} from "../components/channel_picker.slint";
import { PickerField, PickerRow, SwatchName } from "../components/picker_field.slint";

import { FocusModeButton } from "pipeline_focus.slint";
import { Ink, InkIcons, InkIconButton, InkCheckbox, InkButton, InkButtonKind, InkSwitch, InkSelect, InkHint, InkTextField, InkNumberField, InkMenuFrame, InkMenuItem, InkMenuCaption, InkMenuSeparator } from "../ink/ink.slint";

// ----------------------------------------------------------
// Data model
// ----------------------------------------------------------
// Helpers - category & status
// ----------------------------------------------------------
// Reusable bits

// Square ghost icon button.
component GhostIconBtn inherits Rectangle {
        in property <image> icon;
        in property <length> sz: 22px;
        in property <length> icon-sz: 12px;
        in property <bool> enabled: true;
        in property <color> tint: Theme.text-dim;
        callback clicked;

        width: sz;
        height: sz;
        border-radius: 4px;
        opacity: root.enabled ? 1.0 : 0.4;
        background: ta.has-hover && root.enabled ? Theme.raised : transparent;
        animate background { duration: 100ms; }

        Image {
            source: root.icon;
            width: root.icon-sz;
            height: root.icon-sz;
            colorize: ta.has-hover && root.enabled ? Theme.text : root.tint;
        }

        ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }

// 14×14 square checkbox (used for pipeline-include-in-run toggle).
component SquareCheck inherits Rectangle {
        in property <bool> checked;
        callback toggled;

        width: 14px;
        height: 14px;
        border-radius: 3px;
        background: root.checked ? Theme.accent : transparent;
        border-width: root.checked ? 0px : 1.5px;
        border-color: Theme.border;
        animate background { duration: 100ms; }

        if root.checked: Image {
            source: @image-url("../icons/regular-white/check.svg");
            width: 10px;
            height: 10px;
            colorize: #ffffff;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.toggled();
            }
        }
    }


// ----------------------------------------------------------
// Pipeline tab row

// "Advanced (n) · m changed" row of a step card: expands/collapses the
// step's advanced settings; "Always" expands them in every step. Labels are
// short and elide, so this row never widens the card (and with it the list,
// which would then show a horizontal scrollbar).
component AdvancedRow inherits Rectangle {
        in property <int> count;
        in property <int> changed-count;
        in property <bool> expanded;
        in property <bool> always;
        callback toggled;
        callback always-toggled(bool);

        height: 24px;

        HorizontalLayout {
            spacing: 6px;
            row-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.toggled();
                }
                HorizontalLayout {
                    spacing: 5px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.expanded ? @image-url("../icons/regular-white/caret-down.svg") : @image-url("../icons/regular-white/caret-right.svg");
                            width: 10px;
                            height: 10px;
                            colorize: row-ta.has-hover ? Theme.text : Theme.text-dim;
                        }
                    }

                    Text {
                        text: "Advanced (\{root.count})";
                        font-size: 11px;
                        font-weight: 600;
                        color: row-ta.has-hover ? Theme.text : Theme.text-dim;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.changed-count > 0: Text {
                        text: "· \{root.changed-count} changed";
                        font-size: 11px;
                        color: Theme.warn;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            HorizontalLayout {
                spacing: 5px;
                alignment: end;
                VerticalLayout {
                    alignment: center;
                    SquareCheck {
                        checked: root.always;
                        toggled => {
                            root.always-toggled(!root.always);
                        }
                    }
                }

                Text {
                    text: "Always";
                    font-size: 10px;
                    color: Theme.text-mute;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

// A pipeline in the switcher: included in Run (☑), its name, image
// source and steps, focus and ⋯; click to edit its steps.
component PipelineTab inherits Rectangle {
    in property <Pipeline> pipeline;
    in property <bool> active;
    callback selected;
    callback double-clicked;
    callback alt-clicked;
    callback toggled;
    callback more-clicked;
    callback move-up;
    callback move-down;
    callback focus-clicked;

    height: 40px;
    accessible-role: list-item;
    accessible-label: root.pipeline.name;
    accessible-item-selected: root.active;

    face := Rectangle {
        border-radius: Ink.radius-sm;
        background: root.active ? Ink.selection : ta.has-hover ? Ink.hover : transparent;

        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.selected();
            }
            double-clicked => {
                root.double-clicked();
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left && e.modifiers.alt {
                    root.alt-clicked();
                }
            }
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 4px;
            spacing: 8px;

            InkCheckbox {
                y: (parent.height - self.height) / 2;
                checked: root.pipeline.enabled;
                toggled => {
                    root.toggled();
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                HorizontalLayout {
                    spacing: 5px;
                    Text {
                        text: root.pipeline.name;
                        font-size: Ink.fs-md;
                        font-weight: root.active ? 600 : 500;
                        color: root.pipeline.enabled ? Ink.text : Ink.text-mute;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    // Unsaved changes.
                    Rectangle {
                        width: root.pipeline.dirty ? 5px : 0px;
                        Rectangle {
                            visible: root.pipeline.dirty;
                            width: 5px;
                            height: 5px;
                            border-radius: 2.5px;
                            background: Ink.warn;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    text: root.pipeline.image-source + " · " + root.pipeline.total-step-count + " steps · " + root.pipeline.enabled-step-count + " on";
                    font-size: Ink.fs-xs;
                    font-family: Ink.font-mono;
                    color: Ink.text-mute;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: 0px;
                InkIconButton {
                    y: (parent.height - self.height) / 2;
                    size: 22px;
                    visible: ta.has-hover || root.active;
                    icon: InkIcons.caret-up;
                    label: "Move up";
                    clicked => {
                        root.move-up();
                    }
                }
                InkIconButton {
                    y: (parent.height - self.height) / 2;
                    size: 22px;
                    visible: ta.has-hover || root.active;
                    icon: InkIcons.caret-down;
                    label: "Move down";
                    clicked => {
                        root.move-down();
                    }
                }
                InkIconButton {
                    y: (parent.height - self.height) / 2;
                    size: 22px;
                    icon: InkIcons.focus;
                    label: "Focus on this pipeline";
                    clicked => {
                        root.focus-clicked();
                    }
                }
                InkIconButton {
                    y: (parent.height - self.height) / 2;
                    size: 22px;
                    icon: InkIcons.more;
                    label: "Pipeline actions";
                    clicked => {
                        root.more-clicked();
                    }
                }
            }
        }
    }
}

// ----------------------------------------------------------
// Class-dropdown helpers
// Dropdown for ObjectClass (prefix "Obj.") and SegmentationClass (prefix "Seg.").
// Special items at top: Manual annotation (4294967295) and Background (0),
// followed by named classes from ClassificationState.
component ClassDropdown inherits Rectangle {
        in property <bool> is-seg: false;
        in-out property <string> value: "0";
        /// Also offer the opened component's classes (`ComponentClassesState`).
        in property <bool> component-classes: false;
        // A narrow field (a table cell): a numbered class by its number alone.
        in property <bool> compact: false;
        callback changed(string);

        property <string> prefix: root.is-seg ? "Seg." : "Obj.";
        // "Unset", "Background", ... aren't numbered entries.
        property <bool> numbered: root.value.is-float() && root.value != "-1" && root.value != "0" && root.value != "4294967295";

        height: 24px;

        function pick(value: string) {
            root.value = value;
            root.changed(value);
            popup.close();
        }

        PickerField {
            label: root.compact && root.numbered ? ClassHelper.zeropad2(round(root.value.to-float())) : ClassHelper.label(root.value, root.prefix);
            mono: root.numbered || !root.value.is-float();
            clicked => {
                popup.show();
            }
            for cls in ClassificationState.classes_list: SwatchName {
                visible: root.numbered && cls.id == round(root.value.to-float());
                color: cls.color;
                name: cls.name;
            }
            for cls in ComponentClassesState.classes: SwatchName {
                visible: root.value == "L\{cls.id}";
                color: cls.color;
                name: cls.name;
            }
        }

        popup := PopupWindow {
            x: 0px;
            y: root.height + 2px;
            width: max(root.width, 220px);
            height: 300px;

            Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 6px;
                drop-shadow-blur: 12px;
                drop-shadow-color: Theme.shadow;
                clip: true;

                ScrollView {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;

                    VerticalLayout {
                        spacing: 0px;

                        PickerRow {
                            label: "Unset";
                            mono: false;
                            label-color: Theme.text-mute;
                            selected: root.value == "-1";
                            clicked => {
                                root.pick("-1");
                            }
                        }

                        PickerRow {
                            label: "Manual annotation";
                            mono: false;
                            selected: root.value == "4294967295";
                            clicked => {
                                root.pick("4294967295");
                            }
                        }

                        PickerRow {
                            label: "Background";
                            mono: false;
                            selected: root.value == "0";
                            clicked => {
                                root.pick("0");
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        // The opened component's own classes.
                        for cls in ComponentClassesState.classes: PickerRow {
                            height: root.component-classes && !root.is-seg ? 28px : 0px;
                            visible: root.component-classes && !root.is-seg;
                            label: "◆ L\{cls.id}";
                            label-color: Theme.cat-component;
                            selected: root.value == "L\{cls.id}";
                            clicked => {
                                root.pick("L\{cls.id}");
                            }
                            SwatchName {
                                color: cls.color;
                                name: cls.name;
                            }
                        }

                        if root.component-classes && !root.is-seg && ComponentClassesState.classes.length > 0: Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        // Fixed 32 numbered entries; color and name for a class the
                        // project defines.
                        for i in 32: PickerRow {
                            label: root.prefix + " class " + ClassHelper.zeropad2(i + 1);
                            selected: root.numbered && round(root.value.to-float()) == i + 1;
                            clicked => {
                                root.pick("\{i + 1}");
                            }
                            for cls in ClassificationState.classes-list: SwatchName {
                                visible: cls.id == i + 1;
                                color: cls.color;
                                name: cls.name;
                            }
                        }
                    }
                }
            }
        }
    }

// ----------------------------------------------------------
// Multi-select class dropdown - fires changed("toggle:N") on each row click.
// selection-flags is a 33-element [string] ("1"/"0") for classes 0–32,
// populated by the generator via to_parameters() and kept live by the controller.
// Exported so other dialogs (e.g. project_settings_dialog.slint's tile-merge
// class exclusion list) can reuse the same picker instead of a bespoke one.
export component MultiClassDropdown inherits Rectangle {
        in property <bool> is-seg: false;
        in-out property <string> value: "";
        /// flags[0..33] the project's classes; with `component-classes`,
        /// flags[33 + k] the opened component's class k (`ComponentClassesState`).
        in property <[string]> selection-flags: [];
        /// Also offer the opened component's classes.
        in property <bool> component-classes: false;
        callback changed(string);

        property <string> prefix: root.is-seg ? "Seg." : "Obj.";

        height: 26px;
        border-radius: 4px;

        trigger-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                popup.show();
            }

            Rectangle {
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border-soft;
                background: trigger-ta.has-hover ? Theme.raised : Theme.bg;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                // spacing: 0px - gap between chips is baked into each slot's 46px width
                spacing: 0px;
                    // Not `alignment: start`: that packs every item at its
                    // preferred width, so the chip area (0px preferred) would
                    // get no room and only show the "+N" badge.

                    // Placeholder when nothing is selected
                if root.value == "": Text {
                        text: "None selected";
                        font-size: 11px;
                        color: Theme.text-mute;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    // The selected classes, as many as fit; a "+N" badge counts the
                    // rest. The area takes the width the step gives it - the chips
                    // must not widen the field (and with it the step card and popup).
                    chip-area := Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        height: 18px;

                        // Every selected chip takes a 46px slot (see below).
                        property <int> selected: round(chips.preferred-width / 46px);
                        property <int> fitting: floor(self.width / 46px);
                        property <int> shown: self.selected <= self.fitting
                            ? self.selected
                            : max(0, floor((self.width - 28px) / 46px));

                        Rectangle {
                            x: 0px;
                            width: chip-area.shown * 46px;
                            clip: true;

                            // i=0 → BG (flags[0]), i=1..32 → class i (flags[i]).
                            // width:0px collapses unselected slots; clip:true prevents overflow.
                            // Each selected slot is 46px: 43px chip + 3px trailing gap.
                            chips := HorizontalLayout {
                                x: 0px;
                                width: self.preferred-width;
                                spacing: 0px;
                                for i in 33: Rectangle {
                                    width: root.selection-flags[i] == "1" ? 46px : 0px;
                                    height: 18px;
                                    clip: true;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: 43px;
                                        height: 18px;
                                        border-radius: 3px;
                                        background: Theme.accent.with-alpha(0.12);
                                        border-width: 1px;
                                        border-color: Theme.accent.with-alpha(0.35);

                                        property <bool> has-custom-name: false;

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            padding-left: 4px;
                                            padding-right: 4px;

                                            if i == 0: Text {
                                                text: "BG";
                                                font-size: 9px;
                                                font-family: Theme.font-mono;
                                                color: Theme.text;
                                                vertical-alignment: center;
                                            }

                                            if i != 0 && !parent.has-custom-name: Text {
                                                text: ClassHelper.zeropad2(i);
                                                font-size: 9px;
                                                color: Theme.text;
                                                vertical-alignment: center;
                                            }
                                        }

                                        for cls in ClassificationState.classes-list: Rectangle {
                                            visible: cls.id == i && cls.name != "";

                                            init => {
                                                if (cls.id == i && cls.name != "") {
                                                    has-custom-name = true;
                                                }
                                            }

                                            width: parent.width;
                                            height: parent.height;
                                            background: Theme.accent.with-alpha(0.12);

                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 3px;
                                                padding-left: 4px;
                                                padding-right: 4px;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 6px;
                                                        height: 6px;
                                                        border-radius: 2px;
                                                        background: cls.color;
                                                    }
                                                }

                                                Text {
                                                    text: cls.name;
                                                    font-size: 9px;
                                                    color: Theme.text;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }

                                // The opened component's classes selected.
                            for cls[k] in ComponentClassesState.classes: Rectangle {
                                    width: root.component-classes && root.selection-flags[33 + k] == "1" ? 46px : 0px;
                                    height: 18px;
                                    clip: true;
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: 43px;
                                        height: 18px;
                                        border-radius: 3px;
                                        background: Theme.cat-component.with-alpha(0.12);
                                        border-width: 1px;
                                        border-color: Theme.cat-component.with-alpha(0.35);
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 6px;
                                                    height: 6px;
                                                    border-radius: 2px;
                                                    background: cls.color;
                                                }
                                            }

                                            Text {
                                                text: cls.name != "" ? cls.name : "L\{cls.id}";
                                                font-size: 9px;
                                                color: Theme.text;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if chip-area.selected > chip-area.shown: Text {
                            x: chip-area.shown * 46px;
                            height: 18px;
                            text: "+\{chip-area.selected - chip-area.shown}";
                            font-size: 9px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "▾";
                        font-size: 9px;
                        color: Theme.text-mute;
                        vertical-alignment: center;
                    }
                }
            }
        }

        popup := PopupWindow {
            x: 0px;
            y: root.height + 2px;
            width: max(root.width, 220px);
            height: 300px;
            close-policy: no-auto-close;

            Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 6px;
                drop-shadow-blur: 12px;
                drop-shadow-color: #000000.with-alpha(0.4);
                clip: true;

                VerticalLayout {
                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: 4px;
                            spacing: 1px;

                            // Background class (id = 0) - flags[0]
                        bg-ta := TouchArea {
                                height: 26px;
                                clicked => {
                                    root.changed("toggle:0");
                                }
                                Rectangle {
                                    border-radius: 3px;
                                    background: bg-ta.has-hover ? Theme.raised : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 12px;
                                                height: 12px;
                                                border-radius: 3px;
                                                background: root.selection-flags[0] == "1" ? Theme.accent : transparent;
                                                border-width: root.selection-flags[0] == "1" ? 0px : 1.5px;
                                                border-color: Theme.border;
                                            }
                                        }

                                        Text {
                                            text: "Background";
                                            font-size: 11px;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border-soft;
                            }

                            // The opened component's classes - flags[33 + k].
                        for cls[k] in ComponentClassesState.classes: local-ta := TouchArea {
                                height: root.component-classes && !root.is-seg ? 26px : 0px;
                                visible: root.component-classes && !root.is-seg;
                                clicked => {
                                    root.changed("toggle:L\{cls.id}");
                                }
                                Rectangle {
                                    border-radius: 3px;
                                    background: local-ta.has-hover ? Theme.raised : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 12px;
                                                height: 12px;
                                                border-radius: 3px;
                                                background: root.selection-flags[33 + k] == "1" ? Theme.accent : transparent;
                                                border-width: root.selection-flags[33 + k] == "1" ? 0px : 1.5px;
                                                border-color: Theme.border;
                                            }
                                        }

                                        Text {
                                            width: 96px;
                                            text: "◆ L\{cls.id}";
                                            font-size: 11px;
                                            color: Theme.cat-component;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 2px;
                                                background: cls.color;
                                            }
                                        }

                                        Text {
                                            text: "(" + cls.name + ")";
                                            font-size: 11px;
                                            color: Theme.text-dim;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                            }

                            if root.component-classes && !root.is-seg && ComponentClassesState.classes.length > 0: Rectangle {
                                height: 1px;
                                background: Theme.border-soft;
                            }

                            // Classes 1–32 - flags[i+1] (i is 0-based loop index)
                        for i in 32: num-ta := TouchArea {
                                height: 26px;
                                clicked => {
                                    root.changed("toggle:\{i + 1}");
                                }
                                Rectangle {
                                    border-radius: 3px;
                                    background: num-ta.has-hover ? Theme.raised : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 12px;
                                                height: 12px;
                                                border-radius: 3px;
                                                background: root.selection-flags[i + 1] == "1" ? Theme.accent : transparent;
                                                border-width: root.selection-flags[i + 1] == "1" ? 0px : 1.5px;
                                                border-color: Theme.border;
                                            }
                                        }

                                        // A fixed column, so the colors and names line up
                                        // at the same place however wide the popup is.
                                        Text {
                                            width: 96px;
                                            text: root.prefix + " class " + ClassHelper.zeropad2(i + 1);
                                            font-size: 11px;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            for cls in ClassificationState.classes-list: HorizontalLayout {
                                                visible: cls.id == i + 1;
                                                spacing: 4px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 8px;
                                                        height: 8px;
                                                        border-radius: 2px;
                                                        background: cls.color;
                                                    }
                                                }

                                                Text {
                                                    text: "(" + cls.name + ")";
                                                    font-size: 11px;
                                                    color: Theme.text-dim;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-soft;
                    }

                    done-ta := TouchArea {
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => {
                            popup.close();
                        }

                        Rectangle {
                            background: done-ta.has-hover ? Theme.raised : transparent;

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "Done";
                                    font-size: 11px;
                                    color: Theme.accent;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

// ----------------------------------------------------------
// Leaf parameter row (used inside group items)

component LeafParamRow inherits VerticalLayout {
        in property <LeafParam> p;
        callback changed(string);
        callback toggle-exposed();
        callback edit-exposed();
        // This row's pending file-browser request (see `browse-file`).
        property <int> browse-token: -1;

        spacing: 4px;

        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            // Inside an opened component: ◆ exposes the setting as a component
            // parameter (filled) or hides it again.
            if PipelinesPanelState.open-component-name != "" && !PipelinesPanelState.open-component-read-only && p.param-type != ParamType.label: Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 3px;
                background: leaf-expose-ta.has-hover ? Theme.raised : transparent;
                Text {
                    text: p.exposed ? "◆" : "◇";
                    font-size: 9px;
                    color: p.exposed ? Theme.cat-component : Theme.text-mute;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                leaf-expose-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle-exposed();
                    }
                }
            }
            if PipelinesPanelState.open-component-name != "" && !PipelinesPanelState.open-component-read-only && p.exposed: Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 3px;
                background: leaf-edit-ta.has-hover ? Theme.raised : transparent;
                Text {
                    text: "✎";
                    font-size: 9px;
                    color: Theme.cat-component;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                leaf-edit-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.edit-exposed();
                    }
                }
            }
            Text {
                text: p.display-name == "" ? p.name : p.display-name;
                font-size: 10px;
                color: p.exposed ? Theme.cat-component : Theme.text-dim;
                vertical-alignment: center;
            }

            if p.description != "": leaf-help-btn := Rectangle {
                width: 13px;
                height: 13px;
                border-radius: 7px;
                background: leaf-help-ta.has-hover ? Theme.accent.with-alpha(0.3) : Theme.border-soft;
                animate background { duration: 100ms; }
                Text {
                    text: "?";
                    font-size: 8px;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                leaf-help-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        leaf-help-popup.show();
                    }
                }

                leaf-help-popup := PopupWindow {
                    x: 0px;
                    y: parent.height + 3px;
                    width: 230px;
                    Rectangle {
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 6px;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #000000.with-alpha(0.35);
                        VerticalLayout {
                            padding: 10px;
                            spacing: 0px;
                            Text {
                                text: p.description;
                                font-size: 11px;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        if p.param-type == ParamType.number || p.param-type == ParamType.text:
    LineEdit {
            enabled: !PipelinesPanelState.open-component-read-only;
            height: 24px;
            text: p.value;
            font-size: 11px;
            edited(t) => {
                root.changed(t);
            }
        }

        if p.param-type == ParamType.file-path: HorizontalLayout {
            // Applies this row's file-browser result once it arrives.
            property <int> result-token: PipelinesPanelState.browse-result-token;
            changed result-token => {
                if (self.result-token == root.browse-token && root.browse-token >= 0) {
                    root.browse-token = -1;
                    leaf-fp-input.text = PipelinesPanelState.browse-result-path;
                    root.changed(PipelinesPanelState.browse-result-path);
                }
            }

            spacing: 4px;
            leaf-fp-input := LineEdit {
                enabled: !PipelinesPanelState.open-component-read-only;
                height: 24px;
                horizontal-stretch: 1;
                text: p.value;
                font-size: 11px;
                edited(t) => {
                    root.changed(t);
                }
            }

            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border;
                background: leaf-browse-ta.has-hover ? Theme.accent.with-alpha(0.2) : Theme.panel;
                Image {
                    source: @image-url("../icons/regular-white/folder-open.svg");
                    width: 13px;
                    height: 13px;
                    colorize: Theme.text-dim;
                }

                leaf-browse-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        PipelinesPanelState.browse-token-counter += 1;
                        root.browse-token = PipelinesPanelState.browse-token-counter;
                        PipelinesPanelState.browse-file(
                        p.options.length > 0 ? p.options[0] : "",
                        leaf-fp-input.text,
                        root.browse-token);
                    }
                }
            }
        }

        if p.param-type == ParamType.label: Text {
            text: p.value;
            font-size: 11px;
            font-family: Theme.font-mono;
            color: Theme.text-dim;
            vertical-alignment: center;
        }

        if p.param-type == ParamType.spinner:
    InkNumberField {
            enabled: !PipelinesPanelState.open-component-read-only;
            label: p.display-name;
            value: p.value.to-float();
            step: p.step;
            min: p.min;
            max: p.max;
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.dropdown:
    ComboBox {
            enabled: !PipelinesPanelState.open-component-read-only;
            model: p.options;
            current-value: p.value;
            selected(v) => {
                root.changed(v);
            }
        }

        // A value in a range: a spinner, not a slider - a dedicated value is
        // easier to set.
        if p.param-type == ParamType.slider: InkNumberField {
            enabled: !PipelinesPanelState.open-component-read-only;
            label: p.display-name;
            value: p.value.to-float();
            step: p.step > 0 ? p.step : (p.max - p.min) / 100;
            min: p.min;
            max: p.max;
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.toggle: HorizontalLayout {
            CheckBox {
                enabled: !PipelinesPanelState.open-component-read-only;
                checked: p.value == "true";
                toggled => {
                    root.changed(self.checked ? "true" : "false");
                }
            }
        }

        if p.param-type == ParamType.obj-class:
    ClassDropdown {
            is-seg: false;
            component-classes: true;
            value: p.value;
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.seg-class:
    ClassDropdown {
            is-seg: true;
            value: p.value;
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.multi-obj-class:
    MultiClassDropdown {
            is-seg: false;
            component-classes: true;
            value: p.value;
            selection-flags: p.options;
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.multi-seg-class:
    MultiClassDropdown {
            is-seg: true;
            value: p.value;
            selection-flags: p.options;
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.pixel-units || p.param-type == ParamType.size-units:
    ComboBox {
            enabled: !PipelinesPanelState.open-component-read-only;
            model: p.options;
            current-value: p.value;
            selected(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.image-address:
    ImageAddressPicker {
            enabled: !PipelinesPanelState.open-component-read-only;
            kind: p.options[0];
            number: p.options[1].to-float();
            in-component: PipelinesPanelState.open-component-name != "";
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.image-channel:
    ChannelPicker {
            height: 24px;
            font-size: 11px;
            value: p.value.to-float();
            changed(v) => {
                root.changed(v);
            }
        }
    }

// ----------------------------------------------------------
// Parameter row

// Header above the first setting of a section.
component SectionHeader inherits VerticalLayout {
        in property <string> text;
        padding-top: 4px;
        spacing: 3px;
        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: Theme.text-dim;
            overflow: elide;
        }

        Rectangle {
            height: 1px;
            background: Theme.border-soft;
        }
    }

// A setting's name line: ◇/✎ inside an opened component, the name, and "?"
// for its help text.
component ParamLabel inherits HorizontalLayout {
        in property <CommandParameter> p;
        // The settings dialog's layout: a larger name, and "?" shows the
        // full help text below the short one (`help-open`) instead of a popup.
        in property <bool> wide: false;
        in-out property <bool> help-open: false;
        callback toggle-exposed();
        callback edit-exposed();

        spacing: 4px;
        alignment: start;
        // Inside an opened component: ◆ exposes the setting as a component
        // parameter (filled) or hides it again.
        if PipelinesPanelState.open-component-name != "" && !PipelinesPanelState.open-component-read-only && p.param-type != ParamType.group && p.param-type != ParamType.label: Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 3px;
            background: expose-ta.has-hover ? Theme.raised : transparent;
            Text {
                text: p.exposed ? "◆" : "◇";
                font-size: 10px;
                color: p.exposed ? Theme.cat-component : Theme.text-mute;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            expose-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.toggle-exposed();
                }
            }
        }
        if PipelinesPanelState.open-component-name != "" && !PipelinesPanelState.open-component-read-only && p.exposed: Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 3px;
            background: edit-exposed-ta.has-hover ? Theme.raised : transparent;
            Text {
                text: "✎";
                font-size: 10px;
                color: Theme.cat-component;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            edit-exposed-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.edit-exposed();
                }
            }
        }
        Text {
            text: p.display-name == "" ? p.name : p.display-name;
            font-size: root.wide ? 12px : 11px;
            font-weight: root.wide ? 600 : 400;
            color: p.exposed ? Theme.cat-component : (root.wide ? Theme.text : Theme.text-dim);
            vertical-alignment: center;
            overflow: elide;
        }

        if root.wide ? p.more-help : p.description != "": help-btn := Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: help-ta.has-hover || root.help-open ? Theme.accent.with-alpha(0.3) : Theme.border-soft;
            animate background { duration: 100ms; }
            Text {
                text: "?";
                font-size: 8px;
                color: Theme.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            help-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if root.wide {
                        root.help-open = !root.help-open;
                    } else {
                        help-popup.show();
                    }
                }
            }

            help-popup := PopupWindow {
                x: 0px;
                y: parent.height + 3px;
                width: 240px;
                Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 6px;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: #000000.with-alpha(0.35);
                    VerticalLayout {
                        padding: 10px;
                        spacing: 0px;
                        Text {
                            text: p.description;
                            font-size: 11px;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

// A setting's control (text field, spinner, dropdown, list entries, …).
// Locked while a component is only viewed.
component ParamControls inherits Rectangle {
        in property <CommandParameter> p;
        // A narrow field (a table cell): the controls that have it get their
        // compact form.
        in property <bool> compact: false;
        callback changed(string);
        callback item-field-changed(int, string, string);
        callback add-item();
        callback remove-item(int);
        callback show-model-info();
        // A list entry's setting: entry index, setting name.
        callback toggle-item-exposed(int, string);
        callback edit-item-exposed(int, string);
        // This row's pending file-browser request (see `browse-file`).
        property <int> browse-token: -1;
        // This row's pending script-editor request (see `ScriptEditorState`).
        property <int> script-token: -1;

        VerticalLayout {
            spacing: 4px;

            // Script: read-only preview, click opens the script editor.
            if p.param-type == ParamType.script: Rectangle {
                property <int> result-token: ScriptEditorState.result-token;
                changed result-token => {
                    if (self.result-token == root.script-token && root.script-token >= 0) {
                        root.script-token = -1;
                        root.changed(ScriptEditorState.result-text);
                    }
                }

                height: 84px;
                border-radius: 4px;
                border-width: 1px;
                border-color: script-ta.has-hover ? Theme.accent.with-alpha(0.6) : Theme.border;
                background: Theme.bg;
                clip: true;

                Text {
                    x: 6px;
                    y: 4px;
                    width: parent.width - 12px;
                    height: parent.height - 8px;
                    text: p.value;
                    font-family: ScriptFont.family;
                    font-size: 10px;
                    color: Theme.text-dim;
                    wrap: no-wrap;
                    overflow: clip;
                    vertical-alignment: top;
                }

                Rectangle {
                    x: parent.width - self.width - 4px;
                    y: parent.height - self.height - 4px;
                    width: edit-label.preferred-width + 12px;
                    height: 18px;
                    border-radius: 3px;
                    background: script-ta.has-hover ? Theme.accent : Theme.raised;
                    edit-label := Text {
                        text: "Edit script";
                        font-size: 10px;
                        color: script-ta.has-hover ? #FFFFFF : Theme.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                script-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ScriptEditorState.token-counter += 1;
                        root.script-token = ScriptEditorState.token-counter;
                        ScriptEditorState.open(p.display-name, p.value, root.script-token);
                    }
                }
            }

            if p.param-type == ParamType.number || p.param-type == ParamType.text: InkTextField {
                enabled: !PipelinesPanelState.open-component-read-only;
                label: p.display-name;
                mono: p.param-type == ParamType.number;
                value: p.value;
                edited(t) => {
                    root.changed(t);
                }
            }

            if p.param-type == ParamType.file-path: HorizontalLayout {
                // Applies this row's file-browser result once it arrives.
                property <int> result-token: PipelinesPanelState.browse-result-token;
                changed result-token => {
                    if (self.result-token == root.browse-token && root.browse-token >= 0) {
                        root.browse-token = -1;
                        fp-input.text = PipelinesPanelState.browse-result-path;
                        root.changed(PipelinesPanelState.browse-result-path);
                    }
                }

                spacing: 4px;
                fp-input := InkTextField {
                    enabled: !PipelinesPanelState.open-component-read-only;
                    label: p.display-name;
                    mono: true;
                    value: p.value;
                    edited(t) => {
                        root.changed(t);
                    }
                }

                InkIconButton {
                    size: Ink.control-h;
                    icon: InkIcons.open;
                    label: "Browse…";
                    enabled: !PipelinesPanelState.open-component-read-only;
                    clicked => {
                        PipelinesPanelState.browse-token-counter += 1;
                        root.browse-token = PipelinesPanelState.browse-token-counter;
                        PipelinesPanelState.browse-file(
                            p.options.length > 0 ? p.options[0] : "",
                            fp-input.text,
                            root.browse-token);
                    }
                }

                if p.has-model-info: InkIconButton {
                    size: Ink.control-h;
                    icon: InkIcons.info;
                    label: "About the model";
                    clicked => {
                        root.show-model-info();
                    }
                }
            }

            if p.param-type == ParamType.label: Text {
                text: p.value;
                font-size: Ink.fs-sm;
                font-family: Ink.font-mono;
                color: Ink.text-dim;
                vertical-alignment: center;
            }

            if p.param-type == ParamType.spinner: InkNumberField {
                enabled: !PipelinesPanelState.open-component-read-only;
                compact: root.compact;
                label: p.display-name;
                value: p.value.to-float();
                step: p.step;
                min: p.min;
                max: p.max;
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.dropdown: InkSelect {
                enabled: !PipelinesPanelState.open-component-read-only;
                label: p.display-name;
                model: p.options;
                value: p.value;
                picked(i, v) => {
                    root.changed(v);
                }
            }

            // A value in a range: a spinner - a dedicated value is easier to
            // set than with a slider.
            if p.param-type == ParamType.slider: InkNumberField {
                enabled: !PipelinesPanelState.open-component-read-only;
                compact: root.compact;
                label: p.display-name;
                value: p.value.to-float();
                step: p.step > 0 ? p.step : (p.max - p.min) / 100;
                min: p.min;
                max: p.max;
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.toggle: HorizontalLayout {
                InkCheckbox {
                    enabled: !PipelinesPanelState.open-component-read-only;
                    checked: p.value == "true";
                    toggled(on) => {
                        root.changed(on ? "true" : "false");
                    }
                }
            }

            if p.param-type == ParamType.obj-class:
        ClassDropdown {
                is-seg: false;
                compact: root.compact;
                component-classes: true;
                value: p.value;
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.seg-class:
        ClassDropdown {
                is-seg: true;
                compact: root.compact;
                value: p.value;
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.multi-obj-class:
        MultiClassDropdown {
                is-seg: false;
                component-classes: true;
                value: p.value;
                selection-flags: p.options;
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.multi-seg-class:
        MultiClassDropdown {
                is-seg: true;
                value: p.value;
                selection-flags: p.options;
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.pixel-units || p.param-type == ParamType.size-units: InkSelect {
                enabled: !PipelinesPanelState.open-component-read-only;
                label: p.display-name;
                model: p.options;
                value: p.value;
                picked(i, v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.image-address:
        ImageAddressPicker {
                enabled: !PipelinesPanelState.open-component-read-only;
                kind: p.options[0];
                number: p.options[1].to-float();
                in-component: PipelinesPanelState.open-component-name != "";
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.image-channel:
        ChannelPicker {
                height: 24px;
                font-size: 11px;
                compact: root.compact;
                value: p.value.to-float();
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.group: VerticalLayout {
                spacing: 4px;
                for item[i] in p.group-items: Rectangle {
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border-soft;
                    background: Theme.bg;
                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "#" + (i + 1);
                                font-size: 9.5px;
                                font-family: Theme.font-mono;
                                color: Theme.text-mute;
                                vertical-alignment: center;
                            }

                            GhostIconBtn {
                                icon: @image-url("../icons/regular-white/trash-simple.svg");
                                sz: 18px;
                                icon-sz: 10px;
                                tint: Theme.err.with-alpha(0.6);
                                clicked => {
                                    root.remove-item(i);
                                }
                            }
                        }

                        for field in item.fields: LeafParamRow {
                            p: field;
                            changed(v) => {
                                root.item-field-changed(i, field.name, v);
                            }
                            toggle-exposed => {
                                root.toggle-item-exposed(i, field.name);
                            }
                            edit-exposed => {
                                root.edit-item-exposed(i, field.name);
                            }
                        }
                    }
                }
                Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: add-item-ta.has-hover ? Theme.raised : transparent;
                    animate background { duration: 100ms; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        Image {
                            source: @image-url("../icons/regular-white/plus.svg");
                            width: 10px;
                            height: 10px;
                            colorize: Theme.text-dim;
                            y: 8px;
                        }

                        Text {
                            text: "Add item";
                            font-size: 10.5px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }

                    add-item-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.add-item();
                        }
                    }
                }
            }
        }

        // "View": the settings can be read, not changed - the names and
        // their "?" around the controls still work.
        if PipelinesPanelState.open-component-read-only: TouchArea { }
    }

// Below a setting: what it's wired to, and what a check found about it.
component ParamNotes inherits VerticalLayout {
        in property <CommandParameter> p;
        spacing: 2px;
        if p.wiring != "": Text {
            text: p.wiring;
            font-size: 9.5px;
            color: Theme.cat-component.with-alpha(0.85);
            wrap: word-wrap;
            height: self.preferred-height;
        }
        if p.problem != "": Text {
            text: "⚠ \{p.problem}";
            font-size: 10px;
            color: p.problem-error ? Theme.err : Theme.warn;
            wrap: word-wrap;
            height: self.preferred-height;
        }
    }

// One problem: what it is, where (`show-where`), and its fix. Clicking the
// text shows the step it's about.
component ProblemRow inherits HorizontalLayout {
        in property <ProblemItem> item;
        in property <bool> show-where: true;
        spacing: 6px;

        VerticalLayout {
            alignment: start;
            padding-top: 4px;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: item.error ? Theme.err : Theme.warn;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            if root.show-where && item.where != "": Text {
                text: item.where;
                font-size: 9.5px;
                font-weight: 600;
                color: Theme.text-mute;
                overflow: elide;
            }
            problem-text := Text {
                text: item.text;
                font-size: 10.5px;
                color: problem-ta.has-hover && root.show-where ? Theme.text : Theme.text-dim;
                wrap: word-wrap;
                height: self.preferred-height;
                problem-ta := TouchArea {
                    mouse-cursor: root.show-where ? pointer : default;
                    clicked => {
                        if root.show-where {
                            PipelinesPanelState.show-problem(item.index);
                        }
                    }
                }
            }
        }

        if item.fix-label != "": VerticalLayout {
            alignment: start;
            Rectangle {
                height: 20px;
                width: fix-text.preferred-width + 14px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border;
                background: fix-ta.has-hover ? Theme.raised : transparent;
                accessible-role: button;
                accessible-label: item.fix-label;
                fix-text := Text {
                    text: item.fix-label;
                    font-size: 10px;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                fix-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        PipelinesPanelState.fix-problem(item.index);
                    }
                }
            }
        }
    }

component ParamRow inherits VerticalLayout {
        in property <CommandParameter> p;
        // Show `p.section-header` (the settings dialog has its own).
        in property <bool> show-section: true;
        callback changed(string);
        callback item-field-changed(int, string, string);
        callback add-item();
        callback remove-item(int);
        callback show-model-info();
        callback toggle-exposed();
        callback edit-exposed();
        // A list entry's setting: entry index, setting name.
        callback toggle-item-exposed(int, string);
        callback edit-item-exposed(int, string);

        spacing: 4px;

        if root.show-section && p.section-header != "": SectionHeader {
            text: p.section-header;
        }

        ParamLabel {
            p: root.p;
            toggle-exposed => {
                root.toggle-exposed();
            }
            edit-exposed => {
                root.edit-exposed();
            }
        }

        ParamControls {
            p: root.p;
            changed(v) => {
                root.changed(v);
            }
            item-field-changed(i, n, v) => {
                root.item-field-changed(i, n, v);
            }
            add-item => {
                root.add-item();
            }
            remove-item(i) => {
                root.remove-item(i);
            }
            show-model-info => {
                root.show-model-info();
            }
            toggle-item-exposed(i, n) => {
                root.toggle-item-exposed(i, n);
            }
            edit-item-exposed(i, n) => {
                root.edit-item-exposed(i, n);
            }
        }

        ParamNotes {
            p: root.p;
        }
    }

// A setting in the settings dialog, laid out like the project settings:
// name, short help ("?" for the full one) on the left, the control on the
// right - or below, for list entries and scripts, which need the width.
component WideParamRow inherits VerticalLayout {
        in property <CommandParameter> p;
        callback changed(string);
        callback item-field-changed(int, string, string);
        callback add-item();
        callback remove-item(int);
        callback show-model-info();
        callback toggle-exposed();
        callback edit-exposed();
        // A list entry's setting: entry index, setting name.
        callback toggle-item-exposed(int, string);
        callback edit-item-exposed(int, string);

        property <bool> help-open: false;
        property <bool> block: p.param-type == ParamType.group || p.param-type == ParamType.script;

        Rectangle {
            height: 1px;
            background: Theme.border-soft;
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: root.block ? 4px : 12px;
            spacing: 24px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;

                ParamLabel {
                    p: root.p;
                    wide: true;
                    help-open <=> root.help-open;
                    toggle-exposed => {
                        root.toggle-exposed();
                    }
                    edit-exposed => {
                        root.edit-exposed();
                    }
                }

                // `height` from the text's own width (see the project
                // settings' `SettingRow`).
                if p.short-description != "": Text {
                    text: root.help-open ? p.description : p.short-description;
                    font-size: 11px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }

                ParamNotes {
                    p: root.p;
                }
            }

            if !root.block: VerticalLayout {
                width: 280px;
                alignment: center;
                ParamControls {
                    p: root.p;
                    changed(v) => {
                        root.changed(v);
                    }
                    item-field-changed(i, n, v) => {
                        root.item-field-changed(i, n, v);
                    }
                    add-item => {
                        root.add-item();
                    }
                    remove-item(i) => {
                        root.remove-item(i);
                    }
                    show-model-info => {
                        root.show-model-info();
                    }
                    toggle-item-exposed(i, n) => {
                        root.toggle-item-exposed(i, n);
                    }
                    edit-item-exposed(i, n) => {
                        root.edit-item-exposed(i, n);
                    }
                }
            }
        }

        if root.block: VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 12px;
            ParamControls {
                p: root.p;
                changed(v) => {
                    root.changed(v);
                }
                item-field-changed(i, n, v) => {
                    root.item-field-changed(i, n, v);
                }
                add-item => {
                    root.add-item();
                }
                remove-item(i) => {
                    root.remove-item(i);
                }
                show-model-info => {
                    root.show-model-info();
                }
                toggle-item-exposed(i, n) => {
                    root.toggle-item-exposed(i, n);
                }
                edit-item-exposed(i, n) => {
                    root.edit-item-exposed(i, n);
                }
            }
        }
    }

// ----------------------------------------------------------
// Step row

// A setting on one line: its name left, its control right - lists,
// scripts and file paths need the width, so they're stacked (`ParamRow`).
component InlineParamRow inherits VerticalLayout {
        in property <CommandParameter> p;
        callback changed(string);
        callback item-field-changed(int, string, string);
        callback add-item();
        callback remove-item(int);
        callback show-model-info();
        callback toggle-exposed();
        callback edit-exposed();
        // A list entry's setting: entry index, setting name.
        callback toggle-item-exposed(int, string);
        callback edit-item-exposed(int, string);

        property <bool> stacked: p.param-type == ParamType.group || p.param-type == ParamType.script || p.param-type == ParamType.file-path || p.param-type == ParamType.multi-obj-class || p.param-type == ParamType.multi-seg-class || p.param-type == ParamType.image-address || p.param-type == ParamType.slider;

        spacing: 2px;

        if root.stacked: ParamRow {
            p: root.p;
            show-section: false;
            changed(v) => {
                root.changed(v);
            }
            item-field-changed(i, n, v) => {
                root.item-field-changed(i, n, v);
            }
            add-item => {
                root.add-item();
            }
            remove-item(i) => {
                root.remove-item(i);
            }
            show-model-info => {
                root.show-model-info();
            }
            toggle-exposed => {
                root.toggle-exposed();
            }
            edit-exposed => {
                root.edit-exposed();
            }
            toggle-item-exposed(i, n) => {
                root.toggle-item-exposed(i, n);
            }
            edit-item-exposed(i, n) => {
                root.edit-item-exposed(i, n);
            }
        }

        if !root.stacked: HorizontalLayout {
            spacing: 8px;
            HorizontalLayout {
                width: 112px;
                alignment: start;
                ParamLabel {
                    p: root.p;
                    toggle-exposed => {
                        root.toggle-exposed();
                    }
                    edit-exposed => {
                        root.edit-exposed();
                    }
                }
            }

            ParamControls {
                horizontal-stretch: 1;
                p: root.p;
                changed(v) => {
                    root.changed(v);
                }
                item-field-changed(i, n, v) => {
                    root.item-field-changed(i, n, v);
                }
                add-item => {
                    root.add-item();
                }
                remove-item(i) => {
                    root.remove-item(i);
                }
                show-model-info => {
                    root.show-model-info();
                }
                toggle-item-exposed(i, n) => {
                    root.toggle-item-exposed(i, n);
                }
                edit-item-exposed(i, n) => {
                    root.edit-item-exposed(i, n);
                }
            }
        }

        if !root.stacked: ParamNotes {
            p: root.p;
        }
    }

// A collapsible section's head: ▸ name, and its settings' values while closed.
component SectionHead inherits Rectangle {
        in property <SectionView> section;
        callback clicked;

        height: 30px;
        border-radius: 4px;
        background: head-ta.has-hover ? Theme.raised : transparent;
        accessible-role: button;
        accessible-label: root.section.name;

        head-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }

        HorizontalLayout {
            padding-left: 2px;
            padding-right: 6px;
            spacing: 6px;
            Text {
                width: 10px;
                text: root.section.open ? "▾" : "▸";
                font-size: 9px;
                color: Theme.text-mute;
                vertical-alignment: center;
            }

            Text {
                text: root.section.name;
                font-size: 11px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }

            if root.section.problem > 0: Text {
                text: "⚠";
                font-size: 10px;
                color: root.section.problem == 2 ? Theme.err : Theme.warn;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 1;
                text: root.section.open ? "" : root.section.summary;
                font-size: 10.5px;
                color: Theme.text-dim;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }

// Sections with the same settings as a table: a row per section, a
// column per setting, compact controls in the cells.
component CardTableView inherits VerticalLayout {
        in property <CardTable> table;
        // A cell's setting changed: its name, the value.
        callback changed(string, string);

        spacing: 4px;

        HorizontalLayout {
            spacing: 4px;
            Rectangle {
                width: 64px;
            }

            for column in root.table.columns: Text {
                horizontal-stretch: 1;
                preferred-width: 1px;
                min-width: 0px;
                text: column;
                font-size: 9.5px;
                font-weight: 600;
                color: Theme.text-mute;
                overflow: elide;
            }
        }

        for row in root.table.rows: HorizontalLayout {
            spacing: 4px;
            height: 26px;
            Text {
                width: 64px;
                text: row.name;
                font-size: 11px;
                font-weight: 600;
                color: row.problem == 2 ? Theme.err : row.problem == 1 ? Theme.warn : Theme.text;
                overflow: elide;
                vertical-alignment: center;
            }

            for cell in row.cells: Rectangle {
                horizontal-stretch: 1;
                preferred-width: 1px;
                min-width: 0px;
                border-radius: 5px;
                border-width: cell.problem != "" ? 1px : 0px;
                border-color: cell.problem-error ? Theme.err : Theme.warn;
                ParamControls {
                    x: 1px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 2px;
                    p: cell;
                    compact: true;
                    changed(v) => {
                        root.changed(cell.name, v);
                    }
                }
            }
        }

        for problem in root.table.problems: Text {
            text: "⚠ \{problem}";
            font-size: 10px;
            color: root.table.problem-error ? Theme.err : Theme.warn;
            wrap: word-wrap;
            height: self.preferred-height;
        }
    }

component StepRow inherits Rectangle {
        in property <PipelineCommand> step;
        in property <int> idx;
        in property <int> pipeline-id;
        callback toggle-enabled;
        callback toggle-expanded;
        callback remove;
        callback duplicate;
        callback create-component;
        callback open-component;
        callback view-component;
        callback expand-component;
        callback save-to-library;
        callback update-component;
        callback param-changed(string, string);
        callback toggle-breakpoint;
        callback open-settings;

        // Collapsed: a line. Expanded: a card around the settings.
        property <bool> hovered: head-ta.has-hover;
        property <bool> editable: !PipelinesPanelState.open-component-read-only;
        // 0 = off, 1 = stop, 2 = snapshot - for this step.
        property <int> bp-state: (PipelinesPanelState.breakpoint-pipeline-id == root.pipeline-id && PipelinesPanelState.breakpoint-step-id == root.step.step-id) ? PipelinesPanelState.breakpoint-mode : 0;

        background: step.expanded ? Ink.panel : head-ta.has-hover ? Ink.hover : transparent;
        border-width: step.expanded ? 1px : 0px;
        border-color: Ink.border;
        border-radius: Ink.radius-md;
        clip: true;

        VerticalLayout {
            spacing: 0px;

            // -- The line --
            Rectangle {
                height: 34px;
                opacity: step.enabled ? 1.0 : 0.5;
                head-ta := TouchArea {
                    clicked => {
                        root.toggle-expanded();
                    }
                }

                HorizontalLayout {
                    spacing: 0px;

                    // Category stripe.
                    Rectangle {
                        width: 3px;
                        Rectangle {
                            height: 18px;
                            width: 3px;
                            border-radius: 1.5px;
                            background: Cat.color(step.category);
                        }
                    }

                    // The step's id - what "#2 EV Detection" elsewhere refers to.
                    step-number := Text {
                        width: max(26px, self.preferred-width + 10px);
                        text: root.step.step-id;
                        color: Ink.text-faint;
                        font-size: Ink.fs-sm;
                        font-family: Ink.font-mono;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        padding-right: 6px;

                        Text {
                            text: step.name;
                            color: Ink.text;
                            font-size: Ink.fs-lg;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if step.help != "": Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 15px;
                            height: 15px;
                            border-radius: 7.5px;
                            background: step-help-ta.has-hover ? Ink.focus-ring : Ink.raised;
                            accessible-role: button;
                            accessible-label: "About \{step.name}";
                            Text {
                                text: "?";
                                font-size: 9px;
                                font-weight: 600;
                                color: Ink.text-dim;
                            }

                            step-help-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    step-help-popup.show();
                                }
                            }

                            step-help-popup := PopupWindow {
                                x: 0px;
                                y: parent.height + 4px;
                                width: 300px;
                                Rectangle {
                                    background: Ink.panel;
                                    border-width: 1px;
                                    border-color: Ink.border;
                                    border-radius: Ink.radius-md;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-offset-y: 4px;
                                    drop-shadow-color: Ink.shadow;
                                    VerticalLayout {
                                        padding: 10px;
                                        Text {
                                            text: step.help;
                                            font-size: Ink.fs-sm;
                                            color: Ink.text;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        if step.problems.length > 0: Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 16px;
                            width: badge-text.preferred-width + 10px;
                            border-radius: 8px;
                            background: step.problem-errors > 0 ? Ink.err-tint : Ink.warn-tint;
                            accessible-role: text;
                            accessible-label: "\{step.problems.length} problems";
                            badge-text := Text {
                                text: "⚠ \{step.problems.length}";
                                font-size: Ink.fs-xs;
                                font-weight: 600;
                                color: step.problem-errors > 0 ? Ink.err : Ink.warn;
                            }
                        }

                        // What it's set to, like a line of code.
                        Text {
                            horizontal-stretch: 1;
                            text: step.summary;
                            color: Ink.text-mute;
                            font-size: Ink.fs-sm;
                            font-family: Ink.font-mono;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    // -- Controls: on hover, while open, or when set --
                    HorizontalLayout {
                        spacing: 0px;
                        padding-right: 4px;

                        // Breakpoint: off → stop (red) → snapshot (orange) → off.
                        bp-btn := Rectangle {
                            y: (parent.height - self.height) / 2;
                            // Inner steps of a component can't be breakpoint targets.
                            visible: PipelinesPanelState.open-component-name == "" && (root.hovered || step.expanded || root.bp-state != 0);
                            width: 22px;
                            height: 22px;
                            border-radius: Ink.radius-sm;
                            background: bp-btn-ta.has-hover ? Ink.border-soft : transparent;
                            accessible-role: button;
                            accessible-label: "Breakpoint";
                            Rectangle {
                                width: 9px;
                                height: 9px;
                                border-radius: 4.5px;
                                background: root.bp-state == 1 ? Ink.err : root.bp-state == 2 ? Ink.warn : transparent;
                                border-width: root.bp-state == 0 ? 1.5px : 0px;
                                border-color: Ink.text-faint;
                            }
                            bp-btn-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.toggle-breakpoint();
                                }
                            }
                        }

                        InkIconButton {
                            y: (parent.height - self.height) / 2;
                            visible: root.hovered || step.expanded || !step.enabled;
                            size: 22px;
                            icon: step.enabled ? InkIcons.visible : InkIcons.hidden;
                            label: step.enabled ? "Switch the step off" : "Switch the step on";
                            enabled: root.editable;
                            clicked => {
                                root.toggle-enabled();
                            }
                        }

                        // The settings in the larger dialog.
                        InkIconButton {
                            y: (parent.height - self.height) / 2;
                            visible: (root.hovered || step.expanded) && (step.parameters.length > 0 || step.advanced-count > 0);
                            size: 22px;
                            icon: InkIcons.expand;
                            label: "Open the settings";
                            clicked => {
                                root.open-settings();
                            }
                        }

                        InkIconButton {
                            y: (parent.height - self.height) / 2;
                            visible: root.hovered || step.expanded;
                            size: 22px;
                            icon: InkIcons.more;
                            label: "Step actions";
                            clicked => {
                                step-menu.show();
                            }
                        }
                    }
                }
            }

            // -- Expanded body --
        if step.expanded: Rectangle {

                // Top hairline separator inside the card
            Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 1px;
                    background: Theme.border-soft;
                }

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;

                    if step.problems.length > 0: VerticalLayout {
                        spacing: 6px;
                        for item in step.problems: ProblemRow {
                            item: item;
                            show-where: false;
                        }
                    }

                    // A component card with sections: collapsed to their
                    // values, a table where sections have the same settings.
                    // The settings as rows (name left, control right): those
                    // without a section first, then each section - collapsed
                    // to its values, or a table where sections have the
                    // same settings.
                    VerticalLayout {
                    spacing: 0px;
                    for section in step.section-views: VerticalLayout {
                        // A table's other sections are its rows: nothing here.
                        padding-bottom: section.kind == 2 ? 0px : 8px;
                        spacing: 6px;
                        if section.kind == 0: SectionHead {
                            section: section;
                            clicked => {
                                PipelinesPanelState.toggle-section(root.idx, section.name);
                            }
                        }
                        if section.kind == 1: CardTableView {
                            table: step.card-tables[section.table];
                            changed(name, v) => {
                                root.param-changed(name, v);
                            }
                        }
                        if section.kind == 3 || (section.kind == 0 && section.open): VerticalLayout {
                            padding-left: section.kind == 0 ? 12px : 0px;
                            spacing: 8px;
                            for p in section.params: InlineParamRow {
                                p: p;
                                changed(v) => {
                                    root.param-changed(p.name, v);
                                }
                                item-field-changed(item_idx, field_name, v) => {
                                    root.param-changed("\{p.name}.\{item_idx}.\{field_name}", v);
                                }
                                add-item => {
                                    PipelinesPanelState.add-group-item(step.id, p.name);
                                }
                                remove-item(idx) => {
                                    PipelinesPanelState.remove-group-item(step.id, p.name, idx);
                                }
                                show-model-info => {
                                    PipelinesPanelState.show-model-info(step.id);
                                }
                                toggle-exposed => {
                                    PipelinesPanelState.toggle-exposed(step.id, p.name);
                                }
                                toggle-item-exposed(item_idx, field_name) => {
                                    PipelinesPanelState.toggle-exposed(step.id, "\{p.name}.\{item_idx}.\{field_name}");
                                }
                                edit-exposed => {
                                    PipelinesPanelState.edit-exposed(step.id, p.name);
                                }
                                edit-item-exposed(item_idx, field_name) => {
                                    PipelinesPanelState.edit-exposed(step.id, "\{p.name}.\{item_idx}.\{field_name}");
                                }
                            }
                        }
                    }
                    }

                    if step.section-views.length == 0: VerticalLayout {
                        spacing: 10px;
                    for p in step.parameters: ParamRow {
                        p: p;
                        changed(v) => {
                            root.param-changed(p.name, v);
                        }
                        item-field-changed(item_idx, field_name, v) => {
                            root.param-changed("\{p.name}.\{item_idx}.\{field_name}", v);
                        }
                        add-item => {
                            PipelinesPanelState.add-group-item(step.id, p.name);
                        }
                        remove-item(idx) => {
                            PipelinesPanelState.remove-group-item(step.id, p.name, idx);
                        }
                        show-model-info => {
                            PipelinesPanelState.show-model-info(step.id);
                        }
                        toggle-exposed => {
                            PipelinesPanelState.toggle-exposed(step.id, p.name);
                        }
                        toggle-item-exposed(item_idx, field_name) => {
                            PipelinesPanelState.toggle-exposed(step.id, "\{p.name}.\{item_idx}.\{field_name}");
                        }
                        edit-exposed => {
                            PipelinesPanelState.edit-exposed(step.id, p.name);
                        }
                        edit-item-exposed(item_idx, field_name) => {
                            PipelinesPanelState.edit-exposed(step.id, "\{p.name}.\{item_idx}.\{field_name}");
                        }
                    }
                    }

                    if step.advanced-count > 0: AdvancedRow {
                        count: step.advanced-count;
                        changed-count: step.advanced-changed;
                        expanded: step.show-advanced || PipelinesPanelState.always-show-advanced;
                        always: PipelinesPanelState.always-show-advanced;
                        toggled => {
                            PipelinesPanelState.toggle-advanced(step.id);
                        }
                        always-toggled(on) => {
                            PipelinesPanelState.always-show-advanced-toggled(on);
                        }
                    }

                    for p in step.advanced-parameters: InlineParamRow {
                        p: p;
                        changed(v) => {
                            root.param-changed(p.name, v);
                        }
                        item-field-changed(item_idx, field_name, v) => {
                            root.param-changed("\{p.name}.\{item_idx}.\{field_name}", v);
                        }
                        add-item => {
                            PipelinesPanelState.add-group-item(step.id, p.name);
                        }
                        remove-item(idx) => {
                            PipelinesPanelState.remove-group-item(step.id, p.name, idx);
                        }
                        show-model-info => {
                            PipelinesPanelState.show-model-info(step.id);
                        }
                        toggle-exposed => {
                            PipelinesPanelState.toggle-exposed(step.id, p.name);
                        }
                        toggle-item-exposed(item_idx, field_name) => {
                            PipelinesPanelState.toggle-exposed(step.id, "\{p.name}.\{item_idx}.\{field_name}");
                        }
                        edit-exposed => {
                            PipelinesPanelState.edit-exposed(step.id, p.name);
                        }
                        edit-item-exposed(item_idx, field_name) => {
                            PipelinesPanelState.edit-exposed(step.id, "\{p.name}.\{item_idx}.\{field_name}");
                        }
                    }

                    // A component's own actions; the step's actions are in ⋯.
                    if root.step.category == StepCategory.component || root.step.update-version != "": HorizontalLayout {
                        spacing: 6px;
                        padding-top: 2px;
                        alignment: start;
                        if root.step.category == StepCategory.component: InkButton {
                            small: true;
                            text: "View";
                            clicked => {
                                root.view-component();
                            }
                        }
                        if root.step.category == StepCategory.component && root.editable: InkButton {
                            small: true;
                            text: "Edit";
                            clicked => {
                                root.open-component();
                            }
                        }
                        if root.step.update-version != "": InkButton {
                            small: true;
                            kind: InkButtonKind.primary;
                            text: "Update to v\{root.step.update-version}";
                            clicked => {
                                root.update-component();
                            }
                        }
                    }
                    // YODA
                Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }
        }
    
    step-menu := PopupWindow {
        x: root.width - 220px;
        y: 32px;
        InkMenuFrame {
            menu-width: 220px;
            InkMenuCaption { text: root.step.name; }
            InkMenuItem {
                icon: InkIcons.copy;
                text: "Duplicate";
                enabled: root.editable;
                clicked => {
                    root.duplicate();
                }
            }
            InkMenuItem {
                icon: InkIcons.component;
                text: "Bundle into a component…";
                enabled: root.editable;
                clicked => {
                    root.create-component();
                }
            }
            if root.step.category == StepCategory.component && root.editable: InkMenuItem {
                text: "Expand into its steps";
                clicked => {
                    root.expand-component();
                }
            }
            if root.step.category == StepCategory.component && PipelinesPanelState.open-component-name == "": InkMenuItem {
                icon: InkIcons.save;
                text: "Save to the library…";
                clicked => {
                    root.save-to-library();
                }
            }
            InkMenuSeparator { }
            InkMenuItem {
                icon: InkIcons.delete;
                text: "Remove step";
                danger: true;
                enabled: root.editable;
                clicked => {
                    root.remove();
                }
            }
        }
    }
}

// ----------------------------------------------------------
// Insertion point between rows

component InsertPoint inherits Rectangle {
    callback insert;

    height: 8px;
    accessible-role: button;
    accessible-label: "Insert a step here";
    accessible-action-default => {
        root.insert();
    }

    // Shown on hover: a line and a +, where the step goes.
    Rectangle {
        visible: ta.has-hover;
        x: 8px;
        y: (parent.height - 1px) / 2;
        width: parent.width - 16px;
        height: 1px;
        background: Ink.focus;
    }
    Rectangle {
        visible: ta.has-hover;
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Ink.focus;
        Image {
            source: InkIcons.add;
            width: 10px;
            colorize: #FFFFFF;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.insert();
        }
    }
}

// ----------------------------------------------------------
// Category filter chip

/*
component CategoryChip inherits Rectangle {
    in property <StepCategory> category;
    in property <int> count;
    in property <bool> active;
    callback clicked;

    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.active ? Cat.color(category) : Theme.border-soft;
    background: root.active ? Cat.tint(category) : transparent;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 5px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 1.5px;
                background: Cat.color(category);
            }
        }

        Text {
            text: Cat.name(category);
            color: root.active ? Cat.color(category) : Theme.text-dim;
            font-size: 10.5px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: count;
            color: Theme.text-mute;
            font-size: 10.5px;
            font-family: Theme.font-mono;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
    */
export component PipelinesPanel inherits Rectangle {
    property <bool> has-pipeline: PipelinesPanelState.pipelines.length > 0;

    VerticalLayout {
        spacing: 0px;

        // -- Head: the pipeline being edited (a click switches), focus, ⋯ --
        Rectangle {
            height: Ink.head-h;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 4px;

                switcher := Rectangle {
                    horizontal-stretch: 1;
                    accessible-role: button;
                    accessible-label: "Pipelines";
                    accessible-action-default => {
                        pipelines-popup.show();
                    }

                    Rectangle {
                        y: 4px;
                        height: parent.height - 8px;
                        border-radius: Ink.radius-md;
                        background: switch-ta.has-hover ? Ink.hover : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text {
                                text: root.has-pipeline ? "Steps · " + PipelinesPanelState.active-pipeline-name : "Pipelines";
                                font-size: Ink.fs-lg;
                                font-weight: 600;
                                color: Ink.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Image {
                                source: InkIcons.caret-down;
                                width: 10px;
                                colorize: Ink.text-mute;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: PipelinesPanelState.active-pipeline-image-source;
                                font-size: Ink.fs-sm;
                                font-family: Ink.font-mono;
                                color: Ink.text-mute;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    switch-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            pipelines-popup.show();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    FocusModeButton { }
                }

                VerticalLayout {
                    alignment: center;
                    InkIconButton {
                        size: 24px;
                        icon: InkIcons.more;
                        label: "Pipeline actions";
                        enabled: root.has-pipeline;
                        clicked => {
                            pipeline-menu.show();
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Ink.border-soft;
            }
        }

        // -- The project's problems --
        if PipelinesPanelState.project-problems.length > 0: Rectangle {
            // As high as its content - a Rectangle would stretch and take
            // height from the step list.
            height: strip.preferred-height;
            vertical-stretch: 0;
            background: PipelinesPanelState.project-problem-errors > 0 ? Ink.err-tint : Ink.warn-tint;

            strip := VerticalLayout {
                padding-left: 12px;
                padding-right: 10px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 6px;

                problems-head := HorizontalLayout {
                    spacing: 6px;
                    accessible-role: button;
                    accessible-label: "Problems";
                    Image {
                        source: PipelinesPanelState.problems-expanded ? InkIcons.caret-down : InkIcons.caret-right;
                        width: 10px;
                        colorize: Ink.text-mute;
                    }
                    Text {
                        text: PipelinesPanelState.project-problem-errors > 0
                            ? "\{PipelinesPanelState.project-problems.length} problems - \{PipelinesPanelState.project-problem-errors} make a run fail"
                            : "\{PipelinesPanelState.project-problems.length} things that look unintended";
                        font-size: Ink.fs-sm;
                        font-weight: 600;
                        color: PipelinesPanelState.project-problem-errors > 0 ? Ink.err : Ink.warn;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }

                if PipelinesPanelState.problems-expanded: ScrollView {
                    height: min(problem-list.preferred-height, 220px);
                    problem-list := VerticalLayout {
                        spacing: 8px;
                        padding-right: 6px;
                        for item in PipelinesPanelState.project-problems: ProblemRow {
                            item: item;
                        }
                    }
                }
            }

            // The head toggles the list (over the head only).
            TouchArea {
                x: 0px;
                y: 0px;
                width: 100%;
                height: problems-head.height + 14px;
                mouse-cursor: pointer;
                clicked => {
                    PipelinesPanelState.problems-expanded = !PipelinesPanelState.problems-expanded;
                }
            }
        }

        // -- An opened component: its bar stays on top while its steps scroll --
        if PipelinesPanelState.open-component-name != "": VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 8px;
            Rectangle {
                // As high as its (wrapping) text needs.
                height: bar.preferred-height;
                border-radius: Ink.radius-md;
                background: Ink.cat-component.with-alpha(0.10);
                border-width: 1px;
                border-color: Ink.cat-component.with-alpha(0.5);
                bar := HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        InkButton {
                            small: true;
                            kind: InkButtonKind.quiet;
                            text: "‹ Back";
                            clicked => {
                                PipelinesPanelState.close-component();
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "\{PipelinesPanelState.active-pipeline-name} › ◆ \{PipelinesPanelState.open-component-name}";
                            font-size: Ink.fs-md;
                            font-weight: 600;
                            color: Ink.text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: PipelinesPanelState.open-component-read-only ? "Viewing · read only" : "Changes apply to every use of this component · ◇ exposes a setting";
                            font-size: Ink.fs-xs;
                            color: Ink.text-mute;
                            wrap: word-wrap;
                        }
                        if PipelinesPanelState.open-component-values != "": Text {
                            text: PipelinesPanelState.open-component-values;
                            font-size: Ink.fs-xs;
                            color: Ink.text-dim;
                            wrap: word-wrap;
                        }
                        if PipelinesPanelState.open-component-problem != "": Text {
                            text: "⚠ \{PipelinesPanelState.open-component-problem}";
                            font-size: Ink.fs-xs;
                            color: Ink.warn;
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        if !PipelinesPanelState.open-component-read-only: InkButton {
                            small: true;
                            text: "Settings…";
                            clicked => {
                                PipelinesPanelState.open-component-settings();
                            }
                        }
                        if PipelinesPanelState.open-component-read-only: InkButton {
                            small: true;
                            text: "Edit";
                            clicked => {
                                PipelinesPanelState.edit-open-component();
                            }
                        }
                    }
                }
            }
        }

        // -- The steps --
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                // Steps at their own height - with a short pipeline the
                // stretchable parts of an expanded card would fill the panel.
                alignment: start;
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 4px;
                padding-top: 6px;
                spacing: 0px;

                if PipelinesPanelState.active-commands.length == 0: VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    Text {
                        text: root.has-pipeline ? "This pipeline is empty" : "No pipelines yet";
                        font-size: Ink.fs-lg;
                        font-weight: 600;
                        color: Ink.text;
                        horizontal-alignment: center;
                    }
                    InkHint {
                        text: root.has-pipeline ? "Add a step below - it runs on every image." : "A pipeline is a list of steps run on every image.";
                        horizontal-alignment: center;
                    }
                    if !root.has-pipeline: HorizontalLayout {
                        alignment: center;
                        padding-top: 4px;
                        InkButton {
                            text: "New pipeline";
                            kind: InkButtonKind.primary;
                            icon: InkIcons.add;
                            clicked => {
                                PipelinesPanelState.new-pipeline();
                            }
                        }
                    }
                }

                if PipelinesPanelState.active-commands.length > 0 && !PipelinesPanelState.open-component-read-only: InsertPoint {
                    insert => {
                        PipelinesPanelState.insert-step(PipelinesPanelState.active-pipeline-id, -1);
                    }
                }

                for cmd[i] in PipelinesPanelState.active-commands: VerticalLayout {
                    spacing: 0px;
                    StepRow {
                        step: cmd;
                        idx: i;
                        pipeline-id: PipelinesPanelState.active-pipeline-id;
                        toggle-enabled => {
                            PipelinesPanelState.toggle-step(cmd.id);
                        }
                        toggle-expanded => {
                            if cmd.expanded == true {
                                cmd.expanded = false;
                            } else {
                                cmd.expanded = true;
                            }
                            PipelinesPanelState.expand-step(cmd.id);
                        }
                        remove => {
                            PipelinesPanelState.remove-step(cmd.id);
                        }
                        duplicate => {
                            PipelinesPanelState.duplicate-step(cmd.id);
                        }
                        create-component => {
                            PipelinesPanelState.create-component(cmd.id);
                        }
                        open-component => {
                            PipelinesPanelState.open-component(cmd.id);
                        }
                        view-component => {
                            PipelinesPanelState.view-component(cmd.id);
                        }
                        expand-component => {
                            PipelinesPanelState.expand-component(cmd.id);
                        }
                        save-to-library => {
                            PipelinesPanelState.save-component-to-library(cmd.id);
                        }
                        update-component => {
                            PipelinesPanelState.update-component(cmd.id);
                        }
                        param-changed(n, v) => {
                            PipelinesPanelState.param-changed(cmd.id, n, v);
                        }
                        open-settings => {
                            PipelinesPanelState.open-step-settings(cmd.step-id);
                        }
                        toggle-breakpoint => {
                            if PipelinesPanelState.breakpoint-pipeline-id == PipelinesPanelState.active-pipeline-id && PipelinesPanelState.breakpoint-step-id == cmd.step-id {
                                if PipelinesPanelState.breakpoint-mode == 1 {
                                    // Stop → Snapshot (capture image, pipeline continues)
                                    PipelinesPanelState.breakpoint-mode = 2;
                                    PipelinesPanelState.show-breakpoint-image = false;
                                    PipelinesPanelState.show-breakpoint-image-changed(false);
                                    PipelinesPanelState.has-breakpoint-image = false;
                                    PipelinesPanelState.set-breakpoint(PipelinesPanelState.active-pipeline-id, cmd.step-id, 2);
                                } else {
                                    // Snapshot → Off; captured image remains available.
                                    PipelinesPanelState.breakpoint-pipeline-id = -1;
                                    PipelinesPanelState.breakpoint-step-id = "";
                                    PipelinesPanelState.breakpoint-mode = 0;
                                    PipelinesPanelState.clear-breakpoint();
                                }
                            } else {
                                // Off → Stop (pipeline halts at step)
                                PipelinesPanelState.breakpoint-pipeline-id = PipelinesPanelState.active-pipeline-id;
                                PipelinesPanelState.breakpoint-step-id = cmd.step-id;
                                PipelinesPanelState.breakpoint-mode = 1;
                                PipelinesPanelState.show-breakpoint-image = false;
                                PipelinesPanelState.show-breakpoint-image-changed(false);
                                PipelinesPanelState.has-breakpoint-image = false;
                                PipelinesPanelState.set-breakpoint(PipelinesPanelState.active-pipeline-id, cmd.step-id, 1);
                            }
                        }
                    }

                    if i < PipelinesPanelState.active-commands.length - 1 && !PipelinesPanelState.open-component-read-only: InsertPoint {
                        insert => {
                            PipelinesPanelState.insert-step(PipelinesPanelState.active-pipeline-id, i);
                        }
                    }
                    if i >= PipelinesPanelState.active-commands.length - 1: Rectangle {
                        height: 6px;
                    }
                }

                if root.has-pipeline && !PipelinesPanelState.open-component-read-only: add-step := Rectangle {
                    height: 30px;
                    accessible-role: button;
                    accessible-label: "Add step";
                    accessible-action-default => {
                        PipelinesPanelState.insert-step(PipelinesPanelState.active-pipeline-id, PipelinesPanelState.active-commands.length);
                    }
                    Rectangle {
                        border-radius: Ink.radius-md;
                        border-width: 1px;
                        border-color: add-ta.has-hover ? Ink.text-faint : Ink.border;
                        background: add-ta.has-hover ? Ink.hover : transparent;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Image {
                                source: InkIcons.add;
                                width: 12px;
                                colorize: Ink.text-dim;
                            }
                            Text {
                                text: "Add step";
                                color: Ink.text-dim;
                                font-size: Ink.fs-md;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }
                    add-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            PipelinesPanelState.insert-step(PipelinesPanelState.active-pipeline-id, PipelinesPanelState.active-commands.length);
                        }
                    }
                }
            }
        }

        // -- Footer: the breakpoint's image, totals --
        VerticalLayout {
            padding-left: 12px;
            padding-right: 10px;
            padding-top: 6px;
            padding-bottom: 8px;
            spacing: 6px;

            if PipelinesPanelState.has-breakpoint-image: HorizontalLayout {
                spacing: 6px;
                InkSwitch {
                    text: "Breakpoint image";
                    checked: PipelinesPanelState.show-breakpoint-image;
                    toggled(on) => {
                        PipelinesPanelState.show-breakpoint-image = on;
                        PipelinesPanelState.show-breakpoint-image-changed(on);
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if PipelinesPanelState.show-breakpoint-image: InkSelect {
                    width: 140px;
                    label: "Breakpoint shows";
                    model: ["Processed image", "Segmentation", "Instances"];
                    selected: PipelinesPanelState.breakpoint-view-mode;
                    picked(i, name) => {
                        PipelinesPanelState.breakpoint-view-mode = i;
                        PipelinesPanelState.breakpoint-view-mode-changed(i);
                    }
                }
            }

            HorizontalLayout {
                spacing: 4px;
                Text {
                    horizontal-stretch: 1;
                    text: PipelinesPanelState.enabled-pipeline-count + " of " + PipelinesPanelState.pipelines.length + " pipelines · " + PipelinesPanelState.total-enabled-steps + " steps";
                    color: Ink.text-mute;
                    font-size: Ink.fs-xs;
                    font-family: Ink.font-mono;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: "~" + PipelinesPanelState.eta-seconds-per-image + " s/image";
                    color: Ink.text-mute;
                    font-size: Ink.fs-xs;
                    font-family: Ink.font-mono;
                    vertical-alignment: center;
                }
            }
        }
    }

    pipelines-popup := PopupWindow {
        x: 6px;
        y: Ink.head-h - 4px;
        close-policy: close-on-click-outside;

        InkMenuFrame {
            menu-width: min(root.width + 40px, 380px);
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                height: 24px;
                Text {
                    horizontal-stretch: 1;
                    text: "PIPELINES";
                    font-size: Ink.fs-xs;
                    font-weight: 600;
                    letter-spacing: 0.6px;
                    color: Ink.text-mute;
                    vertical-alignment: center;
                }
                Text {
                    text: "☑ = included in Run";
                    font-size: Ink.fs-xs;
                    color: Ink.text-faint;
                    vertical-alignment: center;
                }
            }
            for p in PipelinesPanelState.pipelines: PipelineTab {
                pipeline: p;
                active: p.id == PipelinesPanelState.active-pipeline-id;
                selected => {
                    PipelinesPanelState.active-pipeline-id = p.id;
                    PipelinesPanelState.select-pipeline(p.id);
                    PipelineFocusState.pipeline-selected(p.id);
                    pipelines-popup.close();
                }
                // Double-click edits the pipeline, Alt+click focuses it.
                double-clicked => {
                    PipelinesPanelState.pipeline-more(p.id);
                    pipelines-popup.close();
                }
                alt-clicked => {
                    PipelineFocusState.toggle-pipeline-focus(p.id);
                }
                focus-clicked => {
                    PipelineFocusState.toggle-pipeline-focus(p.id);
                }
                toggled => {
                    PipelinesPanelState.toggle-pipeline(p.id);
                }
                move-up => {
                    PipelinesPanelState.move-pipeline-up(p.id);
                }
                move-down => {
                    PipelinesPanelState.move-pipeline-down(p.id);
                }
                more-clicked => {
                    PipelinesPanelState.pipeline-more(p.id);
                    pipelines-popup.close();
                }
            }
            InkMenuSeparator { }
            InkMenuItem {
                icon: InkIcons.add;
                text: "New pipeline";
                clicked => {
                    PipelinesPanelState.new-pipeline();
                    pipelines-popup.close();
                }
            }
        }
    }

    pipeline-menu := PopupWindow {
        x: root.width - 250px;
        y: Ink.head-h - 4px;

        InkMenuFrame {
            menu-width: 250px;
            InkMenuCaption { text: PipelinesPanelState.active-pipeline-name; }
            InkMenuItem {
                icon: InkIcons.edit;
                text: "Edit name and image source…";
                clicked => {
                    PipelinesPanelState.pipeline-more(PipelinesPanelState.active-pipeline-id);
                }
            }
            InkMenuItem {
                icon: InkIcons.copy;
                text: "Duplicate";
                clicked => {
                    PipelinesPanelState.duplicate-pipeline(PipelinesPanelState.active-pipeline-id);
                }
            }
            InkMenuItem {
                icon: InkIcons.component;
                text: "Save as component…";
                clicked => {
                    PipelinesPanelState.save-as-component();
                }
            }
            InkMenuSeparator { }
            InkMenuItem {
                icon: InkIcons.add;
                text: "New pipeline";
                clicked => {
                    PipelinesPanelState.new-pipeline();
                }
            }
            InkMenuItem {
                icon: InkIcons.delete;
                text: "Delete pipeline…";
                danger: true;
                clicked => {
                    PipelinesPanelState.delete-pipeline(PipelinesPanelState.active-pipeline-id);
                }
            }
        }
    }
}

// ══════════════════════════════════════════════════════════
// Step settings dialog

// One section of the settings dialog's list on the left.
component SectionNavItem inherits Rectangle {
        in property <string> text;
    // Shown after the name, e.g. "2 changed".
    in property <string> note;
        in property <bool> active;
        callback clicked;

        height: 30px;
        border-radius: 6px;
        background: root.active ? Theme.accent-dim : (ta.has-hover ? Theme.hover : transparent);

        Rectangle {
            x: 0;
            y: 7px;
            width: 3px;
            height: parent.height - 14px;
            border-radius: 1.5px;
            background: root.active ? Theme.accent : transparent;
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 6px;

            Text {
                text: root.text;
                vertical-alignment: center;
                font-size: 12px;
                font-weight: root.active ? 600 : 400;
                color: root.active ? Theme.text : Theme.text-dim;
                overflow: elide;
            }

            if root.note != "": Text {
                text: root.note;
                vertical-alignment: center;
                font-size: 10px;
                color: Theme.warn;
            }
        }

        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }

// A step's settings in a larger dialog (⤢ on the step card), like the
// project settings: the step's sections - the sections of its settings,
// and "Advanced" - on the left, the chosen section's settings on the right;
// or, while searching, every matching setting. Shows the step
// `PipelinesPanelState.settings-step-id`, live: edits go through the same
// callbacks as on the card. (Opening it shows the step's advanced settings,
// so they are there to pick and to search.)
export component StepSettingsDialog inherits Dialog {
        title: "Step settings";
        dialog-width: 920px;
        dialog-height: 660px;
        content-padding: 0px;
        close-on-backdrop: true;

        // The list is rebuilt after each change - what's chosen lives out here
    // so it stays.
    // Index into the step's `sections`; `sections.length` is Advanced.
    property <int> current: 0;
        property <string> query;
        property <bool> searching: root.query.replace-all(" ", "") != "";

        // Whether setting `p` is found by the search text (ignoring case).
    pure function matches(p: CommandParameter) -> bool {
            root.found("\{p.display-name} \{p.name} \{p.description} \{p.section}")
        }

        pure function found(words: string) -> bool {
            words.to-lowercase().replace-all(root.query.to-lowercase(), "") != words.to-lowercase()
        }

        // Whether setting `p` of the basic (not advanced) ones is shown.
    pure function shows(p: CommandParameter, sections: [string]) -> bool {
            root.searching ? root.matches(p) : (root.current < sections.length && p.section == sections[root.current])
        }

        // The chosen step's settings - one list for all steps, so the
        // step is found in it (the list is rebuilt after each change).
        Rectangle {
        vertical-stretch: 1;
        for cmd in PipelinesPanelState.active-commands: Rectangle {
            width: 100%;
            height: 100%;
            if cmd.step-id == PipelinesPanelState.settings-step-id: Rectangle {
                property <bool> on-advanced: !root.searching && root.current >= cmd.sections.length;

                width: 100%;
                height: 100%;
                border-width: 1px;
                border-color: Theme.border-soft;
                clip: true;

                HorizontalLayout {
                // -- Left: name, search, sections --
                Rectangle {
                        width: 230px;
                        background: Theme.bg;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 4px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 4px;
                                    border-radius: 2px;
                                    background: Cat.color(cmd.category);
                                }

                                Text {
                                    text: cmd.name;
                                    font-size: 18px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                            }

                            Rectangle {
                                height: 10px;
                            }

                            LineEdit {
                                text: root.query;
                                placeholder-text: "Search settings";
                                edited(t) => {
                                    root.query = t;
                                }
                            }

                            Rectangle {
                                height: 10px;
                            }

                            for section[si] in cmd.sections: SectionNavItem {
                                text: section == "" ? "General" : section;
                                active: !root.searching && root.current == si;
                                clicked => {
                                    root.query = "";
                                    root.current = si;
                                }
                            }

                            if cmd.advanced-count > 0: SectionNavItem {
                                text: "Advanced (\{cmd.advanced-count})";
                                note: cmd.advanced-changed > 0 ? "\{cmd.advanced-changed} changed" : "";
                                active: on-advanced;
                                clicked => {
                                    root.query = "";
                                    root.current = cmd.sections.length;
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 1px;
                        background: Theme.border-soft;
                    }

                    // -- Right: the chosen section's settings --
                Rectangle {
                        horizontal-stretch: 1;
                        ScrollView {
                            VerticalLayout {
                                padding: 24px;
                                padding-top: 20px;
                                spacing: 6px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.searching ? "Search results" : on-advanced ? "Advanced" : (cmd.sections[root.current] == "" ? "General" : cmd.sections[root.current]);
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: cmd.summary;
                                    font-size: 11px;
                                    font-family: Theme.font-mono;
                                    color: Theme.text-mute;
                                    overflow: elide;
                                }

                                // What the command does - on its first page.
                            if cmd.help != "" && !root.searching && root.current == 0: Text {
                                    text: cmd.help;
                                    font-size: 11px;
                                    color: Theme.text-dim;
                                    wrap: word-wrap;
                                    height: self.preferred-height;
                                }

                                Rectangle {
                                    height: 8px;
                                }

                                // The rows draw the dividers between them; the
                            // card's top border is the first one's.
                            Rectangle {
                                    background: Theme.panel;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.border-soft;
                                    clip: true;

                                    VerticalLayout {
                                        padding-top: -1px;

                                        if !on-advanced: VerticalLayout {
                                            for p in cmd.parameters: VerticalLayout {
                                                if root.shows(p, cmd.sections): WideParamRow {
                                                    p: p;
                                                    changed(v) => {
                                                        PipelinesPanelState.param-changed(cmd.id, p.name, v);
                                                    }
                                                    item-field-changed(item_idx, field_name, v) => {
                                                        PipelinesPanelState.param-changed(cmd.id, "\{p.name}.\{item_idx}.\{field_name}", v);
                                                    }
                                                    add-item => {
                                                        PipelinesPanelState.add-group-item(cmd.id, p.name);
                                                    }
                                                    remove-item(idx) => {
                                                        PipelinesPanelState.remove-group-item(cmd.id, p.name, idx);
                                                    }
                                                    show-model-info => {
                                                        PipelinesPanelState.show-model-info(cmd.id);
                                                    }
                                                    toggle-exposed => {
                                                        PipelinesPanelState.toggle-exposed(cmd.id, p.name);
                                                    }
                                                    toggle-item-exposed(item_idx, field_name) => {
                                                        PipelinesPanelState.toggle-exposed(cmd.id, "\{p.name}.\{item_idx}.\{field_name}");
                                                    }
                                                    edit-exposed => {
                                                        PipelinesPanelState.edit-exposed(cmd.id, p.name);
                                                    }
                                                    edit-item-exposed(item_idx, field_name) => {
                                                        PipelinesPanelState.edit-exposed(cmd.id, "\{p.name}.\{item_idx}.\{field_name}");
                                                    }
                                                }
                                            }
                                        }

                                        if on-advanced || root.searching: VerticalLayout {
                                            for p in cmd.advanced-parameters: VerticalLayout {
                                                if !root.searching || root.matches(p): WideParamRow {
                                                    p: p;
                                                    changed(v) => {
                                                        PipelinesPanelState.param-changed(cmd.id, p.name, v);
                                                    }
                                                    item-field-changed(item_idx, field_name, v) => {
                                                        PipelinesPanelState.param-changed(cmd.id, "\{p.name}.\{item_idx}.\{field_name}", v);
                                                    }
                                                    add-item => {
                                                        PipelinesPanelState.add-group-item(cmd.id, p.name);
                                                    }
                                                    remove-item(idx) => {
                                                        PipelinesPanelState.remove-group-item(cmd.id, p.name, idx);
                                                    }
                                                    show-model-info => {
                                                        PipelinesPanelState.show-model-info(cmd.id);
                                                    }
                                                    toggle-exposed => {
                                                        PipelinesPanelState.toggle-exposed(cmd.id, p.name);
                                                    }
                                                    toggle-item-exposed(item_idx, field_name) => {
                                                        PipelinesPanelState.toggle-exposed(cmd.id, "\{p.name}.\{item_idx}.\{field_name}");
                                                    }
                                                    edit-exposed => {
                                                        PipelinesPanelState.edit-exposed(cmd.id, p.name);
                                                    }
                                                    edit-item-exposed(item_idx, field_name) => {
                                                        PipelinesPanelState.edit-exposed(cmd.id, "\{p.name}.\{item_idx}.\{field_name}");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
