// pipelines_panel.slint
// EVAnalyzer - Pipelines panel.
// Owns N pipelines; each pipeline is a flat, ordered list of commands.
// Category is a property of each step (colored stripe), not a hard bucket.

import { Dialog } from "../components/new_components/dialog.slint";
import { NumberSpinner } from "../components/new_components/number_spinner.slint";
import {
    ScrollView,
    LineEdit,
    ComboBox,
    Slider,
    CheckBox,
    Palette,
} from "std-widgets.slint";
import { Theme } from "../style.slint";
import {
    ImageAddressPicker,
    ChannelPicker,
} from "../components/channel_picker.slint";
import { PickerField, PickerRow, SwatchName } from "../components/picker_field.slint";
import { ClassificationState, ClassItemData } from "classification_panel.slint";
import { PipelineFocusState, FocusModeButton } from "pipeline_focus.slint";
import { ScriptEditorState, ScriptFont } from "script_editor_panel.slint";

// ----------------------------------------------------------
// Data model

export enum StepCategory { preprocess, segment, instance-segmentation, measure, object, dataset, component }
export enum PipelineStatus { idle, queued, running, done, error }
export enum ParamType {
    number,
    text,
    dropdown,
    toggle,
    slider,
    spinner,
    group,
    obj-class,
    seg-class,
    multi-obj-class,
    multi-seg-class,
    pixel-units,
    size-units,
    label,
    file-path,
    image-address,
    image-channel,
    script }

export struct LeafParam {
        name: string,
        display-name: string,
        description: string,
        value: string,
        param-type: ParamType,
        options: [string],
        min: float,
        max: float,
        step: float,
        // Inside an opened component: this setting is a component parameter.
        exposed: bool,
    }

export struct GroupItem {
        fields: [LeafParam],
    }

export struct CommandParameter {
        name: string,
        display-name: string,
        description: string,
        value: string,
        param-type: ParamType,
        options: [string],
        min: float,
        max: float,
        step: float,
        group-items: [GroupItem],
        // True only for a `PixelClassifier`/`AiObjectClassifier` step's
        // `model_path` field, once a model is set - shows an info button that
        // opens the model's saved metadata (name/description/classes).
        // Computed in Rust rather than matched on `name`/`display-name` here,
        // so this is the one place that knows which commands these are.
        has-model-info: bool,
        // Inside an opened component: this setting is a component parameter.
        exposed: bool,
        // The header shown above the setting where its section (`#[cmdsmeta(section)]`
        // or a component parameter's) starts. Empty otherwise - also for the
        // settings without a section, which come first.
        section-header: string,
        // The setting's section; empty: none.
        section: string,
        // The first paragraph of `description`, on one line - shown in the
        // settings dialog, with "?" for the rest.
        short-description: string,
        // `description` says more than `short-description`.
        more-help: bool,
        // A component parameter: what it sets ("Sets ExtractObjects › …"); a
        // setting of an opened component: the parameter setting it. Else empty.
        wiring: string,
        // What a check found about this setting, or empty.
        problem: string,
        problem-error: bool,
    }

// A problem the checks found (`check_project`) - in the panel's problem list
// and on the card of the step it's about.
export struct ProblemItem {
        text: string,
        // A run fails (else: works, but probably isn't meant).
        error: bool,
        // Where it is: "Channel1 · step 1", "Component Coloc 3CH".
        where: string,
        // The one-click fix's button ("Add class 1"), or empty.
        fix-label: string,
        // Its number in the project's list - what show/fix refer to.
        index: int,
    }

// A section of a component card (see `PipelineCommand.section-views`).
export struct SectionView {
        name: string,
        // Its settings' values on one line ("CY7 · 200 · ch1@coloc_ch3").
        summary: string,
        // Shows its settings (a collapsible section).
        open: bool,
        // 0: collapsible; 1: the first of a table's sections - shows table
        // `table`; 2: another of that table's sections (shown by the first);
        // 3: the settings without a section, always shown.
        kind: int,
        table: int,
        // What a check found among its settings: 0 nothing, 1 a warning, 2 an error.
        problem: int,
        // Its settings.
        params: [CommandParameter],
    }

// A row of a `CardTable`: a section, its settings as the cells.
export struct CardTableRow {
        name: string,
        problem: int,
        cells: [CommandParameter],
    }

// Sections with the same settings, as one table: a row per section, a
// column per setting.
export struct CardTable {
        columns: [string],
        rows: [CardTableRow],
        // What the checks found about its cells, each once.
        problems: [string],
        problem-error: bool,
    }

export struct PipelineCommand {
        // Position in the pipeline - what the step actions (remove, move,
        // change a parameter) refer to; the list is rebuilt after each change.
        id: int,
        // The step's stable id - for what must stay with the step when steps
        // above it are inserted or removed (breakpoint, expanded state).
        step-id: string,
        name: string,
        category: StepCategory,
        summary: string,        // "σ = 2.0 · per channel"
        // What the command or component does - behind the card's "?" (empty: no "?").
        help: string,
        enabled: bool,
        expanded: bool,
        parameters: [CommandParameter],
        // Settings marked `visibility = Advanced`: shown below the "Advanced
        // settings" row, and only while it is expanded (empty otherwise).
        advanced-parameters: [CommandParameter],
        // The advanced section of this step is expanded (kept per step).
        show-advanced: bool,
        // How many advanced settings the step has, and how many of them differ
        // from their default (shown on the collapsed row so changed hidden
        // values never go unnoticed).
        advanced-count: int,
        advanced-changed: int,
        // A component card: the component library has a newer version ("3"), or empty.
        update-version: string,
        // The sections of `parameters`, in order - "" (no section) first
        // when there are such settings. The settings dialog's sections.
        sections: [string],
        // A component card with sections: how they're shown - collapsed to a
        // summary, open, or as a table when several have the same settings.
        // Empty otherwise (the settings one below the other).
        section-views: [SectionView],
        card-tables: [CardTable],
        // What the checks found about this step.
        problems: [ProblemItem],
        // How many of `problems` are errors.
        problem-errors: int,
    }

export struct Pipeline {
        id: int,
        name: string,
        image-source: string,
        enabled: bool,                 // included in "Run all"
    dirty: bool,                   // unsaved changes
    status: PipelineStatus,
        total-step-count: int,         // pre-computed in host
    enabled-step-count: int,       // pre-computed in host
}

// ----------------------------------------------------------
// Helpers - category & status

global Cat {
        public pure function color(c: StepCategory) -> color {
            if c == StepCategory.preprocess {
                return Theme.cat-preprocess;
            }
            if c == StepCategory.segment {
                return Theme.cat-segment;
            }
            if c == StepCategory.instance-segmentation {
                return Theme.cat-object;
            }
            if c == StepCategory.measure {
                return Theme.cat-measure;
            }
            if c == StepCategory.dataset {
                return Theme.cat-dataset;
            }
            if c == StepCategory.component {
                return Theme.cat-component;
            }
            return Theme.cat-classify;
        }
        public pure function tint(c: StepCategory) -> color {
            return Cat.color(c).with-alpha(0.15);
        }
        public pure function name(c: StepCategory) -> string {
            if c == StepCategory.preprocess {
                return "Preprocess";
            }
            if c == StepCategory.segment {
                return "Segment";
            }
            if c == StepCategory.instance-segmentation {
                return "Instance Seg.";
            }
            if c == StepCategory.measure {
                return "Measure";
            }
            if c == StepCategory.dataset {
                return "Dataset";
            }
            if c == StepCategory.component {
                return "Component";
            }
            return "Object";
        }
    }

global Status {
        public pure function color(s: PipelineStatus) -> color {
            if s == PipelineStatus.running {
                return Theme.warn;
            }
            if s == PipelineStatus.queued {
                return Theme.accent;
            }
            if s == PipelineStatus.done {
                return Theme.ok;
            }
            if s == PipelineStatus.error {
                return Theme.err;
            }
            return Theme.text-faint;
        }
        public pure function name(s: PipelineStatus) -> string {
            if s == PipelineStatus.running {
                return "RUN";
            }
            if s == PipelineStatus.queued {
                return "QUEUED";
            }
            if s == PipelineStatus.done {
                return "DONE";
            }
            if s == PipelineStatus.error {
                return "ERR";
            }
            return "IDLE";
        }
    }

// ----------------------------------------------------------
// Reusable bits

// Square ghost icon button.
component GhostIconBtn inherits Rectangle {
        in property <image> icon;
        in property <length> sz: 22px;
        in property <length> icon-sz: 12px;
        in property <bool> enabled: true;
        in property <color> tint: Theme.text-dim;
        callback clicked;

        width: sz;
        height: sz;
        border-radius: 4px;
        opacity: root.enabled ? 1.0 : 0.4;
        background: ta.has-hover && root.enabled ? Theme.raised : transparent;
        animate background { duration: 100ms; }

        Image {
            source: root.icon;
            width: root.icon-sz;
            height: root.icon-sz;
            colorize: ta.has-hover && root.enabled ? Theme.text : root.tint;
        }

        ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }

// 14×14 square checkbox (used for pipeline-include-in-run toggle).
component SquareCheck inherits Rectangle {
        in property <bool> checked;
        callback toggled;

        width: 14px;
        height: 14px;
        border-radius: 3px;
        background: root.checked ? Theme.accent : transparent;
        border-width: root.checked ? 0px : 1.5px;
        border-color: Theme.border;
        animate background { duration: 100ms; }

        if root.checked: Image {
            source: @image-url("../icons/regular-white/check.svg");
            width: 10px;
            height: 10px;
            colorize: #ffffff;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.toggled();
            }
        }
    }

// Small mono dot (5–6 px) used for status / dirty markers.
component DotPx inherits Rectangle {
        in property <length> sz: 6px;
        in property <color> fill;
        width: sz;
        height: sz;
        border-radius: sz / 2;
        background: fill;
    }

// ----------------------------------------------------------
// Pipeline tab row

// "Advanced (n) · m changed" row of a step card: expands/collapses the
// step's advanced settings; "Always" expands them in every step. Labels are
// short and elide, so this row never widens the card (and with it the list,
// which would then show a horizontal scrollbar).
component AdvancedRow inherits Rectangle {
        in property <int> count;
        in property <int> changed-count;
        in property <bool> expanded;
        in property <bool> always;
        callback toggled;
        callback always-toggled(bool);

        height: 24px;

        HorizontalLayout {
            spacing: 6px;
            row-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.toggled();
                }
                HorizontalLayout {
                    spacing: 5px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.expanded ? @image-url("../icons/regular-white/caret-down.svg") : @image-url("../icons/regular-white/caret-right.svg");
                            width: 10px;
                            height: 10px;
                            colorize: row-ta.has-hover ? Theme.text : Theme.text-dim;
                        }
                    }

                    Text {
                        text: "Advanced (\{root.count})";
                        font-size: 11px;
                        font-weight: 600;
                        color: row-ta.has-hover ? Theme.text : Theme.text-dim;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.changed-count > 0: Text {
                        text: "· \{root.changed-count} changed";
                        font-size: 11px;
                        color: Theme.warn;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            HorizontalLayout {
                spacing: 5px;
                alignment: end;
                VerticalLayout {
                    alignment: center;
                    SquareCheck {
                        checked: root.always;
                        toggled => {
                            root.always-toggled(!root.always);
                        }
                    }
                }

                Text {
                    text: "Always";
                    font-size: 10px;
                    color: Theme.text-mute;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

component PipelineTab inherits Rectangle {
        in property <Pipeline> pipeline;
        in property <bool> active;
        callback selected;
        callback double-clicked;
        callback alt-clicked;
        callback toggled;
        callback more-clicked;
        callback move-up;
        callback move-down;

        height: 46px;
        border-radius: 5px;
        background: root.active ? Theme.raised : (ta.has-hover ? Theme.raised.with-alpha(0.5) : transparent);
        border-width: 1px;
        border-color: root.active ? Theme.border : transparent;
        opacity: pipeline.enabled ? 1.0 : 0.55;
        animate background { duration: 80ms; }

        // 3px accent bar on the left (only when active)
    if root.active: Rectangle {
            x: 0px;
            y: 6px;
            width: 3px;
            height: parent.height - 12px;
            background: Theme.accent;
            border-radius: 1.5px;
        }

        // Declared first so the HorizontalLayout (buttons) renders on top and receives clicks first.
    ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.selected();
            }
            double-clicked => {
                root.double-clicked();
            }
            // `clicked` carries no modifier keys - Alt+click is caught on
            // the press itself.
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left && e.modifiers.alt) {
                    root.alt-clicked();
                }
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            spacing: 9px;
            alignment: stretch;

            // Run-toggle
        VerticalLayout {
                alignment: center;
                SquareCheck {
                    checked: pipeline.enabled;
                    toggled => {
                        root.toggled();
                    }
                }
            }

            // Name + meta
        VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: 5px;
                    alignment: start;
                    Text {
                        text: pipeline.name;
                        font-size: 12px;
                        font-weight: 500;
                        color: root.active ? Theme.text : Theme.text-dim;
                        overflow: elide;
                    }

                    if pipeline.dirty: VerticalLayout {
                        alignment: center;
                        DotPx {
                            sz: 5px;
                            fill: Theme.warn;
                        }
                    }
                }

                Text {
                    text: pipeline.image-source + " · " + pipeline.total-step-count + " steps · " + pipeline.enabled-step-count + " on";
                    font-size: 10px;
                    font-family: Theme.font-mono;
                    color: Theme.text-mute;
                    overflow: elide;
                }
            }

            // Status pill
     /*
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 5px;
                alignment: end;
                VerticalLayout {
                    alignment: center;
                    DotPx {
                        sz: 5px;
                        fill: Status.color(pipeline.status);
                    }
                }

                Text {
                    text: Status.name(pipeline.status);
                    font-size: 9.5px;
                    letter-spacing: 0.4px;
                    color: Theme.text-mute;
                    vertical-alignment: center;
                }
            }
        }
*/
        // Move + more buttons (visible on hover)
        VerticalLayout {
                alignment: center;
                padding-right: 2px;
                HorizontalLayout {
                    spacing: 0px;
                    opacity: ta.has-hover || root.active ? 1.0 : 0.0;
                    animate opacity { duration: 100ms; }
                    GhostIconBtn {
                        icon: @image-url("../icons/regular-white/arrow-up.svg");
                        sz: 20px;
                        icon-sz: 10px;
                        clicked => {
                            root.move-up();
                        }
                    }

                    GhostIconBtn {
                        icon: @image-url("../icons/regular-white/arrow-down.svg");
                        sz: 20px;
                        icon-sz: 10px;
                        clicked => {
                            root.move-down();
                        }
                    }

                    GhostIconBtn {
                        icon: @image-url("../icons/regular-white/dots-three.svg");
                        clicked => {
                            root.more-clicked();
                        }
                    }
                }
            }
        }
    }

// ----------------------------------------------------------
// Class-dropdown helpers

/// The classes of the component opened in the pipelines panel ("L1", ...) -
/// its class dropdowns offer them besides the project's.
export global ComponentClassesState {
    in property <[ClassItemData]> classes: [];
}

global ClassHelper {
        pure public function zeropad2(n: int) -> string {
            n < 10 ? "0\{n}" : "\{n}"
        }
        pure public function label(val: string, prefix: string) -> string {
            val == "-1" ? "Unset" : val == "4294967295" ? "Manual annotation" : val == "0" ? "Background" : !val.is-float() ? "◆ Component class " + val : prefix + " class " + ClassHelper.zeropad2(round(val.to-float()))
        }
    }

// Dropdown for ObjectClass (prefix "Obj.") and SegmentationClass (prefix "Seg.").
// Special items at top: Manual annotation (4294967295) and Background (0),
// followed by named classes from ClassificationState.
component ClassDropdown inherits Rectangle {
        in property <bool> is-seg: false;
        in-out property <string> value: "0";
        /// Also offer the opened component's classes (`ComponentClassesState`).
        in property <bool> component-classes: false;
        // A narrow field (a table cell): a numbered class by its number alone.
        in property <bool> compact: false;
        callback changed(string);

        property <string> prefix: root.is-seg ? "Seg." : "Obj.";
        // "Unset", "Background", ... aren't numbered entries.
        property <bool> numbered: root.value.is-float() && root.value != "-1" && root.value != "0" && root.value != "4294967295";

        height: 24px;

        function pick(value: string) {
            root.value = value;
            root.changed(value);
            popup.close();
        }

        PickerField {
            label: root.compact && root.numbered ? ClassHelper.zeropad2(round(root.value.to-float())) : ClassHelper.label(root.value, root.prefix);
            mono: root.numbered || !root.value.is-float();
            clicked => {
                popup.show();
            }
            for cls in ClassificationState.classes_list: SwatchName {
                visible: root.numbered && cls.id == round(root.value.to-float());
                color: cls.color;
                name: cls.name;
            }
            for cls in ComponentClassesState.classes: SwatchName {
                visible: root.value == "L\{cls.id}";
                color: cls.color;
                name: cls.name;
            }
        }

        popup := PopupWindow {
            x: 0px;
            y: root.height + 2px;
            width: max(root.width, 220px);
            height: 300px;

            Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 6px;
                drop-shadow-blur: 12px;
                drop-shadow-color: Theme.shadow;
                clip: true;

                ScrollView {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;

                    VerticalLayout {
                        spacing: 0px;

                        PickerRow {
                            label: "Unset";
                            mono: false;
                            label-color: Theme.text-mute;
                            selected: root.value == "-1";
                            clicked => {
                                root.pick("-1");
                            }
                        }

                        PickerRow {
                            label: "Manual annotation";
                            mono: false;
                            selected: root.value == "4294967295";
                            clicked => {
                                root.pick("4294967295");
                            }
                        }

                        PickerRow {
                            label: "Background";
                            mono: false;
                            selected: root.value == "0";
                            clicked => {
                                root.pick("0");
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        // The opened component's own classes.
                        for cls in ComponentClassesState.classes: PickerRow {
                            height: root.component-classes && !root.is-seg ? 28px : 0px;
                            visible: root.component-classes && !root.is-seg;
                            label: "◆ L\{cls.id}";
                            label-color: Theme.cat-component;
                            selected: root.value == "L\{cls.id}";
                            clicked => {
                                root.pick("L\{cls.id}");
                            }
                            SwatchName {
                                color: cls.color;
                                name: cls.name;
                            }
                        }

                        if root.component-classes && !root.is-seg && ComponentClassesState.classes.length > 0: Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        // Fixed 32 numbered entries; color and name for a class the
                        // project defines.
                        for i in 32: PickerRow {
                            label: root.prefix + " class " + ClassHelper.zeropad2(i + 1);
                            selected: root.numbered && round(root.value.to-float()) == i + 1;
                            clicked => {
                                root.pick("\{i + 1}");
                            }
                            for cls in ClassificationState.classes-list: SwatchName {
                                visible: cls.id == i + 1;
                                color: cls.color;
                                name: cls.name;
                            }
                        }
                    }
                }
            }
        }
    }

// ----------------------------------------------------------
// Multi-select class dropdown - fires changed("toggle:N") on each row click.
// selection-flags is a 33-element [string] ("1"/"0") for classes 0–32,
// populated by the generator via to_parameters() and kept live by the controller.
// Exported so other dialogs (e.g. project_settings_dialog.slint's tile-merge
// class exclusion list) can reuse the same picker instead of a bespoke one.
export component MultiClassDropdown inherits Rectangle {
        in property <bool> is-seg: false;
        in-out property <string> value: "";
        /// flags[0..33] the project's classes; with `component-classes`,
        /// flags[33 + k] the opened component's class k (`ComponentClassesState`).
        in property <[string]> selection-flags: [];
        /// Also offer the opened component's classes.
        in property <bool> component-classes: false;
        callback changed(string);

        property <string> prefix: root.is-seg ? "Seg." : "Obj.";

        height: 26px;
        border-radius: 4px;

        trigger-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                popup.show();
            }

            Rectangle {
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border-soft;
                background: trigger-ta.has-hover ? Theme.raised : Theme.bg;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                // spacing: 0px - gap between chips is baked into each slot's 46px width
                spacing: 0px;
                    // Not `alignment: start`: that packs every item at its
                    // preferred width, so the chip area (0px preferred) would
                    // get no room and only show the "+N" badge.

                    // Placeholder when nothing is selected
                if root.value == "": Text {
                        text: "None selected";
                        font-size: 11px;
                        color: Theme.text-mute;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    // The selected classes, as many as fit; a "+N" badge counts the
                    // rest. The area takes the width the step gives it - the chips
                    // must not widen the field (and with it the step card and popup).
                    chip-area := Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        height: 18px;

                        // Every selected chip takes a 46px slot (see below).
                        property <int> selected: round(chips.preferred-width / 46px);
                        property <int> fitting: floor(self.width / 46px);
                        property <int> shown: self.selected <= self.fitting
                            ? self.selected
                            : max(0, floor((self.width - 28px) / 46px));

                        Rectangle {
                            x: 0px;
                            width: chip-area.shown * 46px;
                            clip: true;

                            // i=0 → BG (flags[0]), i=1..32 → class i (flags[i]).
                            // width:0px collapses unselected slots; clip:true prevents overflow.
                            // Each selected slot is 46px: 43px chip + 3px trailing gap.
                            chips := HorizontalLayout {
                                x: 0px;
                                width: self.preferred-width;
                                spacing: 0px;
                                for i in 33: Rectangle {
                                    width: root.selection-flags[i] == "1" ? 46px : 0px;
                                    height: 18px;
                                    clip: true;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: 43px;
                                        height: 18px;
                                        border-radius: 3px;
                                        background: Theme.accent.with-alpha(0.12);
                                        border-width: 1px;
                                        border-color: Theme.accent.with-alpha(0.35);

                                        property <bool> has-custom-name: false;

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            padding-left: 4px;
                                            padding-right: 4px;

                                            if i == 0: Text {
                                                text: "BG";
                                                font-size: 9px;
                                                font-family: Theme.font-mono;
                                                color: Theme.text;
                                                vertical-alignment: center;
                                            }

                                            if i != 0 && !parent.has-custom-name: Text {
                                                text: ClassHelper.zeropad2(i);
                                                font-size: 9px;
                                                color: Theme.text;
                                                vertical-alignment: center;
                                            }
                                        }

                                        for cls in ClassificationState.classes-list: Rectangle {
                                            visible: cls.id == i && cls.name != "";

                                            init => {
                                                if (cls.id == i && cls.name != "") {
                                                    has-custom-name = true;
                                                }
                                            }

                                            width: parent.width;
                                            height: parent.height;
                                            background: Theme.accent.with-alpha(0.12);

                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 3px;
                                                padding-left: 4px;
                                                padding-right: 4px;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 6px;
                                                        height: 6px;
                                                        border-radius: 2px;
                                                        background: cls.color;
                                                    }
                                                }

                                                Text {
                                                    text: cls.name;
                                                    font-size: 9px;
                                                    color: Theme.text;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }

                                // The opened component's classes selected.
                            for cls[k] in ComponentClassesState.classes: Rectangle {
                                    width: root.component-classes && root.selection-flags[33 + k] == "1" ? 46px : 0px;
                                    height: 18px;
                                    clip: true;
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: 43px;
                                        height: 18px;
                                        border-radius: 3px;
                                        background: Theme.cat-component.with-alpha(0.12);
                                        border-width: 1px;
                                        border-color: Theme.cat-component.with-alpha(0.35);
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 6px;
                                                    height: 6px;
                                                    border-radius: 2px;
                                                    background: cls.color;
                                                }
                                            }

                                            Text {
                                                text: cls.name != "" ? cls.name : "L\{cls.id}";
                                                font-size: 9px;
                                                color: Theme.text;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if chip-area.selected > chip-area.shown: Text {
                            x: chip-area.shown * 46px;
                            height: 18px;
                            text: "+\{chip-area.selected - chip-area.shown}";
                            font-size: 9px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "▾";
                        font-size: 9px;
                        color: Theme.text-mute;
                        vertical-alignment: center;
                    }
                }
            }
        }

        popup := PopupWindow {
            x: 0px;
            y: root.height + 2px;
            width: max(root.width, 220px);
            height: 300px;
            close-policy: no-auto-close;

            Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 6px;
                drop-shadow-blur: 12px;
                drop-shadow-color: #000000.with-alpha(0.4);
                clip: true;

                VerticalLayout {
                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: 4px;
                            spacing: 1px;

                            // Background class (id = 0) - flags[0]
                        bg-ta := TouchArea {
                                height: 26px;
                                clicked => {
                                    root.changed("toggle:0");
                                }
                                Rectangle {
                                    border-radius: 3px;
                                    background: bg-ta.has-hover ? Theme.raised : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 12px;
                                                height: 12px;
                                                border-radius: 3px;
                                                background: root.selection-flags[0] == "1" ? Theme.accent : transparent;
                                                border-width: root.selection-flags[0] == "1" ? 0px : 1.5px;
                                                border-color: Theme.border;
                                            }
                                        }

                                        Text {
                                            text: "Background";
                                            font-size: 11px;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border-soft;
                            }

                            // The opened component's classes - flags[33 + k].
                        for cls[k] in ComponentClassesState.classes: local-ta := TouchArea {
                                height: root.component-classes && !root.is-seg ? 26px : 0px;
                                visible: root.component-classes && !root.is-seg;
                                clicked => {
                                    root.changed("toggle:L\{cls.id}");
                                }
                                Rectangle {
                                    border-radius: 3px;
                                    background: local-ta.has-hover ? Theme.raised : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 12px;
                                                height: 12px;
                                                border-radius: 3px;
                                                background: root.selection-flags[33 + k] == "1" ? Theme.accent : transparent;
                                                border-width: root.selection-flags[33 + k] == "1" ? 0px : 1.5px;
                                                border-color: Theme.border;
                                            }
                                        }

                                        Text {
                                            width: 96px;
                                            text: "◆ L\{cls.id}";
                                            font-size: 11px;
                                            color: Theme.cat-component;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 2px;
                                                background: cls.color;
                                            }
                                        }

                                        Text {
                                            text: "(" + cls.name + ")";
                                            font-size: 11px;
                                            color: Theme.text-dim;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                            }

                            if root.component-classes && !root.is-seg && ComponentClassesState.classes.length > 0: Rectangle {
                                height: 1px;
                                background: Theme.border-soft;
                            }

                            // Classes 1–32 - flags[i+1] (i is 0-based loop index)
                        for i in 32: num-ta := TouchArea {
                                height: 26px;
                                clicked => {
                                    root.changed("toggle:\{i + 1}");
                                }
                                Rectangle {
                                    border-radius: 3px;
                                    background: num-ta.has-hover ? Theme.raised : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 12px;
                                                height: 12px;
                                                border-radius: 3px;
                                                background: root.selection-flags[i + 1] == "1" ? Theme.accent : transparent;
                                                border-width: root.selection-flags[i + 1] == "1" ? 0px : 1.5px;
                                                border-color: Theme.border;
                                            }
                                        }

                                        // A fixed column, so the colors and names line up
                                        // at the same place however wide the popup is.
                                        Text {
                                            width: 96px;
                                            text: root.prefix + " class " + ClassHelper.zeropad2(i + 1);
                                            font-size: 11px;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            for cls in ClassificationState.classes-list: HorizontalLayout {
                                                visible: cls.id == i + 1;
                                                spacing: 4px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 8px;
                                                        height: 8px;
                                                        border-radius: 2px;
                                                        background: cls.color;
                                                    }
                                                }

                                                Text {
                                                    text: "(" + cls.name + ")";
                                                    font-size: 11px;
                                                    color: Theme.text-dim;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-soft;
                    }

                    done-ta := TouchArea {
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => {
                            popup.close();
                        }

                        Rectangle {
                            background: done-ta.has-hover ? Theme.raised : transparent;

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "Done";
                                    font-size: 11px;
                                    color: Theme.accent;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

// ----------------------------------------------------------
// Leaf parameter row (used inside group items)

component LeafParamRow inherits VerticalLayout {
        in property <LeafParam> p;
        callback changed(string);
        callback toggle-exposed();
        callback edit-exposed();
        // This row's pending file-browser request (see `browse-file`).
        property <int> browse-token: -1;

        spacing: 4px;

        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            // Inside an opened component: ◆ exposes the setting as a component
            // parameter (filled) or hides it again.
            if PipelinesPanelState.open-component-name != "" && !PipelinesPanelState.open-component-read-only && p.param-type != ParamType.label: Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 3px;
                background: leaf-expose-ta.has-hover ? Theme.raised : transparent;
                Text {
                    text: p.exposed ? "◆" : "◇";
                    font-size: 9px;
                    color: p.exposed ? Theme.cat-component : Theme.text-mute;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                leaf-expose-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle-exposed();
                    }
                }
            }
            if PipelinesPanelState.open-component-name != "" && !PipelinesPanelState.open-component-read-only && p.exposed: Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 3px;
                background: leaf-edit-ta.has-hover ? Theme.raised : transparent;
                Text {
                    text: "✎";
                    font-size: 9px;
                    color: Theme.cat-component;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                leaf-edit-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.edit-exposed();
                    }
                }
            }
            Text {
                text: p.display-name == "" ? p.name : p.display-name;
                font-size: 10px;
                color: p.exposed ? Theme.cat-component : Theme.text-dim;
                vertical-alignment: center;
            }

            if p.description != "": leaf-help-btn := Rectangle {
                width: 13px;
                height: 13px;
                border-radius: 7px;
                background: leaf-help-ta.has-hover ? Theme.accent.with-alpha(0.3) : Theme.border-soft;
                animate background { duration: 100ms; }
                Text {
                    text: "?";
                    font-size: 8px;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                leaf-help-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        leaf-help-popup.show();
                    }
                }

                leaf-help-popup := PopupWindow {
                    x: 0px;
                    y: parent.height + 3px;
                    width: 230px;
                    Rectangle {
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 6px;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #000000.with-alpha(0.35);
                        VerticalLayout {
                            padding: 10px;
                            spacing: 0px;
                            Text {
                                text: p.description;
                                font-size: 11px;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        if p.param-type == ParamType.number || p.param-type == ParamType.text:
    LineEdit {
            enabled: !PipelinesPanelState.open-component-read-only;
            height: 24px;
            text: p.value;
            font-size: 11px;
            edited(t) => {
                root.changed(t);
            }
        }

        if p.param-type == ParamType.file-path: HorizontalLayout {
            // Applies this row's file-browser result once it arrives.
            property <int> result-token: PipelinesPanelState.browse-result-token;
            changed result-token => {
                if (self.result-token == root.browse-token && root.browse-token >= 0) {
                    root.browse-token = -1;
                    leaf-fp-input.text = PipelinesPanelState.browse-result-path;
                    root.changed(PipelinesPanelState.browse-result-path);
                }
            }

            spacing: 4px;
            leaf-fp-input := LineEdit {
                enabled: !PipelinesPanelState.open-component-read-only;
                height: 24px;
                horizontal-stretch: 1;
                text: p.value;
                font-size: 11px;
                edited(t) => {
                    root.changed(t);
                }
            }

            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border;
                background: leaf-browse-ta.has-hover ? Theme.accent.with-alpha(0.2) : Theme.panel;
                Image {
                    source: @image-url("../icons/regular-white/folder-open.svg");
                    width: 13px;
                    height: 13px;
                    colorize: Theme.text-dim;
                }

                leaf-browse-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        PipelinesPanelState.browse-token-counter += 1;
                        root.browse-token = PipelinesPanelState.browse-token-counter;
                        PipelinesPanelState.browse-file(
                        p.options.length > 0 ? p.options[0] : "",
                        leaf-fp-input.text,
                        root.browse-token);
                    }
                }
            }
        }

        if p.param-type == ParamType.label: Text {
            text: p.value;
            font-size: 11px;
            font-family: Theme.font-mono;
            color: Theme.text-dim;
            vertical-alignment: center;
        }

        if p.param-type == ParamType.spinner:
    NumberSpinner {
            enabled: !PipelinesPanelState.open-component-read-only;
            label: p.display-name;
            value: p.value.to-float();
            step: p.step;
            min: p.min;
            max: p.max;
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.dropdown:
    ComboBox {
            enabled: !PipelinesPanelState.open-component-read-only;
            model: p.options;
            current-value: p.value;
            selected(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.slider: HorizontalLayout {
            spacing: 8px;
            Slider {
                enabled: !PipelinesPanelState.open-component-read-only;
                minimum: p.min;
                maximum: p.max;
                value: p.value.to-float();
                horizontal-stretch: 1;
                changed(v) => {
                    root.changed("\{v}");
                }
            }

            Text {
                text: p.value;
                font-size: 11px;
                font-family: Theme.font-mono;
                color: Theme.text;
                vertical-alignment: center;
                width: 36px;
                horizontal-alignment: right;
            }
        }

        if p.param-type == ParamType.toggle: HorizontalLayout {
            CheckBox {
                enabled: !PipelinesPanelState.open-component-read-only;
                checked: p.value == "true";
                toggled => {
                    root.changed(self.checked ? "true" : "false");
                }
            }
        }

        if p.param-type == ParamType.obj-class:
    ClassDropdown {
            is-seg: false;
            component-classes: true;
            value: p.value;
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.seg-class:
    ClassDropdown {
            is-seg: true;
            value: p.value;
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.multi-obj-class:
    MultiClassDropdown {
            is-seg: false;
            component-classes: true;
            value: p.value;
            selection-flags: p.options;
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.multi-seg-class:
    MultiClassDropdown {
            is-seg: true;
            value: p.value;
            selection-flags: p.options;
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.pixel-units || p.param-type == ParamType.size-units:
    ComboBox {
            enabled: !PipelinesPanelState.open-component-read-only;
            model: p.options;
            current-value: p.value;
            selected(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.image-address:
    ImageAddressPicker {
            enabled: !PipelinesPanelState.open-component-read-only;
            kind: p.options[0];
            number: p.options[1].to-float();
            in-component: PipelinesPanelState.open-component-name != "";
            changed(v) => {
                root.changed(v);
            }
        }

        if p.param-type == ParamType.image-channel:
    ChannelPicker {
            height: 24px;
            font-size: 11px;
            value: p.value.to-float();
            changed(v) => {
                root.changed(v);
            }
        }
    }

// ----------------------------------------------------------
// Parameter row

// Header above the first setting of a section.
component SectionHeader inherits VerticalLayout {
        in property <string> text;
        padding-top: 4px;
        spacing: 3px;
        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: Theme.text-dim;
            overflow: elide;
        }

        Rectangle {
            height: 1px;
            background: Theme.border-soft;
        }
    }

// A setting's name line: ◇/✎ inside an opened component, the name, and "?"
// for its help text.
component ParamLabel inherits HorizontalLayout {
        in property <CommandParameter> p;
        // The settings dialog's layout: a larger name, and "?" shows the
        // full help text below the short one (`help-open`) instead of a popup.
        in property <bool> wide: false;
        in-out property <bool> help-open: false;
        callback toggle-exposed();
        callback edit-exposed();

        spacing: 4px;
        alignment: start;
        // Inside an opened component: ◆ exposes the setting as a component
        // parameter (filled) or hides it again.
        if PipelinesPanelState.open-component-name != "" && !PipelinesPanelState.open-component-read-only && p.param-type != ParamType.group && p.param-type != ParamType.label: Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 3px;
            background: expose-ta.has-hover ? Theme.raised : transparent;
            Text {
                text: p.exposed ? "◆" : "◇";
                font-size: 10px;
                color: p.exposed ? Theme.cat-component : Theme.text-mute;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            expose-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.toggle-exposed();
                }
            }
        }
        if PipelinesPanelState.open-component-name != "" && !PipelinesPanelState.open-component-read-only && p.exposed: Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 3px;
            background: edit-exposed-ta.has-hover ? Theme.raised : transparent;
            Text {
                text: "✎";
                font-size: 10px;
                color: Theme.cat-component;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            edit-exposed-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.edit-exposed();
                }
            }
        }
        Text {
            text: p.display-name == "" ? p.name : p.display-name;
            font-size: root.wide ? 12px : 11px;
            font-weight: root.wide ? 600 : 400;
            color: p.exposed ? Theme.cat-component : (root.wide ? Theme.text : Theme.text-dim);
            vertical-alignment: center;
            overflow: elide;
        }

        if root.wide ? p.more-help : p.description != "": help-btn := Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: help-ta.has-hover || root.help-open ? Theme.accent.with-alpha(0.3) : Theme.border-soft;
            animate background { duration: 100ms; }
            Text {
                text: "?";
                font-size: 8px;
                color: Theme.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            help-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if root.wide {
                        root.help-open = !root.help-open;
                    } else {
                        help-popup.show();
                    }
                }
            }

            help-popup := PopupWindow {
                x: 0px;
                y: parent.height + 3px;
                width: 240px;
                Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 6px;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: #000000.with-alpha(0.35);
                    VerticalLayout {
                        padding: 10px;
                        spacing: 0px;
                        Text {
                            text: p.description;
                            font-size: 11px;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

// A setting's control (text field, spinner, dropdown, list entries, …).
// Locked while a component is only viewed.
component ParamControls inherits Rectangle {
        in property <CommandParameter> p;
        // A narrow field (a table cell): the controls that have it get their
        // compact form.
        in property <bool> compact: false;
        callback changed(string);
        callback item-field-changed(int, string, string);
        callback add-item();
        callback remove-item(int);
        callback show-model-info();
        // A list entry's setting: entry index, setting name.
        callback toggle-item-exposed(int, string);
        callback edit-item-exposed(int, string);
        // This row's pending file-browser request (see `browse-file`).
        property <int> browse-token: -1;
        // This row's pending script-editor request (see `ScriptEditorState`).
        property <int> script-token: -1;

        VerticalLayout {
            spacing: 4px;

            // Script: read-only preview, click opens the script editor.
            if p.param-type == ParamType.script: Rectangle {
                property <int> result-token: ScriptEditorState.result-token;
                changed result-token => {
                    if (self.result-token == root.script-token && root.script-token >= 0) {
                        root.script-token = -1;
                        root.changed(ScriptEditorState.result-text);
                    }
                }

                height: 84px;
                border-radius: 4px;
                border-width: 1px;
                border-color: script-ta.has-hover ? Theme.accent.with-alpha(0.6) : Theme.border;
                background: Theme.bg;
                clip: true;

                Text {
                    x: 6px;
                    y: 4px;
                    width: parent.width - 12px;
                    height: parent.height - 8px;
                    text: p.value;
                    font-family: ScriptFont.family;
                    font-size: 10px;
                    color: Theme.text-dim;
                    wrap: no-wrap;
                    overflow: clip;
                    vertical-alignment: top;
                }

                Rectangle {
                    x: parent.width - self.width - 4px;
                    y: parent.height - self.height - 4px;
                    width: edit-label.preferred-width + 12px;
                    height: 18px;
                    border-radius: 3px;
                    background: script-ta.has-hover ? Theme.accent : Theme.raised;
                    edit-label := Text {
                        text: "Edit script";
                        font-size: 10px;
                        color: script-ta.has-hover ? #FFFFFF : Theme.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                script-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ScriptEditorState.token-counter += 1;
                        root.script-token = ScriptEditorState.token-counter;
                        ScriptEditorState.open(p.display-name, p.value, root.script-token);
                    }
                }
            }

            if p.param-type == ParamType.number || p.param-type == ParamType.text:
        LineEdit {
                enabled: !PipelinesPanelState.open-component-read-only;
                height: 26px;
                text: p.value;
                font-size: 11px;
                edited(t) => {
                    root.changed(t);
                }
            }

            if p.param-type == ParamType.file-path: HorizontalLayout {
                // Applies this row's file-browser result once it arrives.
                property <int> result-token: PipelinesPanelState.browse-result-token;
                changed result-token => {
                    if (self.result-token == root.browse-token && root.browse-token >= 0) {
                        root.browse-token = -1;
                        fp-input.text = PipelinesPanelState.browse-result-path;
                        root.changed(PipelinesPanelState.browse-result-path);
                    }
                }

                spacing: 4px;
                fp-input := LineEdit {
                    enabled: !PipelinesPanelState.open-component-read-only;
                    height: 26px;
                    horizontal-stretch: 1;
                    text: p.value;
                    font-size: 11px;
                    edited(t) => {
                        root.changed(t);
                    }
                }

                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: browse-ta.has-hover ? Theme.accent.with-alpha(0.2) : Theme.panel;
                    Image {
                        source: @image-url("../icons/regular-white/folder-open.svg");
                        width: 14px;
                        height: 14px;
                        colorize: Theme.text-dim;
                    }

                    browse-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            PipelinesPanelState.browse-token-counter += 1;
                            root.browse-token = PipelinesPanelState.browse-token-counter;
                            PipelinesPanelState.browse-file(
                            p.options.length > 0 ? p.options[0] : "",
                            fp-input.text,
                            root.browse-token);
                        }
                    }
                }

                if p.has-model-info: Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: info-ta.has-hover ? Theme.accent.with-alpha(0.2) : Theme.panel;
                    Text {
                        text: "i";
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    info-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show-model-info();
                        }
                    }
                }
            }

            if p.param-type == ParamType.label: Text {
                text: p.value;
                font-size: 11px;
                font-family: Theme.font-mono;
                color: Theme.text-dim;
                vertical-alignment: center;
            }

            if p.param-type == ParamType.spinner:
        NumberSpinner {
                enabled: !PipelinesPanelState.open-component-read-only;
                compact: root.compact;
                label: p.display-name;
                value: p.value.to-float();
                step: p.step;
                min: p.min;
                max: p.max;
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.dropdown:
        ComboBox {
                enabled: !PipelinesPanelState.open-component-read-only;
                model: p.options;
                current-value: p.value;
                selected(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.slider: HorizontalLayout {
                spacing: 8px;
                Slider {
                    enabled: !PipelinesPanelState.open-component-read-only;
                    minimum: p.min;
                    maximum: p.max;
                    value: p.value.to-float();
                    horizontal-stretch: 1;
                    changed(v) => {
                        root.changed("\{v}");
                    }
                }

                Text {
                    text: p.value;
                    font-size: 11px;
                    font-family: Theme.font-mono;
                    color: Theme.text;
                    vertical-alignment: center;
                    width: 36px;
                    horizontal-alignment: right;
                }
            }

            if p.param-type == ParamType.toggle: HorizontalLayout {
                CheckBox {
                    enabled: !PipelinesPanelState.open-component-read-only;
                    checked: p.value == "true";
                    toggled => {
                        root.changed(self.checked ? "true" : "false");
                    }
                }
            }

            if p.param-type == ParamType.obj-class:
        ClassDropdown {
                is-seg: false;
                compact: root.compact;
                component-classes: true;
                value: p.value;
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.seg-class:
        ClassDropdown {
                is-seg: true;
                compact: root.compact;
                value: p.value;
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.multi-obj-class:
        MultiClassDropdown {
                is-seg: false;
                component-classes: true;
                value: p.value;
                selection-flags: p.options;
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.multi-seg-class:
        MultiClassDropdown {
                is-seg: true;
                value: p.value;
                selection-flags: p.options;
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.pixel-units || p.param-type == ParamType.size-units:
        ComboBox {
                enabled: !PipelinesPanelState.open-component-read-only;
                model: p.options;
                current-value: p.value;
                selected(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.image-address:
        ImageAddressPicker {
                enabled: !PipelinesPanelState.open-component-read-only;
                kind: p.options[0];
                number: p.options[1].to-float();
                in-component: PipelinesPanelState.open-component-name != "";
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.image-channel:
        ChannelPicker {
                height: 24px;
                font-size: 11px;
                compact: root.compact;
                value: p.value.to-float();
                changed(v) => {
                    root.changed(v);
                }
            }

            if p.param-type == ParamType.group: VerticalLayout {
                spacing: 4px;
                for item[i] in p.group-items: Rectangle {
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border-soft;
                    background: Theme.bg;
                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "#" + (i + 1);
                                font-size: 9.5px;
                                font-family: Theme.font-mono;
                                color: Theme.text-mute;
                                vertical-alignment: center;
                            }

                            GhostIconBtn {
                                icon: @image-url("../icons/regular-white/trash-simple.svg");
                                sz: 18px;
                                icon-sz: 10px;
                                tint: Theme.err.with-alpha(0.6);
                                clicked => {
                                    root.remove-item(i);
                                }
                            }
                        }

                        for field in item.fields: LeafParamRow {
                            p: field;
                            changed(v) => {
                                root.item-field-changed(i, field.name, v);
                            }
                            toggle-exposed => {
                                root.toggle-item-exposed(i, field.name);
                            }
                            edit-exposed => {
                                root.edit-item-exposed(i, field.name);
                            }
                        }
                    }
                }
                Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: add-item-ta.has-hover ? Theme.raised : transparent;
                    animate background { duration: 100ms; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        Image {
                            source: @image-url("../icons/regular-white/plus.svg");
                            width: 10px;
                            height: 10px;
                            colorize: Theme.text-dim;
                            y: 8px;
                        }

                        Text {
                            text: "Add item";
                            font-size: 10.5px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }

                    add-item-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.add-item();
                        }
                    }
                }
            }
        }

        // "View": the settings can be read, not changed - the names and
        // their "?" around the controls still work.
        if PipelinesPanelState.open-component-read-only: TouchArea { }
    }

// Below a setting: what it's wired to, and what a check found about it.
component ParamNotes inherits VerticalLayout {
        in property <CommandParameter> p;
        spacing: 2px;
        if p.wiring != "": Text {
            text: p.wiring;
            font-size: 9.5px;
            color: Theme.cat-component.with-alpha(0.85);
            wrap: word-wrap;
            height: self.preferred-height;
        }
        if p.problem != "": Text {
            text: "⚠ \{p.problem}";
            font-size: 10px;
            color: p.problem-error ? Theme.err : Theme.warn;
            wrap: word-wrap;
            height: self.preferred-height;
        }
    }

// One problem: what it is, where (`show-where`), and its fix. Clicking the
// text shows the step it's about.
component ProblemRow inherits HorizontalLayout {
        in property <ProblemItem> item;
        in property <bool> show-where: true;
        spacing: 6px;

        VerticalLayout {
            alignment: start;
            padding-top: 4px;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: item.error ? Theme.err : Theme.warn;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            if root.show-where && item.where != "": Text {
                text: item.where;
                font-size: 9.5px;
                font-weight: 600;
                color: Theme.text-mute;
                overflow: elide;
            }
            problem-text := Text {
                text: item.text;
                font-size: 10.5px;
                color: problem-ta.has-hover && root.show-where ? Theme.text : Theme.text-dim;
                wrap: word-wrap;
                height: self.preferred-height;
                problem-ta := TouchArea {
                    mouse-cursor: root.show-where ? pointer : default;
                    clicked => {
                        if root.show-where {
                            PipelinesPanelState.show-problem(item.index);
                        }
                    }
                }
            }
        }

        if item.fix-label != "": VerticalLayout {
            alignment: start;
            Rectangle {
                height: 20px;
                width: fix-text.preferred-width + 14px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border;
                background: fix-ta.has-hover ? Theme.raised : transparent;
                accessible-role: button;
                accessible-label: item.fix-label;
                fix-text := Text {
                    text: item.fix-label;
                    font-size: 10px;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                fix-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        PipelinesPanelState.fix-problem(item.index);
                    }
                }
            }
        }
    }

component ParamRow inherits VerticalLayout {
        in property <CommandParameter> p;
        // Show `p.section-header` (the settings dialog has its own).
        in property <bool> show-section: true;
        callback changed(string);
        callback item-field-changed(int, string, string);
        callback add-item();
        callback remove-item(int);
        callback show-model-info();
        callback toggle-exposed();
        callback edit-exposed();
        // A list entry's setting: entry index, setting name.
        callback toggle-item-exposed(int, string);
        callback edit-item-exposed(int, string);

        spacing: 4px;

        if root.show-section && p.section-header != "": SectionHeader {
            text: p.section-header;
        }

        ParamLabel {
            p: root.p;
            toggle-exposed => {
                root.toggle-exposed();
            }
            edit-exposed => {
                root.edit-exposed();
            }
        }

        ParamControls {
            p: root.p;
            changed(v) => {
                root.changed(v);
            }
            item-field-changed(i, n, v) => {
                root.item-field-changed(i, n, v);
            }
            add-item => {
                root.add-item();
            }
            remove-item(i) => {
                root.remove-item(i);
            }
            show-model-info => {
                root.show-model-info();
            }
            toggle-item-exposed(i, n) => {
                root.toggle-item-exposed(i, n);
            }
            edit-item-exposed(i, n) => {
                root.edit-item-exposed(i, n);
            }
        }

        ParamNotes {
            p: root.p;
        }
    }

// A setting in the settings dialog, laid out like the project settings:
// name, short help ("?" for the full one) on the left, the control on the
// right - or below, for list entries and scripts, which need the width.
component WideParamRow inherits VerticalLayout {
        in property <CommandParameter> p;
        callback changed(string);
        callback item-field-changed(int, string, string);
        callback add-item();
        callback remove-item(int);
        callback show-model-info();
        callback toggle-exposed();
        callback edit-exposed();
        // A list entry's setting: entry index, setting name.
        callback toggle-item-exposed(int, string);
        callback edit-item-exposed(int, string);

        property <bool> help-open: false;
        property <bool> block: p.param-type == ParamType.group || p.param-type == ParamType.script;

        Rectangle {
            height: 1px;
            background: Theme.border-soft;
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: root.block ? 4px : 12px;
            spacing: 24px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;

                ParamLabel {
                    p: root.p;
                    wide: true;
                    help-open <=> root.help-open;
                    toggle-exposed => {
                        root.toggle-exposed();
                    }
                    edit-exposed => {
                        root.edit-exposed();
                    }
                }

                // `height` from the text's own width (see the project
                // settings' `SettingRow`).
                if p.short-description != "": Text {
                    text: root.help-open ? p.description : p.short-description;
                    font-size: 11px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }

                ParamNotes {
                    p: root.p;
                }
            }

            if !root.block: VerticalLayout {
                width: 280px;
                alignment: center;
                ParamControls {
                    p: root.p;
                    changed(v) => {
                        root.changed(v);
                    }
                    item-field-changed(i, n, v) => {
                        root.item-field-changed(i, n, v);
                    }
                    add-item => {
                        root.add-item();
                    }
                    remove-item(i) => {
                        root.remove-item(i);
                    }
                    show-model-info => {
                        root.show-model-info();
                    }
                    toggle-item-exposed(i, n) => {
                        root.toggle-item-exposed(i, n);
                    }
                    edit-item-exposed(i, n) => {
                        root.edit-item-exposed(i, n);
                    }
                }
            }
        }

        if root.block: VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 12px;
            ParamControls {
                p: root.p;
                changed(v) => {
                    root.changed(v);
                }
                item-field-changed(i, n, v) => {
                    root.item-field-changed(i, n, v);
                }
                add-item => {
                    root.add-item();
                }
                remove-item(i) => {
                    root.remove-item(i);
                }
                show-model-info => {
                    root.show-model-info();
                }
                toggle-item-exposed(i, n) => {
                    root.toggle-item-exposed(i, n);
                }
                edit-item-exposed(i, n) => {
                    root.edit-item-exposed(i, n);
                }
            }
        }
    }

// ----------------------------------------------------------
// Step row

// A setting on one line: its name left, its control right - lists,
// scripts and file paths need the width, so they're stacked (`ParamRow`).
component InlineParamRow inherits VerticalLayout {
        in property <CommandParameter> p;
        callback changed(string);
        callback item-field-changed(int, string, string);
        callback add-item();
        callback remove-item(int);
        callback show-model-info();
        callback toggle-exposed();
        callback edit-exposed();
        // A list entry's setting: entry index, setting name.
        callback toggle-item-exposed(int, string);
        callback edit-item-exposed(int, string);

        property <bool> stacked: p.param-type == ParamType.group || p.param-type == ParamType.script || p.param-type == ParamType.file-path || p.param-type == ParamType.multi-obj-class || p.param-type == ParamType.multi-seg-class || p.param-type == ParamType.image-address || p.param-type == ParamType.slider;

        spacing: 2px;

        if root.stacked: ParamRow {
            p: root.p;
            show-section: false;
            changed(v) => {
                root.changed(v);
            }
            item-field-changed(i, n, v) => {
                root.item-field-changed(i, n, v);
            }
            add-item => {
                root.add-item();
            }
            remove-item(i) => {
                root.remove-item(i);
            }
            show-model-info => {
                root.show-model-info();
            }
            toggle-exposed => {
                root.toggle-exposed();
            }
            edit-exposed => {
                root.edit-exposed();
            }
            toggle-item-exposed(i, n) => {
                root.toggle-item-exposed(i, n);
            }
            edit-item-exposed(i, n) => {
                root.edit-item-exposed(i, n);
            }
        }

        if !root.stacked: HorizontalLayout {
            spacing: 8px;
            HorizontalLayout {
                width: 112px;
                alignment: start;
                ParamLabel {
                    p: root.p;
                    toggle-exposed => {
                        root.toggle-exposed();
                    }
                    edit-exposed => {
                        root.edit-exposed();
                    }
                }
            }

            ParamControls {
                horizontal-stretch: 1;
                p: root.p;
                changed(v) => {
                    root.changed(v);
                }
                item-field-changed(i, n, v) => {
                    root.item-field-changed(i, n, v);
                }
                add-item => {
                    root.add-item();
                }
                remove-item(i) => {
                    root.remove-item(i);
                }
                show-model-info => {
                    root.show-model-info();
                }
                toggle-item-exposed(i, n) => {
                    root.toggle-item-exposed(i, n);
                }
                edit-item-exposed(i, n) => {
                    root.edit-item-exposed(i, n);
                }
            }
        }

        if !root.stacked: ParamNotes {
            p: root.p;
        }
    }

// A collapsible section's head: ▸ name, and its settings' values while closed.
component SectionHead inherits Rectangle {
        in property <SectionView> section;
        callback clicked;

        height: 30px;
        border-radius: 4px;
        background: head-ta.has-hover ? Theme.raised : transparent;
        accessible-role: button;
        accessible-label: root.section.name;

        head-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }

        HorizontalLayout {
            padding-left: 2px;
            padding-right: 6px;
            spacing: 6px;
            Text {
                width: 10px;
                text: root.section.open ? "▾" : "▸";
                font-size: 9px;
                color: Theme.text-mute;
                vertical-alignment: center;
            }

            Text {
                text: root.section.name;
                font-size: 11px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }

            if root.section.problem > 0: Text {
                text: "⚠";
                font-size: 10px;
                color: root.section.problem == 2 ? Theme.err : Theme.warn;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 1;
                text: root.section.open ? "" : root.section.summary;
                font-size: 10.5px;
                color: Theme.text-dim;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }

// Sections with the same settings as a table: a row per section, a
// column per setting, compact controls in the cells.
component CardTableView inherits VerticalLayout {
        in property <CardTable> table;
        // A cell's setting changed: its name, the value.
        callback changed(string, string);

        spacing: 4px;

        HorizontalLayout {
            spacing: 4px;
            Rectangle {
                width: 64px;
            }

            for column in root.table.columns: Text {
                horizontal-stretch: 1;
                preferred-width: 1px;
                min-width: 0px;
                text: column;
                font-size: 9.5px;
                font-weight: 600;
                color: Theme.text-mute;
                overflow: elide;
            }
        }

        for row in root.table.rows: HorizontalLayout {
            spacing: 4px;
            height: 26px;
            Text {
                width: 64px;
                text: row.name;
                font-size: 11px;
                font-weight: 600;
                color: row.problem == 2 ? Theme.err : row.problem == 1 ? Theme.warn : Theme.text;
                overflow: elide;
                vertical-alignment: center;
            }

            for cell in row.cells: Rectangle {
                horizontal-stretch: 1;
                preferred-width: 1px;
                min-width: 0px;
                border-radius: 5px;
                border-width: cell.problem != "" ? 1px : 0px;
                border-color: cell.problem-error ? Theme.err : Theme.warn;
                ParamControls {
                    x: 1px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 2px;
                    p: cell;
                    compact: true;
                    changed(v) => {
                        root.changed(cell.name, v);
                    }
                }
            }
        }

        for problem in root.table.problems: Text {
            text: "⚠ \{problem}";
            font-size: 10px;
            color: root.table.problem-error ? Theme.err : Theme.warn;
            wrap: word-wrap;
            height: self.preferred-height;
        }
    }

component StepRow inherits Rectangle {
        in property <PipelineCommand> step;
        in property <int> idx;
        in property <int> pipeline-id;
        callback toggle-enabled;
        callback toggle-expanded;
        callback remove;
        callback duplicate;
        callback create-component;
        callback open-component;
        callback view-component;
        callback expand-component;
        callback save-to-library;
        callback update-component;
        callback param-changed(string, string);
        callback toggle-breakpoint;
        callback open-settings;

        background: Theme.raised;
        border-width: 1px;
        border-color: step.expanded ? Cat.color(step.category) : (head-ta.has-hover ? Theme.border : Theme.border-soft);
        border-radius: 6px;
        clip: true;
        opacity: step.enabled ? 1.0 : 0.55;
        animate border-color { duration: 100ms; }

        VerticalLayout {
            spacing: 0px;

            // -- Header row --
        Rectangle {
                height: 40px;
                head-ta := TouchArea {
                    clicked => {
                        root.toggle-expanded();
                    }
                }

                HorizontalLayout {
                    spacing: 0px;
                    alignment: stretch;

                    // 3px category stripe
                Rectangle {
                        width: 3px;
                        background: Cat.color(step.category);
                    }

                    // Grip
                VerticalLayout {
                        alignment: center;
                        padding-left: 6px;
                        padding-right: 2px;
                        Image {
                            source: @image-url("../icons/regular-white/dots-six-vertical.svg");
                            width: 10px;
                            height: 10px;
                            colorize: Theme.text-mute;
                        }
                    }

                    // Number chip
                VerticalLayout {
                        alignment: center;
                        padding-right: 8px;
                        // The step's id - what "#2 EV Detection" elsewhere refers to
                        // (equal steps are told apart by it; it stays when steps
                        // are added, moved or removed).
                        Rectangle {
                            width: max(20px, step-number.preferred-width + 8px);
                            height: 18px;
                            border-radius: 4px;
                            background: Theme.bg;
                            border-width: 1px;
                            border-color: Theme.border-soft;
                            step-number := Text {
                                text: root.step.step-id;
                                color: Theme.text-dim;
                                font-size: 10px;
                                font-weight: 600;
                                font-family: Theme.font-mono;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Name + mono summary
                VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        horizontal-stretch: 1;
                        padding-right: 8px;

                        HorizontalLayout {
                            spacing: 5px;
                            Text {
                                text: step.name;
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 500;
                                overflow: elide;
                            }

                            if step.help != "": Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: step-help-ta.has-hover ? Theme.accent.with-alpha(0.3) : Theme.border-soft;
                                accessible-role: button;
                                accessible-label: "About \{step.name}";
                                Text {
                                    text: "?";
                                    font-size: 8px;
                                    color: Theme.text-dim;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                step-help-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        step-help-popup.show();
                                    }
                                }

                                step-help-popup := PopupWindow {
                                    x: 0px;
                                    y: parent.height + 3px;
                                    width: 300px;
                                    Rectangle {
                                        background: Theme.panel;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        border-radius: 6px;
                                        drop-shadow-blur: 10px;
                                        drop-shadow-color: #000000.with-alpha(0.35);
                                        VerticalLayout {
                                            padding: 10px;
                                            Text {
                                                text: step.help;
                                                font-size: 11px;
                                                color: Theme.text;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }

                            if step.problems.length > 0: Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 14px;
                                width: badge-text.preferred-width + 8px;
                                border-radius: 7px;
                                background: (step.problem-errors > 0 ? Theme.err : Theme.warn).with-alpha(0.2);
                                accessible-role: text;
                                accessible-label: "\{step.problems.length} problems";
                                badge-text := Text {
                                    text: "⚠ \{step.problems.length}";
                                    font-size: 9px;
                                    font-weight: 600;
                                    color: step.problem-errors > 0 ? Theme.err : Theme.warn;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }

                        Text {
                            text: step.summary;
                            color: Theme.text-mute;
                            font-size: 10px;
                            font-family: Theme.font-mono;
                            overflow: elide;
                        }
                    }

                    // Controls
                VerticalLayout {
                        alignment: center;
                        padding-right: 6px;
                        HorizontalLayout {
                            spacing: 2px;

                            // Breakpoint dot: gray=off, red=Stop, orange=Snapshot
                        // Click cycles: off → stop → snapshot → off
                        bp-btn := Rectangle {
                            // Inner steps of a component can't be breakpoint targets.
                            visible: PipelinesPanelState.open-component-name == "";
                            // 0=off, 1=stop, 2=snapshot for this specific step
                            property <int> bp-state: (PipelinesPanelState.breakpoint-pipeline-id == root.pipeline-id && PipelinesPanelState.breakpoint-step-id == root.step.step-id) ? PipelinesPanelState.breakpoint-mode : 0;
                                width: 22px;
                                height: 22px;
                                border-radius: 4px;
                                background: bp-btn-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 100ms; }
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: bp-btn.bp-state == 1 ? #e53e3e : bp-btn.bp-state == 2 ? #ed8936 : Theme.text-faint;
                                    border-width: bp-btn.bp-state == 0 ? 1.5px : 0px;
                                    border-color: Theme.text-faint;
                                }

                                bp-btn-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.toggle-breakpoint();
                                    }
                                }
                            }

                            GhostIconBtn {
                                icon: step.enabled ? @image-url("../icons/regular-white/check-square.svg") : @image-url("../icons/regular-white/selection-slash.svg");
                                icon-sz: 13px;
                                tint: step.enabled ? Theme.text-dim : Theme.text-faint;
                                clicked => {
                                    if !PipelinesPanelState.open-component-read-only {
                                        root.toggle-enabled();
                                    }
                                }
                            }

                            // Opens the settings in the larger dialog.
                            if step.parameters.length > 0 || step.advanced-count > 0: GhostIconBtn {
                                icon: @image-url("../icons/regular-white/arrows-out-simple.svg");
                                icon-sz: 12px;
                                tint: Theme.text-dim;
                                clicked => {
                                    root.open-settings();
                                }
                            }

                            GhostIconBtn {
                                icon: step.expanded ? @image-url("../icons/regular-white/caret-up.svg") : @image-url("../icons/regular-white/caret-down.svg");
                                icon-sz: 12px;
                                clicked => {
                                    root.toggle-expanded();
                                }
                            }
                        }
                    }
                }
            }

            // -- Expanded body --
        if step.expanded: Rectangle {
                background: Theme.bg;

                // Top hairline separator inside the card
            Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 1px;
                    background: Theme.border-soft;
                }

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;

                    if step.problems.length > 0: VerticalLayout {
                        spacing: 6px;
                        for item in step.problems: ProblemRow {
                            item: item;
                            show-where: false;
                        }
                    }

                    // A component card with sections: collapsed to their
                    // values, a table where sections have the same settings.
                    // The settings as rows (name left, control right): those
                    // without a section first, then each section - collapsed
                    // to its values, or a table where sections have the
                    // same settings.
                    VerticalLayout {
                    spacing: 0px;
                    for section in step.section-views: VerticalLayout {
                        // A table's other sections are its rows: nothing here.
                        padding-bottom: section.kind == 2 ? 0px : 8px;
                        spacing: 6px;
                        if section.kind == 0: SectionHead {
                            section: section;
                            clicked => {
                                PipelinesPanelState.toggle-section(root.idx, section.name);
                            }
                        }
                        if section.kind == 1: CardTableView {
                            table: step.card-tables[section.table];
                            changed(name, v) => {
                                root.param-changed(name, v);
                            }
                        }
                        if section.kind == 3 || (section.kind == 0 && section.open): VerticalLayout {
                            padding-left: section.kind == 0 ? 12px : 0px;
                            spacing: 8px;
                            for p in section.params: InlineParamRow {
                                p: p;
                                changed(v) => {
                                    root.param-changed(p.name, v);
                                }
                                item-field-changed(item_idx, field_name, v) => {
                                    root.param-changed("\{p.name}.\{item_idx}.\{field_name}", v);
                                }
                                add-item => {
                                    PipelinesPanelState.add-group-item(step.id, p.name);
                                }
                                remove-item(idx) => {
                                    PipelinesPanelState.remove-group-item(step.id, p.name, idx);
                                }
                                show-model-info => {
                                    PipelinesPanelState.show-model-info(step.id);
                                }
                                toggle-exposed => {
                                    PipelinesPanelState.toggle-exposed(step.id, p.name);
                                }
                                toggle-item-exposed(item_idx, field_name) => {
                                    PipelinesPanelState.toggle-exposed(step.id, "\{p.name}.\{item_idx}.\{field_name}");
                                }
                                edit-exposed => {
                                    PipelinesPanelState.edit-exposed(step.id, p.name);
                                }
                                edit-item-exposed(item_idx, field_name) => {
                                    PipelinesPanelState.edit-exposed(step.id, "\{p.name}.\{item_idx}.\{field_name}");
                                }
                            }
                        }
                    }
                    }

                    if step.section-views.length == 0: VerticalLayout {
                        spacing: 10px;
                    for p in step.parameters: ParamRow {
                        p: p;
                        changed(v) => {
                            root.param-changed(p.name, v);
                        }
                        item-field-changed(item_idx, field_name, v) => {
                            root.param-changed("\{p.name}.\{item_idx}.\{field_name}", v);
                        }
                        add-item => {
                            PipelinesPanelState.add-group-item(step.id, p.name);
                        }
                        remove-item(idx) => {
                            PipelinesPanelState.remove-group-item(step.id, p.name, idx);
                        }
                        show-model-info => {
                            PipelinesPanelState.show-model-info(step.id);
                        }
                        toggle-exposed => {
                            PipelinesPanelState.toggle-exposed(step.id, p.name);
                        }
                        toggle-item-exposed(item_idx, field_name) => {
                            PipelinesPanelState.toggle-exposed(step.id, "\{p.name}.\{item_idx}.\{field_name}");
                        }
                        edit-exposed => {
                            PipelinesPanelState.edit-exposed(step.id, p.name);
                        }
                        edit-item-exposed(item_idx, field_name) => {
                            PipelinesPanelState.edit-exposed(step.id, "\{p.name}.\{item_idx}.\{field_name}");
                        }
                    }
                    }

                    if step.advanced-count > 0: AdvancedRow {
                        count: step.advanced-count;
                        changed-count: step.advanced-changed;
                        expanded: step.show-advanced || PipelinesPanelState.always-show-advanced;
                        always: PipelinesPanelState.always-show-advanced;
                        toggled => {
                            PipelinesPanelState.toggle-advanced(step.id);
                        }
                        always-toggled(on) => {
                            PipelinesPanelState.always-show-advanced-toggled(on);
                        }
                    }

                    for p in step.advanced-parameters: InlineParamRow {
                        p: p;
                        changed(v) => {
                            root.param-changed(p.name, v);
                        }
                        item-field-changed(item_idx, field_name, v) => {
                            root.param-changed("\{p.name}.\{item_idx}.\{field_name}", v);
                        }
                        add-item => {
                            PipelinesPanelState.add-group-item(step.id, p.name);
                        }
                        remove-item(idx) => {
                            PipelinesPanelState.remove-group-item(step.id, p.name, idx);
                        }
                        show-model-info => {
                            PipelinesPanelState.show-model-info(step.id);
                        }
                        toggle-exposed => {
                            PipelinesPanelState.toggle-exposed(step.id, p.name);
                        }
                        toggle-item-exposed(item_idx, field_name) => {
                            PipelinesPanelState.toggle-exposed(step.id, "\{p.name}.\{item_idx}.\{field_name}");
                        }
                        edit-exposed => {
                            PipelinesPanelState.edit-exposed(step.id, p.name);
                        }
                        edit-item-exposed(item_idx, field_name) => {
                            PipelinesPanelState.edit-exposed(step.id, "\{p.name}.\{item_idx}.\{field_name}");
                        }
                    }

                    // A component's own actions, in a row of their own - with
                    // the step actions they'd be wider than the card. While
                    // viewing, only "View" (a nested component).
                    if root.step.category == StepCategory.component: HorizontalLayout {
                        spacing: 6px;
                        padding-top: 2px;
                        alignment: start;

                        Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.cat-component;
                            background: view-ta.has-hover ? Theme.cat-component.with-alpha(0.15) : transparent;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                Text {
                                    text: "View";
                                    font-size: 11px;
                                    color: Theme.cat-component;
                                    vertical-alignment: center;
                                }
                            }

                            view-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.view-component();
                                }
                            }
                        }

                        if !PipelinesPanelState.open-component-read-only: Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: open-ta.has-hover ? Theme.raised : transparent;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                Text {
                                    text: "Edit";
                                    font-size: 11px;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }

                            open-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-component();
                                }
                            }
                        }

                        if !PipelinesPanelState.open-component-read-only: Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: expand-ta.has-hover ? Theme.raised : transparent;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                Text {
                                    text: "Expand";
                                    font-size: 11px;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }

                            expand-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.expand-component();
                                }
                            }
                        }

                        // Into a new component that contains this one (nested).
                        if !PipelinesPanelState.open-component-read-only: Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: bundle-component-ta.has-hover ? Theme.raised : transparent;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                Text {
                                    text: "Bundle";
                                    font-size: 11px;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }

                            bundle-component-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.create-component();
                                }
                            }
                        }

                        if root.step.update-version != "": Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: update-ta.has-hover ? Theme.cat-component : Theme.cat-component.with-alpha(0.8);
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                Text {
                                    text: "Update to v\{root.step.update-version}";
                                    font-size: 11px;
                                    color: Theme.panel;
                                    vertical-alignment: center;
                                }
                            }

                            update-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.update-component();
                                }
                            }
                        }
                    }

                    if !PipelinesPanelState.open-component-read-only: HorizontalLayout {
                        spacing: 6px;
                        padding-top: 2px;

                        Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: dup-ta.has-hover ? Theme.raised : transparent;
                            animate background { duration: 100ms; }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 5px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/regular-white/copy.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: Theme.text-dim;
                                    }
                                }

                                Text {
                                    text: "Duplicate";
                                    font-size: 11px;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }

                            dup-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.duplicate();
                                }
                            }
                        }

                        if root.step.category == StepCategory.component && PipelinesPanelState.open-component-name == "": Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: library-ta.has-hover ? Theme.raised : transparent;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                Text {
                                    text: "Save as";
                                    font-size: 11px;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }

                            library-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.save-to-library();
                                }
                            }
                        }

                        // A component card has it in its own row (no room here).
                        if root.step.category != StepCategory.component: Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: component-ta.has-hover ? Theme.raised : transparent;
                            animate background { duration: 100ms; }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 5px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/regular-white/brackets-square.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: Theme.text-dim;
                                    }
                                }

                                Text {
                                    text: "Bundle";
                                    font-size: 11px;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }

                            component-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.create-component();
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.err.with-alpha(0.3);
                            background: rm-ta.has-hover ? Theme.err.with-alpha(0.1) : transparent;
                            animate background { duration: 100ms; }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 5px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/regular-white/trash-simple.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: Theme.err;
                                    }
                                }

                                Text {
                                    text: "Remove";
                                    font-size: 11px;
                                    color: Theme.err;
                                    vertical-alignment: center;
                                }
                            }

                            rm-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.remove();
                                }
                            }
                        }
                    }

                    // YODA
                Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }
        }
    }

// ----------------------------------------------------------
// Insertion point between rows

component InsertPoint inherits Rectangle {
        callback insert;
        height: 16px;

        // hairline
    Rectangle {
            x: 12px;
            y: (parent.height - 1px) / 2;
            width: parent.width - 24px;
            height: 1px;
            background: Theme.border-soft;
        }

        // round + button
    Rectangle {
            x: (parent.width - 18px) / 2;
            y: (parent.height - 18px) / 2;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: ta.has-hover ? Theme.accent : Theme.panel;
            border-width: 1px;
            border-color: ta.has-hover ? Theme.accent : Theme.border;
            animate background { duration: 100ms; }

            Image {
                source: @image-url("../icons/regular-white/plus.svg");
                width: 10px;
                height: 10px;
                colorize: ta.has-hover ? #ffffff : Theme.text-mute;
            }

            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.insert();
                }
            }
        }
    }

// ----------------------------------------------------------
// Category filter chip

/*
component CategoryChip inherits Rectangle {
    in property <StepCategory> category;
    in property <int> count;
    in property <bool> active;
    callback clicked;

    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.active ? Cat.color(category) : Theme.border-soft;
    background: root.active ? Cat.tint(category) : transparent;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 5px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 1.5px;
                background: Cat.color(category);
            }
        }

        Text {
            text: Cat.name(category);
            color: root.active ? Cat.color(category) : Theme.text-dim;
            font-size: 10.5px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: count;
            color: Theme.text-mute;
            font-size: 10.5px;
            font-family: Theme.font-mono;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
    */

// ══════════════════════════════════════════════════════════
// Main panel
export global PipelinesPanelState {
        in property <[Pipeline]> pipelines: [];
        in property <[PipelineCommand]> active-commands:[];
        in property <string> active-pipeline-name;
        in property <string> active-pipeline-image-source;
        in property <int> enabled-pipeline-count;
        in property <int> total-enabled-steps;
        in property <string> eta-seconds-per-image: "0.00";
        in property <int> cat-count-preprocess;
        in property <int> cat-count-segment;
        in property <int> cat-count-classify;
        in property <int> cat-count-measure;

        // -- User selection state --
    in-out property <int> active-pipeline-id;
        in-out property <int> selected-step-id;
        in-out property <int> filter-category: -1;

        // -- Breakpoint state (-1 / 0 = none) --
    in-out property <int> breakpoint-pipeline-id: -1;
        in-out property <string> breakpoint-step-id: "";
    // 0 = off, 1 = Stop (pipeline halts at step), 2 = Snapshot (capture and continue)
    in-out property <int> breakpoint-mode: 0;
    // True while the viewport shows the breakpoint image instead of the original.
    in-out property <bool> show-breakpoint-image: false;
    // True once a breakpoint image has been captured (enables the toggle).
    in-out property <bool> has-breakpoint-image: false;
    // Which buffer the breakpoint preview renders: 0 = processed image,
    // 1 = segmentation map, 2 = instance map.
    in-out property <int> breakpoint-view-mode: 0;
    // True once auto preview is enabled
    in-out property <bool> auto-preview-enabled: false;

        // -- Outbound callbacks --
    // mode: 1 = Stop (pipeline halts at step), 2 = Snapshot (capture and continue)
    callback set-breakpoint(int, string, int);   // pipeline-id, step-id, mode
    callback clear-breakpoint();
    // Fired whenever the breakpoint-image toggle changes so Rust can
    // switch the viewport worker between original and breakpoint rendering.
    callback show-breakpoint-image-changed(bool);
    // Fired whenever the breakpoint view-mode dropdown changes (see
    // breakpoint-view-mode above for the value meaning).
    callback breakpoint-view-mode-changed(int);
        callback select-pipeline(int);
        callback toggle-pipeline(int);
        callback move-pipeline-up(int);
        callback move-pipeline-down(int);
        callback new-pipeline();
        callback duplicate-pipeline(int);
        callback delete-pipeline(int);
        callback pipeline-more(int);

        callback toggle-step(int);
        callback expand-step(int);
        callback remove-step(int);
        callback duplicate-step(int);
        /// Opens "Create component" starting at this step (its index).
        callback create-component(int);
        /// The component opened in the panel (its steps are shown), or
        /// empty.
        in property <string> open-component-name: "";
        /// What's wrong with the opened component (its checks), or empty.
        in property <string> open-component-problem: "";
        // A component only looked at from a pipeline step: that it shows the
        // step's values ("Shown with the values of step 1 …"), else empty.
        in property <string> open-component-values: "";
        // What the checks found in the whole project (`check_project`).
        in property <[ProblemItem]> project-problems: [];
        // How many of `project-problems` are errors.
        in property <int> project-problem-errors: 0;
        in-out property <bool> problems-expanded: false;
        // Opens or closes a section of a component card (step index, section).
        callback toggle-section(int, string);
        // Shows the step a problem is about (its `index`).
        callback show-problem(int);
        // Makes a problem's fix (its `index`).
        callback fix-problem(int);
        /// The opened component is only being looked at ("View"): nothing can be
        /// changed.
        in property <bool> open-component-read-only: false;
        callback view-component(int);
        /// "Edit" in the bar of a component opened with "View".
        callback edit-open-component();
        /// "Settings…" in the opened component's bar: its name, description and
        /// parameters, in a dialog.
        callback open-component-settings();
        /// ✎ next to an exposed setting (step index, setting path): the
        /// settings dialog at its parameter.
        callback edit-exposed(int, string);
        callback open-component(int);
        callback close-component();
        callback expand-component(int);
        /// "Save to library…" on a component card (step index).
        callback save-component-to-library(int);
        /// "Update to vN" on a component card (step index).
        callback update-component(int);
        /// Exposes a setting of an opened component's step as a component parameter,
        /// or hides it again: step index, setting path ("min_area",
        /// "thresholds.1.min_threshold").
        callback toggle-exposed(int, string);
        callback insert-step(int, int);          // pipeline-id, after-idx
    callback param-changed(int, string, string);
        callback add-group-item(int, string);    // step-id, param-name
        // Expands/collapses a step's advanced settings (step-id).
        callback toggle-advanced(int);
        // Debug mode (user preference, toolbar): settings show what they're
        // wired to inside components.
        in-out property <bool> debug-mode: false;
        callback debug-mode-toggled(bool);
        // "Always show advanced settings" (user preference, every step).
        in-out property <bool> always-show-advanced: false;
        callback always-show-advanced-toggled(bool);
        callback remove-group-item(int, string, int); // step-id, param-name, item-idx
    callback show-model-info(int); // step-id
        // The step (step-id) whose settings the settings dialog shows.
        in-out property <string> settings-step-id;
        // Opens the settings dialog for a step (step-id).
        callback open-step-settings(string);

        callback run-all();
        callback dry-run();
        callback auto-preview(bool);
        // Saves the pipeline's steps to the library as one component.
        callback save-as-component();

        // Opens the file browser for a file-path parameter, filtered to the given
    // comma-separated extensions (empty = any file), starting from the
    // current path's folder. The chosen path comes back asynchronously: Rust
    // sets `browse-result-path`, then `browse-result-token` to the token the
    // row passed, and the row with that token applies it (see
    // `LeafParamRow`/`ParamRow`).
    callback browse-file(string, string, int);
        in-out property <int> browse-token-counter: 0;
        in-out property <int> browse-result-token: -1;
        in-out property <string> browse-result-path;
    }




export component PipelinesPanel inherits Rectangle {

        background: Theme.panel;

        VerticalLayout {
            spacing: 0px;

            // --- 1. Header ---
        Rectangle {
                height: 38px;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Pipelines";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                        }

                        Text {
                            text: PipelinesPanelState.enabled-pipeline-count + " / " + PipelinesPanelState.pipelines.length;
                            font-size: 11px;
                            font-family: Theme.font-mono;
                            color: Theme.text-mute;
                            vertical-alignment: center;
                        }
                    }

                    // New pipeline - moved up onto the header row (was a
                    // full-width bar below the pipeline-tab list, permanently
                    // costing ~46px of sidebar height that's better spent on
                    // visible pipeline steps). Same compact-pill style as the
                    // "Auto-scale" button next to the histogram title.
                    //
                    // Wrapped in a VerticalLayout so the fixed-height pill is
                    // centered against the row's other (auto-stretched) text,
                    // instead of defaulting to the top - same reason the icon
                    // inside it gets its own centering VerticalLayout below,
                    // matching the "Duplicate"/"Remove" buttons further down
                    // in this file.
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;
                        VerticalLayout {
                            alignment: center;
                            FocusModeButton { }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 24px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: np-ta.has-hover ? Theme.raised.brighter(0.06) : Theme.raised;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../icons/regular-white/plus.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: Theme.text;
                                        }
                                    }

                                    Text {
                                        text: "New pipeline";
                                        color: Theme.text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                np-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        PipelinesPanelState.new-pipeline();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // --- 2. Pipeline tabs ---
        VerticalLayout {
            // Scrollable, capped list of pipeline tabs - grows with the
            // number of pipelines but caps out so a long list can't squeeze
            // the step list below (section 5, which only has
            // vertical-stretch:1 to claim whatever this section leaves it) -
            // beyond the cap it scrolls instead.
            Rectangle {
                    height: min(PipelinesPanelState.pipelines.length * 49px + 7px, 200px);

                    ScrollView {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 3px;

                            for p in PipelinesPanelState.pipelines: PipelineTab {
                                pipeline: p;
                                active: p.id == PipelinesPanelState.active-pipeline-id;
                                selected => {
                                    PipelinesPanelState.active-pipeline-id = p.id;
                                    PipelinesPanelState.select-pipeline(p.id);
                                    PipelineFocusState.pipeline-selected(p.id);
                                }
                                // Double-click edits the pipeline (same dialog as
                                // the "..." button), Alt+click focuses it.
                                double-clicked => {
                                    PipelinesPanelState.pipeline-more(p.id);
                                }
                                alt-clicked => {
                                    PipelineFocusState.toggle-pipeline-focus(p.id);
                                }
                                toggled => {
                                    PipelinesPanelState.toggle-pipeline(p.id);
                                }
                                move-up => {
                                    PipelinesPanelState.move-pipeline-up(p.id);
                                }
                                move-down => {
                                    PipelinesPanelState.move-pipeline-down(p.id);
                                }
                                more-clicked => {
                                    PipelinesPanelState.pipeline-more(p.id);
                                }
                            }
                        }
                    }
                }
            }

            // --- 3. Editing-context bar ---
        Rectangle {
                height: 46px;
                background: Theme.bg;

                // top + bottom hairlines (faked with absolutely-positioned 1px rects)
            Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 1px;
                    background: Theme.border-soft;
                }

                Rectangle {
                    x: 0px;
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: Theme.border-soft;
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "EDITING";
                                color: Theme.text-mute;
                                font-size: 9.5px;
                                letter-spacing: 0.5px;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: PipelinesPanelState.active-pipeline-name;
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 500;
                                overflow: elide;
                            }

                            Text {
                                text: PipelinesPanelState.active-pipeline-image-source;
                                font-size: 10px;
                                font-family: Theme.font-mono;
                                color: Theme.text-mute;
                                overflow: elide;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 3px;
                            GhostIconBtn {
                                icon: @image-url("../icons/regular-white/pencil-simple.svg");
                                clicked => {
                                    PipelinesPanelState.pipeline-more(PipelinesPanelState.active-pipeline-id);
                                }
                            }

                            GhostIconBtn {
                                icon: @image-url("../icons/regular-white/copy.svg");
                                clicked => {
                                    PipelinesPanelState.duplicate-pipeline(PipelinesPanelState.active-pipeline-id);
                                }
                            }

                            GhostIconBtn {
                                icon: @image-url("../icons/regular-white/trash-simple.svg");
                                tint: Theme.text-mute;
                                clicked => {
                                    PipelinesPanelState.delete-pipeline(PipelinesPanelState.active-pipeline-id);
                                }
                            }
                        }
                    }
                }
            }

            // --- 3b. The project's problems ---
            if PipelinesPanelState.project-problems.length > 0: Rectangle {
                background: Theme.bg;
                // As high as its content - a Rectangle would stretch and take
                // height from the step list.
                height: strip.preferred-height;
                vertical-stretch: 0;
                strip := VerticalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 6px;

                    problems-head := HorizontalLayout {
                        spacing: 6px;
                        accessible-role: button;
                        accessible-label: "Problems";
                        Text {
                            text: PipelinesPanelState.problems-expanded ? "▾" : "▸";
                            font-size: 10px;
                            color: Theme.text-mute;
                            vertical-alignment: center;
                        }
                        Text {
                            text: PipelinesPanelState.project-problem-errors > 0
                                ? "⚠ \{PipelinesPanelState.project-problems.length} problems in the project - \{PipelinesPanelState.project-problem-errors} make a run fail"
                                : "⚠ \{PipelinesPanelState.project-problems.length} things that look unintended";
                            font-size: 11px;
                            font-weight: 500;
                            color: PipelinesPanelState.project-problem-errors > 0 ? Theme.err : Theme.warn;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }

                    if PipelinesPanelState.problems-expanded: ScrollView {
                        height: min(problem-list.preferred-height, 220px);
                        problem-list := VerticalLayout {
                            spacing: 8px;
                            padding-right: 6px;
                            for item in PipelinesPanelState.project-problems: ProblemRow {
                                item: item;
                            }
                        }
                    }
                }

                // The head toggles the list (over the head only).
                TouchArea {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: problems-head.height + 12px;
                    mouse-cursor: pointer;
                    clicked => {
                        PipelinesPanelState.problems-expanded = !PipelinesPanelState.problems-expanded;
                    }
                }

                Rectangle {
                    x: 0px;
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: Theme.border-soft;
                }
            }

            // --- 4. Category filter chips ---
       /*
        Rectangle {
            height: 62px;
            GridLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 6px;
                spacing: 4px;

                Row {
                    CategoryChip {
                        category: StepCategory.preprocess;
                        count: PipelinesPanelState.cat-count-preprocess;
                        active: PipelinesPanelState.filter-category == 0;
                        clicked => {
                            PipelinesPanelState.filter-category = PipelinesPanelState.filter-category == 0 ? -1 : 0;
                        }
                    }

                    CategoryChip {
                        category: StepCategory.segment;
                        count: PipelinesPanelState.cat-count-segment;
                        active: PipelinesPanelState.filter-category == 1;
                        clicked => {
                            PipelinesPanelState.filter-category = PipelinesPanelState.filter-category == 1 ? -1 : 1;
                        }
                    }
                }

                Row {
                    CategoryChip {
                        category: StepCategory.object;
                        count: PipelinesPanelState.cat-count-classify;
                        active: PipelinesPanelState.filter-category == 2;
                        clicked => {
                            PipelinesPanelState.filter-category = PipelinesPanelState.filter-category == 2 ? -1 : 2;
                        }
                    }

                    CategoryChip {
                        category: StepCategory.measure;
                        count: PipelinesPanelState.cat-count-measure;
                        active: PipelinesPanelState.filter-category == 3;
                        clicked => {
                            PipelinesPanelState.filter-category = PipelinesPanelState.filter-category == 3 ? -1 : 3;
                        }
                    }
                }
            }
        }
*/
        // --- 5. Step list (scrolling) ---
        // An opened component's bar stays on top while its steps scroll.
        VerticalLayout {
                vertical-stretch: 1;

                if PipelinesPanelState.open-component-name != "": VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    Rectangle {
                            // As high as its (wrapping) text needs.
                            height: bar.preferred-height;
                            border-radius: 6px;
                            background: Theme.cat-component.with-alpha(0.10);
                            border-width: 1px;
                            border-color: Theme.cat-component.with-alpha(0.5);
                            bar := HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 54px;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: back-ta.has-hover ? Theme.raised : transparent;
                                        Text {
                                            text: "‹ Back";
                                            font-size: 11px;
                                            color: Theme.text;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        back-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                PipelinesPanelState.close-component();
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "\{PipelinesPanelState.active-pipeline-name} › ◆ \{PipelinesPanelState.open-component-name}";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.text;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }

                                    Text {
                                        text: PipelinesPanelState.open-component-read-only ? "Viewing · read only" : "Changes apply to every use of this component · ◇ exposes a setting";
                                        font-size: 10px;
                                        color: Theme.text-mute;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }

                                    if PipelinesPanelState.open-component-values != "": Text {
                                        text: PipelinesPanelState.open-component-values;
                                        font-size: 10px;
                                        color: Theme.text-dim;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }

                                    if PipelinesPanelState.open-component-problem != "": Text {
                                        text: "⚠ \{PipelinesPanelState.open-component-problem}";
                                        font-size: 10px;
                                        color: Theme.warn;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    if !PipelinesPanelState.open-component-read-only: Rectangle {
                                        width: 66px;
                                        height: 24px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: settings-ta.has-hover ? Theme.raised : transparent;
                                        Text {
                                            text: "Settings…";
                                            font-size: 11px;
                                            color: Theme.text-dim;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        settings-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                PipelinesPanelState.open-component-settings();
                                            }
                                        }
                                    }

                                    if PipelinesPanelState.open-component-read-only: Rectangle {
                                        width: 66px;
                                        height: 24px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: Theme.cat-component;
                                        background: edit-ta.has-hover ? Theme.cat-component.with-alpha(0.15) : transparent;
                                        Text {
                                            text: "Edit";
                                            font-size: 11px;
                                            color: Theme.cat-component;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        edit-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                PipelinesPanelState.edit-open-component();
                                            }
                                        }
                                    }
                                }
                            }
                        }

                }

                ScrollView {
                vertical-stretch: 1;
                    VerticalLayout {
                        // Steps at their own height - with a short pipeline the
                        // stretchable parts of an expanded card (a section
                        // header, the card's bottom) would fill the panel.
                        alignment: start;
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 4px;
                        padding-top: 8px;
                        spacing: 0px;

                        // -- EMPTY STATE --
                    if PipelinesPanelState.active-commands.length == 0: Rectangle {
                            height: 180px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                padding: 16px;

                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 48px;
                                        height: 48px;
                                        border-radius: 10px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        Image {
                                            source: @image-url("../icons/regular-white/flow-arrow.svg");
                                            width: 20px;
                                            height: 20px;
                                            colorize: Theme.text-faint;
                                        }
                                    }
                                }

                                Text {
                                    text: PipelinesPanelState.pipelines.length == 0 ? "No pipelines yet" : "This pipeline is empty";
                                    font-size: 12px;
                                    color: Theme.text-dim;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: PipelinesPanelState.pipelines.length == 0 ? "Create a pipeline above, then add\nsteps to run on every image." : "Add a step below to start chaining\noperations.";
                                    font-size: 11px;
                                    color: Theme.text-mute;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // -- STEP ROWS --
                    if PipelinesPanelState.active-commands.length > 0 && !PipelinesPanelState.open-component-read-only: InsertPoint {
                            insert => {
                                PipelinesPanelState.insert-step(PipelinesPanelState.active-pipeline-id, -1);
                            }
                        }

                        for cmd[i] in PipelinesPanelState.active-commands: VerticalLayout {
                            spacing: 0px;
                            StepRow {
                                step: cmd;
                                idx: i;
                                pipeline-id: PipelinesPanelState.active-pipeline-id;
                                toggle-enabled => {
                                    PipelinesPanelState.toggle-step(cmd.id);
                                }
                                toggle-expanded => {
                                    if cmd.expanded == true {
                                        cmd.expanded = false;
                                    } else {
                                        cmd.expanded = true;
                                    }
                                    PipelinesPanelState.expand-step(cmd.id);
                                }
                                remove => {
                                    PipelinesPanelState.remove-step(cmd.id);
                                }
                                duplicate => {
                                    PipelinesPanelState.duplicate-step(cmd.id);
                                }
                                create-component => {
                                    PipelinesPanelState.create-component(cmd.id);
                                }
                                open-component => {
                                    PipelinesPanelState.open-component(cmd.id);
                                }
                                view-component => {
                                    PipelinesPanelState.view-component(cmd.id);
                                }
                                expand-component => {
                                    PipelinesPanelState.expand-component(cmd.id);
                                }
                                save-to-library => {
                                    PipelinesPanelState.save-component-to-library(cmd.id);
                                }
                                update-component => {
                                    PipelinesPanelState.update-component(cmd.id);
                                }
                                param-changed(n, v) => {
                                    PipelinesPanelState.param-changed(cmd.id, n, v);
                                }
                                open-settings => {
                                    PipelinesPanelState.open-step-settings(cmd.step-id);
                                }
                                toggle-breakpoint => {
                                    if PipelinesPanelState.breakpoint-pipeline-id == PipelinesPanelState.active-pipeline-id && PipelinesPanelState.breakpoint-step-id == cmd.step-id {
                                        if PipelinesPanelState.breakpoint-mode == 1 {
                                        // Stop → Snapshot (capture image, pipeline continues)
                                        PipelinesPanelState.breakpoint-mode = 2;
                                            PipelinesPanelState.show-breakpoint-image = false;
                                            PipelinesPanelState.show-breakpoint-image-changed(false);
                                            PipelinesPanelState.has-breakpoint-image = false;
                                            PipelinesPanelState.set-breakpoint(PipelinesPanelState.active-pipeline-id, cmd.step-id, 2);
                                        } else {
                                        // Snapshot → Off; captured image remains available.
                                        PipelinesPanelState.breakpoint-pipeline-id = -1;
                                            PipelinesPanelState.breakpoint-step-id = "";
                                            PipelinesPanelState.breakpoint-mode = 0;
                                            PipelinesPanelState.clear-breakpoint();
                                        }
                                    } else {
                                    // Off → Stop (pipeline halts at step)
                                    PipelinesPanelState.breakpoint-pipeline-id = PipelinesPanelState.active-pipeline-id;
                                        PipelinesPanelState.breakpoint-step-id = cmd.step-id;
                                        PipelinesPanelState.breakpoint-mode = 1;
                                        PipelinesPanelState.show-breakpoint-image = false;
                                        PipelinesPanelState.show-breakpoint-image-changed(false);
                                        PipelinesPanelState.has-breakpoint-image = false;
                                        PipelinesPanelState.set-breakpoint(PipelinesPanelState.active-pipeline-id, cmd.step-id, 1);
                                    }
                                }
                            }

                            if i < PipelinesPanelState.active-commands.length - 1 && !PipelinesPanelState.open-component-read-only: InsertPoint {
                                insert => {
                                    PipelinesPanelState.insert-step(PipelinesPanelState.active-pipeline-id, i);
                                }
                            }
                            if i >= PipelinesPanelState.active-commands.length - 1: Rectangle {
                                height: 8px;
                            }
                        }

                        // -- ADD STEP - only when there is at least one pipeline --
                    if PipelinesPanelState.pipelines.length > 0 && !PipelinesPanelState.open-component-read-only: Rectangle {
                            height: 34px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: add-ta.has-hover ? Theme.raised : transparent;
                            animate background { duration: 100ms; }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Image {
                                    source: @image-url("../icons/regular-white/plus.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: Theme.text-dim;
                                    y: 10px;
                                }

                                Text {
                                    text: "Add step";
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            add-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    PipelinesPanelState.insert-step(PipelinesPanelState.active-pipeline-id, PipelinesPanelState.active-commands.length);
                                }
                            }
                        }
                    }
                }
            }

            // --- 6. Run bar ---
        Rectangle {
                height: PipelinesPanelState.show-breakpoint-image ? 148px : (PipelinesPanelState.has-breakpoint-image ? 114px : 76px);

                // Top hairline
            Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 1px;
                    background: Theme.border-soft;
                }

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: PipelinesPanelState.enabled-pipeline-count + " pipelines · " + PipelinesPanelState.total-enabled-steps + " steps total";
                            color: Theme.text-mute;
                            font-size: 10.5px;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Image {
                                source: @image-url("../icons/regular-white/clock.svg");
                                width: 11px;
                                height: 11px;
                                colorize: Theme.text-mute;
                            }

                            Text {
                                text: "~" + PipelinesPanelState.eta-seconds-per-image + "s/image";
                                color: Theme.text-mute;
                                font-size: 10.5px;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Breakpoint image toggle (only shown when a breakpoint image is available)
                if PipelinesPanelState.has-breakpoint-image: Rectangle {
                        height: 30px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: PipelinesPanelState.show-breakpoint-image ? #e53e3e.with-alpha(0.6) : Theme.border;
                        background: PipelinesPanelState.show-breakpoint-image ? #e53e3e.with-alpha(0.12) : (bp-view-ta.has-hover ? Theme.raised : transparent);
                        animate background { duration: 100ms; }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #e53e3e;
                                y: 11px;
                            }

                            Text {
                                text: PipelinesPanelState.show-breakpoint-image ? "Breakpoint image" : "Original image";
                                font-size: 11px;
                                color: PipelinesPanelState.show-breakpoint-image ? #e53e3e : Theme.text-dim;
                                vertical-alignment: center;
                            }
                        }

                        bp-view-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                PipelinesPanelState.show-breakpoint-image = !PipelinesPanelState.show-breakpoint-image;
                                PipelinesPanelState.show-breakpoint-image-changed(PipelinesPanelState.show-breakpoint-image);
                            }
                        }
                    }

                    // Breakpoint buffer picker (image / segmentation / instances) -
                    // only meaningful while the breakpoint image is actually shown.
                    if PipelinesPanelState.has-breakpoint-image && PipelinesPanelState.show-breakpoint-image: bp-mode-ta := TouchArea {
                        height: 26px;
                        mouse-cursor: pointer;
                        clicked => {
                            bp-mode-popup.show();
                        }

                        Rectangle {
                            background: bp-mode-ta.has-hover ? Theme.hover : Theme.raised;
                            border-color: Theme.border;
                            border-width: 1px;
                            border-radius: 5px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: space-between;

                                Text {
                                    text: PipelinesPanelState.breakpoint-view-mode == 1 ? "Segmentation" : PipelinesPanelState.breakpoint-view-mode == 2 ? "Instances" : "Processed image";
                                    font-size: 11px;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "▼";
                                    font-size: 9px;
                                    color: Theme.text-mute;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        bp-mode-popup := PopupWindow {
                            x: 0;
                            y: bp-mode-ta.height + 4px;
                            width: bp-mode-ta.width;
                            height: 3 * 32px;

                            Rectangle {
                                background: Theme.raised;
                                border-color: Theme.border;
                                border-width: 1px;
                                border-radius: 4px;

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;

                                    for entry[i] in [
                                        { label: "Processed image", value: 0 },
                                        { label: "Segmentation", value: 1 },
                                        { label: "Instances", value: 2 },
                                    ]: item-ta := TouchArea {
                                        height: 28px;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            PipelinesPanelState.breakpoint-view-mode = entry.value;
                                            PipelinesPanelState.breakpoint-view-mode-changed(entry.value);
                                            bp-mode-popup.close();
                                        }

                                        Rectangle {
                                            background: item-ta.has-hover ? Theme.hover : (PipelinesPanelState.breakpoint-view-mode == entry.value ? Theme.border-soft : transparent);
                                            border-radius: 2px;

                                            Text {
                                                text: entry.label;
                                                font-size: 11px;
                                                color: Theme.text;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                                x: 8px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        // Combined preview control — one rounded unit:
                    //   • left  : tap "Preview" to render once (dry-run)
                    //   • right : toggle "Auto" to keep re-rendering on change
                    // The Auto segment dims when off and gets a bright wash +
                    // bold label when on, so its state reads without a switch.
                    Rectangle {
                            height: 34px;
                            border-radius: 6px;
                            horizontal-stretch: 1;
                            clip: true;
                            background: Theme.accent;

                            HorizontalLayout {
                                spacing: 0px;

                                // -- One-shot preview --
                            Rectangle {
                                    horizontal-stretch: 1;
                                    background: preview-ta.has-hover ? #ffffff.with-alpha(0.12) : transparent;
                                    animate background { duration: 100ms; }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Image {
                                            y: 10px;
                                            source: @image-url("../icons/regular-white/eye.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: #ffffff;
                                        }

                                        Text {
                                            text: "Preview";
                                            color: #ffffff;
                                            font-size: 12px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }

                                    preview-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            PipelinesPanelState.dry-run();
                                        }
                                    }
                                }

                                // Divider between the two segments
                            Rectangle {
                                    width: 1px;
                                    background: #ffffff.with-alpha(0.25);
                                }

                                // -- Auto-preview toggle --
                            Rectangle {
                                    width: 76px;
                                    background: PipelinesPanelState.auto-preview-enabled ? #ffffff.with-alpha(0.22) : (auto-ta.has-hover ? #ffffff.with-alpha(0.12) : transparent);
                                    animate background { duration: 100ms; }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 5px;
                                        Image {
                                            y: 10px;
                                            source: @image-url("../icons/regular-white/lightning.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: #ffffff;
                                            opacity: PipelinesPanelState.auto-preview-enabled ? 1.0 : 0.55;
                                        }

                                        Text {
                                            text: "Auto";
                                            color: #ffffff;
                                            opacity: PipelinesPanelState.auto-preview-enabled ? 1.0 : 0.55;
                                            font-size: 12px;
                                            font-weight: PipelinesPanelState.auto-preview-enabled ? 600 : 500;
                                            vertical-alignment: center;
                                        }
                                    }

                                    auto-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            PipelinesPanelState.auto-preview-enabled = !PipelinesPanelState.auto-preview-enabled;
                                            PipelinesPanelState.auto-preview(PipelinesPanelState.auto-preview-enabled);
                                        }
                                    }
                                }
                            }
                        }

                        // Run analysis
                    GhostIconBtn {
                            sz: 34px;
                            icon-sz: 14px;
                            icon: @image-url("../icons/regular-white/person-simple-run.svg");
                            clicked => {
                                PipelinesPanelState.run-all();
                            }
                        }

                        // Save pipeline as component
                    GhostIconBtn {
                            sz: 34px;
                            icon-sz: 14px;
                            icon: @image-url("../icons/regular-white/floppy-disk.svg");
                            clicked => {
                                PipelinesPanelState.save-as-component();
                            }
                        }
                    }
                }
            }
        }
    }

// ══════════════════════════════════════════════════════════
// Step settings dialog

// One section of the settings dialog's list on the left.
component SectionNavItem inherits Rectangle {
        in property <string> text;
    // Shown after the name, e.g. "2 changed".
    in property <string> note;
        in property <bool> active;
        callback clicked;

        height: 30px;
        border-radius: 6px;
        background: root.active ? Theme.accent-dim : (ta.has-hover ? Theme.hover : transparent);

        Rectangle {
            x: 0;
            y: 7px;
            width: 3px;
            height: parent.height - 14px;
            border-radius: 1.5px;
            background: root.active ? Theme.accent : transparent;
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 6px;

            Text {
                text: root.text;
                vertical-alignment: center;
                font-size: 12px;
                font-weight: root.active ? 600 : 400;
                color: root.active ? Theme.text : Theme.text-dim;
                overflow: elide;
            }

            if root.note != "": Text {
                text: root.note;
                vertical-alignment: center;
                font-size: 10px;
                color: Theme.warn;
            }
        }

        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }

// A step's settings in a larger dialog (⤢ on the step card), like the
// project settings: the step's sections - the sections of its settings,
// and "Advanced" - on the left, the chosen section's settings on the right;
// or, while searching, every matching setting. Shows the step
// `PipelinesPanelState.settings-step-id`, live: edits go through the same
// callbacks as on the card. (Opening it shows the step's advanced settings,
// so they are there to pick and to search.)
export component StepSettingsDialog inherits Dialog {
        title: "Step settings";
        dialog-width: 920px;
        dialog-height: 660px;
        content-padding: 0px;
        close-on-backdrop: true;

        // The list is rebuilt after each change - what's chosen lives out here
    // so it stays.
    // Index into the step's `sections`; `sections.length` is Advanced.
    property <int> current: 0;
        property <string> query;
        property <bool> searching: root.query.replace-all(" ", "") != "";

        // Whether setting `p` is found by the search text (ignoring case).
    pure function matches(p: CommandParameter) -> bool {
            root.found("\{p.display-name} \{p.name} \{p.description} \{p.section}")
        }

        pure function found(words: string) -> bool {
            words.to-lowercase().replace-all(root.query.to-lowercase(), "") != words.to-lowercase()
        }

        // Whether setting `p` of the basic (not advanced) ones is shown.
    pure function shows(p: CommandParameter, sections: [string]) -> bool {
            root.searching ? root.matches(p) : (root.current < sections.length && p.section == sections[root.current])
        }

        // The chosen step's settings - one list for all steps, so the
        // step is found in it (the list is rebuilt after each change).
        Rectangle {
        vertical-stretch: 1;
        for cmd in PipelinesPanelState.active-commands: Rectangle {
            width: 100%;
            height: 100%;
            if cmd.step-id == PipelinesPanelState.settings-step-id: Rectangle {
                property <bool> on-advanced: !root.searching && root.current >= cmd.sections.length;

                width: 100%;
                height: 100%;
                border-width: 1px;
                border-color: Theme.border-soft;
                clip: true;

                HorizontalLayout {
                // -- Left: name, search, sections --
                Rectangle {
                        width: 230px;
                        background: Theme.bg;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 4px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 4px;
                                    border-radius: 2px;
                                    background: Cat.color(cmd.category);
                                }

                                Text {
                                    text: cmd.name;
                                    font-size: 18px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                            }

                            Rectangle {
                                height: 10px;
                            }

                            LineEdit {
                                text: root.query;
                                placeholder-text: "Search settings";
                                edited(t) => {
                                    root.query = t;
                                }
                            }

                            Rectangle {
                                height: 10px;
                            }

                            for section[si] in cmd.sections: SectionNavItem {
                                text: section == "" ? "General" : section;
                                active: !root.searching && root.current == si;
                                clicked => {
                                    root.query = "";
                                    root.current = si;
                                }
                            }

                            if cmd.advanced-count > 0: SectionNavItem {
                                text: "Advanced (\{cmd.advanced-count})";
                                note: cmd.advanced-changed > 0 ? "\{cmd.advanced-changed} changed" : "";
                                active: on-advanced;
                                clicked => {
                                    root.query = "";
                                    root.current = cmd.sections.length;
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 1px;
                        background: Theme.border-soft;
                    }

                    // -- Right: the chosen section's settings --
                Rectangle {
                        horizontal-stretch: 1;
                        ScrollView {
                            VerticalLayout {
                                padding: 24px;
                                padding-top: 20px;
                                spacing: 6px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.searching ? "Search results" : on-advanced ? "Advanced" : (cmd.sections[root.current] == "" ? "General" : cmd.sections[root.current]);
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: cmd.summary;
                                    font-size: 11px;
                                    font-family: Theme.font-mono;
                                    color: Theme.text-mute;
                                    overflow: elide;
                                }

                                // What the command does - on its first page.
                            if cmd.help != "" && !root.searching && root.current == 0: Text {
                                    text: cmd.help;
                                    font-size: 11px;
                                    color: Theme.text-dim;
                                    wrap: word-wrap;
                                    height: self.preferred-height;
                                }

                                Rectangle {
                                    height: 8px;
                                }

                                // The rows draw the dividers between them; the
                            // card's top border is the first one's.
                            Rectangle {
                                    background: Theme.panel;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.border-soft;
                                    clip: true;

                                    VerticalLayout {
                                        padding-top: -1px;

                                        if !on-advanced: VerticalLayout {
                                            for p in cmd.parameters: VerticalLayout {
                                                if root.shows(p, cmd.sections): WideParamRow {
                                                    p: p;
                                                    changed(v) => {
                                                        PipelinesPanelState.param-changed(cmd.id, p.name, v);
                                                    }
                                                    item-field-changed(item_idx, field_name, v) => {
                                                        PipelinesPanelState.param-changed(cmd.id, "\{p.name}.\{item_idx}.\{field_name}", v);
                                                    }
                                                    add-item => {
                                                        PipelinesPanelState.add-group-item(cmd.id, p.name);
                                                    }
                                                    remove-item(idx) => {
                                                        PipelinesPanelState.remove-group-item(cmd.id, p.name, idx);
                                                    }
                                                    show-model-info => {
                                                        PipelinesPanelState.show-model-info(cmd.id);
                                                    }
                                                    toggle-exposed => {
                                                        PipelinesPanelState.toggle-exposed(cmd.id, p.name);
                                                    }
                                                    toggle-item-exposed(item_idx, field_name) => {
                                                        PipelinesPanelState.toggle-exposed(cmd.id, "\{p.name}.\{item_idx}.\{field_name}");
                                                    }
                                                    edit-exposed => {
                                                        PipelinesPanelState.edit-exposed(cmd.id, p.name);
                                                    }
                                                    edit-item-exposed(item_idx, field_name) => {
                                                        PipelinesPanelState.edit-exposed(cmd.id, "\{p.name}.\{item_idx}.\{field_name}");
                                                    }
                                                }
                                            }
                                        }

                                        if on-advanced || root.searching: VerticalLayout {
                                            for p in cmd.advanced-parameters: VerticalLayout {
                                                if !root.searching || root.matches(p): WideParamRow {
                                                    p: p;
                                                    changed(v) => {
                                                        PipelinesPanelState.param-changed(cmd.id, p.name, v);
                                                    }
                                                    item-field-changed(item_idx, field_name, v) => {
                                                        PipelinesPanelState.param-changed(cmd.id, "\{p.name}.\{item_idx}.\{field_name}", v);
                                                    }
                                                    add-item => {
                                                        PipelinesPanelState.add-group-item(cmd.id, p.name);
                                                    }
                                                    remove-item(idx) => {
                                                        PipelinesPanelState.remove-group-item(cmd.id, p.name, idx);
                                                    }
                                                    show-model-info => {
                                                        PipelinesPanelState.show-model-info(cmd.id);
                                                    }
                                                    toggle-exposed => {
                                                        PipelinesPanelState.toggle-exposed(cmd.id, p.name);
                                                    }
                                                    toggle-item-exposed(item_idx, field_name) => {
                                                        PipelinesPanelState.toggle-exposed(cmd.id, "\{p.name}.\{item_idx}.\{field_name}");
                                                    }
                                                    edit-exposed => {
                                                        PipelinesPanelState.edit-exposed(cmd.id, p.name);
                                                    }
                                                    edit-item-exposed(item_idx, field_name) => {
                                                        PipelinesPanelState.edit-exposed(cmd.id, "\{p.name}.\{item_idx}.\{field_name}");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
