// editor/viewport_navigator.slint — the mini-map at the top right of the
// image: the whole image as a small frame, the part in view outlined. A
// click or a drag in it moves the view there. Auto: shown only while the
// view doesn't show the whole image; or always, or never (EVA › View).

import { ViewportState } from "../api/viewport.slint";
import { Ink } from "../ink/palette.slint";

export component Navigator inherits Rectangle {
    /// 0 auto (only zoomed in), 1 always, 2 never - `LayoutState.navigator-mode`.
    in property <int> mode: 0;
    // The viewport's size: with `nav_width`/`nav_height` (the part of the
    // image in view, 0…1) it gives the image's size on screen.
    in property <length> viewport-width;
    in property <length> viewport-height;

    property <float> nav-w: ViewportState.nav_width;
    property <float> nav-h: ViewportState.nav_height;
    property <bool> has-image: root.nav-w > 0 && root.nav-h > 0;
    // The image's width / height.
    property <float> aspect: root.has-image ? (root.viewport-width / root.nav-w) / (root.viewport-height / root.nav-h) : 1;
    property <length> max-side: 140px;

    // Moves the view so that the point (u, v) of the image (0…1) is in its
    // middle - the same way a drag on the image pans it.
    function center-on(u: float, v: float) {
        ViewportState.offset_x = -(u - root.nav-w / 2) * root.viewport-width / root.nav-w;
        ViewportState.offset_y = -(v - root.nav-h / 2) * root.viewport-height / root.nav-h;
        ViewportState.report_viewport_moved(ViewportState.offset_x / 1px, ViewportState.offset_y / 1px);
    }

    width: root.aspect >= 1 ? root.max-side : root.max-side * root.aspect;
    height: root.aspect >= 1 ? root.max-side / root.aspect : root.max-side;
    visible: root.has-image && (root.mode == 1 || (root.mode == 0 && (root.nav-w < 0.999 || root.nav-h < 0.999)));
    accessible-role: slider;
    accessible-label: "Navigator";

    frame := Rectangle {
        background: #000000.with-alpha(0.45);
        border-radius: Ink.radius-sm;
        border-width: 1px;
        border-color: #FFFFFF.with-alpha(0.35);
        clip: true;

        // The part in view.
        Rectangle {
            x: ViewportState.nav_x * parent.width;
            y: ViewportState.nav_y * parent.height;
            width: max(4px, root.nav-w * parent.width);
            height: max(4px, root.nav-h * parent.height);
            background: Ink.focus.with-alpha(0.18);
            border-width: 1.5px;
            border-color: Ink.focus;
        }

        TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    root.center-on(self.mouse-x / self.width, self.mouse-y / self.height);
                }
            }
            moved => {
                if self.pressed {
                    root.center-on(clamp(self.mouse-x / self.width, 0, 1), clamp(self.mouse-y / self.height, 0, 1));
                }
            }
        }
    }
}
