// editor/image_meta_panel.slint — "Image info": what the file says about
// the open image. Pixel size, frame interval and the channels' wavelengths
// can be corrected right in place (Enter applies; for the whole project);
// Reset brings back the file's values.

import { ChannelState } from "../api/state.slint";
import { ImageMetaData, WavelengthOption } from "../api/image_meta.slint";
import { Ink, InkIcons, InkTextField, InkButton, InkButtonKind, InkCaption, InkHint } from "../ink/ink.slint";
import { FocusBanner } from "pipeline_focus.slint";

// "edited" - set for the project, not read from the file.
component EditedTag inherits Text {
    text: "edited";
    font-size: Ink.fs-caption;
    color: Ink.focus;
    vertical-alignment: center;
}

// A color tile of a channel's color chooser.
component WavelengthTile inherits Rectangle {
    in property <WavelengthOption> option;
    in property <bool> selected;
    callback picked(float);

    width: 18px;
    height: 18px;
    accessible-role: button;
    accessible-label: root.option.nm > 0 ? root.option.nm + " nm" : "White";
    accessible-checked: root.selected;

    face := Rectangle {
        background: root.option.color;
        border-radius: Ink.radius-xs;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? Ink.text : Ink.shadow.with-alpha(0.25);
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked(root.option.nm);
        }
    }
}

// A label of the info's form.
component Key inherits Text {
    width: 96px;
    font-size: Ink.fs-secondary;
    color: Ink.text-dim;
    vertical-alignment: center;
    overflow: elide;
}

export component ImageMetaPanel inherits Rectangle {
    // The channel whose color chooser is open, -1 none.
    property <int> editing-channel: -1;
    // "All metadata ›": everything the file says.
    property <bool> all: false;
    property <length> field-w: 130px;

    background: Ink.ground.mix(Ink.panel, 0.35);
    // At the panel's bottom: its rounded corners (a clip doesn't round).
    border-bottom-left-radius: Ink.radius-lg - 1px;
    border-bottom-right-radius: Ink.radius-lg - 1px;
    // As high as its content.
    preferred-height: 32px + body.preferred-height;

    VerticalLayout {
        spacing: 0px;

        // -- Image info · name, All metadata --
        HorizontalLayout {
            height: 32px;
            padding-left: Ink.pad-panel;
            padding-right: Ink.pad-panel;
            spacing: 8px;
            InkCaption {
                horizontal-stretch: 1;
                text: "IMAGE INFO · " + ImageMetaData.image_name;
                overflow: elide;
            }
            Text {
                text: root.all ? "Less ‹" : "All metadata ›";
                font-size: Ink.fs-secondary;
                color: all-ta.has-hover ? Ink.text : Ink.focus;
                vertical-alignment: center;
                all-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.all = !root.all;
                    }
                }
            }
        }

        // Short enough not to scroll, also with All metadata.
        Rectangle {
            vertical-stretch: 1;

            body := VerticalLayout {
                padding: Ink.pad-panel;
                padding-top: 0px;
                spacing: 6px;
                alignment: start;

                InkHint {
                    text: "Values from the file - change a wrong one; Reset brings back the file's.";
                }

                HorizontalLayout {
                    height: 22px;
                    spacing: 10px;
                    Key {
                        text: "Series";
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: ImageMetaData.nr_series > 1 ? "\{ChannelState.selected_series + 1} of \{ImageMetaData.nr_series} · \{ImageMetaData.size}" : ImageMetaData.size == "" ? "–" : ImageMetaData.size;
                        font-size: Ink.fs-secondary;
                        color: Ink.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // One size for X and Y (All metadata: each axis).
                if !root.all: HorizontalLayout {
                    spacing: 10px;
                    Key {
                        text: "Pixel size";
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        InkTextField {
                            width: root.field-w;
                            mono: true;
                            label: "Pixel size in nm";
                            value: ImageMetaData.pixel_size_x;
                            accepted(t) => {
                                ImageMetaData.pixel_size_changed(t.to-float(), t.to-float(), ImageMetaData.pixel_size_z);
                            }
                        }
                        Text {
                            text: "nm";
                            font-size: Ink.fs-secondary;
                            color: Ink.text-mute;
                            vertical-alignment: center;
                        }
                        InkButton {
                            small: true;
                            kind: InkButtonKind.quiet;
                            text: "Reset";
                            clicked => {
                                ImageMetaData.reset_pixel_sizes();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Key {
                        text: "Frame interval";
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        InkTextField {
                            width: root.field-w;
                            mono: true;
                            label: "Frame interval in seconds";
                            placeholder: "–";
                            value: ImageMetaData.frame_interval_text;
                            accepted(t) => {
                                ImageMetaData.frame_interval_changed(t.to-float());
                            }
                        }
                        Text {
                            text: "s";
                            font-size: Ink.fs-secondary;
                            color: Ink.text-mute;
                            vertical-alignment: center;
                        }
                        if ImageMetaData.frame_interval_overridden: InkButton {
                            small: true;
                            kind: InkButtonKind.quiet;
                            text: "Reset";
                            clicked => {
                                ImageMetaData.reset_frame_interval();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    height: 22px;
                    spacing: 10px;
                    Key {
                        text: "Z / T";
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: ImageMetaData.nr_z_stacks + (ImageMetaData.nr_z_stacks == 1 ? " slice · " : " slices · ") + ImageMetaData.nr_t_stacks + (ImageMetaData.nr_t_stacks == 1 ? " frame" : " frames");
                        font-size: Ink.fs-secondary;
                        color: Ink.text;
                        vertical-alignment: center;
                    }
                }

                // -- All metadata: the rest of the file's values --
                if root.all: VerticalLayout {
                    spacing: 6px;
                    for fact in [
                        { key: "Channels · Z · T", value: ImageMetaData.dimensions_str },
                        { key: "Pixel type", value: ImageMetaData.pixel_type + (ImageMetaData.is-rgb ? " · color" : "") },
                        { key: "Magnification", value: ImageMetaData.magnification },
                        { key: "File size", value: ImageMetaData.storage_size },
                    ]: HorizontalLayout {
                        height: 22px;
                        spacing: 10px;
                        Key {
                            text: fact.key;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: fact.value == "" ? "–" : fact.value;
                            font-size: Ink.fs-secondary;
                            font-family: Ink.font-mono;
                            color: fact.value == "" ? Ink.text-faint : Ink.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Key {
                            text: "Pixel size X Y Z";
                        }
                        px-x := InkTextField {
                            mono: true;
                            label: "Pixel size X in nm";
                            value: ImageMetaData.pixel_size_x;
                            accepted(t) => {
                                ImageMetaData.pixel_size_changed(t.to-float(), px-y.text.to-float(), px-z.text.to-float());
                            }
                        }
                        px-y := InkTextField {
                            mono: true;
                            label: "Pixel size Y in nm";
                            value: ImageMetaData.pixel_size_y;
                            accepted(t) => {
                                ImageMetaData.pixel_size_changed(px-x.text.to-float(), t.to-float(), px-z.text.to-float());
                            }
                        }
                        px-z := InkTextField {
                            mono: true;
                            label: "Pixel size Z in nm";
                            value: ImageMetaData.pixel_size_z;
                            accepted(t) => {
                                ImageMetaData.pixel_size_changed(px-x.text.to-float(), px-y.text.to-float(), t.to-float());
                            }
                        }
                    }
                }

                // -- Channels: color (from the emission wavelength); a click
                // on the color changes it --
                Key {
                    height: 22px;
                    text: "Channels";
                }

                FocusBanner { }

                for channel in ChannelState.channels: VerticalLayout {
                    spacing: 4px;

                    HorizontalLayout {
                        height: 24px;
                        spacing: 8px;

                        // A click on the color changes it (RGB images keep theirs).
                        swatch := Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            border-radius: 3px;
                            background: channel.color;
                            border-width: swatch-ta.has-hover || root.editing-channel == channel.idx ? 2px : 1px;
                            border-color: swatch-ta.has-hover || root.editing-channel == channel.idx ? Ink.focus : Ink.shadow.with-alpha(0.25);
                            accessible-role: button;
                            accessible-label: "Color of " + channel.name;
                            swatch-ta := TouchArea {
                                enabled: !ImageMetaData.is-rgb;
                                mouse-cursor: ImageMetaData.is-rgb ? default : pointer;
                                clicked => {
                                    root.editing-channel = root.editing-channel == channel.idx ? -1 : channel.idx;
                                }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: channel.name;
                            font-size: Ink.fs-body;
                            color: Ink.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if channel.wavelength_overridden: EditedTag { }
                        Text {
                            text: channel.emission_wave_length > 0 ? channel.emission_wave_length + " nm" : channel.wavelength_overridden ? "white" : "–";
                            font-size: Ink.fs-secondary;
                            font-family: Ink.font-mono;
                            color: channel.wavelength_overridden ? Ink.focus : channel.emission_wave_length > 0 ? Ink.text : Ink.text-faint;
                            vertical-alignment: center;
                        }
                    }

                    // Its color chooser.
                    if root.editing-channel == channel.idx: Rectangle {
                        height: chooser.preferred-height;
                        border-radius: Ink.radius-md;
                        background: Ink.raised;

                        chooser := VerticalLayout {
                            padding: 8px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: start;
                                for option in ImageMetaData.wavelength_options: WavelengthTile {
                                    option: option;
                                    selected: abs(option.nm - channel.emission_wave_length) < 0.5;
                                    picked(nm) => {
                                        ImageMetaData.emission_wave_length_changed(channel.idx, nm);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Emission (nm)";
                                    font-size: Ink.fs-secondary;
                                    color: Ink.text-dim;
                                    vertical-alignment: center;
                                }
                                InkTextField {
                                    mono: true;
                                    label: "Emission wavelength of " + channel.name + " in nm";
                                    value: channel.emission_wave_length > 0 ? channel.emission_wave_length : "";
                                    accepted(t) => {
                                        if t.is-float() {
                                            ImageMetaData.emission_wave_length_changed(channel.idx, t.to-float());
                                        }
                                    }
                                }
                                if channel.wavelength_overridden: InkButton {
                                    small: true;
                                    kind: InkButtonKind.quiet;
                                    text: "Reset";
                                    clicked => {
                                        ImageMetaData.reset_emission_wave_length(channel.idx);
                                    }
                                }
                                InkButton {
                                    small: true;
                                    text: "Done";
                                    clicked => {
                                        root.editing-channel = -1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
