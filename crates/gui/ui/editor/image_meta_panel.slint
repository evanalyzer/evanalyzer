// editor/image_meta_panel.slint — "Image info": what the file says about
// the open image. Pixel size, frame interval and the channels' wavelengths
// can be corrected right in place (Enter applies; for the whole project);
// Reset brings back the file's values.

import { ChannelState } from "../api/state.slint";
import { ImageMetaData, WavelengthOption } from "../api/image_meta.slint";
import { Ink, InkIcons, InkPanelHead, InkTextField, InkButton, InkButtonKind, InkCaption, InkHint, InkDivider } from "../ink/ink.slint";
import { FocusBanner } from "pipeline_focus.slint";

// "Key   value" - read only.
component Fact inherits Rectangle {
    in property <string> key;
    in property <string> value;

    height: 22px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            width: Ink.label-w;
            text: root.key;
            font-size: Ink.fs-sm;
            color: Ink.text-dim;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 1;
            text: root.value == "" ? "–" : root.value;
            font-size: Ink.fs-sm;
            font-family: Ink.font-mono;
            color: root.value == "" ? Ink.text-faint : Ink.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// "edited" - set for the project, not read from the file.
component EditedTag inherits Text {
    text: "edited";
    font-size: Ink.fs-xs;
    color: Ink.focus;
    vertical-alignment: center;
}

// A color tile of a channel's color chooser.
component WavelengthTile inherits Rectangle {
    in property <WavelengthOption> option;
    in property <bool> selected;
    callback picked(float);

    width: 18px;
    height: 18px;
    accessible-role: button;
    accessible-label: root.option.nm + " nm";
    accessible-checked: root.selected;

    face := Rectangle {
        background: root.option.color;
        border-radius: Ink.radius-xs;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? Ink.text : Ink.shadow.with-alpha(0.25);
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked(root.option.nm);
        }
    }
}

export component ImageMetaPanel inherits Rectangle {
    // The channel whose color chooser is open, -1 none.
    property <int> editing-channel: -1;

    VerticalLayout {
        spacing: 0px;

        InkPanelHead {
            title: "Image info";
            subtitle: ImageMetaData.image_name;
            closable: false;
        }

        Flickable {
            vertical-stretch: 1;
            content-height: body.preferred-height;

            body := VerticalLayout {
                padding: Ink.pad-panel;
                padding-top: 8px;
                spacing: 6px;
                alignment: start;

                InkHint {
                    text: "Values from the file - correct a wrong one (Enter); Reset brings back the file's.";
                }

                // -- The file --
                Fact {
                    key: "Series";
                    value: ImageMetaData.nr_series > 1
                        ? "\{ChannelState.selected_series + 1} of \{ImageMetaData.nr_series} · \{ImageMetaData.size}"
                        : ImageMetaData.size;
                }
                Fact {
                    key: "Channels · Z · T";
                    value: ImageMetaData.dimensions_str;
                }
                Fact {
                    key: "Pixel type";
                    value: ImageMetaData.pixel_type + (ImageMetaData.is-rgb ? " · color" : "");
                }
                Fact {
                    key: "Magnification";
                    value: ImageMetaData.magnification;
                }
                Fact {
                    key: "File size";
                    value: ImageMetaData.storage_size;
                }

                InkDivider { }

                // -- Calibration: pixel size X / Y / Z --
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        width: Ink.label-w;
                        text: "Pixel size (nm)";
                        font-size: Ink.fs-sm;
                        color: Ink.text-dim;
                        vertical-alignment: center;
                    }
                    px-x := InkTextField {
                        mono: true;
                        label: "Pixel size X in nm";
                        value: ImageMetaData.pixel_size_x;
                        accepted(t) => {
                            ImageMetaData.pixel_size_changed(t.to-float(), px-y.text.to-float(), px-z.text.to-float());
                        }
                    }
                    px-y := InkTextField {
                        mono: true;
                        label: "Pixel size Y in nm";
                        value: ImageMetaData.pixel_size_y;
                        accepted(t) => {
                            ImageMetaData.pixel_size_changed(px-x.text.to-float(), t.to-float(), px-z.text.to-float());
                        }
                    }
                    px-z := InkTextField {
                        mono: true;
                        label: "Pixel size Z in nm";
                        value: ImageMetaData.pixel_size_z;
                        accepted(t) => {
                            ImageMetaData.pixel_size_changed(px-x.text.to-float(), px-y.text.to-float(), t.to-float());
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    InkButton {
                        small: true;
                        kind: InkButtonKind.quiet;
                        text: "Reset pixel size";
                        clicked => {
                            ImageMetaData.reset_pixel_sizes();
                        }
                    }
                }

                // -- Time --
                if ImageMetaData.nr_t_stacks > 1 || ImageMetaData.frame_interval_text != "": HorizontalLayout {
                    spacing: 6px;
                    Text {
                        width: Ink.label-w;
                        text: "Frame interval (s)";
                        font-size: Ink.fs-sm;
                        color: Ink.text-dim;
                        vertical-alignment: center;
                    }
                    InkTextField {
                        mono: true;
                        label: "Frame interval in seconds";
                        placeholder: "not in the file";
                        value: ImageMetaData.frame_interval_text;
                        accepted(t) => {
                            ImageMetaData.frame_interval_changed(t.to-float());
                        }
                    }
                    if ImageMetaData.frame_interval_overridden: InkButton {
                        small: true;
                        kind: InkButtonKind.quiet;
                        text: "Reset";
                        clicked => {
                            ImageMetaData.reset_frame_interval();
                        }
                    }
                }

                InkDivider { }

                // -- Channels: color (from the emission wavelength) --
                InkCaption {
                    text: "CHANNELS";
                }

                FocusBanner { }

                for channel in ChannelState.channels: VerticalLayout {
                    spacing: 4px;

                    HorizontalLayout {
                        height: 24px;
                        spacing: 8px;

                        // A click on the color changes it (RGB images keep theirs).
                        swatch := Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            border-radius: 3px;
                            background: channel.color;
                            border-width: swatch-ta.has-hover || root.editing-channel == channel.idx ? 2px : 1px;
                            border-color: swatch-ta.has-hover || root.editing-channel == channel.idx ? Ink.focus : Ink.shadow.with-alpha(0.25);
                            accessible-role: button;
                            accessible-label: "Color of " + channel.name;
                            swatch-ta := TouchArea {
                                enabled: !ImageMetaData.is-rgb;
                                mouse-cursor: ImageMetaData.is-rgb ? default : pointer;
                                clicked => {
                                    root.editing-channel = root.editing-channel == channel.idx ? -1 : channel.idx;
                                }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: channel.name;
                            font-size: Ink.fs-md;
                            color: Ink.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if channel.wavelength_overridden: EditedTag { }
                        Text {
                            text: channel.emission_wave_length > 0 ? channel.emission_wave_length + " nm" : "–";
                            font-size: Ink.fs-sm;
                            font-family: Ink.font-mono;
                            color: channel.wavelength_overridden ? Ink.focus : channel.emission_wave_length > 0 ? Ink.text : Ink.text-faint;
                            vertical-alignment: center;
                        }
                    }

                    // Its color chooser.
                    if root.editing-channel == channel.idx: Rectangle {
                        height: chooser.preferred-height;
                        border-radius: Ink.radius-md;
                        background: Ink.raised;

                        chooser := VerticalLayout {
                            padding: 8px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: start;
                                for option in ImageMetaData.wavelength_options: WavelengthTile {
                                    option: option;
                                    selected: abs(option.nm - channel.emission_wave_length) < 0.5;
                                    picked(nm) => {
                                        ImageMetaData.emission_wave_length_changed(channel.idx, nm);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Emission (nm)";
                                    font-size: Ink.fs-sm;
                                    color: Ink.text-dim;
                                    vertical-alignment: center;
                                }
                                InkTextField {
                                    mono: true;
                                    label: "Emission wavelength of " + channel.name + " in nm";
                                    value: channel.emission_wave_length > 0 ? channel.emission_wave_length : "";
                                    accepted(t) => {
                                        if t.is-float() {
                                            ImageMetaData.emission_wave_length_changed(channel.idx, t.to-float());
                                        }
                                    }
                                }
                                if channel.wavelength_overridden: InkButton {
                                    small: true;
                                    kind: InkButtonKind.quiet;
                                    text: "Reset";
                                    clicked => {
                                        ImageMetaData.reset_emission_wave_length(channel.idx);
                                    }
                                }
                                InkButton {
                                    small: true;
                                    text: "Done";
                                    clicked => {
                                        root.editing-channel = -1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
