// editor/image_meta_panel.slint — "Image info" (design I3): what the file
// says about the open image, in parts that fold - Image, Calibration,
// Channels, Objective, Position, Description; a part the file has nothing
// for is left out. Pixel size X / Y / Z, the frame interval and the
// channels' emission can be corrected in place (Enter applies; for the
// whole project); Reset brings back the file's values. The rest of the
// file's own metadata: "Format metadata ↗" (a dialog).

import { ChannelState } from "../api/state.slint";
import { LayoutState } from "../api/layout.slint";
import { ScrollView, ListView } from "std-widgets.slint";
import { ImageMetaData, WavelengthOption, ChannelAcq } from "../api/image_meta.slint";
import { Ink, InkIcons, InkTextField, InkButton, InkButtonKind, InkCaption, InkHint, InkTipZone, InkDialog, InkSearchField, InkBusy } from "../ink/ink.slint";

// A color tile of a channel's color chooser.
component WavelengthTile inherits Rectangle {
    in property <WavelengthOption> option;
    in property <bool> selected;
    callback picked(float);

    width: 18px;
    height: 18px;
    accessible-role: button;
    accessible-label: root.option.nm > 0 ? root.option.nm + " nm" : "White";
    accessible-checked: root.selected;

    face := Rectangle {
        background: root.option.color;
        border-radius: Ink.radius-xs;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? Ink.text : Ink.shadow.with-alpha(0.25);
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked(root.option.nm);
        }
    }
}

// A label of the info's form.
component Key inherits Text {
    width: 96px;
    font-size: Ink.fs-secondary;
    color: Ink.text-dim;
    vertical-alignment: center;
    overflow: elide;
}

// A part's head: ▾ / ▸ and its name; folded, a short summary at the right.
component InfoPart inherits Rectangle {
    in property <string> title;
    in property <string> summary;
    in-out property <bool> open;

    height: 30px;
    accessible-role: button;
    accessible-label: root.title;
    accessible-expanded: root.open;
    accessible-action-default => {
        root.open = !root.open;
    }
    Rectangle {
        y: 0px;
        height: 1px;
        background: Ink.border-soft;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.open = !root.open;
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: Ink.pad-panel;
        spacing: 6px;
        Image {
            y: (parent.height - self.height) / 2;
            source: root.open ? InkIcons.caret-down : InkIcons.caret-right;
            width: 9px;
            height: 9px;
            colorize: Ink.text-mute;
        }
        Text {
            text: root.title;
            font-size: Ink.fs-secondary;
            font-weight: 600;
            color: ta.has-hover ? Ink.text : Ink.text;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.open ? "" : root.summary;
            font-size: Ink.fs-caption;
            font-family: Ink.font-mono;
            color: Ink.text-mute;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A value of the file: its name and the value (left out while empty).
component InfoRow inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    in property <bool> mono: true;
    height: 22px;
    padding-left: 28px;
    padding-right: Ink.pad-panel;
    spacing: 10px;
    Key {
        text: root.key;
    }
    v := Text {
        horizontal-stretch: 1;
        text: root.value;
        font-size: Ink.fs-secondary;
        font-family: root.mono ? Ink.font-mono : Ink.font-sans;
        color: Ink.text;
        vertical-alignment: center;
        overflow: elide;
        InkTipZone {
            width: 100%;
            height: 100%;
            wanted: tip-ta.has-hover && v.preferred-width > v.width + 0.5px;
            text: root.value;
        }
        tip-ta := TouchArea { }
    }
}

export component ImageMetaPanel inherits Rectangle {
    // The channel tile picked (its acquisition and colour chooser below
    // the tiles), -1 none - an index into `ChannelState.channels`.
    property <int> picked: -1;
    // Which parts are open (for the session).
    property <bool> part-image: true;
    property <bool> part-calib: true;
    property <bool> part-channels: true;
    property <bool> part-objective: false;
    property <bool> part-position: false;
    property <bool> part-description: false;
    property <bool> has-objective: ImageMetaData.objective_model != "" || ImageMetaData.objective_magnification != "" || ImageMetaData.objective_na != "" || ImageMetaData.objective_immersion != "";
    property <string> objective-summary: ImageMetaData.objective_magnification
        + (ImageMetaData.objective_na != "" ? (ImageMetaData.objective_magnification != "" ? " · " : "") + "NA " + ImageMetaData.objective_na : "")
        + (ImageMetaData.objective_immersion != "" ? " · " + ImageMetaData.objective_immersion.to-lowercase() : "");
    property <string> folded-summary: (ImageMetaData.size == "" ? "" : ImageMetaData.size.replace-all(" px", "") + " · ")
        + ChannelState.channels.length + " ch"
        + (ImageMetaData.pixel_size_x > 0 ? " · " + round(ImageMetaData.pixel_size_x * 10) / 10 + " nm" : "")
        + (ImageMetaData.objective_magnification != "" ? " · " + ImageMetaData.objective_magnification : "");
    property <length> tile-h: 28px;
    property <length> tile-gap: 4px;
    property <ChannelAcq> acq: root.picked >= 0 && root.picked < ImageMetaData.channel_acq.length ? ImageMetaData.channel_acq[root.picked] : { fluor: "" };

    background: Ink.ground.mix(Ink.panel, 0.35);
    // At the panel's bottom: its rounded corners (a clip doesn't round).
    border-bottom-left-radius: Ink.radius-lg - 1px;
    border-bottom-right-radius: Ink.radius-lg - 1px;
    // As high as its content; short of room, the parts scroll.
    preferred-height: LayoutState.image-info-folded ? 36px : 36px + body.preferred-height;
    min-height: LayoutState.image-info-folded ? 36px : 36px + min(body.preferred-height, 160px);

    VerticalLayout {
        spacing: 0px;

        // -- Image info (a click folds it; folded: a summary), the
        // file's own metadata --
        HorizontalLayout {
            height: 36px;
            padding-left: 10px;
            padding-right: Ink.pad-panel;
            spacing: 6px;
            accessible-role: button;
            accessible-label: "Image info";
            accessible-expanded: !LayoutState.image-info-folded;
            Image {
                y: (parent.height - self.height) / 2;
                source: LayoutState.image-info-folded ? InkIcons.caret-right : InkIcons.caret-down;
                width: 10px;
                height: 10px;
                colorize: Ink.text-mute;
            }
            Text {
                text: "Image info";
                font-size: Ink.fs-body;
                font-weight: 600;
                color: Ink.text;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        LayoutState.image-info-folded = !LayoutState.image-info-folded;
                    }
                }
            }
            Text {
                horizontal-stretch: 1;
                text: LayoutState.image-info-folded ? root.folded-summary : "";
                font-size: Ink.fs-caption;
                font-family: Ink.font-mono;
                color: Ink.text-mute;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
            if !LayoutState.image-info-folded: Text {
                text: "Format metadata ↗";
                font-size: Ink.fs-secondary;
                color: fm-ta.has-hover ? Ink.text : Ink.focus;
                vertical-alignment: center;
                accessible-role: button;
                accessible-label: "Format metadata";
                fm-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ImageMetaData.format_meta_open = true;
                        ImageMetaData.format_meta_requested();
                    }
                }
            }
        }

        ScrollView {
            vertical-stretch: LayoutState.image-info-folded ? 0 : 1;
            max-height: LayoutState.image-info-folded ? 0px : 100000px;
            visible: !LayoutState.image-info-folded;

            body := VerticalLayout {
                padding-bottom: 10px;
                spacing: 0px;
                alignment: start;

                // -- Image: the file's facts --
                InfoPart {
                    title: "Image";
                    summary: ImageMetaData.size;
                    open <=> root.part-image;
                }
                if root.part-image: VerticalLayout {
                    padding-bottom: 6px;
                    InfoRow {
                        key: "Name";
                        value: ImageMetaData.image_name;
                        mono: false;
                    }
                    if ImageMetaData.nr_series > 1 || ImageMetaData.series_name != "": InfoRow {
                        key: "Series";
                        value: (ImageMetaData.nr_series > 1 ? "\{ChannelState.selected_series + 1} of \{ImageMetaData.nr_series}" : "")
                            + (ImageMetaData.nr_series > 1 && ImageMetaData.series_name != "" ? " · " : "") + ImageMetaData.series_name;
                    }
                    InfoRow {
                        key: "Size";
                        value: ImageMetaData.size;
                    }
                    InfoRow {
                        key: "C · Z · T";
                        value: "\{ImageMetaData.nr_c_stacks} · \{ImageMetaData.nr_z_stacks} · \{ImageMetaData.nr_t_stacks}";
                    }
                    InfoRow {
                        key: "Pixel type";
                        value: ImageMetaData.pixel_type + (ImageMetaData.is-rgb ? " · colour" : "");
                    }
                    if ImageMetaData.levels != "": InfoRow {
                        key: "Levels";
                        value: ImageMetaData.levels;
                    }
                    if ImageMetaData.acquired != "": InfoRow {
                        key: "Acquired";
                        value: ImageMetaData.acquired;
                    }
                    if ImageMetaData.storage_size != "": InfoRow {
                        key: "Data size";
                        value: ImageMetaData.storage_size;
                    }
                }

                // -- Calibration: what a user corrects --
                InfoPart {
                    title: "Calibration";
                    summary: round(ImageMetaData.pixel_size_x * 10) / 10 + " × " + round(ImageMetaData.pixel_size_y * 10) / 10 + " × " + (ImageMetaData.pixel_size_z > 0 ? round(ImageMetaData.pixel_size_z * 10) / 10 : "–") + " nm";
                    open <=> root.part-calib;
                }
                if root.part-calib: VerticalLayout {
                    padding-left: 28px;
                    padding-right: Ink.pad-panel;
                    padding-bottom: 8px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        Key {
                            width: 70px;
                            text: "Pixel size";
                        }
                        px-x := InkTextField {
                            mono: true;
                            suffix: "nm";
                            label: "Pixel size X in nm";
                            placeholder: "X";
                            value: ImageMetaData.pixel_size_x;
                            accepted(t) => {
                                ImageMetaData.pixel_size_changed(t.to-float(), px-y.text.to-float(), px-z.text.to-float());
                            }
                        }
                        px-y := InkTextField {
                            mono: true;
                            suffix: "nm";
                            label: "Pixel size Y in nm";
                            placeholder: "Y";
                            value: ImageMetaData.pixel_size_y;
                            accepted(t) => {
                                ImageMetaData.pixel_size_changed(px-x.text.to-float(), t.to-float(), px-z.text.to-float());
                            }
                        }
                        px-z := InkTextField {
                            mono: true;
                            suffix: "nm";
                            label: "Pixel size Z in nm";
                            placeholder: "Z –";
                            value: ImageMetaData.pixel_size_z > 0 ? ImageMetaData.pixel_size_z : "";
                            accepted(t) => {
                                ImageMetaData.pixel_size_changed(px-x.text.to-float(), px-y.text.to-float(), t.to-float());
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 70px;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "X · Y · Z";
                            font-size: Ink.fs-caption;
                            color: Ink.text-faint;
                            vertical-alignment: center;
                        }
                        InkButton {
                            small: true;
                            kind: InkButtonKind.quiet;
                            text: "Reset pixel size";
                            clicked => {
                                ImageMetaData.reset_pixel_sizes();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Key {
                            width: 70px;
                            text: "Interval";
                        }
                        InkTextField {
                            horizontal-stretch: 0;
                            width: 96px;
                            mono: true;
                            suffix: "s";
                            label: "Frame interval in seconds";
                            placeholder: "–";
                            edited-mark: ImageMetaData.frame_interval_overridden;
                            value: ImageMetaData.frame_interval_text;
                            accepted(t) => {
                                ImageMetaData.frame_interval_changed(t.to-float());
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        if ImageMetaData.frame_interval_overridden: InkButton {
                            small: true;
                            kind: InkButtonKind.quiet;
                            text: "Reset";
                            clicked => {
                                ImageMetaData.reset_frame_interval();
                            }
                        }
                    }
                }

                // -- Channels: tiles (name, emission); the picked one's
                // acquisition and colour below --
                InfoPart {
                    title: "Channels";
                    summary: ChannelState.channels.length;
                    open <=> root.part-channels;
                }
                if root.part-channels: VerticalLayout {
                    padding-left: 28px;
                    padding-right: Ink.pad-panel;
                    padding-bottom: 8px;
                    spacing: 6px;
                    tiles := Rectangle {
                        height: ceil(ChannelState.channels.length / 2) * (root.tile-h + root.tile-gap);
                        for channel[i] in ChannelState.channels: Rectangle {
                            x: mod(i, 2) * (tiles.width + root.tile-gap) / 2;
                            y: floor(i / 2) * (root.tile-h + root.tile-gap);
                            width: (tiles.width - root.tile-gap) / 2;
                            height: root.tile-h;
                            border-radius: Ink.radius-sm;
                            background: root.picked == i ? Ink.panel : tile-ta.has-hover ? Ink.hover : Ink.raised;
                            border-width: root.picked == i ? 1.5px : 0px;
                            border-color: Ink.focus;
                            accessible-role: button;
                            accessible-label: channel.name + (channel.emission_wave_length > 0 ? ", " + channel.emission_wave_length + " nm" : "");
                            tile-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.picked = root.picked == i ? -1 : i;
                                }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 3px;
                                    background: channel.color;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: channel.name;
                                    font-size: Ink.fs-secondary;
                                    color: Ink.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: channel.emission_wave_length > 0 ? round(channel.emission_wave_length) : channel.wavelength_overridden ? "white" : "–";
                                    font-size: Ink.fs-caption;
                                    font-family: Ink.font-mono;
                                    color: channel.wavelength_overridden ? Ink.focus : Ink.text-dim;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // The picked channel: its acquisition, its emission and
                    // colour.
                    if root.picked >= 0 && root.picked < ChannelState.channels.length: Rectangle {
                        border-radius: Ink.radius-md;
                        background: Ink.raised;
                        border-width: 1px;
                        border-color: Ink.border-soft;
                        VerticalLayout {
                            padding: 8px;
                            padding-left: 10px;
                            spacing: 2px;
                            HorizontalLayout {
                                height: 22px;
                                spacing: 6px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 3px;
                                    background: ChannelState.channels[root.picked].color;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: ChannelState.channels[root.picked].name;
                                    font-size: Ink.fs-secondary;
                                    font-weight: 600;
                                    color: Ink.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.acq.contrast;
                                    font-size: Ink.fs-caption;
                                    color: Ink.text-mute;
                                    vertical-alignment: center;
                                }
                            }
                            for f in [
                                { key: "Fluorophore", value: root.acq.fluor },
                                { key: "Excitation", value: root.acq.excitation },
                                { key: "Exposure", value: root.acq.exposure },
                                { key: "Gain", value: root.acq.gain },
                                { key: "Binning", value: root.acq.binning },
                                { key: "Pinhole", value: root.acq.pinhole },
                            ]: HorizontalLayout {
                                height: f.value == "" ? 0px : 20px;
                                visible: f.value != "";
                                spacing: 8px;
                                Text {
                                    width: 78px;
                                    text: f.key;
                                    font-size: Ink.fs-secondary;
                                    color: Ink.text-dim;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: f.value;
                                    font-size: Ink.fs-secondary;
                                    font-family: Ink.font-mono;
                                    color: Ink.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                padding-top: 2px;
                                Text {
                                    width: 78px;
                                    text: "Emission";
                                    font-size: Ink.fs-secondary;
                                    color: Ink.text-dim;
                                    vertical-alignment: center;
                                }
                                InkTextField {
                                    horizontal-stretch: 0;
                                    width: 90px;
                                    mono: true;
                                    suffix: "nm";
                                    label: "Emission wavelength of " + ChannelState.channels[root.picked].name + " in nm";
                                    edited-mark: ChannelState.channels[root.picked].wavelength_overridden;
                                    value: ChannelState.channels[root.picked].emission_wave_length > 0 ? ChannelState.channels[root.picked].emission_wave_length : "";
                                    accepted(t) => {
                                        if t.is-float() {
                                            ImageMetaData.emission_wave_length_changed(ChannelState.channels[root.picked].idx, t.to-float());
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                                if ChannelState.channels[root.picked].wavelength_overridden: InkButton {
                                    small: true;
                                    kind: InkButtonKind.quiet;
                                    text: "Reset";
                                    clicked => {
                                        ImageMetaData.reset_emission_wave_length(ChannelState.channels[root.picked].idx);
                                    }
                                }
                            }
                            // Its colour: a tile per wavelength (RGB images
                            // keep theirs).
                            if !ImageMetaData.is-rgb: HorizontalLayout {
                                padding-top: 4px;
                                spacing: 4px;
                                alignment: start;
                                for option in ImageMetaData.wavelength_options: WavelengthTile {
                                    option: option;
                                    selected: abs(option.nm - ChannelState.channels[root.picked].emission_wave_length) < 0.5;
                                    picked(nm) => {
                                        ImageMetaData.emission_wave_length_changed(ChannelState.channels[root.picked].idx, nm);
                                    }
                                }
                            }
                        }
                    }
                }

                // -- Objective, Position, Description: folded, a summary --
                if root.has-objective: InfoPart {
                    title: "Objective";
                    summary: root.objective-summary;
                    open <=> root.part-objective;
                }
                if root.has-objective && root.part-objective: VerticalLayout {
                    padding-bottom: 6px;
                    if ImageMetaData.objective_model != "": InfoRow {
                        key: "Model";
                        value: ImageMetaData.objective_model;
                        mono: false;
                    }
                    if ImageMetaData.objective_magnification != "": InfoRow {
                        key: "Magnification";
                        value: ImageMetaData.objective_magnification;
                    }
                    if ImageMetaData.objective_na != "": InfoRow {
                        key: "NA";
                        value: ImageMetaData.objective_na;
                    }
                    if ImageMetaData.objective_immersion != "": InfoRow {
                        key: "Immersion";
                        value: ImageMetaData.objective_immersion;
                        mono: false;
                    }
                }

                if ImageMetaData.stage_position != "": InfoPart {
                    title: "Position";
                    summary: "stage " + ImageMetaData.stage_position;
                    open <=> root.part-position;
                }
                if ImageMetaData.stage_position != "" && root.part-position: VerticalLayout {
                    padding-bottom: 6px;
                    InfoRow {
                        key: "Stage";
                        value: ImageMetaData.stage_position;
                    }
                }

                if ImageMetaData.description != "": InfoPart {
                    title: "Description";
                    summary: ImageMetaData.description;
                    open <=> root.part-description;
                }
                if ImageMetaData.description != "" && root.part-description: HorizontalLayout {
                    padding-left: 28px;
                    padding-right: Ink.pad-panel;
                    padding-bottom: 6px;
                    Text {
                        text: ImageMetaData.description;
                        font-size: Ink.fs-secondary;
                        color: Ink.text;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// Image info › Format metadata: everything else the file says (camera,
// filters, light source …) - read on opening, searchable.
export component FormatMetaDialog inherits InkDialog {
    title: "Format metadata";
    subtitle: ImageMetaData.image_name;
    card-width: 680px;
    card-height: min(Ink.window-height - 120px, 640px);
    close-on-backdrop: true;
    close => {
        ImageMetaData.format_meta_open = false;
        ImageMetaData.format_meta_query = "";
    }

    VerticalLayout {
        spacing: 8px;
        InkSearchField {
            placeholder: "Search keys and values";
            text: ImageMetaData.format_meta_query;
            edited(t) => {
                ImageMetaData.format_meta_query = t;
                ImageMetaData.format_meta_query_changed(t);
            }
        }
        HorizontalLayout {
            height: 20px;
            spacing: 8px;
            Text {
                width: 260px;
                text: "KEY";
                font-size: Ink.fs-caption;
                font-weight: 600;
                letter-spacing: 0.6px;
                color: Ink.text-mute;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: "VALUE";
                font-size: Ink.fs-caption;
                font-weight: 600;
                letter-spacing: 0.6px;
                color: Ink.text-mute;
                vertical-alignment: center;
            }
            Text {
                text: ImageMetaData.format_meta.length + (ImageMetaData.format_meta.length == 1 ? " key" : " keys");
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
                vertical-alignment: center;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            ListView {
                for pair in ImageMetaData.format_meta: HorizontalLayout {
                    height: 22px;
                    spacing: 8px;
                    k := Text {
                        width: 260px;
                        text: pair.key;
                        font-size: Ink.fs-secondary;
                        font-family: Ink.font-mono;
                        color: Ink.text-dim;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: pair.value;
                        font-size: Ink.fs-secondary;
                        font-family: Ink.font-mono;
                        color: Ink.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            if ImageMetaData.format_meta_loading: InkBusy {
                size: 20px;
            }
            if !ImageMetaData.format_meta_loading && ImageMetaData.format_meta_error != "": InkHint {
                text: ImageMetaData.format_meta_error;
            }
            if !ImageMetaData.format_meta_loading && ImageMetaData.format_meta_error == "" && ImageMetaData.format_meta.length == 0: InkHint {
                text: ImageMetaData.format_meta_query == "" ? "The file has no further metadata." : "Nothing matches the search.";
            }
        }
    }
}
