// editor/viewport_stack_bar.slint — the bar at the bottom of the image: the
// objects on / off (O) and their opacity; for a z-stack the projection or
// slice, for a time series the frame and its playback. ◂ folds it to a pill
// that still shows them; the objects toggle and the keys work folded too.

import { ChannelState, IntensityProjection } from "../api/state.slint";
import { ViewportState } from "../api/viewport.slint";
import { ViewportObjectState } from "../api/viewport.slint";
import { ImageMetaData } from "../api/image_meta.slint";
import { LayoutState } from "../api/layout.slint";
import { Ink, InkIcons, InkIconButton, InkSelect, InkCaption, InkTipZone } from "../ink/ink.slint";

// One step through the slices or the frames: the bar's ◀ ▶ and the keys.
export global StackSteps {
    public function step-z(d: int) {
        if ImageMetaData.nr_z_stacks > 1 && (ChannelState.intensity_projection == IntensityProjection.single-stack || ChannelState.intensity_projection == IntensityProjection.volume) {
            StackSteps.set-z(ChannelState.selected_z_stack + d);
        }
    }
    public function step-t(d: int) {
        if ImageMetaData.nr_t_stacks > 1 {
            StackSteps.set-t(ChannelState.selected_t_stack + d);
        }
    }
    public function set-z(z: int) {
        let v = clamp(z, 0, ImageMetaData.nr_z_stacks - 1);
        if v != ChannelState.selected_z_stack {
            ChannelState.selected_z_stack = v;
            ChannelState.trigger_channel_state_changed();
        }
    }
    public function set-t(t: int) {
        let v = clamp(t, 0, ImageMetaData.nr_t_stacks - 1);
        if v != ChannelState.selected_t_stack {
            ChannelState.selected_t_stack = v;
            ChannelState.trigger_channel_state_changed();
        }
    }
}

// Where in the stack: a track with a knob; a click or a drag picks the
// plane.
component StackTrack inherits Rectangle {
    in property <int> value;
    in property <int> count;
    in property <string> label;
    /// Read out after the value ("80 %"); "" - "n of count".
    in property <string> unit;
    callback picked(int);

    property <float> at: root.count > 1 ? root.value / (root.count - 1) : 0;

    min-width: 48px;
    preferred-width: 150px;
    horizontal-stretch: 1;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.unit != "" ? root.value + root.unit : "\{root.value + 1} of \{root.count}";
    accessible-value-minimum: 1;
    accessible-value-maximum: root.count;
    accessible-action-increment => {
        root.picked(root.value + 1);
    }
    accessible-action-decrement => {
        root.picked(root.value - 1);
    }

    function pick-at(x: length) {
        root.picked(round(clamp(x / root.width, 0, 1) * (root.count - 1)));
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Ink.border;
    }
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: root.at * root.width;
        height: 4px;
        border-radius: 2px;
        background: Ink.focus;
    }
    Rectangle {
        x: root.at * (root.width - self.width);
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Ink.glass;
        border-width: 2px;
        border-color: Ink.focus;
    }

    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.pick-at(self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.pick-at(self.mouse-x);
            }
        }
    }
}

// "12 / 40": the plane, mono, centered.
component PlaneText inherits Text {
    font-family: Ink.font-mono;
    font-size: Ink.fs-body;
    color: Ink.text;
    horizontal-alignment: center;
    vertical-alignment: center;
    min-width: 56px;
}


export global OverlaySet {
    public function opacity(percent: int) {
        ViewportObjectState.object_transparency = clamp(percent, 0, 100) / 100;
        ViewportObjectState.object_transparency_changed(ViewportObjectState.object_transparency);
    }
    public function toggle() {
        ViewportObjectState.show_objects = !ViewportObjectState.show_objects;
    }
}

// The objects on / off: highlighted while on.
component ObjectsToggle inherits Rectangle {
    width: 26px;
    height: 26px;
    border-radius: Ink.radius-md;
    background: ViewportObjectState.show_objects ? Ink.info-tint : transparent;
    InkIconButton {
        size: 26px;
        icon: InkIcons.overlay;
        tint: ViewportObjectState.show_objects ? Ink.focus : Ink.text-dim;
        label: ViewportObjectState.show_objects ? "Hide the objects" : "Show the objects";
        keys: ["O"];
        clicked => {
            OverlaySet.toggle();
        }
    }
}

component Sep inherits Rectangle {
    width: 1px;
    background: Ink.border;
}

export component StackBar inherits Rectangle {
    // The width there is next to the navigator; the tracks give way.
    in property <length> room: 10000px;
    property <bool> has-z: ImageMetaData.nr_z_stacks > 1;
    property <bool> has-t: ImageMetaData.nr_t_stacks > 1;
    // One slice shown: a single plane, or a volume (3D) slice by slice.
    property <bool> slice: ChannelState.intensity_projection == IntensityProjection.single-stack || ChannelState.intensity_projection == IntensityProjection.volume;
    property <[string]> fps-names: ["1 fps", "2 fps", "5 fps", "10 fps", "20 fps", "25 fps"];
    property <[int]> fps-values: [1, 2, 5, 10, 20, 25];
    property <string> z-text: root.slice ? "\{ChannelState.selected_z_stack + 1} / \{ImageMetaData.nr_z_stacks}" : "all \{ImageMetaData.nr_z_stacks}";
    property <string> t-text: "\{ChannelState.selected_t_stack + 1} / \{ImageMetaData.nr_t_stacks}";
    property <int> percent: round(ViewportObjectState.object_transparency * 100);
    property <bool> folded: LayoutState.stack-bar-folded;

    pure function fps-index(hz: int) -> int {
        hz >= 25 ? 5 : hz >= 20 ? 4 : hz >= 10 ? 3 : hz >= 5 ? 2 : hz >= 2 ? 1 : 0
    }

    function projection(p: IntensityProjection) {
        ChannelState.intensity_projection = p;
        ChannelState.trigger_channel_state_changed();
    }

    function fold(on: bool) {
        LayoutState.stack-bar-folded = on;
        LayoutState.panels-changed();
    }

    // With an image open - a 2D one shows only the objects' part.
    visible: ImageMetaData.image_name != "";
    height: 40px;
    width: root.folded ? pill.preferred-width : min(bar.preferred-width, root.room);
    background: Ink.glass;
    border-radius: Ink.radius-lg;
    border-width: 1px;
    border-color: Ink.border;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Ink.shadow;
    clip: true;
    accessible-role: groupbox;
    accessible-label: "Objects, Z and T";

    // Clicks on the bar don't reach the image below.
    TouchArea { }

    // -- Folded: the objects toggle, the opacity, the planes, ▸ --
    pill := HorizontalLayout {
        visible: root.folded;
        padding-left: 6px;
        padding-right: 4px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 8px;
        ObjectsToggle { }
        PlaneText {
            text: root.percent + " %";
            min-width: 0px;
            color: ViewportObjectState.show_objects ? Ink.text : Ink.text-mute;
        }
        if root.has-z: Sep { }
        if root.has-z: InkCaption {
            text: "Z";
        }
        if root.has-z: PlaneText {
            text: root.z-text;
            min-width: 0px;
        }
        if root.has-t: Sep { }
        if root.has-t: InkCaption {
            text: "T";
        }
        if root.has-t: PlaneText {
            text: root.t-text;
            min-width: 0px;
        }
        InkIconButton {
            size: 26px;
            icon: InkIcons.caret-right;
            label: "Unfold the bar";
            clicked => {
                root.fold(false);
            }
        }
    }

    // -- Open --
    bar := HorizontalLayout {
        visible: !root.folded;
        padding-left: 4px;
        padding-right: 8px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 8px;

        InkIconButton {
            size: 26px;
            icon: InkIcons.caret-left;
            label: "Fold the bar";
            clicked => {
                root.fold(true);
            }
        }

        // -- Objects: on / off, opacity (dimmed while off, still set) --
        ObjectsToggle { }
        StackTrack {
            min-width: 48px;
            preferred-width: 64px;
            horizontal-stretch: 0;
            opacity: ViewportObjectState.show_objects ? 1 : 0.4;
            label: "Objects' opacity";
            value: root.percent;
            count: 101;
            unit: " %";
            picked(v) => {
                OverlaySet.opacity(v);
            }
        }
        PlaneText {
            text: root.percent + " %";
            min-width: 34px;
            horizontal-alignment: left;
            color: ViewportObjectState.show_objects ? Ink.text : Ink.text-mute;
        }

        // -- Z --
        if root.has-z: Sep { }
        if root.has-z: InkCaption {
            text: "Z";
        }
        if root.has-z: InkSelect {
            width: 76px;
            height: 26px;
            horizontal-stretch: 0;
            label: "Z projection";
            model: ["Slice", "Max", "Min", "Avg", "Sum", "Mid", "3D"];
            selected: ChannelState.intensity_projection == IntensityProjection.max ? 1
                : ChannelState.intensity_projection == IntensityProjection.min ? 2
                : ChannelState.intensity_projection == IntensityProjection.avg ? 3
                : ChannelState.intensity_projection == IntensityProjection.sum ? 4
                : ChannelState.intensity_projection == IntensityProjection.middle ? 5
                : ChannelState.intensity_projection == IntensityProjection.volume ? 6
                : 0;
            picked(i) => {
                root.projection(i == 1 ? IntensityProjection.max
                    : i == 2 ? IntensityProjection.min
                    : i == 3 ? IntensityProjection.avg
                    : i == 4 ? IntensityProjection.sum
                    : i == 5 ? IntensityProjection.middle
                    : i == 6 ? IntensityProjection.volume
                    : IntensityProjection.single-stack);
            }
        }
        // A projection: every slice, nothing to step.
        if root.has-z && !root.slice: Text {
            text: "all \{ImageMetaData.nr_z_stacks} slices";
            font-family: Ink.font-mono;
            font-size: Ink.fs-secondary;
            color: Ink.text-mute;
            vertical-alignment: center;
        }
        if root.has-z && root.slice: InkIconButton {
            size: 26px;
            icon: InkIcons.caret-left;
            label: "Previous slice";
            keys: ["Page Up"];
            enabled: ChannelState.selected_z_stack > 0;
            disabled-reason: "The first slice";
            clicked => {
                StackSteps.step-z(-1);
            }
        }
        if root.has-z && root.slice: PlaneText {
            text: root.z-text;
        }
        if root.has-z && root.slice: InkIconButton {
            size: 26px;
            icon: InkIcons.caret-right;
            label: "Next slice";
            keys: ["Page Down"];
            enabled: ChannelState.selected_z_stack < ImageMetaData.nr_z_stacks - 1;
            disabled-reason: "The last slice";
            clicked => {
                StackSteps.step-z(1);
            }
        }
        if root.has-z && root.slice: StackTrack {
            label: "Z slice";
            value: ChannelState.selected_z_stack;
            count: ImageMetaData.nr_z_stacks;
            picked(z) => {
                StackSteps.set-z(z);
            }
        }
        // The 3D view: the stack's brightest voxels, turned with the mouse.
        // It and the orthogonal views are either / or: turning one on turns the other off.
        if root.has-z && root.slice: InkIconButton {
            size: 26px;
            icon: InkIcons.volume;
            label: "3D view";
            active: ViewportState.volume_view;
            clicked => {
                ViewportState.volume_view = !ViewportState.volume_view;
                if ViewportState.volume_view && ViewportState.ortho {
                    ViewportState.ortho = false;
                    ViewportState.ortho_changed(false);
                }
                ViewportState.volume_view_changed(ViewportState.volume_view, ViewportState.volume_yaw, ViewportState.volume_pitch, ViewportState.volume_zoom, false);
            }
        }
        // The XZ and YZ views through a crosshair.
        if root.has-z && root.slice: InkIconButton {
            size: 26px;
            icon: InkIcons.ortho;
            label: "Orthogonal views";
            active: ViewportState.ortho;
            clicked => {
                ViewportState.ortho = !ViewportState.ortho;
                if ViewportState.ortho && ViewportState.volume_view {
                    ViewportState.volume_view = false;
                    ViewportState.volume_view_changed(false, ViewportState.volume_yaw, ViewportState.volume_pitch, ViewportState.volume_zoom, false);
                }
                ViewportState.ortho_changed(ViewportState.ortho);
            }
        }

        // -- T --
        if root.has-t: Sep { }
        if root.has-t: InkCaption {
            text: "T";
        }
        if root.has-t: InkIconButton {
            size: 26px;
            icon: ChannelState.is_play_active ? InkIcons.pause : InkIcons.play;
            label: ChannelState.is_play_active ? "Pause" : "Play";
            active: ChannelState.is_play_active;
            clicked => {
                ChannelState.is_play_active = !ChannelState.is_play_active;
                ChannelState.toggle_play(ChannelState.is_play_active);
            }
        }
        if root.has-t: PlaneText {
            text: root.t-text;
        }
        if root.has-t: StackTrack {
            label: "Frame";
            value: ChannelState.selected_t_stack;
            count: ImageMetaData.nr_t_stacks;
            picked(t) => {
                StackSteps.set-t(t);
            }
        }
        if root.has-t: InkSelect {
            width: 76px;
            height: 26px;
            horizontal-stretch: 0;
            label: "Playback speed";
            model: root.fps-names;
            selected: root.fps-index(ChannelState.play_back_speed_hz);
            picked(i, name) => {
                ChannelState.play_back_speed_hz = root.fps-values[i];
                ChannelState.is_play_active = false;
                ChannelState.toggle_play(false);
            }
        }
    }
}
