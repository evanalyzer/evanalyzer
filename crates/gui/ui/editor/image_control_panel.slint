// editor/image_control_panel.slint — the Image panel: which series and
// channels are shown and how - the objects overlay, the histogram (black
// and white point), the Z projection or slice, the time frame.

import { ChannelState, HistogramState, IntensityProjection } from "../api/state.slint";
import { ImageMetaData } from "../api/image_meta.slint";
import { ViewportObjectState } from "../api/viewport.slint";
import { LayoutState } from "../api/layout.slint";
import { ResultsState } from "../api/results.slint";
import { PipelinesPanelState } from "../api/pipelines.slint";
import { Ink, InkIcons, InkPanelHead, InkSwitch, InkNumberField, InkTextField, InkSegmented, InkSelect, InkCaption, InkIconButton, InkButton, InkButtonKind, InkDivider, InkMenuFrame, InkMenuItem } from "../ink/ink.slint";

// One channel: its color (a click switches it on/off), name, index. The
// selected one is the histogram's.
component ChannelRow inherits Rectangle {
    in property <int> idx;
    in property <string> name;
    in property <color> tint;
    in property <bool> active;
    in property <bool> selected;
    callback select;
    callback toggle;

    height: 26px;
    accessible-role: list-item;
    accessible-label: root.name;
    accessible-item-selected: root.selected;
    accessible-checked: root.active;

    face := Rectangle {
        border-radius: Ink.radius-sm;
        background: root.selected ? Ink.selection : ta.has-hover ? Ink.hover : transparent;

        ta := TouchArea {
            clicked => {
                root.select();
            }
        }

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 4px;
            spacing: 8px;
            swatch := Rectangle {
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                border-radius: 3px;
                background: root.active ? root.tint : transparent;
                border-width: 1px;
                border-color: root.active ? Ink.shadow.with-alpha(0.2) : Ink.text-faint;
                accessible-role: checkbox;
                accessible-label: "Show " + root.name;
                accessible-checked: root.active;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle();
                    }
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.name;
                font-size: Ink.fs-md;
                font-weight: root.selected ? 600 : 400;
                color: root.active ? Ink.text : Ink.text-mute;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            Text {
                text: "ch " + root.idx;
                font-size: Ink.fs-sm;
                font-family: Ink.font-mono;
                color: Ink.text-faint;
                vertical-alignment: center;
            }
            InkIconButton {
                y: (parent.height - self.height) / 2;
                size: 22px;
                icon: root.active ? InkIcons.visible : InkIcons.hidden;
                label: root.active ? "Hide " + root.name : "Show " + root.name;
                clicked => {
                    root.toggle();
                }
            }
        }
    }
}

// Histogram values in the image's own units ("4095", like the footer),
// from 0..1 - 3 decimals for float images.
global HistogramText {
    pure public function shown(v: float) -> string {
        HistogramState.value-scale > 1.5 ? round(v * HistogramState.value-scale) : round(v * 1000) / 1000
    }
}

// A value at its line, inside the box.
component LineValue inherits Text {
    font-size: Ink.fs-xs;
    font-family: Ink.font-mono;
    color: Ink.text-dim;
}

// The histogram of the selected channel (or, comparing, the breakpoint
// image): drag the two lines to set the black and white point, their
// values at them; the axis' ends below. A double click auto-scales.
component Histogram inherits VerticalLayout {
    property <bool> dragging-min: false;
    property <bool> dragging-max: false;

    spacing: 2px;
    accessible-role: slider;
    accessible-label: "Histogram";

    face := Rectangle {
        height: 120px;
        background: Ink.field;
        border-radius: Ink.radius-sm;
        border-width: 1px;
        border-color: Ink.border;
        clip: true;

        for hist in HistogramState.histogram_svg_path: Path {
            width: 100%;
            height: 100%;
            commands: hist.path;
            stroke: hist.color;
            stroke-width: 1.25px;
            fill: hist.color.with-alpha(0.18);
            viewbox-width: 100;
            viewbox-height: 100;
            // Stretched to the box (the default `contain` squeezed the
            // curve into a square in the middle - off the black / white
            // lines, which use the full width).
            fit: fill;
        }

        // Clipped to black / white.
        Rectangle {
            x: 0;
            width: parent.width * HistogramState.histogram_min_val;
            background: Ink.panel.with-alpha(0.6);
        }
        Rectangle {
            x: parent.width * HistogramState.histogram_max_val;
            width: parent.width * (1 - HistogramState.histogram_max_val);
            background: Ink.panel.with-alpha(0.6);
        }

        Rectangle {
            x: parent.width * HistogramState.histogram_min_val - 1px;
            width: 2px;
            background: root.dragging-min ? Ink.focus : Ink.text;
        }
        Rectangle {
            x: parent.width * HistogramState.histogram_max_val - 1px;
            width: 2px;
            background: root.dragging-max ? Ink.focus : Ink.text;
        }

        // The values at their lines: black right of its line, white left
        // of its line - both inside the box.
        LineValue {
            x: clamp(parent.width * HistogramState.histogram_min_val + 4px, 2px, parent.width - self.width - 2px);
            y: 3px;
            text: HistogramText.shown(HistogramState.histogram_min_val_abs);
        }
        LineValue {
            x: clamp(parent.width * HistogramState.histogram_max_val - self.width - 4px, 2px, parent.width - self.width - 2px);
            y: 16px;
            text: HistogramText.shown(HistogramState.histogram_max_val_abs);
        }

        TouchArea {
            mouse-cursor: root.dragging-min || root.dragging-max ? col-resize : pointer;
            double-clicked => {
                HistogramState.auto_adjust_clicked();
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.left {
                    if event.kind == PointerEventKind.down {
                        let d-min = abs(self.mouse-x - parent.width * HistogramState.histogram_min_val);
                        let d-max = abs(self.mouse-x - parent.width * HistogramState.histogram_max_val);
                        if d-min < d-max && d-min < 20px {
                            root.dragging-min = true;
                        } else if d-max < 20px {
                            root.dragging-max = true;
                        }
                    } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        root.dragging-min = false;
                        root.dragging-max = false;
                    }
                }
            }
            moved => {
                if root.dragging-min || root.dragging-max {
                    let rel = clamp(self.mouse-x / self.width, 0.0, 1.0);
                    let range = HistogramState.histogram_max_lim - HistogramState.histogram_min_lim;
                    if root.dragging-min {
                        let r = min(rel, HistogramState.histogram_max_val - 0.01);
                        HistogramState.histogram_min_val = r;
                        HistogramState.histogram_min_val_abs = HistogramState.histogram_min_lim + r * range;
                    } else {
                        let r = max(rel, HistogramState.histogram_min_val + 0.01);
                        HistogramState.histogram_max_val = r;
                        HistogramState.histogram_max_val_abs = HistogramState.histogram_min_lim + r * range;
                    }
                    HistogramState.histogram_adjusted(
                        HistogramState.histogram_min_val_abs,
                        HistogramState.histogram_max_val_abs,
                        HistogramState.histogram_min_lim,
                        HistogramState.histogram_max_lim);
                }
            }
        }
    }

    // The axis' ends.
    HorizontalLayout {
        LineValue {
            text: HistogramText.shown(HistogramState.histogram_min_lim);
            color: Ink.text-mute;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        LineValue {
            text: HistogramText.shown(HistogramState.histogram_max_lim);
            color: Ink.text-mute;
        }
    }
}

// "Label  [field]" in the panel's form layout.
component FieldRow inherits Rectangle {
    in property <string> label;
    height: Ink.control-h;
    Text {
        x: 0px;
        width: 64px;
        text: root.label;
        font-size: Ink.fs-sm;
        color: Ink.text-dim;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component ImageControlPanel inherits Rectangle {
    // In the results' split view (a drawer over the image): ✕ closes the
    // drawer, no pin.
    in property <bool> in-split: false;
    property <[string]> fps-names: ["1 fps", "2 fps", "5 fps", "10 fps", "20 fps", "25 fps"];
    property <[int]> fps-values: [1, 2, 5, 10, 20, 25];
    property <string> channel-name: ChannelState.channels.length > ChannelState.selected_channel_index
        ? ChannelState.channels[ChannelState.selected_channel_index].name : "";
    property <float> hist-range: HistogramState.histogram_max_lim - HistogramState.histogram_min_lim;
    // Comparing: the histogram is the original's or the breakpoint's.
    property <bool> comparing: ViewportObjectState.compare && PipelinesPanelState.has-breakpoint-image;
    changed comparing => {
        if !self.comparing && HistogramState.side != 0 {
            HistogramState.side = 0;
            HistogramState.side-changed(0);
        }
    }

    // The four values typed in (behind "Values ›").
    property <bool> show-values: false;
    // Typed in the image's units, back to 0..1.
    pure function typed(t: string) -> float {
        t.to-float() / max(HistogramState.value-scale, 1.0)
    }

    pure function fps-index(hz: int) -> int {
        hz >= 25 ? 5 : hz >= 20 ? 4 : hz >= 10 ? 3 : hz >= 5 ? 2 : hz >= 2 ? 1 : 0
    }

    function projection(p: IntensityProjection) {
        ChannelState.intensity_projection = p;
        ChannelState.trigger_channel_state_changed();
    }

    // Black / white typed in: within the axis, the handles follow.
    function set-black(v: float) {
        let abs-v = clamp(v, HistogramState.histogram_min_lim, HistogramState.histogram_max_val_abs);
        HistogramState.histogram_min_val_abs = abs-v;
        if root.hist-range > 0.00001 {
            HistogramState.histogram_min_val = (abs-v - HistogramState.histogram_min_lim) / root.hist-range;
        }
        HistogramState.histogram_adjusted(abs-v, HistogramState.histogram_max_val_abs, HistogramState.histogram_min_lim, HistogramState.histogram_max_lim);
    }

    function set-white(v: float) {
        let abs-v = clamp(v, HistogramState.histogram_min_val_abs, HistogramState.histogram_max_lim);
        HistogramState.histogram_max_val_abs = abs-v;
        if root.hist-range > 0.00001 {
            HistogramState.histogram_max_val = (abs-v - HistogramState.histogram_min_lim) / root.hist-range;
        }
        HistogramState.histogram_adjusted(HistogramState.histogram_min_val_abs, abs-v, HistogramState.histogram_min_lim, HistogramState.histogram_max_lim);
    }

    // The axis changed: black and white stay where they are (inside it).
    function set-axis(new-min: float, new-max: float) {
        let range = new-max - new-min;
        let lo = clamp(HistogramState.histogram_min_val_abs, new-min, new-max);
        let hi = clamp(HistogramState.histogram_max_val_abs, new-min, new-max);
        HistogramState.histogram_min_lim = new-min;
        HistogramState.histogram_max_lim = new-max;
        if range > 0.00001 {
            HistogramState.histogram_min_val = (lo - new-min) / range;
            HistogramState.histogram_max_val = (hi - new-min) / range;
        }
        HistogramState.histogram_min_val_abs = lo;
        HistogramState.histogram_max_val_abs = hi;
        HistogramState.histogram_adjusted(lo, hi, new-min, new-max);
    }

    VerticalLayout {
        spacing: 0px;

        InkPanelHead {
            title: "Image";
            subtitle: ImageMetaData.nr_series > 1 ? "Series \{ChannelState.selected_series + 1} of \{ImageMetaData.nr_series}" : "";
            pinnable: !root.in-split;
            pinned: LayoutState.image-pinned;
            // The series: in the top bar's image chip (always in view).
            pin-toggled => {
                LayoutState.image-pinned = !LayoutState.image-pinned;
            }
            close => {
                if root.in-split {
                    ResultsState.split-image-panel = false;
                    ResultsState.split-image-panel-changed(false);
                } else {
                    LayoutState.image-open = false;
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: body.preferred-height;

            body := VerticalLayout {
                padding: Ink.pad-panel;
                padding-top: 8px;
                spacing: 8px;
                alignment: start;

                // -- Channels --
                VerticalLayout {
                    spacing: 0px;
                    for ch[i] in ChannelState.channels: ChannelRow {
                        idx: ch.idx;
                        name: ch.name;
                        tint: ch.color;
                        active: ch.active;
                        selected: ChannelState.selected_channel_index == i;
                        select => {
                            ChannelState.selected_channel_index = i;
                            ChannelState.trigger_active_channel_selection_changed();
                        }
                        toggle => {
                            ChannelState.channels[i].active = !ChannelState.channels[i].active;
                            ChannelState.trigger_channel_state_changed();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;
                    InkSwitch {
                        text: "Grayscale";
                        checked: ChannelState.grayscale;
                        toggled(on) => {
                            ChannelState.grayscale = on;
                            ChannelState.grayscale_toggled(on);
                        }
                    }
                    InkSwitch {
                        text: "Show objects";
                        checked: ViewportObjectState.show_objects;
                        toggled(on) => {
                            ViewportObjectState.show_objects = on;
                        }
                    }
                }

                FieldRow {
                    label: "Overlay";
                    InkNumberField {
                        x: 72px;
                        width: parent.width - 72px;
                        label: "Overlay opacity in percent";
                        value: round(ViewportObjectState.object_transparency * 100);
                        step: 5;
                        unit: "%";
                        changed(text) => {
                            ViewportObjectState.object_transparency = clamp(text.to-float(), 0, 100) / 100;
                            ViewportObjectState.object_transparency_changed(ViewportObjectState.object_transparency);
                        }
                    }
                }

                InkDivider { }

                // -- Histogram --
                HorizontalLayout {
                    spacing: 6px;
                    InkCaption {
                        horizontal-stretch: 1;
                        text: "HISTOGRAM" + (HistogramState.side == 1 ? " · breakpoint" : root.channel-name != "" ? " · " + root.channel-name : "");
                        overflow: elide;
                    }

                    InkButton {
                        small: true;
                        kind: InkButtonKind.quiet;
                        text: "Auto-scale";
                        clicked => {
                            HistogramState.auto_adjust_clicked();
                        }
                    }
                    // Every channel (the original's).
                    if HistogramState.side == 0: InkButton {
                        small: true;
                        kind: InkButtonKind.quiet;
                        text: "All channels";
                        clicked => {
                            HistogramState.auto_adjust_all_clicked();
                        }
                    }
                }

                // Comparing: whose histogram is shown and changed.
                if root.comparing: InkSegmented {
                    model: ["Original", "Breakpoint"];
                    label: "Histogram of";
                    selected: HistogramState.side;
                    picked(i) => {
                        HistogramState.side = i;
                        HistogramState.side-changed(i);
                    }
                }

                Histogram { }

                // Log counts; the values to type in; this image's scaling for
                // all (the original's only).
                HorizontalLayout {
                    spacing: 6px;
                    InkSwitch {
                        text: "Log";
                        checked: HistogramState.log-scale;
                        toggled(on) => {
                            HistogramState.log-scale = on;
                            HistogramState.log-scale-changed(on);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    InkButton {
                        small: true;
                        kind: InkButtonKind.quiet;
                        text: root.show-values ? "Values ‹" : "Values ›";
                        clicked => {
                            root.show-values = !root.show-values;
                        }
                    }
                    if HistogramState.side == 0: InkButton {
                        small: true;
                        kind: InkButtonKind.quiet;
                        text: "Use for all images";
                        clicked => {
                            HistogramState.apply-to-all-images();
                        }
                    }
                }

                if root.show-values: GridLayout {
                    spacing-horizontal: 6px;
                    spacing-vertical: 4px;
                    Row {
                        Text {
                            text: "Black / white";
                            font-size: Ink.fs-xs;
                            color: Ink.text-mute;
                        }
                        Text {
                            text: "Axis min / max";
                            font-size: Ink.fs-xs;
                            color: Ink.text-mute;
                        }
                    }
                    Row {
                        InkTextField {
                            mono: true;
                            label: "Black point";
                            value: HistogramText.shown(HistogramState.histogram_min_val_abs);
                            accepted(t) => {
                                root.set-black(root.typed(t));
                            }
                        }
                        InkTextField {
                            mono: true;
                            label: "Axis min";
                            value: HistogramText.shown(HistogramState.histogram_min_lim);
                            accepted(t) => {
                                root.set-axis(root.typed(t), HistogramState.histogram_max_lim);
                            }
                        }
                    }
                    Row {
                        InkTextField {
                            mono: true;
                            label: "White point";
                            value: HistogramText.shown(HistogramState.histogram_max_val_abs);
                            accepted(t) => {
                                root.set-white(root.typed(t));
                            }
                        }
                        InkTextField {
                            mono: true;
                            label: "Axis max";
                            value: HistogramText.shown(HistogramState.histogram_max_lim);
                            accepted(t) => {
                                root.set-axis(HistogramState.histogram_min_lim, root.typed(t));
                            }
                        }
                    }
                }

                // -- Z --
                if ImageMetaData.nr_z_stacks > 1: VerticalLayout {
                    spacing: 6px;
                    InkDivider { }
                    HorizontalLayout {
                        spacing: 8px;
                        InkCaption {
                            width: 16px;
                            text: "Z";
                        }
                        InkSegmented {
                            horizontal-stretch: 1;
                            label: "Z projection";
                            model: ["Slice", "Max", "Min", "Avg", "Sum", "Mid"];
                            selected: ChannelState.intensity_projection == IntensityProjection.max ? 1
                                : ChannelState.intensity_projection == IntensityProjection.min ? 2
                                : ChannelState.intensity_projection == IntensityProjection.avg ? 3
                                : ChannelState.intensity_projection == IntensityProjection.sum ? 4
                                : ChannelState.intensity_projection == IntensityProjection.middle ? 5
                                : 0;
                            picked(i) => {
                                root.projection(i == 1 ? IntensityProjection.max
                                    : i == 2 ? IntensityProjection.min
                                    : i == 3 ? IntensityProjection.avg
                                    : i == 4 ? IntensityProjection.sum
                                    : i == 5 ? IntensityProjection.middle
                                    : IntensityProjection.single-stack);
                            }
                        }
                    }
                    if ChannelState.intensity_projection == IntensityProjection.single-stack: FieldRow {
                        label: "Slice";
                        InkNumberField {
                            x: 72px;
                            width: parent.width - 72px;
                            label: "Z slice";
                            value: ChannelState.selected_z_stack + 1;
                            min: 1;
                            max: ImageMetaData.nr_z_stacks;
                            unit: "/ " + ImageMetaData.nr_z_stacks;
                            changed(text) => {
                                ChannelState.selected_z_stack = clamp(round(text.to-float()) - 1, 0, ImageMetaData.nr_z_stacks - 1);
                                ChannelState.trigger_channel_state_changed();
                            }
                        }
                    }
                }

                // -- T --
                if ImageMetaData.nr_t_stacks > 1: VerticalLayout {
                    spacing: 6px;
                    InkDivider { }
                    HorizontalLayout {
                        spacing: 6px;
                        InkCaption {
                            width: 16px;
                            text: "T";
                        }
                        InkIconButton {
                            size: Ink.control-h;
                            icon: ChannelState.is_play_active ? InkIcons.pause : InkIcons.play;
                            label: ChannelState.is_play_active ? "Pause" : "Play";
                            active: ChannelState.is_play_active;
                            clicked => {
                                ChannelState.is_play_active = !ChannelState.is_play_active;
                                ChannelState.toggle_play(ChannelState.is_play_active);
                            }
                        }
                        InkNumberField {
                            label: "Frame";
                            value: ChannelState.selected_t_stack + 1;
                            min: 1;
                            max: ImageMetaData.nr_t_stacks;
                            unit: "/ " + ImageMetaData.nr_t_stacks;
                            changed(text) => {
                                ChannelState.selected_t_stack = clamp(round(text.to-float()) - 1, 0, ImageMetaData.nr_t_stacks - 1);
                                ChannelState.trigger_channel_state_changed();
                            }
                        }
                        InkSelect {
                            width: 76px;
                            horizontal-stretch: 0;
                            label: "Playback speed";
                            model: root.fps-names;
                            selected: root.fps-index(ChannelState.play_back_speed_hz);
                            picked(i, name) => {
                                ChannelState.play_back_speed_hz = root.fps-values[i];
                                ChannelState.is_play_active = false;
                                ChannelState.toggle_play(false);
                            }
                        }
                    }
                }
            }
        }
    }

}
