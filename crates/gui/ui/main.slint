import { AnalysisRunningCloseState, AppInfoState, ChannelInfo, ChannelState, ConnectState, ConnectionState, DialogType, GlobalAppState, HistogramData, HistogramState, ImagePixelInfo, IntensityProjection, RecentServerRow, UnsavedChangesState, WarningState } from "api/state.slint";
import { ToolbarState } from "api/toolbar.slint";
import { RetainedTile, ToolState, ViewportObjectState, ViewportState } from "api/viewport.slint";
import { ImageMetaData } from "api/image_meta.slint";
import { ProjectSettingsSlint, ProjectSettingsState, ViewportMemoryState } from "api/project_settings.slint";
import { ImageItemData, ImagesListState } from "api/images_list.slint";
import { ClassificationState } from "api/classification.slint";
import { ClassSettingsSlint, ClassificationSettingsState } from "api/classification_class_edit.slint";
import { ObjectItemDataSlint, ObjectListState } from "api/object_list.slint";
import { CommandAuthor, CommandDef, CommandPickerState, DefaultParamPreview } from "api/command_selection.slint";
import { PipelineDeleteConfirmState, PipelineEditState } from "api/pipeline_edit.slint";
import { ComponentBindingRow, ComponentClassRow, ComponentEditChoiceState, ComponentParamRow, ComponentSettingsState, ComponentUpdateState, CreateComponentState, ExposeChoiceState } from "api/create_component.slint";
import { PipelineRunningState } from "api/pipeline_running.slint";
import { TemplateMetaSlint, TemplateMetaState } from "api/template_meta.slint";
import { ProjectAuthor, ProjectTemplateDef, ProjectTemplateState } from "api/project_template.slint";
import { ComponentClassesState, PipelinesPanelState } from "api/pipelines.slint";
import { ScriptCommandDoc, ScriptDiagnostic, ScriptEdit, ScriptEditorState, ScriptHighlight } from "api/script_editor.slint";
import { PipelineFocusState } from "api/pipeline_focus.slint";
import { AiLearningState, AiTrainingSettingsSlint, ClassSelectionRowSlint, FeatureRowSlint, ObjectMetricRowSlint, TrainingImageRowSlint, TrainingObjectRowSlint } from "api/ai_learning.slint";
import { RunAnalysisState } from "api/run_analysis.slint";
import { ResultsListState } from "api/results_list.slint";
import { ResultsState } from "api/results.slint";
import { ExportDialogState } from "api/export.slint";
import { FileBrowserCrumb, FileBrowserEntry, FileBrowserMode, FileBrowserPlace, FileBrowserState } from "api/file_browser.slint";
import {
    Button,
    ComboBox,
    VerticalBox,
    HorizontalBox,
    GroupBox,
    Switch,
    StandardListView,
} from "std-widgets.slint";

import { GlobalShortcuts, DialogShortcuts } from "shortcuts.slint";

import { AboutDialog } from "dialogs/about.slint";
import { ShortcutsHelpDialog } from "dialogs/shortcuts_help_dialog.slint";

import { Theme } from "style.slint";
import { Appearance } from "api/appearance.slint";
import { LayoutState, WorkspaceMode } from "api/layout.slint";
import { TopBar } from "shell/top_bar.slint";
import { BottomBar } from "shell/bottom_bar.slint";
import { Workspace } from "shell/workspace.slint";
import { InkBanner, InkTone } from "ink/ink.slint";
import { Ink, InkScheme } from "ink/palette.slint";
import { ImageMissingDialog } from "dialogs/images_missing_dialog.slint";

import { ProjectSettingsDialog } from "dialogs/project_settings_dialog.slint";

import {
    ConfirmDeleteClassDialog,
} from "dialogs/classification_confirm_delete.slint";

import {
    ConfirmAutoAddClassesDialog,
} from "dialogs/classification_confirm_auto_add_dialog.slint";

import { ClassEditDialog } from "dialogs/classification_class_edit_dialog.slint";

import {
    ConfirmDeleteObjectDialog,
} from "dialogs/object_list_confirm_delete_dialog.slint";
import { CommandSelectionDialog } from "dialogs/command_selection_dialog.slint";
import { PipelineEditDialog, PipelineDeleteConfirmDialog } from "dialogs/pipeline_edit_dialog.slint";
import { ComponentUpdateDialog, ComponentSettingsDialog } from "dialogs/create_component_dialog.slint";
import { CreateComponentDialog, ComponentEditChoiceDialog, ExposeChoiceDialog } from "dialogs/create_component_dialog.slint";
import { PipelineRunningDialog } from "dialogs/pipeline_running_dialog.slint";
import { TemplateMetaDialog } from "dialogs/template_meta_dialog.slint";
import { ProjectTemplateDialog } from "dialogs/project_template_dialog.slint";
import { StepSettingsDialog } from "editor/pipelines_panel.slint";
import { ScriptEditorPanel } from "editor/script_editor_panel.slint";

import { PreviewRendering } from "dialogs/preview_rendering_dialog.slint";
import { WarningDialog } from "dialogs/warning_dialog.slint";

import { UnsavedChangesDialog } from "dialogs/unsaved_changes_dialog.slint";
import {
    AnalysisRunningCloseDialog,
} from "dialogs/analysis_running_close_dialog.slint";
import { ConnectDialog } from "dialogs/connect_dialog.slint";

import { AiLearningDialog } from "dialogs/ai_learning_dialog.slint";
import { RunAnalysisDialog } from "dialogs/run_analysis_dialog.slint";
import { ExportDialog } from "results/export_dialog.slint";

import { FileBrowserDialog } from "dialogs/file_browser_dialog.slint";
import { ClassSelectDialog } from "dialogs/classification_select_dialog.slint";
import {
    ConfirmDeleteManualAnnotatedObjectDialog,
} from "dialogs/object_list_confirm_delete_manual_annotated_dialog.slint";

export {
    GlobalAppState,
    ViewportMemoryState,
    RetainedTile,
    ProjectSettingsSlint,
    ProjectSettingsState,
    ImagePixelInfo,
    DialogType,
    HistogramState,
    ViewportState,
    ChannelState,
    ChannelInfo,
    IntensityProjection,
    ImageMetaData,
    ImagesListState,
    ImageItemData,
    ClassificationState,
    ClassificationSettingsState,
    ClassSettingsSlint,
    ObjectListState,
    ObjectItemDataSlint,
    ToolbarState,
    ToolState,
    ViewportObjectState,
    PipelinesPanelState,
    ComponentClassesState,
    ScriptEditorState,
    ScriptHighlight,
    ScriptEdit,
    ScriptDiagnostic,
    ScriptCommandDoc,
    PipelineFocusState,
    CommandPickerState,
    CommandDef,
    CommandAuthor,
    DefaultParamPreview,
    PipelineEditState,
    CreateComponentState,
    ComponentClassRow,
    ComponentEditChoiceState,
    ExposeChoiceState,
    ComponentUpdateState,
    ComponentSettingsState,
    ComponentParamRow,
    ComponentBindingRow,
    PipelineDeleteConfirmState,
    PipelineRunningState,
    TemplateMetaState,
    TemplateMetaSlint,
    ProjectTemplateState,
    ProjectTemplateDef,
    ProjectAuthor,
    ResultsListState,
    WarningState,
    ConnectionState,
    AppInfoState,
    UnsavedChangesState,
    AnalysisRunningCloseState,
    ConnectState,
    RecentServerRow,
    RunAnalysisState,
    Appearance,
    LayoutState,
    WorkspaceMode,
    Ink,
    InkScheme,
    AiLearningState,
    AiTrainingSettingsSlint,
    ClassSelectionRowSlint,
    FeatureRowSlint,
    ObjectMetricRowSlint,
    TrainingImageRowSlint,
    TrainingObjectRowSlint,
    ResultsState,
    ExportDialogState,
    FileBrowserState,
    FileBrowserMode,
    FileBrowserPlace,
    FileBrowserCrumb,
    FileBrowserEntry,
}
export component AppWindow inherits Window {
    // A literal binding on the inherited `title` property isn't settable
    // from Rust (Slint only generates an accessor for a plain, binding-free
    // `in`/`in-out` property) — so the actual title lives in this property
    // instead, and `title` just mirrors it. Rust pushes the open project's
    // filename (plus an unsaved-changes marker) into `window_title` via
    // `UiState::set_window_title`.
    in-out property <string> window_title: "EVAnalyzer";
    title: root.window_title;
    icon: @image-url("icons/icon.png");
    preferred-width: 1500px;
    preferred-height: 900px;
    min-width: 1500px;
    min-height: 900px;
    background: Theme.bg;
    default-font-family: Ink.font-sans;

    callback apply_math();
    in property <image> display_image;
    in property <image> ghost_image;
    in property <image> object_image;

    // Initial color scheme is applied from Rust (`Appearance.apply`) right
    // after this window is constructed, using the persisted preference -
    // see `evanalyzer_gui::run`.

    // Global keyboard accelerators for the main editing surface. Wrapping
    // the `VerticalBox` (rather than adding a sibling `FocusScope`, the
    // pattern the modal dialogs use) makes `kbd` an ancestor of every
    // focusable widget inside it - e.g. a `LineEdit` in a sidebar panel - so
    // an unhandled key press there bubbles up to this handler instead of
    // only firing when nothing has focus. See shortcuts.slint for the full
    // list of shortcuts and why they're gated on no dialog being open.
    forward-focus: kbd;
    kbd := GlobalShortcuts {
        VerticalLayout {
            spacing: 0px;

            TopBar {
                title: root.window_title;
            }

            // Can't be missed: everything that needs the server fails until
            // the connection is back, and this is the only place that says why.
            if ConnectionState.remote && !ConnectionState.connected: Rectangle {
                height: 36px;
                background: Ink.panel;
                InkBanner {
                    x: 8px;
                    y: 2px;
                    width: parent.width - 16px;
                    height: 32px;
                    tone: InkTone.err;
                    text: "Connection to " + ConnectionState.label + " lost - " + ConnectionState.lost-message;
                    action: ConnectionState.can-reconnect ? "Reconnect now" : "";
                    action-clicked => {
                        ConnectionState.reconnect-now();
                    }
                }
            }

            Workspace {
                vertical-stretch: 1;
                display_image: root.display_image;
                ghost_image: root.ghost_image;
                object_image: root.object_image;
            }

            BottomBar { }
        }
    }

    // The "Overlay Manager". Wrapped in `DialogShortcuts` (see
    // shortcuts.slint) so Escape closes whichever dialog below is open,
    // without every dialog file needing its own copy of that logic.
    if (GlobalAppState.active_dialog != DialogType.none): DialogShortcuts {
        width: 100%;
        height: 100%;
        Rectangle {
            width: 100%;
            height: 100%;
            if (GlobalAppState.active_dialog == DialogType.missing_images): ImageMissingDialog { }
            if (GlobalAppState.active_dialog == DialogType.about): AboutDialog { }
            if (GlobalAppState.active_dialog == DialogType.shortcuts_help): ShortcutsHelpDialog { }
            if (GlobalAppState.active_dialog == DialogType.project_settings): ProjectSettingsDialog { }
            if (GlobalAppState.active_dialog == DialogType.classification_confirm_delete): ConfirmDeleteClassDialog { }
            if (GlobalAppState.active_dialog == DialogType.classification_confirm_auto_add_dialog): ConfirmAutoAddClassesDialog { }
            if (GlobalAppState.active_dialog == DialogType.classification-edit-class-dialog): ClassEditDialog { }
            if (GlobalAppState.active_dialog == DialogType.object-confirm-delete): ConfirmDeleteObjectDialog { }
            if (GlobalAppState.active_dialog == DialogType.object-confirm-delete-manual-annotated): ConfirmDeleteManualAnnotatedObjectDialog { }

            if (GlobalAppState.active_dialog == DialogType.command-selection-dialog): CommandSelectionDialog {
                width: 100%;
                height: 100%;
                commands: CommandPickerState.all-commands;
                target-pipeline: CommandPickerState.target-pipeline;
                insert-after-idx: CommandPickerState.insert-after-idx;
                total-steps: CommandPickerState.total-steps;
                shown-preprocess: CommandPickerState.shown-preprocess;
                shown-segment: CommandPickerState.shown-segment;
                shown-object: CommandPickerState.shown-object;
                shown-classify: CommandPickerState.shown-classify;
                shown-dataset: CommandPickerState.shown-dataset;
                shown-measure: CommandPickerState.shown-measure;
                shown-components: CommandPickerState.shown-components;
                shown-library-components: CommandPickerState.shown-library-components;
                detail: CommandPickerState.detail;
                has-detail: CommandPickerState.has-detail;
                total-shown: CommandPickerState.total-shown;
                cat-count-pre: CommandPickerState.cat-count-pre;
                cat-count-seg: CommandPickerState.cat-count-seg;
                cat-count-obj: CommandPickerState.cat-count-obj;
                cat-count-cls: CommandPickerState.cat-count-cls;
                cat-count-dat: CommandPickerState.cat-count-dat;
                cat-count-mea: CommandPickerState.cat-count-mea;
                cat-count-grp: CommandPickerState.cat-count-grp;
                unused-component-count: CommandPickerState.unused-component-count;
                detail-removable: CommandPickerState.detail-removable;
                query <=> CommandPickerState.query;
                fcat-pre <=> CommandPickerState.fcat-pre;
                fcat-seg <=> CommandPickerState.fcat-seg;
                fcat-obj <=> CommandPickerState.fcat-obj;
                fcat-mea <=> CommandPickerState.fcat-mea;
                fcat-cls <=> CommandPickerState.fcat-cls;
                fcat-dat <=> CommandPickerState.fcat-dat;
                filter-components <=> CommandPickerState.filter-components;
                selected-id <=> CommandPickerState.selected-id;
                query-changed(t) => {
                    CommandPickerState.query-changed(t);
                }
                select(id) => {
                    CommandPickerState.select(id);
                }
                confirm(id) => {
                    CommandPickerState.confirm(id);
                }
                remove-component(id) => {
                    CommandPickerState.remove-component(id);
                }
                remove-unused-components => {
                    CommandPickerState.remove-unused-components();
                }
                cancel => {
                    CommandPickerState.cancel();
                }
                import-bioimageio => {
                    CommandPickerState.import-bioimageio();
                }
            }
            if (GlobalAppState.active_dialog == DialogType.script-editor): ScriptEditorPanel {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.pipeline-edit): PipelineEditDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.create-component): CreateComponentDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.component-edit-choice): ComponentEditChoiceDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.expose-choice): ExposeChoiceDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.component-update): ComponentUpdateDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.component-settings): ComponentSettingsDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.step-settings): StepSettingsDialog {
                width: 100%;
                height: 100%;
                close => {
                    GlobalAppState.active_dialog = DialogType.none;
                }
            }
            if (GlobalAppState.active_dialog == DialogType.pipeline-delete-confirm): PipelineDeleteConfirmDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.pipeline-running): PipelineRunningDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.warning): WarningDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.template-meta): TemplateMetaDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.project-template): ProjectTemplateDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.unsaved-changes-confirm): UnsavedChangesDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.analysis-running-close): AnalysisRunningCloseDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.connect-server): ConnectDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.run-analysis-confirm): RunAnalysisDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.ai-learning): AiLearningDialog {
                width: 100%;
                height: 100%;
            }
            if (GlobalAppState.active_dialog == DialogType.classification-selection-dialog): ClassSelectDialog {
                width: 100%;
                height: 100%;
            }
        }
    }

    if ExportDialogState.active: ExportDialog {
        width: 100%;
        height: 100%;
    }

    // The file browser sits above every other overlay: some dialogs (e.g.
    // AI learning) open it while they are themselves still open.
    if FileBrowserState.visible: FileBrowserDialog {
        width: 100%;
        height: 100%;
    }
}
