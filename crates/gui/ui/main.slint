import {
    Button,
    ComboBox,
    VerticalBox,
    HorizontalBox,
    GroupBox,
    Switch,
    StandardListView,
} from "std-widgets.slint";
import {
    HistogramState,
    ChannelState,
    ChannelInfo,
    IntensityProjection,
    HistogramData,
    ImagePixelInfo,
} from "state.slint";
import { SidebarLeft } from "sidebar_left.slint";
import { Toolbar, ToolbarState } from "toolbar.slint";
import { Viewport } from "editor/viewport.slint";
import { ToolState } from "editor/viewport_state.slint";
import { StatusBar } from "status_bar.slint";
import { AboutDialog } from "dialogs/about.slint";
import { CustomMenuBar } from "menu_bar.slint";
import { SidebarRight } from "sidebar_right.slint";
import { ImageMetaData } from "editor/image_meta_panel.slint";
import { Theme, Appearance } from "style.slint";
import { ImageMissingDialog } from "dialogs/images_missing_dialog.slint";
import { GlobalAppState, DialogType, AppInfoState } from "state.slint";
import {
    ProjectSettingsDialog,
    ProjectSettingsState,
    ProjectSettingsSlint,
} from "dialogs/project_settings_dialog.slint";
import {
    ImageItemData,
    ImagesListState,
} from "editor/images_list_panel.slint";

import { ClassificationState } from "editor/classification_panel.slint";
import {
    ConfirmDeleteClassDialog,
} from "dialogs/classification_confirm_delete.slint";

import {
    ConfirmAutoAddClassesDialog,
}from "dialogs/classification_confirm_auto_add_dialog.slint";

import {
    ClassEditDialog,
    ClassificationSettingsState,
    ClassSettingsSlint,
} from "dialogs/classification_class_edit_dialog.slint";

import {
    ObjectListState,
    ObjectItemDataSlint,
} from "editor/object_list_panel.slint";
import {
    ViewportState,
    ViewportObjectState,
} from "editor/viewport_state.slint";
import {
    ConfirmDeleteObjectDialog,
} from "dialogs/object_list_confirm_delete_dialog.slint";
import {
    CommandSelectionDialog,
    CommandPickerState,
    CommandDef,
    DefaultParamPreview,
} from "dialogs/command_selection_dialog.slint";
import {
    PipelineEditDialog,
    PipelineEditState,
    PipelineDeleteConfirmDialog,
    PipelineDeleteConfirmState,
} from "dialogs/pipeline_edit_dialog.slint";
import {
    PipelineRunningDialog,
    PipelineRunningState,
} from "dialogs/pipeline_running_dialog.slint";
import {
    TemplateMetaDialog,
    TemplateMetaState,
    TemplateMetaSlint,
} from "dialogs/template_meta_dialog.slint";
import {
    ProjectTemplateDialog,
    ProjectTemplateState,
    ProjectTemplateDef,
} from "dialogs/project_template_dialog.slint";
import { PipelinesPanelState } from "editor/pipelines_panel.slint";
import { PreviewRendering } from "dialogs/preview_rendering_dialog.slint";
import { WarningDialog } from "dialogs/warning_dialog.slint";
import { WarningState } from "state.slint";
import { UnsavedChangesDialog } from "dialogs/unsaved_changes_dialog.slint";
import { UnsavedChangesState } from "state.slint";
import {
    AiLearningDialog,
    AiLearningState,
    AiTrainingSettingsSlint,
    ClassSelectionRowSlint,
    FeatureRowSlint,
    ObjectMetricRowSlint,
    TrainingImageRowSlint,
    TrainingObjectRowSlint,
} from "dialogs/ai_learning_dialog.slint";
import {
    RunAnalysisDialog,
    RunAnalysisState,
} from "dialogs/run_analysis_dialog.slint";
import {
    ResultsWindow,
    ResultsState,
    ResultsColumnDef,
    ResultsRow,
    ResultsViewMode,
    ResultsChartKind,
} from "results/results_window.slint";
import { ResultsListState } from "editor/results_list_panel.slint";

export {
    GlobalAppState,
    ProjectSettingsSlint,
    ProjectSettingsState,
    ImagePixelInfo,
    DialogType,
    HistogramState,
    ViewportState,
    ChannelState,
    ChannelInfo,
    IntensityProjection,
    ImageMetaData,
    ImagesListState,
    ImageItemData,
    ClassificationState,
    ClassificationSettingsState,
    ClassSettingsSlint,
    ObjectListState,
    ObjectItemDataSlint,
    ToolbarState,
    ToolState,
    ViewportObjectState,
    PipelinesPanelState,
    CommandPickerState,
    CommandDef,
    DefaultParamPreview,
    PipelineEditState,
    PipelineDeleteConfirmState,
    PipelineRunningState,
    TemplateMetaState,
    TemplateMetaSlint,
    ProjectTemplateState,
    ProjectTemplateDef,
    ResultsListState,
    WarningState,
    AppInfoState,
    UnsavedChangesState,
    RunAnalysisState,
    ResultsWindow,
    ResultsState,
    ResultsColumnDef,
    ResultsRow,
    ResultsViewMode,
    ResultsChartKind,
    Appearance,
    AiLearningState,
    AiTrainingSettingsSlint,
    ClassSelectionRowSlint,
    FeatureRowSlint,
    ObjectMetricRowSlint,
    TrainingImageRowSlint,
    TrainingObjectRowSlint,
}
export component AppWindow inherits Window {
    // A literal binding on the inherited `title` property isn't settable
    // from Rust (Slint only generates an accessor for a plain, binding-free
    // `in`/`in-out` property) — so the actual title lives in this property
    // instead, and `title` just mirrors it. Rust pushes the open project's
    // filename (plus an unsaved-changes marker) into `window_title` via
    // `UiState::set_window_title`.
    in-out property <string> window_title: "EVAnalyzer";
    title: root.window_title;
    icon: @image-url("icons/icon.png");
    preferred-width: 1500px;
    preferred-height: 900px;
    min-width: 1500px;
    min-height: 900px;
    background: Theme.bg;

    callback apply_math();
    in property <image> display_image;
    in property <image> ghost_image;
    in property <image> object_image;

    // Initial color scheme is applied from Rust (`Appearance.apply`) right
    // after this window is constructed, using the persisted preference -
    // see `evanalyzer_gui::run`.

    // Global keyboard accelerators for the main editing surface (Save/Open/
    // Undo/Redo). Wrapping the `VerticalBox` (rather than adding a sibling
    // `FocusScope`, the pattern the modal dialogs use) makes `kbd` an
    // ancestor of every focusable widget inside it - e.g. a `LineEdit` in a
    // sidebar panel - so an unhandled key press there bubbles up to this
    // handler instead of only firing when nothing has focus. Gated on no
    // dialog being open; dialogs live outside this subtree (see the
    // "Overlay Manager" below) and have no bubble path back here anyway, but
    // the guard is kept as a defensive belt-and-braces check.
    forward-focus: kbd;
    kbd := FocusScope {
        key-pressed(e) => {
            if (GlobalAppState.active_dialog != DialogType.none) {
                return reject;
            }
            if (e.modifiers.control && e.text == "s") {
                if (e.modifiers.shift) {
                    ToolbarState.save_as_file_clicked();
                } else {
                    ToolbarState.save_file_clicked();
                }
                return accept;
            }
            if (e.modifiers.control && e.text == "o") {
                ToolbarState.open_file_clicked();
                return accept;
            }
            if (e.modifiers.control && (e.text == "z" || e.text == "y")) {
                if (e.text == "y" || e.modifiers.shift) {
                    ToolbarState.redo_clicked();
                } else {
                    ToolbarState.undo_clicked();
                }
                return accept;
            }
            return reject;
        }

        VerticalBox {
            padding: 0;
            spacing: 0;

            CustomMenuBar { }

            Toolbar { }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            HorizontalBox {
                spacing: 0;
                padding: 0;
                Rectangle {
                    width: 364px;
                    SidebarLeft { }
                }

                Rectangle {
                    horizontal-stretch: 1;

                    Viewport {
                        display_image: root.display_image;
                        ghost_image: root.ghost_image;
                        object_image: root.object_image;
                        width: 100%;
                        height: 100%;
                        enabled: GlobalAppState.active_dialog == DialogType.none;
                    }

                    // Kept scoped to the viewport's own bounds (not the whole
                    // window) so it never covers the sidebars/toolbar/status
                    // bar - see the "Overlay Manager" section for every other
                    // dialog, which intentionally does span the full window.
                    if (GlobalAppState.active_dialog == DialogType.preview-rendering): PreviewRendering {
                        width: 100%;
                        height: 100%;
                    }
                }

                // Image tools sidebar
                if (GlobalAppState.show_image_tools): Rectangle {
                    width: 400px;
                    animate width {
                        duration: 200ms;
                        easing: ease-in-out;
                    }

                    SidebarRight { }
                }
            }

            // Status Bar
            StatusBar { }
        }
    }

    // The "Overlay Manager"
    if (GlobalAppState.active_dialog != DialogType.none): Rectangle {
        width: 100%;
        height: 100%;
        if (GlobalAppState.active_dialog == DialogType.missing_images): ImageMissingDialog { }
        if (GlobalAppState.active_dialog == DialogType.about): AboutDialog { }
        if (GlobalAppState.active_dialog == DialogType.project_settings): ProjectSettingsDialog { }
        if (GlobalAppState.active_dialog == DialogType.classification_confirm_delete): ConfirmDeleteClassDialog { }
        if (GlobalAppState.active_dialog == DialogType.classification_confirm_auto_add_dialog): ConfirmAutoAddClassesDialog { }
        if (GlobalAppState.active_dialog == DialogType.classification-edit-class-dialog): ClassEditDialog { }
        if (GlobalAppState.active_dialog == DialogType.object-confirm-delete): ConfirmDeleteObjectDialog { }
        if (GlobalAppState.active_dialog == DialogType.command-selection-dialog): CommandSelectionDialog {
            width: 100%;
            height: 100%;
            commands: CommandPickerState.all-commands;
            target-pipeline: CommandPickerState.target-pipeline;
            insert-after-idx: CommandPickerState.insert-after-idx;
            total-steps: CommandPickerState.total-steps;
            shown-preprocess: CommandPickerState.shown-preprocess;
            shown-segment: CommandPickerState.shown-segment;
            shown-object: CommandPickerState.shown-object;
            shown-classify: CommandPickerState.shown-classify;
            shown-measure: CommandPickerState.shown-measure;
            shown-templates: CommandPickerState.shown-templates;
            detail: CommandPickerState.detail;
            has-detail: CommandPickerState.has-detail;
            total-shown: CommandPickerState.total-shown;
            cat-count-pre: CommandPickerState.cat-count-pre;
            cat-count-seg: CommandPickerState.cat-count-seg;
            cat-count-obj: CommandPickerState.cat-count-obj;
            cat-count-cls: CommandPickerState.cat-count-cls;
            cat-count-mea: CommandPickerState.cat-count-mea;
            cat-count-fav: CommandPickerState.cat-count-fav;
            query <=> CommandPickerState.query;
            fcat-pre <=> CommandPickerState.fcat-pre;
            fcat-seg <=> CommandPickerState.fcat-seg;
            fcat-obj <=> CommandPickerState.fcat-obj;
            fcat-mea <=> CommandPickerState.fcat-mea;
            fcat-cls <=> CommandPickerState.fcat-cls;
            filter-favorites <=> CommandPickerState.filter-favorites;
            selected-id <=> CommandPickerState.selected-id;
            query-changed(t) => {
                CommandPickerState.query-changed(t);
            }
            select(id) => {
                CommandPickerState.select(id);
            }
            confirm(id) => {
                CommandPickerState.confirm(id);
            }
            cancel => {
                CommandPickerState.cancel();
            }
            import-bioimageio => {
                CommandPickerState.import-bioimageio();
            }
        }
        if (GlobalAppState.active_dialog == DialogType.pipeline-edit): PipelineEditDialog {
            width: 100%;
            height: 100%;
        }
        if (GlobalAppState.active_dialog == DialogType.pipeline-delete-confirm): PipelineDeleteConfirmDialog {
            width: 100%;
            height: 100%;
        }
        if (GlobalAppState.active_dialog == DialogType.pipeline-running): PipelineRunningDialog {
            width: 100%;
            height: 100%;
        }
        if (GlobalAppState.active_dialog == DialogType.warning): WarningDialog {
            width: 100%;
            height: 100%;
        }
        if (GlobalAppState.active_dialog == DialogType.template-meta): TemplateMetaDialog {
            width: 100%;
            height: 100%;
        }
        if (GlobalAppState.active_dialog == DialogType.project-template): ProjectTemplateDialog {
            width: 100%;
            height: 100%;
        }
        if (GlobalAppState.active_dialog == DialogType.unsaved-changes-confirm): UnsavedChangesDialog {
            width: 100%;
            height: 100%;
        }
        if (GlobalAppState.active_dialog == DialogType.run-analysis-confirm): RunAnalysisDialog {
            width: 100%;
            height: 100%;
        }
        if (GlobalAppState.active_dialog == DialogType.ai-learning): AiLearningDialog {
            width: 100%;
            height: 100%;
        }
    }
}
