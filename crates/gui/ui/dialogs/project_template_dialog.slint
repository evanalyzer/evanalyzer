// project_template_dialog.slint
// EVAnalyzer - "New from Project Template" dialog.
//
// Opens from File > New from Template…. Lets the user pick one of the
// project templates found in the user/app templates folders. Confirming
// replaces the classification, plate and pipeline settings of the
// currently open project with the ones from the selected template.
//
// Layout (880 x 560, centered modal):
//
//   ┌------------------------------------------------------------------┐
//   │  New from Project Template                                   ✕   │   ← the Dialog's head
//   ├------------------------------------------------------------------┤
//   │  [ category ▾ ]  [ search… ]                                     │   ← filter bar
//   ├----------------------------┬-------------------------------------┤
//   │ □ Nucleus Counting          │   Nucleus Counting                  │
//   │ □ Cell Migration            │   ------------------------------    │
//   │ □ Wound Healing             │   Counts and measures nuclei in...  │   ← list  +  detail
//   │                             │                                     │     pane (split)
//   │                             │   Author        Jane Doe            │
//   │                             │   Organization  Acme Labs           │
//   │                             │   Pipelines     2                   │
//   ├----------------------------┴-------------------------------------┤
//   │ Replaces the current pipelines…       [ Cancel ] [ Use Template ] │   ← DialogFooter
//   └------------------------------------------------------------------┘
//
// Host wires:
//   - templates : [ProjectTemplateDef]
//   confirm(int)  -> apply this template to the current project
//   cancel().
import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { ProjectTemplateDef, ProjectTemplateState, ProjectTemplateStyle } from "../api/project_template.slint";

import { ScrollView } from "std-widgets.slint";
import { ComboBox } from "../ink/std_compat.slint";
import { Ink } from "../ink/palette.slint";
// ---------- Local visual constants ----------
// ---------- One row in the template list ----------

component ProjectTemplateRow inherits Rectangle {
    in property <ProjectTemplateDef> tmpl;
    in property <bool> selected: false;
    callback clicked;
    callback double-clicked;

    height: ProjectTemplateStyle.row-h;
    background: selected ? Ink.raised : (ta.has-hover ? Ink.ground.with-alpha(0.5) : transparent);
    border-radius: 6px;
    border-width: 1px;
    border-color: selected ? Ink.border : transparent;

    // accent stripe
    Rectangle {
        x: 4px;
        y: 6px;
        width: 3px;
        height: parent.height - 12px;
        background: Ink.focus;
        border-radius: 1.5px;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        spacing: 10px;
        alignment: stretch;

        // icon glyph
        Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - 28px) / 2;
            border-radius: 5px;
            background: Ink.ground;
            border-width: 1px;
            border-color: Ink.border-soft;
            Image {
                source: @image-url("../icons/regular-black/package.svg");
                width: 14px;
                height: 14px;
                colorize: Ink.text-dim;
            }
        }

        // name + summary
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: tmpl.name;
                color: Ink.text;
                font-size: 12.5px;
                font-weight: 500;
                overflow: elide;
            }

            Text {
                text: tmpl.short-description;
                color: Ink.text-mute;
                font-size: 10.5px;
                font-family: Ink.font-mono;
                overflow: elide;
            }
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }
}

// ---------- Detail pane (right side) ----------

component ProjectTemplateDetailPane inherits Rectangle {
    in property <ProjectTemplateDef> tmpl;
    in property <bool> has-selection: false;

    background: Ink.ground;

    if !has-selection: VerticalLayout {
        alignment: center;
        spacing: 10px;
        Text {
            text: "◇";
            color: Ink.text-faint;
            font-size: 28px;
            horizontal-alignment: center;
        }

        Text {
            text: "Pick a template";
            color: Ink.text-dim;
            font-size: 12px;
            horizontal-alignment: center;
        }
    }

    if has-selection: VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 20px;
        spacing: 16px;

        // Category eyebrow
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 1.5px;
                background: Ink.focus;
                y: (parent.height - 6px) / 2;
            }

            Text {
                text: "PROJECT TEMPLATE";
                color: Ink.focus;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.6px;
                vertical-alignment: center;
            }
        }

        // Title
        Text {
            text: tmpl.name;
            color: Ink.text;
            font-size: 20px;
            font-weight: 600;
        }

        // Summary
        Text {
            text: tmpl.short-description;
            color: Ink.text-dim;
            font-size: 12.5px;
            wrap: word-wrap;
        }

        // Divider
        Rectangle {
            height: 1px;
            background: Ink.border-soft;
        }

        // Description body
        Text {
            text: tmpl.description;
            color: Ink.text-dim;
            font-size: 12px;
            wrap: word-wrap;
        }

        Rectangle {
            vertical-stretch: 1;
        }   // spacer

        // Footer metadata
        Rectangle {
            height: 1px;
            background: Ink.border-soft;
        }

        VerticalLayout {
            spacing: 4px;
            if tmpl.authors.length > 0: HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: "Author";
                    color: Ink.text-mute;
                    font-size: 10.5px;
                }

                Text {
                    text: tmpl.authors[0].full-name + " (" + tmpl.authors[0].organization + ")";
                    color: Ink.text-dim;
                    font-size: 10.5px;
                    font-family: Ink.font-mono;
                    overflow: elide;
                }
            }

            if tmpl.authors.length > 1: VerticalLayout {
                spacing: 4px;
                alignment: space-between;
                for author[index] in tmpl.authors: HorizontalLayout {
                    if index > 0: HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;

                        Text {
                            text: index == 1 ? "Co-authors" : "";
                            color: Ink.text-mute;
                            font-size: 10.5px;
                        }

                        Text {
                            text: author.full-name + " (" + author.organization + ")";
                            color: Ink.text-dim;
                            font-size: 10.5px;
                            font-family: Ink.font-mono;
                            overflow: elide;
                        }
                    }
                }
            }

            if tmpl.creation-time != "": HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: "Created";
                    color: Ink.text-mute;
                    font-size: 10.5px;
                }

                Text {
                    text: tmpl.creation-time;
                    color: Ink.text-dim;
                    font-size: 10.5px;
                    font-family: Ink.font-mono;
                    overflow: elide;
                }
            }

            if tmpl.category != "": HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: "Category";
                    color: Ink.text-mute;
                    font-size: 10.5px;
                }

                Text {
                    text: tmpl.category;
                    color: Ink.text-dim;
                    font-size: 10.5px;
                    font-family: Ink.font-mono;
                    overflow: elide;
                }
            }

            if tmpl.tags.length > 0: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for t in tmpl.tags: Rectangle {
                    height: 18px;
                    border-radius: 9px;
                    background: Ink.raised;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: t;
                            color: Ink.text-dim;
                            font-size: 9.5px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: "Pipelines";
                    color: Ink.text-mute;
                    font-size: 10.5px;
                }

                Text {
                    text: "\{tmpl.pipeline-count}";
                    color: Ink.text-faint;
                    font-size: 10.5px;
                    font-family: Ink.font-mono;
                }
            }
        }
    }
}

    // ===========================================================================
// Main dialog
// ===========================================================================

export component ProjectTemplateDialog inherits InkDialog {
    title: "New from Project Template";
    card-width: ProjectTemplateStyle.modal-w;
    card-height: ProjectTemplateStyle.modal-h;
    content-padding: 0px;
    close-on-backdrop: true;
    close => {
        ProjectTemplateState.cancel();
    }

    init => {
        kbd.focus();
    }

    // Esc cancels, Enter uses the selected template.
    kbd := FocusScope {
        vertical-stretch: 1;
        key-pressed(e) => {
            if e.text == Key.Escape {
                ProjectTemplateState.cancel();
                return accept;
            }
            if e.text == Key.Return && ProjectTemplateState.selected-id != -1 {
                ProjectTemplateState.confirm(ProjectTemplateState.selected-id);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0;

            // ---------- 1b. Filter bar - category + tags ----------
            Rectangle {
                height: 46px;
                background: Ink.panel;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: 1px;
                    background: Ink.border-soft;
                }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 10px;
                    // No explicit `alignment` here (default is `stretch`): the
                    // category combo and divider keep their natural width, and
                    // the tag scroll area's `horizontal-stretch: 1` lets it
                    // claim the rest of the bar instead of collapsing to its
                    // minimum width.

                    // Wrapped in a VerticalLayout so it's vertically centered
                    // against the (differently-sized) tag chips, matching the
                    // centering trick used for the header title above.
                    VerticalLayout {
                        alignment: center;
                        cat-combo := ComboBox {
                            width: 190px;
                            model: ProjectTemplateState.categories;
                            selected(v) => {
                                ProjectTemplateState.select-category(v);
                            }
                        }
                    }

                    Rectangle {
                        width: 1px;
                        height: 18px;
                        y: (parent.height - 18px) / 2;
                        background: Ink.border-soft;
                    }

                    // Tags can outnumber the available width; scroll
                    // horizontally instead of running off the edge of the
                    // dialog where they'd be unreachable.
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        // 22px for the chip row + 14px so the horizontal
                        // scrollbar (an overlay pinned to the bottom of the
                        // viewport) has its own room instead of covering
                        // half the chips.
                        ScrollView {
                            height: 36px;
                            vertical-scrollbar-policy: always-off;
                            horizontal-scrollbar-policy: as-needed;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for chip in ProjectTemplateState.tag-chips: Rectangle {
                                    height: 22px;
                                    border-radius: 11px;
                                    border-width: 1px;
                                    border-color: chip.active ? Ink.focus : Ink.border-soft;
                                    background: chip.active ? Ink.focus.with-alpha(0.14) : (tag-ta.has-hover ? Ink.raised : transparent);
                                    animate background, border-color { duration: 100ms; }

                                    HorizontalLayout {
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        Text {
                                            text: chip.name;
                                            color: chip.active ? Ink.focus : Ink.text-dim;
                                            font-size: 10.5px;
                                            font-weight: chip.active ? 600 : 400;
                                            vertical-alignment: center;
                                        }
                                    }

                                    tag-ta := TouchArea {
                                        clicked => {
                                            ProjectTemplateState.toggle-tag(chip.name);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Ink.border-soft;
                }
            }

            // ---------- 2. Body - split list + detail ----------
            Rectangle {
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: 0;
                    alignment: stretch;

                    // LIST
                    Rectangle {
                        width: ProjectTemplateStyle.list-col-w;
                        background: Ink.panel;

                        ScrollView {
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 12px;
                                spacing: 0;

                                if ProjectTemplateState.templates.length == 0: VerticalLayout {
                                    padding-top: 60px;
                                    spacing: 10px;
                                    Text {
                                        text: ProjectTemplateState.filters-active ? "No templates match this filter" : "No project templates found";
                                        color: Ink.text-dim;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: ProjectTemplateState.filters-active ? "Try a different category or tag" : "Save a project as template to see it here";
                                        color: Ink.text-mute;
                                        font-size: 10.5px;
                                        font-family: Ink.font-mono;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }

                                for t in ProjectTemplateState.templates: ProjectTemplateRow {
                                    tmpl: t;
                                    selected: t.id == ProjectTemplateState.selected-id;
                                    clicked => {
                                        ProjectTemplateState.selected-id = t.id;
                                        ProjectTemplateState.select(t.id);
                                    }
                                    double-clicked => {
                                        ProjectTemplateState.confirm(t.id);
                                    }
                                }
                            }
                        }
                    }

                    // Splitter
                    Rectangle {
                        width: 1px;
                        background: Ink.border-soft;
                    }

                    // DETAIL
                    ProjectTemplateDetailPane {
                        horizontal-stretch: 1;
                        tmpl: ProjectTemplateState.detail;
                        has-selection: ProjectTemplateState.has-detail;
                    }
                }
            }

            // ---------- 3. Footer ----------
            Rectangle {
                height: 1px;
                background: Ink.border-soft;
            }

            Rectangle {
                background: Ink.ground;

                // The dialog's buttons; this dialog pads its own content.
                HorizontalLayout {
                    alignment: end;
                    spacing: 6px;
                    padding-left: Ink.pad-dialog;
                    padding-right: Ink.pad-dialog;
                    padding-top: 10px;
                    padding-bottom: 10px;

                    Text {
                        text: "Replaces the current pipelines, classes and plate settings";
                        color: Ink.text-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    InkButton {
                        text: "Cancel";
                        clicked => {
                            ProjectTemplateState.cancel();
                        }
                    }

                    InkButton {
                        kind: InkButtonKind.primary;
                        text: "Use Template";
                        enabled: ProjectTemplateState.selected-id != -1;
                        clicked => {
                            if ProjectTemplateState.selected-id != -1 {
                                ProjectTemplateState.confirm(ProjectTemplateState.selected-id);
                            }
                        }
                    }
                }
            }
        }
    }
}
