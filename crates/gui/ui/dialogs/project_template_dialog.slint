// project_template_dialog.slint — "New from template": pick one of the
// project templates found in the user/app templates folders. Confirming
// replaces the classification, plate and pipeline settings of the open
// project with the template's.
//
//   [ category ▾ ] tags…
//   templates list        │ the chosen one: name, summary, description,
//                         │ authors, created, category, tags, pipelines
//   Replaces the current pipelines…            [ Cancel ] [ Use template ]
//
// Host wires: templates, detail; select(int), confirm(int), cancel(),
// select-category(string), toggle-tag(string).
import { InkButton, InkButtonKind, InkCaption, InkChip, InkDialog, InkDialogFooter, InkDivider, InkHint, InkIcons, InkLabel, InkListRow, InkDialogPlacement } from "../ink/ink.slint";
import { ProjectTemplateDef, ProjectTemplateState, ProjectTemplateStyle } from "../api/project_template.slint";

import { ScrollView } from "std-widgets.slint";
import { ComboBox } from "../ink/std_compat.slint";
import { Ink } from "../ink/palette.slint";

// A line of the detail pane: what, then the value.
component MetaLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    InkLabel {
        text: root.label;
    }

    Text {
        horizontal-stretch: 1;
        text: root.value;
        font-size: Ink.fs-sm;
        color: Ink.text-dim;
        vertical-alignment: center;
        overflow: elide;
    }
}

// The chosen template.
component ProjectTemplateDetailPane inherits Rectangle {
    in property <ProjectTemplateDef> tmpl;
    in property <bool> has-selection: false;

    if !root.has-selection: VerticalLayout {
        alignment: center;
        spacing: 8px;
        Image {
            source: InkIcons.component;
            height: 22px;
            colorize: Ink.text-faint;
        }

        InkHint {
            text: "Pick a template";
            horizontal-alignment: center;
        }
    }

    if root.has-selection: VerticalLayout {
        padding: 20px;
        spacing: 10px;

        InkCaption {
            text: "PROJECT TEMPLATE";
        }

        Text {
            text: root.tmpl.name;
            color: Ink.text;
            font-size: Ink.fs-title;
            font-weight: 600;
            wrap: word-wrap;
        }

        if root.tmpl.short-description != "": Text {
            text: root.tmpl.short-description;
            color: Ink.text-dim;
            font-size: Ink.fs-md;
            wrap: word-wrap;
        }

        if root.tmpl.description != "": ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                Text {
                    text: root.tmpl.description;
                    color: Ink.text-dim;
                    font-size: Ink.fs-md;
                    wrap: word-wrap;
                }
            }
        }

        if root.tmpl.description == "": Rectangle {
            vertical-stretch: 1;
        }

        InkDivider { }

        VerticalLayout {
            spacing: 4px;
            for author[i] in root.tmpl.authors: MetaLine {
                label: i == 0 ? (root.tmpl.authors.length > 1 ? "Authors" : "Author") : "";
                value: author.organization == "" ? author.full-name : author.full-name + " · " + author.organization;
            }
            if root.tmpl.creation-time != "": MetaLine {
                label: "Created";
                value: root.tmpl.creation-time;
            }
            if root.tmpl.category != "": MetaLine {
                label: "Category";
                value: root.tmpl.category;
            }
            MetaLine {
                label: "Pipelines";
                value: root.tmpl.pipeline-count;
            }
        }

        if root.tmpl.tags.length > 0: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for t in root.tmpl.tags: InkChip {
                text: t;
            }
        }
    }
}

export component ProjectTemplateDialog inherits InkDialog {
    title: "New from template";
    card-width: ProjectTemplateStyle.modal-w;
    card-height: ProjectTemplateStyle.modal-h;
    content-padding: 0px;
    close-on-backdrop: true;
    close => {
        ProjectTemplateState.cancel();
    }

    init => {
        kbd.focus();
    }

    // Esc cancels, Enter uses the selected template.
    kbd := FocusScope {
        vertical-stretch: 1;
        key-pressed(e) => {
            if e.text == Key.Escape {
                ProjectTemplateState.cancel();
                return accept;
            }
            if e.text == Key.Return && ProjectTemplateState.selected-id != -1 {
                ProjectTemplateState.confirm(ProjectTemplateState.selected-id);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0;

            // -- Filter: category, tags --
            HorizontalLayout {
                height: 44px;
                padding-left: Ink.pad-dialog;
                padding-right: Ink.pad-dialog;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    ComboBox {
                        width: 190px;
                        // "All categories" first.
                        current-index: 0;
                        model: ProjectTemplateState.categories;
                        selected(v) => {
                            ProjectTemplateState.select-category(v);
                        }
                    }
                }

                // Tags can outnumber the width: they scroll.
                ScrollView {
                    horizontal-stretch: 1;
                    vertical-scrollbar-policy: always-off;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        padding-top: 11px;
                        padding-bottom: 11px;
                        for chip in ProjectTemplateState.tag-chips: InkChip {
                            text: chip.name;
                            selected: chip.active;
                            clicked => {
                                ProjectTemplateState.toggle-tag(chip.name);
                            }
                        }
                    }
                }
            }

            InkDivider { }

            // -- The templates, the chosen one --
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0;

                ScrollView {
                    width: ProjectTemplateStyle.list-col-w;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        alignment: start;

                        if ProjectTemplateState.templates.length == 0: VerticalLayout {
                            padding-top: 60px;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            Text {
                                text: ProjectTemplateState.filters-active ? "No template matches" : "No project templates yet";
                                color: Ink.text-dim;
                                font-size: Ink.fs-md;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }

                            InkHint {
                                text: ProjectTemplateState.filters-active ? "Try another category or tag." : "EVA › Save as template… saves a project as one.";
                                horizontal-alignment: center;
                            }
                        }

                        for t in ProjectTemplateState.templates: InkListRow {
                            height: 44px;
                            icon: InkIcons.component;
                            title: t.name;
                            subtitle: t.short-description;
                            selected: t.id == ProjectTemplateState.selected-id;
                            clicked => {
                                ProjectTemplateState.selected-id = t.id;
                                ProjectTemplateState.select(t.id);
                            }
                            double-clicked => {
                                ProjectTemplateState.confirm(t.id);
                            }
                        }
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Ink.border-soft;
                }

                ProjectTemplateDetailPane {
                    horizontal-stretch: 1;
                    tmpl: ProjectTemplateState.detail;
                    has-selection: ProjectTemplateState.has-detail;
                }
            }

            // -- Footer (this dialog pads its own content) --
            VerticalLayout {
                padding-left: Ink.pad-dialog;
                padding-right: Ink.pad-dialog;
                InkDialogFooter {
                    InkHint {
                        horizontal-stretch: 1;
                        text: "Replaces the current pipelines, classes and plate settings.";
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    InkButton {
                        text: "Cancel";
                        clicked => {
                            ProjectTemplateState.cancel();
                        }
                    }

                    InkButton {
                        kind: InkButtonKind.primary;
                        text: "Use template";
                        enabled: ProjectTemplateState.selected-id != -1;
                        clicked => {
                            if ProjectTemplateState.selected-id != -1 {
                                ProjectTemplateState.confirm(ProjectTemplateState.selected-id);
                            }
                        }
                    }
                }
            }
        }
    }
}
