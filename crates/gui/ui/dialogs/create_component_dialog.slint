import { LineEdit, ComboBox, ScrollView, TextEdit } from "std-widgets.slint";
import {
    NavItem,
    SectionHeader,
    SettingsCard,
    SettingRow,
    SettingBlock,
} from "../components/settings_layout.slint";
import { AppButton } from "../components/app_button.slint";
import { Theme } from "../style.slint";

// "Create component": turns consecutive steps of a pipeline into a component.
// The host fills the class list with suggested roles (see
// `evanalyzer_app::components::plan_component`) and recomputes it when the range
// changes.

// -- Global state --------------------------------------------

/// A project class the steps use, and what it becomes in the component.
export struct ComponentClassRow {
    /// The class in its text form ("3") - how the host knows which it is.
    class-text: string,
    name: string,
    /// "Only used by these steps" / "Also used elsewhere".
    detail: string,
    /// 0 = internal (the component's own), 1 = component parameter, 2 = fixed.
    role: int,
}

export global CreateComponentState {
    in property <int> pipeline-id: 0;
    /// "1 · Threshold", "2 · Extract Objects", ... - for the range pickers.
    in property <[string]> step-names: [];
    in-out property <int> from-step: 0;
    in-out property <int> to-step: 0;
    in-out property <string> name: "";
    in property <[ComponentClassRow]> classes: [];
    /// "Channel 1 becomes a component parameter", or empty.
    in property <string> channels-text: "";
    /// Why the component can't be made, or empty.
    in property <string> error: "";
    callback range-changed(int, int);
    callback role-changed(int, int);
    callback confirm();
    callback cancel();
}

component RangeRow inherits HorizontalLayout {
    in property <string> label;
    in property <[string]> model;
    in property <int> current;
    callback picked(int);

    spacing: 8px;
    Text {
        text: label;
        width: 40px;
        font-size: 11px;
        color: Theme.text-dim;
        vertical-alignment: center;
    }

    ComboBox {
        horizontal-stretch: 1;
        model: root.model;
        current-index: root.current;
        selected(v) => {
            root.picked(self.current-index);
        }
    }
}

// -- Dialog component -----------------------------------------

export component CreateComponentDialog inherits Rectangle {
    background: Theme.modal-overlay;

    TouchArea {
        clicked => {
            CreateComponentState.cancel();
        }
    }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 480px;
        background: Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 12px;
        clip: true;

        TouchArea { }

        layout := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Create component";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                }

                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    background: close-ta.has-hover ? Theme.raised : transparent;
                    Text {
                        text: "✕";
                        font-size: 12px;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            CreateComponentState.cancel();
                        }
                    }
                }
            }

            Text {
                text: "The steps become one step - a component you can use like a command, in this and other pipelines.";
                font-size: 11px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 5px;
                Text {
                    text: "Component name";
                    font-size: 11px;
                    color: Theme.text-dim;
                }

                LineEdit {
                    height: 30px;
                    text: CreateComponentState.name;
                    placeholder-text: "e.g. Cell reconstruction";
                    font-size: 12px;
                    edited(t) => {
                        CreateComponentState.name = t;
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;
                RangeRow {
                    label: "From";
                    model: CreateComponentState.step-names;
                    current: CreateComponentState.from-step;
                    picked(i) => {
                        CreateComponentState.range-changed(i, CreateComponentState.to-step);
                    }
                }

                RangeRow {
                    label: "To";
                    model: CreateComponentState.step-names;
                    current: CreateComponentState.to-step;
                    picked(i) => {
                        CreateComponentState.range-changed(CreateComponentState.from-step, i);
                    }
                }
            }

            if CreateComponentState.classes.length > 0: VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Classes";
                    font-size: 11px;
                    color: Theme.text-dim;
                }

                for row[i] in CreateComponentState.classes: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: row.name;
                            font-size: 12px;
                            color: Theme.text;
                        }

                        Text {
                            text: row.detail;
                            font-size: 10px;
                            color: Theme.text-mute;
                        }
                    }

                    ComboBox {
                        width: 190px;
                        model: ["Internal (component only)", "Component parameter", "Fixed"];
                        current-index: row.role;
                        selected(v) => {
                            CreateComponentState.role-changed(i, self.current-index);
                        }
                    }
                }

                Text {
                    text: "Internal classes are the component's own: each use of the component has its own, and their objects don't reach the results.";
                    font-size: 10px;
                    color: Theme.text-mute;
                    wrap: word-wrap;
                }
            }

            if CreateComponentState.channels-text != "": Text {
                text: CreateComponentState.channels-text;
                font-size: 11px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }

            if CreateComponentState.error != "": Text {
                text: CreateComponentState.error;
                font-size: 11px;
                color: Theme.err;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                AppButton {
                    text: "Cancel";
                    clicked => {
                        CreateComponentState.cancel();
                    }
                }

                AppButton {
                    text: "Create component";
                    primary: true;
                    clicked => {
                        CreateComponentState.confirm();
                    }
                }
            }
        }

        height: layout.preferred-height;
    }
}

// -- "Edit for all" or "Only this step" -------------------------

/// Asked when opening a component that other steps use too.
export global ComponentEditChoiceState {
    in property <int> pipeline-id: 0;
    in property <int> step-idx: 0;
    in property <string> component-name: "";
    in property <int> uses: 0;
    callback edit-all();
    callback only-this();
    callback cancel();
}

export component ComponentEditChoiceDialog inherits Rectangle {
    background: Theme.modal-overlay;

    TouchArea {
        clicked => {
            ComponentEditChoiceState.cancel();
        }
    }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        background: Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 12px;
        clip: true;

        TouchArea { }

        layout := VerticalLayout {
            padding: 24px;
            spacing: 14px;

            Text {
                text: "Open \{ComponentEditChoiceState.component-name}";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
            }

            Text {
                text: "This component is used by \{ComponentEditChoiceState.uses} steps. Changes to it apply to all of them - or make a copy just for this step.";
                font-size: 11px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                AppButton {
                    text: "Cancel";
                    clicked => {
                        ComponentEditChoiceState.cancel();
                    }
                }

                AppButton {
                    text: "Only this step";
                    clicked => {
                        ComponentEditChoiceState.only-this();
                    }
                }

                AppButton {
                    text: "Edit for all";
                    primary: true;
                    clicked => {
                        ComponentEditChoiceState.edit-all();
                    }
                }
            }
        }

        height: layout.preferred-height;
    }
}

// -- Expose a setting: a new parameter, or one that exists -------

/// Asked when exposing a setting that existing component parameters could set
/// too (same kind of setting).
export global ExposeChoiceState {
    in property <string> setting-name: "";
    /// "New parameter", then "Add to “Cell class”", ...
    in property <[string]> choices: [];
    /// For each choice, what that parameter sets already ("sets #2 EV
    /// Detection › Output class"), or empty.
    in property <[string]> details: [];
    callback chosen(int);
    callback cancel();
}

export component ExposeChoiceDialog inherits Rectangle {
    background: Theme.modal-overlay;

    TouchArea {
        clicked => {
            ExposeChoiceState.cancel();
        }
    }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(460px, parent.width - 48px);
        background: Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 12px;
        clip: true;

        TouchArea { }

        layout := VerticalLayout {
            padding: 24px;
            spacing: 10px;

            Text {
                text: "Expose \{ExposeChoiceState.setting-name}";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
            }

            Text {
                text: "As a parameter of its own, or set by a parameter the component has already:";
                font-size: 11px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }

            if ExposeChoiceState.choices.length > 0: AppButton {
                text: ExposeChoiceState.choices[0];
                primary: true;
                clicked => {
                    ExposeChoiceState.chosen(0);
                }
            }

            // An existing parameter: its name, and below what it sets already -
            // parameters of equal steps are often named alike.
            for choice[i] in ExposeChoiceState.choices: Rectangle {
                visible: i > 0;
                height: i > 0 ? self.preferred-height : 0px;
                border-radius: 8px;
                border-width: 1px;
                border-color: choice-ta.has-hover ? Theme.accent : Theme.border;
                background: choice-ta.has-hover ? Theme.raised : Theme.bg;
                accessible-role: button;
                accessible-label: choice;

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 2px;
                    Text {
                        text: choice;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }

                    if ExposeChoiceState.details[i] != "": Text {
                        text: ExposeChoiceState.details[i];
                        font-size: 11px;
                        color: Theme.text-dim;
                        overflow: elide;
                    }
                }

                choice-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ExposeChoiceState.chosen(i);
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                AppButton {
                    text: "Cancel";
                    clicked => {
                        ExposeChoiceState.cancel();
                    }
                }
            }
        }

        height: layout.preferred-height;
    }
}

// -- Update a component from the library -------------------------------

export global ComponentUpdateState {
    in property <string> component-name: "";
    /// "v1 → v3"
    in property <string> versions: "";
    /// The project changed the component since it was inserted - the update
    /// replaces those changes.
    in property <bool> changed-here: false;
    callback confirm();
    callback cancel();
}

export component ComponentUpdateDialog inherits Rectangle {
    background: Theme.modal-overlay;

    TouchArea {
        clicked => {
            ComponentUpdateState.cancel();
        }
    }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        background: Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 12px;
        clip: true;

        TouchArea { }

        layout := VerticalLayout {
            padding: 24px;
            spacing: 12px;

            Text {
                text: "Update \{ComponentUpdateState.component-name}";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
            }

            Text {
                text: "The component library has a newer version (\{ComponentUpdateState.versions}). Every step using the component gets it; their values stay.";
                font-size: 11px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }

            if ComponentUpdateState.changed-here: Text {
                text: "This project changed the component since it was inserted - updating replaces those changes.";
                font-size: 11px;
                color: Theme.warn;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                AppButton {
                    text: "Cancel";
                    clicked => {
                        ComponentUpdateState.cancel();
                    }
                }

                AppButton {
                    text: "Update";
                    primary: true;
                    clicked => {
                        ComponentUpdateState.confirm();
                    }
                }
            }
        }

        height: layout.preferred-height;
    }
}

// -- Component settings ------------------------------------------------

/// A setting a parameter sets.
export struct ComponentBindingRow {
    /// "#2 EV Detection › Output class"
    text: string,
    step-id: int,
    path: string,
}

/// A parameter of the component, as it shows on the component card.
export struct ComponentParamRow {
    // The parameter's key ("min_size").
    key: string,
    label: string,
    description: string,
    /// The default value, as text.
    default-value: string,
    /// The help text of the setting it's bound to - shown while
    /// `description` is empty.
    default-description: string,
    /// What it sets: "Blur › Kernel size, Blur › Kernel size".
    sets: string,
    /// The section it's shown in on the component card; empty: none.
    section: string,
    /// What it sets, one by one.
    bindings: [ComponentBindingRow],
    /// "Also set…", then the settings it could also set (same control, set
    /// by no parameter yet) - empty if there are none.
    addable: [string],
}

/// The opened component's name, descriptions and parameters (name, help text,
/// order). Opened from "Settings…" in the bar of a component opened to edit, or
/// from ✎ on an exposed setting (`focus-index` is then that parameter's
/// row).
export global ComponentSettingsState {
    in property <string> name: "";
    /// One line, shown in the command picker.
    in property <string> description: "";
    /// The full description, shown with the short one behind the component
    /// card's "?".
    in property <string> long-description: "";
    /// The first author - shown in the command picker.
    in property <string> author-name: "";
    in property <string> author-organization: "";
    in property <[ComponentParamRow]> parameters: [];
    /// The row to scroll to and highlight, or -1.
    in property <int> focus-index: -1;
    callback name-edited(string);
    callback description-edited(string);
    callback long-description-edited(string);
    /// name, organization
    callback author-edited(string, string);
    /// key, name - the help text stays (the rows aren't refreshed while
    /// typing, so passing both would undo the other field's edit).
    callback parameter-name-edited(string, string);
    /// key, help text
    callback parameter-help-edited(string, string);
    /// key, section on the component card (empty: none)
    callback parameter-section-edited(string, string);
    /// key, -1 up / +1 down
    callback parameter-moved(string, int);
    /// key: back to the bound setting's own help text.
    callback parameter-help-reset(string);
    /// key: stop exposing it - its settings go back to the component's values.
    callback parameter-removed(string);
    /// key, step id, path: it no longer sets that setting.
    callback binding-removed(string, int, string);
    /// key, index into its `addable` (after "Also set…"): it sets that
    /// setting too.
    callback binding-added(string, int);
    /// ✎: parameter `key` is opened to edit - what changes from now on can be
    /// undone with Cancel.
    callback parameter-edit-started(string);
    /// Apply: keep the changes made since ✎.
    callback parameter-edit-applied();
    /// Cancel: undo the changes made since ✎.
    callback parameter-edit-cancelled();
    callback close();
}

// A small icon button of a parameter row (↑ ↓ ✎ ✕).
component RowButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <string> tooltip;
    callback clicked;

    width: 24px;
    height: 24px;
    border-radius: 4px;
    opacity: root.enabled ? 1 : 0.3;
    background: ta.has-hover && root.enabled ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: root.tooltip;

    Text {
        text: root.text;
        font-size: 12px;
        color: ta.has-hover && root.danger ? Theme.warn : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A parameter's row: name, section, help and what it sets on the left; its
// default and ↑ ↓ ✎ ✕ on the right. While a parameter is opened to edit
// (`editing`), the rows' buttons wait for its Apply or Cancel.
component ParamHeader inherits Rectangle {
    in property <ComponentParamRow> param;
    in property <int> index;
    in property <int> editing: -1;
    callback edit;

    property <bool> free: root.editing < 0;

    background: root.index == root.editing ? Theme.cat-component.with-alpha(0.06) : transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        spacing: 16px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.param.label;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }

                if root.param.section != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 16px;
                        width: section-text.preferred-width + 12px;
                        border-radius: 8px;
                        background: Theme.raised;
                        section-text := Text {
                            text: root.param.section;
                            font-size: 10px;
                            color: Theme.text-dim;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            Text {
                text: root.param.description != "" ? root.param.description : (root.param.default-description != "" ? root.param.default-description : "No help text");
                font-size: 11px;
                color: root.param.description != "" ? Theme.text-dim : Theme.text-mute;
                overflow: elide;
            }

            Text {
                text: "sets \{root.param.sets}";
                font-size: 10px;
                color: Theme.text-mute;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 2px;
                Text {
                    text: "default \{root.param.default-value}";
                    font-size: 10px;
                    color: Theme.text-mute;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 6px;
                }

                RowButton {
                    text: "↑";
                    tooltip: "Move up";
                    enabled: root.free && root.index > 0;
                    clicked => {
                        ComponentSettingsState.parameter-moved(root.param.key, -1);
                    }
                }

                RowButton {
                    text: "↓";
                    tooltip: "Move down";
                    enabled: root.free && root.index < ComponentSettingsState.parameters.length - 1;
                    clicked => {
                        ComponentSettingsState.parameter-moved(root.param.key, 1);
                    }
                }

                RowButton {
                    text: "✎";
                    tooltip: "Edit parameter";
                    enabled: root.free;
                    clicked => {
                        root.edit();
                    }
                }

                RowButton {
                    text: "✕";
                    tooltip: "Remove parameter";
                    danger: true;
                    enabled: root.free;
                    clicked => {
                        ComponentSettingsState.parameter-removed(root.param.key);
                    }
                }
            }
        }
    }
}

// The component's name, descriptions and parameters - laid out like the
// project settings: sections on the left, rows of name/explanation and
// control on the right. Changes apply right away.
export component ComponentSettingsDialog inherits Rectangle {
    background: Theme.modal-overlay;

    // 0 General, 1 Parameters. ✎ on an exposed setting opens its parameter -
    // set once as the dialog opens (refills change `focus-index`).
    property <int> current-section: 0;
    // The parameter opened to edit (its name, help, section, what it sets).
    property <int> editing: -1;

    init => {
        if ComponentSettingsState.focus-index >= 0 {
            root.current-section = 1;
            root.editing = ComponentSettingsState.focus-index;
        }
    }
    // A closed parameter row's height - so the focused one can be scrolled to.
    property <length> row-height: 66px;
    // The opened parameter's editor height (below its header).
    property <length> edited-height: 0px;

    TouchArea {
        clicked => {
            ComponentSettingsState.close();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(860px, parent.width - 48px);
        height: min(620px, parent.height - 48px);
        background: Theme.bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 18px;
        clip: true;

        TouchArea { }

        VerticalLayout {
            spacing: 0;

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0;

                // -- Section list ----------------------------------------
                Rectangle {
                    width: 210px;
                    background: Theme.sidebar;

                    VerticalLayout {
                        padding: 16px;
                        padding-top: 18px;
                        spacing: 4px;

                        Text {
                            text: "Component settings";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        Text {
                            text: "◆ " + ComponentSettingsState.name;
                            font-size: 11px;
                            color: Theme.cat-component;
                            overflow: elide;
                        }

                        Rectangle {
                            height: 14px;
                        }

                        NavItem {
                            text: "General";
                            icon: @image-url("../icons/regular-black/info.svg");
                            active: root.current-section == 0;
                            clicked => {
                                root.current-section = 0;
                            }
                        }

                        NavItem {
                            text: "Parameters (\{ComponentSettingsState.parameters.length})";
                            icon: @image-url("../icons/regular-black/faders-horizontal.svg");
                            active: root.current-section == 1;
                            clicked => {
                                root.current-section = 1;
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }
                    }

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.border-soft;
                    }
                }

                // -- Settings --------------------------------------------
                if root.current-section == 0: ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding: 28px;
                        padding-top: 22px;
                        spacing: 14px;

                        SectionHeader {
                            title: "General";
                            scope: "Saved with the component";
                            subtitle: "What the component is called and does - shown in the command picker and behind the component card's ?.";
                        }

                        SettingsCard {
                            SettingRow {
                                label: "Name";
                                LineEdit {
                                    text: ComponentSettingsState.name;
                                    placeholder-text: "Component name";
                                    edited(t) => {
                                        ComponentSettingsState.name-edited(t);
                                    }
                                }
                            }

                            SettingRow {
                                label: "Short description";
                                description: "One line, shown in the command picker.";
                                LineEdit {
                                    text: ComponentSettingsState.description;
                                    placeholder-text: "What the component does";
                                    edited(t) => {
                                        ComponentSettingsState.description-edited(t);
                                    }
                                }
                            }

                            SettingRow {
                                label: "Author";
                                author-name-edit := LineEdit {
                                    text: ComponentSettingsState.author-name;
                                    placeholder-text: "Full name";
                                    edited(t) => {
                                        ComponentSettingsState.author-edited(t, author-organization-edit.text);
                                    }
                                }
                            }

                            SettingRow {
                                label: "Organization";
                                author-organization-edit := LineEdit {
                                    text: ComponentSettingsState.author-organization;
                                    placeholder-text: "Lab, institute, company";
                                    edited(t) => {
                                        ComponentSettingsState.author-edited(author-name-edit.text, t);
                                    }
                                }
                            }

                            SettingBlock {
                                label: "Description";
                                description: "How to use it, what it expects, references - shown behind the component card's ?.";
                                TextEdit {
                                    height: 96px;
                                    text: ComponentSettingsState.long-description;
                                    wrap: word-wrap;
                                    placeholder-text: "How to use it, what it expects, references…";
                                    edited(t) => {
                                        ComponentSettingsState.long-description-edited(t);
                                    }
                                }
                            }
                        }
                    }
                }

                if root.current-section == 1: VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 28px;
                    padding-top: 22px;
                    padding-bottom: 0px;
                    spacing: 14px;

                    SectionHeader {
                        title: "Parameters";
                        scope: "Saved with the component";
                        subtitle: ComponentSettingsState.parameters.length == 0 ? "None yet - ◇ next to a setting of the opened component shows it on the component card." : "Shown on the component card in this order. ✎ edits a parameter's name, help, section and what it sets.";
                    }

                    // The list, and the opened parameter's header pinned on top
                    // while its editor scrolls.
                    if ComponentSettingsState.parameters.length > 0: Rectangle {
                        vertical-stretch: 1;

                        list := ScrollView {
                            init => {
                                if ComponentSettingsState.focus-index > 0 {
                                    self.viewport-y = -ComponentSettingsState.focus-index * root.row-height;
                                }
                            }

                            VerticalLayout {
                                alignment: start;
                                padding-bottom: 20px;

                                SettingsCard {
                                    for param[pi] in ComponentSettingsState.parameters: VerticalLayout {
                                        // Divider, like a settings row.
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.border-soft;
                                        }

                                        ParamHeader {
                                            param: param;
                                            index: pi;
                                            editing: root.editing;
                                            height: root.row-height - 1px;
                                            edit => {
                                                ComponentSettingsState.parameter-edit-started(param.key);
                                                root.editing = pi;
                                            }
                                        }

                                    // -- The parameter, opened to edit --
                                        if pi == root.editing: VerticalLayout {
                                            // How tall the opened editor is - for the pinned
                                            // header (see `pinned`).
                                            changed height => {
                                                root.edited-height = self.height;
                                            }
                                            init => {
                                                root.edited-height = self.height;
                                            }
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            padding-bottom: 14px;
                                            spacing: 8px;

                                            SettingRow {
                                                label: "Name";
                                                description: "On the component card.";
                                                LineEdit {
                                                    text: param.label;
                                                    placeholder-text: "Name on the component card";
                                                    accessible-label: "Parameter name";
                                                    edited(t) => {
                                                        ComponentSettingsState.parameter-name-edited(param.key, t);
                                                    }
                                                }
                                            }

                                            SettingRow {
                                                label: "Section";
                                                description: "Groups parameters on the card (optional).";
                                                LineEdit {
                                                    text: param.section;
                                                    placeholder-text: "e.g. Detection";
                                                    accessible-label: "Parameter section";
                                                    edited(t) => {
                                                        ComponentSettingsState.parameter-section-edited(param.key, t);
                                                    }
                                                }
                                            }

                                            SettingBlock {
                                                label: "Help text";
                                                description: param.description == "" ? (param.default-description == "" ? "Shown as ? next to the parameter." : "Empty: the setting's own help is shown.") : "Shown as ? next to the parameter.";
                                                TextEdit {
                                                    height: 56px;
                                                    text: param.description;
                                                    wrap: word-wrap;
                                                    placeholder-text: param.default-description != "" ? param.default-description : "Help text, shown as ? next to the parameter";
                                                    accessible-label: "Parameter help text";
                                                    edited(t) => {
                                                        ComponentSettingsState.parameter-help-edited(param.key, t);
                                                    }
                                                }

                                                if param.description != "": HorizontalLayout {
                                                    alignment: start;
                                                    AppButton {
                                                        text: "Reset to the setting's own help";
                                                        clicked => {
                                                            ComponentSettingsState.parameter-help-reset(param.key);
                                                        }
                                                    }
                                                }
                                            }

                                            SettingBlock {
                                                label: "Sets";
                                                description: "The settings of the component's steps this parameter sets.";

                                                for binding in param.bindings: HorizontalLayout {
                                                    spacing: 6px;
                                                    height: 24px;
                                                    Text {
                                                        horizontal-stretch: 1;
                                                        text: binding.text;
                                                        font-size: 11px;
                                                        color: Theme.text;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }

                                                    RowButton {
                                                        text: "✕";
                                                        tooltip: "Stop setting \{binding.text}";
                                                        danger: true;
                                                        // The last one: remove the parameter instead.
                                                        enabled: param.bindings.length > 1;
                                                        clicked => {
                                                            ComponentSettingsState.binding-removed(param.key, binding.step-id, binding.path);
                                                        }
                                                    }
                                                }

                                                if param.addable.length > 1: also-set := ComboBox {
                                                    model: param.addable;
                                                    current-index: 0;
                                                    accessible-label: "Also set";
                                                    selected => {
                                                        if also-set.current-index > 0 {
                                                            ComponentSettingsState.binding-added(param.key, also-set.current-index - 1);
                                                            also-set.current-index = 0;
                                                        }
                                                    }
                                                }
                                            }

                                            // Keep or undo what was changed since ✎.
                                            HorizontalLayout {
                                                alignment: end;
                                                spacing: 8px;
                                                padding-top: 4px;
                                                AppButton {
                                                    text: "Cancel";
                                                    clicked => {
                                                        ComponentSettingsState.parameter-edit-cancelled();
                                                        root.editing = -1;
                                                    }
                                                }

                                                AppButton {
                                                    text: "Apply";
                                                    primary: true;
                                                    clicked => {
                                                        ComponentSettingsState.parameter-edit-applied();
                                                        root.editing = -1;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // The opened parameter's header, while its own is scrolled
                        // away and its editor still shows.
                        property <length> header-top: list.viewport-y + root.editing * root.row-height;
                        if root.editing >= 0 && self.header-top < 0 && self.header-top + root.row-height + root.edited-height > root.row-height: Rectangle {
                            y: 0;
                            height: root.row-height;
                            background: Theme.panel;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.cat-component.with-alpha(0.5);
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow;
                            accessible-role: none;
                            ParamHeader {
                                param: ComponentSettingsState.parameters[root.editing];
                                index: root.editing;
                                editing: root.editing;
                            }
                        }
                    }

                    if ComponentSettingsState.parameters.length == 0: Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }

            // -- Footer ----------------------------------------------------
            Rectangle {
                height: 56px;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border-soft;
                }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: end;
                    VerticalLayout {
                        alignment: center;
                        AppButton {
                            text: "Close";
                            primary: true;
                            clicked => {
                                ComponentSettingsState.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
