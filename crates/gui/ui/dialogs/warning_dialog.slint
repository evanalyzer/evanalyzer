import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { DialogType, GlobalAppState, WarningState } from "../api/state.slint";
import { ScrollView } from "std-widgets.slint";
import { Ink } from "../ink/palette.slint";

export component WarningDialog inherits InkDialog {
    title: WarningState.title;
    card-width: 440px;
    // Grow with the message - a long one scrolls inside (the dialog is never
    // taller than the window, so OK stays reachable).
    card-height: msg.preferred-height + 150px;
    close => {
        GlobalAppState.active_dialog = DialogType.none;
    }

    ScrollView {
        vertical-stretch: 1;

        msg := Text {
            width: root.card-width - 2 * Ink.pad-dialog;
            text: WarningState.message;
            wrap: word-wrap;
            color: Ink.text;
            font-size: Ink.fs-heading;
        }
    }

    InkDialogFooter {
        InkButton {
            kind: InkButtonKind.primary;
            text: "OK";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
            }
        }
    }
}
