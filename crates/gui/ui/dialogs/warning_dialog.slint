import { ScrollView } from "std-widgets.slint";
import { Dialog, DialogFooter, DialogTone } from "../components/new_components/dialog.slint";
import { AppButton } from "../components/app_button.slint";
import { Theme } from "../style.slint";
import {
    GlobalAppState,
    DialogType,
    WarningState,
} from "../state.slint";

export component WarningDialog inherits Dialog {
    title: WarningState.title;
    tone: WarningState.info ? DialogTone.info : DialogTone.warning;
    dialog-width: 440px;
    // Grow with the message - a long one scrolls inside (the dialog is never
    // taller than the window, so OK stays reachable).
    dialog-height: msg.preferred-height + 150px;
    close => {
        GlobalAppState.active_dialog = DialogType.none;
    }

    ScrollView {
        vertical-stretch: 1;

        msg := Text {
            width: root.dialog-width - 64px;
            text: WarningState.message;
            wrap: word-wrap;
            color: Theme.text;
            font-size: 13px;
        }
    }

    DialogFooter {
        AppButton {
            text: "OK";
            primary: true;
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
            }
        }
    }
}
