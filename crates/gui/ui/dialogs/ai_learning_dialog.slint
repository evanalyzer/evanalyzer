import { InkButton, InkButtonKind, InkCaption, InkDialog, InkDialogFooter, InkIcons, InkDialogPlacement, InkSegmented, InkHint, InkBanner, InkTone, InkDivider } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { AiLearningState, ClassSelectionRowSlint, FeatureRowSlint, ObjectMetricRowSlint, TrainingImageRowSlint, TrainingObjectRowSlint } from "../api/ai_learning.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { LineEdit, ComboBox, SpinBox, CheckBox } from "../ink/std_compat.slint";

import { Ink } from "../ink/palette.slint";

// A form row's label - plain (InkLabel's elide costs ~2 KB a use).
component FormLabel inherits Text {
    width: 120px;
    font-size: Ink.fs-secondary;
    color: Ink.text-dim;
    vertical-alignment: center;
}

// ----------------------------------------------------------
component FeatureRow inherits Rectangle {
    in property <FeatureRowSlint> data;
    in property <int> row_index;

    height: 44px;
    border-radius: Ink.radius-sm;
    background: row-ta.has-hover ? Ink.raised : transparent;

    // Declared before the controls below (not after) so it sits behind them
    // in z-order/hit-testing - a full-row TouchArea declared last would sit
    // on top and swallow every click meant for the ComboBox/remove button.
    row-ta := TouchArea { }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: stretch;

        ComboBox {
            width: 150px;
            model: [
                "Raw",
                "Gaussian Blur",
                "Sobel",
                "Laplacian",
                "Structure Tensor",
                "Hessian",
                "Rank Filter"
            ];
            current-index: root.data.filter_type;
            selected(v) => {
                AiLearningState.feature_rows[root.row_index].filter_type = self.current-index;
            }
        }

        if root.data.filter_type == 1 || root.data.filter_type == 4: LineEdit {
            width: 70px;
            text: root.data.sigma;
            edited(v) => {
                AiLearningState.feature_rows[root.row_index].sigma = v.to-float();
            }
        }

        if root.data.filter_type == 4: ComboBox {
            width: 130px;
            model: ["Eigenvalue X", "Eigenvalue Y", "Coherence"];
            current-index: root.data.structure_tensor_mode;
            selected(v) => {
                AiLearningState.feature_rows[root.row_index].structure_tensor_mode = self.current-index;
            }
        }

        if root.data.filter_type == 5: ComboBox {
            width: 130px;
            model: ["Determinant", "Eigenvalue X", "Eigenvalue Y"];
            current-index: root.data.hessian_mode;
            selected(v) => {
                AiLearningState.feature_rows[root.row_index].hessian_mode = self.current-index;
            }
        }

        if root.data.filter_type == 6: ComboBox {
            width: 110px;
            model: ["Mean", "Median", "Min", "Max", "Outliers"];
            current-index: root.data.rank_stat;
            selected(v) => {
                AiLearningState.feature_rows[root.row_index].rank_stat = self.current-index;
            }
        }

        if root.data.filter_type == 6: LineEdit {
            width: 70px;
            text: root.data.rank_radius;
            edited(v) => {
                AiLearningState.feature_rows[root.row_index].rank_radius = v.to-float();
            }
        }

        if root.data.filter_type == 6 && root.data.rank_stat == 4: LineEdit {
            width: 70px;
            placeholder-text: "Threshold";
            text: root.data.rank_threshold;
            edited(v) => {
                AiLearningState.feature_rows[root.row_index].rank_threshold = v.to-float();
            }
        }

        // Laplacian/Hessian have no sigma of their own - offer an optional
        // Gaussian pre-smoothing step (Laplacian-/Hessian-of-Gaussian).
        if root.data.filter_type == 3 || root.data.filter_type == 5: CheckBox {
            text: "Pre-blur";
            checked: root.data.pre_blur_enabled;
            toggled => {
                AiLearningState.feature_rows[root.row_index].pre_blur_enabled = self.checked;
            }
        }

        if (root.data.filter_type == 3 || root.data.filter_type == 5) && root.data.pre_blur_enabled: LineEdit {
            width: 60px;
            text: root.data.pre_blur_sigma;
            edited(v) => {
                AiLearningState.feature_rows[root.row_index].pre_blur_sigma = v.to-float();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 4px;
            background: remove-ta.has-hover ? Ink.raised : transparent;
            Text {
                text: "✕";
                color: Ink.text-dim;
                font-size: Ink.fs-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            remove-ta := TouchArea {
                clicked => {
                    AiLearningState.remove_feature_row_clicked(root.row_index);
                }
            }
        }
    }
}

// ----------------------------------------------------------
component ClassSelectionRow inherits Rectangle {
    in property <ClassSelectionRowSlint> data;
    in property <int> row_index;

    height: 26px;

    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            CheckBox {
                checked: root.data.selected;
                toggled => {
                    AiLearningState.class_selection[root.row_index].selected = self.checked;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 2px;
                background: root.data.color;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.data.name;
            font-size: Ink.fs-body;
            color: Ink.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.data.count;
            font-size: Ink.fs-secondary;
            font-family: Ink.font-mono;
            color: Ink.text-mute;
            vertical-alignment: center;
        }
    }
}

// ----------------------------------------------------------
component ObjectMetricRow inherits Rectangle {
    in property <ObjectMetricRowSlint> data;
    in property <int> row_index;

    height: 30px;

    HorizontalLayout {
        padding-left: 4px;
        spacing: 8px;
        CheckBox {
            text: root.data.label;
            checked: root.data.selected;
            toggled => {
                AiLearningState.object_metrics[root.row_index].selected = self.checked;
            }
        }
    }
}

// ----------------------------------------------------------
component TrainingImageRow inherits Rectangle {
    in property <TrainingImageRowSlint> data;
    in property <int> row_index;

    height: 32px;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 8px;
        alignment: stretch;

        CheckBox {
            text: root.data.name;
            checked: root.data.selected;
            toggled => {
                AiLearningState.toggle_image_selected(root.row_index);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: root.data.annotated_object_count + " objects";
            color: Ink.text-mute;
            font-size: Ink.fs-secondary;
            font-family: Ink.font-mono;
            vertical-alignment: center;
        }
    }
}

// ----------------------------------------------------------
component TrainingObjectRow inherits Rectangle {
    in property <TrainingObjectRowSlint> data;
    in property <int> row_index;

    height: 32px;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 8px;
        alignment: stretch;

        Text {
            text: root.data.label;
            color: Ink.text;
            font-size: Ink.fs-secondary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        CheckBox {
            text: "Train on this";
            checked: !root.data.excluded;
            toggled => {
                AiLearningState.toggle_object_excluded(root.row_index);
            }
        }

        ComboBox {
            width: 140px;
            model: AiLearningState.class_names;
            current-index: root.data.assigned_class_index;
            selected(v) => {
                AiLearningState.assign_object_class(root.row_index, self.current-index);
            }
        }
    }
}

// ----------------------------------------------------------
export component AiLearningDialog inherits InkDialog {
    // Docked on the right; the image stays usable.
    placement: InkDialogPlacement.sheet;
    title: "Train classifier";
    subtitle: "from your annotations";
    // "More settings ›": everything beyond the short form.
    property <bool> more: false;
    property <length> field-w: 190px;
    card-width: 440px;
    card-height: 840px;
    content-padding: 0px;
    close => {
        AiLearningState.cancel_clicked();
        GlobalAppState.active-dialog = DialogType.none;
    }

    VerticalLayout {
        spacing: 0;

        // ----- BODY -----
        Rectangle {
            vertical-stretch: 1;

            ScrollView {
                // Only up and down: the content is as wide as the sheet.
                content-width: self.visible-width;
                VerticalLayout {
                    width: parent.width;
                    padding: 16px;
                    spacing: 18px;
                    alignment: start;

                    // -- What it learns (design R) --
                    InkSegmented {
                        label: "Classifier";
                        model: ["Pixel classifier", "Object classifier"];
                        selected: AiLearningState.settings.mode;
                        picked(i) => {
                            AiLearningState.settings.mode = i;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        InkCaption {
                            text: "CLASSES TO LEARN";
                        }
                        for data[index] in AiLearningState.class_selection: ClassSelectionRow {
                            data: data;
                            row_index: index;
                        }
                        if AiLearningState.class_selection.length == 0: InkHint {
                            text: "No classes yet - add some in the classes panel.";
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        InkCaption {
                            text: "TRAINING";
                        }
                        if AiLearningState.settings.mode == 0: HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            FormLabel {
                                text: "Channel";
                            }
                            ComboBox {
                                width: root.field-w;
                                model: AiLearningState.channel_names;
                                current-index <=> AiLearningState.settings.pixel_channel;
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            FormLabel {
                                text: "Model";
                            }
                            ComboBox {
                                width: root.field-w;
                                model: ["Random Forest", "K-Nearest Neighbors", "Neural Network (MLP)"];
                                current-index <=> AiLearningState.settings.algorithm;
                            }
                        }
                        // The two settings that matter most for the model.
                        if AiLearningState.settings.algorithm == 0: VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Trees";
                                }
                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 2000;
                                    value <=> AiLearningState.settings.rf_n_trees;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Tree depth";
                                }
                                SpinBox {
                                    width: root.field-w;
                                    minimum: 0;
                                    maximum: 200;
                                    value <=> AiLearningState.settings.rf_max_depth;
                                }
                            }
                        }
                        if AiLearningState.settings.algorithm == 1: HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            FormLabel {
                                text: "K (neighbors)";
                            }
                            SpinBox {
                                width: root.field-w;
                                minimum: 1;
                                maximum: 200;
                                value <=> AiLearningState.settings.knn_k;
                            }
                        }
                        if AiLearningState.settings.algorithm == 2: VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Hidden layers";
                                }
                                LineEdit {
                                    width: root.field-w;
                                    placeholder-text: "e.g. 64, 32";
                                    text <=> AiLearningState.settings.mlp_hidden_layers;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Max iterations";
                                }
                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 100000;
                                    value <=> AiLearningState.settings.mlp_max_iterations;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            FormLabel {
                                text: "Save as";
                            }
                            LineEdit {
                                width: root.field-w;
                                placeholder-text: "e.g. nuclei-pixels";
                                text <=> AiLearningState.settings.model_name;
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            FormLabel {
                                text: "";
                            }
                            InkButton {
                                small: true;
                                kind: InkButtonKind.quiet;
                                icon: InkIcons.open;
                                text: "Or load a trained model…";
                                clicked => {
                                    AiLearningState.browse_existing_model_clicked();
                                }
                            }
                        }
                        if AiLearningState.settings.loaded_model_path != "": Text {
                            text: "Loaded: " + AiLearningState.settings.loaded_model_path;
                            color: Ink.text-mute;
                            font-size: Ink.fs-secondary;
                            font-family: Ink.font-mono;
                            overflow: elide;
                        }
                    }

                    InkBanner {
                        tone: AiLearningState.annotated-image-count == 0 ? InkTone.warn : InkTone.info;
                        text: AiLearningState.annotated-image-count == 0
                            ? "No hand-drawn objects yet - draw some in annotate mode."
                            : "Uses the annotations of \{AiLearningState.annotated-image-count} " + (AiLearningState.annotated-image-count == 1 ? "image" : "images") + ". Annotate more for a better model.";
                    }

                    // -- Everything else --
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: root.more ? "Fewer settings ‹" : "More settings ›";
                            font-size: Ink.fs-secondary;
                            color: more-ta.has-hover ? Ink.text : Ink.focus;
                            more-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.more = !root.more;
                                }
                            }
                        }
                    }

                    if root.more: VerticalLayout {
                        spacing: 20px;

                    // -- Algorithm + hyperparameters --
                    VerticalLayout {
                        spacing: 12px;
                        InkCaption {
                            text: "ALL MODEL SETTINGS";
                        }

                        // Random Forest
                        if AiLearningState.settings.algorithm == 0: VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Number of trees";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 2000;
                                    value <=> AiLearningState.settings.rf_n_trees;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Max tree depth";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 0;
                                    maximum: 200;
                                    value <=> AiLearningState.settings.rf_max_depth;
                                }

                                Text {
                                    text: "0 = no limit";
                                    color: Ink.text-mute;
                                    font-size: Ink.fs-secondary;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Min samples split";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 2;
                                    maximum: 1000;
                                    value <=> AiLearningState.settings.rf_min_samples_split;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Min samples leaf";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 1000;
                                    value <=> AiLearningState.settings.rf_min_samples_leaf;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Split criterion";
                                }

                                ComboBox {
                                    width: root.field-w;
                                    model: ["Gini", "Entropy"];
                                    current-index <=> AiLearningState.settings.rf_criterion;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Features per split";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 0;
                                    maximum: 1000;
                                    value <=> AiLearningState.settings.rf_max_features;
                                }

                                Text {
                                    text: "0 = auto";
                                    color: Ink.text-mute;
                                    font-size: Ink.fs-secondary;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Random seed";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 0;
                                    maximum: 999999;
                                    value <=> AiLearningState.settings.rf_seed;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "";
                                }

                                CheckBox {
                                    text: "Accuracy from out-of-bag samples";
                                    checked <=> AiLearningState.settings.rf_out_of_bag_eval;
                                }
                            }
                        }

                        // K-Nearest Neighbors
                        if AiLearningState.settings.algorithm == 1: VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "K (neighbors)";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 200;
                                    value <=> AiLearningState.settings.knn_k;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Distance metric";
                                }

                                distance-combo := ComboBox {
                                    width: root.field-w;
                                    model: ["Euclidean", "Manhattan", "Minkowski", "Cosine", "Hamming"];
                                    current-index <=> AiLearningState.settings.knn_distance;
                                }
                            }

                            // Only Minkowski takes an order parameter - the other
                            // four metrics are parameterless.
                            if distance-combo.current-index == 2: HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Minkowski order (p)";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 100;
                                    value <=> AiLearningState.settings.knn_minkowski_p;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Search algorithm";
                                }

                                ComboBox {
                                    width: root.field-w;
                                    model: ["Linear Search", "Cover Tree"];
                                    current-index <=> AiLearningState.settings.knn_search_algorithm;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Vote weighting";
                                }

                                ComboBox {
                                    width: root.field-w;
                                    model: ["Uniform", "Distance-weighted"];
                                    current-index <=> AiLearningState.settings.knn_weight;
                                }
                            }
                        }

                        // Neural Network (MLP)
                        if AiLearningState.settings.algorithm == 2: VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Hidden layers";
                                }

                                LineEdit {
                                    width: root.field-w;
                                    placeholder-text: "e.g. 64, 32";
                                    text <=> AiLearningState.settings.mlp_hidden_layers;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Activation";
                                }

                                ComboBox {
                                    width: root.field-w;
                                    model: ["ReLU", "Sigmoid", "Tanh"];
                                    current-index <=> AiLearningState.settings.mlp_activation;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Max iterations";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 100000;
                                    value <=> AiLearningState.settings.mlp_max_iterations;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Epsilon";
                                }

                                LineEdit {
                                    width: root.field-w;
                                    text: AiLearningState.settings.mlp_epsilon;
                                    edited(v) => {
                                        AiLearningState.settings.mlp_epsilon = v.to-float();
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Learning rate";
                                }

                                LineEdit {
                                    width: root.field-w;
                                    text: AiLearningState.settings.mlp_learning_rate;
                                    edited(v) => {
                                        AiLearningState.settings.mlp_learning_rate = v.to-float();
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Batch size";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 10000;
                                    value <=> AiLearningState.settings.mlp_batch_size;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Random seed";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 0;
                                    maximum: 999999;
                                    value <=> AiLearningState.settings.mlp_seed;
                                }
                            }
                        }
                    }

                    // -- Pixel classifier: feature channels --
                    if AiLearningState.settings.mode == 0: VerticalLayout {
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            InkCaption {
                                text: "FEATURE CHANNELS";
                            }

                            InkButton {
                                small: true;
                                icon: InkIcons.add;
                                text: "Add feature";
                                clicked => {
                                    AiLearningState.add_feature_row_clicked();
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            FormLabel {
                                text: "Image channel";
                            }

                            ComboBox {
                                width: root.field-w;
                                model: AiLearningState.channel_names;
                                current-index <=> AiLearningState.settings.pixel_channel;
                            }
                        }

                        Rectangle {
                            height: 180px;
                            border-width: 1px;
                            border-color: Ink.border-soft;
                            border-radius: Ink.radius-sm;

                            ListView {
                                for data[index] in AiLearningState.feature_rows: FeatureRow {
                                    data: data;
                                    row_index: index;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            FormLabel {
                                text: "Quick add blur scales";
                            }

                            gaussian-scales-input := LineEdit {
                                width: root.field-w;
                                placeholder-text: "e.g. 1, 3, 5, 6";
                            }

                            InkButton {
                                text: "Add";
                                clicked => {
                                    AiLearningState.add_gaussian_scales_clicked(gaussian-scales-input.text);
                                }
                            }
                        }
                    }

                    // -- Object classifier: metrics --
                    if AiLearningState.settings.mode == 1: VerticalLayout {
                        spacing: 10px;
                        InkCaption {
                            text: "OBJECT METRICS";
                        }

                        Text {
                            text: "Assigned class and position are intentionally excluded to avoid label leakage and location-based overfitting.";
                            color: Ink.text-mute;
                            font-size: Ink.fs-secondary;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 200px;
                            border-width: 1px;
                            border-color: Ink.border-soft;
                            border-radius: Ink.radius-sm;

                            ListView {
                                for data[index] in AiLearningState.object_metrics: ObjectMetricRow {
                                    data: data;
                                    row_index: index;
                                }
                            }
                        }
                    }

                    // -- Shared training options --
                    VerticalLayout {
                        spacing: 12px;
                        InkCaption {
                            text: "TRAINING OPTIONS";
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            FormLabel {
                                text: "";
                            }

                            CheckBox {
                                text: "Normalize features (KNN, MLP)";
                                checked <=> AiLearningState.settings.normalize_features;
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            FormLabel {
                                text: "";
                            }

                            CheckBox {
                                text: "Balance uneven classes";
                                checked <=> AiLearningState.settings.balance_classes;
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            FormLabel {
                                text: "Validation split";
                            }

                            LineEdit {
                                width: root.field-w;
                                text: AiLearningState.settings.validation_split;
                                edited(v) => {
                                    AiLearningState.settings.validation_split = v.to-float();
                                }
                            }

                            Text {
                                text: "fraction held out to report accuracy";
                                color: Ink.text-mute;
                                font-size: Ink.fs-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // -- Training data source --
                    VerticalLayout {
                        spacing: 10px;
                        InkCaption {
                            text: "TRAINING DATA SOURCE";
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            FormLabel {
                                text: "";
                            }

                            CheckBox {
                                text: "Annotations of other images too";
                                checked <=> AiLearningState.settings.use_other_images;
                            }
                        }

                        if AiLearningState.settings.use_other_images: Rectangle {
                            height: 150px;
                            border-width: 1px;
                            border-color: Ink.border-soft;
                            border-radius: Ink.radius-sm;

                            ListView {
                                for data[index] in AiLearningState.training_images: TrainingImageRow {
                                    data: data;
                                    row_index: index;
                                }
                            }
                        }
                    }

                    // -- Labeled training objects --
                    VerticalLayout {
                        spacing: 10px;
                        InkCaption {
                            text: "TRAINING OBJECTS";
                        }

                        Text {
                            text: "Only manually-painted objects with a class assigned below are used for training.";
                            color: Ink.text-mute;
                            font-size: Ink.fs-secondary;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 220px;
                            border-width: 1px;
                            border-color: Ink.border-soft;
                            border-radius: Ink.radius-sm;

                            ListView {
                                for data[index] in AiLearningState.training_objects: TrainingObjectRow {
                                    data: data;
                                    row_index: index;
                                }
                            }
                        }
                    }
                    }
                }
            }
        }

        // ----- STATUS BANNER -----
        // Shown instead of the app-wide warning dialog for both
        // pre-flight validation failures and training progress/results,
        // so the dialog (and the user's settings) stay in place - the
        // dialog is never closed automatically, including on training
        // completion, so the user can see the result and retrain.
        if AiLearningState.training_status != "": Rectangle {
            background: Ink.ground;
            border-width: 1px;
            border-color: AiLearningState.training_status_is_error ? Ink.err : AiLearningState.training_in_progress ? Ink.focus : Ink.ok;

            HorizontalLayout {
                padding: 10px;
                Text {
                    text: AiLearningState.training_status;
                    color: AiLearningState.training_status_is_error ? Ink.err : AiLearningState.training_in_progress ? Ink.focus : Ink.ok;
                    font-size: Ink.fs-secondary;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                }
            }
        }

        // ----- FOOTER -----
        InkDivider { }

        // The dialog's buttons; this dialog pads its own content.
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            padding-left: Ink.pad-dialog;
            padding-right: Ink.pad-dialog;
            padding-top: 10px;
            padding-bottom: 10px;

            InkButton {
                text: "Close";
                clicked => {
                    AiLearningState.cancel_clicked();
                    GlobalAppState.active-dialog = DialogType.none;
                }
            }

            if AiLearningState.training_in_progress: InkButton {
                kind: InkButtonKind.danger;
                text: "Cancel";
                clicked => {
                    AiLearningState.cancel_training_clicked();
                }
            }

            InkButton {
                kind: InkButtonKind.primary;
                text: "Train";
                enabled: !AiLearningState.training_in_progress;
                disabled-reason: "Training is already running";
                clicked => {
                    // Rust decides whether to close the dialog - a
                    // pre-flight validation failure keeps it open
                    // (see `training_error`) instead of always
                    // closing immediately like this used to.
                    AiLearningState.trigger_train();
                }
            }
        }
    }
}
