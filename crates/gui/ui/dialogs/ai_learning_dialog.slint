import { InkButton, InkButtonKind, InkCaption, InkChip, InkDialog, InkIcons, InkDialogPlacement, InkSegmented, InkHint, InkBanner, InkTone, InkDivider } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { AiLearningState, ClassSelectionRowSlint, FeatureGridRowSlint, BrightnessRowSlint, TrainingImageRowSlint, TrainingObjectRowSlint } from "../api/ai_learning.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { LineEdit, ComboBox, SpinBox, CheckBox } from "../ink/std_compat.slint";

import { Ink } from "../ink/palette.slint";
import { StackTrack } from "../editor/viewport_stack_bar.slint";

// A form row's label - plain (InkLabel's elide costs ~2 KB a use).
component FormLabel inherits Text {
    width: 120px;
    font-size: Ink.fs-secondary;
    color: Ink.text-dim;
    vertical-alignment: center;
}

// A foldable section's header: ▾/▸, the caption, a summary on the right.
component SectionHead inherits Rectangle {
    in property <string> title;
    in property <string> summary;
    in-out property <bool> open: true;
    in property <bool> top-line: false;

    height: 30px;
    if root.top-line: Rectangle {
        y: 0;
        height: 1px;
        background: Ink.border-soft;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.open = !root.open;
        }
    }
    HorizontalLayout {
        spacing: 6px;
        Text {
            text: root.open ? "▾" : "▸";
            font-size: 9px;
            color: Ink.text-mute;
            vertical-alignment: center;
        }
        InkCaption {
            text: root.title;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: root.summary;
            font-size: Ink.fs-secondary;
            color: root.open ? Ink.text-mute : Ink.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// ----------------------------------------------------------
component ClassSelectionRow inherits Rectangle {
    in property <ClassSelectionRowSlint> data;
    in property <int> row_index;

    height: 26px;

    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            CheckBox {
                checked: root.data.selected;
                toggled => {
                    AiLearningState.class_selection[root.row_index].selected = self.checked;
                    AiLearningState.class_selection_changed();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 2px;
                background: root.data.color;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.data.name;
            font-size: Ink.fs-body;
            color: Ink.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.data.count;
            font-size: Ink.fs-secondary;
            font-family: Ink.font-mono;
            color: Ink.text-mute;
            vertical-alignment: center;
        }
    }
}

// ----------------------------------------------------------
// A row of the pixel feature table: name (and its option), then a
// checkbox per size column.
component FeatureGridRow inherits Rectangle {
    in property <FeatureGridRowSlint> data;
    in property <int> row_index;
    in property <length> name-w;
    in property <length> cell-w;

    // As high as the name (wrapped) and its option need.
    height: max(32px, row-layout.preferred-height);
    border-radius: Ink.radius-sm;
    background: ta.has-hover ? Ink.hover : transparent;
    ta := TouchArea { }

    row-layout := HorizontalLayout {
        VerticalLayout {
            width: root.name-w;
            padding-left: 6px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 2px;
            alignment: center;
            Text {
                text: root.data.label;
                font-size: Ink.fs-body;
                color: Ink.text;
                wrap: word-wrap;
            }
            if root.data.options.length > 0: ComboBox {
                width: root.name-w - 14px;
                height: 22px;
                model: root.data.options;
                current-index: root.data.option;
                selected(v) => {
                    AiLearningState.set_feature_option(root.row_index, self.current-index);
                }
            }
        }
        // "as is"
        Rectangle {
            width: root.cell-w;
            if root.data.has_raw: CheckBox {
                checked: root.data.raw;
                toggled => {
                    AiLearningState.toggle_feature_cell(root.row_index, -1);
                }
            }
            if !root.data.has_raw: Text {
                text: "·";
                color: Ink.text-faint;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        for on[col] in root.data.cells: Rectangle {
            width: root.cell-w;
            CheckBox {
                checked: on;
                toggled => {
                    AiLearningState.toggle_feature_cell(root.row_index, col);
                }
            }
        }
    }
}

// A row of the brightness table: the statistic (a click ticks the whole
// row), then a checkbox per channel.
component BrightnessRow inherits Rectangle {
    in property <BrightnessRowSlint> data;
    in property <int> row_index;
    in property <length> cell-w;
    in property <bool> show-hint: true;

    height: 28px;
    HorizontalLayout {
        Rectangle {
            horizontal-stretch: 1;
            lt := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    AiLearningState.toggle_brightness_row(root.row_index);
                }
            }
            HorizontalLayout {
                padding-left: 6px;
                spacing: 6px;
                Text {
                    text: root.data.label;
                    font-size: Ink.fs-body;
                    color: lt.has-hover ? Ink.focus : Ink.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.show-hint: Text {
                    text: root.data.hint;
                    font-size: Ink.fs-secondary;
                    color: Ink.text-mute;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
        for on[col] in root.data.cells: Rectangle {
            width: root.cell-w;
            CheckBox {
                checked: on;
                toggled => {
                    AiLearningState.toggle_brightness_cell(root.row_index, col);
                }
            }
        }
    }
}

// ----------------------------------------------------------
component TrainingImageRow inherits Rectangle {
    in property <TrainingImageRowSlint> data;
    in property <int> row_index;

    height: 32px;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 8px;
        alignment: stretch;

        CheckBox {
            text: root.data.name;
            checked: root.data.selected;
            toggled => {
                AiLearningState.toggle_image_selected(root.row_index);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: root.data.annotated_object_count + " objects";
            color: Ink.text-mute;
            font-size: Ink.fs-secondary;
            font-family: Ink.font-mono;
            vertical-alignment: center;
        }
    }
}

// ----------------------------------------------------------
component TrainingObjectRow inherits Rectangle {
    in property <TrainingObjectRowSlint> data;
    in property <int> row_index;

    height: 32px;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 8px;
        alignment: stretch;

        Text {
            text: root.data.label;
            color: Ink.text;
            font-size: Ink.fs-secondary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        CheckBox {
            text: "Train on this";
            checked: !root.data.excluded;
            toggled => {
                AiLearningState.toggle_object_excluded(root.row_index);
            }
        }

        ComboBox {
            width: 140px;
            model: AiLearningState.class_names;
            current-index: root.data.assigned_class_index;
            selected(v) => {
                AiLearningState.assign_object_class(root.row_index, self.current-index);
            }
        }
    }
}

// ----------------------------------------------------------
export component AiLearningDialog inherits InkDialog {
    // Docked on the right; the image stays usable.
    placement: InkDialogPlacement.sheet;
    title: "Train classifier";
    subtitle: "from your annotations";
    card-width: 440px;
    card-height: 840px;
    content-padding: 0px;
    // "All model settings": everything beyond the model's main settings.
    property <bool> more: false;
    property <length> field-w: 190px;
    // Sections folded or open.
    property <bool> classes-open: true;
    property <bool> features-open: true;
    property <bool> model-open: false;
    property <bool> objects-open: false;
    property <bool> adding-size: false;
    property <int> shape-rows: floor((AiLearningState.shape_metrics.length + 2) / 3);
    close => {
        AiLearningState.cancel_clicked();
        GlobalAppState.active-dialog = DialogType.none;
    }

    VerticalLayout {
        spacing: 0;

        // ----- BODY -----
        Rectangle {
            vertical-stretch: 1;

            ScrollView {
                // Only up and down: the content is as wide as the sheet.
                content-width: self.visible-width;
                VerticalLayout {
                    width: parent.width;
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;

                    // -- What it learns, in one line --
                    VerticalLayout {
                        spacing: 6px;
                        InkSegmented {
                            label: "Classifier";
                            model: ["Pixel classifier", "Object classifier"];
                            selected: AiLearningState.settings.mode;
                            picked(i) => {
                                AiLearningState.settings.mode = i;
                                AiLearningState.class_selection_changed();
                            }
                        }
                        Text {
                            text: AiLearningState.settings.mode == 0
                                ? "Decides for every pixel which class it belongs to – finds objects a threshold can't separate."
                                : "Sorts objects your pipeline already found into classes – by size, shape and brightness.";
                            font-size: Ink.fs-secondary;
                            color: Ink.text-dim;
                            wrap: word-wrap;
                        }
                    }

                    // -- Classes --
                    VerticalLayout {
                        spacing: 2px;
                        SectionHead {
                            title: "CLASSES TO LEARN";
                            summary: AiLearningState.settings.mode == 0 ? "examples" : "objects";
                            open <=> root.classes-open;
                        }
                        if root.classes-open: VerticalLayout {
                            spacing: 2px;
                            for data[index] in AiLearningState.class_selection: ClassSelectionRow {
                                data: data;
                                row_index: index;
                            }
                            if AiLearningState.class_selection.length == 0: InkHint {
                                text: "No classes yet - add some in the classes panel.";
                            }
                            Text {
                                text: AiLearningState.settings.mode == 0
                                    ? "Draw on the image – this list follows while you draw."
                                    : "Give objects in the image a class – this list follows.";
                                font-size: Ink.fs-secondary;
                                color: Ink.text-mute;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        InkCaption {
                            text: "EXAMPLES FROM";
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: AiLearningState.examples_summary;
                            font-size: Ink.fs-body;
                            color: Ink.text;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    // -- Features --
                    VerticalLayout {
                        spacing: 8px;
                        SectionHead {
                            title: "FEATURES";
                            summary: AiLearningState.feature_count;
                            open <=> root.features-open;
                        }

                        // Pixel classifier: channels, presets, the table.
                        if root.features-open && AiLearningState.settings.mode == 0: VerticalLayout {
                            spacing: 8px;
                            Flickable {
                                height: 28px;
                                content-width: chips.preferred-width;
                                chips := HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    for chip[i] in AiLearningState.pixel_channels: InkChip {
                                        text: chip.name;
                                        swatch: chip.color;
                                        selected: chip.selected;
                                        clicked => {
                                            AiLearningState.toggle_pixel_channel(i);
                                        }
                                    }
                                }
                            }
                            InkSegmented {
                                model: ["Simple", "Recommended", "All"];
                                selected: AiLearningState.pixel_preset;
                                picked(i) => {
                                    AiLearningState.apply_pixel_preset(i);
                                }
                            }
                            // The columns share the table's width: header and
                            // checkboxes always line up, however many sizes.
                            pixel-table := Rectangle {
                                property <int> cols: AiLearningState.feature_sizes.length + 1;
                                property <length> cw: clamp((self.width - 4px - 120px) / self.cols, 26px, 40px);
                                property <length> nw: self.width - 4px - self.cols * self.cw;
                                border-width: 1px;
                                border-color: Ink.border;
                                border-radius: Ink.radius-md;
                                VerticalLayout {
                                    padding: 2px;
                                    // Header: the sizes; a click removes one.
                                    HorizontalLayout {
                                        height: 26px;
                                        Text {
                                            width: pixel-table.nw;
                                            text: "  Size (px)";
                                            font-size: Ink.fs-caption;
                                            font-weight: 600;
                                            color: Ink.text-mute;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            width: pixel-table.cw;
                                            text: "raw";
                                            font-size: Ink.fs-caption;
                                            color: Ink.text-mute;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        for size[col] in AiLearningState.feature_sizes: Rectangle {
                                            width: pixel-table.cw;
                                            property <bool> removable: AiLearningState.feature_sizes.length > 1;
                                            st := TouchArea {
                                                mouse-cursor: parent.removable ? pointer : default;
                                                clicked => {
                                                    if (parent.removable) {
                                                        AiLearningState.remove_feature_size(col);
                                                    }
                                                }
                                            }
                                            Text {
                                                text: st.has-hover && parent.removable ? "✕" : size;
                                                font-size: Ink.fs-caption;
                                                font-weight: 600;
                                                color: st.has-hover && parent.removable ? Ink.err : Ink.text-mute;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    for row[r] in AiLearningState.feature_grid: FeatureGridRow {
                                        data: row;
                                        row_index: r;
                                        name-w: pixel-table.nw;
                                        cell-w: pixel-table.cw;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Size: Gaussian σ = size / 2, rank filter radius = size. Click a size to remove it.";
                                    font-size: Ink.fs-secondary;
                                    color: Ink.text-mute;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }
                                if !root.adding-size: InkButton {
                                    small: true;
                                    kind: InkButtonKind.quiet;
                                    text: "+ size";
                                    clicked => {
                                        root.adding-size = true;
                                    }
                                }
                                if root.adding-size: size-input := LineEdit {
                                    width: 56px;
                                    placeholder-text: "px";
                                    accepted(v) => {
                                        AiLearningState.add_feature_size(v);
                                        root.adding-size = false;
                                    }
                                }
                            }
                        }

                        // Object classifier: shape, brightness × channels.
                        if root.features-open && AiLearningState.settings.mode == 1: VerticalLayout {
                            spacing: 8px;
                            InkSegmented {
                                model: ["Shape only", "Recommended", "All"];
                                selected: AiLearningState.object_preset;
                                picked(i) => {
                                    AiLearningState.apply_object_preset(i);
                                }
                            }
                            InkCaption {
                                text: "SIZE & SHAPE";
                            }
                            for r in root.shape-rows: HorizontalLayout {
                                height: 26px;
                                for k in 3: Rectangle {
                                    horizontal-stretch: 1;
                                    if r * 3 + k < AiLearningState.shape_metrics.length: CheckBox {
                                        x: 0;
                                        text: AiLearningState.shape_metrics[r * 3 + k].label;
                                        checked: AiLearningState.shape_metrics[r * 3 + k].selected;
                                        toggled => {
                                            AiLearningState.toggle_shape_metric(r * 3 + k);
                                        }
                                    }
                                }
                            }
                            InkCaption {
                                text: "BRIGHTNESS";
                            }
                            // Channel columns share the width; with very many
                            // channels the table scrolls sideways.
                            bright-scroll := Flickable {
                                property <int> n: max(1, AiLearningState.channel_names.length);
                                property <length> cw: clamp((self.width - 4px - 100px) / self.n, 32px, 60px);
                                property <bool> narrow: self.cw < 56px;
                                height: bright-table.preferred-height;
                                content-width: max(self.width, 104px + self.n * self.cw);
                                bright-table := Rectangle {
                                    width: parent.content-width;
                                    border-width: 1px;
                                    border-color: Ink.border;
                                    border-radius: Ink.radius-md;
                                    VerticalLayout {
                                        padding: 2px;
                                        HorizontalLayout {
                                            height: 26px;
                                            Text {
                                                horizontal-stretch: 1;
                                                text: "  STATISTIC";
                                                font-size: Ink.fs-caption;
                                                font-weight: 600;
                                                color: Ink.text-mute;
                                                vertical-alignment: center;
                                            }
                                            for name[c] in AiLearningState.channel_names: Rectangle {
                                                width: bright-scroll.cw;
                                                ct := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        AiLearningState.toggle_brightness_column(c);
                                                    }
                                                }
                                                Text {
                                                    width: parent.width - 4px;
                                                    // Narrow: the number (the legend below names it).
                                                    text: bright-scroll.narrow ? c : name;
                                                    font-size: Ink.fs-secondary;
                                                    color: ct.has-hover ? Ink.focus : Ink.text;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                        for row[r] in AiLearningState.brightness_rows: BrightnessRow {
                                            data: row;
                                            row_index: r;
                                            cell-w: bright-scroll.cw;
                                            // The hints only when the names have room.
                                            show-hint: bright-table.width - 4px - bright-scroll.n * bright-scroll.cw >= 200px;
                                        }
                                    }
                                }
                            }
                            if bright-scroll.narrow: Text {
                                text: AiLearningState.channel_legend;
                                font-size: Ink.fs-secondary;
                                color: Ink.text-dim;
                                wrap: word-wrap;
                            }
                            if AiLearningState.ring_in_use: HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Ring width";
                                }
                                SpinBox {
                                    width: 80px;
                                    minimum: 1;
                                    maximum: 100;
                                    value <=> AiLearningState.settings.ring_width;
                                }
                                Text {
                                    text: "px around each object";
                                    font-size: Ink.fs-secondary;
                                    color: Ink.text-mute;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: "Click a channel or statistic to tick its column or row.";
                                font-size: Ink.fs-secondary;
                                color: Ink.text-mute;
                                overflow: elide;
                            }
                            Text {
                                text: "Class and position are never used.";
                                font-size: Ink.fs-secondary;
                                color: Ink.text-mute;
                                overflow: elide;
                            }
                        }
                    }

                    // -- Model (folded) --
                    VerticalLayout {
                        spacing: 8px;
                        SectionHead {
                            top-line: true;
                            title: "MODEL";
                            summary: AiLearningState.settings.algorithm == 0
                                ? "Random forest · \{AiLearningState.settings.rf_n_trees} trees"
                                : AiLearningState.settings.algorithm == 1
                                ? "Nearest neighbours · k \{AiLearningState.settings.knn_k}"
                                : "Neural network · " + AiLearningState.settings.mlp_hidden_layers;
                            open <=> root.model-open;
                        }
                        if root.model-open: VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Model";
                                }
                                ComboBox {
                                    width: root.field-w;
                                    model: ["Random Forest", "K-Nearest Neighbors", "Neural Network (MLP)"];
                                    current-index <=> AiLearningState.settings.algorithm;
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                Text {
                                    text: root.more ? "Fewer settings ‹" : "All model settings ›";
                                    font-size: Ink.fs-secondary;
                                    color: more-ta.has-hover ? Ink.text : Ink.focus;
                                    more-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.more = !root.more;
                                        }
                                    }
                                }
                            }
                            if root.more: VerticalLayout {
                                spacing: 12px;
                    VerticalLayout {
                        spacing: 12px;
                        InkCaption {
                            text: "ALL MODEL SETTINGS";
                        }

                        // Random Forest
                        if AiLearningState.settings.algorithm == 0: VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Number of trees";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 2000;
                                    value <=> AiLearningState.settings.rf_n_trees;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Max tree depth";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 0;
                                    maximum: 200;
                                    value <=> AiLearningState.settings.rf_max_depth;
                                }

                                Text {
                                    text: "0 = no limit";
                                    color: Ink.text-mute;
                                    font-size: Ink.fs-secondary;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Min samples split";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 2;
                                    maximum: 1000;
                                    value <=> AiLearningState.settings.rf_min_samples_split;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Min samples leaf";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 1000;
                                    value <=> AiLearningState.settings.rf_min_samples_leaf;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Split criterion";
                                }

                                ComboBox {
                                    width: root.field-w;
                                    model: ["Gini", "Entropy"];
                                    current-index <=> AiLearningState.settings.rf_criterion;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Features per split";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 0;
                                    maximum: 1000;
                                    value <=> AiLearningState.settings.rf_max_features;
                                }

                                Text {
                                    text: "0 = auto";
                                    color: Ink.text-mute;
                                    font-size: Ink.fs-secondary;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Random seed";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 0;
                                    maximum: 999999;
                                    value <=> AiLearningState.settings.rf_seed;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "";
                                }

                                CheckBox {
                                    text: "Accuracy from out-of-bag samples";
                                    checked <=> AiLearningState.settings.rf_out_of_bag_eval;
                                }
                            }
                        }

                        // K-Nearest Neighbors
                        if AiLearningState.settings.algorithm == 1: VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "K (neighbors)";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 200;
                                    value <=> AiLearningState.settings.knn_k;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Distance metric";
                                }

                                distance-combo := ComboBox {
                                    width: root.field-w;
                                    model: ["Euclidean", "Manhattan", "Minkowski", "Cosine", "Hamming"];
                                    current-index <=> AiLearningState.settings.knn_distance;
                                }
                            }

                            // Only Minkowski takes an order parameter - the other
                            // four metrics are parameterless.
                            if distance-combo.current-index == 2: HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Minkowski order (p)";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 100;
                                    value <=> AiLearningState.settings.knn_minkowski_p;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Search algorithm";
                                }

                                ComboBox {
                                    width: root.field-w;
                                    model: ["Linear Search", "Cover Tree"];
                                    current-index <=> AiLearningState.settings.knn_search_algorithm;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Vote weighting";
                                }

                                ComboBox {
                                    width: root.field-w;
                                    model: ["Uniform", "Distance-weighted"];
                                    current-index <=> AiLearningState.settings.knn_weight;
                                }
                            }
                        }

                        // Neural Network (MLP)
                        if AiLearningState.settings.algorithm == 2: VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Hidden layers";
                                }

                                LineEdit {
                                    width: root.field-w;
                                    placeholder-text: "e.g. 64, 32";
                                    text <=> AiLearningState.settings.mlp_hidden_layers;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Activation";
                                }

                                ComboBox {
                                    width: root.field-w;
                                    model: ["ReLU", "Sigmoid", "Tanh"];
                                    current-index <=> AiLearningState.settings.mlp_activation;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Max iterations";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 100000;
                                    value <=> AiLearningState.settings.mlp_max_iterations;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Epsilon";
                                }

                                LineEdit {
                                    width: root.field-w;
                                    text: AiLearningState.settings.mlp_epsilon;
                                    edited(v) => {
                                        AiLearningState.settings.mlp_epsilon = v.to-float();
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Learning rate";
                                }

                                LineEdit {
                                    width: root.field-w;
                                    text: AiLearningState.settings.mlp_learning_rate;
                                    edited(v) => {
                                        AiLearningState.settings.mlp_learning_rate = v.to-float();
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Batch size";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 1;
                                    maximum: 10000;
                                    value <=> AiLearningState.settings.mlp_batch_size;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                FormLabel {
                                    text: "Random seed";
                                }

                                SpinBox {
                                    width: root.field-w;
                                    minimum: 0;
                                    maximum: 999999;
                                    value <=> AiLearningState.settings.mlp_seed;
                                }
                            }
                        }
                    }

                            }
                        }
                    }

                    // "Training options" (Balance classes, Normalize features,
                    // Hold back) is hidden: training doesn't use them yet
                    // (`balance_classes`, `normalize_features`,
                    // `validation_split` are never read) - see TODO.

                    // -- The examples one by one (folded): class, use or not --
                    VerticalLayout {
                        spacing: 8px;
                        SectionHead {
                            top-line: true;
                            title: "EXAMPLE OBJECTS";
                            summary: AiLearningState.training_objects.length;
                            open <=> root.objects-open;
                        }
                        if root.objects-open: VerticalLayout {
                            spacing: 8px;
                            CheckBox {
                                text: "Show the objects of other images too";
                                checked <=> AiLearningState.settings.use_other_images;
                            }
                            if AiLearningState.settings.use_other_images: Rectangle {
                                height: 120px;
                                border-width: 1px;
                                border-color: Ink.border-soft;
                                border-radius: Ink.radius-sm;
                                ListView {
                                    for data[index] in AiLearningState.training_images: TrainingImageRow {
                                        data: data;
                                        row_index: index;
                                    }
                                }
                            }
                            Rectangle {
                                height: 200px;
                                border-width: 1px;
                                border-color: Ink.border-soft;
                                border-radius: Ink.radius-sm;
                                ListView {
                                    for data[index] in AiLearningState.training_objects: TrainingObjectRow {
                                        data: data;
                                        row_index: index;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ----- SHOW ON IMAGE: the prediction overlay -----
        // Each pixel (object) in the colour of its predicted class, the
        // stronger the more probable - pale where to paint (label) next.
        VerticalLayout {
            vertical-stretch: 0;
            alignment: start;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;
            Rectangle {
                height: 1px;
                background: Ink.border-soft;
            }
            InkCaption {
                text: "SHOW ON IMAGE";
            }
            InkSegmented {
                label: "Show on image";
                model: ["Prediction", "Off"];
                selected: AiLearningState.prediction_on ? 0 : 1;
                tips: [
                    AiLearningState.settings.mode == 0 ? "Each pixel in the colour of the class it is predicted as - the stronger, the more probable" : "Each object as strong as the model is sure of its class",
                    "Only the image and the objects"
                ];
                picked(index) => {
                    AiLearningState.prediction_on = index == 0;
                    AiLearningState.prediction_changed();
                }
            }
            if AiLearningState.prediction_on: HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Opacity";
                    color: Ink.text-dim;
                    font-size: Ink.fs-secondary;
                    vertical-alignment: center;
                }
                StackTrack {
                    height: 20px;
                    label: "Prediction opacity";
                    value: round(AiLearningState.prediction_opacity * 100);
                    count: 101;
                    unit: " %";
                    picked(v) => {
                        AiLearningState.prediction_opacity = clamp(v, 0, 100) / 100;
                        AiLearningState.prediction_changed();
                    }
                }
                Text {
                    text: round(AiLearningState.prediction_opacity * 100) + " %";
                    min-width: 36px;
                    font-family: Ink.font-mono;
                    font-size: Ink.fs-secondary;
                    color: Ink.text;
                    vertical-alignment: center;
                }
            }
            if AiLearningState.prediction_on && AiLearningState.settings.mode == 0: CheckBox {
                text: "Background in its colour too";
                checked <=> AiLearningState.prediction_background;
                toggled => {
                    AiLearningState.prediction_changed();
                }
            }
            if AiLearningState.prediction_on: CheckBox {
                text: "Values under the cursor";
                checked <=> AiLearningState.prediction_values;
                toggled => {
                    AiLearningState.prediction_changed();
                }
            }
            // The objects to label next: click selects one and flies to it.
            if AiLearningState.prediction_on && AiLearningState.settings.mode == 1 && AiLearningState.prediction_unsure.length > 0: VerticalLayout {
                spacing: 2px;
                InkCaption {
                    text: "MOST UNSURE OBJECTS";
                }
                for object in AiLearningState.prediction_unsure: Rectangle {
                    height: 22px;
                    border-radius: Ink.radius-sm;
                    background: unsure-touch.has-hover ? Ink.hover : transparent;
                    accessible-role: button;
                    accessible-label: object.class + " " + object.percent + " %";
                    accessible-action-default => {
                        AiLearningState.prediction_object_clicked(object.id);
                    }
                    unsure-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AiLearningState.prediction_object_clicked(object.id);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        Rectangle {
                            width: 9px;
                            height: 9px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 2px;
                            background: object.color;
                        }
                        Text {
                            text: object.class;
                            font-size: Ink.fs-secondary;
                            color: Ink.text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: object.percent + " %";
                            font-family: Ink.font-mono;
                            font-size: Ink.fs-secondary;
                            color: Ink.text-dim;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if AiLearningState.prediction_on && AiLearningState.prediction_hint != "": InkBanner {
                tone: InkTone.warn;
                text: AiLearningState.prediction_hint;
            }
            if AiLearningState.prediction_on && AiLearningState.prediction_hint == "": Text {
                text: AiLearningState.settings.mode == 0
                    ? "Pale areas are where the model is unsure - paint examples there, then train again."
                    : "Pale objects are where the model is unsure - copy a few to manual, give them their class, then train again.";
                color: Ink.text-dim;
                font-size: Ink.fs-secondary;
                wrap: word-wrap;
            }
        }

        // ----- STATUS: progress, errors, the result -----
        // The dialog is never closed automatically, including on training
        // completion, so the user can see the result and retrain.
        if AiLearningState.training_status != "": Rectangle {
            background: Ink.ground;
            border-width: 1px;
            border-color: AiLearningState.training_status_is_error ? Ink.err : AiLearningState.training_in_progress ? Ink.focus : Ink.ok;

            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                if !AiLearningState.training_in_progress && !AiLearningState.training_status_is_error: InkCaption {
                    text: "RESULT";
                }
                Text {
                    text: AiLearningState.training_status;
                    color: AiLearningState.training_status_is_error ? Ink.err : AiLearningState.training_in_progress ? Ink.focus : Ink.text;
                    font-size: Ink.fs-secondary;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                }
                if AiLearningState.can_add_to_pipeline && !AiLearningState.training_in_progress: HorizontalLayout {
                    alignment: start;
                    InkButton {
                        small: true;
                        kind: InkButtonKind.primary;
                        icon: InkIcons.add;
                        text: "Add to pipeline";
                        clicked => {
                            AiLearningState.add_to_pipeline_clicked();
                        }
                    }
                }
            }
        }

        // ----- FOOTER: is it ready, the name, Train -----
        InkDivider { }
        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;

            if AiLearningState.readiness_text != "": InkBanner {
                tone: AiLearningState.readiness_tone == 2 ? InkTone.ok : AiLearningState.readiness_tone == 1 ? InkTone.warn : InkTone.neutral;
                text: AiLearningState.readiness_text;
            }
            HorizontalLayout {
                spacing: 6px;
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "model name";
                    text <=> AiLearningState.settings.model_name;
                }
                InkButton {
                    text: "Load…";
                    clicked => {
                        AiLearningState.browse_existing_model_clicked();
                    }
                }
                if AiLearningState.training_in_progress: InkButton {
                    kind: InkButtonKind.danger;
                    text: "Cancel";
                    clicked => {
                        AiLearningState.cancel_training_clicked();
                    }
                }
                InkButton {
                    kind: InkButtonKind.primary;
                    text: "Train";
                    enabled: !AiLearningState.training_in_progress && AiLearningState.readiness_tone > 0;
                    disabled-reason: AiLearningState.training_in_progress ? "Training is already running" : AiLearningState.readiness_text;
                    clicked => {
                        AiLearningState.trigger_train();
                    }
                }
            }
            if AiLearningState.settings.loaded_model_path != "": Text {
                text: "Loaded: " + AiLearningState.settings.loaded_model_path;
                color: Ink.text-mute;
                font-size: Ink.fs-secondary;
                font-family: Ink.font-mono;
                overflow: elide;
            }
        }
    }
}
