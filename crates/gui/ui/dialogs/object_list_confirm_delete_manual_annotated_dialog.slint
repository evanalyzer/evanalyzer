import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { ObjectListState } from "../api/object_list.slint";
import { Ink } from "../ink/palette.slint";


export component ConfirmDeleteManualAnnotatedObjectDialog inherits InkDialog {
    title: "Delete objects";
    card-width: 440px;
    close => {
        GlobalAppState.active-dialog = DialogType.none;
    }

    VerticalLayout {
        spacing: 12px;
        Text {
            text: "This action cannot be undone. Deleting all manual annotated objects.";
            wrap: word-wrap;
            color: Ink.text;
            font-size: 13px;
        }

        Text {
            text: "Delete all manual annotated objects.";
            wrap: word-wrap;
            color: Ink.text-dim;
            font-size: 13px;
        }

        InkDialogFooter {

            InkButton {
                text: "Cancel";
                clicked => {
                    GlobalAppState.active_dialog = DialogType.none;
                }
            }

            InkButton {
                kind: InkButtonKind.danger;
                text: "Delete";
                clicked => {
                    GlobalAppState.active_dialog = DialogType.none;
                    ObjectListState.object_delete_all_manual_annotated();
                    ObjectListState.selected_object = { };
                }
            }
        }
    }
}
