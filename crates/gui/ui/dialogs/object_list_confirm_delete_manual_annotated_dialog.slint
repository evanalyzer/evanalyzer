import { Theme } from "../style.slint";
import { Dialog, DialogFooter, DialogTone } from "../components/new_components/dialog.slint";
import {
    GlobalAppState,
    DialogType,
} from "../state.slint";

import { ObjectListState } from "../editor/object_list_panel.slint";
import { AppButton } from "../components/app_button.slint";

export component ConfirmDeleteManualAnnotatedObjectDialog inherits Dialog {
    title: "Delete objects";
    dialog-width: 440px;
    tone: DialogTone.danger;
    close => {
        GlobalAppState.active-dialog = DialogType.none;
    }

    VerticalLayout {
        spacing: 12px;
        Text {
            text: "This action cannot be undone. Deleting all manual annotated objects.";
            wrap: word-wrap;
            color: Theme.text;
            font-size: 13px;
        }

        Text {
            text: "Delete all manual annotated objects.";
            wrap: word-wrap;
            color: Theme.text-dim;
            font-size: 13px;
        }

        DialogFooter {

            AppButton {
                text: "Cancel";
                clicked => {
                    GlobalAppState.active_dialog = DialogType.none;
                }
            }

            AppButton {
                text: "Delete";
                danger: true;
                clicked => {
                    GlobalAppState.active_dialog = DialogType.none;
                    ObjectListState.object_delete_all_manual_annotated();
                    ObjectListState.selected_object = { };
                }
            }
        }
    }
}
