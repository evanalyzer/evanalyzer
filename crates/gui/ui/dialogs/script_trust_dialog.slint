// dialogs/script_trust_dialog.slint — "Run the script …?" before an export
// runs a script not trusted yet (design canvas "Result exports",
// TrustPrompt; "Settings dialog - project vs. this computer, trusted
// scripts", board Prompt): allow this script or trust the project's
// folder, then Run once or Allow and run. Floats over the window: blurred
// like every dialog (InkDialog). Don't run has the safe place on the left.

import { Ink, InkButton, InkButtonKind, InkDialog, InkDialogFooter, InkHint, InkOptionCard } from "../ink/ink.slint";
import { ScriptTrustState } from "../api/script_trust.slint";

export component ScriptTrustDialog inherits InkDialog {
    title: "Run the script " + ScriptTrustState.name + "?";
    subtitle: ScriptTrustState.more > 0 ? (ScriptTrustState.more + 1) + " scripts to allow" : "";
    card-width: 560px;
    modal: true;
    // What "Allow and run" keeps: false this script, true its folder -
    // back to the script for each one asked about.
    property <bool> whole-folder: false;
    property <string> asked: ScriptTrustState.folder + "/" + ScriptTrustState.about;
    changed asked => {
        root.whole-folder = false;
    }
    close => {
        ScriptTrustState.answer(0);
    }

    VerticalLayout {
        spacing: 10px;

        Text {
            text: "The export “" + ScriptTrustState.export-name + "” runs a script that came with this project. A script can do anything on this computer that you can - only allow it if you trust where the project came from.";
            wrap: word-wrap;
            color: Ink.text;
            font-size: Ink.fs-body;
        }

        if ScriptTrustState.changed-since != "": Rectangle {
            background: Ink.warn-tint;
            border-radius: Ink.radius-md;
            HorizontalLayout {
                padding: 8px;
                padding-left: 12px;
                Text {
                    text: ScriptTrustState.changed-since;
                    color: Ink.text;
                    font-size: Ink.fs-secondary;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: ScriptTrustState.about;
                color: Ink.text-dim;
                font-size: Ink.fs-secondary;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }
            if ScriptTrustState.can-open: InkButton {
                small: true;
                kind: InkButtonKind.quiet;
                text: "Open in editor";
                clicked => {
                    ScriptTrustState.open-in-editor();
                }
            }
        }

        Rectangle {
            background: Ink.viewport;
            border-radius: Ink.radius-md;
            height: 200px;
            clip: true;
            VerticalLayout {
                padding: 12px;
                alignment: start;
                Text {
                    text: ScriptTrustState.preview;
                    font-family: Ink.font-mono;
                    font-size: Ink.fs-secondary;
                    color: #E8E8EA;
                    accessible-label: "The script";
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            InkOptionCard {
                title: "Allow this script";
                description: "Asks again when the file changes.";
                checked: !root.whole-folder;
                picked => {
                    root.whole-folder = false;
                }
            }
            InkOptionCard {
                title: "Trust the folder “" + ScriptTrustState.folder-name + "”";
                description: "Every script in it runs without asking, also after changes.";
                accessible-description: ScriptTrustState.folder;
                checked: root.whole-folder;
                picked => {
                    root.whole-folder = true;
                }
            }
        }

        InkHint {
            text: root.whole-folder ? "Trusts " + ScriptTrustState.folder + " - on a shared folder, other people's changes run too. The export's tables and images are written either way." : "The export's tables and images are written either way.";
            wrap: word-wrap;
        }

        InkDialogFooter {
            InkButton {
                text: "Don't run";
                clicked => {
                    ScriptTrustState.answer(0);
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            InkButton {
                text: "Run once";
                clicked => {
                    ScriptTrustState.answer(1);
                }
            }
            InkButton {
                kind: InkButtonKind.primary;
                text: "Allow and run";
                clicked => {
                    ScriptTrustState.answer(root.whole-folder ? 3 : 2);
                }
            }
        }
    }
}
