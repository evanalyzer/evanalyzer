import { Places } from "../api/layout.slint";
import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { ObjectListState } from "../api/object_list.slint";
import { Ink } from "../ink/palette.slint";

export component ConfirmDeleteObjectDialog inherits InkDialog {
    // Left of the right-hand panels.
    from-right: true;
    anchor-x: Places.beside-right;
    anchor-y: 240px;
    title: "Delete object \{ObjectListState.selected_object.id}?";
    card-width: 320px;
    close => {
        GlobalAppState.active_dialog = DialogType.none;
    }

    Text {
        text: "The selected object is deleted (Undo, Ctrl+Z, brings it back).";
        wrap: word-wrap;
        color: Ink.text;
        font-size: 13px;
    }

    InkDialogFooter {
        InkButton {
            text: "Cancel";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
            }
        }

        InkButton {
            kind: InkButtonKind.danger;
            text: "Delete";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
                ObjectListState.object_delete(ObjectListState.selected_object.id);
                ObjectListState.selected_object = { };
            }
        }
    }
}
