import { Dialog, DialogFooter, DialogTone } from "../components/new_components/dialog.slint";
import { AppButton } from "../components/app_button.slint";
import { Theme } from "../style.slint";
import {
    GlobalAppState,
    DialogType,
} from "../state.slint";
import { ObjectListState } from "../editor/object_list_panel.slint";

export component ConfirmDeleteObjectDialog inherits Dialog {
    title: "Delete object \{ObjectListState.selected_object.id}?";
    tone: DialogTone.danger;
    dialog-width: 440px;
    close => {
        GlobalAppState.active_dialog = DialogType.none;
    }

    Text {
        text: "The selected object is deleted. This can't be undone.";
        wrap: word-wrap;
        color: Theme.text;
        font-size: 13px;
    }

    DialogFooter {
        AppButton {
            text: "Cancel";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
            }
        }

        AppButton {
            text: "Delete";
            danger: true;
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
                ObjectListState.object_delete(ObjectListState.selected_object.id);
                ObjectListState.selected_object = { };
            }
        }
    }
}
