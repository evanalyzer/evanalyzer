import { Dialog, DialogFooter, DialogTone } from "../components/new_components/dialog.slint";
import { AppButton } from "../components/app_button.slint";
import { Theme } from "../style.slint";
import {
    GlobalAppState,
    DialogType,
} from "../state.slint";
import {
    ImagesListState,
} from "../editor/images_list_panel.slint";

export component ImageMissingDialog inherits Dialog {
    title: "Images missing";
    tone: DialogTone.warning;
    dialog-width: 440px;
    close => {
        GlobalAppState.active_dialog = DialogType.none;
    }

    Text {
        text: "The project's image files could not be found. They may have been moved or renamed, or the drive is disconnected.";
        wrap: word-wrap;
        color: Theme.text;
        font-size: 13px;
    }

    Rectangle {
        height: path.preferred-height + 12px;
        background: Theme.bg;
        border-radius: Theme.radius-sm;
        path := Text {
            x: 8px;
            width: parent.width - 16px;
            text: ImagesListState.act_image_root_dir;
            font-family: Theme.font-mono;
            font-size: 11px;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
    }

    Text {
        text: "Search for them there, or select the folder they're in now?";
        wrap: word-wrap;
        color: Theme.text-dim;
        font-size: 12px;
    }

    DialogFooter {
        AppButton {
            text: "Cancel";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
            }
        }

        AppButton {
            text: "Select folder";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
                ImagesListState.open_images_folder_clicked();
            }
        }

        AppButton {
            text: "Search";
            primary: true;
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
                ImagesListState.new_image_root_folder_clicked();
            }
        }
    }
}
