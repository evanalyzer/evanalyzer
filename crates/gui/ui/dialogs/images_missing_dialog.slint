import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { ImagesListState } from "../api/images_list.slint";
import { Ink } from "../ink/palette.slint";

export component ImageMissingDialog inherits InkDialog {
    title: "Images missing";
    card-width: 440px;
    close => {
        GlobalAppState.active_dialog = DialogType.none;
    }

    Text {
        text: "The project's image files could not be found. They may have been moved or renamed, or the drive is disconnected.";
        wrap: word-wrap;
        color: Ink.text;
        font-size: Ink.fs-heading;
    }

    Rectangle {
        height: path.preferred-height + 12px;
        background: Ink.ground;
        border-radius: Ink.radius-sm;
        path := Text {
            x: 8px;
            width: parent.width - 16px;
            text: ImagesListState.act_image_root_dir;
            font-family: Ink.font-mono;
            font-size: Ink.fs-secondary;
            color: Ink.text-dim;
            wrap: word-wrap;
        }
    }

    Text {
        text: "Search for them there, or select the folder they're in now?";
        wrap: word-wrap;
        color: Ink.text-dim;
        font-size: Ink.fs-body;
    }

    InkDialogFooter {
        InkButton {
            text: "Cancel";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
            }
        }

        InkButton {
            text: "Select folder";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
                ImagesListState.open_images_folder_clicked();
            }
        }

        InkButton {
            kind: InkButtonKind.primary;
            text: "Search";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
                ImagesListState.new_image_root_folder_clicked();
            }
        }
    }
}
