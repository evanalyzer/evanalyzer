import { ScrollView } from "std-widgets.slint";
import { GlobalAppState, DialogType, AppInfoState } from "../state.slint";
import { Theme } from "../style.slint";
import { AppButton } from "../components/app_button.slint";

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    height: 30px;
    border-radius: 7px;
    background: root.active ? Theme.accent.with-alpha(0.14) : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: 100ms; }

    Text {
        text: root.text;
        font-size: 12px;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Theme.accent : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ContributorRow inherits VerticalLayout {
    in property <string> person_name;
    in property <string> role;
    spacing: 2px;

    Text {
        text: root.person_name;
        font-size: 13px;
        font-weight: 700;
        color: Theme.text;
    }

    Text {
        text: root.role;
        font-size: 12px;
        color: Theme.text-dim;
        wrap: word-wrap;
    }
}

component InfoStat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value_color: Theme.text;

    height: 56px;
    background: Theme.raised;
    border-radius: 8px;

    VerticalLayout {
        alignment: center;
        padding: 8px;
        spacing: 4px;

        Text {
            text: root.label;
            font-size: 10px;
            font-weight: 600;
            color: Theme.text-mute;
            horizontal-alignment: center;
        }

        Text {
            text: root.value;
            font-size: 13px;
            font-weight: 700;
            color: root.value_color;
            horizontal-alignment: center;
        }
    }
}

export component AboutDialog inherits Rectangle {
    background: Theme.modal-overlay;
    TouchArea { }

    property <int> current-tab: 0;
    // Which license card is expanded, or -1 if none: -2 is EVAnalyzer's own
    // license, 0.. indexes into AppInfoState.third_party_licenses. One
    // shared index (rather than a separate bool for the own-license card)
    // so opening one card closes whichever other was open. Local UI-only
    // state - the underlying model never changes, only what's shown expanded.
    property <int> expanded-third-party-index: -1;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 700px;
        height: 800px;
        background: Theme.panel;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 48px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 16px;
        clip: true;

        VerticalLayout {
            padding: 28px;
            spacing: 0px;

            // -- Header: icon + name + version --------------------------------
            HorizontalLayout {
                height: 60px;
                spacing: 14px;

                Rectangle {
                    width: 56px;
                    height: 56px;
                    border-radius: 14px;
                    background: Theme.accent.with-alpha(0.12);
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.25);
                    Image {
                        source: @image-url("../icons/icon.png");
                        width: 38px;
                        height: 38px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: "EVAnalyzer";
                        font-size: 22px;
                        font-weight: 800;
                        color: Theme.text;
                    }

                    Text {
                        text: "Version " + AppInfoState.version;
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.accent;
                    }
                }
            }

            Rectangle {
                height: 18px;
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Rectangle {
                height: 18px;
            }

            // -- Tab strip -----------------------------------------------------
            HorizontalLayout {
                height: 30px;
                spacing: 4px;

                TabButton {
                    text: "About";
                    active: root.current-tab == 0;
                    clicked => { root.current-tab = 0; }
                }

                TabButton {
                    text: "Contributors";
                    active: root.current-tab == 1;
                    clicked => { root.current-tab = 1; }
                }

                TabButton {
                    text: "System";
                    active: root.current-tab == 2;
                    clicked => { root.current-tab = 2; }
                }

                TabButton {
                    text: "Licenses";
                    active: root.current-tab == 3;
                    clicked => { root.current-tab = 3; }
                }
            }

            Rectangle {
                height: 16px;
            }

            // -- Tab content -----------------------------------------------------
            Rectangle {
                vertical-stretch: 1;

                // -- About ---------------------------------------------------
                if (root.current-tab == 0): VerticalLayout {
                    alignment: center;
                    spacing: 16px;

                    Text {
                        text: "EVAnalyzer " + AppInfoState.version + " is an application for high throughput image processing.";
                        font-size: 13px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Copyright 2019-2026 Joachim Danmayr";
                        font-size: 12px;
                        color: Theme.text-mute;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "https://evanalyzer.org/";
                        font-size: 12px;
                        color: Theme.accent;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "ALL RIGHTS RESERVED";
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1px;
                        color: Theme.text-faint;
                        horizontal-alignment: center;
                    }
                }

                // -- Contributors ----------------------------------------------
                if (root.current-tab == 1): ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding-right: 10px;
                        spacing: 16px;
                        alignment: start;

                        ContributorRow {
                            person_name: "Joachim Danmayr";
                            role: "Creator, Programming, Documentation, Testing";
                        }

                        ContributorRow {
                            person_name: "Melanie Schuerz";
                            role: "Co-Creator, Conceptualization, Testing, AI-Training";
                        }

                        Rectangle {
                            border-width: 1px;
                            border-color: #000;
                            height: 1px;
                        }

                        ContributorRow {
                            person_name: "Tanja Plank";
                            role: "Testing";
                        }

                        ContributorRow {
                            person_name: "Maria Jaritsch";
                            role: "Testing";
                        }

                        ContributorRow {
                            person_name: "Patricia Hrasnova";
                            role: "Testing";
                        }

                        ContributorRow {
                            person_name: "Anna Dlugosch";
                            role: "Testing";
                        }
                    }
                }

                // -- System -------------------------------------------------------
                if (root.current-tab == 2): VerticalLayout {
                    alignment: start;
                    spacing: 10px;

                    InfoStat {
                        label: "CPU Cores";
                        value: "\{AppInfoState.cpu_cores}";
                    }

                    InfoStat {
                        label: "Available RAM";
                        value: AppInfoState.ram_total;
                    }

                    InfoStat {
                        label: "CUDA (GPU) Acceleration";
                        value: AppInfoState.cuda_available ? "Available" : "Not available";
                        value_color: AppInfoState.cuda_available ? Theme.ok : Theme.text-mute;
                    }
                }

                // -- Licenses --------------------------------------------------
                if (root.current-tab == 3): ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Tap a license to view its full text.";
                            font-size: 11px;
                            color: Theme.text-mute;
                        }

                        Rectangle {
                            height: 4px;
                        }

                        // -- EVAnalyzer's own license - same card style as the
                        // third-party entries below, just pinned first and
                        // driven off its own sentinel (-2) rather than the
                        // model index.
                        Rectangle {
                            background: Theme.raised;
                            border-radius: 8px;
                            clip: true;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                Rectangle {
                                    height: own-header-col.preferred-height;

                                    own-header-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.expanded-third-party-index = (root.expanded-third-party-index == -2) ? -1 : -2;
                                        }
                                    }

                                    own-header-col := VerticalLayout {
                                        spacing: 4px;

                                        Text {
                                            text: "EVAnalyzer  (AGPL-3.0)";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: own-header-ta.has-hover ? Theme.accent : Theme.text;
                                        }

                                        Text {
                                            text: "This application's own license";
                                            font-size: 11px;
                                            color: Theme.text-dim;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if (root.expanded-third-party-index == -2): VerticalLayout {
                                    spacing: 6px;

                                    Rectangle {
                                        height: 1px;
                                        background: Theme.border;
                                    }

                                    for paragraph in AppInfoState.license_paragraphs: Text {
                                        text: paragraph;
                                        font-family: Theme.font-mono;
                                        font-size: 10px;
                                        color: Theme.text-dim;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 10px;
                        }

                        Text {
                            text: "Third-party open-source packages (" + AppInfoState.third_party_package_count + ")";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        Rectangle {
                            height: 4px;
                        }

                        for group[i] in AppInfoState.third_party_licenses: Rectangle {
                            background: Theme.raised;
                            border-radius: 8px;
                            clip: true;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                Rectangle {
                                    height: header-col.preferred-height;

                                    header-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.expanded-third-party-index = (root.expanded-third-party-index == i) ? -1 : i;
                                        }
                                    }

                                    header-col := VerticalLayout {
                                        spacing: 4px;

                                        Text {
                                            text: group.name + "  (" + group.id + ")";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: header-ta.has-hover ? Theme.accent : Theme.text;
                                        }

                                        Text {
                                            text: group.crates;
                                            font-size: 11px;
                                            color: Theme.text-dim;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if (root.expanded-third-party-index == i): VerticalLayout {
                                    spacing: 6px;

                                    Rectangle {
                                        height: 1px;
                                        background: Theme.border;
                                    }

                                    for paragraph in group.text_paragraphs: Text {
                                        text: paragraph;
                                        font-family: Theme.font-mono;
                                        font-size: 10px;
                                        color: Theme.text-dim;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // -- Close button ------------------------------------------------
            Rectangle {
                height: 20px;
            }

            AppButton {
                text: "Close";
                primary: true;
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    root.current-tab = 0;
                    root.expanded-third-party-index = -1;
                }
            }
        }
    }
}
