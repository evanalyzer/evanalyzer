import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { AppInfoState, DialogType, GlobalAppState } from "../api/state.slint";
import { ScrollView } from "std-widgets.slint";

import { Ink } from "../ink/palette.slint";

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    horizontal-stretch: 1;
    height: 30px;
    border-radius: Ink.radius-md;
    background: root.active ? Ink.focus.with-alpha(0.14) : (ta.has-hover ? Ink.hover : transparent);
    animate background { duration: 100ms; }

    Text {
        text: root.text;
        font-size: 12px;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Ink.focus : Ink.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ContributorRow inherits Rectangle {
    in property <string> person_name;
    in property <string> role;
    in property <string> initials;
    in property <bool> is_last: false;

    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: Ink.selection;
            y: 0px;

            Text {
                text: root.initials;
                font-size: 12px;
                font-weight: 700;
                color: Ink.focus;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: start;
            spacing: 2px;

            Text {
                text: root.person_name;
                font-size: 13px;
                font-weight: 700;
                color: Ink.text;
            }

            Text {
                text: root.role;
                font-size: 11.5px;
                color: Ink.text-dim;
                wrap: word-wrap;
            }
        }
    }

    if !root.is_last: Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Ink.border-soft;
    }
}

component InfoStat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value_color: Ink.text;

    horizontal-stretch: 1;
    height: 72px;
    background: Ink.raised;
    border-radius: 8px;

    VerticalLayout {
        alignment: center;
        padding: 8px;
        spacing: 6px;

        Text {
            text: root.label;
            font-size: 9.5px;
            font-weight: 600;
            letter-spacing: 0.3px;
            color: Ink.text-mute;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: root.value;
            font-size: 13px;
            font-weight: 700;
            color: root.value_color;
            horizontal-alignment: center;
        }
    }
}

// Small clickable attribution mark for a third-party library whose license
// requires displaying its logo (currently just Slint's Royalty-free License
// - https://slint.dev/agreements/slint-royalty-free-license.pdf, section 2 -
// but written to take more than one as they come up). Sized explicitly
// per-instance rather than auto-fit from the source image, since each logo
// asset has its own aspect ratio.
component AttributionLogo inherits Rectangle {
    in property <image> logo-dark;
    in property <image> logo-light;
    in property <string> url;
    in property <length> logo-width: 48px;
    in property <length> logo-height: 20px;

    width: root.logo-width;
    height: root.logo-height;

    Image {
        source: Ink.dark ? root.logo-dark : root.logo-light;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { Platform.open-url(root.url); }
    }
}

component LicenseCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> expanded;
    callback toggled;

    background: Ink.raised;
    border-radius: 8px;
    clip: true;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        Rectangle {
            height: header-row.preferred-height;

            header-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggled(); }
            }

            header-row := HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.expanded ? "▾" : "▸";
                    font-size: 10px;
                    color: Ink.text-mute;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;

                    Text {
                        text: root.title;
                        font-size: 12px;
                        font-weight: 700;
                        color: header-ta.has-hover ? Ink.focus : Ink.text;
                    }

                    Text {
                        text: root.subtitle;
                        font-size: 11px;
                        color: Ink.text-dim;
                        wrap: word-wrap;
                    }
                }
            }
        }

        if root.expanded: Rectangle {
            height: 1px;
            background: Ink.border;
        }

        // Always instantiated (unlike the divider above) so `@children` has
        // somewhere to live - `@children` can't appear inside a conditional
        // (`if`) element. Collapsed to zero height instead, which - combined
        // with `clip: true` on the root `Rectangle` - keeps the paragraph
        // text invisible and out of the layout until expanded, rather than
        // it rendering unconditionally wherever the root places extra
        // children (which is what happened before this had anywhere to go).
        ScrollView {
            height: root.expanded ? 180px : 0px;
            animate height { duration: 100ms; }

            VerticalLayout {
                alignment: start;
                spacing: 6px;

                @children
            }
        }
    }
}

export component AboutDialog inherits InkDialog {
    title: "EVA";
    subtitle: "Version " + AppInfoState.version + " · High-throughput image analysis";
    card-width: 600px;
    card-height: 600px;
    close => {
        GlobalAppState.active-dialog = DialogType.none;
        root.current-tab = 0;
        root.expanded-third-party-index = -1;
    }

    property <int> current-tab: 0;
    // Which license card is expanded, or -1 if none: -2 is EVAnalyzer's own
    // license, 0.. indexes into AppInfoState.third_party_licenses. One
    // shared index (rather than a separate bool for the own-license card)
    // so opening one card closes whichever other was open. Local UI-only
    // state - the underlying model never changes, only what's shown expanded.
    property <int> expanded-third-party-index: -1;

    // Fresh every time the dialog opens: in remote mode the numbers come
    // from the worker, whose connection may have changed since startup.
    init => {
        AppInfoState.refresh_system_info();
    }

    // -- Tab strip: equal-width tabs -----------------------------------
    HorizontalLayout {
        height: 30px;
        spacing: 4px;

        TabButton {
            text: "About";
            active: root.current-tab == 0;
            clicked => { root.current-tab = 0; }
        }

        TabButton {
            text: "Contributors";
            active: root.current-tab == 1;
            clicked => { root.current-tab = 1; }
        }

        TabButton {
            text: "System";
            active: root.current-tab == 2;
            clicked => { root.current-tab = 2; }
        }

        TabButton {
            text: "Licenses";
            active: root.current-tab == 3;
            clicked => { root.current-tab = 3; }
        }
    }

    // -- Tab content -----------------------------------------------------
    Rectangle {
        vertical-stretch: 1;

        // -- About: top-aligned, link as pill ------------------------
        if (root.current-tab == 0): VerticalLayout {
            alignment: start;
            spacing: 14px;
            padding-top: 6px;

            HorizontalLayout {
                spacing: 14px;

                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: Ink.radius-lg + 2px;
                    background: Ink.focus.with-alpha(0.12);
                    border-width: 1px;
                    border-color: Ink.focus.with-alpha(0.25);
                    Image {
                        source: @image-url("../icons/icon.png");
                        width: 30px;
                        height: 30px;
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: "Enhanced Visual Analyzer " + AppInfoState.version + " is an application for high throughput image processing.";
                    font-size: 13px;
                    color: Ink.text;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }

            Text {
                text: "Copyright 2019-2026 Joachim Danmayr";
                font-size: 12px;
                color: Ink.text-mute;
            }

            Rectangle {
                width: link-text.preferred-width + 28px;
                height: 30px;
                border-radius: 15px;
                background: Ink.raised;
                border-width: 1px;
                border-color: Ink.border;

                link-text := Text {
                    text: "evanalyzer.org ↗";
                    font-size: 12px;
                    font-weight: 600;
                    color: Ink.focus;
                    x: 14px;
                    y: (parent.height - self.height) / 2;
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            Text {
                text: "ALL RIGHTS RESERVED";
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
                color: Ink.text-faint;
            }
        }

        // -- Contributors: divider rows + initial avatars ---------------
        if (root.current-tab == 1): ScrollView {
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding-right: 10px;
                spacing: 0px;
                alignment: start;

                ContributorRow {
                    person_name: "Joachim Danmayr";
                    role: "Creator, Programming, Documentation, Testing";
                    initials: "JD";
                }

                ContributorRow {
                    person_name: "Melanie Schuerz";
                    role: "Co-Creator, Conceptualization, Testing, AI-Training";
                    initials: "MS";
                }

                ContributorRow {
                    person_name: "Tanja Plank";
                    role: "Testing";
                    initials: "TP";
                }

                ContributorRow {
                    person_name: "Maria Jaritsch";
                    role: "Testing";
                    initials: "MJ";
                }

                ContributorRow {
                    person_name: "Patricia Hrasnova";
                    role: "Testing";
                    initials: "PH";
                }

                ContributorRow {
                    person_name: "Anna Dlugosch";
                    role: "Testing";
                    initials: "AD";
                    is_last: true;
                }
            }
        }

        // -- System: where the work runs + 4-column stat grid ---------------
        if (root.current-tab == 2): VerticalLayout {
            alignment: start;
            spacing: 10px;

            Text {
                text: "Computing on: " + AppInfoState.system_source;
                font-size: 11px;
                color: Ink.text-mute;
                wrap: word-wrap;
            }

            if AppInfoState.system_error != "": Text {
                text: AppInfoState.system_error;
                font-size: 11px;
                color: Ink.warn;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;

                InfoStat {
                    label: "OPERATING SYSTEM";
                    value: AppInfoState.system_loading ? "…" : AppInfoState.system_os;
                }

                InfoStat {
                    label: "CPU CORES";
                    value: AppInfoState.system_loading ? "…" : "\{AppInfoState.cpu_cores}";
                }

                InfoStat {
                    label: "AVAILABLE RAM";
                    value: AppInfoState.system_loading ? "…" : AppInfoState.ram_total;
                }

                InfoStat {
                    label: "CUDA (GPU)";
                    value: AppInfoState.system_loading ? "Checking…" : (AppInfoState.cuda_available ? "Available" : "Not available");
                    value_color: AppInfoState.cuda_available && !AppInfoState.system_loading ? Ink.ok : Ink.text-mute;
                }
            }
        }

        // -- Licenses: chevron + capped inner-scroll body ---------------
        if (root.current-tab == 3): ScrollView {
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding-right: 10px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Tap a license to view its full text.";
                    font-size: 11px;
                    color: Ink.text-mute;
                }

                Rectangle {
                    height: 4px;
                }

                // -- EVAnalyzer's own license - same card style as the
                // third-party entries below, just pinned first and
                // driven off its own sentinel (-2) rather than the
                // model index.
                LicenseCard {
                    title: "EVAnalyzer  (AGPL-3.0)";
                    subtitle: "This application's own license";
                    expanded: root.expanded-third-party-index == -2;
                    toggled => {
                        root.expanded-third-party-index = (root.expanded-third-party-index == -2) ? -1 : -2;
                    }

                    for paragraph in AppInfoState.license_paragraphs: Text {
                        text: paragraph;
                        font-family: Ink.font-mono;
                        font-size: 10px;
                        color: Ink.text-dim;
                        wrap: word-wrap;
                    }
                }

                Rectangle {
                    height: 10px;
                }

                // Logos of third-party libraries whose license requires
                // displaying them (just Slint for now).
                HorizontalLayout {
                    height: 20px;
                    alignment: start;
                    spacing: 12px;

                    AttributionLogo {
                        logo-dark: @image-url("../icons/madewithslint-dark.svg");
                        logo-light: @image-url("../icons/madewithslint-light.svg");
                        url: "https://slint.dev";
                        logo-width: 48px;
                        logo-height: 20px;
                    }
                }

                Rectangle {
                    height: 10px;
                }

                Text {
                    text: "Third-party open-source packages (" + AppInfoState.third_party_package_count + ")";
                    font-size: 13px;
                    font-weight: 700;
                    color: Ink.text;
                }

                Rectangle {
                    height: 4px;
                }

                for group[i] in AppInfoState.third_party_licenses: LicenseCard {
                    title: group.name + "  (" + group.id + ")";
                    subtitle: group.crates;
                    expanded: root.expanded-third-party-index == i;
                    toggled => {
                        root.expanded-third-party-index = (root.expanded-third-party-index == i) ? -1 : i;
                    }

                    for paragraph in group.text_paragraphs: Text {
                        text: paragraph;
                        font-family: Ink.font-mono;
                        font-size: 10px;
                        color: Ink.text-dim;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    InkDialogFooter {
        InkButton {
            kind: InkButtonKind.primary;
            text: "Close";
            clicked => {
                root.close();
            }
        }
    }
}
