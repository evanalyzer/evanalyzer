import { ScrollView } from "std-widgets.slint";
import { GlobalAppState, DialogType, AppInfoState } from "../state.slint";
import { Theme } from "../style.slint";
import { AppButton } from "../components/app_button.slint";

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    horizontal-stretch: 1;
    height: 30px;
    border-radius: 7px;
    background: root.active ? Theme.accent.with-alpha(0.14) : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: 100ms; }

    Text {
        text: root.text;
        font-size: 12px;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Theme.accent : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ContributorRow inherits Rectangle {
    in property <string> person_name;
    in property <string> role;
    in property <string> initials;
    in property <bool> is_last: false;

    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: Theme.accent-dim;
            y: 0px;

            Text {
                text: root.initials;
                font-size: 12px;
                font-weight: 700;
                color: Theme.accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: start;
            spacing: 2px;

            Text {
                text: root.person_name;
                font-size: 13px;
                font-weight: 700;
                color: Theme.text;
            }

            Text {
                text: root.role;
                font-size: 11.5px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
        }
    }

    if !root.is_last: Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border-soft;
    }
}

component InfoStat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value_color: Theme.text;

    horizontal-stretch: 1;
    height: 72px;
    background: Theme.raised;
    border-radius: 8px;

    VerticalLayout {
        alignment: center;
        padding: 8px;
        spacing: 6px;

        Text {
            text: root.label;
            font-size: 9.5px;
            font-weight: 600;
            letter-spacing: 0.3px;
            color: Theme.text-mute;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: root.value;
            font-size: 13px;
            font-weight: 700;
            color: root.value_color;
            horizontal-alignment: center;
        }
    }
}

component LicenseCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> expanded;
    callback toggled;

    background: Theme.raised;
    border-radius: 8px;
    clip: true;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        Rectangle {
            height: header-row.preferred-height;

            header-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggled(); }
            }

            header-row := HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.expanded ? "▾" : "▸";
                    font-size: 10px;
                    color: Theme.text-mute;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;

                    Text {
                        text: root.title;
                        font-size: 12px;
                        font-weight: 700;
                        color: header-ta.has-hover ? Theme.accent : Theme.text;
                    }

                    Text {
                        text: root.subtitle;
                        font-size: 11px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                }
            }
        }

        if root.expanded: Rectangle {
            height: 1px;
            background: Theme.border;
        }

        // Always instantiated (unlike the divider above) so `@children` has
        // somewhere to live - `@children` can't appear inside a conditional
        // (`if`) element. Collapsed to zero height instead, which - combined
        // with `clip: true` on the root `Rectangle` - keeps the paragraph
        // text invisible and out of the layout until expanded, rather than
        // it rendering unconditionally wherever the root places extra
        // children (which is what happened before this had anywhere to go).
        ScrollView {
            height: root.expanded ? 180px : 0px;
            animate height { duration: 100ms; }

            VerticalLayout {
                alignment: start;
                spacing: 6px;

                @children
            }
        }
    }
}

export component AboutDialog inherits Rectangle {
    background: Theme.modal-overlay;
    TouchArea { }

    property <int> current-tab: 0;
    // Which license card is expanded, or -1 if none: -2 is EVAnalyzer's own
    // license, 0.. indexes into AppInfoState.third_party_licenses. One
    // shared index (rather than a separate bool for the own-license card)
    // so opening one card closes whichever other was open. Local UI-only
    // state - the underlying model never changes, only what's shown expanded.
    property <int> expanded-third-party-index: -1;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 600px;
        height: 600px;
        background: Theme.panel;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 48px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 16px;
        clip: true;

        VerticalLayout {
            padding: 28px;
            spacing: 0px;

            // -- Header: icon + name + version + tagline ----------------------
            HorizontalLayout {
                height: 64px;
                spacing: 14px;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 16px;
                    background: Theme.accent.with-alpha(0.12);
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.25);
                    Image {
                        source: @image-url("../icons/icon.png");
                        width: 40px;
                        height: 40px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 3px;

                    Text {
                        text: "EVAnalyzer";
                        font-size: 22px;
                        font-weight: 800;
                        color: Theme.text;
                    }

                    Text {
                        text: "Version " + AppInfoState.version;
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.accent;
                    }

                    Text {
                        text: "High-throughput image analysis";
                        font-size: 11.5px;
                        color: Theme.text-mute;
                    }
                }
            }

            Rectangle {
                height: 18px;
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Rectangle {
                height: 18px;
            }

            // -- Tab strip: equal-width tabs -----------------------------------
            HorizontalLayout {
                height: 30px;
                spacing: 4px;

                TabButton {
                    text: "About";
                    active: root.current-tab == 0;
                    clicked => { root.current-tab = 0; }
                }

                TabButton {
                    text: "Contributors";
                    active: root.current-tab == 1;
                    clicked => { root.current-tab = 1; }
                }

                TabButton {
                    text: "System";
                    active: root.current-tab == 2;
                    clicked => { root.current-tab = 2; }
                }

                TabButton {
                    text: "Licenses";
                    active: root.current-tab == 3;
                    clicked => { root.current-tab = 3; }
                }
            }

            Rectangle {
                height: 16px;
            }

            // -- Tab content -----------------------------------------------------
            Rectangle {
                vertical-stretch: 1;

                // -- About: top-aligned, link as pill ------------------------
                if (root.current-tab == 0): VerticalLayout {
                    alignment: start;
                    spacing: 14px;
                    padding-top: 6px;

                    Text {
                        text: "EVAnalyzer " + AppInfoState.version + " is an application for high throughput image processing.";
                        font-size: 13px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "Copyright 2019-2026 Joachim Danmayr";
                        font-size: 12px;
                        color: Theme.text-mute;
                    }

                    Rectangle {
                        width: link-text.preferred-width + 28px;
                        height: 30px;
                        border-radius: 15px;
                        background: Theme.raised;
                        border-width: 1px;
                        border-color: Theme.border;

                        link-text := Text {
                            text: "evanalyzer.org ↗";
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.accent;
                            x: 14px;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    Text {
                        text: "ALL RIGHTS RESERVED";
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1px;
                        color: Theme.text-faint;
                    }
                }

                // -- Contributors: divider rows + initial avatars ---------------
                if (root.current-tab == 1): ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding-right: 10px;
                        spacing: 0px;
                        alignment: start;

                        ContributorRow {
                            person_name: "Joachim Danmayr";
                            role: "Creator, Programming, Documentation, Testing";
                            initials: "JD";
                        }

                        ContributorRow {
                            person_name: "Melanie Schuerz";
                            role: "Co-Creator, Conceptualization, Testing, AI-Training";
                            initials: "MS";
                        }

                        ContributorRow {
                            person_name: "Tanja Plank";
                            role: "Testing";
                            initials: "TP";
                        }

                        ContributorRow {
                            person_name: "Maria Jaritsch";
                            role: "Testing";
                            initials: "MJ";
                        }

                        ContributorRow {
                            person_name: "Patricia Hrasnova";
                            role: "Testing";
                            initials: "PH";
                        }

                        ContributorRow {
                            person_name: "Anna Dlugosch";
                            role: "Testing";
                            initials: "AD";
                            is_last: true;
                        }
                    }
                }

                // -- System: 3-column stat grid -----------------------------------
                if (root.current-tab == 2): VerticalLayout {
                    alignment: start;

                    HorizontalLayout {
                        spacing: 10px;

                        InfoStat {
                            label: "CPU CORES";
                            value: "\{AppInfoState.cpu_cores}";
                        }

                        InfoStat {
                            label: "AVAILABLE RAM";
                            value: AppInfoState.ram_total;
                        }

                        InfoStat {
                            label: "CUDA (GPU)";
                            value: AppInfoState.cuda_available ? "Available" : "Not available";
                            value_color: AppInfoState.cuda_available ? Theme.ok : Theme.text-mute;
                        }
                    }
                }

                // -- Licenses: chevron + capped inner-scroll body ---------------
                if (root.current-tab == 3): ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Tap a license to view its full text.";
                            font-size: 11px;
                            color: Theme.text-mute;
                        }

                        Rectangle {
                            height: 4px;
                        }

                        // -- EVAnalyzer's own license - same card style as the
                        // third-party entries below, just pinned first and
                        // driven off its own sentinel (-2) rather than the
                        // model index.
                        LicenseCard {
                            title: "EVAnalyzer  (AGPL-3.0)";
                            subtitle: "This application's own license";
                            expanded: root.expanded-third-party-index == -2;
                            toggled => {
                                root.expanded-third-party-index = (root.expanded-third-party-index == -2) ? -1 : -2;
                            }

                            for paragraph in AppInfoState.license_paragraphs: Text {
                                text: paragraph;
                                font-family: Theme.font-mono;
                                font-size: 10px;
                                color: Theme.text-dim;
                                wrap: word-wrap;
                            }
                        }

                        Rectangle {
                            height: 10px;
                        }

                        Text {
                            text: "Third-party open-source packages (" + AppInfoState.third_party_package_count + ")";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        Rectangle {
                            height: 4px;
                        }

                        for group[i] in AppInfoState.third_party_licenses: LicenseCard {
                            title: group.name + "  (" + group.id + ")";
                            subtitle: group.crates;
                            expanded: root.expanded-third-party-index == i;
                            toggled => {
                                root.expanded-third-party-index = (root.expanded-third-party-index == i) ? -1 : i;
                            }

                            for paragraph in group.text_paragraphs: Text {
                                text: paragraph;
                                font-family: Theme.font-mono;
                                font-size: 10px;
                                color: Theme.text-dim;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // -- Close button ------------------------------------------------
            Rectangle {
                height: 20px;
            }

            AppButton {
                text: "Close";
                primary: false;
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    root.current-tab = 0;
                    root.expanded-third-party-index = -1;
                }
            }
        }
    }
}
