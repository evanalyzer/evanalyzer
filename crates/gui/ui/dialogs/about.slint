// dialogs/about.slint — About EVAnalyzer (board Y): a dark hero on the
// left (name, version, platform), on the right About (the people as an
// orbit, the creators, the license), System (where the work runs) and
// Licenses (EVAnalyzer's own, then the third-party packages, searchable).
// The hero carries Slint's AboutSlint (on every tab, so it fits beside the
// About tab's full content). Only facts the app knows - no invented numbers.

import {
    InkButton,
    InkButtonKind,
    InkIconButton,
    InkIcons,
    InkSearchField,
    InkDivider,
} from "../ink/ink.slint";
import { AppInfoState, DialogType, GlobalAppState } from "../api/state.slint";
import { AboutSlint, Palette, ScrollView } from "std-widgets.slint";
import { Ink } from "../ink/palette.slint";

struct Person {
    initials: string,
    name: string,
    role: string,
    tint: color,
}

global AboutData {
    // The colors of the orbit (the app's class colors).
    out property <[color]> palette: [#E6C200, #FB7185, #9933FF, #33CFFF, #3CB44B, #f77bf0];
    out property <[Person]> creators: [
        {
            initials: "JD",
            name: "Joachim Danmayr",
            role: "Creator, pipeline developer and lead maintainer",
            tint: #2A6BDF
        },
        {
            initials: "MS",
            name: "Melanie Schürz",
            role: "Pipeline developer, testing and scientific lead",
            tint: #E040E0
        },
    ];
    out property <[Person]> contributors: [
        { initials: "NM", name: "Nicole Meisner Kober", role: "Institue leader", tint: #E6C200 },
        { initials: "CO", name: "Claude Opus 5.5", role: "Unit-Testing", tint: #FB7185 },
        { initials: "MJ", name: "Maria Jaritsch", role: "Testing", tint: #9933FF },
        { initials: "TP", name: "Tanja Plank", role: "Testing", tint: #33CFFF },
        { initials: "PH", name: "Patricia Hrasnova", role: "Testing", tint: #3CB44B },
        { initials: "HZ", name: "Hanwen Zangth", role: "Testing", tint: #f77bf0 },
    ];
}

// A person as a round avatar with initials.
component Avatar inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    in property <length> size: 30px;
    in property <color> ring: Ink.panel;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.tint;
    border-width: 2px;
    border-color: root.ring;
    Text {
        text: root.initials;
        font-size: root.size * 0.33;
        font-weight: 700;
        color: #0B0C10;
    }
}

// The people circling the app's mark: the creators (big, pulsing) and the
// testers on the inner ring, more on the outer one - slowly turning.
component Orbit inherits Rectangle {
    in property <length> size: 268px;
    property <float> s: root.size / 268px;
    property <length> c: root.size / 2;
    property <length> r1: 80px * root.s;
    property <length> r2: 124px * root.s;
    // Turns while shown (the dialog is open only briefly).
    property <angle> turn1: animation-tick() / 38s * 360deg;
    // (Not `-animation-tick()`: Slint 1.18 negates the unsigned tick in Rust.)
    property <angle> turn2: 0deg - animation-tick() / 64s * 360deg;
    // 0..1 of a pulse of the creators.
    property <float> pulse: mod(animation-tick() / 2.8s, 1.0);

    width: root.size;
    height: root.size;

    // The rings.
    Rectangle {
        x: root.c - root.r1;
        y: root.c - root.r1;
        width: 2 * root.r1;
        height: 2 * root.r1;
        border-radius: root.r1;
        border-width: 1px;
        border-color: Ink.border;
    }

    Rectangle {
        x: root.c - root.r2;
        y: root.c - root.r2;
        width: 2 * root.r2;
        height: 2 * root.r2;
        border-radius: root.r2;
        border-width: 1px;
        border-color: Ink.border;
    }

    // The mark in the middle.
    Rectangle {
        x: root.c - self.width / 2;
        y: root.c - self.height / 2;
        width: 82px * root.s;
        height: 82px * root.s;
        border-radius: 16px * root.s;
        Image {
            source: @image-url("../icons/icon.svg");
            width: parent.width * 0.62;
            height: parent.height * 0.62;
        }
    }

    // Outer ring: two testers and three companions.
    for i in 5: outer := Rectangle {
        property <angle> a: root.turn2 + 10deg + i * 72deg;
        property <length> sz: (i < 4 ? 30px : 14px) * root.s;
        x: root.c + root.r2 * cos(self.a) - self.sz / 2;
        y: root.c + root.r2 * sin(self.a) - self.sz / 2;
        width: self.sz;
        height: self.sz;
        if i < 4: Avatar {
            size: outer.sz;
            initials: AboutData.contributors[i + 2].initials;
            tint: AboutData.contributors[i + 2].tint;
        }
        if i >= 4: Rectangle {
            border-radius: self.width / 2;
            border-width: 1.5px;
            border-color: AboutData.palette[i];
        }
    }

    // Inner ring: the creators (big, pulsing) and two testers.
    for i in 4: spot := Rectangle {
        property <bool> lead: mod(i, 2) == 0;
        property <angle> a: root.turn1 - 90deg + i * 90deg;
        property <length> sz: (self.lead ? 46px : 30px) * root.s;
        x: root.c + root.r1 * cos(self.a) - self.sz / 2;
        y: root.c + root.r1 * sin(self.a) - self.sz / 2;
        width: self.sz;
        height: self.sz;
        property <Person> who: self.lead ? AboutData.creators[i / 2] : AboutData.contributors[(i - 1) / 2];
        if spot.lead: Rectangle {
            property <length> grow: spot.sz * root.pulse;
            x: -self.grow / 2;
            y: -self.grow / 2;
            width: spot.sz + self.grow;
            height: spot.sz + self.grow;
            border-radius: self.width / 2;
            border-width: 2px;
            border-color: spot.who.tint.with-alpha(0.6 * (1 - root.pulse));
        }
        Avatar {
            size: spot.sz;
            initials: spot.who.initials;
            tint: spot.who.tint;
        }
    }
}

// A tab in the head: its name, the chosen one underlined.
component AboutTab inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    callback clicked;

    width: row.preferred-width + 24px;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.active;

    row := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        Image {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            width: 14px;
            colorize: root.active ? Ink.text : Ink.text-dim;
        }

        Text {
            text: root.text;
            font-size: Ink.fs-body;
            font-weight: root.active ? 600 : 500;
            color: root.active || ta.has-hover ? Ink.text : Ink.text-dim;
            vertical-alignment: center;
        }
    }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Ink.focus : transparent;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A card: raised, rounded.
component Card inherits Rectangle {
    in property <bool> soft: false;
    background: root.soft ? Ink.selection : Ink.raised;
    border-radius: 10px;
    border-width: root.soft ? 0px : 1px;
    border-color: Ink.border;
}

// "Version   1.4.0" - a label over a value.
component Fact inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> mono;
    spacing: 3px;
    Text {
        text: root.label;
        font-size: Ink.fs-secondary;
        color: Ink.text-dim;
    }

    Text {
        text: root.value;
        font-size: Ink.fs-body;
        font-weight: 500;
        font-family: root.mono ? Ink.font-mono : Ink.font-sans;
        color: Ink.text;
        // Wraps rather than hides part of a fact in a narrow window.
        wrap: word-wrap;
    }
}

// A creator: avatar, name, role.
component PersonCard inherits Card {
    in property <Person> who;
    soft: true;
    height: 54px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 34px;
                initials: root.who.initials;
                tint: root.who.tint;
                ring: transparent;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.who.name;
                font-size: Ink.fs-body;
                font-weight: 600;
                color: Ink.text;
                overflow: elide;
            }

            Text {
                text: root.who.role;
                font-size: Ink.fs-secondary;
                color: Ink.text-dim;
                overflow: elide;
            }
        }
    }
}

// A license group: chevron, name, its packages; open: the text.
component LicenseRow inherits Rectangle {
    in property <string> title;
    in property <string> badge;
    in property <string> subtitle;
    in property <bool> expanded;
    callback toggled;

    background: root.expanded ? Ink.raised : head-ta.has-hover ? Ink.hover : transparent;
    clip: true;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 38px;
            head-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.toggled();
                }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                Text {
                    width: 8px;
                    text: root.expanded ? "▾" : "▸";
                    font-size: 9px;
                    color: Ink.text-faint;
                    vertical-alignment: center;
                }

                Text {
                    text: root.title;
                    font-size: Ink.fs-body;
                    font-weight: 600;
                    color: Ink.text;
                    vertical-alignment: center;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.subtitle;
                    font-size: Ink.fs-secondary;
                    color: Ink.text-dim;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.badge != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 18px;
                        width: badge-text.preferred-width + 14px;
                        border-radius: 4px;
                        background: Ink.ok.with-alpha(0.14);
                        badge-text := Text {
                            text: root.badge;
                            font-size: Ink.fs-caption;
                            font-weight: 600;
                            color: Ink.ok;
                        }
                    }
                }
            }
        }
        // `@children` can't sit in an `if`: collapsed to 0 instead.
        ScrollView {
            height: root.expanded ? 180px : 0px;
            VerticalLayout {
                padding: 14px;
                padding-left: 28px;
                padding-top: 4px;
                spacing: 6px;
                alignment: start;
                @children
            }
        }

        InkDivider { }
    }
}

// Slint's logo, which its Royalty-free License asks to show (section 2 of
// https://slint.dev/agreements/slint-royalty-free-license.pdf).
component AttributionLogo inherits Rectangle {
    width: 48px;
    height: 20px;
    Image {
        source: Ink.dark ? @image-url("../icons/madewithslint-dark.svg") : @image-url("../icons/madewithslint-light.svg");
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Platform.open-url("https://slint.dev");
        }
    }
}

export component AboutDialog inherits Rectangle {
    // 0 About, 1 the contributors, 2 System, 3 Licenses.
    property <int> tab: 0;
    // The license opened: -2 EVAnalyzer's own, 0.. a third-party group.
    property <int> open-license: -1;
    property <string> query;

    function close() {
        GlobalAppState.active-dialog = DialogType.none;
        root.tab = 0;
        root.open-license = -1;
        root.query = "";
    }

    pure function found(words: string) -> bool {
        root.query == "" || words.to-lowercase().replace-all(root.query.to-lowercase(), "") != words.to-lowercase()
    }

    // Fresh every time it opens: in remote mode the numbers come from the
    // worker, whose connection may have changed since startup.
    init => {
        AppInfoState.refresh_system_info();
    }

    card := Rectangle {
        width: min(880px, root.width - 32px);
        height: min(600px, root.height - 32px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Ink.panel;
        border-radius: 14px;
        border-width: 1px;
        border-color: Ink.border;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: Ink.shadow;
        clip: true;
        accessible-role: groupbox;
        accessible-label: "About EVAnalyzer";

        // Clicks stay on the card.
        TouchArea { }

        HorizontalLayout {
            spacing: 0px;

            // -- The hero: always dark ------------------------------------
            hero := Rectangle {
                width: 280px;
                background: #0B0C10;
                clip: true;

                // Circles drifting in the background (objects found).
                for i in 18: Rectangle {
                    property <length> r: (8 + mod(i, 5) * 5) * 1px;
                    property <length> drift: 14px * sin(animation-tick() / (7s + mod(i, 6) * 1.5s) * 360deg + i * 40deg);
                    x: mod(i * 97, 300) * 1px - 20px + self.drift;
                    y: mod(i * 151, 620) * 1px - 20px - self.drift;
                    width: self.r;
                    height: self.r;
                    border-radius: self.r / 2;
                    border-width: 1.5px;
                    border-color: AboutData.palette[mod(i, 4)].with-alpha(0.45);
                }

                VerticalLayout {
                    padding: 28px;
                    spacing: 6px;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 12px;
                        background: #FFFFFF.with-alpha(0.08);
                        Image {
                            source: @image-url("../icons/icon.svg");
                            width: 28px;
                            height: 28px;
                        }
                    }

                    Text {
                        text: "EVAnalyzer";
                        font-size: Ink.fs-display;
                        font-weight: 700;
                        color: #F4F4F5;
                    }

                    Text {
                        text: "Enhanced Visual Analyzer";
                        font-size: Ink.fs-dialog-title;
                        color: #A1A1AA;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    // Made with Slint - Slint's own AboutSlint, as its
                    // Royalty-free license asks. It picks its logo by
                    // std-widgets' color scheme, so it sits on that
                    // scheme's background to stay readable. Its size is
                    // fixed: the logo then keeps its aspect ratio (padding
                    // 2 x 12 + logo 136 x 62 + 8 + two 10 px lines).
                    HorizontalLayout {
                        padding-bottom: 14px;
                        alignment: start;
                        Rectangle {
                            width: 160px;
                            height: 122px;
                            border-radius: 10px;
                            background: Palette.background;
                            made-with-slint := AboutSlint {
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                    }

                    Text {
                        text: "VERSION";
                        font-size: Ink.fs-caption;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                        color: #8A8A93;
                    }

                    Text {
                        text: AppInfoState.version;
                        font-size: Ink.fs-figure;
                        font-weight: 500;
                        font-family: Ink.font-mono;
                        color: #F4F4F5;
                    }

                    HorizontalLayout {
                        padding-top: 2px;
                        padding-bottom: 10px;
                        spacing: 6px;
                        alignment: start;
                        Rectangle {
                            height: 18px;
                            width: chan.preferred-width + 14px;
                            border-radius: 4px;
                            background: AppInfoState.prerelease ? #FBBF24.with-alpha(0.16) : #4ADE80.with-alpha(0.14);
                            chan := Text {
                                text: AppInfoState.prerelease ? "pre-release" : "stable";
                                font-size: Ink.fs-caption;
                                font-weight: 600;
                                color: AppInfoState.prerelease ? #FCD34D : #86EFAC;
                            }
                        }

                        if AppInfoState.platform != "": Rectangle {
                            height: 18px;
                            width: plat.preferred-width + 14px;
                            border-radius: 4px;
                            background: #1F1F23;
                            plat := Text {
                                text: AppInfoState.platform;
                                font-size: Ink.fs-caption;
                                color: #A1A1AA;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #232327;
                    }

                    Text {
                        text: "© 2019–2026 Joachim Danmayr";
                        font-size: Ink.fs-caption;
                        color: #8A8A93;
                    }
                }
            }

            // -- The tabs and their content --------------------------------
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 10px;
                        spacing: 2px;
                        AboutTab {
                            text: "About";
                            icon: InkIcons.info;
                            active: root.tab <= 1;
                            clicked => {
                                root.tab = 0;
                            }
                        }

                        AboutTab {
                            text: "System";
                            icon: InkIcons.computer;
                            active: root.tab == 2;
                            clicked => {
                                root.tab = 2;
                            }
                        }

                        AboutTab {
                            text: "Licenses";
                            icon: InkIcons.copy;
                            active: root.tab == 3;
                            clicked => {
                                root.tab = 3;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        InkIconButton {
                            y: (parent.height - self.height) / 2;
                            size: 32px;
                            icon: InkIcons.close;
                            label: "Close";
                            clicked => {
                                root.close();
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Ink.border-soft;
                    }
                }

                // -- About ---------------------------------------------
                if root.tab == 0: VerticalLayout {
                    vertical-stretch: 1;
                    padding: 22px;
                    spacing: 14px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 20px;
                        // The orbit's place (it's drawn once, over the tabs).
                        Rectangle {
                            width: 200px;
                            height: 200px;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 14px;
                            Text {
                                text: "EVAnalyzer finds, classifies and measures objects in microscopy images with pipelines of steps you can tune live on the image.";
                                font-size: Ink.fs-body;
                                color: Ink.text-dim;
                                wrap: word-wrap;
                            }

                            GridLayout {
                                spacing-horizontal: 16px;
                                spacing-vertical: 12px;
                                Row {
                                    Fact {
                                        label: "Version";
                                        value: AppInfoState.version;
                                        mono: true;
                                    }

                                    Fact {
                                        label: "Platform";
                                        value: AppInfoState.platform;
                                    }
                                }

                                Row {
                                    Fact {
                                        label: "Copyright";
                                        value: "© 2019–2026 Joachim Danmayr";
                                    }

                                    Fact {
                                        label: "License";
                                        value: "PolyForm Noncommercial 1.0.0";
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        for p in AboutData.creators: PersonCard {
                            horizontal-stretch: 1;
                            who: p;
                        }
                    }

                    Card {
                        height: 52px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            HorizontalLayout {
                                alignment: start;
                                spacing: -6px;
                                for p in AboutData.contributors: VerticalLayout {
                                    alignment: center;
                                    Avatar {
                                        size: 26px;
                                        initials: p.initials;
                                        tint: p.tint;
                                        ring: Ink.raised;
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: "and " + AboutData.contributors.length + " contributors";
                                    font-size: Ink.fs-heading;
                                    font-weight: 600;
                                    color: Ink.text;
                                }

                                Text {
                                    text: "Testing";
                                    font-size: Ink.fs-secondary;
                                    color: Ink.text-dim;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                InkButton {
                                    small: true;
                                    text: "See all contributors";
                                    clicked => {
                                        root.tab = 1;
                                    }
                                }
                            }
                        }
                    }

                    Card {
                        height: 56px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "Free for non-commercial use";
                                    font-size: Ink.fs-heading;
                                    font-weight: 600;
                                    color: Ink.text;
                                }

                                Text {
                                    text: "PolyForm Noncommercial 1.0.0 - companies need a license.";
                                    font-size: Ink.fs-secondary;
                                    color: Ink.text-dim;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                InkButton {
                                    small: true;
                                    text: "Read license";
                                    clicked => {
                                        root.open-license = -2;
                                        root.tab = 3;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                InkButton {
                                    small: true;
                                    kind: InkButtonKind.quiet;
                                    text: AppInfoState.third_party_package_count + " libraries →";
                                    clicked => {
                                        root.tab = 3;
                                    }
                                }
                            }
                        }
                    }
                }

                // -- The contributors -------------------------------------
                if root.tab == 1: HorizontalLayout {
                    vertical-stretch: 1;
                    padding: 22px;
                    spacing: 22px;
                    // The orbit's place (drawn once, over the tabs).
                    Rectangle {
                        width: 220px;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 10px;
                        Text {
                            text: "CREATED BY";
                            font-size: Ink.fs-caption;
                            font-weight: 600;
                            letter-spacing: 0.6px;
                            color: Ink.text-mute;
                        }

                        for p in AboutData.creators: PersonCard {
                            who: p;
                        }
                        Text {
                            text: "CONTRIBUTORS";
                            font-size: Ink.fs-caption;
                            font-weight: 600;
                            letter-spacing: 0.6px;
                            color: Ink.text-mute;
                        }

                        VerticalLayout {
                            for p in AboutData.contributors: Rectangle {
                                height: 34px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 5px;
                                            background: p.tint;
                                        }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: p.name;
                                        font-size: Ink.fs-body;
                                        color: Ink.text;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: p.role;
                                        font-size: Ink.fs-secondary;
                                        color: Ink.text-dim;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: Ink.border-soft;
                                }
                            }
                        }
                    }
                }

                // -- System: where the work runs ----------------------------
                if root.tab == 2: VerticalLayout {
                    vertical-stretch: 1;
                    padding: 22px;
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "Computing on: " + AppInfoState.system_source;
                        font-size: Ink.fs-secondary;
                        color: Ink.text-dim;
                    }

                    if AppInfoState.system_error != "": Text {
                        text: AppInfoState.system_error;
                        font-size: Ink.fs-secondary;
                        color: Ink.warn;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        for stat in [
                            {
                                label: "PROCESSOR",
                                value: AppInfoState.system_loading ? "…" : AppInfoState.cpu_cores + " cores",
                                note: "Analysis threads run on them"
                            },
                            {
                                label: "MEMORY",
                                value: AppInfoState.system_loading ? "…" : AppInfoState.ram_total,
                                note: "Installed"
                            },
                            {
                                label: "GPU · CUDA",
                                value: AppInfoState.system_loading ? "Checking…" : AppInfoState.cuda_available ? "Available" : "Not available",
                                note: AppInfoState.cuda_available ? "AI runs on the GPU" : "AI runs on the CPU"
                            },
                        ]: Card {
                            horizontal-stretch: 1;
                            height: 96px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                Text {
                                    text: stat.label;
                                    font-size: Ink.fs-caption;
                                    font-weight: 600;
                                    letter-spacing: 0.6px;
                                    color: Ink.text-mute;
                                }

                                Text {
                                    text: stat.value;
                                    font-size: Ink.fs-figure;
                                    font-weight: 500;
                                    font-family: Ink.font-mono;
                                    color: Ink.text;
                                }

                                Text {
                                    text: stat.note;
                                    font-size: Ink.fs-secondary;
                                    color: Ink.text-dim;
                                }
                            }
                        }
                    }

                    Card {
                        height: 64px;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 24px;
                            Fact {
                                label: "System";
                                value: AppInfoState.system_loading ? "…" : AppInfoState.system_os;
                            }

                            Fact {
                                label: "Platform";
                                value: AppInfoState.platform;
                            }

                            Fact {
                                label: "Version";
                                value: AppInfoState.version;
                                mono: true;
                            }
                        }
                    }
                }

                // -- Licenses -------------------------------------------------
                if root.tab == 3: VerticalLayout {
                    vertical-stretch: 1;
                    padding: 22px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        InkSearchField {
                            horizontal-stretch: 1;
                            placeholder: "Search libraries or licenses";
                            text: root.query;
                            edited(t) => {
                                root.query = t;
                            }
                        }

                        Text {
                            text: AppInfoState.third_party_package_count + " libraries";
                            font-size: Ink.fs-secondary;
                            color: Ink.text-dim;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Ink.border;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                spacing: 0px;
                                if root.found("EVAnalyzer PolyForm Noncommercial 1.0.0"): LicenseRow {
                                    title: "EVAnalyzer";
                                    badge: "PolyForm Noncommercial 1.0.0";
                                    subtitle: "This application";
                                    expanded: root.open-license == -2;
                                    toggled => {
                                        root.open-license = root.open-license == -2 ? -1 : -2;
                                    }
                                    for paragraph in AppInfoState.license_paragraphs: Text {
                                        text: paragraph;
                                        font-family: Ink.font-mono;
                                        font-size: Ink.fs-caption;
                                        color: Ink.text-dim;
                                        wrap: word-wrap;
                                    }
                                }
                                for group[i] in AppInfoState.third_party_licenses: VerticalLayout {
                                    if root.found(group.name + " " + group.id + " " + group.crates): LicenseRow {
                                        title: group.name;
                                        badge: group.id;
                                        subtitle: group.crates;
                                        expanded: root.open-license == i;
                                        toggled => {
                                            root.open-license = root.open-license == i ? -1 : i;
                                        }
                                        for paragraph in group.text_paragraphs: Text {
                                            text: paragraph;
                                            font-family: Ink.font-mono;
                                            font-size: Ink.fs-caption;
                                            color: Ink.text-dim;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // -- Footer -----------------------------------------------------
                Rectangle {
                    height: 56px;
                    Rectangle {
                        y: 0px;
                        height: 1px;
                        background: Ink.border-soft;
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        spacing: 6px;
                        if root.tab == 1: VerticalLayout {
                            alignment: center;
                            InkButton {
                                small: true;
                                kind: InkButtonKind.quiet;
                                text: "← Back to About";
                                clicked => {
                                    root.tab = 0;
                                }
                            }
                        }
                        if root.tab != 1: VerticalLayout {
                            alignment: center;
                            InkButton {
                                small: true;
                                kind: InkButtonKind.quiet;
                                text: "Website ↗";
                                clicked => {
                                    Platform.open-url("https://evanalyzer.org");
                                }
                            }
                        }
                        if root.tab == 3: VerticalLayout {
                            alignment: center;
                            AttributionLogo { }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.tab == 3 ? "Thank you to everyone who builds these" : "";
                            font-size: Ink.fs-secondary;
                            color: Ink.text-mute;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            InkButton {
                                kind: InkButtonKind.primary;
                                text: "Close";
                                clicked => {
                                    root.close();
                                }
                            }
                        }
                    }
                }
            }
        }

        // The people's orbit - one for About and the contributors (it's
        // big), on the place their layouts keep free.
        if root.tab <= 1: Orbit {
            size: root.tab == 0 ? 200px : 220px;
            x: 280px + 22px;
            y: root.tab == 0 ? 52px + 22px : 52px + (card.height - 52px - 56px - 220px) / 2;
        }
    }
}
