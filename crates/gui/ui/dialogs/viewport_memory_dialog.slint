import { SpinBox, Switch } from "std-widgets.slint";
import { BaseDialog } from "dialog_base.slint";
import { GlobalAppState, DialogType } from "../state.slint";
import { AppButton } from "../components/app_button.slint";
import { Theme } from "../style.slint";

// The viewport's RAM/smoothness trade-offs. Kept on this computer (they are
// about its RAM) and applied as soon as they change.
export global ViewportMemoryState {
    in-out property <bool> tile_history_enabled: false;
    in-out property <int> tile_history_budget_mb: 512;
    in-out property <int> object_overlay_margin_px: 256;

    callback changed();
    callback reset_to_defaults();
}

component Hint inherits Text {
    wrap: word-wrap;
    color: Theme.text-dim;
    font-size: 11px;
}

export component ViewportMemoryDialog inherits BaseDialog {
    title-text: "Viewport memory";
    icon: "▦";
    main-height: 440px;
    main-width: 480px;

    VerticalLayout {
        spacing: 14px;

        VerticalLayout {
            spacing: 5px;
            Switch {
                text: "Keep earlier high-resolution renders";
                checked <=> ViewportMemoryState.tile_history_enabled;
                toggled => {
                    ViewportMemoryState.changed();
                }
            }

            Hint {
                text: "Panning back or zooming then shows the sharp earlier renders instead of the blurry overview - most useful for whole slide images. Off: only the current render and one overview are kept (least RAM).";
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Memory for earlier renders (MB)";
                vertical-alignment: center;
                horizontal-stretch: 1;
                color: ViewportMemoryState.tile_history_enabled ? Theme.text : Theme.text-dim;
            }

            SpinBox {
                width: 120px;
                enabled: ViewportMemoryState.tile_history_enabled;
                minimum: 64;
                maximum: 16384;
                step-size: 64;
                value <=> ViewportMemoryState.tile_history_budget_mb;
                edited => {
                    ViewportMemoryState.changed();
                }
            }
        }

        VerticalLayout {
            spacing: 5px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: "Object overlay margin (px)";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                SpinBox {
                    width: 120px;
                    minimum: 0;
                    maximum: 2048;
                    step-size: 64;
                    value <=> ViewportMemoryState.object_overlay_margin_px;
                    edited => {
                        ViewportMemoryState.changed();
                    }
                }
            }

            Hint {
                text: "How far objects are drawn past the visible area, so they don't leave an empty border while panning. 0 uses the least RAM; objects at a newly uncovered edge then appear once you stop moving.";
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: end;

            AppButton {
                text: "Reset to defaults";
                clicked => {
                    ViewportMemoryState.reset_to_defaults();
                }
            }

            AppButton {
                text: "Close";
                primary: true;
                clicked => {
                    GlobalAppState.active_dialog = DialogType.none;
                }
            }
        }
    }
}
