// file_browser_dialog.slint — the app's own open/save/folder dialog. It
// browses the file system of wherever the backend runs (this computer, or
// the server in remote mode), so it replaces the OS dialogs everywhere.
//
// Rendered as an overlay above everything else (including other dialogs, so
// e.g. the AI learning dialog can open it), driven entirely by
// `FileBrowserState` from Rust: Rust lists folders on a background thread
// and pushes rows; this file only renders and reports clicks/keys.
import { InkButton, InkButtonKind, InkIconButton, InkDialog, InkDialogFooter, InkIcons, InkTextField, InkSearchField, InkSelect } from "../ink/ink.slint";
import { FileBrowserEntry, FileBrowserMode, FileBrowserPlace, FileBrowserState } from "../api/file_browser.slint";

import { ScrollView } from "std-widgets.slint";
import { Ink } from "../ink/palette.slint";
component PlaceRow inherits Rectangle {
    in property <FileBrowserPlace> place;
    in property <bool> current;
    callback clicked;

    height: 32px;
    border-radius: Ink.radius-md;
    background: root.current ? Ink.selection : ta.has-hover ? Ink.hover : transparent;
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        Image {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            source: root.place.kind == 0 ? @image-url("../icons/regular-white/house.svg")
                  : root.place.kind == 1 ? @image-url("../icons/regular-white/hard-drives.svg")
                  : @image-url("../icons/regular-white/folder-simple.svg");
            colorize: root.current ? Ink.focus : Ink.text-dim;
        }
        Text {
            text: root.place.name;
            font-size: Ink.fs-heading;
            font-weight: root.current ? 600 : 400;
            color: root.current ? Ink.focus : Ink.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component EntryRow inherits Rectangle {
    in property <FileBrowserEntry> entry;
    in property <bool> selected;
    in property <bool> zebra;
    callback clicked;
    callback double-clicked;

    background: root.selected ? Ink.selection
              : ta.has-hover ? Ink.hover
              : root.zebra ? Ink.field : transparent;
    border-radius: Ink.radius-sm;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 12px;

        Image {
            colorize: Ink.text-dim;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            source: root.entry.kind == 0 ? @image-url("../icons/duotone-blue/folder-duotone.svg")
                  : root.entry.kind == 1 ? @image-url("../icons/duotone-blue/file-image-duotone.svg")
                  : root.entry.kind == 2 ? @image-url("../icons/regular-white/file-text.svg")
                  : root.entry.kind == 3 ? @image-url("../icons/regular-white/cube.svg")
                  : root.entry.kind == 4 ? @image-url("../icons/regular-white/database.svg")
                  : @image-url("../icons/regular-white/file.svg");
        }
        Text {
            horizontal-stretch: 1;
            text: root.entry.name;
            font-size: Ink.fs-heading;
            font-weight: root.entry.is-dir ? 500 : 400;
            color: Ink.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 90px;
            text: root.entry.size;
            font-size: Ink.fs-body;
            font-family: Ink.font-mono;
            color: Ink.text-dim;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            width: 140px;
            text: root.entry.modified;
            font-size: Ink.fs-body;
            color: Ink.text-dim;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }
}

export component FileBrowserDialog inherits InkDialog {
    title: FileBrowserState.title;
    subtitle: FileBrowserState.location;
    card-width: 980px;
    card-height: 640px;
    content-padding: 0px;
    close => {
        if (FileBrowserState.overwrite-name != "") {
            FileBrowserState.overwrite-answered(false);
            keys.focus();
        } else {
            FileBrowserState.cancel();
        }
    }

    // Manual windowing (see multi_select_dropdown.slint): folders with
    // thousands of images must not instantiate thousands of rows.
    property <length> row-height: 34px;
    property <length> row-pitch: 36px;
    property <int> window-size: 40;

    // Esc is the Dialog's (`close` above); the rest is the browser's.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return) {
                if (FileBrowserState.overwrite-name != "") {
                    FileBrowserState.overwrite-answered(true);
                } else if (FileBrowserState.can-accept) {
                    FileBrowserState.accept();
                }
                return accept;
            }
            if (event.text == Key.Backspace && event.modifiers.alt) {
                FileBrowserState.go-up();
                return accept;
            }
            if (event.text == Key.UpArrow && FileBrowserState.selected > 0) {
                FileBrowserState.select(FileBrowserState.selected - 1);
                return accept;
            }
            if (event.text == Key.DownArrow && FileBrowserState.selected + 1 < FileBrowserState.entries.length) {
                FileBrowserState.select(FileBrowserState.selected + 1);
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;

            // ---- Body: places | folder -------------------------------------
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // Places sidebar
                Rectangle {
                    width: 196px;
                    background: Ink.panel;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;
                        Text {
                            text: FileBrowserState.remote ? "SERVER LOCATIONS" : "PLACES";
                            font-size: Ink.fs-caption;
                            font-weight: 700;
                            letter-spacing: 0.6px;
                            color: Ink.text-mute;
                        }
                        Rectangle { height: 6px; }
                        for place in FileBrowserState.places: PlaceRow {
                            place: place;
                            current: FileBrowserState.current-path == place.path;
                            clicked => { FileBrowserState.navigate(place.path); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle { width: 1px; background: Ink.border-soft; }

                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 12px;
                    spacing: 10px;

                    // Toolbar: up / refresh / breadcrumbs / search / hidden
                    HorizontalLayout {
                        spacing: 6px;
                        InkIconButton {
                            size: 30px;
                            label: "Up";
                            icon: @image-url("../icons/regular-white/arrow-up.svg");
                            enabled: FileBrowserState.crumbs.length > 1;
                            disabled-reason: "Already at the top";
                            clicked => { FileBrowserState.go-up(); }
                        }
                        InkIconButton {
                            size: 30px;
                            label: "Refresh";
                            icon: @image-url("../icons/regular-white/arrow-clockwise.svg");
                            clicked => { FileBrowserState.refresh(); }
                        }

                        // Breadcrumbs, or a typed path while editing
                        crumb-box := Rectangle {
                            horizontal-stretch: 1;
                            height: 32px;
                            border-radius: Ink.radius-md;
                            background: Ink.raised;
                            border-width: 1px;
                            border-color: Ink.border-soft;
                            property <bool> editing: false;

                            if !crumb-box.editing: Flickable {
                                x: 6px;
                                width: parent.width - 40px;
                                content-width: crumb-row.preferred-width;
                                interactive: false;
                                // Keep the deepest folder visible.
                                content-x: min(0px, self.width - crumb-row.preferred-width);
                                crumb-row := HorizontalLayout {
                                    height: 32px;
                                    spacing: 0px;
                                    for crumb[i] in FileBrowserState.crumbs: HorizontalLayout {
                                        spacing: 0px;
                                        if i > 0: Image {
                                            width: 12px;
                                            height: 12px;
                                            y: (parent.height - self.height) / 2;
                                            source: @image-url("../icons/regular-white/caret-right.svg");
                                            colorize: Ink.text-faint;
                                        }
                                        Rectangle {
                                            border-radius: Ink.radius-sm;
                                            background: crumb-ta.has-hover ? Ink.hover : transparent;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: crumb.name;
                                                    font-size: Ink.fs-body;
                                                    font-weight: i == FileBrowserState.crumbs.length - 1 ? 600 : 400;
                                                    color: i == FileBrowserState.crumbs.length - 1 ? Ink.text : Ink.text-dim;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            crumb-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { FileBrowserState.navigate(crumb.path); }
                                            }
                                        }
                                    }
                                }
                            }
                            if crumb-box.editing: InkTextField {
                                width: parent.width - 34px;
                                height: parent.height;
                                x: 0px;
                                mono: true;
                                autofocus: true;
                                label: "Folder path";
                                value: FileBrowserState.current-path;
                                accepted(text) => {
                                    crumb-box.editing = false;
                                    FileBrowserState.path-entered(text);
                                    keys.focus();
                                }
                            }
                            InkIconButton {
                                x: parent.width - self.width - 1px;
                                y: 1px;
                                size: 30px;
                                label: crumb-box.editing ? "Stop editing path" : "Edit path";
                                icon: crumb-box.editing ? InkIcons.close : InkIcons.edit;
                                clicked => {
                                    crumb-box.editing = !crumb-box.editing;
                                    if (!crumb-box.editing) { keys.focus(); }
                                }
                            }
                        }

                        InkSearchField {
                            width: 190px;
                            placeholder: "Filter this folder";
                            text: FileBrowserState.search;
                            edited(text) => { FileBrowserState.search-edited(text); }
                        }
                        InkIconButton {
                            icon: FileBrowserState.show-hidden
                                ? @image-url("../icons/regular-white/eye.svg")
                                : @image-url("../icons/regular-white/eye-slash.svg");
                            size: 30px;
                            label: "Show hidden files";
                            active: FileBrowserState.show-hidden;
                            clicked => { FileBrowserState.hidden-toggled(!FileBrowserState.show-hidden); }
                        }
                    }

                    // File list
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: Ink.radius-lg;
                        border-width: 1px;
                        border-color: Ink.border-soft;
                        background: Ink.panel;
                        clip: true;

                        VerticalLayout {
                            spacing: 0px;
                            // Column header
                            Rectangle {
                                height: 30px;
                                background: Ink.raised;
                                HorizontalLayout {
                                    padding-left: 42px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    Text { horizontal-stretch: 1; text: "Name"; font-size: Ink.fs-secondary; font-weight: 600; color: Ink.text-mute; vertical-alignment: center; }
                                    Text { width: 90px; text: "Size"; font-size: Ink.fs-secondary; font-weight: 600; color: Ink.text-mute; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { width: 140px; text: "Modified"; font-size: Ink.fs-secondary; font-weight: 600; color: Ink.text-mute; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }

                            list := ScrollView {
                                vertical-stretch: 1;
                                content-height: FileBrowserState.entries.length * root.row-pitch + 8px;
                                property <int> first: max(0, floor(-self.content-y / root.row-pitch) - 5);

                                for i in root.window-size: row := Rectangle {
                                    property <int> index: list.first + i;
                                    x: 4px;
                                    y: 4px + self.index * root.row-pitch;
                                    width: list.visible-width - 8px;
                                    height: root.row-height;
                                    if row.index < FileBrowserState.entries.length: EntryRow {
                                        width: row.width;
                                        height: row.height;
                                        entry: FileBrowserState.entries[row.index];
                                        selected: row.index == FileBrowserState.selected;
                                        zebra: Math.mod(row.index, 2) == 1;
                                        clicked => {
                                            FileBrowserState.select(row.index);
                                            keys.focus();
                                        }
                                        double-clicked => { FileBrowserState.activate(row.index); }
                                    }
                                }
                            }
                        }

                        // Empty / loading / error states
                        if FileBrowserState.entries.length == 0: VerticalLayout {
                            y: 30px;
                            height: parent.height - 30px;
                            alignment: center;
                            spacing: 8px;
                            Image {
                                height: 34px;
                                source: FileBrowserState.error != ""
                                    ? @image-url("../icons/regular-white/warning-circle.svg")
                                    : @image-url("../icons/regular-white/folder-open.svg");
                                colorize: FileBrowserState.error != "" ? Ink.err : Ink.text-faint;
                            }
                            Text {
                                text: FileBrowserState.loading ? "Loading…"
                                    : FileBrowserState.error != "" ? FileBrowserState.error
                                    : FileBrowserState.search != "" ? "Nothing matches “" + FileBrowserState.search + "”"
                                    : "This folder is empty";
                                font-size: Ink.fs-heading;
                                color: FileBrowserState.error != "" ? Ink.err : Ink.text-mute;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        if FileBrowserState.loading && FileBrowserState.entries.length > 0: Rectangle {
                            y: 30px;
                            height: 2px;
                            background: Ink.focus;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Ink.border-soft; }

            // ---- Footer -------------------------------------------------
            VerticalLayout {
                padding-left: Ink.pad-dialog;
                padding-right: Ink.pad-dialog;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;

                // The file name (saving) and the file type: a row of their own.
                if FileBrowserState.mode == FileBrowserMode.save-file || FileBrowserState.filter-names.length > 1: HorizontalLayout {
                    spacing: 8px;
                    if FileBrowserState.mode == FileBrowserMode.save-file: name-field := InkTextField {
                        horizontal-stretch: 1;
                        placeholder: "File name";
                        value: FileBrowserState.file-name;
                        edited(text) => { FileBrowserState.file-name-edited(text); }
                        accepted(text) => {
                            FileBrowserState.file-name-edited(text);
                            if (FileBrowserState.can-accept) { FileBrowserState.accept(); }
                        }
                    }
                    if FileBrowserState.mode != FileBrowserMode.save-file: Rectangle {
                        horizontal-stretch: 1;
                    }
                    if FileBrowserState.filter-names.length > 1: InkSelect {
                        width: 230px;
                        horizontal-stretch: 0;
                        label: "File type";
                        model: FileBrowserState.filter-names;
                        value: FileBrowserState.filter-name;
                        picked(i, name) => { FileBrowserState.filter-selected(name); }
                    }
                }

                // The status (what is chosen), the buttons.
                HorizontalLayout {
                    spacing: 6px;

                    Text {
                        horizontal-stretch: 1;
                        text: FileBrowserState.mode != FileBrowserMode.save-file ? FileBrowserState.status : "";
                        font-size: Ink.fs-secondary;
                        color: Ink.text-dim;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // New folder (inline)
                    new-folder := HorizontalLayout {
                        spacing: 6px;
                        property <bool> naming: false;
                        if !new-folder.naming: InkButton {
                            text: "New folder";
                            clicked => { new-folder.naming = true; }
                        }
                        if new-folder.naming: InkTextField {
                            width: 200px;
                            placeholder: "Folder name";
                            label: "Folder name";
                            autofocus: true;
                            accepted(text) => {
                                new-folder.naming = false;
                                FileBrowserState.create-folder(text);
                                keys.focus();
                            }
                        }
                        if new-folder.naming: InkIconButton {
                            y: 3px;
                            size: 30px;
                            label: "Cancel new folder";
                            icon: @image-url("../icons/regular-white/x.svg");
                            clicked => { new-folder.naming = false; keys.focus(); }
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: FileBrowserState.error != "" && FileBrowserState.entries.length > 0 ? FileBrowserState.error : "";
                        font-size: Ink.fs-body;
                        color: Ink.err;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        overflow: elide;
                    }

                    InkButton {
                        text: "Cancel";
                        clicked => { FileBrowserState.cancel(); }
                    }
                    InkButton {
                        kind: InkButtonKind.primary;
                        text: FileBrowserState.accept-label;
                        enabled: FileBrowserState.can-accept;
                        disabled-reason: "Pick a file or folder first";
                        clicked => { FileBrowserState.accept(); }
                    }
                }
            }
        }

        // ---- Overwrite confirmation (a dialog over the browser) ---------
        if FileBrowserState.overwrite-name != "": InkDialog {
            title: "Replace existing file?";
            card-width: 420px;
            close => {
                FileBrowserState.overwrite-answered(false);
                keys.focus();
            }

            Text {
                text: "“" + FileBrowserState.overwrite-name + "” already exists in this folder. Replacing it overwrites its contents.";
                font-size: Ink.fs-heading;
                color: Ink.text;
                wrap: word-wrap;
            }

            InkDialogFooter {
                InkButton {
                    text: "Cancel";
                    clicked => { FileBrowserState.overwrite-answered(false); keys.focus(); }
                }
                InkButton {
                    kind: InkButtonKind.danger;
                    text: "Replace";
                    clicked => { FileBrowserState.overwrite-answered(true); }
                }
            }
        }
    }

    init => { keys.focus(); }
}
