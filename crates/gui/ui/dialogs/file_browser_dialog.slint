// file_browser_dialog.slint — the app's own open/save/folder dialog. It
// browses the file system of wherever the backend runs (this computer, or
// the server in remote mode), so it replaces the OS dialogs everywhere.
//
// Rendered as an overlay above everything else (including other dialogs, so
// e.g. the AI learning dialog can open it), driven entirely by
// `FileBrowserState` from Rust: Rust lists folders on a background thread
// and pushes rows; this file only renders and reports clicks/keys.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../style.slint";
import { AppButton } from "../components/app_button.slint";
import { TextField } from "../components/new_components/text_field.slint";
import { DropdownField } from "../components/new_components/dropdown.slint";

export enum FileBrowserMode { open-file, open-folder, save-file }

// kind: 0 home, 1 drive, 2 folder
export struct FileBrowserPlace {
    name: string,
    path: string,
    kind: int,
}

export struct FileBrowserCrumb {
    name: string,
    path: string,
}

// kind: 0 folder, 1 image, 2 project/template, 3 model, 4 results, 5 other
export struct FileBrowserEntry {
    name: string,
    path: string,
    is-dir: bool,
    size: string,
    modified: string,
    kind: int,
}

export global FileBrowserState {
    in-out property <bool> visible: false;
    in-out property <FileBrowserMode> mode: FileBrowserMode.open-file;
    in-out property <string> title: "Open";
    in-out property <string> accept-label: "Open";
    // Where the browsed files live, e.g. "This computer" / "Server ws://…".
    in-out property <string> location;
    in-out property <bool> remote: false;
    in-out property <string> current-path;
    in-out property <[FileBrowserCrumb]> crumbs;
    in-out property <[FileBrowserPlace]> places;
    in-out property <[FileBrowserEntry]> entries;
    in-out property <int> selected: -1;
    in-out property <string> file-name;
    in-out property <[string]> filter-names;
    in-out property <string> filter-name;
    in-out property <string> search;
    in-out property <bool> show-hidden: false;
    in-out property <bool> loading: false;
    in-out property <string> error;
    in-out property <string> status;
    // Non-empty: ask whether to replace this existing file.
    in-out property <string> overwrite-name;
    in-out property <bool> can-accept: false;

    callback navigate(string);
    callback go-up();
    callback refresh();
    callback select(int);
    callback activate(int);
    callback accept();
    callback cancel();
    callback search-edited(string);
    callback filter-selected(string);
    callback hidden-toggled(bool);
    callback path-entered(string);
    callback create-folder(string);
    callback overwrite-answered(bool);
    callback file-name-edited(string);
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked;

    width: 30px;
    height: 30px;
    border-radius: Theme.radius-md;
    background: root.active ? Theme.accent-dim : ta.has-hover && root.enabled ? Theme.hover : transparent;
    opacity: root.enabled ? 1.0 : 0.4;
    animate background { duration: 80ms; }

    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: root.active ? Theme.accent : Theme.text-dim;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component PlaceRow inherits Rectangle {
    in property <FileBrowserPlace> place;
    in property <bool> current;
    callback clicked;

    height: 32px;
    border-radius: Theme.radius-md;
    background: root.current ? Theme.accent-dim : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        Image {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            source: root.place.kind == 0 ? @image-url("../icons/regular-gray/house.svg")
                  : root.place.kind == 1 ? @image-url("../icons/regular-gray/hard-drives.svg")
                  : @image-url("../icons/regular-gray/folder-simple.svg");
            colorize: root.current ? Theme.accent : Theme.text-dim;
        }
        Text {
            text: root.place.name;
            font-size: 13px;
            font-weight: root.current ? 600 : 400;
            color: root.current ? Theme.accent : Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component EntryRow inherits Rectangle {
    in property <FileBrowserEntry> entry;
    in property <bool> selected;
    in property <bool> zebra;
    callback clicked;
    callback double-clicked;

    background: root.selected ? Theme.list-select-row-bg
              : ta.has-hover ? Theme.hover
              : root.zebra ? Theme.list-row-alt-bg : transparent;
    border-radius: Theme.radius-sm;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 12px;

        Image {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            source: root.entry.kind == 0 ? @image-url("../icons/duotone-blue/folder-duotone.svg")
                  : root.entry.kind == 1 ? @image-url("../icons/duotone-blue/file-image-duotone.svg")
                  : root.entry.kind == 2 ? @image-url("../icons/regular-gray/file-text.svg")
                  : root.entry.kind == 3 ? @image-url("../icons/regular-gray/cube.svg")
                  : root.entry.kind == 4 ? @image-url("../icons/regular-gray/database.svg")
                  : @image-url("../icons/regular-gray/file.svg");
        }
        Text {
            horizontal-stretch: 1;
            text: root.entry.name;
            font-size: 13px;
            font-weight: root.entry.is-dir ? 500 : 400;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 90px;
            text: root.entry.size;
            font-size: 12px;
            font-family: Theme.font-mono;
            color: Theme.text-dim;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            width: 140px;
            text: root.entry.modified;
            font-size: 12px;
            color: Theme.text-dim;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }
}

export component FileBrowserDialog inherits Rectangle {
    background: Theme.modal-overlay;

    // Block clicks to whatever is underneath.
    TouchArea { }

    // Manual windowing (see multi_select_dropdown.slint): folders with
    // thousands of images must not instantiate thousands of rows.
    property <length> row-height: 34px;
    property <length> row-pitch: 36px;
    property <int> window-size: 40;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (FileBrowserState.overwrite-name != "") {
                    FileBrowserState.overwrite-answered(false);
                } else {
                    FileBrowserState.cancel();
                }
                return accept;
            }
            if (event.text == Key.Return) {
                if (FileBrowserState.overwrite-name != "") {
                    FileBrowserState.overwrite-answered(true);
                } else if (FileBrowserState.can-accept) {
                    FileBrowserState.accept();
                }
                return accept;
            }
            if (event.text == Key.Backspace && event.modifiers.alt) {
                FileBrowserState.go-up();
                return accept;
            }
            if (event.text == Key.UpArrow && FileBrowserState.selected > 0) {
                FileBrowserState.select(FileBrowserState.selected - 1);
                return accept;
            }
            if (event.text == Key.DownArrow && FileBrowserState.selected + 1 < FileBrowserState.entries.length) {
                FileBrowserState.select(FileBrowserState.selected + 1);
                return accept;
            }
            reject
        }
    }
    init => { keys.focus(); }

    card := Rectangle {
        width: min(parent.width - 48px, 980px);
        height: min(parent.height - 48px, 640px);
        background: Theme.panel;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow;
        clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // ---- Header -------------------------------------------------
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 14px;
                padding-top: 16px;
                padding-bottom: 14px;
                spacing: 12px;

                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    background: Theme.accent-dim;
                    Image {
                        width: 18px;
                        height: 18px;
                        source: FileBrowserState.mode == FileBrowserMode.save-file
                            ? @image-url("../icons/regular-gray/floppy-disk.svg")
                            : FileBrowserState.mode == FileBrowserMode.open-folder
                            ? @image-url("../icons/regular-gray/folder-open.svg")
                            : @image-url("../icons/regular-gray/file.svg");
                        colorize: Theme.accent;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: FileBrowserState.title;
                        font-size: 17px;
                        font-weight: 700;
                        color: Theme.text-bright;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Image {
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                            source: FileBrowserState.remote
                                ? @image-url("../icons/regular-gray/hard-drives.svg")
                                : @image-url("../icons/regular-gray/desktop.svg");
                            colorize: FileBrowserState.remote ? Theme.accent : Theme.text-mute;
                        }
                        Text {
                            text: FileBrowserState.location;
                            font-size: 11.5px;
                            color: FileBrowserState.remote ? Theme.accent : Theme.text-mute;
                        }
                    }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("../icons/regular-gray/x.svg");
                    clicked => { FileBrowserState.cancel(); }
                }
            }

            Rectangle { height: 1px; background: Theme.border-soft; }

            // ---- Body: places | folder -------------------------------------
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // Places sidebar
                Rectangle {
                    width: 196px;
                    background: Theme.sidebar;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;
                        Text {
                            text: FileBrowserState.remote ? "SERVER LOCATIONS" : "PLACES";
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 0.6px;
                            color: Theme.text-mute;
                        }
                        Rectangle { height: 6px; }
                        for place in FileBrowserState.places: PlaceRow {
                            place: place;
                            current: FileBrowserState.current-path == place.path;
                            clicked => { FileBrowserState.navigate(place.path); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle { width: 1px; background: Theme.border-soft; }

                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 12px;
                    spacing: 10px;

                    // Toolbar: up / refresh / breadcrumbs / search / hidden
                    HorizontalLayout {
                        spacing: 6px;
                        IconButton {
                            icon: @image-url("../icons/regular-gray/arrow-up.svg");
                            enabled: FileBrowserState.crumbs.length > 1;
                            clicked => { FileBrowserState.go-up(); }
                        }
                        IconButton {
                            icon: @image-url("../icons/regular-gray/arrow-clockwise.svg");
                            clicked => { FileBrowserState.refresh(); }
                        }

                        // Breadcrumbs, or a typed path while editing
                        crumb-box := Rectangle {
                            horizontal-stretch: 1;
                            height: 32px;
                            border-radius: Theme.radius-md;
                            background: Theme.raised;
                            border-width: 1px;
                            border-color: Theme.border-soft;
                            property <bool> editing: false;

                            if !crumb-box.editing: Flickable {
                                x: 6px;
                                width: parent.width - 40px;
                                content-width: crumb-row.preferred-width;
                                interactive: false;
                                // Keep the deepest folder visible.
                                content-x: min(0px, self.width - crumb-row.preferred-width);
                                crumb-row := HorizontalLayout {
                                    height: 32px;
                                    spacing: 0px;
                                    for crumb[i] in FileBrowserState.crumbs: HorizontalLayout {
                                        spacing: 0px;
                                        if i > 0: Image {
                                            width: 12px;
                                            height: 12px;
                                            y: (parent.height - self.height) / 2;
                                            source: @image-url("../icons/regular-gray/caret-right.svg");
                                            colorize: Theme.text-faint;
                                        }
                                        Rectangle {
                                            border-radius: Theme.radius-sm;
                                            background: crumb-ta.has-hover ? Theme.hover : transparent;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: crumb.name;
                                                    font-size: 12.5px;
                                                    font-weight: i == FileBrowserState.crumbs.length - 1 ? 600 : 400;
                                                    color: i == FileBrowserState.crumbs.length - 1 ? Theme.text : Theme.text-dim;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            crumb-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { FileBrowserState.navigate(crumb.path); }
                                            }
                                        }
                                    }
                                }
                            }
                            if crumb-box.editing: TextField {
                                width: parent.width - 34px;
                                x: 0px;
                                mono: true;
                                autofocus: true;
                                value: FileBrowserState.current-path;
                                accepted(text) => {
                                    crumb-box.editing = false;
                                    FileBrowserState.path-entered(text);
                                    keys.focus();
                                }
                            }
                            IconButton {
                                x: parent.width - self.width - 1px;
                                y: 1px;
                                width: 30px;
                                height: 30px;
                                icon: crumb-box.editing
                                    ? @image-url("../icons/regular-gray/x.svg")
                                    : @image-url("../icons/regular-gray/pencil-simple.svg");
                                clicked => {
                                    crumb-box.editing = !crumb-box.editing;
                                    if (!crumb-box.editing) { keys.focus(); }
                                }
                            }
                        }

                        TextField {
                            width: 190px;
                            height: 32px;
                            has-icon: true;
                            icon: @image-url("../icons/regular-gray/magnifying-glass.svg");
                            placeholder: "Filter this folder";
                            value: FileBrowserState.search;
                            edited(text) => { FileBrowserState.search-edited(text); }
                        }
                        IconButton {
                            icon: FileBrowserState.show-hidden
                                ? @image-url("../icons/regular-gray/eye.svg")
                                : @image-url("../icons/regular-gray/eye-slash.svg");
                            active: FileBrowserState.show-hidden;
                            clicked => { FileBrowserState.hidden-toggled(!FileBrowserState.show-hidden); }
                        }
                    }

                    // File list
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: Theme.border-soft;
                        background: Theme.panel;
                        clip: true;

                        VerticalLayout {
                            spacing: 0px;
                            // Column header
                            Rectangle {
                                height: 30px;
                                background: Theme.raised;
                                HorizontalLayout {
                                    padding-left: 42px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    Text { horizontal-stretch: 1; text: "Name"; font-size: 11px; font-weight: 600; color: Theme.text-mute; vertical-alignment: center; }
                                    Text { width: 90px; text: "Size"; font-size: 11px; font-weight: 600; color: Theme.text-mute; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { width: 140px; text: "Modified"; font-size: 11px; font-weight: 600; color: Theme.text-mute; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }

                            list := ScrollView {
                                vertical-stretch: 1;
                                content-height: FileBrowserState.entries.length * root.row-pitch + 8px;
                                property <int> first: max(0, floor(-self.content-y / root.row-pitch) - 5);

                                for i in root.window-size: row := Rectangle {
                                    property <int> index: list.first + i;
                                    x: 4px;
                                    y: 4px + self.index * root.row-pitch;
                                    width: list.visible-width - 8px;
                                    height: root.row-height;
                                    if row.index < FileBrowserState.entries.length: EntryRow {
                                        width: row.width;
                                        height: row.height;
                                        entry: FileBrowserState.entries[row.index];
                                        selected: row.index == FileBrowserState.selected;
                                        zebra: Math.mod(row.index, 2) == 1;
                                        clicked => {
                                            FileBrowserState.select(row.index);
                                            keys.focus();
                                        }
                                        double-clicked => { FileBrowserState.activate(row.index); }
                                    }
                                }
                            }
                        }

                        // Empty / loading / error states
                        if FileBrowserState.entries.length == 0: VerticalLayout {
                            y: 30px;
                            height: parent.height - 30px;
                            alignment: center;
                            spacing: 8px;
                            Image {
                                height: 34px;
                                source: FileBrowserState.error != ""
                                    ? @image-url("../icons/regular-gray/warning-circle.svg")
                                    : @image-url("../icons/regular-gray/folder-open.svg");
                                colorize: FileBrowserState.error != "" ? Theme.err : Theme.text-faint;
                            }
                            Text {
                                text: FileBrowserState.loading ? "Loading…"
                                    : FileBrowserState.error != "" ? FileBrowserState.error
                                    : FileBrowserState.search != "" ? "Nothing matches “" + FileBrowserState.search + "”"
                                    : "This folder is empty";
                                font-size: 13px;
                                color: FileBrowserState.error != "" ? Theme.err : Theme.text-mute;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        if FileBrowserState.loading && FileBrowserState.entries.length > 0: Rectangle {
                            y: 30px;
                            height: 2px;
                            background: Theme.accent;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border-soft; }

            // ---- Footer -------------------------------------------------
            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 14px;
                padding-bottom: 16px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;
                    if FileBrowserState.mode == FileBrowserMode.save-file: name-field := TextField {
                        horizontal-stretch: 1;
                        placeholder: "File name";
                        value: FileBrowserState.file-name;
                        edited(text) => { FileBrowserState.file-name-edited(text); }
                        accepted(text) => {
                            FileBrowserState.file-name-edited(text);
                            if (FileBrowserState.can-accept) { FileBrowserState.accept(); }
                        }
                    }
                    if FileBrowserState.mode != FileBrowserMode.save-file: Text {
                        horizontal-stretch: 1;
                        text: FileBrowserState.status;
                        font-size: 12px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if FileBrowserState.filter-names.length > 1: DropdownField {
                        field-width: 230px;
                        value: FileBrowserState.filter-name;
                        options: FileBrowserState.filter-names;
                        option-selected(name) => { FileBrowserState.filter-selected(name); }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;

                    // New folder (inline)
                    new-folder := HorizontalLayout {
                        spacing: 6px;
                        property <bool> naming: false;
                        if !new-folder.naming: AppButton {
                            text: "New folder";
                            clicked => { new-folder.naming = true; }
                        }
                        if new-folder.naming: TextField {
                            width: 200px;
                            height: 36px;
                            placeholder: "Folder name";
                            autofocus: true;
                            accepted(text) => {
                                new-folder.naming = false;
                                FileBrowserState.create-folder(text);
                                keys.focus();
                            }
                        }
                        if new-folder.naming: IconButton {
                            y: 3px;
                            icon: @image-url("../icons/regular-gray/x.svg");
                            clicked => { new-folder.naming = false; keys.focus(); }
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: FileBrowserState.error != "" && FileBrowserState.entries.length > 0 ? FileBrowserState.error : "";
                        font-size: 12px;
                        color: Theme.err;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        overflow: elide;
                    }

                    AppButton {
                        text: "Cancel";
                        clicked => { FileBrowserState.cancel(); }
                    }
                    AppButton {
                        text: FileBrowserState.accept-label;
                        primary: true;
                        enabled: FileBrowserState.can-accept;
                        clicked => { FileBrowserState.accept(); }
                    }
                }
            }
        }

        // ---- Overwrite confirmation -------------------------------------
        if FileBrowserState.overwrite-name != "": Rectangle {
            background: Theme.modal-dim;
            TouchArea { }
            Rectangle {
                width: 420px;
                height: 176px;
                background: Theme.panel;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 24px;
                drop-shadow-color: Theme.shadow;
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        Image {
                            width: 20px;
                            height: 20px;
                            source: @image-url("../icons/regular-gray/warning-circle.svg");
                            colorize: Theme.warn;
                        }
                        Text {
                            text: "Replace existing file?";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-bright;
                        }
                    }
                    Text {
                        text: "“" + FileBrowserState.overwrite-name + "” already exists in this folder. Replacing it overwrites its contents.";
                        font-size: 13px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;
                        AppButton {
                            text: "Cancel";
                            clicked => { FileBrowserState.overwrite-answered(false); keys.focus(); }
                        }
                        AppButton {
                            text: "Replace";
                            danger: true;
                            clicked => { FileBrowserState.overwrite-answered(true); }
                        }
                    }
                }
            }
        }
    }
}
