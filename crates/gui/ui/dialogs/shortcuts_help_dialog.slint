import { InkButton, InkButtonKind, InkCaption, InkDialog, InkDialogFooter, InkKbd } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { ShortcutsDoc } from "../api/shortcuts.slint";
import { ScrollView } from "std-widgets.slint";

import { Ink } from "../ink/palette.slint";

component ShortcutRow inherits HorizontalLayout {
    in property <string> combo;
    in property <string> label;

    height: 28px;
    spacing: 12px;
    Text {
        horizontal-stretch: 1;
        text: root.label;
        font-size: Ink.fs-body;
        color: Ink.text;
        vertical-alignment: center;
        overflow: elide;
    }

    VerticalLayout {
        alignment: center;
        InkKbd {
            text: root.combo;
        }
    }
}

export component ShortcutsHelpDialog inherits InkDialog {
    title: "Keyboard shortcuts";
    card-width: 460px;
    // The list scrolls inside a fixed-height card.
    card-height: 560px;
    // A pure reference view with nothing to confirm/discard: a click
    // outside closes it too.
    close-on-backdrop: true;
    close => {
        GlobalAppState.active_dialog = DialogType.none;
    }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            // Room for the scroll bar.
            padding-right: 12px;
            spacing: 16px;

            for section in ShortcutsDoc.sections: VerticalLayout {
                spacing: 0px;

                InkCaption {
                    height: 22px;
                    text: section.title.to-uppercase();
                }

                for row in section.rows: ShortcutRow {
                    combo: row.combo;
                    label: row.label;
                }
            }
        }
    }

    InkDialogFooter {
        InkButton {
            kind: InkButtonKind.primary;
            text: "Close";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
            }
        }
    }
}
