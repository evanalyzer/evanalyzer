import { ScrollView } from "std-widgets.slint";
import { Dialog, DialogFooter } from "../components/new_components/dialog.slint";
import { GlobalAppState, DialogType } from "../state.slint";
import { Theme } from "../style.slint";
import { AppButton } from "../components/app_button.slint";
import { ShortcutsDoc } from "../shortcuts.slint";

component ShortcutRow inherits Rectangle {
    in property <string> combo;
    in property <string> label;

    height: 30px;

    HorizontalLayout {
        alignment: space-between;
        padding-right: 4px;

        Text {
            text: root.label;
            font-size: 12.5px;
            color: Theme.text;
            vertical-alignment: center;
        }

        Rectangle {
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.border-soft;
            border-radius: 5px;
            width: combo-text.preferred-width + 16px;

            combo-text := Text {
                text: root.combo;
                font-size: 11px;
                font-family: Theme.font-mono;
                color: Theme.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component ShortcutsHelpDialog inherits Dialog {
    title: "Keyboard Shortcuts";
    dialog-width: 460px;
    // The list scrolls inside a fixed-height card.
    dialog-height: 560px;
    // A pure reference view with nothing to confirm/discard: a click
    // outside closes it too.
    close-on-backdrop: true;
    close => {
        GlobalAppState.active_dialog = DialogType.none;
    }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 18px;

            for section in ShortcutsDoc.sections: VerticalLayout {
                spacing: 2px;

                Text {
                    text: section.title;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-mute;
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-soft;
                }

                for row in section.rows: ShortcutRow {
                    combo: row.combo;
                    label: row.label;
                }
            }
        }
    }

    DialogFooter {
        AppButton {
            text: "Close";
            primary: true;
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
            }
        }
    }
}
