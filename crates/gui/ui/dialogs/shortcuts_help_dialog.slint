import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { ShortcutsDoc } from "../api/shortcuts.slint";
import { ScrollView } from "std-widgets.slint";

import { Ink } from "../ink/palette.slint";

component ShortcutRow inherits Rectangle {
    in property <string> combo;
    in property <string> label;

    height: 30px;

    HorizontalLayout {
        alignment: space-between;
        padding-right: 4px;

        Text {
            text: root.label;
            font-size: 12.5px;
            color: Ink.text;
            vertical-alignment: center;
        }

        Rectangle {
            background: Ink.raised;
            border-width: 1px;
            border-color: Ink.border-soft;
            border-radius: 5px;
            width: combo-text.preferred-width + 16px;

            combo-text := Text {
                text: root.combo;
                font-size: 11px;
                font-family: Ink.font-mono;
                color: Ink.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component ShortcutsHelpDialog inherits InkDialog {
    title: "Keyboard Shortcuts";
    card-width: 460px;
    // The list scrolls inside a fixed-height card.
    card-height: 560px;
    // A pure reference view with nothing to confirm/discard: a click
    // outside closes it too.
    close-on-backdrop: true;
    close => {
        GlobalAppState.active_dialog = DialogType.none;
    }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 18px;

            for section in ShortcutsDoc.sections: VerticalLayout {
                spacing: 2px;

                Text {
                    text: section.title;
                    font-size: 11px;
                    font-weight: 700;
                    color: Ink.text-mute;
                }

                Rectangle {
                    height: 1px;
                    background: Ink.border-soft;
                }

                for row in section.rows: ShortcutRow {
                    combo: row.combo;
                    label: row.label;
                }
            }
        }
    }

    InkDialogFooter {
        InkButton {
            kind: InkButtonKind.primary;
            text: "Close";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
            }
        }
    }
}
