import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { AnalysisRunningCloseState, DialogType, GlobalAppState } from "../api/state.slint";

import { Ink } from "../ink/palette.slint";

// Asked when the window is closed while an analysis runs.
export component AnalysisRunningCloseDialog inherits InkDialog {
    title: "Analysis running";
    card-width: 480px;
    close => {
        GlobalAppState.active-dialog = DialogType.none;
        AnalysisRunningCloseState.back();
    }

    VerticalLayout {
        spacing: 12px;
        Text {
            text: AnalysisRunningCloseState.remote
                ? (AnalysisRunningCloseState.disconnecting
                    ? "An analysis is running on the server. It can keep running after you disconnect - EVAnalyzer shows it again the next time you connect."
                    : "An analysis is running on the server. It can keep running without this window - EVAnalyzer shows it again the next time you connect.")
                : "An analysis is running on this computer. Closing EVAnalyzer stops it.";
            wrap: word-wrap;
            color: Ink.text;
            font-size: 13px;
        }

        InkDialogFooter {

            InkButton {
                text: "Back";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    AnalysisRunningCloseState.back();
                }
            }

            InkButton {
                kind: InkButtonKind.danger;
                text: AnalysisRunningCloseState.remote ? "Cancel analysis" : "Stop analysis and close";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    AnalysisRunningCloseState.cancel_analysis();
                }
            }

            if AnalysisRunningCloseState.remote: InkButton {
                text: AnalysisRunningCloseState.disconnecting ? "Keep running and disconnect" : "Keep running on server";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    AnalysisRunningCloseState.keep_running();
                }
            }
        }
    }
}
