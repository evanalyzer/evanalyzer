import { Places } from "../api/layout.slint";
import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { ClassificationState } from "../api/classification.slint";

import { Ink } from "../ink/palette.slint";

export component ConfirmAutoAddClassesDialog inherits InkDialog {
    // Left of the right-hand panels.
    from-right: true;
    anchor-x: Places.beside-right;
    anchor-y: 96px;
    title: "Auto add classes";
    card-width: 380px;
    close => {
        GlobalAppState.active-dialog = DialogType.none;
    }

    VerticalLayout {
        spacing: 12px;

        Text {
            text: "New classes will be added based on image metadata. Would you like to replace your current list with these new definitions, or merge them into your existing?";
            wrap: word-wrap;
            color: Ink.text;
            font-size: Ink.fs-heading;
        }

        Text {
            text: "Merge automatically added classes or replace existing?";
            wrap: word-wrap;
            color: Ink.text-dim;
            font-size: Ink.fs-body;
        }
    }

    InkDialogFooter {
        InkButton {
            text: "Cancel";
            clicked => {
                GlobalAppState.active-dialog = DialogType.none;
            }
        }

        InkButton {
            text: "Replace";
            clicked => {
                ClassificationState.class_auto_add_and_replace();
                GlobalAppState.active-dialog = DialogType.none;
            }
        }

        InkButton {
            kind: InkButtonKind.primary;
            text: "Merge";
            clicked => {
                ClassificationState.class_auto_add_and_merge();
                GlobalAppState.active-dialog = DialogType.none;
            }
        }
    }
}
