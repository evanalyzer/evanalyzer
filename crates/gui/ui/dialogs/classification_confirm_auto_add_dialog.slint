import { DialogType, GlobalAppState } from "../api/state.slint";
import { ClassificationState } from "../api/classification.slint";

import { Dialog, DialogFooter, DialogTone } from "../components/new_components/dialog.slint";
import { AppButton } from "../components/app_button.slint";
import { Theme } from "../style.slint";

export component ConfirmAutoAddClassesDialog inherits Dialog {
    title: "Auto add classes";
    tone: DialogTone.info;
    dialog-width: 500px;
    close => {
        GlobalAppState.active-dialog = DialogType.none;
    }

    VerticalLayout {
        spacing: 12px;

        Text {
            text: "New classes will be added based on image metadata. Would you like to replace your current list with these new definitions, or merge them into your existing?";
            wrap: word-wrap;
            color: Theme.text;
            font-size: 13px;
        }

        Text {
            text: "Merge automatically added classes or replace existing?";
            wrap: word-wrap;
            color: Theme.text-dim;
            font-size: 12px;
        }
    }

    DialogFooter {
        AppButton {
            text: "Cancel";
            clicked => {
                GlobalAppState.active-dialog = DialogType.none;
            }
        }

        AppButton {
            text: "Replace";
            clicked => {
                ClassificationState.class_auto_add_and_replace();
                GlobalAppState.active-dialog = DialogType.none;
            }
        }

        AppButton {
            text: "Merge";
            primary: true;
            clicked => {
                ClassificationState.class_auto_add_and_merge();
                GlobalAppState.active-dialog = DialogType.none;
            }
        }
    }
}
