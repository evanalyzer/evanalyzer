import { InkButton, InkButtonKind, InkDialog, InkDialogFooter, InkDialogPlacement } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { TemplateMetaState } from "../api/template_meta.slint";
import { TextEdit } from "std-widgets.slint";
import { LineEdit } from "../ink/std_compat.slint";

import { Ink } from "../ink/palette.slint";
export component TemplateMetaDialog inherits InkDialog {
    // Docked on the right; the image stays usable.
    placement: InkDialogPlacement.sheet;
    title: TemplateMetaState.dialog_title;
    card-width: 460px;
    close-on-backdrop: true;
    close => {
        TemplateMetaState.cancel();
    }

    // Empty, or a whole number from 1.
    property <bool> version-valid: TemplateMetaState.meta.version == "" || (TemplateMetaState.meta.version.is-float() && TemplateMetaState.meta.version.to-float() >= 1 && Math.floor(TemplateMetaState.meta.version.to-float()) == TemplateMetaState.meta.version.to-float());

    VerticalLayout {
        spacing: 5px;
        Text {
            text: "Name";
            font-size: 11px;
            color: Ink.text-dim;
        }

        LineEdit {
            height: 30px;
            text <=> TemplateMetaState.meta.name;
            placeholder-text: "e.g. Cell counting pipeline";
        }
    }

    VerticalLayout {
        spacing: 5px;
        Text {
            text: "Short description";
            font-size: 11px;
            color: Ink.text-dim;
        }

        LineEdit {
            height: 30px;
            text <=> TemplateMetaState.meta.short_description;
            placeholder-text: "One line summary";
        }
    }

    VerticalLayout {
        spacing: 5px;
        Text {
            text: "Description";
            font-size: 11px;
            color: Ink.text-dim;
        }

        TextEdit {
            height: 80px;
            text <=> TemplateMetaState.meta.description;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            spacing: 5px;
            Text {
                text: "Author";
                font-size: 11px;
                color: Ink.text-dim;
            }

            LineEdit {
                height: 30px;
                text <=> TemplateMetaState.meta.author_name;
                placeholder-text: "Charles Darwin";
            }
        }

        VerticalLayout {
            spacing: 5px;
            Text {
                text: "Organization";
                font-size: 11px;
                color: Ink.text-dim;
            }

            LineEdit {
                height: 30px;
                text <=> TemplateMetaState.meta.author_organization;
                placeholder-text: "University / Company";
            }
        }
    }

    VerticalLayout {
        spacing: 5px;
        Text {
            text: "Category";
            font-size: 11px;
            color: Ink.text-dim;
        }

        LineEdit {
            height: 30px;
            text <=> TemplateMetaState.meta.category;
            placeholder-text: "e.g. Cell Biology / Uptake";
        }

        if TemplateMetaState.known-categories.length > 0: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for c in TemplateMetaState.known-categories: Rectangle {
                height: 20px;
                border-radius: 10px;
                border-width: 1px;
                border-color: Ink.border-soft;
                background: cat-ta.has-hover ? Ink.raised : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: c;
                        font-size: 10px;
                        color: Ink.text-dim;
                        vertical-alignment: center;
                    }
                }

                cat-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        TemplateMetaState.meta.category = c;
                    }
                }
            }
        }
    }

    VerticalLayout {
        spacing: 5px;
        Text {
            text: "Version (optional)";
            font-size: 11px;
            color: Ink.text-dim;
        }

        LineEdit {
            height: 30px;
            input-type: InputType.number;
            text <=> TemplateMetaState.meta.version;
            placeholder-text: "e.g. 1 - count up when you change the template";
        }

        if !root.version-valid: Text {
            text: "A whole number from 1, or leave it empty.";
            font-size: 11px;
            color: Ink.err;
        }
    }

    VerticalLayout {
        spacing: 5px;
        Text {
            text: "Tags";
            font-size: 11px;
            color: Ink.text-dim;
        }

        LineEdit {
            height: 30px;
            text <=> TemplateMetaState.meta.tags;
            placeholder-text: "Comma separated, e.g. colocalization, uptake-assay";
        }
    }

    InkDialogFooter {
        InkButton {
            text: "Cancel";
            clicked => {
                TemplateMetaState.cancel();
            }
        }

        InkButton {
            kind: InkButtonKind.primary;
            text: "Next…";
            enabled: TemplateMetaState.meta.name != "" && TemplateMetaState.meta.category != "" && TemplateMetaState.meta.tags != "" && root.version-valid;
            clicked => {
                TemplateMetaState.confirm();
            }
        }
    }
}
