import { Places } from "../api/layout.slint";
import { InkTextField, InkButton, InkButtonKind, InkBanner, InkCaption, InkChip, InkDialog, InkDialogFooter, InkHint, InkIconButton, InkIcons, InkLabel, InkTone, InkDialogPlacement, InkDivider } from "../ink/ink.slint";
import { ModuleParamRow, ModuleSettingsState, ModuleUpdateState, CreateModuleState, ExposeChoiceState, InPlaceCopyState } from "../api/create_module.slint";
import { ScrollView, TextEdit } from "std-widgets.slint";
import { LineEdit, ComboBox } from "../ink/std_compat.slint";
import { InkSettingsHead, InkSettingsCard, InkSettingRow, InkSettingBlock, InkTab } from "../ink/ink.slint";
import { Ink } from "../ink/palette.slint";

// "Create module": turns consecutive steps of a pipeline into a module.
// The host fills the class list with suggested roles (see
// `evanalyzer_app::modules::plan_module`) and recomputes it when the range
// changes.

// -- Global state --------------------------------------------
component RangeRow inherits HorizontalLayout {
    in property <string> label;
    in property <[string]> model;
    in property <int> current;
    callback picked(int);

    spacing: 8px;
    InkLabel {
        text: root.label;
    }

    ComboBox {
        horizontal-stretch: 1;
        model: root.model;
        current-index: root.current;
        selected(v) => {
            root.picked(self.current-index);
        }
    }
}

// -- Dialog component -----------------------------------------

export component CreateModuleDialog inherits InkDialog {
    // Next to the steps panel.
    anchor-x: Places.beside-left;
    title: "Create module";
    card-width: 480px;
    close-on-backdrop: true;
    close => {
        CreateModuleState.cancel();
    }

    InkHint {
        text: "The steps become one step - a module you can use like a command, in this and other pipelines.";
    }

    HorizontalLayout {
        spacing: 8px;
        InkLabel {
            text: "Name";
        }

        LineEdit {
            horizontal-stretch: 1;
            text: CreateModuleState.name;
            placeholder-text: "e.g. Cell reconstruction";
            edited(t) => {
                CreateModuleState.name = t;
            }
        }
    }

    VerticalLayout {
        spacing: 6px;
        RangeRow {
            label: "From";
            model: CreateModuleState.step-names;
            current: CreateModuleState.from-step;
            picked(i) => {
                CreateModuleState.range-changed(i, CreateModuleState.to-step);
            }
        }

        RangeRow {
            label: "To";
            model: CreateModuleState.step-names;
            current: CreateModuleState.to-step;
            picked(i) => {
                CreateModuleState.range-changed(CreateModuleState.from-step, i);
            }
        }
    }

    if CreateModuleState.classes.length > 0: VerticalLayout {
        spacing: 6px;
        Text {
            text: "Classes";
            font-size: Ink.fs-secondary;
            color: Ink.text-dim;
        }

        for row[i] in CreateModuleState.classes: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: row.name;
                    font-size: Ink.fs-body;
                    color: Ink.text;
                }

                Text {
                    text: row.detail;
                    font-size: Ink.fs-caption;
                    color: Ink.text-mute;
                }
            }

            ComboBox {
                width: 190px;
                model: ["Internal (module only)", "Module parameter", "Fixed"];
                current-index: row.role;
                selected(v) => {
                    CreateModuleState.role-changed(i, self.current-index);
                }
            }
        }

        Text {
            text: "Internal classes are the module's own: each use of the module has its own, and their objects don't reach the results.";
            font-size: Ink.fs-secondary;
            color: Ink.text-dim;
            wrap: word-wrap;
        }
    }

    if CreateModuleState.channels-text != "": Text {
        text: CreateModuleState.channels-text;
        font-size: Ink.fs-body;
        color: Ink.text-dim;
        wrap: word-wrap;
    }

    if CreateModuleState.error != "": Text {
        text: CreateModuleState.error;
        font-size: Ink.fs-body;
        color: Ink.err;
        wrap: word-wrap;
    }

    InkDialogFooter {
        InkButton {
            text: "Cancel";
            clicked => {
                CreateModuleState.cancel();
            }
        }

        InkButton {
            kind: InkButtonKind.primary;
            text: "Create module";
            clicked => {
                CreateModuleState.confirm();
            }
        }
    }
}

// -- "Edit in place": the copy's name ---------------------------
// Shown only when a copy is made - other steps use the module; the only
// use is edited without asking.
export component InPlaceCopyDialog inherits InkDialog {
    // Next to the steps panel.
    anchor-x: Places.beside-left;
    title: "Edit in place";
    card-width: 420px;
    close-on-backdrop: true;
    close => {
        InPlaceCopyState.cancel();
    }

    Text {
        text: "A copy of “\{InPlaceCopyState.module-name}” just for this step, with its values. "
            + (InPlaceCopyState.other-uses == 1 ? "The other step using it stays unchanged."
                : "The \{InPlaceCopyState.other-uses} other steps using it stay unchanged.")
            + (InPlaceCopyState.from-library ? " The copy doesn't get library updates." : "");
        font-size: Ink.fs-body;
        color: Ink.text;
        wrap: word-wrap;
    }

    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            InkLabel {
                text: "Name";
            }

            InkTextField {
                horizontal-stretch: 1;
                label: "Name of the copy";
                value: InPlaceCopyState.name;
                autofocus: true;
                // Typed over at once.
                init => {
                    self.select-all();
                }
                edited(t) => {
                    InPlaceCopyState.name = t;
                    InPlaceCopyState.name-edited(t);
                }
                accepted(t) => {
                    if InPlaceCopyState.error == "" {
                        InPlaceCopyState.confirm();
                    }
                }
            }
        }

        if InPlaceCopyState.error != "": Text {
            text: InPlaceCopyState.error;
            font-size: Ink.fs-secondary;
            color: Ink.err;
            wrap: word-wrap;
        }
    }

    InkDialogFooter {
        InkButton {
            text: "Cancel";
            clicked => {
                InPlaceCopyState.cancel();
            }
        }

        InkButton {
            kind: InkButtonKind.primary;
            text: "Create copy and edit";
            enabled: InPlaceCopyState.error == "";
            disabled-reason: InPlaceCopyState.error;
            clicked => {
                InPlaceCopyState.confirm();
            }
        }
    }
}

// -- Expose a setting: a new parameter, or one that exists -------
export component ExposeChoiceDialog inherits InkDialog {
    // Next to the steps panel.
    anchor-x: Places.beside-left;
    title: "Expose \{ExposeChoiceState.setting-name}";
    card-width: 460px;
    close-on-backdrop: true;
    close => {
        ExposeChoiceState.cancel();
    }

    InkHint {
        text: "As a parameter of its own, or set by a parameter the module has already:";
    }

    VerticalLayout {
        spacing: 10px;

        if ExposeChoiceState.choices.length > 0: InkButton {
            kind: InkButtonKind.primary;
            text: ExposeChoiceState.choices[0];
            clicked => {
                ExposeChoiceState.chosen(0);
            }
        }

        // An existing parameter: its name, and below what it sets already -
        // parameters of equal steps are often named alike.
        for choice[i] in ExposeChoiceState.choices: Rectangle {
            visible: i > 0;
            height: i > 0 ? self.preferred-height : 0px;
            border-radius: 8px;
            border-width: 1px;
            border-color: choice-ta.has-hover ? Ink.focus : Ink.border;
            background: choice-ta.has-hover ? Ink.raised : Ink.ground;
            accessible-role: button;
            accessible-label: choice;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 2px;
                Text {
                    text: choice;
                    font-size: Ink.fs-body;
                    font-weight: 600;
                    color: Ink.text;
                    overflow: elide;
                }

                if ExposeChoiceState.details[i] != "": Text {
                    text: ExposeChoiceState.details[i];
                    font-size: Ink.fs-secondary;
                    color: Ink.text-dim;
                    overflow: elide;
                }
            }

            choice-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    ExposeChoiceState.chosen(i);
                }
            }
        }
    }

    InkDialogFooter {
        InkButton {
            text: "Cancel";
            clicked => {
                ExposeChoiceState.cancel();
            }
        }
    }
}

// -- Update a module from the library -------------------------------
export component ModuleUpdateDialog inherits InkDialog {
    // Next to the steps panel.
    anchor-x: Places.beside-left;
    title: "Update \{ModuleUpdateState.module-name}";
    card-width: 420px;
    close-on-backdrop: true;
    close => {
        ModuleUpdateState.cancel();
    }

    Text {
        text: "The module library has a newer version (\{ModuleUpdateState.versions}). Every step using the module gets it; their values stay.";
        font-size: Ink.fs-body;
        color: Ink.text;
        wrap: word-wrap;
    }

    if ModuleUpdateState.changed-here: InkBanner {
        tone: InkTone.warn;
        text: "This project changed the module since it was inserted - updating replaces those changes.";
    }

    InkDialogFooter {
        InkButton {
            text: "Cancel";
            clicked => {
                ModuleUpdateState.cancel();
            }
        }

        InkButton {
            kind: InkButtonKind.primary;
            text: "Update";
            clicked => {
                ModuleUpdateState.confirm();
            }
        }
    }
}

// -- Module settings (design P) ----------------------------------------
// A parameter in the list: its name and default.
component ParamListRow inherits Rectangle {
    in property <ModuleParamRow> param;
    in property <bool> selected;
    callback clicked;

    height: 28px;
    background: root.selected ? Ink.selection : ta.has-hover ? Ink.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.param.label;
    accessible-item-selected: root.selected;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.param.label;
            font-size: Ink.fs-secondary;
            font-weight: root.selected ? 600 : 400;
            color: Ink.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            max-width: 90px;
            text: root.param.default-value;
            font-size: Ink.fs-caption;
            font-family: Ink.font-mono;
            color: Ink.text-mute;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A label of the parameter's form.
// A form row's label - plain (InkLabel's elide costs ~2 KB a use).
component FormLabel inherits Text {
    width: 72px;
    font-size: Ink.fs-secondary;
    color: Ink.text-dim;
    vertical-alignment: center;
}

// The module's name and descriptions (General) and its parameters - a
// list by section, the chosen one's form beside it. Cancel undoes all
// changes made while it's open (✕ and Esc too), Apply keeps them.
export component ModuleSettingsDialog inherits InkDialog {
    // Next to the steps panel.
    anchor-x: Places.beside-left;
    placement: InkDialogPlacement.sheet;
    title: ModuleSettingsState.name;
    subtitle: "◆ module settings";
    card-width: 700px;
    content-padding: 0px;
    close => {
        ModuleSettingsState.parameter-edit-cancelled();
        ModuleSettingsState.close();
    }

    // 0 General, 1 Parameters.
    property <int> current-section: 0;
    // The parameter shown in the form.
    property <int> chosen: 0;
    property <ModuleParamRow> param: ModuleSettingsState.parameters[min(root.chosen, ModuleSettingsState.parameters.length - 1)];
    property <bool> has-param: ModuleSettingsState.parameters.length > 0;

    init => {
        // What Cancel goes back to.
        ModuleSettingsState.parameter-edit-started("");
        // ✎ on an exposed setting: its parameter.
        if ModuleSettingsState.focus-index >= 0 {
            root.current-section = 1;
            root.chosen = ModuleSettingsState.focus-index;
        }
    }

    // -- Tabs, in the head (left of ✕) --
    Rectangle {
        height: 0px;
        HorizontalLayout {
            x: parent.width - self.width - 48px;
            y: (Ink.head-h - 30px) / 2 - Ink.head-h;
            width: self.preferred-width;
            height: 30px;
            spacing: 14px;
            InkTab {
                text: "General";
                active: root.current-section == 0;
                clicked => {
                    root.current-section = 0;
                }
            }
            InkTab {
                text: "Parameters";
                note: "· \{ModuleSettingsState.parameters.length}";
                active: root.current-section == 1;
                clicked => {
                    root.current-section = 1;
                }
            }
        }
    }

    // -- General --
    if root.current-section == 0: ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            padding: Ink.pad-dialog;
            spacing: 14px;

            InkHint {
                text: "What the module is called and does - shown in the command picker and behind the module card's ?.";
            }

            InkSettingsCard {
                InkSettingRow {
                    label: "Name";
                    LineEdit {
                        text: ModuleSettingsState.name;
                        placeholder-text: "Module name";
                        edited(t) => {
                            ModuleSettingsState.name-edited(t);
                        }
                    }
                }

                InkSettingRow {
                    label: "Short description";
                    description: "One line, shown in the command picker.";
                    LineEdit {
                        text: ModuleSettingsState.description;
                        placeholder-text: "What the module does";
                        edited(t) => {
                            ModuleSettingsState.description-edited(t);
                        }
                    }
                }

                InkSettingRow {
                    label: "Author";
                    author-name-edit := LineEdit {
                        text: ModuleSettingsState.author-name;
                        placeholder-text: "Full name";
                        edited(t) => {
                            ModuleSettingsState.author-edited(t, author-organization-edit.text);
                        }
                    }
                }

                InkSettingRow {
                    label: "Organization";
                    author-organization-edit := LineEdit {
                        text: ModuleSettingsState.author-organization;
                        placeholder-text: "Lab, institute, company";
                        edited(t) => {
                            ModuleSettingsState.author-edited(author-name-edit.text, t);
                        }
                    }
                }

                InkSettingBlock {
                    label: "Description";
                    description: "How to use it, what it expects, references - shown behind the module card's ?.";
                    TextEdit {
                        height: 96px;
                        text: ModuleSettingsState.long-description;
                        wrap: word-wrap;
                        placeholder-text: "How to use it, what it expects, references…";
                        edited(t) => {
                            ModuleSettingsState.long-description-edited(t);
                        }
                    }
                }
            }
        }
    }

    // -- Parameters: the list, the chosen one's form --
    if root.current-section == 1: HorizontalLayout {
        vertical-stretch: 1;
        spacing: 0px;

        // The list, by section.
        Rectangle {
            width: 250px;
            ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    for p[pi] in ModuleSettingsState.parameters: VerticalLayout {
                        if p.section != "" && (pi == 0 || ModuleSettingsState.parameters[pi - 1].section != p.section): HorizontalLayout {
                            padding-left: 14px;
                            InkCaption {
                                text: p.section;
                                height: 26px;
                                vertical-alignment: bottom;
                            }
                        }
                        ParamListRow {
                            param: p;
                            selected: pi == root.chosen;
                            clicked => {
                                root.chosen = pi;
                            }
                        }
                    }
                    if !root.has-param: HorizontalLayout {
                        padding: 14px;
                        InkHint {
                            text: "None yet - ◇ next to a setting of the opened module makes it a parameter.";
                        }
                    }
                }
            }
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Ink.border-soft;
            }
        }

        // The chosen one.
        if root.has-param: ScrollView {
            horizontal-stretch: 1;
            content-width: self.visible-width;
            VerticalLayout {
                width: parent.width;
                alignment: start;
                padding: 14px;
                padding-left: 16px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 2px;
                    InkCaption {
                        horizontal-stretch: 1;
                        text: root.param.section == "" ? root.param.label : root.param.section + " · " + root.param.label;
                        vertical-alignment: center;
                    }
                    InkIconButton {
                        icon: InkIcons.caret-up;
                        size: 24px;
                        label: "Move up";
                        enabled: root.chosen > 0;
                        disabled-reason: "Already the first";
                        clicked => {
                            ModuleSettingsState.parameter-moved(root.param.key, -1);
                            root.chosen -= 1;
                        }
                    }
                    InkIconButton {
                        icon: InkIcons.caret-down;
                        size: 24px;
                        label: "Move down";
                        enabled: root.chosen < ModuleSettingsState.parameters.length - 1;
                        disabled-reason: "Already the last";
                        clicked => {
                            ModuleSettingsState.parameter-moved(root.param.key, 1);
                            root.chosen += 1;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    FormLabel {
                        text: "Name";
                    }
                    LineEdit {
                        text: root.param.label;
                        placeholder-text: "Name on the module card";
                        accessible-label: "Parameter name";
                        edited(t) => {
                            ModuleSettingsState.parameter-name-edited(root.param.key, t);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    FormLabel {
                        text: "Section";
                    }
                    LineEdit {
                        text: root.param.section;
                        placeholder-text: "e.g. Detection (optional)";
                        accessible-label: "Parameter section";
                        edited(t) => {
                            ModuleSettingsState.parameter-section-edited(root.param.key, t);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    FormLabel {
                        vertical-alignment: top;
                        text: "Help";
                    }
                    VerticalLayout {
                        spacing: 4px;
                        TextEdit {
                            height: 56px;
                            text: root.param.description;
                            wrap: word-wrap;
                            placeholder-text: root.param.default-description != "" ? root.param.default-description : "Shown as ? next to the parameter";
                            accessible-label: "Parameter help text";
                            edited(t) => {
                                ModuleSettingsState.parameter-help-edited(root.param.key, t);
                            }
                        }
                        if root.param.description != "" && root.param.default-description != "": HorizontalLayout {
                            alignment: start;
                            InkButton {
                                small: true;
                                kind: InkButtonKind.quiet;
                                text: "Use the setting's own help";
                                clicked => {
                                    ModuleSettingsState.parameter-help-reset(root.param.key);
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    height: 26px;
                    spacing: 10px;
                    FormLabel {
                        text: "Default";
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.param.default-value == "" ? "–" : root.param.default-value;
                        font-size: Ink.fs-secondary;
                        font-family: Ink.font-mono;
                        color: Ink.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    FormLabel {
                        vertical-alignment: top;
                        height: 24px;
                        text: "Sets";
                    }
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        for binding in root.param.bindings: HorizontalLayout {
                            alignment: start;
                            InkChip {
                                text: binding.text;
                                // The last one: "Remove parameter" instead.
                                removable: root.param.bindings.length > 1;
                                remove => {
                                    ModuleSettingsState.binding-removed(root.param.key, binding.step-id, binding.path);
                                }
                            }
                        }
                        if root.param.addable.length > 1: also-set := ComboBox {
                            model: root.param.addable;
                            current-index: 0;
                            accessible-label: "Also set";
                            selected => {
                                if also-set.current-index > 0 {
                                    ModuleSettingsState.binding-added(root.param.key, also-set.current-index - 1);
                                    also-set.current-index = 0;
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    padding-top: 6px;
                    InkButton {
                        small: true;
                        kind: InkButtonKind.quiet;
                        icon: InkIcons.delete;
                        text: "Remove parameter";
                        clicked => {
                            ModuleSettingsState.parameter-removed(root.param.key);
                            root.chosen = max(0, root.chosen - 1);
                        }
                    }
                }
            }
        }
        if !root.has-param: Rectangle {
            horizontal-stretch: 1;
        }
    }

    // The footer; this dialog pads its own content.
    InkDivider { }
    HorizontalLayout {
        spacing: 6px;
        padding-left: Ink.pad-dialog;
        padding-right: Ink.pad-dialog;
        padding-top: 10px;
        padding-bottom: 10px;
        Text {
            horizontal-stretch: 1;
            text: "Changes apply to every use of the module";
            font-size: Ink.fs-secondary;
            color: Ink.text-mute;
            vertical-alignment: center;
        }
        InkButton {
            text: "Cancel";
            clicked => {
                ModuleSettingsState.parameter-edit-cancelled();
                ModuleSettingsState.close();
            }
        }
        InkButton {
            kind: InkButtonKind.primary;
            text: "Apply";
            clicked => {
                ModuleSettingsState.close();
            }
        }
    }
}
