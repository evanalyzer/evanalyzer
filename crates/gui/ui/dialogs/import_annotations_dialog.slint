// dialogs/import_annotations_dialog.slint — a .geojson file read for the
// open image (from EVAnalyzer or another tool): where each class
// name found in it goes - a project class (the names needn't match), a new
// one, no class, or not imported - and whether the shapes are added to the
// image's manual annotations or replace them.

import { Places } from "../api/layout.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { AnnotationState } from "../api/annotations.slint";
import { Ink, InkButton, InkButtonKind, InkCaption, InkDialog, InkDialogFooter, InkSegmented, InkSelect, InkSwatch } from "../ink/ink.slint";

export component ImportAnnotationsDialog inherits InkDialog {
    // Left of the right-hand panels.
    from-right: true;
    anchor-x: Places.beside-right;
    anchor-y: 160px;
    title: "Import annotations";
    subtitle: AnnotationState.geojson-image;
    card-width: 420px;
    property <bool> replace: false;
    close => {
        GlobalAppState.active_dialog = DialogType.none;
    }

    VerticalLayout {
        spacing: 10px;
        Text {
            text: AnnotationState.import-file + " · " + AnnotationState.import-shapes + (AnnotationState.import-shapes == 1 ? " shape" : " shapes");
            wrap: word-wrap;
            color: Ink.text;
            font-size: Ink.fs-secondary;
        }

        if AnnotationState.import-classes.length > 0: InkCaption {
            text: "CLASSES IN THE FILE  →  HERE";
        }
        for row[i] in AnnotationState.import-classes: HorizontalLayout {
            spacing: 8px;
            InkSwatch {
                y: (parent.height - self.height) / 2;
                value: row.color;
            }
            Text {
                horizontal-stretch: 1;
                min-width: 80px;
                text: (row.name == "" ? "(no class)" : row.name) + " · " + row.count;
                font-size: Ink.fs-body;
                color: Ink.text;
                vertical-alignment: center;
                overflow: elide;
            }
            InkSelect {
                width: 190px;
                horizontal-stretch: 0;
                label: "Import " + (row.name == "" ? "the shapes without a class" : row.name) + " as";
                model: AnnotationState.import-targets;
                swatches: AnnotationState.import-target-colors;
                selected: row.target;
                picked(t) => {
                    AnnotationState.import-classes[i].target = t;
                }
            }
        }

        InkSegmented {
            model: ["Add to the annotations", "Replace them"];
            selected: root.replace ? 1 : 0;
            picked(i) => {
                root.replace = i == 1;
            }
        }
        Text {
            text: root.replace ? "This image's manual annotations are deleted first (Undo brings them back)." : "Annotations already there (the same pixels) are not added again.";
            wrap: word-wrap;
            color: Ink.text-mute;
            font-size: Ink.fs-caption;
        }
    }

    InkDialogFooter {
        InkButton {
            text: "Cancel";
            kind: InkButtonKind.quiet;
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
            }
        }
        InkButton {
            text: "Import";
            kind: InkButtonKind.primary;
            enabled: AnnotationState.import-shapes > 0;
            disabled-reason: "No shapes in the file";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
                AnnotationState.apply-import(root.replace);
            }
        }
    }
}
