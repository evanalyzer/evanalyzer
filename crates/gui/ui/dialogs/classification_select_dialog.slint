// dialogs/classification_select_dialog.slint — picks a class for the
// selected object: set it (replacing its classes) or add it.

import { DialogType, GlobalAppState } from "../api/state.slint";
import { ClassificationState } from "../api/classification.slint";
import { ObjectListState } from "../api/object_list.slint";
import { ClassSelectDialogState } from "../api/classification_select.slint";
import { Ink, InkDialog, InkDialogFooter, InkButton, InkButtonKind, InkListRow, InkBusy } from "../ink/ink.slint";

export component ClassSelectDialog inherits InkDialog {
    title: "Select class";
    subtitle: "for object " + ObjectListState.selected_object.id;
    card-width: 380px;
    card-height: 460px;

    function done() {
        ClassSelectDialogState.selected_class_name = "";
        ClassSelectDialogState.selected_class_id = -1;
        GlobalAppState.active-dialog = DialogType.none;
    }

    close => {
        root.done();
    }

    Rectangle {
        vertical-stretch: 1;

        Flickable {
            content-height: rows.preferred-height;
            rows := VerticalLayout {
                alignment: start;
                for data in ClassificationState.classes_list: InkListRow {
                    title: data.name;
                    tag: data.id < 10 ? "0" + data.id : data.id;
                    swatch: data.color;
                    trailing: data.count;
                    selected: ClassSelectDialogState.selected_class_id == data.id;
                    clicked => {
                        if data.id == ClassSelectDialogState.selected_class_id {
                            ClassSelectDialogState.selected_class_name = "";
                            ClassSelectDialogState.selected_class_id = -1;
                        } else {
                            ClassSelectDialogState.selected_class_name = data.name;
                            ClassSelectDialogState.selected_class_id = data.id;
                        }
                    }
                }
            }
        }

        if ClassificationState.is_scanning: Rectangle {
            background: Ink.glass;
            TouchArea { }
            InkBusy {
                size: 18px;
            }
        }
    }

    InkDialogFooter {
        InkButton {
            text: "Cancel";
            kind: InkButtonKind.quiet;
            clicked => {
                root.done();
            }
        }
        InkButton {
            text: "Add class";
            enabled: ClassSelectDialogState.selected_class_id >= 0;
            clicked => {
                ObjectListState.object_add_class(ObjectListState.selected_object.id, ClassSelectDialogState.selected_class_id);
                root.done();
            }
        }
        InkButton {
            text: "Set class";
            kind: InkButtonKind.primary;
            enabled: ClassSelectDialogState.selected_class_id >= 0;
            clicked => {
                ObjectListState.object_replace_class(ObjectListState.selected_object.id, ClassSelectDialogState.selected_class_id);
                root.done();
            }
        }
    }
}
