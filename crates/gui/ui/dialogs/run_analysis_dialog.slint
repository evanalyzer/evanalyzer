import { CheckBox, ComboBox, LineEdit } from "std-widgets.slint";
import { Dialog, DialogFooter, DialogTone } from "../components/new_components/dialog.slint";
import { GlobalAppState, DialogType } from "../state.slint";
import { AppButton } from "../components/app_button.slint";
import { Theme } from "../style.slint";

export global RunAnalysisState {
    in-out property <string> job_name: "";
    /// Run only the dataset steps, on a copy of an earlier analysis.
    in-out property <bool> dataset_only: false;
    /// Whether the project has enabled dataset steps to run.
    in property <bool> has_dataset_steps: false;
    /// The earlier analyses to choose from (names, and their databases).
    in property <[string]> base_names: [];
    in property <[string]> base_paths: [];
    in-out property <int> base_index: 0;

    callback confirm();
    callback cancel();
}

export component RunAnalysisDialog inherits Dialog {
    title: "Run Analysis";
    dialog-width: 440px;
    tone: DialogTone.run;
    close => {
        RunAnalysisState.cancel();
    }

    VerticalLayout {
        spacing: 12px;

        VerticalLayout {
            spacing: 5px;
            Text {
                text: "Job name (optional)";
                font-size: 11px;
                color: Theme.text-dim;
            }

            name-edit := LineEdit {
                height: 30px;
                text <=> RunAnalysisState.job_name;
                placeholder-text: "e.g. sigmund_freud";
                accepted => {
                    RunAnalysisState.confirm();
                }
            }

            Text {
                text: "Leave blank to auto-generate a name.";
                wrap: word-wrap;
                color: Theme.text-dim;
                font-size: 11px;
            }
        }

        VerticalLayout {
            spacing: 5px;

            CheckBox {
                text: "Only run the dataset steps";
                enabled: RunAnalysisState.has_dataset_steps && RunAnalysisState.base_names.length > 0;
                checked <=> RunAnalysisState.dataset_only;
            }

            Text {
                text: !RunAnalysisState.has_dataset_steps
                    ? "The pipelines have no dataset steps."
                    : RunAnalysisState.base_names.length == 0
                    ? "There are no earlier results to run them on yet."
                    : RunAnalysisState.dataset_only
                    ? "No image is analysed: the dataset steps run on a copy of these results, saved under the new job name."
                    : "Analyses every image, then runs the dataset steps.";
                wrap: word-wrap;
                color: Theme.text-dim;
                font-size: 11px;
            }

            if RunAnalysisState.dataset_only: ComboBox {
                model: RunAnalysisState.base_names;
                current-index <=> RunAnalysisState.base_index;
            }
        }

        DialogFooter {

            AppButton {
                text: "Cancel";
                clicked => {
                    RunAnalysisState.cancel();
                }
            }

            AppButton {
                text: "Run";
                primary: true;
                clicked => {
                    RunAnalysisState.confirm();
                }
            }
        }
    }

    // Focus the name field as soon as the dialog becomes visible so the user
    // can start typing (or just hit Enter to run with an auto-generated name).
    init => {
        name-edit.focus();
    }
}
