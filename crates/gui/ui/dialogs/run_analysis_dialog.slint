import { PipelinesPanelState } from "../api/pipelines.slint";
import { ImagesListState } from "../api/images_list.slint";
import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { RunAnalysisState } from "../api/run_analysis.slint";
import { CheckBox, ComboBox, LineEdit } from "../ink/std_compat.slint";

import { Ink } from "../ink/palette.slint";
export component RunAnalysisDialog inherits InkDialog {
    // Below the Run button.
    from-right: true;
    anchor-x: 12px;
    anchor-y: 46px;
    title: "Run analysis";
    subtitle: PipelinesPanelState.enabled-pipeline-count + (PipelinesPanelState.enabled-pipeline-count == 1 ? " pipeline · " : " pipelines · ") + ImagesListState.images_list.length + " images";
    card-width: 360px;
    close => {
        RunAnalysisState.cancel();
    }

    VerticalLayout {
        spacing: 12px;

        VerticalLayout {
            spacing: 5px;
            Text {
                text: "Job name (optional)";
                font-size: 11px;
                color: Ink.text-dim;
            }

            name-edit := LineEdit {
                height: 30px;
                text <=> RunAnalysisState.job_name;
                placeholder-text: "e.g. sigmund_freud";
                accepted => {
                    RunAnalysisState.confirm();
                }
            }

            Text {
                text: "Leave blank to auto-generate a name.";
                wrap: word-wrap;
                color: Ink.text-dim;
                font-size: 11px;
            }
        }

        VerticalLayout {
            spacing: 5px;

            CheckBox {
                text: "Only run the dataset steps";
                enabled: RunAnalysisState.has_dataset_steps && RunAnalysisState.base_names.length > 0;
                checked <=> RunAnalysisState.dataset_only;
            }

            Text {
                text: !RunAnalysisState.has_dataset_steps
                    ? "The pipelines have no dataset steps."
                    : RunAnalysisState.base_names.length == 0
                    ? "There are no earlier results to run them on yet."
                    : RunAnalysisState.dataset_only
                    ? "No image is analysed: the dataset steps run on a copy of these results, saved under the new job name."
                    : "Analyses every image, then runs the dataset steps.";
                wrap: word-wrap;
                color: Ink.text-dim;
                font-size: 11px;
            }

            if RunAnalysisState.dataset_only: ComboBox {
                model: RunAnalysisState.base_names;
                current-index <=> RunAnalysisState.base_index;
            }
        }

        InkDialogFooter {

            InkButton {
                text: "Cancel";
                clicked => {
                    RunAnalysisState.cancel();
                }
            }

            InkButton {
                kind: InkButtonKind.primary;
                text: "Run";
                clicked => {
                    RunAnalysisState.confirm();
                }
            }
        }
    }

    // Focus the name field as soon as the dialog becomes visible so the user
    // can start typing (or just hit Enter to run with an auto-generated name).
    init => {
        name-edit.focus();
    }
}
