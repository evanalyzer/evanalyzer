import { Places } from "../api/layout.slint";
import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { ClassificationState } from "../api/classification.slint";

import { Ink } from "../ink/palette.slint";

export component ConfirmDeleteClassDialog inherits InkDialog {
    // Left of the right-hand panels.
    from-right: true;
    anchor-x: Places.beside-right;
    anchor-y: 96px;
    title: "Delete class";
    card-width: 320px;
    close => {
        GlobalAppState.active-dialog = DialogType.none;
    }

    VerticalLayout {
        spacing: 12px;
        Text {
            text: "This action cannot be undone. Deleting a class breaks existing annotations and pipeline steps. Ensure you are not using this class before proceeding.";
            wrap: word-wrap;
            color: Ink.text;
            font-size: 13px;
        }

        Text {
            text: "Delete class \{ClassificationState.selected_class_name}?";
            wrap: word-wrap;
            color: Ink.text-dim;
            font-size: 13px;
        }

        InkDialogFooter {

            InkButton {
                text: "Cancel";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                }
            }

            InkButton {
                kind: InkButtonKind.danger;
                text: "Delete";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    ClassificationState.class_delete(ClassificationState.selected_class_id);
                    ClassificationState.selected_class_id = -1;
                    ClassificationState.selected_class_name = "";
                }
            }
        }
    }
}
