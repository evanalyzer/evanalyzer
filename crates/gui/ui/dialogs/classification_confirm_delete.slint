import { Places } from "../api/layout.slint";
import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { ClassificationState } from "../api/classification.slint";

import { Ink } from "../ink/palette.slint";

export component ConfirmDeleteClassDialog inherits InkDialog {
    // Every class, not the selected one.
    in property <bool> all: false;

    // Left of the right-hand panels.
    from-right: true;
    anchor-x: Places.beside-right;
    anchor-y: 96px;
    title: root.all ? "Delete all classes" : "Delete class";
    card-width: 320px;
    close => {
        GlobalAppState.active-dialog = DialogType.none;
    }

    VerticalLayout {
        spacing: 12px;
        Text {
            text: root.all ? "This action cannot be undone. Deleting the classes breaks existing annotations and pipeline steps. Ensure you are not using them before proceeding." : "This action cannot be undone. Deleting a class breaks existing annotations and pipeline steps. Ensure you are not using this class before proceeding.";
            wrap: word-wrap;
            color: Ink.text;
            font-size: Ink.fs-heading;
        }

        Text {
            text: root.all ? "Delete all \{ClassificationState.classes_list.length - 1} classes? Background stays." : "Delete class \{ClassificationState.selected_class_name}?";
            wrap: word-wrap;
            color: Ink.text-dim;
            font-size: Ink.fs-heading;
        }

        InkDialogFooter {

            InkButton {
                text: "Cancel";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                }
            }

            InkButton {
                kind: InkButtonKind.danger;
                text: "Delete";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    if root.all {
                        ClassificationState.class_delete_all();
                    } else {
                        ClassificationState.class_delete(ClassificationState.selected_class_id);
                    }
                    ClassificationState.selected_class_id = -1;
                    ClassificationState.selected_class_name = "";
                }
            }
        }
    }
}
