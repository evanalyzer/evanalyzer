import { Theme } from "../style.slint";
import { Dialog, DialogFooter, DialogTone } from "../components/new_components/dialog.slint";
import { GlobalAppState, DialogType } from "../state.slint";
import { BioRunner } from "../components/bio_runner.slint";
import { AppButton } from "../components/app_button.slint";

// -- Global progress state -----------------------------------------------------

export global PipelineRunningState {
    in-out property <int> processed: 0;
    in-out property <int> total: 0;
    // True once every tile is done and the pipeline has moved on to
    // whole-image-scoped work (tile-merge, Voronoi, DB export, ...). The
    // remaining `processed`/`total` units no longer correspond 1:1 to
    // images, so the label switches to a phase description instead of a
    // counter that would otherwise look "stuck".
    in-out property <bool> whole-image-phase: false;
    in-out property <bool> done: false;
    in-out property <bool> has-error: false;
    in-out property <string> status-message: "";
    callback cancel();
    callback close();
}

// -- Dialog --------------------------------------------------------------------

export component PipelineRunningDialog inherits Dialog {
    title: "Analyzing Images";
    tone: DialogTone.run;
    dialog-width: 440px;
    // No ✕ / Esc / backdrop: the run is stopped (or the finished dialog
    // closed) only through the footer button.
    closable: false;

    // Progress label
    HorizontalLayout {
        alignment: space-between;
        Text {
            text: PipelineRunningState.whole-image-phase ? "Processing objects…" : (PipelineRunningState.total > 0 ? (PipelineRunningState.processed + " of " + PipelineRunningState.total + " images processed") : "Starting…");
            font-size: 13px;
            color: Theme.text-dim;
        }

        Text {
            text: PipelineRunningState.total > 0 ? ((PipelineRunningState.processed * 100 / PipelineRunningState.total) + "%") : "";
            font-size: 13px;
            font-weight: 600;
            color: Theme.accent;
        }
    }

    // Progress bar
    Rectangle {
        height: 8px;
        border-radius: 4px;
        background: Theme.raised;

        Rectangle {
            x: 0;
            width: PipelineRunningState.total > 0 ? parent.width * (PipelineRunningState.processed * 1.0 / PipelineRunningState.total) : 0px;
            height: parent.height;
            border-radius: 4px;
            background: Theme.accent;
            animate width {
                duration: 350ms;
                easing: ease-out;
            }
        }
    }

    // Divider
    Rectangle {
        height: 1px;
        background: Theme.border-soft;
    }

    // Bio-dino runner
    BioRunner { paused: PipelineRunningState.done; }

    // Status message (shown when done)
    Rectangle {
        height: PipelineRunningState.done ? 20px : 0px;
        clip: true;
        animate height { duration: 200ms; easing: ease-out; }
        Text {
            text: PipelineRunningState.status-message;
            font-size: 12px;
            color: PipelineRunningState.done && !PipelineRunningState.has-error ? Theme.accent : Theme.text-dim;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }

    DialogFooter {
        AppButton {
            text: PipelineRunningState.done ? "Close" : "Cancel";
            primary: PipelineRunningState.done;
            clicked => {
                if (PipelineRunningState.done) {
                    PipelineRunningState.close();
                } else {
                    PipelineRunningState.cancel();
                }
            }
        }
    }
}
