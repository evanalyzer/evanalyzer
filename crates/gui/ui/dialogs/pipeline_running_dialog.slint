// dialogs/pipeline_running_dialog.slint — the progress of a running
// analysis: `AnalysisCard` over the image while the window stays usable
// (editing allowed during an analysis, the default), or the blocking
// `PipelineRunningDialog` (not allowed).

import { PipelineRunningState } from "../api/pipeline_running.slint";
import { LayoutState } from "../api/layout.slint";
import { Ink, InkIcons, InkTone, InkDialog, InkDialogFooter, InkButton, InkButtonKind, InkIconButton, InkProgressBar, InkBusy } from "../ink/ink.slint";

export global AnalysisText {
    // "12 of 81 images" / "Processing objects…" / "Starting…".
    pure public function progress() -> string {
        PipelineRunningState.done ? PipelineRunningState.status-message
            : PipelineRunningState.whole-image-phase ? "Processing objects…"
            : PipelineRunningState.total > 0 ? PipelineRunningState.processed + " of " + PipelineRunningState.total + " images"
            : "Starting…"
    }

    pure public function percent() -> string {
        PipelineRunningState.total > 0 && !PipelineRunningState.done ? round(PipelineRunningState.processed * 100 / PipelineRunningState.total) + "%" : ""
    }

    pure public function fraction() -> float {
        PipelineRunningState.done ? 1 : PipelineRunningState.total > 0 ? PipelineRunningState.processed / PipelineRunningState.total : 0
    }

    pure public function tone() -> InkTone {
        PipelineRunningState.done ? (PipelineRunningState.has-error ? InkTone.err : InkTone.ok) : InkTone.neutral
    }
}

// The card over the image: title, progress, Cancel / Close, and – to put
// it away – a minimise button (the bottom bar still shows the progress).
export component AnalysisCard inherits Rectangle {
    width: 360px;
    height: layout.preferred-height;
    accessible-role: groupbox;
    accessible-label: "Analysis";

    glass := Rectangle {
        background: Ink.glass;
        border-radius: Ink.radius-lg;
        border-width: 1px;
        border-color: Ink.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Ink.shadow;

        TouchArea { }

        layout := VerticalLayout {
            padding: 12px;
            padding-top: 8px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 14px;
                    if !PipelineRunningState.done: InkBusy {
                        size: 14px;
                    }
                    if PipelineRunningState.done: Image {
                        source: PipelineRunningState.has-error ? InkIcons.error : InkIcons.check;
                        width: 14px;
                        colorize: PipelineRunningState.has-error ? Ink.err : Ink.ok;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: PipelineRunningState.done ? "Analysis finished" : "Analysis running";
                    font-size: Ink.fs-lg;
                    font-weight: 600;
                    color: Ink.text;
                    vertical-alignment: center;
                }
                Text {
                    text: AnalysisText.percent();
                    font-size: Ink.fs-md;
                    font-family: Ink.font-mono;
                    color: Ink.text-dim;
                    vertical-alignment: center;
                }
                InkIconButton {
                    size: 24px;
                    icon: InkIcons.remove;
                    label: "Minimise";
                    clicked => {
                        LayoutState.analysis-card-hidden = true;
                    }
                }
            }

            InkProgressBar {
                value: AnalysisText.fraction();
                tone: AnalysisText.tone();
            }

            HorizontalLayout {
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: AnalysisText.progress();
                    font-size: Ink.fs-sm;
                    color: PipelineRunningState.done && PipelineRunningState.has-error ? Ink.err : Ink.text-dim;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                InkButton {
                    small: true;
                    text: PipelineRunningState.done ? "Close" : "Cancel";
                    kind: PipelineRunningState.done ? InkButtonKind.primary : InkButtonKind.secondary;
                    clicked => {
                        if PipelineRunningState.done {
                            PipelineRunningState.close();
                        } else {
                            PipelineRunningState.cancel();
                        }
                    }
                }
            }
        }
    }
}

export component PipelineRunningDialog inherits InkDialog {
    title: "Analyzing images";
    subtitle: AnalysisText.percent();
    card-width: 440px;
    closable: false;

    Text {
        text: AnalysisText.progress();
        font-size: Ink.fs-md;
        color: PipelineRunningState.done && PipelineRunningState.has-error ? Ink.err : Ink.text-dim;
        wrap: word-wrap;
    }

    InkProgressBar {
        height: 6px;
        value: AnalysisText.fraction();
        tone: AnalysisText.tone();
    }

    InkDialogFooter {
        InkButton {
            text: PipelineRunningState.done ? "Close" : "Cancel";
            kind: PipelineRunningState.done ? InkButtonKind.primary : InkButtonKind.secondary;
            clicked => {
                if PipelineRunningState.done {
                    PipelineRunningState.close();
                } else {
                    PipelineRunningState.cancel();
                }
            }
        }
    }
}
