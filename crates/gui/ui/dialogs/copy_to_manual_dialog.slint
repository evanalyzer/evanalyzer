// dialogs/copy_to_manual_dialog.slint — copies the open image's pipeline
// (preview) objects into its manual annotations: those of the ticked
// classes, with their own classes or one class for all. A pipeline's
// result as the start of classifier training data, corrected by hand.

import { Places } from "../api/layout.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { ClassificationState } from "../api/classification.slint";
import { AnnotationState } from "../api/annotations.slint";
import { Ink, InkButton, InkButtonKind, InkCaption, InkCheckbox, InkChip, InkDialog, InkDialogFooter, InkListRow, InkSegmented } from "../ink/ink.slint";

export component CopyToManualDialog inherits InkDialog {
    // Left of the right-hand panels.
    from-right: true;
    anchor-x: Places.beside-right;
    anchor-y: 180px;
    title: AnnotationState.copy-single >= 0 ? "Copy object as annotation" : "Copy pipeline objects as annotations";
    subtitle: AnnotationState.copy-single >= 0 ? "editable, used for training" : "on this image";
    card-width: 380px;
    // One class for all copies (-1: their own classes).
    property <bool> one-class: false;
    property <int> target-class: -1;
    close => {
        GlobalAppState.active_dialog = DialogType.none;
    }

    VerticalLayout {
        spacing: 10px;

        if AnnotationState.copy-single < 0: InkCaption {
            text: "OBJECTS OF THESE CLASSES";
        }
        if AnnotationState.copy-single < 0 && AnnotationState.pipeline-classes.length == 0: Text {
            text: "No pipeline objects on this image - run the preview first.";
            wrap: word-wrap;
            color: Ink.text-mute;
            font-size: Ink.fs-secondary;
        }
        // (No rows for one object: its classes are shown below.)
        for row[i] in AnnotationState.copy-single < 0 ? AnnotationState.pipeline-classes : []: InkCheckbox {
            text: row.name + " · " + row.count;
            swatch: row.color;
            checked: row.checked;
            toggled(on) => {
                AnnotationState.pipeline-classes[i].checked = on;
            }
        }

        InkCaption {
            text: AnnotationState.copy-single >= 0 ? "THE COPY'S CLASS" : "THE COPIES' CLASS";
        }
        // One object: its classes, as a reminder of what "its own" means.
        if AnnotationState.copy-single >= 0: HorizontalLayout {
            spacing: 4px;
            alignment: start;
            if AnnotationState.pipeline-classes.length == 0: Text {
                text: "No class";
                color: Ink.text-mute;
                font-size: Ink.fs-secondary;
            }
            for row in AnnotationState.pipeline-classes: InkChip {
                text: row.name;
                swatch: row.color;
            }
        }
        InkSegmented {
            model: AnnotationState.copy-single >= 0 ? ["Its own classes", "Another class"] : ["Their own classes", "One class for all"];
            selected: root.one-class ? 1 : 0;
            picked(i) => {
                root.one-class = i == 1;
            }
        }
        if root.one-class: Rectangle {
            height: min(rows.preferred-height, 180px);
            Flickable {
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    alignment: start;
                    for data in ClassificationState.classes_list: InkListRow {
                        title: data.name;
                        swatch: data.color;
                        selected: root.target-class == data.id;
                        clicked => {
                            root.target-class = data.id;
                        }
                    }
                }
            }
        }
    }

    InkDialogFooter {
        InkButton {
            text: "Cancel";
            kind: InkButtonKind.quiet;
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
            }
        }
        InkButton {
            text: "Copy";
            kind: InkButtonKind.primary;
            enabled: (AnnotationState.copy-single >= 0 || AnnotationState.pipeline-classes.length > 0) && (!root.one-class || root.target-class >= 0);
            disabled-reason: "Nothing to copy - pick the objects and a class";
            clicked => {
                GlobalAppState.active_dialog = DialogType.none;
                AnnotationState.copy-all-to-manual(root.one-class ? root.target-class : -1);
            }
        }
    }
}
