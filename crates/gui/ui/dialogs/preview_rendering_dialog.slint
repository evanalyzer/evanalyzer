// dialogs/preview_rendering_dialog.slint — while the preview renders: a
// small pill at the top of the image with the progress and ✕ (cancel, or
// dismiss a finished one). Not a dialog: the image stays usable.

import { PreviewRunState } from "../api/pipeline_running.slint";
import { Ink, InkIcons, InkBusy, InkIconButton, InkTipZone } from "../ink/ink.slint";

export component PreviewRendering inherits Rectangle {
    // Cancels a running preview, or dismisses a finished one.
    function dismiss() {
        if PreviewRunState.done {
            PreviewRunState.close();
        } else {
            PreviewRunState.cancel();
        }
    }

    property <bool> failed: PreviewRunState.done && PreviewRunState.has-error;

    pill := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 64px;
        width: min(row.preferred-width + 16px, parent.width - 32px);
        height: 32px;
        accessible-role: groupbox;
        accessible-label: "Preview";

        face := Rectangle {
            border-radius: 16px;
            background: #000000.with-alpha(0.72);
            border-width: 1px;
            border-color: #FFFFFF.with-alpha(0.15);

            row := HorizontalLayout {
                padding-left: 12px;
                padding-right: 4px;
                spacing: 8px;

                Rectangle {
                    width: 13px;
                    if !PreviewRunState.done: InkBusy {
                        size: 13px;
                        tint: #FFFFFF;
                    }
                    if PreviewRunState.done: Image {
                        source: root.failed ? InkIcons.error : InkIcons.check;
                        width: 13px;
                        colorize: root.failed ? Ink.err : #FFFFFF;
                    }
                }

                Text {
                    text: !PreviewRunState.done
                        ? (PreviewRunState.whole-image ? "Previewing the whole image…" : "Generating preview…")
                        : root.failed ? "Preview failed: " + PreviewRunState.status-message
                        : PreviewRunState.whole-image && PreviewRunState.outdated ? "Whole image: outdated - settings changed"
                        : PreviewRunState.whole-image ? "Whole image: " + PreviewRunState.objects + (PreviewRunState.objects == 1 ? " object" : " objects")
                        : "Preview ready";
                    font-size: Ink.fs-body;
                    color: root.failed ? Ink.err
                        : PreviewRunState.done && PreviewRunState.outdated ? Ink.warn : #FFFFFF;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if PreviewRunState.total > 0 && !PreviewRunState.done: Text {
                    text: PreviewRunState.processed + " / " + PreviewRunState.total
                        + " · " + round(PreviewRunState.processed * 100 / PreviewRunState.total) + "%";
                    font-size: Ink.fs-secondary;
                    font-family: Ink.font-mono;
                    color: #FFFFFF.with-alpha(0.65);
                    vertical-alignment: center;
                }

                close := Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: close-ta.has-hover ? #FFFFFF.with-alpha(0.18) : transparent;
                    accessible-role: button;
                    accessible-label: "Close";
                    accessible-action-default => {
                        root.dismiss();
                    }
                    Image {
                        source: InkIcons.close;
                        width: 11px;
                        colorize: #FFFFFF;
                    }
                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.dismiss();
                        }
                    }
                    InkTipZone {
                        width: 100%;
                        height: 100%;
                        wanted: close-ta.has-hover && !close-ta.pressed;
                        text: "Close";
                    }
                }
            }
        }
    }
}
