import { Theme } from "../style.slint";
import { PipelineRunningState } from "pipeline_running_dialog.slint";


// -- Dialog --------------------------------------------------------------------

// A slim, unobtrusive progress banner across the middle of the viewport.
// Preview rendering is fast most of the time, so this deliberately avoids a
// full modal card (backdrop, centered dialog, blocking TouchArea) - it's a
// thin black strip, vertically centered over the image, with white
// status/progress text and a small "✕" to cancel or dismiss, all grouped
// together in the middle rather than spread edge-to-edge.
export component PreviewRendering inherits Rectangle {
    background: transparent;

    // Cancels a running preview, or dismisses a finished one.
    function dismiss() {
        if (PipelineRunningState.done) {
            PipelineRunningState.close();
        } else {
            PipelineRunningState.cancel();
        }
    }

    bar := Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: 28px;
        background: #000000;

        HorizontalLayout {
            alignment: center;
            spacing: 8px;

            Text {
                text: !PipelineRunningState.done ? "Generating preview…" : (PipelineRunningState.has-error ? "Preview failed: " + PipelineRunningState.status-message : "Preview ready");
                font-size: 12px;
                color: PipelineRunningState.has-error && PipelineRunningState.done ? Theme.err : Theme.text-pixel-info;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                text: PipelineRunningState.total > 0 && !PipelineRunningState.done ? (PipelineRunningState.processed + " / " + PipelineRunningState.total + " (" + (PipelineRunningState.processed * 100 / PipelineRunningState.total) + "%)") : "";
                font-size: 12px;
                color: Theme.text-pixel-info.with-alpha(0.67);
                vertical-alignment: center;
            }

            Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-sm;
                background: close-ta.has-hover ? Theme.text-pixel-info.with-alpha(0.2) : transparent;
                animate background { duration: 80ms; }
                accessible-role: button;
                accessible-label: "Close";
                accessible-action-default => {
                    root.dismiss();
                }

                Image {
                    source: @image-url("../icons/regular-white/x.svg");
                    width: 12px;
                    height: 12px;
                    colorize: Theme.text-pixel-info;
                }

                close-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }
    }
}
