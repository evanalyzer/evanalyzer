import { Places } from "../api/layout.slint";
import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { ClassificationSettingsState, ClassResultsKind } from "../api/classification_class_edit.slint";
import { LineEdit, ComboBox } from "../ink/std_compat.slint";

import { Ink } from "../ink/palette.slint";
component ColorTile inherits Rectangle {
    in property <color> item_color;
    property <bool> is_selected: ClassificationSettingsState.settings.color == item_color;
    width: 16px;
    height: 16px;
    background: item_color;
    border-radius: 4px;

    border-width: is_selected ? 3px : 1px;
    border-color: is_selected ? Ink.focus : Ink.border;

    TouchArea {
        clicked => {
            ClassificationSettingsState.settings.color = item_color;
        }
    }
}

// One choice of what the results keep of the class: a radio, its name and
// what it does - the whole card picks it.
component ResultsOption inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    callback picked;

    accessible-role: radio-button;
    accessible-checked: root.checked;
    accessible-label: root.title;
    accessible-description: root.description;
    accessible-action-default => {
        root.picked();
    }
    border-radius: Ink.radius-md;
    border-width: 1px;
    border-color: root.checked ? Ink.focus : ta.has-hover ? Ink.row-lift-ring : Ink.border;
    background: ta.has-hover && !root.checked ? Ink.hover : Ink.panel;

    // The chosen one's ring, as the focus ring of a field.
    if root.checked: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: Ink.radius-md + 3px;
        border-width: 3px;
        border-color: Ink.focus-ring;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
        }
    }

    HorizontalLayout {
        padding-top: 9px;
        padding-bottom: 9px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            padding-top: 2px;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: root.checked ? 4px : 1px;
                border-color: root.checked ? Ink.focus : Ink.text-faint;
                background: Ink.panel;
            }
        }

        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                font-size: Ink.fs-body;
                font-weight: root.checked ? 600 : 400;
                color: Ink.text;
                accessible-role: none;
            }

            Text {
                text: root.description;
                font-size: Ink.fs-secondary;
                color: Ink.text-dim;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
    }
}

export component ClassEditDialog inherits InkDialog {
    // Left of the right-hand panels.
    from-right: true;
    anchor-x: Places.beside-right;
    // At the class row it's for (see `anchor-y`).
    anchor-y: ClassificationSettingsState.anchor-y;
    title: "Class settings";
    card-width: 320px;
    close => {
        GlobalAppState.active-dialog = DialogType.none;
        ClassificationSettingsState.reset_to_zero();
        ClassificationSettingsState.anchor-y = 96px;
    }

    HorizontalLayout {
        spacing: 10px;
        Text {
            text: "Name";
            width: 72px;
            vertical-alignment: center;
            font-size: Ink.fs-heading;
            color: Ink.text;
        }

        LineEdit {
            placeholder-text: "e.g. FITC-Cell";
            text <=> ClassificationSettingsState.settings.name;
        }
    }

    HorizontalLayout {
        spacing: 10px;
        Text {
            text: "Notes";
            width: 72px;
            vertical-alignment: center;
            font-size: Ink.fs-heading;
            color: Ink.text;
        }

        LineEdit {
            placeholder-text: "Optional description...";
            text <=> ClassificationSettingsState.settings.notes;
        }
    }

    HorizontalLayout {
        spacing: 10px;
        Text {
            text: "Class ID";
            width: 72px;
            vertical-alignment: center;
            font-size: Ink.fs-heading;
            color: Ink.text;
        }

        ComboBox {
            // The background keeps its id 0.
            enabled: ClassificationSettingsState.settings.class-id != 0;
            model: ClassificationSettingsState.id-options;
            current-index <=> ClassificationSettingsState.id-index;
        }
    }

    // Changing an existing class's id moves its references.
    if ClassificationSettingsState.settings.class-id > 0 && ClassificationSettingsState.id-index > 0: Text {
        text: "Pipelines, modules and annotated objects using class \{ClassificationSettingsState.settings.class-id} switch to the new id. Results of earlier runs keep the old one.";
        font-size: Ink.fs-body;
        color: Ink.text-dim;
        wrap: word-wrap;
    }

    // What the results keep of the class (`ClassResults`).
    VerticalLayout {
        spacing: 6px;
        Text {
            text: "Results";
            font-size: Ink.fs-heading;
            color: Ink.text;
        }

        ResultsOption {
            title: "Objects";
            description: "Every object with its measurements. Default.";
            checked: ClassificationSettingsState.settings.results == ClassResultsKind.objects;
            picked => {
                ClassificationSettingsState.settings.results = ClassResultsKind.objects;
            }
        }

        ResultsOption {
            title: "Intermediate";
            description: "Only for later steps, e.g. seeds for Grow Regions. Shown in the viewer, not written to the results.";
            checked: ClassificationSettingsState.settings.results == ClassResultsKind.intermediate;
            picked => {
                ClassificationSettingsState.settings.results = ClassResultsKind.intermediate;
            }
        }
    }

    HorizontalLayout {
        spacing: 10px;
        Text {
            text: "Color";
            width: 72px;
            vertical-alignment: center;
            font-size: Ink.fs-heading;
            color: Ink.text;
        }

        // 7 a row: the card stays narrow (next to the classes panel).
        GridLayout {
            spacing: 6px;
            Row {
                for c in [#FF00FF, #00FFFF, #00FF00, #FFFF00, #FF3333, #3366FF, #FF9900]: ColorTile {
                    item_color: c;
                }
            }
            Row {
                for c in [#ADFF2F, #00FA9A, #87CEFA, #FF66CC, #FF1493, #7B00FF, #00FF88]: ColorTile {
                    item_color: c;
                }
            }
            Row {
                for c in [#FFD700, #FF4500, #FF69B4, #F08080, #FFA07A, #DA70D6, #FF007F]: ColorTile {
                    item_color: c;
                }
            }
            Row {
                for c in [#FFCC00, #EEDD82, #BC8F8F, #FF8C00, #FF7F50, #C71585, #E9967A]: ColorTile {
                    item_color: c;
                }
            }
            Row {
                for c in [#00CED1, #1E90FF, #9370DB, #40E0D0, #7B68EE, #48D1CC, #00BFFF]: ColorTile {
                    item_color: c;
                }
            }
            Row {
                for c in [#AFEEEE, #B0C4DE, #66CDAA, #9932CC, #20B2AA, #5F9EA0, #4169E1]: ColorTile {
                    item_color: c;
                }
            }
            Row {
                for c in [#FFCCFF, #99FFFF, #FFE4B5, #EEE8AA, #CCFFCC, #E6E6FA, #FFFAC8]: ColorTile {
                    item_color: c;
                }
            }
            Row {
                for c in [#F0FFF0, #F5FFFA, #F0F8FF, #FFFFFF, #FFF0F5, #FFE4E1, #E0FFFF]: ColorTile {
                    item_color: c;
                }
            }
        }
    }

    InkDialogFooter {
        InkButton {
            text: "Cancel";
            clicked => {
                GlobalAppState.active-dialog = DialogType.none;
                ClassificationSettingsState.reset_to_zero();
                ClassificationSettingsState.anchor-y = 96px;
            }
        }

        InkButton {
            kind: InkButtonKind.primary;
            text: "Apply";
            clicked => {
                // Index 0 is "Auto" for a new class, the own id for an edited one.
                ClassificationSettingsState.settings.new-id = ClassificationSettingsState.id-index == 0 ? (ClassificationSettingsState.settings.class-id < 0 ? -1 : ClassificationSettingsState.settings.class-id) : ClassificationSettingsState.id-options[ClassificationSettingsState.id-index].to-float();
                ClassificationSettingsState.apply_classification_settings(ClassificationSettingsState.settings);
                GlobalAppState.active-dialog = DialogType.none;
                ClassificationSettingsState.anchor-y = 96px;
            }
        }
    }
}
