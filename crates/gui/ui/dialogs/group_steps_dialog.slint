import { LineEdit, ComboBox, ScrollView, TextEdit } from "std-widgets.slint";
import { AppButton } from "../components/app_button.slint";
import { Theme } from "../style.slint";

// "Group steps": turns consecutive steps of a pipeline into a command group.
// The host fills the class list with suggested roles (see
// `evanalyzer_app::groups::plan_grouping`) and recomputes it when the range
// changes.

// -- Global state --------------------------------------------

/// A project class the steps use, and what it becomes in the group.
export struct GroupClassRow {
    /// The class in its text form ("3") - how the host knows which it is.
    class-text: string,
    name: string,
    /// "Only used by these steps" / "Also used elsewhere".
    detail: string,
    /// 0 = internal (the group's own), 1 = group parameter, 2 = fixed.
    role: int,
}

export global GroupStepsState {
    in property <int> pipeline-id: 0;
    /// "1 · Threshold", "2 · Extract Objects", ... - for the range pickers.
    in property <[string]> step-names: [];
    in-out property <int> from-step: 0;
    in-out property <int> to-step: 0;
    in-out property <string> name: "";
    in property <[GroupClassRow]> classes: [];
    /// "Channel 1 becomes a group parameter", or empty.
    in property <string> channels-text: "";
    /// Why the group can't be made, or empty.
    in property <string> error: "";
    callback range-changed(int, int);
    callback role-changed(int, int);
    callback confirm();
    callback cancel();
}

component RangeRow inherits HorizontalLayout {
    in property <string> label;
    in property <[string]> model;
    in property <int> current;
    callback picked(int);

    spacing: 8px;
    Text {
        text: label;
        width: 40px;
        font-size: 11px;
        color: Theme.text-dim;
        vertical-alignment: center;
    }

    ComboBox {
        horizontal-stretch: 1;
        model: root.model;
        current-index: root.current;
        selected(v) => {
            root.picked(self.current-index);
        }
    }
}

// -- Dialog component -----------------------------------------

export component GroupStepsDialog inherits Rectangle {
    background: Theme.modal-overlay;

    TouchArea {
        clicked => {
            GroupStepsState.cancel();
        }
    }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 480px;
        background: Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 12px;
        clip: true;

        TouchArea { }

        layout := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Group steps";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                }

                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    background: close-ta.has-hover ? Theme.raised : transparent;
                    Text {
                        text: "✕";
                        font-size: 12px;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            GroupStepsState.cancel();
                        }
                    }
                }
            }

            Text {
                text: "The steps become one step - a command group you can use like a command, in this and other pipelines.";
                font-size: 11px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 5px;
                Text {
                    text: "Group name";
                    font-size: 11px;
                    color: Theme.text-dim;
                }

                LineEdit {
                    height: 30px;
                    text: GroupStepsState.name;
                    placeholder-text: "e.g. Cell reconstruction";
                    font-size: 12px;
                    edited(t) => {
                        GroupStepsState.name = t;
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;
                RangeRow {
                    label: "From";
                    model: GroupStepsState.step-names;
                    current: GroupStepsState.from-step;
                    picked(i) => {
                        GroupStepsState.range-changed(i, GroupStepsState.to-step);
                    }
                }

                RangeRow {
                    label: "To";
                    model: GroupStepsState.step-names;
                    current: GroupStepsState.to-step;
                    picked(i) => {
                        GroupStepsState.range-changed(GroupStepsState.from-step, i);
                    }
                }
            }

            if GroupStepsState.classes.length > 0: VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Classes";
                    font-size: 11px;
                    color: Theme.text-dim;
                }

                for row[i] in GroupStepsState.classes: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: row.name;
                            font-size: 12px;
                            color: Theme.text;
                        }

                        Text {
                            text: row.detail;
                            font-size: 10px;
                            color: Theme.text-mute;
                        }
                    }

                    ComboBox {
                        width: 190px;
                        model: ["Internal (group only)", "Group parameter", "Fixed"];
                        current-index: row.role;
                        selected(v) => {
                            GroupStepsState.role-changed(i, self.current-index);
                        }
                    }
                }

                Text {
                    text: "Internal classes are the group's own: each use of the group has its own, and their objects don't reach the results.";
                    font-size: 10px;
                    color: Theme.text-mute;
                    wrap: word-wrap;
                }
            }

            if GroupStepsState.channels-text != "": Text {
                text: GroupStepsState.channels-text;
                font-size: 11px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }

            if GroupStepsState.error != "": Text {
                text: GroupStepsState.error;
                font-size: 11px;
                color: Theme.err;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                AppButton {
                    text: "Cancel";
                    clicked => {
                        GroupStepsState.cancel();
                    }
                }

                AppButton {
                    text: "Create group";
                    primary: true;
                    clicked => {
                        GroupStepsState.confirm();
                    }
                }
            }
        }

        height: layout.preferred-height;
    }
}

// -- "Edit for all" or "Only this step" -------------------------

/// Asked when opening a group that other steps use too.
export global GroupEditChoiceState {
    in property <int> pipeline-id: 0;
    in property <int> step-idx: 0;
    in property <string> group-name: "";
    in property <int> uses: 0;
    callback edit-all();
    callback only-this();
    callback cancel();
}

export component GroupEditChoiceDialog inherits Rectangle {
    background: Theme.modal-overlay;

    TouchArea {
        clicked => {
            GroupEditChoiceState.cancel();
        }
    }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        background: Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 12px;
        clip: true;

        TouchArea { }

        layout := VerticalLayout {
            padding: 24px;
            spacing: 14px;

            Text {
                text: "Open \{GroupEditChoiceState.group-name}";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
            }

            Text {
                text: "This group is used by \{GroupEditChoiceState.uses} steps. Changes to it apply to all of them - or make a copy just for this step.";
                font-size: 11px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                AppButton {
                    text: "Cancel";
                    clicked => {
                        GroupEditChoiceState.cancel();
                    }
                }

                AppButton {
                    text: "Only this step";
                    clicked => {
                        GroupEditChoiceState.only-this();
                    }
                }

                AppButton {
                    text: "Edit for all";
                    primary: true;
                    clicked => {
                        GroupEditChoiceState.edit-all();
                    }
                }
            }
        }

        height: layout.preferred-height;
    }
}

// -- Expose a setting: a new parameter, or one that exists -------

/// Asked when exposing a setting that existing group parameters could set
/// too (same kind of setting).
export global ExposeChoiceState {
    in property <string> setting-name: "";
    /// "New parameter", then "Add to “Cell class”", ...
    in property <[string]> choices: [];
    callback chosen(int);
    callback cancel();
}

export component ExposeChoiceDialog inherits Rectangle {
    background: Theme.modal-overlay;

    TouchArea {
        clicked => {
            ExposeChoiceState.cancel();
        }
    }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 380px;
        background: Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 12px;
        clip: true;

        TouchArea { }

        layout := VerticalLayout {
            padding: 24px;
            spacing: 10px;

            Text {
                text: "Expose \{ExposeChoiceState.setting-name}";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
            }

            Text {
                text: "As a parameter of its own, or set by a parameter the group has already:";
                font-size: 11px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }

            for choice[i] in ExposeChoiceState.choices: AppButton {
                text: choice;
                primary: i == 0;
                clicked => {
                    ExposeChoiceState.chosen(i);
                }
            }

            HorizontalLayout {
                alignment: end;
                AppButton {
                    text: "Cancel";
                    clicked => {
                        ExposeChoiceState.cancel();
                    }
                }
            }
        }

        height: layout.preferred-height;
    }
}

// -- Update a group from the library -------------------------------

export global GroupUpdateState {
    in property <string> group-name: "";
    /// "v1 → v3"
    in property <string> versions: "";
    /// The project changed the group since it was inserted - the update
    /// replaces those changes.
    in property <bool> changed-here: false;
    callback confirm();
    callback cancel();
}

export component GroupUpdateDialog inherits Rectangle {
    background: Theme.modal-overlay;

    TouchArea {
        clicked => {
            GroupUpdateState.cancel();
        }
    }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        background: Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 12px;
        clip: true;

        TouchArea { }

        layout := VerticalLayout {
            padding: 24px;
            spacing: 12px;

            Text {
                text: "Update \{GroupUpdateState.group-name}";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
            }

            Text {
                text: "The group library has a newer version (\{GroupUpdateState.versions}). Every step using the group gets it; their values stay.";
                font-size: 11px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }

            if GroupUpdateState.changed-here: Text {
                text: "This project changed the group since it was inserted - updating replaces those changes.";
                font-size: 11px;
                color: Theme.warn;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                AppButton {
                    text: "Cancel";
                    clicked => {
                        GroupUpdateState.cancel();
                    }
                }

                AppButton {
                    text: "Update";
                    primary: true;
                    clicked => {
                        GroupUpdateState.confirm();
                    }
                }
            }
        }

        height: layout.preferred-height;
    }
}

// -- Group settings ------------------------------------------------

/// A parameter of the group, as it shows on the group card.
export struct GroupParamRow {
    // The parameter's key ("min_size").
    key: string,
    label: string,
    description: string,
    /// The default value, as text.
    default-value: string,
    /// The help text of the setting it's bound to - shown while
    /// `description` is empty.
    default-description: string,
    /// What it sets: "Blur › Kernel size, Blur › Kernel size".
    sets: string,
    /// The section it's shown in on the group card; empty: none.
    section: string,
}

/// The opened group's name, descriptions and parameters (name, help text,
/// order). Opened from "Settings…" in the bar of a group opened to edit, or
/// from ✎ on an exposed setting (`focus-index` is then that parameter's
/// row).
export global GroupSettingsState {
    in property <string> name: "";
    /// One line, shown in the command picker.
    in property <string> description: "";
    /// The full description, shown with the short one behind the group
    /// card's "?".
    in property <string> long-description: "";
    /// The first author - shown in the command picker.
    in property <string> author-name: "";
    in property <string> author-organization: "";
    in property <[GroupParamRow]> parameters: [];
    /// The row to scroll to and highlight, or -1.
    in property <int> focus-index: -1;
    callback name-edited(string);
    callback description-edited(string);
    callback long-description-edited(string);
    /// name, organization
    callback author-edited(string, string);
    /// key, name - the help text stays (the rows aren't refreshed while
    /// typing, so passing both would undo the other field's edit).
    callback parameter-name-edited(string, string);
    /// key, help text
    callback parameter-help-edited(string, string);
    /// key, section on the group card (empty: none)
    callback parameter-section-edited(string, string);
    /// key, -1 up / +1 down
    callback parameter-moved(string, int);
    /// key: back to the bound setting's own help text.
    callback parameter-help-reset(string);
    /// key: stop exposing it - its settings go back to the group's values.
    callback parameter-removed(string);
    callback close();
}

export component GroupSettingsDialog inherits Rectangle {
    background: Theme.modal-overlay;
    property <length> row-height: 190px;
    property <length> row-spacing: 8px;

    TouchArea {
        clicked => {
            GroupSettingsState.close();
        }
    }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 520px;
        background: Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 12px;
        clip: true;

        TouchArea { }

        layout := VerticalLayout {
            padding: 24px;
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Group settings";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                }

                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    background: close-ta.has-hover ? Theme.raised : transparent;
                    Text {
                        text: "✕";
                        font-size: 12px;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            GroupSettingsState.close();
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 5px;
                Text {
                    text: "Name";
                    font-size: 11px;
                    color: Theme.text-dim;
                }

                LineEdit {
                    text: GroupSettingsState.name;
                    placeholder-text: "Group name";
                    edited(t) => {
                        GroupSettingsState.name-edited(t);
                    }
                }
            }

            VerticalLayout {
                spacing: 5px;
                Text {
                    text: "Short description (one line, shown in the command picker)";
                    font-size: 11px;
                    color: Theme.text-dim;
                }

                LineEdit {
                    text: GroupSettingsState.description;
                    placeholder-text: "What the group does";
                    edited(t) => {
                        GroupSettingsState.description-edited(t);
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    spacing: 5px;
                    Text {
                        text: "Author";
                        font-size: 11px;
                        color: Theme.text-dim;
                    }

                    author-name-edit := LineEdit {
                        text: GroupSettingsState.author-name;
                        placeholder-text: "Full name";
                        edited(t) => {
                            GroupSettingsState.author-edited(t, author-organization-edit.text);
                        }
                    }
                }

                VerticalLayout {
                    spacing: 5px;
                    Text {
                        text: "Organization";
                        font-size: 11px;
                        color: Theme.text-dim;
                    }

                    author-organization-edit := LineEdit {
                        text: GroupSettingsState.author-organization;
                        placeholder-text: "Lab, institute, company";
                        edited(t) => {
                            GroupSettingsState.author-edited(author-name-edit.text, t);
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 5px;
                Text {
                    text: "Description (shown behind the group card's ?)";
                    font-size: 11px;
                    color: Theme.text-dim;
                }

                TextEdit {
                    height: 72px;
                    text: GroupSettingsState.long-description;
                    wrap: word-wrap;
                    placeholder-text: "How to use it, what it expects, references…";
                    edited(t) => {
                        GroupSettingsState.long-description-edited(t);
                    }
                }
            }

            Text {
                text: GroupSettingsState.parameters.length == 0 ? "No parameters yet - ◇ next to a setting of the opened group exposes it on the group card." : "Parameters on the group card, in this order";
                font-size: 11px;
                font-weight: 600;
                color: Theme.cat-group;
                wrap: word-wrap;
            }

            // Rows have a fixed height, so the scroll position of the
            // focused one is known before the list is laid out.
            if GroupSettingsState.parameters.length > 0: list := ScrollView {
                property <length> pitch: root.row-height + root.row-spacing;
                property <length> total: GroupSettingsState.parameters.length * self.pitch - root.row-spacing;
                // Shrinks (down to about one row) when the window is small.
                min-height: min(self.total, root.row-height);
                preferred-height: min(self.total, 440px);
                vertical-stretch: 1;
                vertical-scrollbar-policy: always-on;
                init => {
                    if GroupSettingsState.focus-index > 0 {
                        self.content-y = max(-GroupSettingsState.focus-index * self.pitch, min(0px, self.height - self.total));
                    }
                }

                VerticalLayout {
                    spacing: root.row-spacing;
                    for param[pi] in GroupSettingsState.parameters: Rectangle {
                        height: root.row-height;
                        clip: true;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: pi == GroupSettingsState.focus-index ? Theme.cat-group : Theme.border;
                        background: Theme.raised.with-alpha(0.4);

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text: param.label;
                                                    placeholder-text: "Name on the group card";
                                    accessible-label: "Parameter name";
                                    edited(t) => {
                                        GroupSettingsState.parameter-name-edited(param.key, t);
                                    }
                                }

                                Text {
                                    text: "default \{param.default-value}";
                                    font-size: 10px;
                                    color: Theme.text-mute;
                                    vertical-alignment: center;
                                }

                                HorizontalLayout {
                                    spacing: 2px;
                                    Rectangle {
                                        width: 24px;
                                        opacity: pi > 0 ? 1 : 0.3;
                                        border-radius: 4px;
                                        background: up-ta.has-hover && pi > 0 ? Theme.raised : transparent;
                                        Text {
                                            text: "↑";
                                            color: Theme.text-dim;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        up-ta := TouchArea {
                                            enabled: pi > 0;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                GroupSettingsState.parameter-moved(param.key, -1);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 24px;
                                        opacity: pi < GroupSettingsState.parameters.length - 1 ? 1 : 0.3;
                                        border-radius: 4px;
                                        background: down-ta.has-hover && pi < GroupSettingsState.parameters.length - 1 ? Theme.raised : transparent;
                                        Text {
                                            text: "↓";
                                            color: Theme.text-dim;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        down-ta := TouchArea {
                                            enabled: pi < GroupSettingsState.parameters.length - 1;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                GroupSettingsState.parameter-moved(param.key, 1);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 24px;
                                        border-radius: 4px;
                                        background: remove-ta.has-hover ? Theme.raised : transparent;
                                        Text {
                                            text: "✕";
                                            font-size: 11px;
                                            color: remove-ta.has-hover ? Theme.warn : Theme.text-dim;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        remove-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                GroupSettingsState.parameter-removed(param.key);
                                            }
                                        }
                                    }
                                }
                            }

                            TextEdit {
                                height: 46px;
                                text: param.description;
                                            wrap: word-wrap;
                                placeholder-text: "Help text, shown as ? next to the parameter";
                                accessible-label: "Parameter help text";
                                edited(t) => {
                                    GroupSettingsState.parameter-help-edited(param.key, t);
                                }
                            }

                            LineEdit {
                                text: param.section;
                                placeholder-text: "Section on the group card (optional), e.g. Detection";
                                accessible-label: "Parameter section";
                                edited(t) => {
                                    GroupSettingsState.parameter-section-edited(param.key, t);
                                }
                            }

                            Text {
                                text: "sets \{param.sets}";
                                font-size: 10px;
                                color: Theme.text-mute;
                                overflow: elide;
                            }

                            // Which help the "?" shows: the setting's own while
                            // there's none, else "Reset" back to it.
                            HorizontalLayout {
                                height: 18px;
                                spacing: 6px;
                                if param.description == "": Text {
                                    horizontal-stretch: 1;
                                    text: param.default-description == "" ? "No help text" : "Setting's own help: \{param.default-description}";
                                    font-size: 10px;
                                    color: Theme.text-mute;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                // Back to the setting's own help text.
                                if param.description != "": Rectangle {
                                    horizontal-stretch: 0;
                                    width: reset-text.preferred-width + 12px;
                                    height: 18px;
                                    border-radius: 4px;
                                    background: reset-ta.has-hover ? Theme.raised : transparent;
                                    reset-text := Text {
                                        text: "Reset to the setting's own help";
                                        font-size: 10px;
                                        color: Theme.text-dim;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    reset-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            GroupSettingsState.parameter-help-reset(param.key);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                AppButton {
                    text: "Close";
                    primary: true;
                    clicked => {
                        GroupSettingsState.close();
                    }
                }
            }
        }

        height: min(layout.preferred-height, root.height - 40px);
    }
}
