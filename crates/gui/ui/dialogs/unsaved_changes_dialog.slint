import { DialogType, GlobalAppState, UnsavedChangesState } from "../api/state.slint";
import { Dialog, DialogFooter, DialogTone } from "../components/new_components/dialog.slint";

import { AppButton } from "../components/app_button.slint";
import { Theme } from "../style.slint";

export component UnsavedChangesDialog inherits Dialog {
    title: "Unsaved changes";
    dialog-width: 440px;
    tone: DialogTone.warning;
    close => {
        GlobalAppState.active-dialog = DialogType.none;
        UnsavedChangesState.cancel();
    }

    VerticalLayout {
        spacing: 12px;
        Text {
            text: "This project has unsaved changes. Do you want to save them before continuing?";
            wrap: word-wrap;
            color: Theme.text;
            font-size: 13px;
        }

        DialogFooter {

            AppButton {
                text: "Cancel";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    UnsavedChangesState.cancel();
                }
            }

            AppButton {
                text: "Discard changes";
                danger: true;
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    UnsavedChangesState.discard();
                }
            }

            AppButton {
                text: "Save";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    UnsavedChangesState.save();
                }
            }
        }
    }
}
