import { InkButton, InkButtonKind, InkDialog, InkDialogFooter } from "../ink/ink.slint";
import { DialogType, GlobalAppState, UnsavedChangesState } from "../api/state.slint";

import { Ink } from "../ink/palette.slint";

export component UnsavedChangesDialog inherits InkDialog {
    // In the middle, a third down.
    anchor-y: root.height / 3;
    title: "Unsaved changes";
    card-width: 440px;
    close => {
        GlobalAppState.active-dialog = DialogType.none;
        UnsavedChangesState.cancel();
    }

    VerticalLayout {
        spacing: 12px;
        Text {
            text: "This project has unsaved changes. Do you want to save them before continuing?";
            wrap: word-wrap;
            color: Ink.text;
            font-size: Ink.fs-heading;
        }

        InkDialogFooter {

            InkButton {
                text: "Cancel";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    UnsavedChangesState.cancel();
                }
            }

            InkButton {
                kind: InkButtonKind.danger;
                text: "Discard changes";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    UnsavedChangesState.discard();
                }
            }

            InkButton {
                text: "Save";
                clicked => {
                    GlobalAppState.active-dialog = DialogType.none;
                    UnsavedChangesState.save();
                }
            }
        }
    }
}
