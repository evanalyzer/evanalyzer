import { InkButton, InkButtonKind, InkDialog, InkDialogFooter, InkDialogPlacement, InkDivider } from "../ink/ink.slint";
import { DialogType, GlobalAppState } from "../api/state.slint";
import { ProjectSettingsState, ViewportMemoryState } from "../api/project_settings.slint";
import { ScrollView } from "std-widgets.slint";
import { LineEdit, ComboBox, SpinBox, Switch } from "../ink/std_compat.slint";

import { Ink } from "../ink/palette.slint";
import { MultiClassDropdown } from "../editor/pipelines_panel.slint";
import { InkSettingsCard, InkSettingRow, InkSettingBlock, InkSearchField, InkCaption, InkIcons } from "../ink/ink.slint";
// A section's head: its title, a short summary, ▸ / ▾ - a click opens or
// closes it.
component SectionToggle inherits Rectangle {
    in property <string> title;
    in property <string> summary;
    in property <bool> open;
    callback toggled;

    height: 36px;
    border-radius: Ink.radius-md;
    background: ta.has-hover ? Ink.hover : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-expanded: root.open;
    accessible-expandable: true;
    accessible-action-default => {
        root.toggled();
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 8px;
        Image {
            y: (parent.height - self.height) / 2;
            source: root.open ? InkIcons.caret-down : InkIcons.caret-right;
            width: 10px;
            height: 10px;
            colorize: Ink.text-mute;
        }
        Text {
            text: root.title;
            font-size: Ink.fs-body;
            font-weight: 600;
            color: Ink.text;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.summary;
            font-size: Ink.fs-secondary;
            color: Ink.text-mute;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// -- Dialog --------------------------------------------------------------------

// All settings in one place: the project's (saved with the project) and this
// computer's (viewport memory). A section list on the left, or - while
// searching - every matching setting of all sections.
export component ProjectSettingsDialog inherits InkDialog {
    // Docked on the right; the image stays usable.
    placement: InkDialogPlacement.sheet;
    title: "Settings";
    card-width: 440px;
    content-padding: 0px;
    close => {
        root.cancel();
    }
    private property <length> well_size: (ProjectSettingsState.settings.well_rows > 5 || ProjectSettingsState.settings.well_columns > 5) ? 30px : 45px;

    // Sections: 0 General, 1 Plate & grouping, 2 Object merging, 3 Viewport -
    // each opened or closed by its head.
    property <bool> open-0: true;
    property <bool> open-1: false;
    property <bool> open-2: false;
    property <bool> open-3: false;
    property <string> query;
    property <bool> searching: root.query.replace-all(" ", "") != "";

    // Words each setting is found by (its name, explanation and synonyms).
    property <string> kw-name: "Project name title identification";
    property <string> kw-author: "Author name person user identification";
    property <string> kw-org: "Organization organisation university company institute lab identification";
    property <string> kw-grouping: "Grouping group images into wells file name auto custom regex folder";
    property <string> kw-regex: "Regex regular expression grouping file name pattern";
    property <string> kw-plate: "Plate size wells 6 12 24 48 96 384 1536";
    property <string> kw-well-size: "Well size images per well rows columns auto custom";
    property <string> kw-well-images: "Images in well order position layout rows columns";
    property <string> kw-merge: "Merge objects split across tile boundaries cross-tile whole slide stitching";
    property <string> kw-exclude: "Exclude classes from merging object classes";
    property <string> kw-connectivity: "Connectivity 4-connected 8-connected neighbours neighbors diagonal merging";
    property <string> kw-fragments: "Max maximum fragments per group merging limit";
    property <string> kw-masks: "Keep object outlines masks in the results split view database file size";
    property <string> kw-history: "Keep earlier high-resolution renders tile history ghost overview memory RAM whole slide zoom pan performance";
    property <string> kw-budget: "Memory for earlier renders budget MB megabytes RAM tile history performance";
    property <string> kw-margin: "Object overlay margin pixels border pan memory RAM performance";
    property <string> kw-cache-auto: "Size caches automatically from RAM tile overview cache memory MB";
    property <string> kw-tile-cache: "Tile cache image tiles read from disk memory RAM MB megabytes performance";
    property <string> kw-preview-tiles: "Preview tiles maximum whole slide zoom live preview automatic RAM";
    property <string> kw-breakpoint-tiles: "Breakpoint tiles image compare memory RAM automatic";
    property <string> kw-renderer: "Draw in software renderer graphics card GPU driver virtual machine remote desktop RAM";
    property <string> kw-overview-cache: "Overview cache whole image overviews switching images memory RAM MB megabytes performance";
    property <string> kw-free-caches: "Free caches when an analysis starts release memory RAM analysis run";
    property <string> kw-objects-table: "Objects as a table list default view bottom";
    property <string> kw-reduce-motion: "Reduce motion animation fly move accessibility";
    property <string> kw-auto-scale: "Auto-scale new images histogram open first time brightness contrast";
    property <string> kw-channel-colors: "Color channels without wavelength emission colour white open image";

    // Whether `words` contain the search text (ignoring case).
    pure function matches(words: string) -> bool {
        words.to-lowercase().replace-all(root.query.to-lowercase(), "") != words.to-lowercase()
    }

    // Section `section` is open (searching: all are).
    pure function is-open(section: int) -> bool {
        root.searching || (section == 0 ? root.open-0 : section == 1 ? root.open-1 : section == 2 ? root.open-2 : root.open-3)
    }

    function toggle(section: int) {
        if section == 0 {
            root.open-0 = !root.open-0;
        } else if section == 1 {
            root.open-1 = !root.open-1;
        } else if section == 2 {
            root.open-2 = !root.open-2;
        } else {
            root.open-3 = !root.open-3;
        }
    }

    // Whether a setting of `section` found by `words` is shown.
    pure function shows(section: int, words: string) -> bool {
        root.searching ? root.matches(words) : root.is-open(section)
    }

    // Whether anything of `section` matches the search.
    pure function section-matches(section: int) -> bool {
        section == 0 ? (root.matches(root.kw-name) || root.matches(root.kw-author) || root.matches(root.kw-org))
        : section == 1 ? (root.matches(root.kw-grouping) || (ProjectSettingsState.settings.grouping_mode == 1 && root.matches(root.kw-regex)) || root.matches(root.kw-plate) || root.matches(root.kw-well-size) || (!ProjectSettingsState.settings.well_auto && root.matches(root.kw-well-images)))
        : section == 2 ? (root.matches(root.kw-merge) || root.matches(root.kw-masks) || (ProjectSettingsState.settings.tile_merge_enabled && (root.matches(root.kw-exclude) || root.matches(root.kw-connectivity) || root.matches(root.kw-fragments))))
        : (root.matches(root.kw-history) || root.matches(root.kw-budget) || root.matches(root.kw-margin) || root.matches(root.kw-cache-auto) || root.matches(root.kw-tile-cache) || root.matches(root.kw-overview-cache) || root.matches(root.kw-preview-tiles) || root.matches(root.kw-breakpoint-tiles) || root.matches(root.kw-renderer) || root.matches(root.kw-free-caches) || root.matches(root.kw-objects-table) || root.matches(root.kw-reduce-motion) || root.matches(root.kw-auto-scale) || root.matches(root.kw-channel-colors))
    }

    pure function shows-section(section: int) -> bool {
        root.searching ? root.section-matches(section) : true
    }

    function cancel() {
        ProjectSettingsState.project_settings_canceled();
        GlobalAppState.active-dialog = DialogType.none;
    }

    init => {
        ViewportMemoryState.load();
        search-input.focus-input();
    }

    Rectangle {
        vertical-stretch: 1;

        VerticalLayout {
            spacing: 0;

            // The search, up in the head: Settings | search | ✕ (design O).
            Rectangle {
                height: 0px;
                search-input := InkSearchField {
                    x: 84px;
                    y: (Ink.head-h - self.height) / 2 - Ink.head-h;
                    width: parent.width - self.x - 44px;
                    placeholder: "Search settings";
                    text: root.query;
                    edited(t) => {
                        root.query = t;
                    }
                }
            }

            VerticalLayout {
                vertical-stretch: 1;
                spacing: 0;

                // -- Settings ------------------------------------------------
                Rectangle {
                    horizontal-stretch: 1;

                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            padding: Ink.pad-dialog;
                            padding-top: 10px;
                            spacing: 12px;

                            if root.searching && !root.section-matches(0) && !root.section-matches(1) && !root.section-matches(2) && !root.section-matches(3): VerticalLayout {
                                padding-top: 60px;
                                spacing: 6px;
                                Text {
                                    text: "No settings match “" + root.query + "”";
                                    font-size: Ink.fs-heading;
                                    font-weight: 600;
                                    color: Ink.text;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Try another word, e.g. “plate”, “merge” or “memory”.";
                                    font-size: Ink.fs-secondary;
                                    color: Ink.text-dim;
                                    horizontal-alignment: center;
                                }
                            }

                            // -- General -----------------------------------
                            InkCaption {
                                text: "PROJECT";
                            }
                            if root.shows-section(0): VerticalLayout {
                                spacing: 14px;
                                SectionToggle {
                                    title: "General";
                                    summary: "Who made this project - stored with it and shown when it is cited.";
                                    open: root.is-open(0);
                                    toggled => {
                                        root.toggle(0);
                                    }
                                }

                                if root.is-open(0): InkSettingsCard {
                                    if root.shows(0, root.kw-name): InkSettingRow {
                                        control-width: 168px;
                                        label: "Project name";
                                        LineEdit {
                                            placeholder-text: "Enter project name…";
                                            text <=> ProjectSettingsState.settings.project_name;
                                        }
                                    }
                                    if root.shows(0, root.kw-author): InkSettingRow {
                                        control-width: 168px;
                                        label: "Author";
                                        LineEdit {
                                            placeholder-text: "Charles Darwin";
                                            text <=> ProjectSettingsState.settings.author_name;
                                        }
                                    }
                                    if root.shows(0, root.kw-org): InkSettingRow {
                                        control-width: 168px;
                                        label: "Organization";
                                        LineEdit {
                                            placeholder-text: "University / Company";
                                            text <=> ProjectSettingsState.settings.organization_name;
                                        }
                                    }
                                }
                            }

                            // -- Plate & grouping --------------------------
                            if root.shows-section(1): VerticalLayout {
                                spacing: 14px;
                                SectionToggle {
                                    title: "Plate & grouping";
                                    summary: "How images are grouped into wells and how the plate is laid out in the results.";
                                    open: root.is-open(1);
                                    toggled => {
                                        root.toggle(1);
                                    }
                                }

                                if root.is-open(1): InkSettingsCard {
                                    if root.shows(1, root.kw-grouping): InkSettingRow {
                                        control-width: 168px;
                                        label: "Grouping";
                                        description: "How the well of an image is found.";
                                        ComboBox {
                                            model: [
                                                "Auto (from the file name)",
                                                "Custom regex",
                                                "Folder [well/image_01.tif]"
                                            ];
                                            current-index <=> ProjectSettingsState.settings.grouping_mode;
                                        }
                                    }
                                    if ProjectSettingsState.settings.grouping_mode == 1 && root.shows(1, root.kw-regex): InkSettingRow {
                                        control-width: 168px;
                                        label: "Regex";
                                        description: "Applied to the file name to find the well.";
                                        LineEdit {
                                            placeholder-text: "^(([A-H])([0-9]+))_([0-9]+)";
                                            text <=> ProjectSettingsState.settings.custom_regex;
                                        }
                                    }
                                    if root.shows(1, root.kw-plate): InkSettingRow {
                                        control-width: 168px;
                                        label: "Plate size";
                                        description: "The same choice as the results window's plate size.";
                                        ComboBox {
                                            model: ProjectSettingsState.plate-size-labels;
                                            current-index <=> ProjectSettingsState.settings.plate_size_index;
                                        }
                                    }
                                    if root.shows(1, root.kw-well-size): InkSettingRow {
                                        control-width: 168px;
                                        label: "Well size";
                                        description: ProjectSettingsState.settings.well_auto ? "Rows and columns of images in a well, fitted to the images." : "Rows × columns of images in a well.";
                                        VerticalLayout {
                                            spacing: 8px;
                                            ComboBox {
                                                model: ["Auto (fitted to the images)", "Custom"];
                                                current-index: ProjectSettingsState.settings.well_auto ? 0 : 1;
                                                selected => {
                                                    ProjectSettingsState.settings.well_auto = self.current-index == 0;
                                                }
                                            }

                                            // Stacked: two SpinBoxes (min. 128px each)
                                            // don't fit the control column side by side.
                                            if !ProjectSettingsState.settings.well_auto: HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: "Rows";
                                                    width: 56px;
                                                    font-size: Ink.fs-secondary;
                                                    color: Ink.text-dim;
                                                    vertical-alignment: center;
                                                }

                                                SpinBox {
                                                    value: ProjectSettingsState.settings.well_rows;
                                                    minimum: 1;
                                                    maximum: 8;
                                                    edited => {
                                                        ProjectSettingsState.settings.well_rows = self.value;
                                                        ProjectSettingsState.well_dims_changed(self.value, ProjectSettingsState.settings.well_columns);
                                                    }
                                                }
                                            }

                                            if !ProjectSettingsState.settings.well_auto: HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: "Columns";
                                                    width: 56px;
                                                    font-size: Ink.fs-secondary;
                                                    color: Ink.text-dim;
                                                    vertical-alignment: center;
                                                }

                                                SpinBox {
                                                    value: ProjectSettingsState.settings.well_columns;
                                                    minimum: 1;
                                                    maximum: 8;
                                                    edited => {
                                                        ProjectSettingsState.settings.well_columns = self.value;
                                                        ProjectSettingsState.well_dims_changed(ProjectSettingsState.settings.well_rows, self.value);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if !ProjectSettingsState.settings.well_auto && root.shows(1, root.kw-well-images): InkSettingBlock {
                                        label: "Images in well";
                                        description: "Which image number is shown at each position of the well (press Enter to confirm a change).";
                                        HorizontalLayout {
                                            alignment: start;
                                            GridLayout {
                                                spacing: 2px;
                                                for val[i] in ProjectSettingsState.settings.well_values: Rectangle {
                                                    row: i / ProjectSettingsState.settings.well_columns;
                                                    col: mod(i, ProjectSettingsState.settings.well_columns);
                                                    width: root.well_size;
                                                    height: root.well_size * 0.8;
                                                    background: Ink.ground;
                                                    border-width: 1px;
                                                    border-color: Ink.border-soft;
                                                    border-radius: 3px;

                                                    TextInput {
                                                        text: val;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        width: 100%;
                                                        height: 100%;
                                                        color: Ink.text;
                                                        font-size: Ink.fs-secondary;
                                                        accepted => {
                                                            ProjectSettingsState.well_value_changed(i, round(self.text.to-float()));
                                                        }
                                                        edited => {
                                                            ProjectSettingsState.well_value_changed(i, round(self.text.to-float()));
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // -- Object merging ----------------------------
                            if root.shows-section(2): VerticalLayout {
                                spacing: 14px;
                                SectionToggle {
                                    title: "Objects";
                                    summary: "Reassembles objects split across an internal tile boundary (e.g. a whole organ on a whole slide image) into one object - every object class merges unless excluded - and what the results keep of them.";
                                    open: root.is-open(2);
                                    toggled => {
                                        root.toggle(2);
                                    }
                                }

                                if root.is-open(2): InkSettingsCard {
                                    if root.shows(2, root.kw-merge): InkSettingRow {
                                        control-width: 168px;
                                        label: "Merge objects across tiles";
                                        description: "Off: objects are exported per tile, as found.";
                                        HorizontalLayout {
                                            alignment: end;
                                            Switch {
                                                checked <=> ProjectSettingsState.settings.tile_merge_enabled;
                                            }
                                        }
                                    }
                                    if ProjectSettingsState.settings.tile_merge_enabled && root.shows(2, root.kw-exclude): InkSettingRow {
                                        control-width: 168px;
                                        label: "Exclude classes";
                                        description: "Classes whose objects are never merged.";
                                        MultiClassDropdown {
                                            is-seg: false;
                                            value: "excluded-classes";
                                            selection-flags: ProjectSettingsState.settings.tile_merge_classes_to_not_merge_flags;
                                            changed(v) => {
                                                ProjectSettingsState.tile_merge_class_toggled(v);
                                            }
                                        }
                                    }
                                    if ProjectSettingsState.settings.tile_merge_enabled && root.shows(2, root.kw-connectivity): InkSettingRow {
                                        control-width: 168px;
                                        label: "Connectivity";
                                        description: "8-connected also joins pieces touching only diagonally.";
                                        ComboBox {
                                            model: ["4-connected", "8-connected"];
                                            current-index <=> ProjectSettingsState.settings.tile_merge_connectivity;
                                        }
                                    }
                                    if ProjectSettingsState.settings.tile_merge_enabled && root.shows(2, root.kw-fragments): InkSettingRow {
                                        control-width: 168px;
                                        label: "Max fragments per group";
                                        description: "Upper limit of pieces joined into one object.";
                                        SpinBox {
                                            value: ProjectSettingsState.settings.tile_merge_max_fragments_per_group;
                                            minimum: 1;
                                            maximum: 1000000;
                                            edited => {
                                                ProjectSettingsState.settings.tile_merge_max_fragments_per_group = self.value;
                                            }
                                        }
                                    }
                                    if root.shows(2, root.kw-masks): InkSettingRow {
                                        control-width: 168px;
                                        label: "Keep object outlines in the results";
                                        description: "Shown in Results' split view. Off: a smaller results file, objects drawn as ellipses there.";
                                        HorizontalLayout {
                                            alignment: end;
                                            Switch {
                                                checked <=> ProjectSettingsState.settings.store_object_masks;
                                            }
                                        }
                                    }
                                }
                            }

                            // -- Viewport ----------------------------------
                            InkCaption {
                                text: "THIS COMPUTER";
                            }
                            if root.shows-section(3): VerticalLayout {
                                spacing: 14px;
                                SectionToggle {
                                    title: "Viewport";
                                    summary: "Memory the image viewport may use for smoother panning and zooming. Kept on this computer, for every project.";
                                    open: root.is-open(3);
                                    toggled => {
                                        root.toggle(3);
                                    }
                                }

                                if root.is-open(3): InkSettingsCard {
                                    if root.shows(3, root.kw-history): InkSettingRow {
                                        control-width: 168px;
                                        label: "Keep earlier high-resolution renders";
                                        description: "Panning back or zooming shows the sharp earlier renders instead of the blurry overview - most useful for whole slide images. Off: only the current render and one overview are kept (least RAM).";
                                        HorizontalLayout {
                                            alignment: end;
                                            Switch {
                                                checked <=> ViewportMemoryState.tile_history_enabled;
                                            }
                                        }
                                    }
                                    if root.shows(3, root.kw-budget): InkSettingRow {
                                        control-width: 168px;
                                        label: "Memory for earlier renders";
                                        description: "In MB. The graphics card holds about as much again.";
                                        enabled: ViewportMemoryState.tile_history_enabled;
                                        SpinBox {
                                            enabled: ViewportMemoryState.tile_history_enabled;
                                            minimum: 64;
                                            maximum: 16384;
                                            step-size: 64;
                                            value <=> ViewportMemoryState.tile_history_budget_mb;
                                        }
                                    }
                                    if root.shows(3, root.kw-margin): InkSettingRow {
                                        control-width: 168px;
                                        label: "Object overlay margin";
                                        description: "In pixels: how far objects are drawn past the visible area, so panning doesn't uncover an empty border. 0 uses the least RAM; objects at a newly uncovered edge then appear once you stop moving.";
                                        SpinBox {
                                            minimum: 0;
                                            maximum: 2048;
                                            step-size: 64;
                                            value <=> ViewportMemoryState.object_overlay_margin_px;
                                        }
                                    }
                                    if root.shows(3, root.kw-cache-auto): InkSettingRow {
                                        control-width: 168px;
                                        label: "Size caches automatically";
                                        description: "From this computer's RAM - " + ViewportMemoryState.auto_cache_note + ". Off: use the sizes below.";
                                        HorizontalLayout {
                                            alignment: end;
                                            Switch {
                                                checked <=> ViewportMemoryState.cache_sizes_auto;
                                            }
                                        }
                                    }
                                    if root.shows(3, root.kw-tile-cache): InkSettingRow {
                                        control-width: 168px;
                                        enabled: !ViewportMemoryState.cache_sizes_auto;
                                        label: "Tile cache";
                                        description: "In MB: image tiles kept after reading, so panning back or returning to an image doesn't read them from disk again.";
                                        SpinBox {
                                            enabled: !ViewportMemoryState.cache_sizes_auto;
                                            minimum: 64;
                                            maximum: 65536;
                                            step-size: 128;
                                            value <=> ViewportMemoryState.tile_cache_mb;
                                        }
                                    }
                                    if root.shows(3, root.kw-overview-cache): InkSettingRow {
                                        control-width: 168px;
                                        enabled: !ViewportMemoryState.cache_sizes_auto;
                                        label: "Overview cache";
                                        description: "In MB: whole-image overviews kept, so switching between images shows them at once.";
                                        SpinBox {
                                            enabled: !ViewportMemoryState.cache_sizes_auto;
                                            minimum: 64;
                                            maximum: 16384;
                                            step-size: 64;
                                            value <=> ViewportMemoryState.overview_cache_mb;
                                        }
                                    }
                                    // Auto (from the RAM) or a number - one row each.
                                    if root.shows(3, root.kw-preview-tiles): InkSettingRow {
                                        control-width: 200px;
                                        label: "Preview tiles";
                                        description: "At most this many tiles in a preview - zoomed out further, zoom in first. Auto: one per 4 GB RAM of the computer running it (" + ViewportMemoryState.auto_preview_tiles_note + "; a server takes no more than its RAM allows).";
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: end;
                                            Switch {
                                                text: "Auto";
                                                checked <=> ViewportMemoryState.preview_tiles_auto;
                                            }
                                            SpinBox {
                                                width: 96px;
                                                enabled: !ViewportMemoryState.preview_tiles_auto;
                                                minimum: 1;
                                                maximum: 256;
                                                step-size: 1;
                                                value <=> ViewportMemoryState.preview_tiles;
                                            }
                                        }
                                    }
                                    if root.shows(3, root.kw-breakpoint-tiles): InkSettingRow {
                                        control-width: 200px;
                                        label: "Breakpoint tiles";
                                        description: "The visible tiles nearest the middle show their breakpoint image - each up to ~190 MB RAM while a breakpoint is set (freed when it is cleared or an analysis starts). Auto: as this computer's RAM allows (" + ViewportMemoryState.auto_breakpoint_tiles_note + ").";
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: end;
                                            Switch {
                                                text: "Auto";
                                                checked <=> ViewportMemoryState.breakpoint_tiles_auto;
                                            }
                                            SpinBox {
                                                width: 96px;
                                                enabled: !ViewportMemoryState.breakpoint_tiles_auto;
                                                minimum: 1;
                                                maximum: 64;
                                                step-size: 1;
                                                value <=> ViewportMemoryState.breakpoint_tiles;
                                            }
                                        }
                                    }
                                    if root.shows(3, root.kw-renderer): InkSettingRow {
                                        control-width: 168px;
                                        label: "Draw in software";
                                        description: "Without the graphics card: about 135 MB less RAM, and smoother on computers without a working graphics driver (virtual machines, remote desktop, older computers). Slower on very large screens. Takes effect after a restart.";
                                        HorizontalLayout {
                                            alignment: end;
                                            Switch {
                                                checked <=> ViewportMemoryState.software_renderer;
                                            }
                                        }
                                    }
                                    if root.shows(3, root.kw-free-caches): InkSettingRow {
                                        control-width: 168px;
                                        label: "Free caches when an analysis starts";
                                        description: "Gives a local analysis the RAM of both caches; they fill up again as you use the viewport.";
                                        HorizontalLayout {
                                            alignment: end;
                                            Switch {
                                                checked <=> ViewportMemoryState.free_caches_on_analysis;
                                            }
                                        }
                                    }
                                    if root.shows(3, root.kw-objects-table): InkSettingRow {
                                        control-width: 168px;
                                        label: "Objects as a table";
                                        description: "The objects open as a table below the image. Off: as a list in the right panel. Its ⋯ switches either way.";
                                        HorizontalLayout {
                                            alignment: end;
                                            Switch {
                                                checked <=> ViewportMemoryState.objects_as_table;
                                            }
                                        }
                                    }
                                    if root.shows(3, root.kw-auto-scale): InkSettingRow {
                                        control-width: 168px;
                                        label: "Auto-scale new images";
                                        description: "An image opened the first time is auto-scaled, every channel. Off: the full value range. The scaling is kept in the project either way.";
                                        HorizontalLayout {
                                            alignment: end;
                                            Switch {
                                                checked <=> ViewportMemoryState.auto_scale_new_images;
                                            }
                                        }
                                    }
                                    if root.shows(3, root.kw-channel-colors): InkSettingRow {
                                        control-width: 168px;
                                        label: "Color channels without a wavelength";
                                        description: "When an image opens, channels the file gives no emission wavelength get distinct colors (kept in the project as their wavelength). Off: white.";
                                        HorizontalLayout {
                                            alignment: end;
                                            Switch {
                                                checked <=> ViewportMemoryState.color_channels_without_wavelength;
                                            }
                                        }
                                    }
                                    if root.shows(3, root.kw-reduce-motion): InkSettingRow {
                                        control-width: 168px;
                                        label: "Reduce motion";
                                        description: "No animated moves: the results' split view jumps to an object instead of flying there.";
                                        HorizontalLayout {
                                            alignment: end;
                                            Switch {
                                                checked <=> ViewportMemoryState.reduce_motion;
                                            }
                                        }
                                    }
                                }

                                if !root.searching && root.open-3: HorizontalLayout {
                                    alignment: end;
                                    InkButton {
                                        small: true;
                                        text: "Reset to defaults";
                                        clicked => {
                                            ViewportMemoryState.reset_to_defaults();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // -- Footer ------------------------------------------------------
            InkDivider { }

            Rectangle {
                background: Ink.panel;

                // The dialog's buttons; this dialog pads its own content.
                HorizontalLayout {
                    alignment: end;
                    spacing: 6px;
                    padding-left: Ink.pad-dialog;
                    padding-right: Ink.pad-dialog;
                    padding-top: 10px;
                    padding-bottom: 10px;

                    Text {
                        text: "Project: saved with it. This computer: here.";
                        font-size: Ink.fs-body;
                        color: Ink.text-dim;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    InkButton {
                        text: "Cancel";
                        clicked => {
                            root.cancel();
                        }
                    }

                    InkButton {
                        kind: InkButtonKind.primary;
                        text: "Apply";
                        clicked => {
                            ProjectSettingsState.trigger_project_settings_accepted();
                            ViewportMemoryState.apply();
                            GlobalAppState.active-dialog = DialogType.none;
                        }
                    }
                }
            }
        }
    }
}
