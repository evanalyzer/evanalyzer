import { Places } from "../api/layout.slint";
// command_picker.slint
// EVAnalyzer - Add-Step (command selection) dialog.
//
// Opens when the user clicks "+ Add step" in the Pipelines panel, or any of
// the inline "+" insertion points between steps. Picks a single command from
// the library, configures nothing here (params are edited inline in the step
// row after insertion), and returns a category + algo-id to the host.
//
// Layout (1080 × 680, centered modal):
//
//   ┌------------------------------------------------------------------┐
//   │  Add step               After step 4 of "Nucleus pipeline"   ✕   │   ← header strip (44)
//   ├------------------------------------------------------------------┤
//   │  🔍  Search commands…                                            │   ← search
//   │                                                                  │
//   │  All · Preprocess · Segment · Instance Seg. · Measure · Object   │   ← filter chips (40)
//   ├----------------------------┬-------------------------------------┤
//   │ PREPROCESS  ---------------│   Gaussian Blur                     │
//   │ ƒ Gaussian Blur     σ ▸    │   ------------------------------    │
//   │ ƒ Median Filter            │   Smooth an image with an isotropic │
//   │ ƒ Background Subtract      │   Gaussian kernel. Reduces shot     │   ← list  +  detail
//   │ SEGMENT     ---------------│   noise before thresholding.        │     pane (split)
//   │ ƒ Threshold (Otsu)         │                                     │
//   │ ƒ Watershed                │   DEFAULT PARAMETERS                │
//   │ ƒ Cellpose            ★    │     σ              2.0  px          │
//   │ MEASURE     ---------------│     Per channel    on               │
//   │ ƒ Intensity Stats          │     Edge handling  reflect          │
//   │ ƒ Area & Perimeter         │                                     │
//   │                            │   Category   Preprocess             │
//   │                            │   Source     skimage · v0.22        │
//   ├----------------------------┴-------------------------------------┤
//   │  ↑↓ navigate    ↵ add    ⎋ cancel             [ Add to pipeline ]│   ← footer (52)
//   └------------------------------------------------------------------┘
//
// Host wires:
//   - commands           : [CommandDef]   - the full library
//   - recents / favorites: [int]          - ids of recently used / starred
//   - target-pipeline    : string         - name of the pipeline being edited
//   - insert-after-idx   : int            - 0-based slot; -1 means "append"
//   confirm(int)  →  insert this command id at (target-pipeline, insert-after-idx)
//   toggle-favorite(int), cancel().
import {
    InkSearchField,
    InkButton,
    InkButtonKind,
    InkDialog,
    InkDialogFooter,
    InkCaption,
    InkHint,
    InkDivider,
    InkDialogPlacement,
} from "../ink/ink.slint";
import { StepCategory } from "../api/pipelines.slint";
import { CommandDef, PickerStyle } from "../api/command_selection.slint";

import { ScrollView } from "std-widgets.slint";
import { Ink } from "../ink/palette.slint";

// ---------- Command library data ----------
// ---------- Command picker global state ----------
// ---------- Local visual constants ----------
// ---------- Filter chip ----------

// "Commands 36" / "Modules 5" above the search: the count turns into
// the hits (blue) while searching.
component PickerTab inherits Rectangle {
    in property <string> text;
    in property <int> count;
    in property <bool> active;
    in property <bool> searching;
    callback clicked;
    width: row.preferred-width;
    accessible-role: tab;
    accessible-label: root.text + " " + root.count;
    accessible-item-selected: root.active;
    accessible-action-default => {
        root.clicked();
    }
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        Text {
            text: root.text;
            font-size: Ink.fs-body;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Ink.text : Ink.text-dim;
            vertical-alignment: center;
        }

        Text {
            text: root.count;
            font-family: Ink.font-mono;
            font-size: Ink.fs-secondary;
            font-weight: root.searching ? 600 : 400;
            color: root.searching ? Ink.focus : Ink.text-mute;
            vertical-alignment: center;
        }
    }

    Rectangle {
        visible: root.active;
        y: parent.height - 2px;
        height: 2px;
        background: Ink.focus;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component FilterChip inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <color> tint: Ink.focus;
    in property <bool> active: false;
    in property <bool> tinted: true;   // false = neutral chip (All / Recents)
    callback clicked;

    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: active ? (tinted ? tint : Ink.focus) : Ink.border-soft;
    background: active ? (tinted ? tint.with-alpha(0.14) : Ink.focus.with-alpha(0.14)) : (ta.has-hover ? Ink.raised : transparent);
    animate background, border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        if tinted: Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 1.5px;
            background: tint;
            y: (parent.height - 6px) / 2;
        }
        Text {
            text: label;
            color: active ? (tinted ? tint : Ink.text) : Ink.text-dim;
            font-size: Ink.fs-secondary;
            font-weight: active ? 600 : 400;
            vertical-alignment: center;
        }

        // Only the active chip says how many it shows (the row fits).
        if active && count > 0: Text {
            text: "\{count}";
            color: Ink.text-mute;
            font-size: Ink.fs-caption;
            font-family: Ink.font-mono;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// ---------- Section header within the list ----------

component SectionHeader inherits Rectangle {
    in property <StepCategory> category;
    in property <int> count;
    height: 28px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: start;
        Rectangle {
            width: 3px;
            height: 10px;
            background: PickerStyle.cat-color(category);
            border-radius: 1.5px;
            y: (parent.height - 10px) / 2;
        }

        Text {
            text: PickerStyle.cat-name(category);
            color: PickerStyle.cat-color(category);
            font-size: Ink.fs-caption;
            font-weight: 600;
            letter-spacing: 0.6px;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: "\{count}";
            color: Ink.text-mute;
            font-size: Ink.fs-caption;
            font-family: Ink.font-mono;
            vertical-alignment: center;
        }
    }
}

// ---------- One row in the command list ----------

component CommandRow inherits Rectangle {
    in property <CommandDef> cmd;
    in property <bool> selected: false;
    callback clicked;
    callback double-clicked;
    callback toggle-favorite;

    height: PickerStyle.row-h;
    background: selected ? Ink.raised : (ta.has-hover ? Ink.ground.with-alpha(0.5) : transparent);
    border-radius: 6px;
    border-width: 1px;
    border-color: selected ? Ink.border : transparent;

    // category stripe
    Rectangle {
        x: 4px;
        y: 6px;
        width: 3px;
        height: parent.height - 12px;
        background: PickerStyle.cmd-color(cmd);
        border-radius: 1.5px;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        spacing: 10px;
        alignment: stretch;

        // icon glyph
        Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - 28px) / 2;
            border-radius: 5px;
            background: Ink.ground;
            border-width: 1px;
            border-color: Ink.border-soft;
            // The module diamond is drawn: as a glyph, the font's metrics
            // put it off centre.
            if cmd.icon-glyph == "◆": Path {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M 6 0 L 12 6 L 6 12 L 0 6 Z";
                fill: PickerStyle.cmd-color(cmd);
            }
            if cmd.icon-glyph != "◆": Text {
                text: cmd.icon-glyph;
                color: PickerStyle.cmd-color(cmd);
                font-size: Ink.fs-heading;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // name + summary
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: cmd.name;
                color: Ink.text;
                font-size: Ink.fs-body;
                font-weight: 500;
                overflow: elide;
            }

            Text {
                text: cmd.summary;
                color: Ink.text-mute;
                font-size: Ink.fs-caption;
                font-family: Ink.font-mono;
                overflow: elide;
            }
        }

        // recent badge
        if cmd.recent && !cmd.favorite: Rectangle {
            y: (parent.height - 18px) / 2;
            width: 50px;
            height: 18px;
            border-radius: 4px;
            background: Ink.focus.with-alpha(0.14);
            Text {
                text: "RECENT";
                color: Ink.focus;
                font-size: Ink.fs-caption;
                letter-spacing: 0.6px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // favorite star
        Rectangle {
            width: 26px;
            height: 26px;
            y: (parent.height - 26px) / 2;
            border-radius: 4px;
            background: fav-ta.has-hover ? Ink.ground : transparent;
            Text {
                text: cmd.favorite ? "★" : "☆";
                color: cmd.favorite ? Ink.cat-measure : Ink.text-faint;
                font-size: Ink.fs-heading;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            fav-ta := TouchArea {
                clicked => {
                    root.toggle-favorite();
                }
            }
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }
}

// ---------- Detail pane (right side) ----------

// A small caption and its lines.
component DetailSection inherits VerticalLayout {
    in property <string> title;
    spacing: 4px;
    InkCaption {
        text: root.title;
    }
}

component DetailPane inherits Rectangle {
    in property <CommandDef> cmd;
    in property <bool> has-selection: false;
    /// A project module no pipeline uses: "Remove from project".
    in property <bool> removable: false;
    callback remove();

    background: Ink.panel;

    if !has-selection: VerticalLayout {
        alignment: center;
        spacing: 6px;
        Text {
            text: "Pick a command";
            color: Ink.text-dim;
            font-size: Ink.fs-dialog-title;
            horizontal-alignment: center;
        }

        InkHint {
            text: "↑↓ choose · Enter adds it";
            horizontal-alignment: center;
        }
    }

    if has-selection: VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // What it is: name, category - and where it comes from when that
        // fits beside them (a module's source is long: "this project ·
        // v1 · …"); the name is never squeezed for it.
        HorizontalLayout {
            // The source's width, estimated (monospace) - not measured, so
            // showing it or not doesn't feed back into the layout.
            property <length> source-w: cmd.source.character-count * Ink.fs-secondary * 0.6;
            property <bool> source-fits: cmd.source != ""
                && root.width - 32px >= 8px + title.preferred-width + category.preferred-width + self.source-w + 3 * 8px;
            spacing: 8px;
            Rectangle {
                width: 8px;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 2px;
                    background: PickerStyle.cmd-color(cmd);
                }
            }

            title := Text {
                text: cmd.name;
                color: Ink.text;
                font-size: Ink.fs-title;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            category := Text {
                horizontal-stretch: 1;
                text: cmd.is-module ? "Module" : PickerStyle.cat-name(cmd.category);
                color: Ink.text-mute;
                font-size: Ink.fs-secondary;
                vertical-alignment: center;
            }

            if self.source-fits: Text {
                text: cmd.source;
                color: Ink.text-mute;
                font-size: Ink.fs-secondary;
                font-family: Ink.font-mono;
                vertical-alignment: center;
            }
        }

        // The short description.
        Text {
            text: cmd.summary;
            color: Ink.text;
            font-size: Ink.fs-body;
            wrap: word-wrap;
        }

        InkDivider { }

        Flickable {
            vertical-stretch: 1;
            content-height: body.preferred-height;

            body := VerticalLayout {
                spacing: 14px;
                alignment: start;

                // The long description.
                if cmd.description != "": Text {
                    text: cmd.description;
                    color: Ink.text-dim;
                    font-size: Ink.fs-body;
                    wrap: word-wrap;
                }

                if cmd.default-params.length > 0: DetailSection {
                    title: "SETTINGS";
                    for p in cmd.default-params: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: p.name;
                            color: Ink.text-dim;
                            font-size: Ink.fs-secondary;
                            overflow: elide;
                        }

                        Text {
                            text: p.value;
                            color: Ink.text;
                            font-size: Ink.fs-secondary;
                            font-family: Ink.font-mono;
                        }
                    }
                }

                // Who made it (modules).
                if cmd.authors.length > 0: DetailSection {
                    title: "AUTHORS";
                    for author in cmd.authors: Text {
                        text: author.organization == "" ? author.full-name : author.full-name + " · " + author.organization;
                        color: Ink.text;
                        font-size: Ink.fs-secondary;
                        overflow: elide;
                    }
                }

                // The publications of its method (commands).
                if cmd.citations.length > 0: DetailSection {
                    title: "CITE";
                    for citation in cmd.citations: Text {
                        text: citation;
                        color: Ink.text-dim;
                        font-size: Ink.fs-secondary;
                        wrap: word-wrap;
                    }
                }

                if cmd.creation-time != "" || root.removable: HorizontalLayout {
                    spacing: 8px;
                    if cmd.creation-time != "": Text {
                        horizontal-stretch: 1;
                        text: "Created " + cmd.creation-time;
                        color: Ink.text-mute;
                        font-size: Ink.fs-secondary;
                        vertical-alignment: center;
                    }
                    if cmd.is-module && root.removable: InkButton {
                        small: true;
                        kind: InkButtonKind.quiet;
                        text: "Remove from project";
                        clicked => {
                            root.remove();
                        }
                    }
                }
            }
        }
    }
}

// ===========================================================================
// Main dialog
// ===========================================================================

export component CommandSelectionDialog inherits InkDialog {
    // Next to the steps panel.
    anchor-x: Places.beside-left;
    // Docked on the right; the image stays usable.
    placement: InkDialogPlacement.sheet;
    // ---- Host inputs ----
    in property <[CommandDef]> commands;
    in property <string> target-pipeline;        // pipeline name, for breadcrumb
    in property <int> insert-after-idx;          // -1 = append
    in property <int> total-steps;               // for breadcrumb "after step N of M"
    in property <string> last-added;             // "Threshold as step 3" - stays open for the next

    // ---- Selection / filter state (in-out so host can drive too) ----
    in-out property <string> query: "";
    // Per-category filter chips (multi-select). None active = "All".
    in-out property <bool> fcat-pre: false;
    in-out property <bool> fcat-seg: false;
    in-out property <bool> fcat-obj: false;
    in-out property <bool> fcat-mea: false;
    in-out property <bool> fcat-cls: false;
    in-out property <bool> fcat-dat: false;
    in-out property <bool> filter-modules: false;
    in-out property <bool> filter-recents: false;
    in-out property <int> selected-id: -1;

    // ---- Host-computed helpers (must be supplied; do not compute in Slint) ----
    // Pre-filtered + grouped, in display order. Host applies query + filters
    // and returns one flat list per category. This keeps the panel branchless
    // and lets the host implement fuzzy ranking server-side.
    in property <[CommandDef]> shown-preprocess;
    in property <[CommandDef]> shown-segment;
    in property <[CommandDef]> shown-object;
    in property <[CommandDef]> shown-classify;
    in property <[CommandDef]> shown-dataset;
    in property <[CommandDef]> shown-measure;
    in property <[CommandDef]> shown-modules;
    in property <[CommandDef]> shown-library-modules;
    in property <CommandDef> detail;            // command for selected-id (or default)
    in property <bool> has-detail;
    in property <int> total-shown;       // sum across the five categories
    in property <int> cat-count-pre;
    in property <int> cat-count-seg;
    in property <int> cat-count-obj;
    in property <int> cat-count-cls;
    in property <int> cat-count-dat;
    in property <int> cat-count-mea;
    in property <int> cat-count-grp;
    /// The project's modules no pipeline uses ("Remove N unused").
    in property <int> unused-module-count;
    /// The selected entry is a project module no pipeline uses.
    in property <bool> detail-removable;
    in property <int> cat-count-rec;

    // ---- Outbound callbacks ----
    callback query-changed(string);
    callback select(int);            // by id
    callback toggle-favorite(int);
    callback confirm(int);           // commit: insert this id
    callback confirm-steps(int);     // a module, as its steps
    /// The Commands tab's count: commands the search finds (all of them
    /// without a search).
    in property <int> commands-matching;
    callback remove-module(int);
    callback remove-unused-modules();
    callback cancel();
    callback import-bioimageio();    // open a bioimage.io rdf.yaml and insert the configured command

    // The selected entry is a module (the footer's two ways to add it).
    property <bool> module-picked: root.has-detail && root.detail.is-module && root.selected-id != -1;

    title: "Add step";
    subtitle: insert-after-idx < 0 ? "Append to \"\{target-pipeline}\"" : "After step \{insert-after-idx + 1} of \"\{target-pipeline}\"";
    card-width: 760px;
    card-height: PickerStyle.modal-h;
    content-padding: 0px;
    close => {
        root.cancel();
    }

    // -------- Keyboard -------- (Esc is the Dialog's: `close` above)
    kbd := FocusScope {
        key-pressed(e) => {
            // A module: Enter adds it, Shift+Enter its steps.
            if e.text == Key.Return && root.selected-id != -1 && e.modifiers.shift && root.module-picked {
                root.confirm-steps(root.selected-id);
                return accept;
            }
            if e.text == Key.Return && root.selected-id != -1 {
                root.confirm(root.selected-id);
                return accept;
            }
            // The other tab.
            if e.text == Key.Tab && e.modifiers.control {
                root.filter-modules = !root.filter-modules;
                root.query-changed(root.query);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0;

            // Commands | Modules: a search counts the hits of both.
            Rectangle {
                height: 36px;
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 2px;
                    alignment: start;
                    PickerTab {
                        text: "Commands";
                        count: root.commands-matching;
                        searching: root.query != "";
                        active: !root.filter-modules;
                        clicked => {
                            root.filter-modules = false;
                            root.query-changed(root.query);
                        }
                    }

                    PickerTab {
                        text: "Modules";
                        count: root.cat-count-grp;
                        searching: root.query != "";
                        active: root.filter-modules;
                        clicked => {
                            root.filter-modules = true;
                            root.query-changed(root.query);
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Ink.border-soft;
                }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 4px;
                InkSearchField {
                    placeholder: root.filter-modules ? "Search modules…" : "Search commands…";
                    text <=> root.query;
                    edited(t) => {
                        root.query-changed(t);
                    }
                }
            }

            if !root.filter-modules: Rectangle {
                height: 40px;
                background: Ink.panel;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 6px;
                    alignment: start;

                    FilterChip {
                        label: "All";
                        count: total-shown;
                        tinted: false;
                        active: !fcat-pre && !fcat-seg && !fcat-obj && !fcat-mea && !fcat-cls && !fcat-dat && !filter-modules && !filter-recents;
                        clicked => {
                            root.fcat-pre = false;
                            root.fcat-seg = false;
                            root.fcat-obj = false;
                            root.fcat-mea = false;
                            root.fcat-cls = false;
                            root.fcat-dat = false;
                            root.filter-modules = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    FilterChip {
                        label: "Preprocess";
                        count: cat-count-pre;
                        tint: Ink.cat-preprocess;
                        active: fcat-pre;
                        clicked => {
                            root.fcat-pre = !fcat-pre;
                            root.filter-modules = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    FilterChip {
                        label: "Segment";
                        count: cat-count-seg;
                        tint: Ink.cat-segment;
                        active: fcat-seg;
                        clicked => {
                            root.fcat-seg = !fcat-seg;
                            root.filter-modules = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    FilterChip {
                        label: "Instance Seg.";
                        count: cat-count-obj;
                        tint: Ink.cat-object;
                        active: fcat-obj;
                        clicked => {
                            root.fcat-obj = !fcat-obj;
                            root.filter-modules = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    FilterChip {
                        label: "Measure";
                        count: cat-count-mea;
                        tint: Ink.cat-measure;
                        active: fcat-mea;
                        clicked => {
                            root.fcat-mea = !fcat-mea;
                            root.filter-modules = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    FilterChip {
                        label: "Object";
                        count: cat-count-cls;
                        tint: Ink.cat-classify;
                        active: fcat-cls;
                        clicked => {
                            root.fcat-cls = !fcat-cls;
                            root.filter-modules = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    FilterChip {
                        label: "Dataset";
                        count: cat-count-dat;
                        tint: Ink.cat-dataset;
                        active: fcat-dat;
                        clicked => {
                            root.fcat-dat = !fcat-dat;
                            root.filter-modules = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    // FilterChip {
                   //     label: "Recents";
                   //     count: cat-count-rec;
                   //     tinted: false;
                   //     active: filter-recents;
                   //     visible: false;
                   //     clicked => {
                   //         root.filter-recents = !filter-recents;
                   //         root.filter-category = -1;
                   //     }
                   // }
                }

                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Ink.border-soft;
                }
            }

            // ---------- 4. Body - split list + detail ----------
        Rectangle {
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: 0;
                    alignment: stretch;

                    // LIST
                Rectangle {
                        width: PickerStyle.list-col-w;
                        background: Ink.panel;
                   // border-right-width: 0;

                    ScrollView {
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 12px;
                                spacing: 0;
                                alignment: start;

                                // Empty state
                            if total-shown == 0 && !filter-modules: VerticalLayout {
                                    padding-top: 60px;
                                    spacing: 6px;
                                    Text {
                                        text: query != "" && cat-count-grp > 0
                                            ? "No commands match “\{query}” - \{cat-count-grp} " + (cat-count-grp == 1 ? "module does." : "modules do.")
                                            : "No commands match";
                                        color: Ink.text-dim;
                                        font-size: Ink.fs-body;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    if !(query != "" && cat-count-grp > 0): Text {
                                        text: query == "" ? "Try another category." : "Try other words.";
                                        color: Ink.text-mute;
                                        font-size: Ink.fs-secondary;
                                        horizontal-alignment: center;
                                    }
                                    // Not switched behind the user's back: one click.
                                    if query != "" && cat-count-grp > 0: HorizontalLayout {
                                        alignment: center;
                                        padding-top: 4px;
                                        InkButton {
                                            text: cat-count-grp == 1 ? "Show the module" : "Show the \{cat-count-grp} modules";
                                            keys: ["Ctrl", "Tab"];
                                            clicked => {
                                                root.filter-modules = true;
                                                root.query-changed(root.query);
                                            }
                                        }
                                    }
                                }

                                // Preprocess
                            if shown-preprocess.length > 0 && !filter-modules: VerticalLayout {
                                    spacing: 0;
                                    SectionHeader {
                                        category: StepCategory.preprocess;
                                        count: shown-preprocess.length;
                                    }

                                    for c in shown-preprocess: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }
                                }

                                // Segment
                            if shown-segment.length > 0 && !filter-modules: VerticalLayout {
                                    spacing: 0;
                                    SectionHeader {
                                        category: StepCategory.segment;
                                        count: shown-segment.length;
                                    }

                                    for c in shown-segment: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }

                                    // Auto-configure an AI segmentation command from a
                                    // downloaded bioimage.io model's rdf.yaml.
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-top: 6px;
                                        padding-bottom: 4px;
                                        alignment: start;
                                        InkButton {
                                            text: "Import bioimage.io model…";
                                            clicked => {
                                                root.import-bioimageio();
                                            }
                                        }
                                    }
                                }

                                // Instance Segmentation
                            if shown-object.length > 0 && !filter-modules: VerticalLayout {
                                    spacing: 0;
                                    SectionHeader {
                                        category: StepCategory.instance-segmentation;
                                        count: shown-object.length;
                                    }

                                    for c in shown-object: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }
                                }

                                // Measure
                            if shown-measure.length > 0 && !filter-modules: VerticalLayout {
                                    spacing: 0;
                                    SectionHeader {
                                        category: StepCategory.measure;
                                        count: shown-measure.length;
                                    }

                                    for c in shown-measure: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }
                                }

                                // Object
                            if shown-classify.length > 0 && !filter-modules: VerticalLayout {
                                    spacing: 0;
                                    SectionHeader {
                                        category: StepCategory.object;
                                        count: shown-classify.length;
                                    }

                                    for c in shown-classify: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }
                                }

                                // Dataset
                            if shown-dataset.length > 0 && !filter-modules: VerticalLayout {
                                    spacing: 0;
                                    SectionHeader {
                                        category: StepCategory.dataset;
                                        count: shown-dataset.length;
                                    }

                                    for c in shown-dataset: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }
                                }

                                // Modules: on their own tab.
                            if filter-modules: VerticalLayout {
                                    spacing: 0;

                                    if filter-modules && unused-module-count > 0: Rectangle {
                                        height: 30px;
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 8px;
                                            Text {
                                                text: unused-module-count == 1 ? "1 module no pipeline uses" : "\{unused-module-count} modules no pipeline uses";
                                                color: Ink.text-mute;
                                                font-size: Ink.fs-caption;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }

                                            Rectangle {
                                                width: 70px;
                                                height: 22px;
                                                y: (parent.height - 22px) / 2;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: Ink.border;
                                                background: remove-unused-ta.has-hover ? Ink.raised : transparent;
                                                Text {
                                                    text: "Remove";
                                                    color: Ink.text-dim;
                                                    font-size: Ink.fs-caption;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                remove-unused-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.remove-unused-modules();
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if filter-modules && shown-modules.length == 0 && shown-library-modules.length == 0: VerticalLayout {
                                        padding-top: 60px;
                                        spacing: 10px;
                                        Text {
                                            text: query == "" ? "No modules in this project"
                                                : commands-matching > 0 ? "No module matches “\{query}” - \{commands-matching} " + (commands-matching == 1 ? "command does." : "commands do.")
                                                : "No module matches";
                                            color: Ink.text-dim;
                                            font-size: Ink.fs-body;
                                            horizontal-alignment: center;
                                        }

                                        Text {
                                            text: "A module is a step made of other steps";
                                            color: Ink.text-mute;
                                            font-size: Ink.fs-caption;
                                            font-family: Ink.font-mono;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    if shown-modules.length > 0: Rectangle {
                                        height: 28px;
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 8px;
                                            alignment: start;
                                            Rectangle {
                                                width: 3px;
                                                height: 10px;
                                                background: Ink.cat-module;
                                                border-radius: 1.5px;
                                                y: (parent.height - 10px) / 2;
                                            }

                                            Text {
                                                text: filter-modules ? "IN THIS PROJECT" : "MODULES";
                                                color: Ink.cat-module;
                                                font-size: Ink.fs-caption;
                                                font-weight: 600;
                                                letter-spacing: 0.6px;
                                                vertical-alignment: center;
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }

                                            Text {
                                                text: "\{shown-modules.length}";
                                                color: Ink.text-mute;
                                                font-size: Ink.fs-caption;
                                                font-family: Ink.font-mono;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    for c in shown-modules: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }

                                    if shown-library-modules.length > 0: Rectangle {
                                        height: 28px;
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 8px;
                                            alignment: start;
                                            Rectangle {
                                                width: 3px;
                                                height: 10px;
                                                background: Ink.cat-module.with-alpha(0.6);
                                                border-radius: 1.5px;
                                                y: (parent.height - 10px) / 2;
                                            }

                                            Text {
                                                text: "LIBRARY";
                                                color: Ink.cat-module;
                                                font-size: Ink.fs-caption;
                                                font-weight: 600;
                                                letter-spacing: 0.6px;
                                                vertical-alignment: center;
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }

                                            Text {
                                                text: "\{shown-library-modules.length}";
                                                color: Ink.text-mute;
                                                font-size: Ink.fs-caption;
                                                font-family: Ink.font-mono;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    for c in shown-library-modules: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Splitter
                Rectangle {
                        width: 1px;
                        background: Ink.border-soft;
                    }

                    // DETAIL
                DetailPane {
                        horizontal-stretch: 1;
                        cmd: root.detail;
                        has-selection: root.has-detail;
                        removable: root.detail-removable;
                        remove => {
                            root.remove-module(root.detail.id);
                        }
                    }
                }
            }

            // ---------- 5. Footer ----------
            InkDivider { }

            // The dialog's buttons; this dialog pads its own content.
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                padding-left: Ink.pad-dialog;
                padding-right: Ink.pad-dialog;
                padding-top: 10px;
                padding-bottom: 10px;

                // Stays open for the next step: what was just added.
                Text {
                    horizontal-stretch: 1;
                    text: root.last-added == "" ? "" : "✓ Added " + root.last-added;
                    font-size: Ink.fs-secondary;
                    color: Ink.ok;
                    vertical-alignment: center;
                    overflow: elide;
                }

                InkButton {
                    text: root.last-added == "" ? "Cancel" : "Done";
                    clicked => {
                        root.cancel();
                    }
                }

                // A module: one click for either - itself (linked to the
                // library, gets updates) or a plain copy of its steps.
                if root.module-picked: InkButton {
                    text: "Add steps";
                    tip: "A plain copy of its steps - every setting editable, no link: library updates don't reach it";
                    keys: ["Shift", "Enter"];
                    clicked => {
                        root.confirm-steps(root.selected-id);
                    }
                }
                if root.module-picked: InkButton {
                    kind: InkButtonKind.primary;
                    text: "Add module";
                    tip: "One step, linked to the library - gets updates, shows its exposed settings";
                    keys: ["Enter"];
                    clicked => {
                        root.confirm(root.selected-id);
                    }
                }
                if !root.module-picked: InkButton {
                    kind: InkButtonKind.primary;
                    text: "Add to pipeline";
                    keys: ["Enter"];
                    enabled: root.selected-id != -1;
                    disabled-reason: "Pick a command first";
                    clicked => {
                        root.confirm(root.selected-id);
                    }
                }
            }
        }
    }

    init => {
        kbd.focus();
    }
}

// ===========================================================================
// Modal wrapper - convenience element you can place inside MainWindow with
// `visible <=> showing-add-step`. Adds the scrim + click-outside-to-close.
// ===========================================================================

export component CommandPickerModal inherits Rectangle {
    in property <[CommandDef]> commands;
    in property <string> target-pipeline;
    in property <int> insert-after-idx;
    in property <int> total-steps;

    in property <[CommandDef]> shown-preprocess;
    in property <[CommandDef]> shown-segment;
    in property <[CommandDef]> shown-object;
    in property <[CommandDef]> shown-classify;
    in property <[CommandDef]> shown-dataset;
    in property <[CommandDef]> shown-measure;
    in property <[CommandDef]> shown-modules;
    in property <[CommandDef]> shown-library-modules;
    in property <CommandDef> detail;
    in property <bool> has-detail;
    in property <int> total-shown;
    in property <int> cat-count-pre;
    in property <int> cat-count-seg;
    in property <int> cat-count-obj;
    in property <int> cat-count-cls;
    in property <int> cat-count-dat;
    in property <int> cat-count-mea;
    in property <int> cat-count-grp;
    /// The project's modules no pipeline uses ("Remove N unused").
    in property <int> unused-module-count;
    /// The selected entry is a project module no pipeline uses.
    in property <bool> detail-removable;
    in property <int> cat-count-rec;

    in-out property <string> query: "";
    in-out property <bool> fcat-pre: false;
    in-out property <bool> fcat-seg: false;
    in-out property <bool> fcat-obj: false;
    in-out property <bool> fcat-mea: false;
    in-out property <bool> fcat-cls: false;
    in-out property <bool> fcat-dat: false;
    in-out property <bool> filter-modules: false;
    in-out property <bool> filter-recents: false;
    in-out property <int> selected-id: -1;

    callback query-changed(string);
    callback select(int);
    callback toggle-favorite(int);
    callback confirm(int);
    callback remove-module(int);
    callback remove-unused-modules();
    callback cancel();
    callback import-bioimageio();

    // The dialog brings its own backdrop; a click on it cancels.
    CommandSelectionDialog {
        width: 100%;
        height: 100%;
        close-on-backdrop: true;
        commands: root.commands;
        target-pipeline: root.target-pipeline;
        insert-after-idx: root.insert-after-idx;
        total-steps: root.total-steps;
        shown-preprocess: root.shown-preprocess;
        shown-segment: root.shown-segment;
        shown-object: root.shown-object;
        shown-classify: root.shown-classify;
        shown-dataset: root.shown-dataset;
        shown-measure: root.shown-measure;
        shown-modules: root.shown-modules;
        shown-library-modules: root.shown-library-modules;
        detail: root.detail;
        has-detail: root.has-detail;
        total-shown: root.total-shown;
        cat-count-pre: root.cat-count-pre;
        cat-count-seg: root.cat-count-seg;
        cat-count-obj: root.cat-count-obj;
        cat-count-cls: root.cat-count-cls;
        cat-count-dat: root.cat-count-dat;
        cat-count-mea: root.cat-count-mea;
        cat-count-grp: root.cat-count-grp;
        unused-module-count: root.unused-module-count;
        detail-removable: root.detail-removable;
        cat-count-rec: root.cat-count-rec;
        query <=> root.query;
        fcat-pre <=> root.fcat-pre;
        fcat-seg <=> root.fcat-seg;
        fcat-obj <=> root.fcat-obj;
        fcat-mea <=> root.fcat-mea;
        fcat-cls <=> root.fcat-cls;
        fcat-dat <=> root.fcat-dat;
        filter-modules <=> root.filter-modules;
        filter-recents <=> root.filter-recents;
        selected-id <=> root.selected-id;

        query-changed(t) => {
            root.query-changed(t);
        }
        select(id) => {
            root.select(id);
        }
        toggle-favorite(id) => {
            root.toggle-favorite(id);
        }
        confirm(id) => {
            root.confirm(id);
        }
        remove-module(id) => {
            root.remove-module(id);
        }
        remove-unused-modules => {
            root.remove-unused-modules();
        }
        cancel => {
            root.cancel();
        }
        import-bioimageio => {
            root.import-bioimageio();
        }
    }
}
