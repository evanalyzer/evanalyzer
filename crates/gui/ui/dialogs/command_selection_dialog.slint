// command_picker.slint
// EVAnalyzer - Add-Step (command selection) dialog.
//
// Opens when the user clicks "+ Add step" in the Pipelines panel, or any of
// the inline "+" insertion points between steps. Picks a single command from
// the library, configures nothing here (params are edited inline in the step
// row after insertion), and returns a category + algo-id to the host.
//
// Layout (1080 × 680, centered modal):
//
//   ┌------------------------------------------------------------------┐
//   │  Add step               After step 4 of "Nucleus pipeline"   ✕   │   ← header strip (44)
//   ├------------------------------------------------------------------┤
//   │  🔍  Search commands…                                            │   ← search
//   │                                                                  │
//   │  All · Preprocess · Segment · Instance Seg. · Measure · Object   │   ← filter chips (40)
//   ├----------------------------┬-------------------------------------┤
//   │ PREPROCESS  ---------------│   Gaussian Blur                     │
//   │ ƒ Gaussian Blur     σ ▸    │   ------------------------------    │
//   │ ƒ Median Filter            │   Smooth an image with an isotropic │
//   │ ƒ Background Subtract      │   Gaussian kernel. Reduces shot     │   ← list  +  detail
//   │ SEGMENT     ---------------│   noise before thresholding.        │     pane (split)
//   │ ƒ Threshold (Otsu)         │                                     │
//   │ ƒ Watershed                │   DEFAULT PARAMETERS                │
//   │ ƒ Cellpose            ★    │     σ              2.0  px          │
//   │ MEASURE     ---------------│     Per channel    on               │
//   │ ƒ Intensity Stats          │     Edge handling  reflect          │
//   │ ƒ Area & Perimeter         │                                     │
//   │                            │   Category   Preprocess             │
//   │                            │   Source     skimage · v0.22        │
//   ├----------------------------┴-------------------------------------┤
//   │  ↑↓ navigate    ↵ add    ⎋ cancel             [ Add to pipeline ]│   ← footer (52)
//   └------------------------------------------------------------------┘
//
// Host wires:
//   - commands           : [CommandDef]   - the full library
//   - recents / favorites: [int]          - ids of recently used / starred
//   - target-pipeline    : string         - name of the pipeline being edited
//   - insert-after-idx   : int            - 0-based slot; -1 means "append"
//   confirm(int)  →  insert this command id at (target-pipeline, insert-after-idx)
//   toggle-favorite(int), cancel().
import { InkSearchField } from "../ink/ink.slint";
import { StepCategory } from "../api/pipelines.slint";
import { CommandDef, PickerStyle } from "../api/command_selection.slint";

import { ScrollView } from "std-widgets.slint";
import { AppButton } from "../components/app_button.slint";
import { Dialog, DialogFooter } from "../components/new_components/dialog.slint";
import { Theme } from "../style.slint";

// ---------- Command library data ----------
// ---------- Command picker global state ----------
// ---------- Local visual constants ----------
// ---------- Filter chip ----------

component FilterChip inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <color> tint: Theme.accent;
    in property <bool> active: false;
    in property <bool> tinted: true;   // false = neutral chip (All / Recents)
    callback clicked;

    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: active ? (tinted ? tint : Theme.accent) : Theme.border-soft;
    background: active ? (tinted ? tint.with-alpha(0.14) : Theme.accent.with-alpha(0.14)) : (ta.has-hover ? Theme.raised : transparent);
    animate background, border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        if tinted: Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 1.5px;
            background: tint;
            y: (parent.height - 6px) / 2;
        }
        Text {
            text: label;
            color: active ? (tinted ? tint : Theme.text) : Theme.text-dim;
            font-size: 11px;
            font-weight: active ? 600 : 400;
            vertical-alignment: center;
        }

        if count > 0: Text {
            text: "\{count}";
            color: Theme.text-mute;
            font-size: 10.5px;
            font-family: Theme.font-mono;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// ---------- Section header within the list ----------

component SectionHeader inherits Rectangle {
    in property <StepCategory> category;
    in property <int> count;
    height: 28px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: start;
        Rectangle {
            width: 3px;
            height: 10px;
            background: PickerStyle.cat-color(category);
            border-radius: 1.5px;
            y: (parent.height - 10px) / 2;
        }

        Text {
            text: PickerStyle.cat-name(category);
            color: PickerStyle.cat-color(category);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.6px;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: "\{count}";
            color: Theme.text-mute;
            font-size: 10px;
            font-family: Theme.font-mono;
            vertical-alignment: center;
        }
    }
}

// ---------- One row in the command list ----------

component CommandRow inherits Rectangle {
    in property <CommandDef> cmd;
    in property <bool> selected: false;
    callback clicked;
    callback double-clicked;
    callback toggle-favorite;

    height: PickerStyle.row-h;
    background: selected ? Theme.raised : (ta.has-hover ? Theme.bg.with-alpha(0.5) : transparent);
    border-radius: 6px;
    border-width: 1px;
    border-color: selected ? Theme.border : transparent;

    // category stripe
    Rectangle {
        x: 4px;
        y: 6px;
        width: 3px;
        height: parent.height - 12px;
        background: PickerStyle.cmd-color(cmd);
        border-radius: 1.5px;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        spacing: 10px;
        alignment: stretch;

        // icon glyph
        Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - 28px) / 2;
            border-radius: 5px;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.border-soft;
            // The component diamond is drawn: as a glyph, the font's metrics
            // put it off centre.
            if cmd.icon-glyph == "◆": Path {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M 6 0 L 12 6 L 6 12 L 0 6 Z";
                fill: PickerStyle.cmd-color(cmd);
            }
            if cmd.icon-glyph != "◆": Text {
                text: cmd.icon-glyph;
                color: PickerStyle.cmd-color(cmd);
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // name + summary
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: cmd.name;
                color: Theme.text;
                font-size: 12.5px;
                font-weight: 500;
                overflow: elide;
            }

            Text {
                text: cmd.summary;
                color: Theme.text-mute;
                font-size: 10.5px;
                font-family: Theme.font-mono;
                overflow: elide;
            }
        }

        // recent badge
        if cmd.recent && !cmd.favorite: Rectangle {
            y: (parent.height - 18px) / 2;
            width: 50px;
            height: 18px;
            border-radius: 4px;
            background: Theme.accent.with-alpha(0.14);
            Text {
                text: "RECENT";
                color: Theme.accent;
                font-size: 9px;
                letter-spacing: 0.6px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // favorite star
        Rectangle {
            width: 26px;
            height: 26px;
            y: (parent.height - 26px) / 2;
            border-radius: 4px;
            background: fav-ta.has-hover ? Theme.bg : transparent;
            Text {
                text: cmd.favorite ? "★" : "☆";
                color: cmd.favorite ? Theme.cat-measure : Theme.text-faint;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            fav-ta := TouchArea {
                clicked => {
                    root.toggle-favorite();
                }
            }
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }
}

// ---------- Detail pane (right side) ----------

component DetailPane inherits Rectangle {
    in property <CommandDef> cmd;
    in property <bool> has-selection: false;
    /// A project component no pipeline uses: "Remove from project".
    in property <bool> removable: false;
    callback remove();

    background: Theme.bg;

    if !has-selection: VerticalLayout {
        alignment: center;
        spacing: 10px;
        Text {
            text: "◇";
            color: Theme.text-faint;
            font-size: 28px;
            horizontal-alignment: center;
        }

        Text {
            text: "Pick a command";
            color: Theme.text-dim;
            font-size: 12px;
            horizontal-alignment: center;
        }

        Text {
            text: "Use ↑↓ to navigate · ↵ to add";
            color: Theme.text-mute;
            font-size: 10.5px;
            font-family: Theme.font-mono;
            horizontal-alignment: center;
        }
    }

    if has-selection: VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 20px;
        spacing: 16px;

        // Category eyebrow
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 1.5px;
                background: PickerStyle.cmd-color(cmd);
                y: (parent.height - 6px) / 2;
            }

            Text {
                text: cmd.is-component ? "COMPONENT" : PickerStyle.cat-name(cmd.category);
                color: PickerStyle.cmd-color(cmd);
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.6px;
                vertical-alignment: center;
            }
        }

        // Title
        Text {
            text: cmd.name;
            color: Theme.text;
            font-size: 20px;
            font-weight: 600;
        }

        // Summary
        Text {
            text: cmd.summary;
            color: Theme.text-dim;
            font-size: 12.5px;
            wrap: word-wrap;
        }

        // Divider
        Rectangle {
            height: 1px;
            background: Theme.border-soft;
        }

        // Description body
        Text {
            text: cmd.description;
            color: Theme.text-dim;
            font-size: 12px;
            wrap: word-wrap;
        }

        // Default parameters
        if cmd.default-params.length > 0: VerticalLayout {
            spacing: 8px;
            Text {
                text: "DEFAULT PARAMETERS";
                color: Theme.text-mute;
                font-size: 9.5px;
                font-weight: 600;
                letter-spacing: 0.6px;
            }

            for p in cmd.default-params: HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: p.name;
                    color: Theme.text-dim;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

                Text {
                    text: p.value;
                    color: Theme.text;
                    font-size: 11.5px;
                    font-family: Theme.font-mono;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }   // spacer

        // Footer metadata
        Rectangle {
            height: 1px;
            background: Theme.border-soft;
        }

        // Footer metadata: as tall as its rows - the spacer above takes the
        // rest (empty rows here used to stretch it apart).
        VerticalLayout {
            spacing: 4px;
            vertical-stretch: 0;
            alignment: start;
            // Components: who made it, and when.
            if cmd.is-component && cmd.authors.length > 0: HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: "Author";
                    color: Theme.text-mute;
                    font-size: 10.5px;
                }

                Text {
                    text: cmd.authors[0].organization == "" ? cmd.authors[0].full-name : cmd.authors[0].full-name + " (" + cmd.authors[0].organization + ")";
                    color: Theme.text-dim;
                    font-size: 10.5px;
                    font-family: Theme.font-mono;
                    overflow: elide;
                }
            }

            if cmd.is-component && cmd.authors.length > 1: VerticalLayout {
                spacing: 4px;
                vertical-stretch: 0;
                for author[index] in cmd.authors: HorizontalLayout {
                    vertical-stretch: 0;
                    if index > 0: HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;

                        Text {
                            text: index == 1 ? "Co-authors" : "";
                            color: Theme.text-mute;
                            font-size: 10.5px;
                        }

                        Text {
                            text: author.organization == "" ? author.full-name : author.full-name + " (" + author.organization + ")";
                            color: Theme.text-dim;
                            font-size: 10.5px;
                            font-family: Theme.font-mono;
                            overflow: elide;
                        }
                    }
                }
            }

            if cmd.is-component && cmd.creation-time != "": HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: "Created";
                    color: Theme.text-mute;
                    font-size: 10.5px;
                }

                Text {
                    text: cmd.creation-time;
                    color: Theme.text-dim;
                    font-size: 10.5px;
                    font-family: Theme.font-mono;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: "Source";
                    color: Theme.text-mute;
                    font-size: 10.5px;
                }

                Text {
                    text: cmd.source;
                    color: Theme.text-dim;
                    font-size: 10.5px;
                    font-family: Theme.font-mono;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: "Id";
                    color: Theme.text-mute;
                    font-size: 10.5px;
                }

                Text {
                    text: "\{cmd.id}";
                    color: Theme.text-faint;
                    font-size: 10.5px;
                    font-family: Theme.font-mono;
                }
            }

            if cmd.is-component && root.removable: HorizontalLayout {
                alignment: start;
                padding-top: 6px;
                AppButton {
                    text: "Remove from project";
                    clicked => {
                        root.remove();
                    }
                }
            }
        }
    }
}

// ===========================================================================
// Main dialog
// ===========================================================================

export component CommandSelectionDialog inherits Dialog {
    // ---- Host inputs ----
    in property <[CommandDef]> commands;
    in property <string> target-pipeline;        // pipeline name, for breadcrumb
    in property <int> insert-after-idx;          // -1 = append
    in property <int> total-steps;               // for breadcrumb "after step N of M"

    // ---- Selection / filter state (in-out so host can drive too) ----
    in-out property <string> query: "";
    // Per-category filter chips (multi-select). None active = "All".
    in-out property <bool> fcat-pre: false;
    in-out property <bool> fcat-seg: false;
    in-out property <bool> fcat-obj: false;
    in-out property <bool> fcat-mea: false;
    in-out property <bool> fcat-cls: false;
    in-out property <bool> fcat-dat: false;
    in-out property <bool> filter-components: false;
    in-out property <bool> filter-recents: false;
    in-out property <int> selected-id: -1;

    // ---- Host-computed helpers (must be supplied; do not compute in Slint) ----
    // Pre-filtered + grouped, in display order. Host applies query + filters
    // and returns one flat list per category. This keeps the panel branchless
    // and lets the host implement fuzzy ranking server-side.
    in property <[CommandDef]> shown-preprocess;
    in property <[CommandDef]> shown-segment;
    in property <[CommandDef]> shown-object;
    in property <[CommandDef]> shown-classify;
    in property <[CommandDef]> shown-dataset;
    in property <[CommandDef]> shown-measure;
    in property <[CommandDef]> shown-components;
    in property <[CommandDef]> shown-library-components;
    in property <CommandDef> detail;            // command for selected-id (or default)
    in property <bool> has-detail;
    in property <int> total-shown;       // sum across the five categories
    in property <int> cat-count-pre;
    in property <int> cat-count-seg;
    in property <int> cat-count-obj;
    in property <int> cat-count-cls;
    in property <int> cat-count-dat;
    in property <int> cat-count-mea;
    in property <int> cat-count-grp;
    /// The project's components no pipeline uses ("Remove N unused").
    in property <int> unused-component-count;
    /// The selected entry is a project component no pipeline uses.
    in property <bool> detail-removable;
    in property <int> cat-count-rec;

    // ---- Outbound callbacks ----
    callback query-changed(string);
    callback select(int);            // by id
    callback toggle-favorite(int);
    callback confirm(int);           // commit: insert this id
    callback remove-component(int);
    callback remove-unused-components();
    callback cancel();
    callback import-bioimageio();    // open a bioimage.io rdf.yaml and insert the configured command

    title: "Add step";
    subtitle: insert-after-idx < 0 ? "Append to \"\{target-pipeline}\"" : "After step \{insert-after-idx + 1} of \"\{target-pipeline}\"";
    dialog-width: PickerStyle.modal-w;
    dialog-height: PickerStyle.modal-h;
    content-padding: 0px;
    close => {
        root.cancel();
    }

    // -------- Keyboard -------- (Esc is the Dialog's: `close` above)
    kbd := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return && root.selected-id != -1 {
                root.confirm(root.selected-id);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0;

            Rectangle {
                height: 1px;
                background: Theme.border-soft;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 4px;
                InkSearchField {
                    placeholder: "Search commands…";
                    text <=> root.query;
                    edited(t) => {
                        root.query-changed(t);
                    }
                }
            }

            Rectangle {
                height: 40px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 6px;
                    alignment: start;

                    FilterChip {
                        label: "All";
                        count: total-shown;
                        tinted: false;
                        active: !fcat-pre && !fcat-seg && !fcat-obj && !fcat-mea && !fcat-cls && !fcat-dat && !filter-components && !filter-recents;
                        clicked => {
                            root.fcat-pre = false;
                            root.fcat-seg = false;
                            root.fcat-obj = false;
                            root.fcat-mea = false;
                            root.fcat-cls = false;
                            root.fcat-dat = false;
                            root.filter-components = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    FilterChip {
                        label: "Preprocess";
                        count: cat-count-pre;
                        tint: Theme.cat-preprocess;
                        active: fcat-pre;
                        clicked => {
                            root.fcat-pre = !fcat-pre;
                            root.filter-components = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    FilterChip {
                        label: "Segment";
                        count: cat-count-seg;
                        tint: Theme.cat-segment;
                        active: fcat-seg;
                        clicked => {
                            root.fcat-seg = !fcat-seg;
                            root.filter-components = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    FilterChip {
                        label: "Instance Seg.";
                        count: cat-count-obj;
                        tint: Theme.cat-object;
                        active: fcat-obj;
                        clicked => {
                            root.fcat-obj = !fcat-obj;
                            root.filter-components = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    FilterChip {
                        label: "Measure";
                        count: cat-count-mea;
                        tint: Theme.cat-measure;
                        active: fcat-mea;
                        clicked => {
                            root.fcat-mea = !fcat-mea;
                            root.filter-components = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    FilterChip {
                        label: "Object";
                        count: cat-count-cls;
                        tint: Theme.cat-classify;
                        active: fcat-cls;
                        clicked => {
                            root.fcat-cls = !fcat-cls;
                            root.filter-components = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    FilterChip {
                        label: "Dataset";
                        count: cat-count-dat;
                        tint: Theme.cat-dataset;
                        active: fcat-dat;
                        clicked => {
                            root.fcat-dat = !fcat-dat;
                            root.filter-components = false;
                            root.filter-recents = false;
                            root.query-changed(query);
                        }
                    }

                    Rectangle {
                        width: 1px;
                        height: 16px;
                        y: (parent.height - 16px) / 2;
                        background: Theme.border-soft;
                    }

                    // FilterChip {
                   //     label: "Recents";
                   //     count: cat-count-rec;
                   //     tinted: false;
                   //     active: filter-recents;
                   //     visible: false;
                   //     clicked => {
                   //         root.filter-recents = !filter-recents;
                   //         root.filter-category = -1;
                   //     }
                   // }

                    FilterChip {
                        label: "◆ Components";
                        count: cat-count-grp;
                        tint: Theme.cat-component;
                        active: filter-components;
                        clicked => {
                            root.filter-components = !filter-components;
                            root.filter-recents = false;
                            root.fcat-pre = false;
                            root.fcat-seg = false;
                            root.fcat-obj = false;
                            root.fcat-mea = false;
                            root.fcat-cls = false;
                            root.fcat-dat = false;
                            root.query-changed(query);
                        }
                    }
                }

                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border-soft;
                }
            }

            // ---------- 4. Body - split list + detail ----------
        Rectangle {
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: 0;
                    alignment: stretch;

                    // LIST
                Rectangle {
                        width: PickerStyle.list-col-w;
                        background: Theme.panel;
                   // border-right-width: 0;

                    ScrollView {
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 12px;
                                spacing: 0;

                                // Empty state
                            if total-shown == 0 && !filter-components: VerticalLayout {
                                    padding-top: 60px;
                                    spacing: 10px;
                                    Text {
                                        text: "No commands match";
                                        color: Theme.text-dim;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: query == "" ? "Try a different filter" : "Try a different query";
                                        color: Theme.text-mute;
                                        font-size: 10.5px;
                                        font-family: Theme.font-mono;
                                        horizontal-alignment: center;
                                    }
                                }

                                // Preprocess
                            if shown-preprocess.length > 0 && !filter-components: VerticalLayout {
                                    spacing: 0;
                                    SectionHeader {
                                        category: StepCategory.preprocess;
                                        count: shown-preprocess.length;
                                    }

                                    for c in shown-preprocess: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }
                                }

                                // Segment
                            if shown-segment.length > 0 && !filter-components: VerticalLayout {
                                    spacing: 0;
                                    SectionHeader {
                                        category: StepCategory.segment;
                                        count: shown-segment.length;
                                    }

                                    for c in shown-segment: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }

                                    // Auto-configure an AI segmentation command from a
                                    // downloaded bioimage.io model's rdf.yaml.
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-top: 6px;
                                        padding-bottom: 4px;
                                        alignment: start;
                                        AppButton {
                                            text: "Import bioimage.io model…";
                                            clicked => {
                                                root.import-bioimageio();
                                            }
                                        }
                                    }
                                }

                                // Instance Segmentation
                            if shown-object.length > 0 && !filter-components: VerticalLayout {
                                    spacing: 0;
                                    SectionHeader {
                                        category: StepCategory.instance-segmentation;
                                        count: shown-object.length;
                                    }

                                    for c in shown-object: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }
                                }

                                // Measure
                            if shown-measure.length > 0 && !filter-components: VerticalLayout {
                                    spacing: 0;
                                    SectionHeader {
                                        category: StepCategory.measure;
                                        count: shown-measure.length;
                                    }

                                    for c in shown-measure: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }
                                }

                                // Object
                            if shown-classify.length > 0 && !filter-components: VerticalLayout {
                                    spacing: 0;
                                    SectionHeader {
                                        category: StepCategory.object;
                                        count: shown-classify.length;
                                    }

                                    for c in shown-classify: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }
                                }

                                // Dataset
                            if shown-dataset.length > 0 && !filter-components: VerticalLayout {
                                    spacing: 0;
                                    SectionHeader {
                                        category: StepCategory.dataset;
                                        count: shown-dataset.length;
                                    }

                                    for c in shown-dataset: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }
                                }

                                // Components: the chip lists the project's components; without it,
                                // a search lists the matching ones too.
                            if (filter-components || query != "") : VerticalLayout {
                                    spacing: 0;

                                    if filter-components && unused-component-count > 0: Rectangle {
                                        height: 30px;
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 8px;
                                            Text {
                                                text: unused-component-count == 1 ? "1 component no pipeline uses" : "\{unused-component-count} components no pipeline uses";
                                                color: Theme.text-mute;
                                                font-size: 10.5px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }

                                            Rectangle {
                                                width: 70px;
                                                height: 22px;
                                                y: (parent.height - 22px) / 2;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                background: remove-unused-ta.has-hover ? Theme.raised : transparent;
                                                Text {
                                                    text: "Remove";
                                                    color: Theme.text-dim;
                                                    font-size: 10.5px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                remove-unused-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.remove-unused-components();
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if filter-components && shown-components.length == 0 && shown-library-components.length == 0: VerticalLayout {
                                        padding-top: 60px;
                                        spacing: 10px;
                                        Text {
                                            text: query == "" ? "No components in this project" : "No component matches";
                                            color: Theme.text-dim;
                                            font-size: 12px;
                                            horizontal-alignment: center;
                                        }

                                        Text {
                                            text: "A component is a step made of other steps";
                                            color: Theme.text-mute;
                                            font-size: 10.5px;
                                            font-family: Theme.font-mono;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    if shown-components.length > 0: Rectangle {
                                        height: 28px;
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 8px;
                                            alignment: start;
                                            Rectangle {
                                                width: 3px;
                                                height: 10px;
                                                background: Theme.cat-component;
                                                border-radius: 1.5px;
                                                y: (parent.height - 10px) / 2;
                                            }

                                            Text {
                                                text: filter-components ? "IN THIS PROJECT" : "COMPONENTS";
                                                color: Theme.cat-component;
                                                font-size: 10px;
                                                font-weight: 600;
                                                letter-spacing: 0.6px;
                                                vertical-alignment: center;
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }

                                            Text {
                                                text: "\{shown-components.length}";
                                                color: Theme.text-mute;
                                                font-size: 10px;
                                                font-family: Theme.font-mono;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    for c in shown-components: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }

                                    if shown-library-components.length > 0: Rectangle {
                                        height: 28px;
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 8px;
                                            alignment: start;
                                            Rectangle {
                                                width: 3px;
                                                height: 10px;
                                                background: Theme.cat-component.with-alpha(0.6);
                                                border-radius: 1.5px;
                                                y: (parent.height - 10px) / 2;
                                            }

                                            Text {
                                                text: "LIBRARY";
                                                color: Theme.cat-component;
                                                font-size: 10px;
                                                font-weight: 600;
                                                letter-spacing: 0.6px;
                                                vertical-alignment: center;
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }

                                            Text {
                                                text: "\{shown-library-components.length}";
                                                color: Theme.text-mute;
                                                font-size: 10px;
                                                font-family: Theme.font-mono;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    for c in shown-library-components: CommandRow {
                                        cmd: c;
                                        selected: c.id == selected-id;
                                        clicked => {
                                            root.selected-id = c.id;
                                            root.select(c.id);
                                        }
                                        double-clicked => {
                                            root.confirm(c.id);
                                        }
                                        toggle-favorite => {
                                            root.toggle-favorite(c.id);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Splitter
                Rectangle {
                        width: 1px;
                        background: Theme.border-soft;
                    }

                    // DETAIL
                DetailPane {
                        horizontal-stretch: 1;
                        cmd: root.detail;
                        has-selection: root.has-detail;
                        removable: root.detail-removable;
                        remove => {
                            root.remove-component(root.detail.id);
                        }
                    }
                }
            }

            // ---------- 5. Footer ----------
            Rectangle {
                height: 1px;
                background: Theme.border-soft;
            }

            DialogFooter {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 14px;
                padding-bottom: 20px;

                AppButton {
                    text: "Cancel";
                    clicked => {
                        root.cancel();
                    }
                }

                AppButton {
                    text: "Add to pipeline";
                    primary: true;
                    clicked => {
                        root.confirm(root.selected-id);
                    }
                }
            }
        }
    }

    init => {
        kbd.focus();
    }
}

// ===========================================================================
// Modal wrapper - convenience element you can place inside MainWindow with
// `visible <=> showing-add-step`. Adds the scrim + click-outside-to-close.
// ===========================================================================

export component CommandPickerModal inherits Rectangle {
    in property <[CommandDef]> commands;
    in property <string> target-pipeline;
    in property <int> insert-after-idx;
    in property <int> total-steps;

    in property <[CommandDef]> shown-preprocess;
    in property <[CommandDef]> shown-segment;
    in property <[CommandDef]> shown-object;
    in property <[CommandDef]> shown-classify;
    in property <[CommandDef]> shown-dataset;
    in property <[CommandDef]> shown-measure;
    in property <[CommandDef]> shown-components;
    in property <[CommandDef]> shown-library-components;
    in property <CommandDef> detail;
    in property <bool> has-detail;
    in property <int> total-shown;
    in property <int> cat-count-pre;
    in property <int> cat-count-seg;
    in property <int> cat-count-obj;
    in property <int> cat-count-cls;
    in property <int> cat-count-dat;
    in property <int> cat-count-mea;
    in property <int> cat-count-grp;
    /// The project's components no pipeline uses ("Remove N unused").
    in property <int> unused-component-count;
    /// The selected entry is a project component no pipeline uses.
    in property <bool> detail-removable;
    in property <int> cat-count-rec;

    in-out property <string> query: "";
    in-out property <bool> fcat-pre: false;
    in-out property <bool> fcat-seg: false;
    in-out property <bool> fcat-obj: false;
    in-out property <bool> fcat-mea: false;
    in-out property <bool> fcat-cls: false;
    in-out property <bool> fcat-dat: false;
    in-out property <bool> filter-components: false;
    in-out property <bool> filter-recents: false;
    in-out property <int> selected-id: -1;

    callback query-changed(string);
    callback select(int);
    callback toggle-favorite(int);
    callback confirm(int);
    callback remove-component(int);
    callback remove-unused-components();
    callback cancel();
    callback import-bioimageio();

    // The dialog brings its own backdrop; a click on it cancels.
    CommandSelectionDialog {
        width: 100%;
        height: 100%;
        close-on-backdrop: true;
        commands: root.commands;
        target-pipeline: root.target-pipeline;
        insert-after-idx: root.insert-after-idx;
        total-steps: root.total-steps;
        shown-preprocess: root.shown-preprocess;
        shown-segment: root.shown-segment;
        shown-object: root.shown-object;
        shown-classify: root.shown-classify;
        shown-dataset: root.shown-dataset;
        shown-measure: root.shown-measure;
        shown-components: root.shown-components;
        shown-library-components: root.shown-library-components;
        detail: root.detail;
        has-detail: root.has-detail;
        total-shown: root.total-shown;
        cat-count-pre: root.cat-count-pre;
        cat-count-seg: root.cat-count-seg;
        cat-count-obj: root.cat-count-obj;
        cat-count-cls: root.cat-count-cls;
        cat-count-dat: root.cat-count-dat;
        cat-count-mea: root.cat-count-mea;
        cat-count-grp: root.cat-count-grp;
        unused-component-count: root.unused-component-count;
        detail-removable: root.detail-removable;
        cat-count-rec: root.cat-count-rec;
        query <=> root.query;
        fcat-pre <=> root.fcat-pre;
        fcat-seg <=> root.fcat-seg;
        fcat-obj <=> root.fcat-obj;
        fcat-mea <=> root.fcat-mea;
        fcat-cls <=> root.fcat-cls;
        fcat-dat <=> root.fcat-dat;
        filter-components <=> root.filter-components;
        filter-recents <=> root.filter-recents;
        selected-id <=> root.selected-id;

        query-changed(t) => {
            root.query-changed(t);
        }
        select(id) => {
            root.select(id);
        }
        toggle-favorite(id) => {
            root.toggle-favorite(id);
        }
        confirm(id) => {
            root.confirm(id);
        }
        remove-component(id) => {
            root.remove-component(id);
        }
        remove-unused-components => {
            root.remove-unused-components();
        }
        cancel => {
            root.cancel();
        }
        import-bioimageio => {
            root.import-bioimageio();
        }
    }
}
