import { HorizontalBox } from "std-widgets.slint";
import { GlobalAppState, HistogramState, ConnectionState } from "state.slint";
import { Theme } from "style.slint";
import {
    ViewportState,
    ViewportObjectState,
} from "editor/viewport_state.slint";
import { ImageMetaData } from "editor/image_meta_panel.slint";


export component StatusBar inherits Rectangle {
    // Properties to be set from Rust
    in property <string> status: "Ready";
    in property <int> objects: 0;
    in property <string> resolution: "0x0";
    in property <string> timing: "0ms";

    height: 38px;

    pure function get_state(is_ready: bool, is_drawing: bool) -> string {
        if is-drawing {
            return "Draw";
        }
        if !is-ready {
            return "Busy";
        }
        return root.status;
    }

    HorizontalBox {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        // Where the work happens. Always visible; coloured when on a server
        // so local and remote windows can't be mixed up, and in the warning
        // colour when the connection is lost or not secure (unencrypted, or
        // the server's certificate unchecked). Icon + text, not just colour.
        badge := Rectangle {
            property <bool> secure: ConnectionState.encrypted && ConnectionState.verified;
            property <bool> fine: ConnectionState.connected && self.secure;
            vertical-stretch: 0;
            height: 22px;
            border-radius: 4px;
            background: !ConnectionState.remote ? transparent
                : self.fine ? Theme.accent : Theme.warn;
            border-width: ConnectionState.remote ? 0px : 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Image {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    source: !ConnectionState.remote ? @image-url("icons/regular-black/desktop.svg")
                        : ConnectionState.connected ? @image-url("icons/regular-black/cloud.svg")
                        : @image-url("icons/regular-black/cloud-slash.svg");
                    colorize: !ConnectionState.remote ? Theme.text-dim
                        : badge.fine ? #FFFFFF : #000000;
                }
                // Lock: encrypted and verified. Open lock: unencrypted.
                // Shield with warning: encrypted, certificate unchecked.
                if ConnectionState.remote: Image {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    source: !ConnectionState.encrypted ? @image-url("icons/regular-black/lock-open.svg")
                        : !ConnectionState.verified ? @image-url("icons/regular-black/shield-warning.svg")
                        : @image-url("icons/regular-black/lock.svg");
                    colorize: badge.fine ? #FFFFFF : #000000;
                }
                Text {
                    text: !ConnectionState.remote ? ConnectionState.label
                        : !ConnectionState.connected ? ConnectionState.label + " - disconnected"
                        : !ConnectionState.encrypted ? ConnectionState.label + " - unencrypted"
                        : !ConnectionState.verified ? ConnectionState.label + " - server not verified"
                        : ConnectionState.label;
                    font-size: 11px;
                    font-weight: ConnectionState.remote ? 600 : 400;
                    vertical-alignment: center;
                    color: !ConnectionState.remote ? Theme.text-dim
                        : badge.fine ? #FFFFFF : #000000;
                }
            }
        }

        // Status Message
        Text {
            text: get_state(ViewportState.high_res_ready, ViewportObjectState.is_drawing) + " / " + ImageMetaData.image_name;
            font-size: 11px;
            vertical-alignment: center;
        }

        // Flex Spacer
        Rectangle { }

        // Object Count with icon-like color
        Text {
            text: "Objects: \{root.objects}";
            font-size: 11px;
            vertical-alignment: center;
        }

        // Vertical Separator
        Rectangle {
            width: 1px;
            height: 14px;
        }

        // Image Details
        Text {
            text: root.resolution;
            font-size: 11px;
            vertical-alignment: center;
        }

        // Vertical Separator
        Rectangle {
            width: 1px;
            height: 14px;
        }

        // Execution Timing
        Text {
            text: root.timing;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}
