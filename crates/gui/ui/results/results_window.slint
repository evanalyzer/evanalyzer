import { Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "../style.slint";
import { ToolToggleButton } from "../components/toggle_button.slint";
import { VerticalDivider } from "../components/divider.slint";
import {
    ResultsTable,
    ResultsState,
    ResultsViewMode,
    ResultsGroupBy,
    ResultsChartKind,
    ResultsColumnDef,
    ResultsRow,
    FilterItem,
} from "results_table.slint";
import { ResultsChart } from "results_chart.slint";
import { FrameStepper } from "frame_stepper.slint";
import { ExportDialog } from "export_dialog.slint";
export {
    ResultsState,
    ResultsViewMode,
    ResultsGroupBy,
    ResultsChartKind,
    ResultsColumnDef,
    ResultsRow,
    FilterItem,
    ExportBatchItem,
}from "results_table.slint";


// -- Radio-style option row (used in the group-by popup) ----------------------

component GroupOptionRow inherits TouchArea {
    in property <string> label;
    in property <bool> selected: false;
    // false = radio (single choice), true = checkbox (multi-select)
    in property <bool> checkbox: false;
    height: 26px;
    mouse-cursor: pointer;

    Rectangle {
        background: root.has-hover ? Theme.raised : transparent;
        animate background { duration: 80ms; }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 6px;
            spacing: 7px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 13px;
                    height: 13px;
                    border-radius: root.checkbox ? 2px : 6.5px;
                    border-width: 1.5px;
                    border-color: root.selected ? Theme.accent : Theme.border;
                    background: root.selected ? Theme.accent : transparent;

                    // Checkbox tick
                    if root.selected && root.checkbox: Image {
                        source: @image-url("../icons/regular-black/check.svg");
                        width: 9px;
                        height: 9px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: white;
                    }
                    // Radio dot
                    if root.selected && !root.checkbox: Rectangle {
                        width: 5px;
                        height: 5px;
                        border-radius: 2.5px;
                        background: white;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            Text {
                text: root.label;
                font-size: 11px;
                font-family: Theme.font-mono;
                color: root.selected ? Theme.text-dim : Theme.text-mute;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }
}

// -- Ribbon-style labeled dropdown button -------------------------------------

component RibbonButton inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color:Theme.text;
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 36px;
    border-radius: 6px;
//    background: root.active ? Theme.hover : (ta.has-hover ? Theme.hover : Theme.bg);

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 5px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.icon-color;
            }
        }

        Text {
            text: root.label;
            font-size: 11px;
            font-family: Theme.font-sans;
            color: Theme.text-dim;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../icons/regular-black/caret-down.svg");
                width: 8px;
                height: 8px;
                colorize: Theme.text-mute;
            }
        }
    }
}

// -- Toolbar -------------------------------------------------------------------

component ResultsToolbar inherits Rectangle {
    height: 48px;
    background: Theme.bg;

    // Preset 1: group by image name + class, avg + sum only
    property <bool> quick-preset1-active:
        ResultsState.group_active &&
        ResultsState.group_by == ResultsGroupBy.image &&
        ResultsState.group_by_class &&
        ResultsState.group_agg_avg &&
        ResultsState.group_agg_sum &&
        !ResultsState.group_agg_min &&
        !ResultsState.group_agg_max &&
        !ResultsState.group_agg_median &&
        !ResultsState.group_agg_stdev;
    // Preset 2: group by regex on image name + class, avg + sum only
    property <bool> quick-preset2-active:
        ResultsState.group_active &&
        ResultsState.group_by == ResultsGroupBy.regex &&
        ResultsState.group_by_class &&
        ResultsState.group_agg_avg &&
        ResultsState.group_agg_sum &&
        !ResultsState.group_agg_min &&
        !ResultsState.group_agg_max &&
        !ResultsState.group_agg_median &&
        !ResultsState.group_agg_stdev;
    // Preset 3: no grouping active
    property <bool> quick-preset3-active: !ResultsState.group_active;
    // Manual: grouping active but doesn't match any quick preset.
    // Gated on pending-preset == 0 so a preset click's in-flight Rust round-trip
    // (where group_active is still true but group_by changed) doesn't briefly
    // satisfy this condition and flash "Custom settings…" as selected.
    property <bool> quick-manual-active:
        root.pending-preset == 0 &&
        ResultsState.group_active &&
        !root.quick-preset1-active &&
        !root.quick-preset2-active;
    // Optimistic pending state: set on click so the button lights up immediately
    // while Rust is still computing the grouped result (group_active lags behind).
    property <int> pending-preset: 0;
    changed quick-preset1-active => {
        if (root.quick-preset1-active) { root.pending-preset = 0; ResultsState.group_computing = false; }
    }
    changed quick-preset2-active => {
        if (root.quick-preset2-active) { root.pending-preset = 0; ResultsState.group_computing = false; }
    }
    changed quick-preset3-active => {
        if (root.quick-preset3-active) { root.pending-preset = 0; ResultsState.group_computing = false; }
    }

    HorizontalLayout {
        padding-top: 5px;
        padding-left: 4px;
        padding-right: 8px;
        padding-bottom: 5px;
        spacing: 2px;

        // -- Column visibility (funnel icon opens popup) -----------------------
        col-vis-btn := Rectangle {
            width: 96px;
            height: 36px;
            property <bool> col-popup-open: false;

            RibbonButton {
                icon: @image-url("../icons/regular-black/funnel.svg");
                label: "Columns";
                icon-color: #2b2b2b;
                clicked => {
                    col-vis-btn.col-popup-open = true;
                    col-filter-popup.show();
                }
            }

            col-filter-popup := PopupWindow {
                x: 0px;
                y: col-vis-btn.height + 2px;
                width: 230px;
                height: 320px;
                close-policy: no-auto-close;

                Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #00000036;
                    drop-shadow-offset-y: 4px;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;

                        // -- Search field --------------------------------------
                        Rectangle {
                            height: 34px;
                            background: Theme.bg;

                            HorizontalLayout {
                                padding: 4px;
                                spacing: 4px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 26px;
                                    background: Theme.bg;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    clip: true;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 4px;
                                        spacing: 5px;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../icons/regular-black/magnifying-glass.svg");
                                                width: 11px;
                                                height: 11px;
                                                colorize: Theme.text-mute;
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;

                                            col-search-input := TextInput {
                                                width: parent.width;
                                                font-size: 11px;
                                                font-family: Theme.font-mono;
                                                color: Theme.text;
                                                vertical-alignment: center;
                                                edited => {
                                                    ResultsState.column_search_changed(self.text);
                                                }
                                            }

                                            if col-search-input.text == "": Text {
                                                x: 0px;
                                                y: (parent.height - self.height) / 2;
                                                text: "Search…";
                                                font-size: 11px;
                                                color: Theme.text-faint;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        // -- (Select All) --------------------------------------
                        col-sel-all-ta := TouchArea {
                            height: 26px;
                            mouse-cursor: pointer;
                            clicked => {
                                if (ResultsState.column_popup_all_checked) {
                                    ResultsState.column_clear_all();
                                } else {
                                    ResultsState.column_select_all();
                                }
                            }

                            Rectangle {
                                background: col-sel-all-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 6px;
                                    spacing: 7px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 13px;
                                            height: 13px;
                                            border-radius: 2px;
                                            border-width: 1.5px;
                                            border-color: ResultsState.column_popup_all_checked ? Theme.accent : Theme.border;
                                            background: ResultsState.column_popup_all_checked ? Theme.accent : transparent;

                                            if ResultsState.column_popup_all_checked: Image {
                                                source: @image-url("../icons/regular-black/check.svg");
                                                width: 9px;
                                                height: 9px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                colorize: white;
                                            }
                                        }
                                    }

                                    Text {
                                        text: "(Select All)";
                                        font-size: 11px;
                                        font-family: Theme.font-mono;
                                        font-weight: 600;
                                        color: ResultsState.column_popup_all_checked ? Theme.text-dim : Theme.text-mute;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        // -- Item list -----------------------------------------
                        ScrollView {
                            vertical-stretch: 1;

                            VerticalLayout {
                                padding: 2px;
                                spacing: 0px;

                                for item in (col-vis-btn.col-popup-open ? ResultsState.column_popup : []): VerticalLayout {
                                    spacing: 0px;

                                    // -- Section header (e.g. "Intensity") — click toggles every
                                    // column in this section at once, so the user doesn't have to
                                    // untick each channel column one by one.
                                    if item.group_header: group-header-ta := TouchArea {
                                        height: 24px;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            ResultsState.column_group_toggle(item.group);
                                        }

                                        Rectangle {
                                            background: group-header-ta.has-hover ? Theme.raised : Theme.bg;
                                            animate background { duration: 80ms; }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 6px;
                                                spacing: 7px;
                                                alignment: start;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 13px;
                                                        height: 13px;
                                                        border-radius: 2px;
                                                        border-width: 1.5px;
                                                        border-color: item.group_all_checked ? Theme.accent : Theme.border;
                                                        background: item.group_all_checked ? Theme.accent : transparent;

                                                        if item.group_all_checked: Image {
                                                            source: @image-url("../icons/regular-black/check.svg");
                                                            width: 9px;
                                                            height: 9px;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            colorize: white;
                                                        }
                                                    }
                                                }

                                                Text {
                                                    text: item.group;
                                                    font-size: 10px;
                                                    font-family: Theme.font-sans;
                                                    font-weight: 700;
                                                    color: Theme.text-mute;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }
                                    }

                                    col-item-ta := TouchArea {
                                        height: 26px;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            ResultsState.column_label_toggled(item.label);
                                        }

                                        Rectangle {
                                            background: col-item-ta.has-hover ? Theme.raised : transparent;
                                            animate background { duration: 80ms; }

                                            HorizontalLayout {
                                                padding-left: item.group != "" ? 18px : 8px;
                                                padding-right: 6px;
                                                spacing: 7px;
                                                alignment: start;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 13px;
                                                        height: 13px;
                                                        border-radius: 2px;
                                                        border-width: 1.5px;
                                                        border-color: item.checked ? Theme.accent : Theme.border;
                                                        background: item.checked ? Theme.accent : transparent;

                                                        if item.checked: Image {
                                                            source: @image-url("../icons/regular-black/check.svg");
                                                            width: 9px;
                                                            height: 9px;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            colorize: white;
                                                        }
                                                    }
                                                }

                                                Text {
                                                    text: item.label;
                                                    font-size: 11px;
                                                    font-family: Theme.font-mono;
                                                    color: item.checked ? Theme.text-dim : Theme.text-mute;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        // -- Done button ---------------------------------------
                        col-done-ta := TouchArea {
                            height: 28px;
                            mouse-cursor: pointer;
                            clicked => {
                                ResultsState.column_filter_apply();
                                col-vis-btn.col-popup-open = false;
                                col-filter-popup.close();
                            }

                            Rectangle {
                                background: col-done-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Done";
                                        font-size: 11px;
                                        font-family: Theme.font-sans;
                                        color: Theme.accent;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // -- Group by ribbon dropdown ------------------------------------------
        group-ribbon-btn := Rectangle {
            width: 110px;
            height: 36px;

            RibbonButton {
                icon-color: #006039;
                icon: (root.pending-preset == 1 || root.quick-preset1-active)
                    ? @image-url("../icons/regular-black/image.svg")
                    : ((root.pending-preset == 2 || root.quick-preset2-active)
                    ? @image-url("../icons/regular-black/asterisk.svg")
                    : ((root.pending-preset == 3 || root.quick-preset3-active)
                    ? @image-url("../icons/regular-black/stack-minus.svg")
                    : (root.quick-manual-active
                    ? @image-url("../icons/regular-black/sliders-horizontal.svg")
                    : @image-url("../icons/regular-black/stack.svg"))));
                label: "Group by";
                active: ResultsState.group_active || root.pending-preset != 0;
                clicked => { group-quick-popup.show(); }
            }

            // Quick-pick dropdown: 3 presets + separator + custom settings
            group-quick-popup := PopupWindow {
                x: 0px;
                y: group-ribbon-btn.height + 2px;
                width: 230px;
                close-policy: close-on-click-outside;

                Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #00000036;
                    drop-shadow-offset-y: 4px;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;
                        padding: 4px;

                        // Preset 1: Image name + class
                        p1-ta := TouchArea {
                            height: 28px;
                            mouse-cursor: pointer;
                            clicked => {
                                ResultsState.group_computing = true;
                                root.pending-preset = 1;
                                ResultsState.clear_all_filters();
                                ResultsState.group_by = ResultsGroupBy.image;
                                ResultsState.group_agg_min = false;
                                ResultsState.group_agg_max = false;
                                ResultsState.group_agg_avg = true;
                                ResultsState.group_agg_median = false;
                                ResultsState.group_agg_stdev = false;
                                ResultsState.group_agg_sum = true;
                                ResultsState.group_split_colocalized = false;
                                ResultsState.group_by_class = true;
                                ResultsState.group_apply();
                                group-quick-popup.close();
                            }

                            Rectangle {
                                border-radius: 4px;
                                background: p1-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 14px;
                                        Image {
                                            source: @image-url("../icons/regular-black/check.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: Theme.accent;
                                            opacity: (root.quick-preset1-active || root.pending-preset == 1) ? 1.0 : 0.0;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 18px;
                                        Image {
                                            source: @image-url("../icons/regular-black/image.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: (root.quick-preset1-active || root.pending-preset == 1) ? Theme.accent : Theme.text-dim;
                                        }
                                    }

                                    Text {
                                        text: "Image name + class";
                                        font-size: 11px;
                                        font-family: Theme.font-sans;
                                        color: (root.quick-preset1-active || root.pending-preset == 1) ? Theme.accent : Theme.text-dim;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }

                        // Preset 2: Regex on name + class
                        p2-ta := TouchArea {
                            height: 28px;
                            mouse-cursor: pointer;
                            clicked => {
                                ResultsState.group_computing = true;
                                root.pending-preset = 2;
                                ResultsState.clear_all_filters();
                                ResultsState.group_by = ResultsGroupBy.regex;
                                ResultsState.group_agg_min = false;
                                ResultsState.group_agg_max = false;
                                ResultsState.group_agg_avg = true;
                                ResultsState.group_agg_median = false;
                                ResultsState.group_agg_stdev = false;
                                ResultsState.group_agg_sum = true;
                                ResultsState.group_split_colocalized = false;
                                ResultsState.group_by_class = true;
                                ResultsState.group_apply();
                                group-quick-popup.close();
                            }

                            Rectangle {
                                border-radius: 4px;
                                background: p2-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 14px;
                                        Image {
                                            source: @image-url("../icons/regular-black/check.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: Theme.accent;
                                            opacity: (root.quick-preset2-active || root.pending-preset == 2) ? 1.0 : 0.0;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 18px;
                                        Image {
                                            source: @image-url("../icons/regular-black/asterisk.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: (root.quick-preset2-active || root.pending-preset == 2) ? Theme.accent : Theme.text-dim;
                                        }
                                    }

                                    Text {
                                        text: "Regex on name + class";
                                        font-size: 11px;
                                        font-family: Theme.font-sans;
                                        color: (root.quick-preset2-active || root.pending-preset == 2) ? Theme.accent : Theme.text-dim;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }

                        // Preset 3: No grouping
                        p3-ta := TouchArea {
                            height: 28px;
                            mouse-cursor: pointer;
                            clicked => {
                                ResultsState.group_computing = true;
                                root.pending-preset = 3;
                                ResultsState.group_by = ResultsGroupBy.none;
                                ResultsState.group_apply();
                                group-quick-popup.close();
                            }

                            Rectangle {
                                border-radius: 4px;
                                background: p3-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 14px;
                                        Image {
                                            source: @image-url("../icons/regular-black/check.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: Theme.accent;
                                            opacity: (root.quick-preset3-active || root.pending-preset == 3) ? 1.0 : 0.0;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 18px;
                                        Image {
                                            source: @image-url("../icons/regular-black/stack-minus.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: (root.quick-preset3-active || root.pending-preset == 3) ? Theme.accent : Theme.text-dim;
                                        }
                                    }

                                    Text {
                                        text: "No grouping";
                                        font-size: 11px;
                                        font-family: Theme.font-sans;
                                        color: (root.quick-preset3-active || root.pending-preset == 3) ? Theme.accent : Theme.text-dim;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        // Custom settings (opens the detailed popup)
                        custom-ta := TouchArea {
                            height: 28px;
                            mouse-cursor: pointer;
                            clicked => {
                                group-quick-popup.close();
                                group-settings-popup.show();
                            }

                            Rectangle {
                                border-radius: 4px;
                                background: custom-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 14px;
                                        Image {
                                            source: @image-url("../icons/regular-black/check.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: Theme.accent;
                                            opacity: root.quick-manual-active ? 1.0 : 0.0;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 18px;
                                        Image {
                                            source: @image-url("../icons/regular-black/sliders-horizontal.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: root.quick-manual-active ? Theme.accent : Theme.text-dim;
                                        }
                                    }

                                    Text {
                                        text: "Custom settings…";
                                        font-size: 11px;
                                        font-family: Theme.font-sans;
                                        color: root.quick-manual-active ? Theme.accent : Theme.text-dim;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Detailed custom group settings (all knobs — same content as before)
            group-settings-popup := PopupWindow {
                x: 0px;
                y: group-ribbon-btn.height + 2px;
                width: 250px;
                height: 467px;
                close-policy: no-auto-close;

                Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #00000036;
                    drop-shadow-offset-y: 4px;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 26px;
                            background: Theme.bg;
                            Text {
                                x: 8px;
                                text: "Group by";
                                font-size: 11px;
                                font-family: Theme.font-sans;
                                font-weight: 600;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        GroupOptionRow {
                            label: "None";
                            selected: ResultsState.group_by == ResultsGroupBy.none;
                            clicked => { ResultsState.group_by = ResultsGroupBy.none; }
                        }

                        GroupOptionRow {
                            label: "Image name";
                            selected: ResultsState.group_by == ResultsGroupBy.image;
                            clicked => { ResultsState.group_by = ResultsGroupBy.image; }
                        }

                        GroupOptionRow {
                            label: "Folder name";
                            selected: ResultsState.group_by == ResultsGroupBy.folder;
                            clicked => { ResultsState.group_by = ResultsGroupBy.folder; }
                        }

                        GroupOptionRow {
                            label: "Regex on image name";
                            selected: ResultsState.group_by == ResultsGroupBy.regex;
                            clicked => { ResultsState.group_by = ResultsGroupBy.regex; }
                        }

                        GroupOptionRow {
                            label: "Also group by class";
                            checkbox: true;
                            selected: ResultsState.group_by_class;
                            clicked => { ResultsState.group_by_class = !ResultsState.group_by_class; }
                        }

                        Rectangle {
                            height: 36px;
                            background: Theme.bg;
                            HorizontalLayout {
                                padding: 4px;
                                padding-left: 26px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 26px;
                                    background: ResultsState.group_by == ResultsGroupBy.regex ? Theme.bg : Theme.panel;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    clip: true;
                                    opacity: ResultsState.group_by == ResultsGroupBy.regex ? 1.0 : 0.5;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 4px;

                                        Rectangle {
                                            horizontal-stretch: 1;

                                            regex-input := TextInput {
                                                width: parent.width;
                                                font-size: 11px;
                                                font-family: Theme.font-mono;
                                                color: Theme.text;
                                                vertical-alignment: center;
                                                enabled: ResultsState.group_by == ResultsGroupBy.regex;
                                                text: ResultsState.group_regex;
                                                edited => { ResultsState.group_regex = self.text; }
                                            }

                                            if regex-input.text == "": Text {
                                                x: 0px;
                                                y: (parent.height - self.height) / 2;
                                                text: "^([A-Z]\\d+)_";
                                                font-size: 11px;
                                                font-family: Theme.font-mono;
                                                color: Theme.text-faint;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 26px;
                            background: Theme.bg;
                            Text {
                                x: 8px;
                                text: "Aggregate";
                                font-size: 11px;
                                font-family: Theme.font-sans;
                                font-weight: 600;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 0px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                GroupOptionRow {
                                    label: "Min";
                                    checkbox: true;
                                    selected: ResultsState.group_agg_min;
                                    clicked => { ResultsState.group_agg_min = !ResultsState.group_agg_min; }
                                }

                                GroupOptionRow {
                                    label: "Max";
                                    checkbox: true;
                                    selected: ResultsState.group_agg_max;
                                    clicked => { ResultsState.group_agg_max = !ResultsState.group_agg_max; }
                                }

                                GroupOptionRow {
                                    label: "Average";
                                    checkbox: true;
                                    selected: ResultsState.group_agg_avg;
                                    clicked => { ResultsState.group_agg_avg = !ResultsState.group_agg_avg; }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                GroupOptionRow {
                                    label: "Median";
                                    checkbox: true;
                                    selected: ResultsState.group_agg_median;
                                    clicked => { ResultsState.group_agg_median = !ResultsState.group_agg_median; }
                                }

                                GroupOptionRow {
                                    label: "Std. dev.";
                                    checkbox: true;
                                    selected: ResultsState.group_agg_stdev;
                                    clicked => { ResultsState.group_agg_stdev = !ResultsState.group_agg_stdev; }
                                }

                                GroupOptionRow {
                                    label: "Sum";
                                    checkbox: true;
                                    selected: ResultsState.group_agg_sum;
                                    clicked => { ResultsState.group_agg_sum = !ResultsState.group_agg_sum; }
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        Rectangle {
                            height: 26px;
                            background: Theme.bg;
                            Text {
                                x: 8px;
                                text: "Split";
                                font-size: 11px;
                                font-family: Theme.font-sans;
                                font-weight: 600;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        GroupOptionRow {
                            label: "Colocalized / not colocalized";
                            checkbox: true;
                            selected: ResultsState.group_split_colocalized;
                            clicked => { ResultsState.group_split_colocalized = !ResultsState.group_split_colocalized; }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        apply-ta := TouchArea {
                            height: 30px;
                            mouse-cursor: pointer;
                            clicked => {
                                root.pending-preset = 0;
                                ResultsState.group_computing = true;
                                ResultsState.group_apply();
                                group-settings-popup.close();
                            }

                            Rectangle {
                                background: apply-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }
                                Text {
                                    text: "Apply";
                                    font-size: 11px;
                                    font-family: Theme.font-sans;
                                    color: Theme.accent;
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        VerticalDivider { }

        // -- View mode ribbon dropdown -----------------------------------------
        view-ribbon-btn := Rectangle {
            width: 80px;
            height: 36px;

            RibbonButton {
                // Icon tracks the active selection so the user sees what's shown at a glance.
                icon: ResultsState.view_mode == ResultsViewMode.table
                    ? @image-url("../icons/regular-black/table.svg")
                    : (ResultsState.view_mode == ResultsViewMode.coloc_table
                    ? @image-url("../icons/regular-black/intersect-three.svg")
                    : (ResultsState.chart_kind == ResultsChartKind.histogram
                    ? @image-url("../icons/regular-black/chart-bar.svg")
                    : (ResultsState.chart_kind == ResultsChartKind.scatter
                    ? @image-url("../icons/regular-black/chart-scatter.svg")
                    : @image-url("../icons/regular-black/grid-four.svg"))));
                label: "View";
                icon-color: #4A90E2;
                active: ResultsState.view_mode == ResultsViewMode.chart
                     || ResultsState.view_mode == ResultsViewMode.coloc_table;
                clicked => { view-popup.show(); }
            }

            view-popup := PopupWindow {
                x: 0px;
                y: view-ribbon-btn.height + 2px;
                width: 180px;
                close-policy: close-on-click-outside;

                Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #00000036;
                    drop-shadow-offset-y: 4px;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;
                        padding: 4px;

                        // Table
                        vt-ta := TouchArea {
                            height: 28px;
                            mouse-cursor: pointer;
                            clicked => {
                                // When leaving coloc_table, trigger a normal reload to
                                // restore per-ROI columns/rows (group_apply re-uses the
                                // current group config, which may be none = plain table).
                                if (ResultsState.view_mode == ResultsViewMode.coloc_table) {
                                    ResultsState.loading_more = true;
                                    ResultsState.group_apply();
                                }
                                ResultsState.view_mode = ResultsViewMode.table;
                                view-popup.close();
                            }

                            Rectangle {
                                border-radius: 4px;
                                background: vt-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 14px;
                                        Image {
                                            source: @image-url("../icons/regular-black/check.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: Theme.accent;
                                            opacity: ResultsState.view_mode == ResultsViewMode.table ? 1.0 : 0.0;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 18px;
                                        Image {
                                            source: @image-url("../icons/regular-black/table.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: ResultsState.view_mode == ResultsViewMode.table ? Theme.accent : Theme.text-dim;
                                        }
                                    }

                                    Text {
                                        text: "Table";
                                        font-size: 11px;
                                        font-family: Theme.font-sans;
                                        color: ResultsState.view_mode == ResultsViewMode.table ? Theme.accent : Theme.text-dim;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        // Histogram
                        vh-ta := TouchArea {
                            height: 28px;
                            mouse-cursor: pointer;
                            clicked => {
                                ResultsState.view_mode = ResultsViewMode.chart;
                                ResultsState.chart_kind = ResultsChartKind.histogram;
                                view-popup.close();
                            }

                            Rectangle {
                                border-radius: 4px;
                                background: vh-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 14px;
                                        Image {
                                            source: @image-url("../icons/regular-black/check.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: Theme.accent;
                                            opacity: (ResultsState.view_mode == ResultsViewMode.chart && ResultsState.chart_kind == ResultsChartKind.histogram) ? 1.0 : 0.0;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 18px;
                                        Image {
                                            source: @image-url("../icons/regular-black/chart-bar.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: (ResultsState.view_mode == ResultsViewMode.chart && ResultsState.chart_kind == ResultsChartKind.histogram) ? Theme.accent : Theme.text-dim;
                                        }
                                    }

                                    Text {
                                        text: "Histogram";
                                        font-size: 11px;
                                        font-family: Theme.font-sans;
                                        color: (ResultsState.view_mode == ResultsViewMode.chart && ResultsState.chart_kind == ResultsChartKind.histogram) ? Theme.accent : Theme.text-dim;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }

                        // Scatter
                        vs-ta := TouchArea {
                            height: 28px;
                            mouse-cursor: pointer;
                            clicked => {
                                ResultsState.view_mode = ResultsViewMode.chart;
                                ResultsState.chart_kind = ResultsChartKind.scatter;
                                view-popup.close();
                            }

                            Rectangle {
                                border-radius: 4px;
                                background: vs-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 14px;
                                        Image {
                                            source: @image-url("../icons/regular-black/check.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: Theme.accent;
                                            opacity: (ResultsState.view_mode == ResultsViewMode.chart && ResultsState.chart_kind == ResultsChartKind.scatter) ? 1.0 : 0.0;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 18px;
                                        Image {
                                            source: @image-url("../icons/regular-black/chart-scatter.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: (ResultsState.view_mode == ResultsViewMode.chart && ResultsState.chart_kind == ResultsChartKind.scatter) ? Theme.accent : Theme.text-dim;
                                        }
                                    }

                                    Text {
                                        text: "Scatter";
                                        font-size: 11px;
                                        font-family: Theme.font-sans;
                                        color: (ResultsState.view_mode == ResultsViewMode.chart && ResultsState.chart_kind == ResultsChartKind.scatter) ? Theme.accent : Theme.text-dim;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }

                        // Heatmap
                        vmh-ta := TouchArea {
                            height: 28px;
                            mouse-cursor: pointer;
                            clicked => {
                                ResultsState.view_mode = ResultsViewMode.chart;
                                ResultsState.chart_kind = ResultsChartKind.heatmap;
                                view-popup.close();
                            }

                            Rectangle {
                                border-radius: 4px;
                                background: vmh-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 14px;
                                        Image {
                                            source: @image-url("../icons/regular-black/check.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: Theme.accent;
                                            opacity: (ResultsState.view_mode == ResultsViewMode.chart && ResultsState.chart_kind == ResultsChartKind.heatmap) ? 1.0 : 0.0;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 18px;
                                        Image {
                                            source: @image-url("../icons/regular-black/grid-four.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: (ResultsState.view_mode == ResultsViewMode.chart && ResultsState.chart_kind == ResultsChartKind.heatmap) ? Theme.accent : Theme.text-dim;
                                        }
                                    }

                                    Text {
                                        text: "Heatmap";
                                        font-size: 11px;
                                        font-family: Theme.font-sans;
                                        color: (ResultsState.view_mode == ResultsViewMode.chart && ResultsState.chart_kind == ResultsChartKind.heatmap) ? Theme.accent : Theme.text-dim;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        // Coloc Detail — flat table, one row per source × partner pair
                        vcd-ta := TouchArea {
                            height: 28px;
                            mouse-cursor: pointer;
                            clicked => {
                                ResultsState.group_computing = true;
                                ResultsState.loading_more = true;
                                ResultsState.view_mode = ResultsViewMode.coloc_table;
                                ResultsState.coloc_detail_requested();
                                view-popup.close();
                            }

                            Rectangle {
                                border-radius: 4px;
                                background: vcd-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 14px;
                                        Image {
                                            source: @image-url("../icons/regular-black/check.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: Theme.accent;
                                            opacity: ResultsState.view_mode == ResultsViewMode.coloc_table ? 1.0 : 0.0;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 18px;
                                        Image {
                                            source: @image-url("../icons/regular-black/intersect-three.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: ResultsState.view_mode == ResultsViewMode.coloc_table ? Theme.accent : Theme.text-dim;
                                        }
                                    }

                                    Text {
                                        text: "Coloc Detail";
                                        font-size: 11px;
                                        font-family: Theme.font-sans;
                                        color: ResultsState.view_mode == ResultsViewMode.coloc_table ? Theme.accent : Theme.text-dim;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if ResultsState.t_stack_active || ResultsState.z_stack_active: VerticalDivider { }

        // -- Frame navigation (time/depth stacks) -------------------------------
        if ResultsState.t_stack_active: FrameStepper {
            axis_label: "T";
            min: ResultsState.t_stack_min;
            max: ResultsState.t_stack_max;
            value: ResultsState.selected_t_stack;
            show_all: ResultsState.t_stack_show_all;
            changed(v, all) => {
                ResultsState.selected_t_stack = v;
                ResultsState.t_stack_show_all = all;
                ResultsState.t_stack_changed(v, all);
            }
        }
        if ResultsState.z_stack_active: FrameStepper {
            axis_label: "Z";
            min: ResultsState.z_stack_min;
            max: ResultsState.z_stack_max;
            value: ResultsState.selected_z_stack;
            show_all: ResultsState.z_stack_show_all;
            changed(v, all) => {
                ResultsState.selected_z_stack = v;
                ResultsState.z_stack_show_all = all;
                ResultsState.z_stack_changed(v, all);
            }
        }

        VerticalDivider { }

        // -- Sort direction ----------------------------------------------------
        ToolToggleButton {
            icon: ResultsState.sort_ascending ? @image-url("../icons/regular-black/sort-ascending.svg") : @image-url("../icons/regular-black/sort-descending.svg");
            enabled: ResultsState.sort_column_id != "";
            clicked => {
                ResultsState.sort_ascending = !ResultsState.sort_ascending;
                ResultsState.sort_requested(ResultsState.sort_column_id, ResultsState.sort_ascending);
            }
        }

        // -- Copy to clipboard -------------------------------------------------
        ToolToggleButton {
            icon: @image-url("../icons/regular-black/clipboard.svg");
            clicked => {
                ResultsState.copy_to_clipboard();
            }
        }

        // -- Spacer ------------------------------------------------------------
        Rectangle {
            horizontal-stretch: 1;
        }

        VerticalDivider { }

        // -- Export ------------------------------------------------------------
        if ResultsState.view_mode == ResultsViewMode.chart: ToolToggleButton {
            icon: @image-url("../icons/regular-black/file-image.svg");
            clicked => {
                ResultsState.chart_save_requested();
            }
        }

        ToolToggleButton {
            icon: @image-url("../icons/regular-black/export.svg");
            clicked => {
                ResultsState.export_dialog_open();
            }
        }
    }
}

// -- Status footer -------------------------------------------------------------

component ResultsStatusBar inherits Rectangle {
    height: 32px;

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            vertical-stretch: 1;

            Text {
                text: ResultsState.rows.length == 1 ? "1 row" : ResultsState.rows.length + " rows";
                font-size: 11px;
                font-family: Theme.font-mono;
                color: Theme.text-mute;
                vertical-alignment: center;
            }

            if ResultsState.filter_active: VerticalLayout {
                alignment: center;

                filter-badge-ta := TouchArea {
                    height: 16px;
                    mouse-cursor: pointer;
                    clicked => { ResultsState.clear_all_filters(); }

                    Rectangle {
                        border-radius: 3px;
                        background: filter-badge-ta.has-hover ? Theme.accent : Theme.accent-dim;
                        border-width: 1px;
                        border-color: Theme.accent;
                        animate background { duration: 80ms; }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 4px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "filtered";
                                font-size: 10px;
                                font-family: Theme.font-mono;
                                color: filter-badge-ta.has-hover ? white : Theme.accent;
                                vertical-alignment: center;
                                animate color { duration: 80ms; }
                            }

                            Image {
                                source: @image-url("../icons/regular-black/x.svg");
                                width: 8px;
                                height: 8px;
                                colorize: filter-badge-ta.has-hover ? white : Theme.accent;
                                animate colorize { duration: 80ms; }
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if ResultsState.selected_roi_id != 0: Text {
                text: "ROI \{ResultsState.selected_roi_id}";
                font-size: 11px;
                font-family: Theme.font-mono;
                color: Theme.accent;
                vertical-alignment: center;
            }

            if ResultsState.sort_column_id != "": Text {
                text: "sorted by \{ResultsState.sort_column_id}";
                font-size: 11px;
                color: Theme.text-mute;
                vertical-alignment: center;
            }
        }
    }
}

// -- Window --------------------------------------------------------------------

export component ResultsWindow inherits Window {
    title: "Results - EVAnalyzer";
    preferred-width: 1100px;
    preferred-height: 900px;
    min-width: 900px;
    min-height: 300px;
    background: Theme.bg;

    init => {
        Palette.color-scheme = ColorScheme.light;
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        ResultsToolbar { }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if ResultsState.view_mode == ResultsViewMode.table
        || ResultsState.view_mode == ResultsViewMode.coloc_table: ResultsTable {
            vertical-stretch: 1;
            background: Theme.panel;
        }
        if ResultsState.view_mode == ResultsViewMode.chart: ResultsChart {
            vertical-stretch: 1;
        }

        ResultsStatusBar { }
    }

    if ResultsState.export_dialog_active: ExportDialog {
        width: 100%;
        height: 100%;
    }
}
