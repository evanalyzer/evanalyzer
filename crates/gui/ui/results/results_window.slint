// results_window.slint — composition root for the redesigned Results
// window: left icon rail (List/Plate/Charts/Coloc) + breadcrumb bar (with
// the global Z/T plane stepper docked on its right, visible in every view)
// + the active view's content, with the export dialog as an overlay.
//
// Wire your existing ResultsChart / ResultsTable / ExportDialog in where
// marked — this file only replaces the toolbar+navigation shell described
// in the reference `ResultsWindow`/`ResultsToolbar`, not the table/chart
// rendering internals.

import { Theme } from "../style.slint";
import {
    ResultsState,
    ResultsRailMode,
    MatrixLevel,
} from "results_state.slint";
import { ResultsRail, ResultsBreadcrumb } from "results_common.slint";
import { ResultsListView } from "results_list.slint";
import { ResultsMatrixView } from "results_matrix.slint";
import { ResultsColocView } from "results_coloc.slint";
import { ResultsChartsView } from "results_charts.slint";
// import { ExportDialog } from "../export_dialog.slint";   // existing, unmodified

export component ResultsWindow inherits Window {
    title: "Results - EVAnalyzer";
    preferred-width: 1500px;
    preferred-height: 900px;
    min-width: 1200px;
    min-height: 700px;
    background: Theme.bg;

    HorizontalLayout {
        spacing: 0px;

        ResultsRail { }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            ResultsBreadcrumb { }

            if ResultsState.rail-mode == ResultsRailMode.list: ResultsListView {
                vertical-stretch: 1;
            }
            if ResultsState.rail-mode == ResultsRailMode.matrix: ResultsMatrixView {
                vertical-stretch: 1;
            }
            if ResultsState.rail-mode == ResultsRailMode.coloc: ResultsColocView {
                vertical-stretch: 1;
            }
            if ResultsState.rail-mode == ResultsRailMode.charts: ResultsChartsView {
                vertical-stretch: 1;
            }
        }
    }

    // if ResultsState.export_dialog_active: ExportDialog { width: 100%; height: 100%; }
}

// -------------------------------------------------------------------------
// Rust wiring notes
// -------------------------------------------------------------------------
// Breadcrumb / drill-down (keep ResultsState.breadcrumb in sync in Rust):
//   plate-cell-clicked(well_id)   -> push "Well {id}", set matrix-level=well,
//                                     load well-fields, active-well=well_id
//   well-field-clicked(field_id)  -> push "{field_id}.vsi", matrix-level=object,
//                                     load object-markers, active-image-name
//   object-marker-clicked(id)     -> open the object detail (existing flow)
//   breadcrumb-nav(i)             -> truncate breadcrumb to i+1, restore the
//                                     matrix-level/active-well that segment
//                                     represents (mirrors the reference impl's
//                                     "re-enter whichever well was last
//                                     drilled into" behavior)
//
// Global Z/T (both axes independent — a dataset may have one, the other,
// both, or neither active):
//   z-changed(v) / t-changed(v)   -> same handling as the existing
//                                     t_stack_changed/z_stack_changed
//                                     callbacks; re-render whichever view is
//                                     active against the new plane
//
// List columns: list-column-toggled/list-column-group-toggled mirror
// export_dialog's export_column_item_toggled/export_column_group_toggle —
// reuse that Rust-side logic against a second FilterItem set scoped to
// on-screen columns rather than export columns.
//
// Matrix toolbar: matrix-value-clicked/matrix-class-clicked should open the
// same kind of small popup as FilterPill implies (not modeled here since
// the options list comes from your class/measurement registry) — hook them
// up to whatever picker component you already use for single-choice pills.
