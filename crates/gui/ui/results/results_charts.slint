// results_charts.slint — Charts view: the chart (Histogram/Scatter/
// Boxplot) and what it shows in the settings column on the right; the
// chart rendering (bars/points/boxes, driven by the data Rust computes in
// `ResultsGenerator::get_histogram`/`get_scatter`/`get_boxplot` and pushes
// into `ResultsState.chart-*`) in the stretch area below.
import { ResultsChartKind2, ResultsState } from "../api/results.slint";
import { InkSegmented, InkHint, InkNumberField, InkSwitch, InkButton, InkButtonKind } from "../ink/ink.slint";
import { ColocCountRow, SettingsGroup } from "results_common.slint";
import { ComboBox } from "../ink/std_compat.slint";

import { ScrollView } from "std-widgets.slint";
import { Ink } from "../ink/palette.slint";

import { InkMultiSelect } from "../ink/ink.slint";
import { ViewBar, BarChip, BarLabel, BarSpacer, BarFolded, ViewPanel } from "results_view_bar.slint";
import { ColumnPicker, ChoiceList, IndexChoiceList } from "results_panel.slint";

component ChartErrorOrEmpty inherits Text {
    text: ResultsState.chart-error;
    color: Ink.text-mute;
    font-size: Ink.fs-body;
    horizontal-alignment: center;
    vertical-alignment: center;
    wrap: word-wrap;
}

component HistogramChart inherits Rectangle {
    if ResultsState.chart-error != "": ChartErrorOrEmpty { }

    if ResultsState.chart-error == "": VerticalLayout {
        padding: 24px;
        spacing: 8px;

        Text {
            text: ResultsState.chart-histogram-object-count + " objects";
            font-size: Ink.fs-secondary;
            color: Ink.text-mute;
        }

        bars := HorizontalLayout {
            vertical-stretch: 1;
            spacing: 2px;

            for bin in ResultsState.chart-histogram-bins: Rectangle {
                horizontal-stretch: 1;

                Rectangle {
                    y: parent.height - self.height;
                    width: parent.width;
                    height: parent.height * bin;
                    background: Ink.focus;
                    border-radius: 2px;
                }
            }

            if ResultsState.chart-histogram-bins.length == 0: Text {
                text: "No data for the selected filters";
                color: Ink.text-mute;
                font-size: Ink.fs-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            Text {
                text: ResultsState.chart-histogram-min-label;
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: ResultsState.chart-histogram-max-label;
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
            }
        }
    }
}

component ScatterChart inherits Rectangle {
    if ResultsState.chart-error != "": ChartErrorOrEmpty { }

    if ResultsState.chart-error == "": VerticalLayout {
        padding: 24px;
        spacing: 8px;

        Text {
            text: ResultsState.chart-scatter-shown-count + " of " + ResultsState.chart-scatter-total-count + " objects plotted";
            font-size: Ink.fs-secondary;
            color: Ink.text-mute;
        }

        plot-area := Rectangle {
            vertical-stretch: 1;
            background: Ink.raised;
            border-radius: 4px;
            clip: true;

            for pt in ResultsState.chart-scatter-points: Rectangle {
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: Ink.focus.with-alpha(0.65);
                x: pt.x * (plot-area.width - self.width);
                y: (1.0 - pt.y) * (plot-area.height - self.height);
            }

            // A click on a point: its object on its image.
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    ResultsState.chart-scatter-clicked(
                        (self.mouse-x - 2.5px) / max(1px, plot-area.width - 5px),
                        1.0 - (self.mouse-y - 2.5px) / max(1px, plot-area.height - 5px),
                        (plot-area.width - 5px) / 1px,
                        (plot-area.height - 5px) / 1px);
                }
            }

            if ResultsState.chart-scatter-points.length == 0: Text {
                text: "No data for the selected filters";
                color: Ink.text-mute;
                font-size: Ink.fs-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                x: 4px;
                y: 2px;
                text: ResultsState.chart-scatter-y-max-label;
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
            }
            Text {
                x: 4px;
                y: parent.height - self.height - 2px;
                text: ResultsState.chart-scatter-y-min-label;
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
            }
        }

        HorizontalLayout {
            Text {
                text: ResultsState.chart-scatter-x-min-label;
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: ResultsState.chart-scatter-x-max-label;
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
            }
        }
    }
}

component BoxplotChart inherits Rectangle {
    if ResultsState.chart-error != "": ChartErrorOrEmpty { }

    if ResultsState.chart-error == "" && ResultsState.chart-boxplot-boxes.length == 0: Text {
        text: "No data for the selected filters";
        color: Ink.text-mute;
        font-size: Ink.fs-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // A box per class can easily be more than fit the panel at once (a
    // database can register dozens of classes) — a plain `ScrollView`
    // (not `ListView`) is fine here since every box is always instantiated
    // (no virtualization needed at this scale), so its own auto-inferred
    // scrollable width just works.
    if ResultsState.chart-error == "" && ResultsState.chart-boxplot-boxes.length > 0: ScrollView {
        HorizontalLayout {
            padding: 24px;
            spacing: 16px;

            // A click on a box: its objects in the List.
            for box in ResultsState.chart-boxplot-boxes: Rectangle {
                width: 90px;
                border-radius: Ink.radius-md;
                background: box-ta.has-hover ? Ink.hover : transparent;
                box-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ResultsState.chart-box-clicked(box.label);
                    }
                }
            VerticalLayout {
                spacing: 4px;

                plot := Rectangle {
                    vertical-stretch: 1;

                    // whisker: min -> max
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        width: 1.5px;
                        y: parent.height * (1.0 - box.max);
                        height: max(0px, parent.height * (box.max - box.min));
                        background: box.color;
                    }

                    // box: Q1 -> Q3
                    Rectangle {
                        x: parent.width * 0.2;
                        width: parent.width * 0.6;
                        y: parent.height * (1.0 - box.q3);
                        height: max(1px, parent.height * (box.q3 - box.q1));
                        background: box.color.with-alpha(0.35);
                        border-width: 1.5px;
                        border-color: box.color;
                        border-radius: 2px;
                    }

                    // median line
                    Rectangle {
                        x: parent.width * 0.2;
                        width: parent.width * 0.6;
                        y: parent.height * (1.0 - box.median) - 1px;
                        height: 2px;
                        background: box.color;
                    }

                    for outlier in box.outliers: Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: box.color;
                        x: (parent.width - self.width) / 2;
                        y: parent.height * (1.0 - outlier) - self.height / 2;
                    }
                }

                Text {
                    text: box.label;
                    font-size: Ink.fs-caption;
                    color: Ink.text-mute;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: box.object-count + " objects";
                    font-size: Ink.fs-caption;
                    color: Ink.text-mute;
                    horizontal-alignment: center;
                }
            }
            }
        }
    }
}

// Over time: a line per class / image / well / track, its spread as a band,
// the individual tracks faint behind (all paths from Rust, in a 1000 x 1000
// box), the axes' ends as labels.
component OverTimeChart inherits Rectangle {
    if ResultsState.chart-error != "": ChartErrorOrEmpty { }

    if ResultsState.chart-error == "": VerticalLayout {
        padding: 20px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 12px;
            Text {
                horizontal-stretch: 1;
                text: ResultsState.chart-time-y-title;
                font-size: Ink.fs-body;
                font-weight: 600;
                color: Ink.text;
                vertical-alignment: center;
                overflow: elide;
            }
            if ResultsState.chart-time-note != "": Text {
                text: ResultsState.chart-time-note;
                font-size: Ink.fs-secondary;
                color: Ink.text-mute;
                vertical-alignment: center;
            }
            InkButton {
                small: true;
                kind: InkButtonKind.secondary;
                text: "Export data…";
                tip: ResultsState.chart-kind == ResultsChartKind2.profile
                    ? "The profile as CSV or XLSX - the lines or each object, long and/or wide"
                    : "The time course as CSV or XLSX - long and/or wide tables";
                clicked => {
                    ResultsState.chart-time-export();
                }
            }
        }

        // The legend.
        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            for line in ResultsState.chart-time-data: HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 14px;
                        height: 3px;
                        background: line.color;
                    }
                }
                Text {
                    text: line.label;
                    font-size: Ink.fs-secondary;
                    color: Ink.text-dim;
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 6px;
            VerticalLayout {
                width: 64px;
                Text {
                    text: ResultsState.chart-time-y-max;
                    font-size: Ink.fs-caption;
                    font-family: Ink.font-mono;
                    color: Ink.text-mute;
                    horizontal-alignment: right;
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                Text {
                    text: ResultsState.chart-time-y-min;
                    font-size: Ink.fs-caption;
                    font-family: Ink.font-mono;
                    color: Ink.text-mute;
                    horizontal-alignment: right;
                }
            }
            plot := Rectangle {
                border-width: 1px;
                border-color: Ink.border-soft;
                accessible-role: image;
                accessible-label: ResultsState.chart-time-y-title;
                for faint in ResultsState.chart-time-faint: Path {
                    width: plot.width;
                    height: plot.height;
                    viewbox-width: 1000;
                    viewbox-height: 1000;
                    // Stretched to the plot (the box isn't square).
                    fit: fill;
                    commands: faint;
                    stroke: Ink.text-mute;
                    stroke-width: 1px;
                    opacity: 0.25;
                }
                for line in ResultsState.chart-time-data: Path {
                    width: plot.width;
                    height: plot.height;
                    viewbox-width: 1000;
                    viewbox-height: 1000;
                    // Stretched to the plot (the box isn't square).
                    fit: fill;
                    commands: line.band != "" ? line.band : "M 0 0";
                    fill: line.color;
                    opacity: line.band != "" ? 0.16 : 0;
                }
                for line in ResultsState.chart-time-data: Path {
                    width: plot.width;
                    height: plot.height;
                    viewbox-width: 1000;
                    viewbox-height: 1000;
                    // Stretched to the plot (the box isn't square).
                    fit: fill;
                    commands: line.line != "" ? line.line : "M 0 0";
                    stroke: line.color;
                    stroke-width: 2px;
                }
                // Profile: the marker (the selected curve's highest value)
                // and the selected object's own curve on top.
                if ResultsState.chart-time-marker != "": Path {
                    width: plot.width;
                    height: plot.height;
                    viewbox-width: 1000;
                    viewbox-height: 1000;
                    fit: fill;
                    commands: ResultsState.chart-time-marker;
                    stroke: Ink.focus;
                    stroke-width: 1px;
                    opacity: 0.7;
                }
                if ResultsState.chart-time-highlight != "": Path {
                    width: plot.width;
                    height: plot.height;
                    viewbox-width: 1000;
                    viewbox-height: 1000;
                    fit: fill;
                    commands: ResultsState.chart-time-highlight;
                    stroke: Ink.focus;
                    stroke-width: 2.5px;
                }
                if ResultsState.chart-time-marker-label != "": Text {
                    x: 8px;
                    y: 6px;
                    text: ResultsState.chart-time-marker-label;
                    font-size: Ink.fs-caption;
                    font-family: Ink.font-mono;
                    color: Ink.focus;
                }
            }
        }

        HorizontalLayout {
            padding-left: 70px;
            Text {
                text: ResultsState.chart-time-x-min;
                font-size: Ink.fs-caption;
                font-family: Ink.font-mono;
                color: Ink.text-mute;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: ResultsState.chart-time-x-max;
                font-size: Ink.fs-caption;
                font-family: Ink.font-mono;
                color: Ink.text-mute;
            }
        }

        // Profile: the selected object's values.
        if ResultsState.chart-profile-cards.length > 0: HorizontalLayout {
            padding-left: 70px;
            spacing: 10px;
            alignment: start;
            for card in ResultsState.chart-profile-cards: Rectangle {
                background: Ink.raised;
                border-radius: Ink.radius-md;
                VerticalLayout {
                    padding: 10px;
                    spacing: 2px;
                    Text {
                        text: card.label;
                        font-size: Ink.fs-caption;
                        color: Ink.text-mute;
                    }
                    Text {
                        text: card.value;
                        font-size: Ink.fs-body;
                        color: Ink.text;
                    }
                }
            }
        }
    }
}

/// The Charts' left panel (design canvas "Results rework", PanelViews):
/// the part the bar's chip names - Value (the List's column picker, one
/// choice; X and Y for a scatter), Class, Groups (a box / a line per), Look.
component ChartsPanel inherits ViewPanel {
    property <ResultsChartKind2> kind: ResultsState.chart-kind;
    property <bool> has-class: root.kind != ResultsChartKind2.boxplot
        && !(root.kind == ResultsChartKind2.over-time && ResultsState.chart-time-lines == 0)
        && !(root.kind == ResultsChartKind2.profile && ResultsState.chart-profile-lines == 0);
    // The parts this kind has.
    parts: root.kind == ResultsChartKind2.boxplot ? ["Value", "Groups"]
        : root.kind == ResultsChartKind2.histogram || root.kind == ResultsChartKind2.scatter ? ["Value", "Class", "Look"]
        : root.has-class ? ["Value", "Class", "Groups", "Look"] : ["Value", "Groups", "Look"];
    part: ResultsState.chart-panel-part;
    part-picked(part) => {
        ResultsState.chart-panel-part = part;
    }
    fold => {
        ResultsState.chart-panel-open = false;
    }

    if root.current == "Value" && root.kind == ResultsChartKind2.profile: IndexChoiceList {
        title: "PROFILE";
        model: ResultsState.chart-profile-names;
        current: ResultsState.chart-profile-index;
        picked(i) => {
            ResultsState.chart-profile-index = i;
            ResultsState.chart-profile-selected(i);
        }
    }
    if root.current == "Value" && root.kind == ResultsChartKind2.scatter: InkSegmented {
        label: "Axis";
        model: ["X axis", "Y axis"];
        selected: ResultsState.chart-value-slot;
        picked(i) => {
            ResultsState.chart-value-slot = i;
            ResultsState.chart-value-slot-changed(i);
        }
    }
    if root.current == "Value" && root.kind != ResultsChartKind2.profile: ColumnPicker {
        single: true;
        placeholder: "Find a value - area, mean, coloc…";
        filter: ResultsState.chart-columns-filter;
        sections: ResultsState.chart-column-sections;
        intensity-title: ResultsState.chart-intensity-title;
        intensity-open: ResultsState.chart-intensity-open;
        intensity-channels: ResultsState.list-intensity-channels;
        intensity-stats: ResultsState.list-intensity-stats;
        intensity-cells: ResultsState.chart-intensity-cells;
        has-coloc: ResultsState.list-coloc-partner-items.length > 0;
        coloc-kinds: ResultsState.chart-coloc-kinds;
        filter-edited(text) => {
            ResultsState.chart-columns-filter = text;
            ResultsState.chart-columns-filter-changed(text);
        }
        picked(key, on) => {
            ResultsState.chart-value-picked(key);
        }
        section-toggled(group, open) => {
            if group == "intensity" {
                ResultsState.chart-intensity-open = open;
            }
            ResultsState.chart-columns-section-toggled(group, open);
        }
    }

    if root.current == "Class": ChoiceList {
        title: "THE OBJECTS OF";
        items: ResultsState.chart-class-items;
        chosen: ResultsState.chart-class-summary;
        picked(key, value) => {
            ResultsState.chart-class-summary = value;
            ResultsState.chart-class-selected(key, true);
        }
    }

    if root.current == "Groups" && root.kind == ResultsChartKind2.boxplot: IndexChoiceList {
        model: ["Class", "Image", "Well", "Plate row", "Plate column"];
        current: ResultsState.chart-group;
        picked(i) => {
            ResultsState.chart-group = i;
            ResultsState.chart-group-selected(i);
        }
    }
    if root.current == "Groups" && root.kind == ResultsChartKind2.over-time: IndexChoiceList {
        model: ["Class", "Image", "Well", "Track"];
        current: ResultsState.chart-time-lines;
        picked(i) => {
            ResultsState.chart-time-lines = i;
            ResultsState.chart-time-changed();
        }
    }
    if root.current == "Groups" && root.kind == ResultsChartKind2.profile: IndexChoiceList {
        model: ["Class", "Image", "Well", "Plate"];
        current: ResultsState.chart-profile-lines;
        picked(i) => {
            ResultsState.chart-profile-lines = i;
            ResultsState.chart-time-changed();
        }
    }

    if root.current == "Look": VerticalLayout {
        spacing: 12px;
            if ResultsState.chart-kind == ResultsChartKind2.histogram: HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: "Bins";
                    font-size: Ink.fs-secondary;
                    color: Ink.text;
                    vertical-alignment: center;
                }
                InkNumberField {
                    width: 110px;
                    label: "Bins";
                    value: ResultsState.chart-bins;
                    min: 5;
                    max: 200;
                    step: 1;
                    changed(v) => {
                        ResultsState.chart-bins = clamp(round(v.to-float()), 5, 200);
                        ResultsState.chart-display-changed();
                    }
                }
            }
            if ResultsState.chart-kind == ResultsChartKind2.histogram: InkSwitch {
                text: "Counts on a log scale";
                checked: ResultsState.chart-log-counts;
                toggled(on) => {
                    ResultsState.chart-log-counts = on;
                    ResultsState.chart-display-changed();
                }
            }
            if ResultsState.chart-kind == ResultsChartKind2.scatter: InkSegmented {
                label: "Points drawn";
                model: ["500", "2 000", "10 000", "All"];
                selected: ResultsState.chart-points-index;
                picked(i) => {
                    ResultsState.chart-points-index = i;
                    ResultsState.chart-display-changed();
                }
            }
            if ResultsState.chart-kind == ResultsChartKind2.scatter: InkHint {
                text: "Click a point to see its object on its image.";
            }
            if ResultsState.chart-kind == ResultsChartKind2.over-time || ResultsState.chart-kind == ResultsChartKind2.profile: InkSegmented {
                label: "Summary";
                model: ["Mean ± SD", "Median + IQR"];
                tips: ["Mean ± standard deviation", "Median and interquartile range"];
                tip-details: [
                    "The line is the average of the objects at each time point; the band reaches one standard deviation above and below it - how far the values typically spread. A few very large or small objects pull both.",
                    "The line is the middle value: half of the objects lie above it, half below. The band holds the middle half of the objects (25th to 75th percentile). Robust to outliers and skewed values such as sizes or intensities.",
                ];
                selected: ResultsState.chart-time-summary;
                picked(i) => {
                    ResultsState.chart-time-summary = i;
                    ResultsState.chart-time-changed();
                }
            }
            if ResultsState.chart-kind == ResultsChartKind2.profile: InkSwitch {
                text: "The selected object's curve";
                checked: ResultsState.chart-profile-curve;
                toggled(on) => {
                    ResultsState.chart-profile-curve = on;
                    ResultsState.chart-time-changed();
                }
            }
            if ResultsState.chart-kind == ResultsChartKind2.profile: InkSwitch {
                text: "Mark its highest value";
                checked: ResultsState.chart-profile-mark;
                toggled(on) => {
                    ResultsState.chart-profile-mark = on;
                    ResultsState.chart-time-changed();
                }
            }
            if ResultsState.chart-kind == ResultsChartKind2.profile: InkHint {
                text: ResultsState.split
                    ? "Click an object on the image - or use ‹ › - to see its curve and its circles. A position an object doesn't reach counts as 0."
                    : "Split with image to pick an object and see its curve and its circles. A position an object doesn't reach counts as 0.";
            }
            if ResultsState.chart-kind == ResultsChartKind2.over-time: InkSwitch {
                text: "Relative to the first time point";
                checked: ResultsState.chart-time-relative;
                toggled(on) => {
                    ResultsState.chart-time-relative = on;
                    ResultsState.chart-time-changed();
                }
            }
            if ResultsState.chart-kind == ResultsChartKind2.over-time: InkSwitch {
                text: "Individual tracks, faint";
                checked: ResultsState.chart-time-tracks;
                toggled(on) => {
                    ResultsState.chart-time-tracks = on;
                    ResultsState.chart-time-changed();
                }
            }
            // Across divisions and fusions - where tracks are drawn.
            if ResultsState.chart-kind == ResultsChartKind2.over-time && ResultsState.has-lineage
                && (ResultsState.chart-time-lines == 3 || ResultsState.chart-time-tracks): InkSegmented {
                label: "History";
                model: ["Own track", "With parents'"];
                tips: ["Each track its own line", "A line per cell, from its first ancestor"];
                tip-details: [
                    "Each track is its own line: a mother's ends at the division, its daughters' start there.",
                    "Each daughter's line starts with its mother's track; a fused track has a line per parent. The parents' time points count once per line - in Mean ± SD, relative to the first time point and the export.",
                ];
                selected: ResultsState.chart-time-history;
                picked(i) => {
                    ResultsState.chart-time-history = i;
                    ResultsState.chart-time-changed();
                }
            }
            }
}

/// The Charts' bar: the kind of chart, then what it draws - the value, the
/// class, a box or a line per, the look - as chips that open the left
/// panel on their part.
component ChartsBar inherits ViewBar {
    property <ResultsChartKind2> kind: ResultsState.chart-kind;
    property <bool> has-class: root.kind != ResultsChartKind2.boxplot
        && !(root.kind == ResultsChartKind2.over-time && ResultsState.chart-time-lines == 0)
        && !(root.kind == ResultsChartKind2.profile && ResultsState.chart-profile-lines == 0);

    if !ResultsState.chart-panel-open: BarFolded {
        summary: (root.kind == ResultsChartKind2.profile ? ResultsState.chart-profile-names[ResultsState.chart-profile-index]
                : root.kind == ResultsChartKind2.scatter ? ResultsState.chart-column-summary + " × " + ResultsState.chart-y-column-summary
                : ResultsState.chart-column-summary)
            + (root.has-class ? " · " + ResultsState.chart-class-summary : "");
        unfold => {
            ResultsState.chart-panel-open = true;
        }
    }
    BarLabel {
        text: "Chart";
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        InkSegmented {
            horizontal-stretch: 0;
            label: "Chart";
            model: ResultsState.has-profiles ? ["Histogram", "Boxplot", "Scatter", "Over time", "Profile"] : ["Histogram", "Boxplot", "Scatter", "Over time"];
            selected: root.kind == ResultsChartKind2.boxplot ? 1 : root.kind == ResultsChartKind2.scatter ? 2
                : root.kind == ResultsChartKind2.over-time ? 3 : root.kind == ResultsChartKind2.profile ? 4 : 0;
            picked(i) => {
                ResultsState.chart-kind = i == 1 ? ResultsChartKind2.boxplot : i == 2 ? ResultsChartKind2.scatter
                    : i == 3 ? ResultsChartKind2.over-time : i == 4 ? ResultsChartKind2.profile : ResultsChartKind2.histogram;
                ResultsState.chart-kind-selected(ResultsState.chart-kind);
                // Only a scatter has a Y to pick.
                if ResultsState.chart-kind != ResultsChartKind2.scatter && ResultsState.chart-value-slot != 0 {
                    ResultsState.chart-value-slot = 0;
                    ResultsState.chart-value-slot-changed(0);
                }
            }
        }
    }
    BarSpacer { }
    InkHint {
        vertical-alignment: center;
        horizontal-stretch: 0;
        text: root.kind == ResultsChartKind2.boxplot ? "Click a box to see its objects in the List."
            : root.kind == ResultsChartKind2.scatter ? "Click a point to see its object on its image." : "";
    }
}

export component ResultsChartsView inherits Rectangle {
    property <bool> panel-open: ResultsState.chart-panel-open;

    background: Ink.ground;

    // Panels on the ground: what is drawn on the left (a chip opens it),
    // the bar over the chart.
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        if root.panel-open: ChartsPanel { }

        VerticalLayout {
        spacing: 12px;
        horizontal-stretch: 1;

        ChartsBar { }

        // The content, a panel beside them.
        Rectangle {
            horizontal-stretch: 1;
            background: Ink.panel;
            border-radius: Ink.radius-lg;
            border-width: 1px;
            border-color: Ink.border;
            clip: true;
            VerticalLayout {
                horizontal-stretch: 1;
                if ResultsState.chart-kind == ResultsChartKind2.histogram: HistogramChart {
                    vertical-stretch: 1;
                }
                if ResultsState.chart-kind == ResultsChartKind2.scatter: ScatterChart {
                    vertical-stretch: 1;
                }
                if ResultsState.chart-kind == ResultsChartKind2.boxplot: BoxplotChart {
                    vertical-stretch: 1;
                }
                // One chart for both: lines over a position (time or radius).
                if ResultsState.chart-kind == ResultsChartKind2.over-time || ResultsState.chart-kind == ResultsChartKind2.profile: OverTimeChart {
                    vertical-stretch: 1;
                }
            }
        }
    }
    }
}
