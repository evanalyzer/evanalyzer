// results_charts.slint — Charts view: the chart (Histogram/Scatter/
// Boxplot) and what it shows in the settings column on the right; the
// chart rendering (bars/points/boxes, driven by the data Rust computes in
// `ResultsGenerator::get_histogram`/`get_scatter`/`get_boxplot` and pushes
// into `ResultsState.chart-*`) in the stretch area below.
import { ResultsChartKind2, ResultsState } from "../api/results.slint";
import { InkSegmented, InkHint, InkNumberField, InkSwitch } from "../ink/ink.slint";
import { SettingsGroup } from "results_common.slint";
import { ComboBox } from "../ink/std_compat.slint";

import { ScrollView } from "std-widgets.slint";
import { Ink } from "../ink/palette.slint";

import { InkMultiSelect } from "../ink/ink.slint";

component ChartErrorOrEmpty inherits Text {
    text: ResultsState.chart-error;
    color: Ink.text-mute;
    font-size: Ink.fs-body;
    horizontal-alignment: center;
    vertical-alignment: center;
    wrap: word-wrap;
}

component HistogramChart inherits Rectangle {
    if ResultsState.chart-error != "": ChartErrorOrEmpty { }

    if ResultsState.chart-error == "": VerticalLayout {
        padding: 24px;
        spacing: 8px;

        Text {
            text: ResultsState.chart-histogram-object-count + " objects";
            font-size: Ink.fs-secondary;
            color: Ink.text-mute;
        }

        bars := HorizontalLayout {
            vertical-stretch: 1;
            spacing: 2px;

            for bin in ResultsState.chart-histogram-bins: Rectangle {
                horizontal-stretch: 1;

                Rectangle {
                    y: parent.height - self.height;
                    width: parent.width;
                    height: parent.height * bin;
                    background: Ink.focus;
                    border-radius: 2px;
                }
            }

            if ResultsState.chart-histogram-bins.length == 0: Text {
                text: "No data for the selected filters";
                color: Ink.text-mute;
                font-size: Ink.fs-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            Text {
                text: ResultsState.chart-histogram-min-label;
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: ResultsState.chart-histogram-max-label;
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
            }
        }
    }
}

component ScatterChart inherits Rectangle {
    if ResultsState.chart-error != "": ChartErrorOrEmpty { }

    if ResultsState.chart-error == "": VerticalLayout {
        padding: 24px;
        spacing: 8px;

        Text {
            text: ResultsState.chart-scatter-shown-count + " of " + ResultsState.chart-scatter-total-count + " objects plotted";
            font-size: Ink.fs-secondary;
            color: Ink.text-mute;
        }

        plot-area := Rectangle {
            vertical-stretch: 1;
            background: Ink.raised;
            border-radius: 4px;
            clip: true;

            for pt in ResultsState.chart-scatter-points: Rectangle {
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: Ink.focus.with-alpha(0.65);
                x: pt.x * (plot-area.width - self.width);
                y: (1.0 - pt.y) * (plot-area.height - self.height);
            }

            // A click on a point: its object on its image.
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    ResultsState.chart-scatter-clicked(
                        (self.mouse-x - 2.5px) / max(1px, plot-area.width - 5px),
                        1.0 - (self.mouse-y - 2.5px) / max(1px, plot-area.height - 5px),
                        (plot-area.width - 5px) / 1px,
                        (plot-area.height - 5px) / 1px);
                }
            }

            if ResultsState.chart-scatter-points.length == 0: Text {
                text: "No data for the selected filters";
                color: Ink.text-mute;
                font-size: Ink.fs-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                x: 4px;
                y: 2px;
                text: ResultsState.chart-scatter-y-max-label;
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
            }
            Text {
                x: 4px;
                y: parent.height - self.height - 2px;
                text: ResultsState.chart-scatter-y-min-label;
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
            }
        }

        HorizontalLayout {
            Text {
                text: ResultsState.chart-scatter-x-min-label;
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: ResultsState.chart-scatter-x-max-label;
                font-size: Ink.fs-caption;
                color: Ink.text-mute;
            }
        }
    }
}

component BoxplotChart inherits Rectangle {
    if ResultsState.chart-error != "": ChartErrorOrEmpty { }

    if ResultsState.chart-error == "" && ResultsState.chart-boxplot-boxes.length == 0: Text {
        text: "No data for the selected filters";
        color: Ink.text-mute;
        font-size: Ink.fs-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // A box per class can easily be more than fit the panel at once (a
    // database can register dozens of classes) — a plain `ScrollView`
    // (not `ListView`) is fine here since every box is always instantiated
    // (no virtualization needed at this scale), so its own auto-inferred
    // scrollable width just works.
    if ResultsState.chart-error == "" && ResultsState.chart-boxplot-boxes.length > 0: ScrollView {
        HorizontalLayout {
            padding: 24px;
            spacing: 16px;

            // A click on a box: its objects in the List.
            for box in ResultsState.chart-boxplot-boxes: Rectangle {
                width: 90px;
                border-radius: Ink.radius-md;
                background: box-ta.has-hover ? Ink.hover : transparent;
                box-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ResultsState.chart-box-clicked(box.label);
                    }
                }
            VerticalLayout {
                spacing: 4px;

                plot := Rectangle {
                    vertical-stretch: 1;

                    // whisker: min -> max
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        width: 1.5px;
                        y: parent.height * (1.0 - box.max);
                        height: max(0px, parent.height * (box.max - box.min));
                        background: box.color;
                    }

                    // box: Q1 -> Q3
                    Rectangle {
                        x: parent.width * 0.2;
                        width: parent.width * 0.6;
                        y: parent.height * (1.0 - box.q3);
                        height: max(1px, parent.height * (box.q3 - box.q1));
                        background: box.color.with-alpha(0.35);
                        border-width: 1.5px;
                        border-color: box.color;
                        border-radius: 2px;
                    }

                    // median line
                    Rectangle {
                        x: parent.width * 0.2;
                        width: parent.width * 0.6;
                        y: parent.height * (1.0 - box.median) - 1px;
                        height: 2px;
                        background: box.color;
                    }

                    for outlier in box.outliers: Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: box.color;
                        x: (parent.width - self.width) / 2;
                        y: parent.height * (1.0 - outlier) - self.height / 2;
                    }
                }

                Text {
                    text: box.label;
                    font-size: Ink.fs-caption;
                    color: Ink.text-mute;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: box.object-count + " objects";
                    font-size: Ink.fs-caption;
                    color: Ink.text-mute;
                    horizontal-alignment: center;
                }
            }
            }
        }
    }
}

// A chart kind to pick: its picture above its name.
component ChartTile inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    height: 54px;
    horizontal-stretch: 1;
    border-radius: Ink.radius-md;
    border-width: 1px;
    border-color: root.selected ? Ink.focus : Ink.border;
    background: root.selected ? Ink.selection : ta.has-hover ? Ink.hover : Ink.panel;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.selected;

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.glyph;
            font-size: Ink.fs-title;
            color: root.selected ? Ink.focus : Ink.text-dim;
            horizontal-alignment: center;
        }
        Text {
            text: root.text;
            font-size: Ink.fs-secondary;
            font-weight: root.selected ? 600 : 400;
            color: Ink.text;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component ResultsChartsView inherits Rectangle {
    property <length> side-w: 280px;
    property <length> field-w: root.side-w - 2 * Ink.pad-panel;

    background: Ink.ground;

    // Panels on the ground (boards H, L, M): the settings left, the content
    // beside them.
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        // -- The chart and what it shows --
        Rectangle {
            width: root.side-w;
            background: Ink.panel;
            border-radius: Ink.radius-lg;
            border-width: 1px;
            border-color: Ink.border;
            clip: true;


            VerticalLayout {
                padding: Ink.pad-panel;
                spacing: 16px;
                alignment: start;

                SettingsGroup {
                    title: "CHART";
                    // The kinds as tiles, each with a picture of it (board M).
                    HorizontalLayout {
                        spacing: 6px;
                        ChartTile {
                            glyph: "▁▃▇▃▁";
                            text: "Histogram";
                            selected: ResultsState.chart-kind == ResultsChartKind2.histogram;
                            clicked => {
                                ResultsState.chart-kind = ResultsChartKind2.histogram;
                                ResultsState.chart-kind-selected(ResultsState.chart-kind);
                            }
                        }
                        ChartTile {
                            glyph: "┤▭├";
                            text: "Boxplot";
                            selected: ResultsState.chart-kind == ResultsChartKind2.boxplot;
                            clicked => {
                                ResultsState.chart-kind = ResultsChartKind2.boxplot;
                                ResultsState.chart-kind-selected(ResultsState.chart-kind);
                            }
                        }
                        ChartTile {
                            glyph: "∴ ∵";
                            text: "Scatter";
                            selected: ResultsState.chart-kind == ResultsChartKind2.scatter;
                            clicked => {
                                ResultsState.chart-kind = ResultsChartKind2.scatter;
                                ResultsState.chart-kind-selected(ResultsState.chart-kind);
                            }
                        }
                    }
                }

                SettingsGroup {
                    title: "VALUE";
                    InkMultiSelect {
                        label: ResultsState.chart-kind == ResultsChartKind2.scatter ? "X" : "Property";
                        summary-text: ResultsState.chart-column-summary;
                        items <=> ResultsState.chart-column-items;
                        multi-select: false;
                        pill-width: root.field-w;
                        item-selected(key, value, selected) => {
                            ResultsState.chart-column-summary = value;
                            ResultsState.chart-column-selected(key);
                        }
                    }
                    if ResultsState.chart-kind == ResultsChartKind2.scatter: InkMultiSelect {
                        label: "Y";
                        summary-text: ResultsState.chart-y-column-summary;
                        items <=> ResultsState.chart-y-column-items;
                        multi-select: false;
                        pill-width: root.field-w;
                        item-selected(key, value, selected) => {
                            ResultsState.chart-y-column-summary = value;
                            ResultsState.chart-y-column-selected(key);
                        }
                    }
                    if ResultsState.chart-kind == ResultsChartKind2.boxplot: VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "A box per";
                            font-size: Ink.fs-caption;
                            color: Ink.text-dim;
                        }
                        ComboBox {
                            model: ["Class", "Image", "Well", "Plate row", "Plate column"];
                            current-index: ResultsState.chart-group;
                            selected(v) => {
                                ResultsState.chart-group = self.current-index;
                                ResultsState.chart-group-selected(self.current-index);
                            }
                        }
                    }
                    if ResultsState.chart-kind != ResultsChartKind2.boxplot: InkMultiSelect {
                        label: "Class";
                        summary-text: ResultsState.chart-class-summary;
                        items <=> ResultsState.chart-class-items;
                        multi-select: false;
                        pill-width: root.field-w;
                        item-selected(key, value, selected) => {
                            ResultsState.chart-class-summary = value;
                            ResultsState.chart-class-selected(key, selected);
                        }
                    }
                }

                // How it's drawn.
                if ResultsState.chart-kind != ResultsChartKind2.boxplot: SettingsGroup {
                    title: "DISPLAY";
                    if ResultsState.chart-kind == ResultsChartKind2.histogram: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: "Bins";
                            font-size: Ink.fs-secondary;
                            color: Ink.text;
                            vertical-alignment: center;
                        }
                        InkNumberField {
                            width: 110px;
                            label: "Bins";
                            value: ResultsState.chart-bins;
                            min: 5;
                            max: 200;
                            step: 1;
                            changed(v) => {
                                ResultsState.chart-bins = clamp(round(v.to-float()), 5, 200);
                                ResultsState.chart-display-changed();
                            }
                        }
                    }
                    if ResultsState.chart-kind == ResultsChartKind2.histogram: InkSwitch {
                        text: "Counts on a log scale";
                        checked: ResultsState.chart-log-counts;
                        toggled(on) => {
                            ResultsState.chart-log-counts = on;
                            ResultsState.chart-display-changed();
                        }
                    }
                    if ResultsState.chart-kind == ResultsChartKind2.scatter: InkSegmented {
                        label: "Points drawn";
                        model: ["500", "2 000", "10 000", "All"];
                        selected: ResultsState.chart-points-index;
                        picked(i) => {
                            ResultsState.chart-points-index = i;
                            ResultsState.chart-display-changed();
                        }
                    }
                    if ResultsState.chart-kind == ResultsChartKind2.scatter: InkHint {
                        text: "Click a point to see its object on its image.";
                    }
                }

                if ResultsState.chart-kind == ResultsChartKind2.boxplot: InkHint {
                    text: "Click a box to see its objects in the List.";
                }
            }
        }

        // The content, a panel beside them.
        Rectangle {
            horizontal-stretch: 1;
            background: Ink.panel;
            border-radius: Ink.radius-lg;
            border-width: 1px;
            border-color: Ink.border;
            clip: true;
            VerticalLayout {
                horizontal-stretch: 1;
                if ResultsState.chart-kind == ResultsChartKind2.histogram: HistogramChart {
                    vertical-stretch: 1;
                }
                if ResultsState.chart-kind == ResultsChartKind2.scatter: ScatterChart {
                    vertical-stretch: 1;
                }
                if ResultsState.chart-kind == ResultsChartKind2.boxplot: BoxplotChart {
                    vertical-stretch: 1;
                }
            }
        }
    }
}
