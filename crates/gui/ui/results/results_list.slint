// results_list.slint — the results as a table (a row per object or per
// image), with what to show and how in the settings column on the right.
import { InkButton, InkButtonKind, InkIconButton, InkIcons, InkHint } from "../ink/ink.slint";
import { SettingsGroup } from "results_common.slint";
import { ResultRow, ResultsState } from "../api/results.slint";

import { ScrollView } from "std-widgets.slint";
import { Ink } from "../ink/palette.slint";

import { InkCheckList, InkMultiSelect, InkSwitch } from "../ink/ink.slint";

export component ResultsListView inherits Rectangle {
    property <length> side-w: 280px;
    // The row clicked (opened in its image) - until other rows come.
    property <[ResultRow]> rows: ResultsState.list-rows;
    changed rows => {
        ResultsState.list-selected-row = -1;
    }
    property <length> field-w: root.side-w - 2 * Ink.pad-panel;

    background: Ink.ground;

    // Panels on the ground (board L): the settings left, the table beside
    // them.
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        // -- The settings: what to show, how the rows are (split with the
        // image: in the table's head instead) --
        if !ResultsState.split: Rectangle {
            width: root.side-w;
            background: Ink.panel;
            border-radius: Ink.radius-lg;
            border-width: 1px;
            border-color: Ink.border;
            clip: true;


            Flickable {
                content-height: side.preferred-height;

                side := VerticalLayout {
                    padding: Ink.pad-panel;
                    spacing: 16px;
                    alignment: start;

                    SettingsGroup {
                        title: "SHOW";
                        // In place, as on the board (L): ticked = shown.
                        InkCheckList {
                            title: "IMAGES · " + ResultsState.list-image-summary;
                            items <=> ResultsState.list-image-items;
                            searchable: true;
                            item-selected(key, value, selected) => {
                                ResultsState.list-image-selected(key, selected);
                            }
                            select-all => {
                                ResultsState.list-image-select-all();
                            }
                            select-none => {
                                ResultsState.list-image-select-none();
                            }
                            filter-changed(text) => {
                                ResultsState.list-image-filter-changed(text);
                            }
                        }
                        InkCheckList {
                            title: "CLASSES · " + ResultsState.list-class-summary;
                            items <=> ResultsState.list-class-items;
                            list-height: 108px;
                            item-selected(key, value, selected) => {
                                ResultsState.list-class-selected(key, selected);
                            }
                            select-all => {
                                ResultsState.list-class-select-all();
                            }
                            select-none => {
                                ResultsState.list-class-select-none();
                            }
                        }
                        InkCheckList {
                            title: "COLUMNS · " + ResultsState.list-columns-summary;
                            items <=> ResultsState.list-columns;
                            list-height: 156px;
                            item-selected(key, value, selected) => {
                                ResultsState.list-columns-item-selected(key, selected);
                            }
                            select-all => {
                                ResultsState.list-columns-select-all();
                            }
                            select-none => {
                                ResultsState.list-columns-select-none();
                            }
                        }
                    }

                    SettingsGroup {
                        title: "ROWS";
                        InkMultiSelect {
                            label: "A row per";
                            summary-text: ResultsState.list-group-by-summary;
                            items <=> ResultsState.list-group-by-items;
                            multi-select: false;
                            pill-width: root.field-w;
                            item-selected(key, value, selected) => {
                                ResultsState.list-group-by-summary = value;
                                ResultsState.list-group-by-selected(key);
                            }
                        }
                        if ResultsState.list-group-by-summary == "Images": InkMultiSelect {
                            label: "Aggregate";
                            summary-text: ResultsState.list-aggregate;
                            items <=> ResultsState.list-aggregation-items;
                            multi-select: true;
                            show-select-all: true;
                            pill-width: root.field-w;
                            item-selected(key, value, selected) => { ResultsState.list-aggregation-item-selected(key, selected); }
                            select-all => { ResultsState.list-aggregation-select-all(); }
                            select-none => { ResultsState.list-aggregation-select-none(); }
                        }
                        // Switches, as on board L.
                        if ResultsState.list-group-by-summary == "Objects": InkSwitch {
                            text: "Coloc details";
                            checked: ResultsState.list-with-coloc-details;
                            toggled(on) => {
                                ResultsState.list-with-coloc-details = on;
                                ResultsState.list-with-coloc-details-changed(on);
                            }
                        }
                        InkSwitch {
                            text: "Transpose";
                            checked: ResultsState.list-transpond;
                            toggled(on) => {
                                ResultsState.list-transpond = on;
                                ResultsState.list-transpond-changed(on);
                            }
                        }
                    }
                }
            }
        }

        // -- The table --
        Rectangle {
            horizontal-stretch: 1;
            background: Ink.panel;
            border-radius: Ink.radius-lg;
            border-width: 1px;
            border-color: Ink.border;
            clip: true;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                // -- What is shown, the pages --
                Rectangle {
                    height: Ink.head-h;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 6px;
                        // Split with the image: what is shown, as fields.
                        if ResultsState.split: InkMultiSelect {
                            y: (parent.height - self.height) / 2;
                            summary-text: "Images · " + ResultsState.list-image-summary;
                            items <=> ResultsState.list-image-items;
                            show-select-all: true;
                            show-search: true;
                            pill-width: 120px;
                            filter-changed(text) => { ResultsState.list-image-filter-changed(text); }
                            item-selected(key, value, selected) => { ResultsState.list-image-selected(key, selected); }
                            select-all => { ResultsState.list-image-select-all(); }
                            select-none => { ResultsState.list-image-select-none(); }
                        }
                        if ResultsState.split: InkMultiSelect {
                            y: (parent.height - self.height) / 2;
                            summary-text: "Classes · " + ResultsState.list-class-summary;
                            items <=> ResultsState.list-class-items;
                            show-select-all: true;
                            pill-width: 130px;
                            item-selected(key, value, selected) => { ResultsState.list-class-selected(key, selected); }
                            select-all => { ResultsState.list-class-select-all(); }
                            select-none => { ResultsState.list-class-select-none(); }
                        }
                        if ResultsState.split: InkMultiSelect {
                            y: (parent.height - self.height) / 2;
                            summary-text: "Columns";
                            items <=> ResultsState.list-columns;
                            show-select-all: true;
                            pill-width: 90px;
                            item-selected(key, value, selected) => { ResultsState.list-columns-item-selected(key, selected); }
                            select-all => { ResultsState.list-columns-select-all(); }
                            select-none => { ResultsState.list-columns-select-none(); }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: ResultsState.split ? "" : ResultsState.list-group-by-summary
                                + (ResultsState.list-class-summary != "" ? " · " + ResultsState.list-class-summary : "")
                                + (ResultsState.list-image-summary != "" ? " · " + ResultsState.list-image-summary : "");
                            font-size: Ink.fs-md;
                            font-weight: 600;
                            color: Ink.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // Next/previous rather than infinite scroll: each page is a
                        // fresh, bounded query (see LIST_PAGE_SIZE in
                        // results_state_controller.rs).
                        InkIconButton {
                            y: (parent.height - self.height) / 2;
                            size: 26px;
                            icon: InkIcons.caret-left;
                            label: "Previous page";
                            enabled: ResultsState.list-page-number > 1;
                            clicked => { ResultsState.list-prev-page(); }
                        }
                        Text {
                            text: ResultsState.list-row-count + (ResultsState.list-row-count == 1 ? " row" : " rows");
                            font-size: Ink.fs-sm;
                            color: Ink.text-mute;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Page " + ResultsState.list-page-number;
                            font-size: Ink.fs-sm;
                            font-family: Ink.font-mono;
                            color: Ink.text-dim;
                            vertical-alignment: center;
                        }
                        InkIconButton {
                            y: (parent.height - self.height) / 2;
                            size: 26px;
                            icon: InkIcons.caret-right;
                            label: "Next page";
                            enabled: ResultsState.list-has-next-page;
                            clicked => { ResultsState.list-next-page(); }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Ink.border-soft;
                    }
                }

                // -- Table --
                Rectangle {
                    vertical-stretch: 1;
                    background: Ink.panel;

                    VerticalLayout {
                        spacing: 0px;

                        header-rect := Rectangle {
                            height: 30px;
                            background: Ink.field;
                            // Columns have a fixed pixel width, so the row content
                            // can be wider than the window; clip the header to its
                            // 28px band and pan it in step with the body's
                            // horizontal scroll (below) instead of letting it spill
                            // out or drift out of alignment with the columns.
                            clip: true;

                            header-layout := HorizontalLayout {
                                x: body-list.content-x;
                                width: max(self.preferred-width, parent.width);
                                padding-left: 16px;
                                padding-right: 16px;
                                // Space between the columns (the same in the rows).
                                spacing: 18px;

                                for header[idx] in ResultsState.list-column-headers: Rectangle {
                                    horizontal-stretch: 1;
                                    clip: true;
                                    width: ResultsState.list-column-widths[idx] * 1px;
                                    Text {
                                        text: header;
                                        width: ResultsState.list-column-widths[idx] * 1px;
                                        font-size: Ink.fs-sm;
                                        font-weight: 600;
                                        color: Ink.text-dim;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-alignment: start;
                                    }
                                }
                                Rectangle { }
                            }

                            Rectangle {
                                x: 0;
                                y: parent.height - 1px;
                                width: parent.width;
                                height: 1px;
                                background: Ink.border-soft;
                            }
                        }

                        // Split: a row selected from the image (or ↑ ↓)
                        // is scrolled into view.
                        property <int> selected-row: ResultsState.list-selected-row;
                        changed selected-row => {
                            if ResultsState.split && self.selected-row >= 0 {
                                if self.selected-row * 30px < -body-list.content-y {
                                    body-list.content-y = -self.selected-row * 30px;
                                } else if (self.selected-row + 1) * 30px > -body-list.content-y + body-list.visible-height {
                                    body-list.content-y = -((self.selected-row + 1) * 30px - body-list.visible-height);
                                }
                            }
                        }

                        body-list := ScrollView {
                            vertical-stretch: 1;
                            accessible-role: list;
                            accessible-orientation: Orientation.vertical;
                            content-width: header-layout.width;
                            content-height: ResultsState.list-rows.length * 30px;

                            for row[index] in ResultsState.list-rows: Rectangle {
                                y: index * 30px;
                                height: 30px;
                                width: header-layout.width;

                                background: index == ResultsState.list-selected-row ? Ink.selection : ta.has-hover ? Ink.hover : (ResultsState.list-with-coloc-details && row.alternating ? Ink.field : transparent);
                                opacity: row.disabled ? 0.55 : 1.0;

                                property <bool> row-visible: self.y + self.height >= -body-list.content-y - 3 * self.height
                                    && self.y <= -body-list.content-y + body-list.height + 3 * self.height;

                                Rectangle {
                                    y: 29px;
                                    border-width: 0px;
                                    background: Ink.border-soft;
                                    height: 1px;
                                    x: 0;
                                }
                                // Split: the selected row's accent edge.
                                if ResultsState.split && index == ResultsState.list-selected-row: Rectangle {
                                    x: -body-list.content-x;
                                    width: 3px;
                                    background: Ink.focus;
                                }

                                ta := TouchArea {
                                    mouse-cursor: pointer;
                                    // A click selects; a double click (or "Show on
                            // image") shows the object on its image.
                            // Split with the image: a click shows it there.
                            clicked => {
                                ResultsState.list-selected-row = index;
                                if ResultsState.split {
                                    ResultsState.list-row-selected(index);
                                }
                            }
                            double-clicked => {
                                if !ResultsState.split {
                                    ResultsState.list-row-clicked(index);
                                }
                            }
                                }

                                if row-visible: row-layout := HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-top: 7px;
                                    padding-bottom: 7px;
                                    spacing: 18px;

                                    // Column virtualization, same reasoning as
                                    // `row-visible` above: with 600-700 selectable
                                    // columns, only a handful are ever actually on
                                    // screen at once horizontally — the rest don't
                                    // need a live Text element just to sit clipped
                                    // off to the side.
                                    for cell[c-index] in row.cells: Rectangle {
                                        height: 16.5px;
                                        horizontal-stretch: 1;
                                        clip: true;
                                        width: ResultsState.list-column-widths[c-index] * 1px;

                                        property <bool> col-visible: self.x + self.width >= -body-list.content-x - 3 * self.width
                                            && self.x <= -body-list.content-x + header-rect.width + 3 * self.width;

                                        // The class: its color before the name.
                                        if col-visible && c-index == row.class-column: Rectangle {
                                            x: 0px;
                                            y: (parent.height - self.height) / 2;
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: row.class-color;
                                        }
                                        if col-visible: Text {
                                            x: c-index == row.class-column ? 14px : 0px;
                                            text: cell;
                                            width: ResultsState.list-column-widths[c-index] * 1px - self.x;
                                            font-size: Ink.fs-md;
                                            font-family: Ink.font-mono;
                                            color: row.failed ? Ink.warn : Ink.text;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-alignment: start;
                                        }
                                    }
                                    Rectangle { }
                                }

                                // The selected object: on its image (at the right of
                        // what's in view, also when scrolled sideways).
                        if index == ResultsState.list-selected-row && ResultsState.list-group-by-summary == "Objects" && !ResultsState.split: InkButton {
                            x: -body-list.content-x + body-list.visible-width - self.width - 10px;
                            y: (parent.height - self.height) / 2;
                            // Its own size (in a plain Rectangle it'd fill the row).
                            width: self.preferred-width;
                            height: self.preferred-height;
                            small: true;
                            kind: InkButtonKind.primary;
                            text: "Show on image ↗";
                            clicked => {
                                ResultsState.list-row-clicked(index);
                            }
                        }

                        if row.disabled: Rectangle {
                                    y: parent.height / 2 - 1px;
                                    x: 0;
                                    width: parent.width;
                                    height: 1px;
                                    background: Ink.text-mute;
                                }
                            }
                        }
                    }

                    if ResultsState.list-rows.length == 0: Rectangle {
                        Text {
                            text: "No objects match the current filters";
                            font-size: Ink.fs-md;
                            color: Ink.text-mute;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 30px;
                    background: Ink.panel;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Ink.border-soft;
                    }
                    InkHint {
                        x: 16px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: ResultsState.split ? "Click a row - or ↑ ↓ - to find its object on the image" : "Double-click a row - or Show on image - to see the object on its image";
                    }
                }
            }
        }
    }
}
