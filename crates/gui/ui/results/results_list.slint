// results_list.slint — flat object table with an image/class filter bar and
// a grouped column-visibility dropdown, both built on the shared
// MultiSelectDropdown (components/multi_select_dropdown.slint).

import { ListView } from "std-widgets.slint";
import { Theme } from "../style.slint";
import { ResultsState } from "results_state.slint";
import { MultiSelectDropdown } from "../components/multi_select_dropdown.slint";

export component ResultsListView inherits Rectangle {
    background: Theme.bg;

    VerticalLayout {
        spacing: 0px;

        // -- Filter bar --
        Rectangle {
            height: 54px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                cross-axis-alignment: center;

                MultiSelectDropdown {
                    label: "IMAGES";
                    summary-text: ResultsState.list-image-summary;
                    items <=> ResultsState.list-image-items;
                    multi-select: true;
                    show-select-all: true;
                    pill-width: 150px;
                    item-selected(key, value, selected) => { ResultsState.list-image-selected(key, selected); }
                }

                MultiSelectDropdown {
                    label: "CLASS";
                    summary-text: ResultsState.list-class-summary;
                    items <=> ResultsState.list-class-items;
                    multi-select: true;
                    show-select-all: true;
                    pill-width: 150px;
                    item-selected(key, value, selected) => { ResultsState.list-class-selected(key, selected); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                MultiSelectDropdown {
                    label: "COLUMNS";
                    summary-text: ResultsState.list-columns-summary;
                    items <=> ResultsState.list-columns;
                    groups: ResultsState.list-columns-groups;
                    multi-select: true;
                    show-select-all: true;
                    pill-width: 130px;
                    item-selected(key, value, selected) => { ResultsState.list-columns-item-selected(key, selected); }
                    select-all => { ResultsState.list-columns-select-all(); }
                    select-none => { ResultsState.list-columns-select-none(); }
                }

                Text {
                    text: ResultsState.list-row-count + " objects";
                    font-size: 11.5px;
                    font-family: Theme.font-mono;
                    color: Theme.text-mute;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.border-soft;
            }
        }

        // -- Table --
        // Rust only ever hands us one page of rows (see
        // ResultsStateController::update_list_view) even when the database
        // holds hundreds of thousands of objects, so a plain `for` here
        // stays cheap — it never has more than a page's worth of rows to
        // instantiate.
        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 28px;
                    background: Theme.raised;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;

                        for header in ResultsState.list-column-headers: Text {
                            text: header;
                            font-size: 10.5px;
                            font-family: Theme.font-mono;
                            font-weight: 600;
                            color: Theme.text-mute;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        x: 0;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.border-soft;
                    }
                }

                ListView {
                    vertical-stretch: 1;

                    for row[index] in ResultsState.list-rows: Rectangle {
                        height: 28px;
                        background: mod(index, 2) == 0 ? transparent : Theme.raised;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;

                            for cell in row.cells: Text {
                                text: cell;
                                font-size: 12px;
                                color: Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            if ResultsState.list-rows.length == 0: Rectangle {
                Text {
                    text: "No objects match the current filters";
                    font-size: 12px;
                    color: Theme.text-mute;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
