// results_list.slint — the results as a table (a row per object or per
// image), what to show and how in the bar above it (`ListBar`).
import { InkButton, InkButtonKind, InkCheckbox, InkIconButton, InkIcons, InkHint, InkOptionCard } from "../ink/ink.slint";
import { SettingsGroup } from "results_common.slint";
import { ColumnSection, ColumnPreset, ColocColumnItem, IntensityCell, ResultRow, ResultsState } from "../api/results.slint";

import { ScrollView } from "std-widgets.slint";
import { Ink } from "../ink/palette.slint";

import { InkCheckList, InkMultiSelect, InkSearchField, InkSegmented, InkSwitch, InkTipSide, InkTipZone, InkMenuItem } from "../ink/ink.slint";
import { ViewBar, BarChip, BarLabel, BarSpacer, BarCount, BarMore, ViewPanel } from "results_view_bar.slint";

/// A section of the column picker: its columns' checklist, foldable.
component ColumnSectionList inherits InkCheckList {
    in property <ColumnSection> section;
    title: root.section.title;
    items: root.section.items;
    open: root.section.open;
    collapsible: true;
    // Whole: the panel scrolls, not each list.
    list-height: self.items.length * 24px + 4px;
    toggled(open) => {
        ResultsState.list-columns-section-toggled(root.section.group, open);
    }
    item-selected(key, value, selected) => {
        ResultsState.list-columns-item-selected(key, selected);
    }
    select-all => {
        ResultsState.list-columns-section-select(root.section.group, true);
    }
    select-none => {
        ResultsState.list-columns-section-select(root.section.group, false);
    }
}

/// A head over a part of the panel: foldable caption, All / None - the
/// look of `InkCheckList`'s.
component PartHead inherits HorizontalLayout {
    in property <string> title;
    in property <bool> open;
    in property <bool> all-none: true;
    callback toggled;
    callback select-all;
    callback select-none;
    spacing: 8px;
    Rectangle {
        width: 12px;
        Image {
            source: root.open ? InkIcons.caret-down : InkIcons.caret-right;
            width: 10px;
            height: 10px;
            colorize: Ink.text-mute;
        }
    }
    Text {
        horizontal-stretch: 1;
        min-width: 0px;
        overflow: elide;
        text: root.title;
        font-size: Ink.fs-caption;
        font-weight: 600;
        letter-spacing: 0.6px;
        color: head-ta.has-hover ? Ink.text : Ink.text-mute;
        vertical-alignment: center;
        accessible-role: button;
        accessible-label: root.title;
        accessible-expandable: true;
        accessible-expanded: root.open;
        accessible-action-default => {
            root.toggled();
        }
        head-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.toggled();
            }
        }
    }
    if root.all-none: Text {
        text: "All";
        font-size: Ink.fs-secondary;
        color: all-ta.has-hover ? Ink.text : Ink.focus;
        all-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.select-all();
            }
        }
    }
    if root.all-none: Text {
        text: "None";
        font-size: Ink.fs-secondary;
        color: none-ta.has-hover ? Ink.text : Ink.focus;
        none-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.select-none();
            }
        }
    }
}

/// A starting set of columns: its name, what it holds; ringed while
/// exactly its columns are shown.
component PresetCard inherits Rectangle {
    in property <ColumnPreset> preset;
    horizontal-stretch: 1;
    min-width: 0px;
    // The row's cards share the tallest one's height.
    min-height: card-text.preferred-height;
    border-radius: Ink.radius-md;
    border-width: root.preset.active ? 1.5px : 1px;
    border-color: root.preset.active ? Ink.focus : ta.has-hover ? Ink.text-faint : Ink.border;
    background: root.preset.active ? Ink.selection-row : ta.has-hover ? Ink.hover : Ink.panel;
    accessible-role: button;
    accessible-label: root.preset.title;
    accessible-description: root.preset.description;
    accessible-action-default => {
        ResultsState.list-columns-preset(root.preset.key);
    }
    card-text := VerticalLayout {
        padding: 8px;
        spacing: 2px;
        alignment: start;
        Text {
            text: root.preset.title;
            font-size: Ink.fs-secondary;
            font-weight: 600;
            color: Ink.text;
            overflow: elide;
        }
        Text {
            text: root.preset.description;
            font-size: Ink.fs-caption;
            color: Ink.text-dim;
            wrap: word-wrap;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            ResultsState.list-columns-preset(root.preset.key);
        }
    }
}

/// Intensity as a grid: a row per channel, a column per value - a cell
/// ticks one column, a channel or a value its whole row or column.
component IntensityGrid inherits VerticalLayout {
    property <int> n: ResultsState.list-intensity-stats.length;
    property <length> label-w: 64px;
    property <length> cell-w: 30px;
    property <length> cell-h: 24px;
    spacing: 4px;

    PartHead {
        title: ResultsState.list-intensity-title;
        open: ResultsState.list-intensity-open;
        toggled => {
            ResultsState.list-intensity-open = !ResultsState.list-intensity-open;
            ResultsState.list-columns-section-toggled("intensity", ResultsState.list-intensity-open);
        }
        select-all => {
            ResultsState.list-columns-section-select("intensity", true);
        }
        select-none => {
            ResultsState.list-columns-section-select("intensity", false);
        }
    }

    if ResultsState.list-intensity-open: VerticalLayout {
        spacing: 3px;
        HorizontalLayout {
            spacing: 3px;
            alignment: start;
            Rectangle {
                width: root.label-w;
            }
            for stat[j] in ResultsState.list-intensity-stats: Rectangle {
                width: root.cell-w;
                height: 18px;
                Text {
                    text: stat;
                    font-size: Ink.fs-caption;
                    font-weight: 600;
                    color: stat-ta.has-hover ? Ink.text : Ink.text-mute;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                stat-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ResultsState.list-intensity-column(j);
                    }
                }
            }
        }
        for channel[i] in ResultsState.list-intensity-channels: HorizontalLayout {
            spacing: 3px;
            alignment: start;
            Rectangle {
                width: root.label-w;
                height: root.cell-h;
                Text {
                    width: 100%;
                    text: channel;
                    font-size: Ink.fs-secondary;
                    color: row-ta.has-hover ? Ink.text : Ink.text-dim;
                    vertical-alignment: center;
                    overflow: elide;
                }
                row-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ResultsState.list-intensity-row(i);
                    }
                }
            }
            for stat[j] in ResultsState.list-intensity-stats: cell-box := Rectangle {
                property <IntensityCell> cell: ResultsState.list-intensity-cells[i * root.n + j];
                width: root.cell-w;
                height: root.cell-h;
                border-radius: Ink.radius-xs;
                border-width: self.cell.selected ? 0px : 1px;
                border-color: cell-ta.has-hover ? Ink.text-faint : Ink.border;
                background: self.cell.key == "" ? transparent : self.cell.selected ? Ink.primary : cell-ta.has-hover ? Ink.hover : Ink.field;
                accessible-role: checkbox;
                accessible-label: stat + " " + channel;
                accessible-checked: self.cell.selected;
                if cell-box.cell.selected: Image {
                    source: InkIcons.check;
                    width: 10px;
                    colorize: Ink.on-primary;
                }
                cell-ta := TouchArea {
                    enabled: cell-box.cell.key != "";
                    mouse-cursor: pointer;
                    clicked => {
                        ResultsState.list-columns-item-selected(cell-box.cell.key, !cell-box.cell.selected);
                    }
                }
            }
        }
        InkHint {
            text: "A click on a channel or a value ticks its whole row or column.";
        }
    }
}

/// A coloc column of the builder: tick, name, what it needs per class.
component ColocColumnRow inherits Rectangle {
    in property <ColocColumnItem> item;
    height: 24px;
    background: ta.has-hover ? Ink.hover : transparent;
    border-radius: Ink.radius-xs;
    accessible-role: checkbox;
    accessible-label: root.item.name;
    accessible-checked: root.item.selected;
    accessible-action-default => {
        ResultsState.list-columns-item-selected(root.item.key, !root.item.selected);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            ResultsState.list-columns-item-selected(root.item.key, !root.item.selected);
        }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 13px;
                height: 13px;
                border-radius: Ink.radius-xs;
                border-width: root.item.selected ? 0px : 1px;
                border-color: Ink.text-faint;
                background: root.item.selected ? Ink.primary : Ink.field;
                if root.item.selected: Image {
                    source: InkIcons.check;
                    width: 9px;
                    colorize: Ink.on-primary;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.item.name;
            font-size: Ink.fs-secondary;
            color: Ink.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.item.glyph;
            font-size: Ink.fs-secondary;
            font-family: Ink.font-mono;
            letter-spacing: 1px;
            color: Ink.text-dim;
            vertical-alignment: center;
        }
    }
}

/// A numbered step of the coloc builder ("1  Overlap with").
component StepLabel inherits HorizontalLayout {
    in property <string> number;
    in property <string> text;
    spacing: 6px;
    Text {
        text: root.number;
        font-size: Ink.fs-secondary;
        font-weight: 700;
        color: Ink.text;
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        font-size: Ink.fs-secondary;
        color: Ink.text-dim;
        wrap: word-wrap;
    }
}

/// The coloc columns in three steps (design canvas "Results rework",
/// ColumnPanel): the partner classes, what a cell counts, which columns -
/// each kind with its columns and the marks of what they need.
component ColocBuilder inherits VerticalLayout {
    in property <bool> grouped;
    spacing: 10px;

    PartHead {
        title: ResultsState.list-coloc-title;
        open: ResultsState.list-coloc-open;
        all-none: false;
        toggled => {
            ResultsState.list-coloc-open = !ResultsState.list-coloc-open;
            ResultsState.list-coloc-toggled(ResultsState.list-coloc-open);
        }
    }

    if ResultsState.list-coloc-open: VerticalLayout {
        padding-left: 20px;
        spacing: 12px;

        VerticalLayout {
            spacing: 4px;
            StepLabel {
                number: "1";
                text: "Overlap with";
            }
            InkCheckList {
                title: "PARTNER CLASSES · " + ResultsState.list-coloc-partner-summary;
                items <=> ResultsState.list-coloc-partner-items;
                list-height: self.items.length * 24px + 4px;
                item-selected(key, value, selected) => {
                    ResultsState.list-coloc-partner-toggled(key);
                }
                select-all => {
                    ResultsState.list-coloc-partners-all(true);
                }
                select-none => {
                    ResultsState.list-coloc-partners-all(false);
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            StepLabel {
                number: "2";
                text: "Each cell counts";
            }
            HorizontalLayout {
                spacing: 6px;
                InkOptionCard {
                    horizontal-stretch: 1;
                    title: root.grouped ? "Objects that overlap" : "Yes / no";
                    description: root.grouped ? "How many objects of the row overlap" : "1 if the object overlaps, else 0";
                    checked: ResultsState.list-coloc-count == 0;
                    picked => {
                        ResultsState.list-coloc-count = 0;
                        ResultsState.list-coloc-count-picked(0);
                    }
                }
                InkOptionCard {
                    horizontal-stretch: 1;
                    title: root.grouped ? "Partner objects" : "How many partners";
                    description: root.grouped ? "How many partners lie on them" : "How many partners the object overlaps";
                    checked: ResultsState.list-coloc-count == 1;
                    picked => {
                        ResultsState.list-coloc-count = 1;
                        ResultsState.list-coloc-count-picked(1);
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            StepLabel {
                number: "3";
                text: "Columns for";
            }
            if ResultsState.list-coloc-kinds.length == 0: InkHint {
                text: "Pick a partner class above.";
            }
            for kind in ResultsState.list-coloc-kinds: VerticalLayout {
                spacing: 2px;
                PartHead {
                    title: kind.title + " · " + kind.count;
                    open: true;
                    select-all => {
                        ResultsState.list-columns-section-select(kind.group, true);
                    }
                    select-none => {
                        ResultsState.list-columns-section-select(kind.group, false);
                    }
                }
                InkHint {
                    text: kind.description;
                }
                for item in kind.items: ColocColumnRow {
                    item: item;
                }
            }
            InkSwitch {
                text: "Only combinations some object has";
                checked: ResultsState.list-coloc-only-occurring;
                toggled(on) => {
                    ResultsState.list-coloc-only-occurring = on;
                    ResultsState.list-coloc-only-occurring-changed(on);
                }
            }
            InkHint {
                text: "● overlaps · ○ must not · · either - per class in this order: " + ResultsState.list-coloc-partner-order + ". \"Exactly\" columns add up to the count. One row per overlapping pair: A row per → Coloc pairs.";
            }
        }
    }
}

/// The List's left panel (design canvas "Results rework", ColumnPanel E
/// with PanelNav D): the part the bar's chip names - Columns, Images,
/// Classes, Values.
component ListPanel inherits ViewPanel {
    in property <bool> grouped;
    property <string> part: ResultsState.panel-part;
    title: root.part == "Values" ? "Values per row" : root.part;

    if root.part == "Columns": VerticalLayout {
        spacing: 12px;
        InkSearchField {
            text: ResultsState.list-columns-filter;
            placeholder: "Find a column - area, mean, coloc…";
            edited(text) => {
                ResultsState.list-columns-filter = text;
                ResultsState.list-columns-filter-changed(text);
            }
        }
        if ResultsState.list-columns-filter == "" && ResultsState.list-column-presets.length > 0: VerticalLayout {
            spacing: 6px;
            Text {
                text: "START FROM";
                font-size: Ink.fs-caption;
                font-weight: 600;
                letter-spacing: 0.6px;
                color: Ink.text-mute;
            }
            HorizontalLayout {
                spacing: 6px;
                for preset in ResultsState.list-column-presets: PresetCard {
                    preset: preset;
                }
            }
        }
        for section in ResultsState.list-column-sections: VerticalLayout {
            if section.group == "intensity" && ResultsState.list-columns-filter == "": IntensityGrid { }
            if section.group != "intensity" || ResultsState.list-columns-filter != "": ColumnSectionList {
                section: section;
            }
        }
        if ResultsState.list-coloc-partner-items.length > 0: ColocBuilder {
            grouped: root.grouped;
        }
        if ResultsState.list-children-items.length > 0: InkCheckList {
            title: "CHILDREN · " + ResultsState.list-children-summary;
            items <=> ResultsState.list-children-items;
            list-height: 120px;
            collapsible: true;
            item-selected(key, value, selected) => {
                ResultsState.list-children-selected(key, selected);
            }
            select-all => {
                ResultsState.list-children-select-all(true);
            }
            select-none => {
                ResultsState.list-children-select-all(false);
            }
        }
        if ResultsState.list-children-items.length > 0: InkMultiSelect {
            label: "Of the columns";
            summary-text: ResultsState.list-child-aggregate;
            items <=> ResultsState.list-child-aggregation-items;
            multi-select: true;
            pill-width: 372px;
            item-selected(key, value, selected) => {
                ResultsState.list-child-aggregation-selected(key, selected);
            }
        }
        if ResultsState.list-parent-items.length > 0: InkCheckList {
            title: "LINKED OBJECTS · " + ResultsState.list-parent-summary;
            items <=> ResultsState.list-parent-items;
            list-height: 120px;
            collapsible: true;
            item-selected(key, value, selected) => {
                ResultsState.list-parent-selected(key, selected);
            }
            select-all => {
                ResultsState.list-parent-select-all(true);
            }
            select-none => {
                ResultsState.list-parent-select-all(false);
            }
        }
    }

    if root.part == "Images": VerticalLayout {
        spacing: 12px;
        InkSegmented {
            label: "Images";
            model: ["All", "Included", "Left out"];
            selected: ResultsState.list-image-state-summary == "Included" ? 1 : ResultsState.list-image-state-summary == "Left out" ? 2 : 0;
            tips: ["Every image, also those left out", "The images the analysis kept", "Only the images left out"];
            picked(i) => {
                ResultsState.list-image-state-summary = i == 1 ? "Included" : i == 2 ? "Left out" : "All";
                ResultsState.list-image-state-selected(i == 1 ? "enabled" : i == 2 ? "disabled" : "all");
            }
        }
        InkCheckList {
            title: "IMAGES · " + ResultsState.list-image-summary;
            items <=> ResultsState.list-image-items;
            searchable: true;
            list-height: 600px;
            item-selected(key, value, selected) => {
                ResultsState.list-image-selected(key, selected);
            }
            select-all => {
                ResultsState.list-image-select-all();
            }
            select-none => {
                ResultsState.list-image-select-none();
            }
            filter-changed(text) => {
                ResultsState.list-image-filter-changed(text);
            }
        }
    }

    if root.part == "Classes": VerticalLayout {
        spacing: 12px;
        InkCheckList {
            title: "CLASSES · " + ResultsState.list-class-summary;
            items <=> ResultsState.list-class-items;
            list-height: self.items.length * 24px + 4px;
            item-selected(key, value, selected) => {
                ResultsState.list-class-selected(key, selected);
            }
            select-all => {
                ResultsState.list-class-select-all();
            }
            select-none => {
                ResultsState.list-class-select-none();
            }
        }
        // A row per image, well or folder: a class without objects there
        // is a row of zeros, or none.
        if root.grouped: InkSwitch {
            text: "Show classes without objects";
            checked: ResultsState.list-empty-classes;
            toggled(on) => {
                ResultsState.list-empty-classes = on;
                ResultsState.list-empty-classes-changed(on);
            }
        }
    }

    if root.part == "Values": VerticalLayout {
        spacing: 12px;
        InkHint {
            text: "Each column summed up over the objects of a row - a column per value.";
        }
        InkCheckList {
            title: "OF THE OBJECTS IN EACH ROW";
            items <=> ResultsState.list-aggregation-items;
            list-height: 240px;
            item-selected(key, value, selected) => {
                ResultsState.list-aggregation-item-selected(key, selected);
            }
            select-all => {
                ResultsState.list-aggregation-select-all();
            }
            select-none => {
                ResultsState.list-aggregation-select-none();
            }
        }
    }
}

/// The List's bar (design canvas "Results rework", ListMock): a row per
/// first, then what is shown - Images, Classes, Columns, Values (grouped
/// rows only) - as chips that open the left panel on their part; how many
/// rows and the pages on the right, rarely used settings in ⋯.
component ListBar inherits ViewBar {
    in property <bool> grouped;
    property <bool> has-pairs: ResultsState.list-group-by-items.length > 4;
    property <string> rows: ResultsState.list-group-by-summary;

    BarLabel {
        text: "A row per";
    }
    // Its own width - the bar's free space stays on the right.
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        InkSegmented {
            horizontal-stretch: 0;
            label: "A row per";
            model: root.has-pairs ? ["Objects", "Images", "Wells", "Folders", "Coloc pairs"] : ["Objects", "Images", "Wells", "Folders"];
            selected: root.rows == "Images" ? 1 : root.rows == "Wells" ? 2 : root.rows == "Folders" ? 3 : root.rows == "Coloc pairs" ? 4 : 0;
            tips: ["A row per object", "A row per image and class", "A row per well and class - the wells from the image names (the project's plate grouping)", "A row per folder of images and class", "A row per pair of overlapping objects"];
            picked(i) => {
                ResultsState.list-group-by-summary = i == 1 ? "Images" : i == 2 ? "Wells" : i == 3 ? "Folders" : i == 4 ? "Coloc pairs" : "Objects";
                ResultsState.list-group-by-selected(i == 1 ? "images" : i == 2 ? "wells" : i == 3 ? "folders" : i == 4 ? "pairs" : "objects");
                // Values belong to rows of several objects only.
                if ResultsState.panel-part == "Values" && (i == 0 || i == 4) {
                    ResultsState.panel-part = "";
                }
            }
        }
    }

    VerticalLayout {
        alignment: center;
        BarChip {
            label: "Images";
            part: "Images";
            value: (ResultsState.list-image-state-summary != "All" ? ResultsState.list-image-state-summary + " · " : "")
                + (ResultsState.list-image-summary == "All Images" ? "All" : ResultsState.list-image-summary);
            active: ResultsState.list-image-state-summary != "All" || ResultsState.list-image-summary != "All Images";
        }
    }

    VerticalLayout {
        alignment: center;
        BarChip {
            label: "Classes";
            part: "Classes";
            value: ResultsState.list-class-summary;
        }
    }

    VerticalLayout {
        alignment: center;
        BarChip {
            label: "Columns";
            part: "Columns";
            value: ResultsState.list-columns-summary;
        }
    }

    if root.grouped: VerticalLayout {
        alignment: center;
        BarChip {
            label: "Values";
            part: "Values";
            value: ResultsState.list-aggregate;
        }
    }

    BarSpacer { }

    BarCount {
        text: ResultsState.list-row-count + (ResultsState.list-row-count == 1 ? " row" : " rows");
        pages: true;
        page: ResultsState.list-page-number;
        has-previous: ResultsState.list-page-number > 1;
        has-next: ResultsState.list-has-next-page;
        previous => {
            ResultsState.list-prev-page();
        }
        next => {
            ResultsState.list-next-page();
        }
    }

    BarMore {
        menu-width: 300px;
        // Per image, per object: each class's values side by side.
        InkMenuItem {
            text: "Classes as columns";
            checked: ResultsState.list-transpond;
            enabled: root.rows != "Wells" && root.rows != "Folders";
            clicked => {
                ResultsState.list-transpond = !ResultsState.list-transpond;
                ResultsState.list-transpond-changed(ResultsState.list-transpond);
            }
        }
    }
}

export component ResultsListView inherits Rectangle {
    // The row clicked (opened in its image) - until other rows come.
    property <[ResultRow]> rows: ResultsState.list-rows;
    changed rows => {
        ResultsState.list-selected-row = -1;
    }

    background: Ink.ground;

    property <string> row-per: ResultsState.list-group-by-summary;
    // Rows of several objects: aggregated.
    property <bool> grouped: root.row-per == "Images" || root.row-per == "Wells" || root.row-per == "Folders";
    property <string> part: ResultsState.panel-part;
    property <bool> panel-open: !ResultsState.split
        && (root.part == "Columns" || root.part == "Images" || root.part == "Classes" || (root.part == "Values" && root.grouped));

    // Panels on the ground: what is shown on the left (a chip opens it),
    // the bar on top (split with the image: in the table's head instead),
    // the table below it.
    HorizontalLayout {
    padding: 12px;
    spacing: 12px;

    if root.panel-open: ListPanel {
        grouped: root.grouped;
    }

    VerticalLayout {
        spacing: 12px;

        if !ResultsState.split: ListBar {
            grouped: root.grouped;
        }

        // -- The table --
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: Ink.panel;
            border-radius: Ink.radius-lg;
            border-width: 1px;
            border-color: Ink.border;
            clip: true;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                // -- Down to one object's children (a click on a count) --
                if ResultsState.list-drill-label != "": Rectangle {
                    height: Ink.head-h;
                    border-width: 0px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        InkButton {
                            y: (parent.height - self.height) / 2;
                            small: true;
                            text: "← Back";
                            clicked => {
                                ResultsState.list-drill-up();
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: ResultsState.list-drill-label;
                            font-size: Ink.fs-body;
                            font-weight: 600;
                            color: Ink.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Ink.border-soft;
                    }
                }

                // -- Split with the image: what is shown, the pages --
                if ResultsState.split: Rectangle {
                    height: Ink.head-h;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 6px;
                        // Split with the image: what is shown, as fields.
                        if ResultsState.split: InkMultiSelect {
                            y: (parent.height - self.height) / 2;
                            summary-text: "Images · " + ResultsState.list-image-summary;
                            items <=> ResultsState.list-image-items;
                            show-select-all: true;
                            show-search: true;
                            pill-width: 120px;
                            filter-changed(text) => { ResultsState.list-image-filter-changed(text); }
                            item-selected(key, value, selected) => { ResultsState.list-image-selected(key, selected); }
                            select-all => { ResultsState.list-image-select-all(); }
                            select-none => { ResultsState.list-image-select-none(); }
                        }
                        if ResultsState.split: InkMultiSelect {
                            y: (parent.height - self.height) / 2;
                            summary-text: "Classes · " + ResultsState.list-class-summary;
                            items <=> ResultsState.list-class-items;
                            show-select-all: true;
                            pill-width: 130px;
                            item-selected(key, value, selected) => { ResultsState.list-class-selected(key, selected); }
                            select-all => { ResultsState.list-class-select-all(); }
                            select-none => { ResultsState.list-class-select-none(); }
                        }
                        if ResultsState.split: InkMultiSelect {
                            y: (parent.height - self.height) / 2;
                            summary-text: "Columns";
                            items <=> ResultsState.list-columns;
                            show-select-all: true;
                            pill-width: 90px;
                            item-selected(key, value, selected) => { ResultsState.list-columns-item-selected(key, selected); }
                            select-all => { ResultsState.list-columns-select-all(); }
                            select-none => { ResultsState.list-columns-select-none(); }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        // Next/previous rather than infinite scroll: each page is a
                        // fresh, bounded query (see LIST_PAGE_SIZE in
                        // results_state_controller.rs).
                        InkIconButton {
                            y: (parent.height - self.height) / 2;
                            size: 26px;
                            icon: InkIcons.caret-left;
                            label: "Previous page";
                            enabled: ResultsState.list-page-number > 1;
                            disabled-reason: "The first page";
                            clicked => { ResultsState.list-prev-page(); }
                        }
                        Text {
                            text: ResultsState.list-row-count + (ResultsState.list-row-count == 1 ? " row" : " rows");
                            font-size: Ink.fs-secondary;
                            color: Ink.text-mute;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Page " + ResultsState.list-page-number;
                            font-size: Ink.fs-secondary;
                            font-family: Ink.font-mono;
                            color: Ink.text-dim;
                            vertical-alignment: center;
                        }
                        InkIconButton {
                            y: (parent.height - self.height) / 2;
                            size: 26px;
                            icon: InkIcons.caret-right;
                            label: "Next page";
                            enabled: ResultsState.list-has-next-page;
                            disabled-reason: "The last page";
                            clicked => { ResultsState.list-next-page(); }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Ink.border-soft;
                    }
                }

                // -- Table --
                Rectangle {
                    vertical-stretch: 1;
                    background: Ink.panel;

                    VerticalLayout {
                        spacing: 0px;

                        // What is ticked, and what to do with its images.
                        if ResultsState.list-checked-rows > 0: Rectangle {
                            height: 40px;
                            background: Ink.info-tint;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 12px;
                                // The buttons' height, centred in the bar.
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: ResultsState.list-checked-images == 1 ? "1 image ticked" : ResultsState.list-checked-images + " images ticked";
                                    font-size: Ink.fs-body;
                                    font-weight: 600;
                                    color: Ink.text;
                                    vertical-alignment: center;
                                }
                                if ResultsState.list-group-by-summary == "Objects": Text {
                                    text: "· " + ResultsState.list-checked-rows + (ResultsState.list-checked-rows == 1 ? " row" : " rows");
                                    font-size: Ink.fs-body;
                                    color: Ink.text-mute;
                                    vertical-alignment: center;
                                }
                                Rectangle { width: 8px; }
                                InkButton {
                                    small: true;
                                    kind: InkButtonKind.primary;
                                    text: "Take back in";
                                    enabled: ResultsState.list-checked-any-disabled;
                                    disabled-reason: "None of them is left out";
                                    clicked => {
                                        ResultsState.list-checked-set-disabled(false);
                                    }
                                }
                                InkButton {
                                    small: true;
                                    text: "Leave out";
                                    enabled: ResultsState.list-checked-any-enabled;
                                    disabled-reason: "All of them are left out already";
                                    clicked => {
                                        ResultsState.list-checked-set-disabled(true);
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                InkButton {
                                    small: true;
                                    kind: InkButtonKind.quiet;
                                    text: "Clear";
                                    clicked => {
                                        ResultsState.list-check-clear();
                                    }
                                }
                            }
                        }

                        header-rect := Rectangle {
                            height: 40px;
                            background: Ink.field;
                            // Columns have a fixed pixel width, so the row content
                            // can be wider than the window; clip the header to its
                            // 28px band and pan it in step with the body's
                            // horizontal scroll (below) instead of letting it spill
                            // out or drift out of alignment with the columns.
                            clip: true;

                            header-layout := HorizontalLayout {
                                x: body-list.content-x;
                                width: max(self.preferred-width, parent.width);
                                padding-left: 16px;
                                padding-right: 16px;
                                // Space between the columns (the same in the rows).
                                spacing: 18px;

                                // Ticks every row of the page (or none).
                                Rectangle {
                                    width: 16px;
                                    InkCheckbox {
                                        // A well or folder has no one image to leave out.

                                        visible: ResultsState.list-group-by-summary != "Wells" && ResultsState.list-group-by-summary != "Folders";
                                        y: (parent.height - self.height) / 2;
                                        checked: ResultsState.list-page-checked;
                                        text: "";
                                        accessible-label: "Tick every row of this page";
                                        toggled(on) => {
                                            ResultsState.list-check-page(on);
                                        }
                                    }
                                }

                                // Two lines: the name, then its unit and how it
                                // is aggregated, small and grey ("px · mean").
                                // A click sorts by the column: ▲, ▼, then as it was.
                                for header[idx] in ResultsState.list-column-headers: head-cell := Rectangle {
                                    property <bool> sortable: idx < ResultsState.list-column-sortable.length && ResultsState.list-column-sortable[idx];
                                    property <bool> sorted: ResultsState.list-sort-index == idx;
                                    horizontal-stretch: 1;
                                    clip: true;
                                    width: ResultsState.list-column-widths[idx] * 1px;
                                    accessible-role: button;
                                    accessible-enabled: self.sortable;
                                    accessible-label: "Sort by " + header;
                                    accessible-action-default => {
                                        ResultsState.list-sort-clicked(idx);
                                    }
                                    sort-ta := TouchArea {
                                        enabled: head-cell.sortable;
                                        mouse-cursor: self.enabled ? pointer : default;
                                        clicked => {
                                            ResultsState.list-sort-clicked(idx);
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 0px;
                                        Text {
                                            text: header + (head-cell.sorted ? (ResultsState.list-sort-descending ? " ▼" : " ▲") : "");
                                            color: head-cell.sorted || sort-ta.has-hover ? Ink.text : Ink.text-dim;
                                            width: ResultsState.list-column-widths[idx] * 1px;
                                            font-size: Ink.fs-secondary;
                                            font-weight: 600;
                                            overflow: elide;
                                            horizontal-alignment: start;
                                        }
                                        if idx < ResultsState.list-column-subs.length && ResultsState.list-column-subs[idx] != "": Text {
                                            text: ResultsState.list-column-subs[idx];
                                            width: ResultsState.list-column-widths[idx] * 1px;
                                            font-size: Ink.fs-caption;
                                            color: Ink.text-mute;
                                            overflow: elide;
                                            horizontal-alignment: start;
                                        }
                                    }
                                }
                                Rectangle { }
                            }

                            Rectangle {
                                x: 0;
                                y: parent.height - 1px;
                                width: parent.width;
                                height: 1px;
                                background: Ink.border-soft;
                            }
                        }

                        // Split: a row selected from the image (or ↑ ↓)
                        // is scrolled into view.
                        property <int> selected-row: ResultsState.list-selected-row;
                        changed selected-row => {
                            if ResultsState.split && self.selected-row >= 0 {
                                if self.selected-row * 30px < -body-list.content-y {
                                    body-list.content-y = -self.selected-row * 30px;
                                } else if (self.selected-row + 1) * 30px > -body-list.content-y + body-list.visible-height {
                                    body-list.content-y = -((self.selected-row + 1) * 30px - body-list.visible-height);
                                }
                            }
                        }

                        body-list := ScrollView {
                            vertical-stretch: 1;
                            accessible-role: list;
                            accessible-orientation: Orientation.vertical;
                            content-width: header-layout.width;
                            content-height: ResultsState.list-rows.length * 30px;

                            for row[index] in ResultsState.list-rows: Rectangle {
                                y: index * 30px;
                                height: 30px;
                                width: header-layout.width;

                                background: index == ResultsState.list-selected-row ? Ink.row-select : ta.has-hover ? Ink.hover : (ResultsState.list-with-coloc-details && row.alternating ? Ink.field : transparent);
                                opacity: row.disabled ? 0.55 : 1.0;

                                property <bool> row-visible: self.y + self.height >= -body-list.content-y - 3 * self.height
                                    && self.y <= -body-list.content-y + body-list.height + 3 * self.height;

                                Rectangle {
                                    y: 29px;
                                    border-width: 0px;
                                    background: Ink.border-soft;
                                    height: 1px;
                                    x: 0;
                                }

                                ta := TouchArea {
                                    mouse-cursor: pointer;
                                    // A click selects; a double click (or "Show on
                            // image") shows the object on its image.
                            // Split with the image: a click shows it there.
                            clicked => {
                                ResultsState.list-selected-row = index;
                                if ResultsState.split {
                                    ResultsState.list-row-selected(index);
                                }
                            }
                            double-clicked => {
                                if !ResultsState.split {
                                    ResultsState.list-row-clicked(index);
                                }
                            }
                                }

                                if row-visible: row-layout := HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-top: 7px;
                                    padding-bottom: 7px;
                                    spacing: 18px;

                                    // Column virtualization, same reasoning as
                                    // `row-visible` above: with 600-700 selectable
                                    // columns, only a handful are ever actually on
                                    // screen at once horizontally — the rest don't
                                    // need a live Text element just to sit clipped
                                    // off to the side.
                                    // The row's checkbox (Shift: every row from
                                    // the last one ticked).
                                    Rectangle {
                                        width: 16px;
                                        height: 16.5px;
                                        InkCheckbox {
                                            // A well or folder has no one image to leave out.

                                            visible: ResultsState.list-group-by-summary != "Wells" && ResultsState.list-group-by-summary != "Folders";
                                            y: (parent.height - self.height) / 2;
                                            checked: row.checked;
                                            text: "";
                                            accessible-label: "Tick this row";
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                                                    ResultsState.list-row-check(index, !row.checked, event.modifiers.shift);
                                                }
                                            }
                                        }
                                    }

                                    for cell[c-index] in row.cells: Rectangle {
                                        height: 16.5px;
                                        horizontal-stretch: 1;
                                        clip: true;
                                        width: ResultsState.list-column-widths[c-index] * 1px;

                                        property <bool> col-visible: self.x + self.width >= -body-list.content-x - 3 * self.width
                                            && self.x <= -body-list.content-x + header-rect.width + 3 * self.width;

                                        // The class: its color before the name.
                                        if col-visible && c-index == row.class-column: Rectangle {
                                            x: 0px;
                                            y: (parent.height - self.height) / 2;
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: row.class-color;
                                        }
                                        property <bool> drill: ResultsState.list-column-drill.length > c-index
                                            && ResultsState.list-column-drill[c-index] && cell != "0" && cell != "";
                                        if col-visible: Text {
                                            x: c-index == row.class-column ? 14px : 0px;
                                            text: cell;
                                            width: ResultsState.list-column-widths[c-index] * 1px - self.x;
                                            font-size: Ink.fs-body;
                                            font-family: Ink.font-mono;
                                            color: row.failed ? Ink.warn : drill ? Ink.focus : Ink.text;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-alignment: start;
                                        }
                                        // A children's count: down to them.
                                        if col-visible && drill: TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                ResultsState.list-drill(index, c-index);
                                            }
                                        }
                                    }
                                    Rectangle { }
                                }

                        if row.disabled: Rectangle {
                                    y: parent.height / 2 - 1px;
                                    x: 0;
                                    width: parent.width;
                                    height: 1px;
                                    background: Ink.text-mute;
                                }

                        // At the row's right (also when scrolled sideways): left
                        // out - why on hover; the eye leaves the row's image out
                        // or takes it back in; the selected object's button.
                        HorizontalLayout {
                            x: -body-list.content-x + body-list.visible-width - self.width - 10px;
                            y: (parent.height - self.height) / 2;
                            width: self.preferred-width;
                            height: 24px;
                            spacing: 6px;
                            alignment: end;
                            if row.disabled: Rectangle {
                                y: 3px;
                                width: left-out.preferred-width + 14px;
                                height: 18px;
                                border-radius: 9px;
                                background: row.note != "" ? Ink.warn-tint : Ink.field;
                                left-out := Text {
                                    text: row.note != "" ? "Excluded" : "Left out";
                                    font-size: Ink.fs-caption;
                                    color: row.note != "" ? Ink.warn : Ink.text-mute;
                                    vertical-alignment: center;
                                }
                                // Why - while the pointer is on the pill itself
                                // (the tip layer drops a tip whose pointer is
                                // outside its control, so the whole row's hover
                                // asked once, off the pill, and never again).
                                // From the row's pointer, not a TouchArea of
                                // its own: a click on the pill still selects
                                // the row.
                                property <length> left: self.absolute-position.x - ta.absolute-position.x;
                                property <length> top: self.absolute-position.y - ta.absolute-position.y;
                                InkTipZone {
                                    width: 100%;
                                    height: 100%;
                                    wanted: ta.has-hover
                                        && ta.mouse-x >= parent.left && ta.mouse-x <= parent.left + parent.width
                                        && ta.mouse-y >= parent.top && ta.mouse-y <= parent.top + parent.height;
                                    text: row.note != "" ? "Excluded by the pipeline: " + row.note : "Left out of the results by hand";
                                    side: InkTipSide.above;
                                }
                            }
                            // Shown on the row's hover (and on a left-out row).
                            eye := InkIconButton {
                                size: 24px;
                                opacity: ta.has-hover || self.has-hover || row.disabled ? 1.0 : 0.0;
                                icon: row.disabled ? InkIcons.hidden : InkIcons.visible;
                                label: row.disabled ? "Take this image back into the results" : "Leave this image out of the results";
                                tip-side: InkTipSide.above;
                                clicked => {
                                    ResultsState.list-row-set-disabled(index, !row.disabled);
                                }
                            }
                            if index == ResultsState.list-selected-row && ResultsState.list-group-by-summary == "Objects" && !ResultsState.split: InkButton {
                                small: true;
                                kind: InkButtonKind.primary;
                                text: "Show on image ↗";
                                clicked => {
                                    ResultsState.list-row-clicked(index);
                                }
                            }
                        }
                            }
                        }
                    }

                    if ResultsState.list-rows.length == 0: Rectangle {
                        Text {
                            text: "No objects match the current filters";
                            font-size: Ink.fs-body;
                            color: Ink.text-mute;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 30px;
                    background: Ink.panel;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Ink.border-soft;
                    }
                    InkHint {
                        x: 16px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: ResultsState.split ? "Click a row - or ↑ ↓ - to find its object on the image" : "Double-click a row - or Show on image - to see the object on its image";
                    }
                }
            }
        }
    }
    }
}
