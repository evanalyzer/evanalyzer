// results_list.slint — flat object table with an image/class filter bar and
// a grouped column-visibility dropdown, both built on the shared
// MultiSelectDropdown (components/multi_select_dropdown.slint).

import { Theme } from "../style.slint";
import { ResultsState } from "results_state.slint";
import { MultiSelectDropdown } from "../components/multi_select_dropdown.slint";

export component ResultsListView inherits Rectangle {
    background: Theme.bg;

    VerticalLayout {
        spacing: 0px;

        // -- Filter bar --
        Rectangle {
            height: 54px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                cross-axis-alignment: center;

                Rectangle {
                    width: 220px;
                    height: 30px;
                    border-radius: Theme.radius-sm;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent : Theme.border-soft;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        cross-axis-alignment: center;
                        Image {
                            source: @image-url("../icons/regular-black/magnifying-glass.svg");
                            width: 12px;
                            height: 12px;
                            colorize: Theme.text-mute;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            search-input := TextInput {
                                width: 100%;
                                height: 100%;
                                text <=> ResultsState.list-image-filter;
                                font-size: 11.5px;
                                color: Theme.text;
                                vertical-alignment: center;
                                single-line: true;
                                edited => { ResultsState.list-image-filter-changed(self.text); }
                            }

                            if search-input.text == "": Text {
                                width: 100%;
                                height: 100%;
                                text: "Filter by image name…";
                                font-size: 11.5px;
                                color: Theme.text-faint;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    width: 20px;
                }

                MultiSelectDropdown {
                    label: "OBJECT CLASS";
                    summary-text: ResultsState.list-class-summary;
                    items <=> ResultsState.list-class-items;
                    multi-select: true;
                    show-select-all: true;
                    pill-width: 150px;
                    item-selected(key, selected) => { ResultsState.list-class-selected(key, selected); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                MultiSelectDropdown {
                    label: "";
                    summary-text: ResultsState.list-columns-summary;
                    items <=> ResultsState.list-columns;
                    groups: ResultsState.list-columns-groups;
                    multi-select: true;
                    show-select-all: true;
                    pill-width: 130px;
                    item-selected(key, selected) => { ResultsState.list-columns-item-selected(key, selected); }
                    select-all => { ResultsState.list-columns-select-all(); }
                    select-none => { ResultsState.list-columns-select-none(); }
                }

                Text {
                    text: ResultsState.list-row-count + " objects";
                    font-size: 11.5px;
                    font-family: Theme.font-mono;
                    color: Theme.text-mute;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.border-soft;
            }
        }

        // Actual row rendering stays in your existing ResultsTable (native
        // table widget) — this view only owns the filter bar + columns
        // dropdown above it. Compose as:
        //   ResultsListView { }
        //   ResultsTable { vertical-stretch: 1; visible: <columns from ResultsState.list-columns> }
        Rectangle {
            vertical-stretch: 1;
        }
    }
}
