// results_list.slint — flat object table with an image/class filter bar and
// a searchable, grouped column-visibility popup (same interaction shape as
// export_dialog.slint's PickerField/ChecklistBox, reimplemented here as
// `ColumnsPopup` so this file has no dependency on the export dialog).

import { ScrollView, LineEdit } from "std-widgets.slint";
import { Theme } from "../style.slint";
import { ResultsState2, ColumnItem } from "results_state.slint";
import { FilterPill } from "results_common.slint";

component ColumnCheckMark inherits Rectangle {
    in property <bool> checked;
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border-width: 1.5px;
    border-color: root.checked ? Theme.accent : Theme.border;
    background: root.checked ? Theme.accent : transparent;
    if root.checked: Image {
        source: @image-url("../icons/regular-black/check.svg");
        width: 9px; height: 9px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: white;
    }
}

// Collapsed field + on-demand popup for picking visible columns. Grouped
// items (Intensity, Coloc classes) get a section header whose checkbox
// toggles the whole group — same UX as the export dialog's column picker,
// so the two stay consistent for users.
export component ColumnsPopup inherits Rectangle {
    in property <[ColumnItem]> items: [];
    in property <int> checked-count: 0;
    in property <int> total-count: 0;
    in-out property <string> search-text: "";
    in-out property <bool> open: false;
    callback item-toggled(string);
    callback group-toggled(string);
    callback select-all();
    callback select-none();
    callback search-changed(string);

    width: 130px;
    height: 40px;
    border-radius: Theme.radius-sm;
    background: Theme.raised;
    border-width: 1px;
    border-color: root.open ? Theme.accent : Theme.border-soft;

    field-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open = !root.open; if (root.open) { popup.show(); } }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        Image { source: @image-url("../icons/regular-black/funnel.svg"); width: 13px; height: 13px; colorize: Theme.text-dim; }
        Text { text: "Columns"; font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: root.checked-count + "/" + root.total-count; font-size: 10px; font-family: Theme.font-mono; color: Theme.text-mute; vertical-alignment: center; }
    }

    popup := PopupWindow {
        x: 0px;
        y: 44px;

        Rectangle {
            width: 280px;
            height: 340px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            clip: true;

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 36px;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "Search columns…";
                            text <=> root.search-text;
                            font-size: 11.5px;
                            edited(t) => { root.search-changed(t); }
                        }
                        all-ta := TouchArea {
                            width: 24px;
                            mouse-cursor: pointer;
                            clicked => { root.select-all(); }
                            Text { text: "All"; font-size: 10.5px; color: Theme.accent; vertical-alignment: center; }
                        }
                        none-ta := TouchArea {
                            width: 34px;
                            mouse-cursor: pointer;
                            clicked => { root.select-none(); }
                            Text { text: "None"; font-size: 10.5px; color: Theme.text-mute; vertical-alignment: center; }
                        }
                    }
                    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border-soft; }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 4px;
                        alignment: start;

                        for item in root.items: VerticalLayout {
                            spacing: 0px;

                            if item.group-header: gh-ta := TouchArea {
                                height: 26px;
                                mouse-cursor: pointer;
                                clicked => { root.group-toggled(item.group); }
                                Rectangle {
                                    background: gh-ta.has-hover ? Theme.raised : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 7px;
                                        VerticalLayout { alignment: center; ColumnCheckMark { checked: item.group-all-checked; } }
                                        Text {
                                            text: item.group;
                                            font-size: 10px;
                                            font-weight: 700;
                                            letter-spacing: 0.5px;
                                            color: Theme.text-mute;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                            }

                            if !item.group-header: row-ta := TouchArea {
                                height: 26px;
                                mouse-cursor: pointer;
                                clicked => { root.item-toggled(item.label); }
                                Rectangle {
                                    background: row-ta.has-hover ? Theme.raised : transparent;
                                    HorizontalLayout {
                                        padding-left: item.group == "" ? 8px : 22px;
                                        padding-right: 6px;
                                        spacing: 7px;
                                        VerticalLayout { alignment: center; ColumnCheckMark { checked: item.checked; } }
                                        Text {
                                            text: item.label;
                                            font-size: 11.5px;
                                            font-family: Theme.font-mono;
                                            color: item.checked ? Theme.text : Theme.text-mute;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component ResultsListView inherits Rectangle {
    background: Theme.bg;

    VerticalLayout {
        spacing: 0px;

        // -- Filter bar --
        Rectangle {
            height: 54px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                alignment: center;

                Rectangle {
                    width: 220px;
                    height: 30px;
                    border-radius: Theme.radius-sm;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.border-soft;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        Image { source: @image-url("../icons/regular-black/magnifying-glass.svg"); width: 12px; height: 12px; colorize: Theme.text-mute; }
                        LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "Filter by image name…";
                            text <=> ResultsState2.list-image-filter;
                            font-size: 11.5px;
                            edited(t) => { ResultsState2.list-image-filter-changed(t); }
                        }
                    }
                }

                FilterPill {
                    label: "OBJECT CLASS";
                    value: ResultsState2.list-class-filter;
                    pill-width: 150px;
                    clicked => { ResultsState2.list-class-filter-clicked(); }
                }

                Rectangle { horizontal-stretch: 1; }

                ColumnsPopup {
                    items: ResultsState2.list-columns;
                    checked-count: 0;
                    total-count: ResultsState2.list-columns.length;
                    item-toggled(l) => { ResultsState2.list-column-toggled(l); }
                    group-toggled(g) => { ResultsState2.list-column-group-toggled(g); }
                    select-all => { ResultsState2.list-columns-select-all(); }
                    select-none => { ResultsState2.list-columns-select-none(); }
                }

                Text {
                    text: ResultsState2.list-row-count + " objects";
                    font-size: 11.5px;
                    font-family: Theme.font-mono;
                    color: Theme.text-mute;
                    vertical-alignment: center;
                }
            }
            Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border-soft; }
        }

        // Actual row rendering stays in your existing ResultsTable (native
        // table widget) — this view only owns the filter bar + columns
        // popup above it. Compose as:
        //   ResultsListView { }
        //   ResultsTable { vertical-stretch: 1; visible: <columns from ResultsState2.list-columns> }
        Rectangle { vertical-stretch: 1; }
    }
}
