// results_common.slint — shared chrome for the redesigned Results window:
// left icon rail, breadcrumb bar (with the global Z/T plane stepper docked
// on its right, per-spec: Z/T is a global filter, visible in every view),
// legend bar, and small pill/chip primitives reused across List/Matrix/
// Charts/Coloc.

import { VerticalBox } from "std-widgets.slint";
import { Theme } from "../style.slint";
import { NavIconLeft } from "../components/navicon_left.slint";
import { AppButton } from "../components/app_button.slint";
import {
    ResultsState,
    ResultsRailMode,
    BreadcrumbItem,
} from "results_state.slint";

// -- Left icon rail: List / Matrix / Charts / Coloc + Export at the bottom.
// Reuses the same NavIconLeft button + panel styling as the main window's
// SidebarLeft (components/navicon_left.slint) instead of a bespoke button.
export component ResultsRail inherits Rectangle {
    width: 64px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;

    VerticalBox {
        width: 64px;
        padding: 4px;
        alignment: start;
        spacing: 8px;

        NavIconLeft {
            icon: @image-url("../icons/regular-black/list.svg");
            label: "List";
            active: ResultsState.rail-mode == ResultsRailMode.list;
            clicked => { ResultsState.rail-mode = ResultsRailMode.list; ResultsState.rail-mode-selected(ResultsRailMode.list); }
        }

        NavIconLeft {
            icon: @image-url("../icons/regular-black/grid-nine.svg");
            label: "Plate";
            active: ResultsState.rail-mode == ResultsRailMode.matrix;
            clicked => { ResultsState.rail-mode = ResultsRailMode.matrix; ResultsState.rail-mode-selected(ResultsRailMode.matrix); }
        }

        NavIconLeft {
            icon: @image-url("../icons/regular-black/chart-bar.svg");
            label: "Charts";
            active: ResultsState.rail-mode == ResultsRailMode.charts;
            clicked => { ResultsState.rail-mode = ResultsRailMode.charts; ResultsState.rail-mode-selected(ResultsRailMode.charts); }
        }

        NavIconLeft {
            icon: @image-url("../icons/regular-black/intersect-three.svg");
            label: "Coloc";
            active: ResultsState.rail-mode == ResultsRailMode.coloc;
            clicked => { ResultsState.rail-mode = ResultsRailMode.coloc; ResultsState.rail-mode-selected(ResultsRailMode.coloc); }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        NavIconLeft {
            icon: @image-url("../icons/regular-black/export.svg");
            label: "Export";
            active: false;
            clicked => { ResultsState.export-dialog-open(); }
        }
    }
}

// -- Single Z or T axis stepper: ‹ n/N › — arrows only, no slider track,
// matching the reference design's compact PlaneSelector (no <input
// type="range"> in its `compact` mode).
component PlaneAxis inherits HorizontalLayout {
    in property <string> axis-label;
    in property <int> value;
    in property <int> max;
    callback changed(int);

    spacing: 6px;
    cross-axis-alignment: center;

    Text {
        text: root.axis-label;
        font-size: 10.5px;
        font-family: Theme.font-mono;
        color: Theme.text-mute;
        vertical-alignment: center;
    }

    dec-ta := TouchArea {
        width: 16px;
        height: 16px;
        mouse-cursor: pointer;
        clicked => { root.changed(Math.max(0, root.value - 1)); }

        Rectangle {
            border-radius: Theme.radius-sm;
            background: dec-ta.has-hover ? Theme.raised : transparent;
            Text {
                text: "‹";
                color: Theme.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 11px;
            }
        }
    }

    inc-ta := TouchArea {
        width: 16px;
        height: 16px;
        mouse-cursor: pointer;
        clicked => { root.changed(Math.min(root.max, root.value + 1)); }

        Rectangle {
            border-radius: Theme.radius-sm;
            background: inc-ta.has-hover ? Theme.raised : transparent;
            Text {
                text: "›";
                color: Theme.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 11px;
            }
        }
    }

    Text {
        text: (root.value + 1) + "/" + (root.max + 1);
        font-size: 10.5px;
        font-family: Theme.font-mono;
        color: Theme.text;
        vertical-alignment: center;
        min-width: 30px;
    }
}

// Docked Z + T control — shown on the right of the breadcrumb bar in every
// view. Fully hidden (width 0) if neither axis is active for this dataset.
export component GlobalPlaneStepper inherits Rectangle {
    visible: ResultsState.z-stack-active || ResultsState.t-stack-active;
    width: root.visible ? self.preferred-width : 0px;
    height: 26px;
    border-radius: Theme.radius-sm;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.border-soft;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        alignment: center;
        cross-axis-alignment: center;

        if ResultsState.z-stack-active: PlaneAxis {
            axis-label: "Z";
            value: ResultsState.z-stack;
            max: ResultsState.z-stack-max;
            changed(v) => { ResultsState.z-stack = v; ResultsState.z-changed(v); }
        }
        if ResultsState.z-stack-active && ResultsState.t-stack-active: Rectangle {
            width: 1px;
            height: 14px;
            background: Theme.border-soft;
        }
        if ResultsState.t-stack-active: PlaneAxis {
            axis-label: "T";
            value: ResultsState.t-stack;
            max: ResultsState.t-stack-max;
            changed(v) => { ResultsState.t-stack = v; ResultsState.t-changed(v); }
        }
    }
}

// -- Breadcrumb bar: trail on the left, plane stepper docked on the right --
export component ResultsBreadcrumb inherits Rectangle {
    height: 38px;
    background: Theme.bg;

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border-soft;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 6px;
        cross-axis-alignment: center;

        for item[i] in ResultsState.breadcrumb: HorizontalLayout {
            spacing: 6px;
            if i > 0: Text {
                text: "›";
                color: Theme.text-faint;
                font-size: 12px;
                vertical-alignment: center;
            }
            crumb-ta := TouchArea {
                enabled: i < ResultsState.breadcrumb.length - 1;
                mouse-cursor: crumb-ta.enabled ? pointer : default;
                clicked => { ResultsState.breadcrumb-nav(i); }

                Text {
                    text: item.label;
                    font-size: 12.5px;
                    font-family: Theme.font-sans;
                    font-weight: i == ResultsState.breadcrumb.length - 1 ? 600 : 400;
                    color: i == ResultsState.breadcrumb.length - 1 ? Theme.text : Theme.text-dim;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        GlobalPlaneStepper { }
    }
}

// -- Legend bar: gradient swatch + min/max, used by Matrix/Well/Charts ------
export component LegendBar inherits VerticalLayout {
    in property <string> value-label: "Value";
    in property <float> min-value: 0;
    in property <float> max-value: 100;
    // Sampled from the selected `ColorSchema` in Rust
    // (`color_scale_gradient` in results_generator.rs) — rendered here by
    // just splitting a `HorizontalLayout` evenly across the stops, so the
    // legend always matches the schema actually painting the plate cells
    // instead of a second, independent gradient definition living in Slint.
    in property <[color]> gradient-stops: [];
    // Only the Matrix Plate level has a real `ColorScale` behind it today
    // (see `MatrixFilter` in results_state_controller.rs) — Well/Charts
    // reuse this component purely for display, so the click-to-edit popup
    // is opt-in per use site.
    in property <bool> editable: false;
    in property <bool> is-manual: false;
    callback set-auto();
    callback set-manual(float, float);

    // Local, uncommitted "which tab is highlighted in the popup" state —
    // separate from `is-manual` (the last value Rust actually committed) so
    // opening the popup and clicking "Manual" can preview the min/max
    // fields before "Apply" is pressed.
    property <bool> manual-tab-selected: root.is-manual;

    spacing: 6px;

    Text {
        text: root.value-label;
        font-size: 10.5px;
        color: Theme.text-mute;
        letter-spacing: 0.3px;
    }

    Rectangle {
        height: 10px;
        border-radius: 5px;
        // Without `clip: true` the flat-colored stop segments below paint
        // square corners straight over this rectangle's rounded ones, so
        // the rounding never actually shows.
        clip: true;

        HorizontalLayout {
            for stop in root.gradient-stops: Rectangle {
                background: stop;
            }
        }

        // Only while `set_color_schemas_in_slint` hasn't run yet.
        if root.gradient-stops.length == 0: Rectangle {
            background: Theme.border-soft;
        }

        if root.editable: TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => {
                manual-tab-selected = root.is-manual;
                popup.show();
            }
        }
    }

    HorizontalLayout {
        Text {
            text: Math.round(root.min-value);
            font-size: 10px;
            font-family: Theme.font-mono;
            color: Theme.text-mute;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: Math.round(root.max-value);
            font-size: 10px;
            font-family: Theme.font-mono;
            color: Theme.text-mute;
        }
    }

    if root.is-manual: Text {
        text: "Manual";
        font-size: 9px;
        letter-spacing: 0.4px;
        color: Theme.text-faint;
        horizontal-alignment: center;
    }

    popup := PopupWindow {
        x: 0;
        y: 34px;
        width: 190px;
        close-policy: close-on-click-outside;
        height: 44px + (manual-tab-selected ? 130px : 0px);

        Rectangle {
            width: 190px;
            height: parent.height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            clip: true;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 6px;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            manual-tab-selected = false;
                            root.set-auto();
                            popup.close();
                        }
                        Rectangle {
                            height: 26px;
                            border-radius: 6px;
                            background: manual-tab-selected ? Theme.raised : Theme.accent;
                            Text {
                                text: "Auto";
                                font-size: 11px;
                                font-weight: 600;
                                color: manual-tab-selected ? Theme.text : Theme.text-bright;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { manual-tab-selected = true; }
                        Rectangle {
                            height: 26px;
                            border-radius: 6px;
                            background: manual-tab-selected ? Theme.accent : Theme.raised;
                            Text {
                                text: "Manual";
                                font-size: 11px;
                                font-weight: 600;
                                color: manual-tab-selected ? Theme.text-bright : Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if manual-tab-selected: VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: "MIN";
                        font-size: 9px;
                        letter-spacing: 0.4px;
                        color: Theme.text-mute;
                    }
                    Rectangle {
                        height: 26px;
                        border-radius: Theme.radius-sm;
                        background: Theme.raised;
                        border-width: 1px;
                        border-color: min-input.has-focus ? Theme.accent : Theme.border-soft;
                        min-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            // Default value only — the conditional `if`
                            // block this lives in is recreated fresh each
                            // time the popup switches to the Manual tab, so
                            // this always starts at the currently displayed
                            // range rather than needing to be reset
                            // imperatively from the bar's click handler.
                            text: "\{root.min-value}";
                            vertical-alignment: center;
                            font-size: 11px;
                            color: Theme.text;
                            single-line: true;
                        }
                    }

                    Text {
                        text: "MAX";
                        font-size: 9px;
                        letter-spacing: 0.4px;
                        color: Theme.text-mute;
                    }
                    Rectangle {
                        height: 26px;
                        border-radius: Theme.radius-sm;
                        background: Theme.raised;
                        border-width: 1px;
                        border-color: max-input.has-focus ? Theme.accent : Theme.border-soft;
                        max-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: "\{root.max-value}";
                            vertical-alignment: center;
                            font-size: 11px;
                            color: Theme.text;
                            single-line: true;
                        }
                    }

                    AppButton {
                        text: "Apply";
                        primary: true;
                        height: 28px;
                        clicked => {
                            root.set-manual(min-input.text.to-float(), max-input.text.to-float());
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// -- Small labeled dropdown button (Value / Aggregate / Class filter pills) --
export component FilterPill inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> pill-width: 150px;
    callback clicked;

    width: root.pill-width;
    border-radius: Theme.radius-sm;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.border-soft;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 2px;

        Text {
            text: root.label;
            font-size: 9px;
            letter-spacing: 0.4px;
            color: Theme.text-mute;
        }

        HorizontalLayout {
            Text {
                text: root.value;
                font-size: 12px;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            Text {
                text: "▾";
                font-size: 9px;
                color: Theme.text-mute;
                vertical-alignment: center;
            }
        }
    }
}
