// results_common.slint — shared chrome for the redesigned Results window:
// left icon rail, breadcrumb bar (with the global Z/T plane stepper docked
// on its right, per-spec: Z/T is a global filter, visible in every view),
// legend bar, and small pill/chip primitives reused across List/Matrix/
// Charts/Coloc.

import { Theme } from "../style.slint";
import {
    ResultsState2,
    ResultsRailMode,
    BreadcrumbItem,
} from "results_state.slint";

// Maps a normalized 0..1 value to a viridis-like color (blue -> teal ->
// yellow), matching the reference HTML mock's `valueColor`.
export global ValueColor {
    public pure function value-color(t: float) -> color {
        let c = Math.clamp(t, 0.0, 1.0);
        if (c < 0.35) {
            return Colors.hsv(255, 30%, 45%).mix(Colors.hsv(225, 28%, 55%), c / 0.35);
        } else if (c < 0.55) {
            return Colors.hsv(225, 28%, 55%).mix(Colors.hsv(175, 30%, 62%), (c - 0.35) / 0.2);
        } else if (c < 0.75) {
            return Colors.hsv(175, 30%, 62%).mix(Colors.hsv(140, 34%, 74%), (c - 0.55) / 0.2);
        } else {
            return Colors.hsv(140, 34%, 74%).mix(Colors.hsv(95, 36%, 88%), (c - 0.75) / 0.25);
        }
    }
}

component RailButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked;

    height: 58px;
    background: root.active ? Theme.accent-dim : (ta.has-hover ? Theme.raised : transparent);
    animate background { duration: 80ms; }

    Rectangle {
        // active indicator bar
        visible: root.active;
        x: 0; y: 6px;
        width: 3px;
        height: parent.height - 12px;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        Image {
            source: root.icon;
            width: 18px;
            height: 18px;
            colorize: root.active ? Theme.accent : Theme.text-dim;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            font-size: 9px;
            font-family: Theme.font-sans;
            color: root.active ? Theme.accent : Theme.text-mute;
            horizontal-alignment: center;
        }
    }
}

// -- Left icon rail: List / Matrix / Charts / Coloc + Export at the bottom --
export component ResultsRail inherits Rectangle {
    width: 64px;
    background: Theme.rail;

    VerticalLayout {
        padding-top: 8px;
        spacing: 2px;

        RailButton {
            icon: @image-url("../icons/regular-black/list.svg");
            label: "List";
            active: ResultsState2.rail-mode == ResultsRailMode.list;
            clicked => { ResultsState2.rail-mode = ResultsRailMode.list; ResultsState2.rail-mode-selected(ResultsRailMode.list); }
        }
        RailButton {
            icon: @image-url("../icons/regular-black/grid-nine.svg");
            label: "Plate";
            active: ResultsState2.rail-mode == ResultsRailMode.matrix;
            clicked => { ResultsState2.rail-mode = ResultsRailMode.matrix; ResultsState2.rail-mode-selected(ResultsRailMode.matrix); }
        }
        RailButton {
            icon: @image-url("../icons/regular-black/chart-bar.svg");
            label: "Charts";
            active: ResultsState2.rail-mode == ResultsRailMode.charts;
            clicked => { ResultsState2.rail-mode = ResultsRailMode.charts; ResultsState2.rail-mode-selected(ResultsRailMode.charts); }
        }
        RailButton {
            icon: @image-url("../icons/regular-black/intersect-three.svg");
            label: "Coloc";
            active: ResultsState2.rail-mode == ResultsRailMode.coloc;
            clicked => { ResultsState2.rail-mode = ResultsRailMode.coloc; ResultsState2.rail-mode-selected(ResultsRailMode.coloc); }
        }

        Rectangle { vertical-stretch: 1; }

        RailButton {
            icon: @image-url("../icons/regular-black/export.svg");
            label: "Export";
            active: false;
            clicked => { ResultsState2.export-dialog-open(); }
        }
    }
}

// Minimal track-and-handle slider (avoids depending on std-widgets' Slider
// styling so it matches the compact plane-stepper look 1:1).
component Slider2 inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value: 0;
    callback changed(float);

    height: 16px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.border;
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 3px;
        border-radius: 1.5px;
        width: parent.width * ((root.value - root.minimum) / Math.max(0.0001, root.maximum - root.minimum));
        background: Theme.accent;
    }
    handle := Rectangle {
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.text;
        y: (parent.height - self.height) / 2;
        x: parent.width * ((root.value - root.minimum) / Math.max(0.0001, root.maximum - root.minimum)) - self.width / 2;
    }
    TouchArea {
        moved => {
            if (self.pressed) {
                let rel = Math.clamp(self.mouse-x / self.width, 0.0, 1.0);
                root.changed(root.minimum + rel * (root.maximum - root.minimum));
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                let rel = Math.clamp(self.mouse-x / self.width, 0.0, 1.0);
                root.changed(root.minimum + rel * (root.maximum - root.minimum));
            }
        }
    }
}

// -- Single Z or T axis stepper: ‹ slider › + "n/N" readout ------------------
component PlaneAxis inherits HorizontalLayout {
    in property <string> axis-label;
    in property <int> value;
    in property <int> max;
    callback changed(int);

    spacing: 6px;

    Text {
        text: root.axis-label;
        font-size: 10.5px;
        font-family: Theme.font-mono;
        color: Theme.text-mute;
        vertical-alignment: center;
    }

    dec-ta := TouchArea {
        width: 16px;
        height: 16px;
        mouse-cursor: pointer;
        clicked => { root.changed(Math.max(0, root.value - 1)); }

        Rectangle {
            border-radius: Theme.radius-sm;
            background: dec-ta.has-hover ? Theme.raised : transparent;
            Text { text: "‹"; color: Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; }
        }
    }

    Slider2 {
        width: 72px;
        minimum: 0;
        maximum: root.max;
        value: root.value;
        changed(v) => { root.changed(Math.round(v)); }
    }

    inc-ta := TouchArea {
        width: 16px;
        height: 16px;
        mouse-cursor: pointer;
        clicked => { root.changed(Math.min(root.max, root.value + 1)); }

        Rectangle {
            border-radius: Theme.radius-sm;
            background: inc-ta.has-hover ? Theme.raised : transparent;
            Text { text: "›"; color: Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; }
        }
    }

    Text {
        text: (root.value + 1) + "/" + (root.max + 1);
        font-size: 10.5px;
        font-family: Theme.font-mono;
        color: Theme.text;
        vertical-alignment: center;
        min-width: 30px;
    }
}

// Docked Z + T control — shown on the right of the breadcrumb bar in every
// view. Fully hidden (width 0) if neither axis is active for this dataset.
export component GlobalPlaneStepper inherits Rectangle {
    visible: ResultsState2.z-stack-active || ResultsState2.t-stack-active;
    width: root.visible ? self.preferred-width : 0px;
    height: 26px;
    border-radius: Theme.radius-sm;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.border-soft;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        alignment: center;

        if ResultsState2.z-stack-active: PlaneAxis {
            axis-label: "Z";
            value: ResultsState2.z-stack;
            max: ResultsState2.z-stack-max;
            changed(v) => { ResultsState2.z-stack = v; ResultsState2.z-changed(v); }
        }
        if ResultsState2.z-stack-active && ResultsState2.t-stack-active: Rectangle {
            width: 1px; height: 14px; background: Theme.border-soft;
        }
        if ResultsState2.t-stack-active: PlaneAxis {
            axis-label: "T";
            value: ResultsState2.t-stack;
            max: ResultsState2.t-stack-max;
            changed(v) => { ResultsState2.t-stack = v; ResultsState2.t-changed(v); }
        }
    }
}

// -- Breadcrumb bar: trail on the left, plane stepper docked on the right --
export component ResultsBreadcrumb inherits Rectangle {
    height: 38px;
    background: Theme.bg;

    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border-soft; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 6px;

        for item[i] in ResultsState2.breadcrumb: HorizontalLayout {
            spacing: 6px;
            if i > 0: Text { text: "›"; color: Theme.text-faint; font-size: 12px; vertical-alignment: center; }
            crumb-ta := TouchArea {
                enabled: i < ResultsState2.breadcrumb.length - 1;
                mouse-cursor: crumb-ta.enabled ? pointer : default;
                clicked => { ResultsState2.breadcrumb-nav(i); }

                Text {
                    text: item.label;
                    font-size: 12.5px;
                    font-family: Theme.font-sans;
                    font-weight: i == ResultsState2.breadcrumb.length - 1 ? 600 : 400;
                    color: i == ResultsState2.breadcrumb.length - 1 ? Theme.text : Theme.text-dim;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        GlobalPlaneStepper { }
    }
}

// -- Legend bar: gradient swatch + min/max, used by Matrix/Well/Charts ------
export component LegendBar inherits VerticalLayout {
    in property <string> value-label: "Value";
    in property <float> min-value: 0;
    in property <float> max-value: 100;

    spacing: 6px;

    Text { text: root.value-label; font-size: 10.5px; color: Theme.text-mute; letter-spacing: 0.3px; }

    Rectangle {
        height: 10px;
        border-radius: 5px;
        Rectangle { x: parent.width * 0.0; width: 20%; height: 100%; background: ValueColor.value-color(0.0); }
        Rectangle { x: parent.width * 0.2; width: 20%; height: 100%; background: ValueColor.value-color(0.25); }
        Rectangle { x: parent.width * 0.4; width: 20%; height: 100%; background: ValueColor.value-color(0.5); }
        Rectangle { x: parent.width * 0.6; width: 20%; height: 100%; background: ValueColor.value-color(0.75); }
        Rectangle { x: parent.width * 0.8; width: 20%; height: 100%; background: ValueColor.value-color(1.0); }
    }

    HorizontalLayout {
        Text { text: Math.round(root.min-value); font-size: 10px; font-family: Theme.font-mono; color: Theme.text-mute; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: Math.round(root.max-value); font-size: 10px; font-family: Theme.font-mono; color: Theme.text-mute; }
    }
}

// -- Small labeled dropdown button (Value / Aggregate / Class filter pills) --
export component FilterPill inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> pill-width: 150px;
    callback clicked;

    width: root.pill-width;
    height: 40px;
    border-radius: Theme.radius-sm;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.border-soft;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 4px;
        padding-bottom: 5px;
        spacing: 2px;

        Text { text: root.label; font-size: 9px; letter-spacing: 0.4px; color: Theme.text-mute; }
        HorizontalLayout {
            Text { text: root.value; font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            Text { text: "▾"; font-size: 9px; color: Theme.text-mute; vertical-alignment: center; }
        }
    }
}
