// results_common.slint — what the results views share: the Z/T plane
// stepper (Z/T is a filter for every view), the legend bar, and the filter
// pills.
import { InkButton, InkButtonKind } from "../ink/ink.slint";
import { BreadcrumbItem, ResultsRailMode, ResultsState } from "../api/results.slint";


import { Ink, InkIcons, InkCaption } from "../ink/ink.slint";

component PlaneAxis inherits HorizontalLayout {
    in property <string> axis-label;
    in property <int> value;
    in property <int> max;
    callback changed(int);

    spacing: 6px;
    cross-axis-alignment: center;

    Text {
        text: root.axis-label;
        font-size: 10.5px;
        font-family: Ink.font-mono;
        color: Ink.text-mute;
        vertical-alignment: center;
    }

    dec-ta := TouchArea {
        width: 16px;
        height: 16px;
        mouse-cursor: pointer;
        clicked => { root.changed(Math.max(0, root.value - 1)); }

        Rectangle {
            border-radius: Ink.radius-sm;
            background: dec-ta.has-hover ? Ink.raised : transparent;
            Text {
                text: "‹";
                color: Ink.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 11px;
            }
        }
    }

    inc-ta := TouchArea {
        width: 16px;
        height: 16px;
        mouse-cursor: pointer;
        clicked => { root.changed(Math.min(root.max, root.value + 1)); }

        Rectangle {
            border-radius: Ink.radius-sm;
            background: inc-ta.has-hover ? Ink.raised : transparent;
            Text {
                text: "›";
                color: Ink.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 11px;
            }
        }
    }

    Text {
        text: (root.value + 1) + "/" + (root.max + 1);
        font-size: 10.5px;
        font-family: Ink.font-mono;
        color: Ink.text;
        vertical-alignment: center;
        min-width: 30px;
    }
}

// Docked Z + T control — shown on the right of the breadcrumb bar in every
// view. Fully hidden (width 0) if neither axis is active for this dataset.
export component GlobalPlaneStepper inherits Rectangle {
    visible: ResultsState.z-stack-active || ResultsState.t-stack-active;
    width: root.visible ? self.preferred-width : 0px;
    height: 26px;
    border-radius: Ink.radius-sm;
    background: Ink.raised;
    border-width: 1px;
    border-color: Ink.border-soft;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        alignment: center;
        cross-axis-alignment: center;

        if ResultsState.z-stack-active: PlaneAxis {
            axis-label: "Z";
            value: ResultsState.z-stack;
            max: ResultsState.z-stack-max;
            changed(v) => { ResultsState.z-stack = v; ResultsState.z-changed(v); }
        }
        if ResultsState.z-stack-active && ResultsState.t-stack-active: Rectangle {
            width: 1px;
            height: 14px;
            background: Ink.border-soft;
        }
        if ResultsState.t-stack-active: PlaneAxis {
            axis-label: "T";
            value: ResultsState.t-stack;
            max: ResultsState.t-stack-max;
            changed(v) => { ResultsState.t-stack = v; ResultsState.t-changed(v); }
        }
    }
}

// -- Legend bar: gradient swatch + min/max, used by Matrix/Well/Charts ------
export component LegendBar inherits VerticalLayout {
    in property <string> value-label: "Value";
    in property <float> min-value: 0;
    in property <float> max-value: 100;
    // Sampled from the selected `ColorSchema` in Rust
    // (`color_scale_gradient` in results_generator.rs) — rendered here by
    // just splitting a `HorizontalLayout` evenly across the stops, so the
    // legend always matches the schema actually painting the plate cells
    // instead of a second, independent gradient definition living in Slint.
    in property <[color]> gradient-stops: [];
    // Only the Matrix Plate level has a real `ColorScale` behind it today
    // (see `MatrixFilter` in results_state_controller.rs) — Well/Charts
    // reuse this component purely for display, so the click-to-edit popup
    // is opt-in per use site.
    in property <bool> editable: false;
    in property <bool> is-manual: false;
    callback set-auto();
    callback set-manual(float, float);

    // Local, uncommitted "which tab is highlighted in the popup" state —
    // separate from `is-manual` (the last value Rust actually committed) so
    // opening the popup and clicking "Manual" can preview the min/max
    // fields before "Apply" is pressed.
    property <bool> manual-tab-selected: root.is-manual;

    spacing: 6px;

    Text {
        text: root.value-label;
        font-size: 10.5px;
        color: Ink.text-mute;
        letter-spacing: 0.3px;
    }

    Rectangle {
        height: 10px;
        border-radius: 5px;
        // Without `clip: true` the flat-colored stop segments below paint
        // square corners straight over this rectangle's rounded ones, so
        // the rounding never actually shows.
        clip: true;

        HorizontalLayout {
            for stop in root.gradient-stops: Rectangle {
                background: stop;
            }
        }

        // Only while `set_color_schemas_in_slint` hasn't run yet.
        if root.gradient-stops.length == 0: Rectangle {
            background: Ink.border-soft;
        }

        if root.editable: TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => {
                manual-tab-selected = root.is-manual;
                popup.show();
            }
        }
    }

    HorizontalLayout {
        Text {
            text: Math.round(root.min-value);
            font-size: 10px;
            font-family: Ink.font-mono;
            color: Ink.text-mute;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: Math.round(root.max-value);
            font-size: 10px;
            font-family: Ink.font-mono;
            color: Ink.text-mute;
        }
    }

    if root.is-manual: Text {
        text: "Manual";
        font-size: 9px;
        letter-spacing: 0.4px;
        color: Ink.text-faint;
        horizontal-alignment: center;
    }

    popup := PopupWindow {
        x: 0;
        y: 34px;
        width: 190px;
        close-policy: close-on-click-outside;
        height: 44px + (manual-tab-selected ? 130px : 0px);

        Rectangle {
            width: 190px;
            height: parent.height;
            background: Ink.panel;
            border-width: 1px;
            border-color: Ink.border;
            border-radius: Ink.radius-md;
            drop-shadow-color: Ink.shadow;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            clip: true;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 6px;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            manual-tab-selected = false;
                            root.set-auto();
                            popup.close();
                        }
                        Rectangle {
                            height: 26px;
                            border-radius: 6px;
                            background: manual-tab-selected ? Ink.raised : Ink.focus;
                            Text {
                                text: "Auto";
                                font-size: 11px;
                                font-weight: 600;
                                color: manual-tab-selected ? Ink.text : Ink.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { manual-tab-selected = true; }
                        Rectangle {
                            height: 26px;
                            border-radius: 6px;
                            background: manual-tab-selected ? Ink.focus : Ink.raised;
                            Text {
                                text: "Manual";
                                font-size: 11px;
                                font-weight: 600;
                                color: manual-tab-selected ? Ink.text : Ink.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if manual-tab-selected: VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: "MIN";
                        font-size: 9px;
                        letter-spacing: 0.4px;
                        color: Ink.text-mute;
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: Ink.radius-sm;
                        background: Ink.raised;
                        border-width: 1px;
                        border-color: min-input.has-focus ? Ink.focus : Ink.border-soft;
                        min-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            // Default value only — the conditional `if`
                            // block this lives in is recreated fresh each
                            // time the popup switches to the Manual tab, so
                            // this always starts at the currently displayed
                            // range rather than needing to be reset
                            // imperatively from the bar's click handler.
                            text: "\{root.min-value}";
                            vertical-alignment: center;
                            font-size: 11px;
                            color: Ink.text;
                            single-line: true;
                        }
                    }

                    Text {
                        text: "MAX";
                        font-size: 9px;
                        letter-spacing: 0.4px;
                        color: Ink.text-mute;
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: Ink.radius-sm;
                        background: Ink.raised;
                        border-width: 1px;
                        border-color: max-input.has-focus ? Ink.focus : Ink.border-soft;
                        max-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: "\{root.max-value}";
                            vertical-alignment: center;
                            font-size: 11px;
                            color: Ink.text;
                            single-line: true;
                        }
                    }

                    InkButton {
                        kind: InkButtonKind.primary;
                        text: "Apply";
                        height: 28px;
                        clicked => {
                            root.set-manual(min-input.text.to-float(), max-input.text.to-float());
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// -- Small labeled dropdown button (Value / Aggregate / Class filter pills) --
// A filter's label as a caption above, its value in a field - the look
// of `MultiSelectDropdown`; a click is for the caller to open its choices.
export component FilterPill inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> pill-width: 150px;
    callback clicked;

    width: root.pill-width;
    height: layout.preferred-height;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-action-default => {
        root.clicked();
    }

    layout := VerticalLayout {
        spacing: 3px;

        if root.label != "": InkCaption {
            text: root.label;
        }

        field := Rectangle {
            height: Ink.control-h;
            border-radius: Ink.radius-sm;
            background: ta.has-hover ? Ink.hover : Ink.field;
            border-width: 1px;
            border-color: ta.has-hover ? Ink.text-faint : Ink.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: root.value;
                    font-size: Ink.fs-md;
                    color: Ink.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Image {
                    source: InkIcons.caret-down;
                    width: 10px;
                    colorize: Ink.text-mute;
                }
            }

            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.clicked(); }
            }
        }
    }
}
