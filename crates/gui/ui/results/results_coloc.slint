// results_coloc.slint — left: plain object list. Right: for the selected
// object, every colocalizing partner with overlap % and the properties the
// user chose to compare (toggle chips control the extra columns).

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../style.slint";
import { ResultsState } from "results_state.slint";

component PropertyChip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked;

    height: 24px;
    border-radius: 12px;
    background: root.on ? Theme.accent-dim : transparent;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        font-size: 11px;
        color: root.on ? Theme.text : Theme.text-mute;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 10px;
        width: parent.width - 20px;
    }
}

export component ResultsColocView inherits Rectangle {
    background: Theme.bg;

    HorizontalLayout {
        spacing: 0px;

        // -- Left: object list --
        Rectangle {
            horizontal-stretch: 45;
            preferred-width: 0px;
            Rectangle {
                x: parent.width - 1px;
                y: 0;
                width: 1px;
                height: parent.height;
                background: Theme.border-soft;
            }

            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 32px;
                    Text {
                        x: 16px;
                        text: "OBJECTS";
                        font-size: 10px;
                        letter-spacing: 0.5px;
                        color: Theme.text-mute;
                        vertical-alignment: center;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 8px;
                        alignment: start;
                        for id in ResultsState.coloc-object-ids: obj-ta := TouchArea {
                            height: 34px;
                            mouse-cursor: pointer;
                            clicked => { ResultsState.coloc-object-selected(id.to-float()); }
                            Rectangle {
                                border-radius: Theme.radius-sm;
                                background: obj-ta.has-hover ? Theme.raised : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Text {
                                        text: "#" + id;
                                        font-size: 12.5px;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // -- Right: partners table for the selected object --
        VerticalLayout {
            horizontal-stretch: 55;
            preferred-width: 0px;
            spacing: 0px;

            Rectangle {
                height: 40px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "Colocalizing with #" + ResultsState.coloc-selected-id;
                        font-size: 10px;
                        letter-spacing: 0.5px;
                        color: Theme.text-mute;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    for prop in ResultsState.coloc-properties: PropertyChip {
                        label: prop;
                        on: ResultsState.coloc-active-properties.length > 0;
                        clicked => { ResultsState.coloc-property-toggled(prop); }
                    }
                }

                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border-soft;
                }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 12px;
                    alignment: start;

                    HorizontalLayout {
                        height: 26px;
                        Text {
                            text: "OBJECT";
                            width: 90px;
                            font-size: 10px;
                            color: Theme.text-mute;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "OVERLAP";
                            width: 80px;
                            font-size: 10px;
                            color: Theme.text-mute;
                            vertical-alignment: center;
                        }

                        for prop in ResultsState.coloc-active-properties: Text {
                            text: prop;
                            horizontal-stretch: 1;
                            font-size: 10px;
                            color: Theme.text-mute;
                            vertical-alignment: center;
                        }
                    }

                    for partner in ResultsState.coloc-partners: HorizontalLayout {
                        height: 30px;
                        cross-axis-alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 2px;
                            background: partner.class-color;
                        }

                        Text {
                            text: "#" + partner.id;
                            width: 82px;
                            font-size: 12px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }

                        Text {
                            text: partner.overlap-pct + "%";
                            width: 80px;
                            font-size: 12px;
                            font-family: Theme.font-mono;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        // Actual per-property values come from Rust-side row
                        // data keyed by the toggled properties — plug in your
                        // existing per-object value lookup here.
                        for prop in ResultsState.coloc-active-properties: Text {
                            text: "—";
                            horizontal-stretch: 1;
                            font-size: 12px;
                            font-family: Theme.font-mono;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
