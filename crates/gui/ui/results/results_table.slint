import { ListView, ScrollView, Spinner } from "std-widgets.slint";
import { Theme } from "../style.slint";

// -- Data model ----------------------------------------------------------------

export struct ResultsColumnDef {
    id: string,
    label: string,
    visible: bool,
    filterable: bool,
    // Column width in logical pixels, user-resizable via the header's right-edge handle.
    width: float,
}

export struct ResultsRow {
    object_id_int: int,
    // The source object's stable database id, or "" for rows with no single
    // source object (grouped rows) or where selection is disabled (coloc-detail
    // rows). Used for row-selection lookups instead of `object_id`, which is
    // only a positional display index and isn't stable across page reloads.
    object_id: string,
    values: [string],
    // Alternating zebra-stripe flag, computed in Rust: toggles every row in
    // the normal/grouped views, and toggles once per *source* object (not per
    // flattened row) in the coloc-detail view, so all of one source object's
    // colocalizing-partner rows read as a single band.
    stripe: bool,
}

export struct FilterItem {
    label: string,
    checked: bool,
    // Section this item belongs to in the column-visibility popup (e.g.
    // "Intensity" for all Ch* columns), or "" for an ungrouped item. Unused by
    // the image/class/coloc filter popups, which never set a group.
    group: string,
    // True on the first item of a new `group` run — the popup renders a
    // section header (with its own select-all toggle) right before it.
    group_header: bool,
    // Only meaningful when `group_header` is true: whether every item
    // sharing this `group` is currently checked, for the header's own
    // checkbox visual.
    group_all_checked: bool,
}

// One queued file in the export dialog's "combinations to export" list: a
// class subset (empty = every class) plus the format to write it in.
export struct ExportBatchItem {
    name: string,
    // Class labels to include; empty means "every class" (no filter applied).
    classes: [string],
    // Precomputed display string for the list row, e.g. "ClassA, ClassB" or
    // "All classes" — computed once in Rust when the batch is added so the
    // dialog doesn't need to join arrays itself.
    classes_label: string,
    // "csv" or "xlsx".
    format: string,
    // Image names in scope. Unlike `classes`, this is never empty for a
    // valid batch — even "every image" is stored as the concrete full list,
    // since `each_image` needs real names to iterate over.
    images: [string],
    // Precomputed display string, e.g. "image_01.tif, image_02.tif" or "All images".
    images_label: string,
    // When true, one output file is written per image in `images` (its name
    // folded into the output filename) instead of one file covering all of them.
    each_image: bool,
    // "table" or "coloc_detail" — captured at "Add" time, so a batch of
    // queued combinations can mix both export styles (and grouped/ungrouped
    // table exports) in one "Export All" run instead of sharing one style.
    style: string,
    // "none" | "image" | "regex" — grouping captured at "Add" time; only
    // meaningful when `style == "table"`.
    group_by: string,
    // Regex pattern, only meaningful when `group_by == "regex"`.
    group_regex: string,
    // Precomputed display string for the list row, e.g. "Table", "Table ·
    // Image", "Table · Regex", or "Coloc Details".
    style_label: string,
    // Column labels to include, captured from whichever column set matched
    // `style` at "Add" time; empty means "every column" (no filter). Captured
    // per-batch (not read live at export time) so a queued "Coloc Details"
    // combination doesn't end up filtered by a "Table"-style column
    // selection the user made afterwards, or vice versa.
    columns: [string],
}

export enum ResultsViewMode { table, chart, coloc_table }

// Which chart the chart view currently shows.
export enum ResultsChartKind { histogram, scatter, heatmap }

// How rows are bucketed before aggregation.
export enum ResultsGroupBy { none, image, folder, regex }

export global ResultsState {
    in-out property <[ResultsColumnDef]> columns: [
        { id: "object_id", label: "object ID", visible: true, filterable: false, width: 100.0 },
        { id: "image", label: "Image", visible: true, filterable: true, width: 100.0 },
        { id: "class", label: "Class", visible: true, filterable: true, width: 100.0 },
        { id: "area_px", label: "Area (px²)", visible: true, filterable: false, width: 100.0 },
        { id: "area_nm2", label: "Area (nm²)", visible: true, filterable: false, width: 100.0 },
        { id: "circularity", label: "Circularity", visible: true, filterable: false, width: 100.0 },
        { id: "colocalized", label: "Colocalized", visible: true, filterable: true, width: 100.0 },
    ];

    in property <[ResultsRow]> rows: [
        {
            object_id: 1,
            object_id: "",
            values: ["1", "image_01.tif", "Nucleus", "1234", "456.7", "0.92", "Yes"],
            stripe: true
        },
        {
            object_id: 2,
            object_id: "",
            values: ["2", "image_01.tif", "Cytoplasm", "5678", "2109.3", "0.71", "No"],
            stripe: false
        },
        {
            object_id: 3,
            object_id: "",
            values: ["3", "image_02.tif", "Nucleus", "987", "365.4", "0.88", "No"],
            stripe: true
        },
        {
            object_id: 4,
            object_id: "",
            values: ["4", "image_02.tif", "Artifact", "312", "115.6", "0.43", "No"],
            stripe: false
        },
    ];

    in-out property <int> selected_object_id:     0;
    in-out property <int> scroll_to_row_index: -1;
    in-out property <string> sort_column_id:      "";
    in-out property <bool> sort_ascending:      true;
    in-out property <bool> filter_active:       false;
    in-out property <ResultsViewMode> view_mode:  ResultsViewMode.table;

    // -- Image-column filter ---------------------------------------------------
    in-out property <[FilterItem]> filter_image_items: [];
    in-out property <[FilterItem]> filter_image_popup: [];
    in-out property <bool> filter_image_active: false;
    in-out property <bool> filter_image_all_popup_checked: true;

    // -- Class-column filter ---------------------------------------------------
    in-out property <[FilterItem]> filter_class_items: [];
    in-out property <[FilterItem]> filter_class_popup: [];
    in-out property <bool> filter_class_active: false;
    in-out property <bool> filter_class_all_popup_checked: true;

    // -- Colocalized-column filter ----------------------------------------------
    in-out property <[FilterItem]> filter_coloc_items: [];
    in-out property <[FilterItem]> filter_coloc_popup: [];
    in-out property <bool> filter_coloc_active: false;
    in-out property <bool> filter_coloc_all_popup_checked: true;

    callback object_row_selected(string);
    callback sort_requested(string, bool);
    callback copy_to_clipboard();
    callback filter_clicked();
    callback column_visibility_toggled(string, bool);
    callback clear_all_filters();
    callback filter_apply();
    callback load_more_rows();
    // Mirrors `load_more_rows()` for the opposite (top) scroll edge: fired
    // when scrolled near the top and an earlier page was evicted from memory
    // (bounded scroll-memory window — see `RowWindow` in the Rust app crate),
    // so Rust can transparently re-fetch and prepend it.
    callback load_previous_rows();

    in-out property <bool> loading_more:    false;
    in-out property <bool> all_rows_loaded: false;
    // Mirrors `all_rows_loaded` for the top edge: false once the window's
    // oldest loaded page is no longer page 0 (i.e. an earlier page has been
    // evicted and could be backfilled by scrolling up).
    in-out property <bool> at_top_loaded: true;
    // Rust sets this to ±N immediately after editing the front of `rows` to
    // evict/prepend N rows, so the view can compensate the scroll position by
    // the same N row-heights and the edit is invisible to the user. Consumed
    // once by `changed front_row_delta` below, then reset to 0.
    in-out property <int> front_row_delta: 0;
    // True while a group_apply() is being processed by Rust. Set by the Slint UI
    // immediately on any group action; cleared when rows arrive or preset state
    // settles. Keeps the spinner visible across the gap where loading_more has
    // already gone false but the grouped rows haven't been delivered yet.
    in-out property <bool> group_computing: false;
    in-out property <int> visible_column_count: 7;
    // Sum of visible columns' widths (logical px), recomputed whenever `columns` is rebuilt.
    in-out property <float> columns_total_width: 700.0;
    // User dragged a column's right-edge resize handle to a new width (logical px).
    callback column_width_changed(string, float);

    callback image_filter_label_toggled(string);
    callback image_filter_search_changed(string);
    callback image_select_all();
    callback image_clear_all();

    callback class_filter_label_toggled(string);
    callback class_filter_search_changed(string);
    callback class_select_all();
    callback class_clear_all();

    callback coloc_filter_label_toggled(string);
    callback coloc_filter_search_changed(string);
    callback coloc_select_all();
    callback coloc_clear_all();

    // -- Column-visibility popup -------------------------------------------
    in-out property <[FilterItem]> column_items: [];
    in-out property <[FilterItem]> column_popup: [];
    in-out property <bool> column_popup_all_checked: true;

    callback column_label_toggled(string);
    callback column_search_changed(string);
    callback column_select_all();
    callback column_clear_all();
    callback column_filter_apply();
    // Selects/clears every column belonging to one popup section at once
    // (e.g. all "Intensity" columns), so the user doesn't have to untick
    // each channel column one by one.
    callback column_group_toggle(string);

    // -- Group-by / aggregation -------------------------------------------
    in-out property <ResultsGroupBy> group_by:   ResultsGroupBy.none;
    in-out property <string> group_regex:        "";
    // Aggregates to compute (multi-select). Each ticked function adds one
    // column per visible metric.
    in-out property <bool> group_agg_min:        false;
    in-out property <bool> group_agg_max:        false;
    in-out property <bool> group_agg_avg:        true;
    in-out property <bool> group_agg_median:     false;
    in-out property <bool> group_agg_stdev:      false;
    in-out property <bool> group_agg_sum:        false;
    // When true, each group is additionally split into a colocalizing and a
    // non-colocalizing row.
    in-out property <bool> group_split_colocalized: false;
    // When true, each group is additionally split by class (e.g. "Image1 /
    // Class1", "Image1 / Class2", …).
    in-out property <bool> group_by_class: false;
    // True while a non-`none` grouping is applied (drives the status badge).
    in-out property <bool> group_active:         false;
    // Applies the current group_by / group_regex / aggregate selection.
    callback group_apply();
    // Switches to the colocalization detail flat table (one row per source × partner pair).
    callback coloc_detail_requested();

    // -- Chart view ---------------------------------------------------------
    in-out property <ResultsChartKind> chart_kind: ResultsChartKind.histogram;
    // Numeric column labels available to plot (visible numeric metrics only).
    in property <[string]> chart_plottable_columns: [];
    in-out property <string> chart_hist_column:   "";
    in-out property <string> chart_scatter_x:     "";
    in-out property <string> chart_scatter_y:     "";
    // "" / "class" / "colocalized" — which categorical dimension colors scatter points.
    in-out property <string> chart_color_by:      "";
    in-out property <int> chart_bucket_count:     20;
    // Bins histogram buckets equally in log space instead of linear space —
    // fixes right-skewed data (e.g. cell area) where a few large outliers
    // otherwise crowd almost every value into the first bucket or two.
    in-out property <bool> chart_log_scale:       false;
    // First entry is always the "Count" sentinel; the rest mirror
    // chart_plottable_columns. Picking the first entry colors heatmap cells
    // by object count, picking any other averages that column per cell.
    in property <[string]> chart_heatmap_metric_options: [];
    in-out property <string> chart_heatmap_metric: "";
    // Raster cell size, in image pixels (square cells).
    in-out property <int> chart_cell_size_px:      20;
    // Color scheme labels the heatmap gradient picker can choose from
    // (e.g. "Viridis", "Magma", "Plasma", "Grayscale").
    in property <[string]> chart_heatmap_color_scheme_options: [];
    in-out property <string> chart_heatmap_color_scheme: "Viridis";
    // Whether the color scale's [min, max] is recomputed from the current
    // data on every render (true) or pinned to chart_heatmap_range_min/max
    // (false) - persists across repaints so different heatmaps can be
    // compared under an identical color mapping. Editing either range field
    // switches this to false; the "Auto" button switches it back to true.
    in-out property <bool> chart_heatmap_range_auto: true;
    // The color scale's range. While chart_heatmap_range_auto is true, the
    // controller overwrites these after every render with the range it
    // actually used, so they always reflect what's on screen (a starting
    // point if the user then wants to switch to manual and fine-tune).
    in-out property <float> chart_heatmap_range_min: 0.0;
    in-out property <float> chart_heatmap_range_max: 1.0;
    // Rendered chart bitmap, built by the controller via the `plotters` crate.
    in property <image> chart_image;
    // Empty while a chart is shown; otherwise an explanatory/placeholder
    // message (e.g. "Pick a column to plot", "showing 5,000 of 42,310 points").
    in property <string> chart_status: "Pick a column and click Plot";
    // Re-renders the chart from the current picks + current table filters.
    callback chart_render_requested();
    // Saves the most recently rendered chart (see chart_image) to a PNG file
    // the user picks. No-op until at least one chart has been rendered.
    callback chart_save_requested();
    // What's at a clicked point in the chart area, for a tap-to-inspect
    // tooltip. mouse_x/mouse_y are pixels relative to the chart Image's
    // displayed area (not the underlying bitmap — image-fit: contain can
    // letterbox it), area_width/area_height that area's current size; both
    // as reported by the TouchArea overlaid on the chart in
    // results_chart.slint. Returns "" when there's nothing to show (outside
    // the plot area, no chart rendered yet, etc).
    callback chart_point_lookup(float, float, float, float) -> string;

    // -- Frame navigation (time/depth stacks) --------------------------------
    // True only when the loaded file actually has more than one t_stack/
    // z_stack value — files without a time/depth axis show no stepper at all.
    in property <bool> t_stack_active: false;
    in property <int> t_stack_min: 0;
    in property <int> t_stack_max: 0;
    in-out property <int> selected_t_stack: 0;
    // True = every frame is shown (today's default); false = restrict to
    // selected_t_stack only.
    in-out property <bool> t_stack_show_all: true;
    callback t_stack_changed(int, bool);

    in property <bool> z_stack_active: false;
    in property <int> z_stack_min: 0;
    in property <int> z_stack_max: 0;
    in-out property <int> selected_z_stack: 0;
    in-out property <bool> z_stack_show_all: true;
    callback z_stack_changed(int, bool);

    // -- Export dialog --------------------------------------------------------
    // One toolbar button opens this dialog; all format/class-subset choices
    // live here instead of on the toolbar.
    in-out property <bool> export_dialog_active: false;
    // Per-dialog-session class checklist — independent of the table's own
    // Class column filter, seeded fresh (all checked) each time the dialog
    // opens (see `export_dialog_open`).
    in-out property <[FilterItem]> export_class_items: [];
    in-out property <bool> export_class_all_checked: true;
    // Live "checked/total" counts for the checklist, computed in Rust
    // alongside `export_class_all_checked` above (Slint's function bodies
    // have no loop or array-reduce construct, so this can't be computed
    // in-component).
    in-out property <int> export_class_checked_count: 0;
    in-out property <int> export_class_total_count: 0;
    // Search-filtered subset of `export_class_items` actually drawn by the
    // ChecklistBox — recomputed in Rust on every keystroke and every
    // mutation (toggle/select-all/clear-all), since Slint has no string
    // `.contains()` to filter with in-component.
    in-out property <[FilterItem]> export_class_displayed_items: [];
    // Two-way bound to the ChecklistBox's own filter LineEdit, so Rust can
    // clear it when the dialog re-opens (see `export_dialog_open`) and read
    // the current text at every mutation site without a separate copy.
    in-out property <string> export_class_search_text: "";
    // Labels of up to the first 4 checked items (in `export_class_items`
    // order), for the collapsed PickerField's chip row. Computed in Rust
    // alongside the counts above — Slint has neither a loop/array-reduce
    // construct nor recursive `pure function`s (self-calls are treated as a
    // binding loop), so walking `export_class_items` to find the first N
    // checked entries can't be done in-component either.
    in-out property <[string]> export_class_chip_labels: [];
    // Per-dialog-session image checklist — independent of the table's own
    // Image column filter, seeded fresh (all checked) each time the dialog
    // opens. Scopes the export to the checked images; combined with
    // `export_each_image` below, also drives per-image file fan-out.
    in-out property <[FilterItem]> export_image_items: [];
    in-out property <bool> export_image_all_checked: true;
    in-out property <int> export_image_checked_count: 0;
    in-out property <int> export_image_total_count: 0;
    in-out property <[FilterItem]> export_image_displayed_items: [];
    in-out property <string> export_image_search_text: "";
    in-out property <[string]> export_image_chip_labels: [];
    // When true, "Add" queues a batch that writes one output file per
    // checked image (its name folded into the filename) instead of one
    // file covering all of them together.
    in-out property <bool> export_each_image: false;
    // "table" (per-object / grouped, mirrors the normal table view) or
    // "coloc_detail" (flattened source × partner rows, mirrors Coloc
    // Details). Switching this re-seeds `export_column_items` from the
    // matching column set.
    in-out property <string> export_style: "table";
    // "none" | "image" | "regex" — overrides whatever grouping is active in
    // the main table for the purposes of this export. Only meaningful when
    // `export_style` is "table"; Coloc Details export is always flat.
    in-out property <string> export_group_by: "none";
    // Regex pattern, only used when `export_group_by == "regex"`.
    in-out property <string> export_group_regex: "";
    // Per-dialog-session column checklist — which columns of the chosen
    // `export_style` end up in the file. Re-seeded (all checked) whenever
    // the dialog opens or `export_style` changes.
    in-out property <[FilterItem]> export_column_items: [];
    in-out property <bool> export_column_all_checked: true;
    in-out property <int> export_column_checked_count: 0;
    in-out property <int> export_column_total_count: 0;
    in-out property <[FilterItem]> export_column_displayed_items: [];
    in-out property <string> export_column_search_text: "";
    in-out property <[string]> export_column_chip_labels: [];
    // Whether `export_column_items` currently has any "Intensity"-grouped
    // column — gates showing the Intensity quick-pick buttons (None / Avg+Sum
    // / All), which would otherwise be a no-op for a file with no channels.
    in-out property <bool> export_has_intensity: false;
    // Name + format for the combination currently being assembled from the
    // checklists above; "Add" appends a snapshot of these to `export_batches`.
    in-out property <string> export_combo_name: "";
    // "csv" or "xlsx".
    in-out property <string> export_format: "csv";
    // Queued combinations; each produces one output file when "Export All"
    // runs. May be empty — in that case Export All uses the checklist/name/
    // format above directly, as a single one-off export.
    in-out property <[ExportBatchItem]> export_batches: [];
    in-out property <bool> export_running: false;
    // Progress/result/validation message shown at the bottom of the dialog.
    in-out property <string> export_status: "";
    // How many of `export_progress_total` output files have been attempted
    // so far (updated live while `export_running` is true).
    in-out property <int> export_progress_current: 0;
    in-out property <int> export_progress_total: 0;
    // Same information as a 0..1 fraction, precomputed in Rust (avoids
    // integer-division/divide-by-zero edge cases in the .slint binding) for
    // the progress bar's `progress` property.
    in-out property <float> export_progress_fraction: 0.0;

    callback export_dialog_open();
    callback export_dialog_close();
    callback export_class_item_toggled(string);
    callback export_class_select_all();
    callback export_class_clear_all();
    // Fired on every keystroke in the Classes ChecklistBox's filter box.
    // Slint has no string `.contains()`, so the search-filtered
    // `export_class_displayed_items` list is computed in Rust.
    callback export_class_search_changed(string);
    callback export_image_item_toggled(string);
    callback export_image_select_all();
    callback export_image_clear_all();
    callback export_image_search_changed(string);
    callback export_style_selected(string);
    callback export_column_item_toggled(string);
    callback export_column_select_all();
    callback export_column_clear_all();
    callback export_column_search_changed(string);
    callback export_column_group_toggle(string);
    // "none" | "avg_sum" | "all" — quick picks scoped to the Intensity section only.
    callback export_column_intensity_preset(string);
    // Copies one "Coloc {Class}" section's checked pattern onto every other
    // Coloc class section (by field position), so configuring columns for
    // one partner class can be stamped onto the rest instead of repeating
    // the same clicks per class.
    callback export_column_apply_group_to_all(string);
    // Queues the current checklist/name/format as one combination to export.
    callback export_add_batch();
    // Queues a combination captured from the results table's own current
    // filters/style/grouping/columns (not the dialog's checklists), using
    // the current Name/Format fields — for stamping "whatever the table is
    // showing right now" into the batch alongside other configured combos.
    callback export_add_batch_from_table();
    callback export_remove_batch(int);
    // Picks an output folder, then writes one file per queued combination
    // (or the checklist directly, if none are queued).
    callback export_run_all();
    // Requests the in-progress export stop after its current file finishes.
    callback export_cancel();
    // Immediately exports a single file matching the results table's own
    // current filters/style/grouping/columns — bypasses the batch queue
    // entirely, for a quick "just export what I'm looking at" action.
    callback export_as_displayed();
}

// -- Shared checkbox item used inside filter popups ----------------------------

export component FilterCheckbox inherits Rectangle {
    in property <string> label;
    in property <bool> checked: true;
    in property <bool> bold: false;
    callback toggled;

    height: 24px;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }

    background: ta.has-hover ? Theme.hover.with-alpha(0.3) : transparent;
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 7px;
        alignment: start;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 13px;
                height: 13px;
                border-radius: 2px;
                border-width: 1.5px;
                border-color: root.checked ? Theme.accent : Theme.border;
                background: root.checked ? Theme.accent : transparent;

                if root.checked: Image {
                    source: @image-url("../icons/regular-black/check.svg");
                    width: 9px;
                    height: 9px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: white;
                }
            }
        }

        Text {
            text: root.label;
            font-size: 11px;
            font-family: Theme.font-mono;
            font-weight: root.bold ? 600 : 400;
            color: root.checked ? Theme.text-dim : Theme.text-mute;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

// -- Column header with inline Excel-style filter popup -----------------------

component ResultsHeaderCell inherits Rectangle {
    in property <string> label;
    in property <string> col-id;
    in property <bool> sorted:               false;
    in property <bool> sort-asc:             true;
    in property <bool> filterable:           false;
    in property <bool> filter-active:        false;
    in property <bool> all-popup-checked:    true;
    in-out property <[FilterItem]> popup-items: [];
    // Controls layout collapse — set to false for hidden columns.
    // Using a custom in-property so the internal bindings below can reference it;
    // external assignment to built-in min-width cannot override an internal binding.
    in property <bool> col-visible: true;
    // Explicit, pre-rounded column width shared with the data cells. Fixed
    // (min == max, no stretch) so the header and rows are laid out identically
    // and never drift apart due to independent stretch rounding.
    in property <length> cell-width: 100px;
    property <bool> popup-open: false;
    callback clicked;
    callback filter-label-toggled(string);
    callback filter-search-changed(string);
    callback filter-select-all();
    callback filter-clear-all();
    callback filter-apply;
    // Emits the live width (logical px) while the right-edge handle is being dragged.
    callback width-changed(float);

    min-width: root.col-visible ? root.cell-width : 0px;
    max-width: root.col-visible ? root.cell-width : 0px;
    horizontal-stretch: 0;
    height: 32px;
    background: Theme.raised;

    header-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Rectangle {
        background: header-ta.has-hover ? Theme.hover.with-alpha(0.35) : transparent;
        animate background { duration: 100ms; }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 2px;
        alignment: space-between;

        Text {
            text: root.label;
            font-size: 11px;
            font-family: Theme.font-mono;
            font-weight: root.sorted ? 600 : 400;
            color: root.sorted ? Theme.accent : Theme.text-dim;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.sorted: Image {
            source: root.sort-asc ? @image-url("../icons/regular-black/sort-ascending.svg") : @image-url("../icons/regular-black/sort-descending.svg");
            width: 11px;
            height: 11px;
            colorize: Theme.accent;
        }

        if root.filterable: TouchArea {
            width: 22px;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => {
                root.popup-open = true;
                filter-popup.show();
            }

            Image {
                source: @image-url("../icons/regular-black/funnel.svg");
                width: 11px;
                height: 11px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.filter-active ? Theme.accent : Theme.text-dim;
                opacity: root.filter-active ? 1.0 : 0.55;
            }
        }
    }

    // Column divider
    Rectangle {
        x: parent.width - 1px;
        y: 6px;
        width: 1px;
        height: parent.height - 12px;
        background: Theme.border;
    }

    // Excel-style right-edge resize handle. Declared last so it takes pointer-event
    // priority over `header-ta` in its narrow strip. Each `moved` event (while pressed)
    // nudges the width by the cursor's offset from the handle's own center — the edge
    // self-corrects to track the cursor without needing to remember the press-start width.
    resize-ta := TouchArea {
        x: parent.width - 4px;
        width: 8px;
        height: parent.height;
        mouse-cursor: col-resize;
        property <bool> dragging: false;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    self.dragging = true;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    self.dragging = false;
                }
            }
        }
        moved => {
            if (self.dragging) {
                let delta = (self.mouse-x - self.width / 2) / 1px;
                root.width-changed(Math.max(40.0, root.cell-width / 1px + delta));
            }
        }
    }

    // Excel-style dropdown popup -----------------------------------------------
    filter-popup := PopupWindow {
        x: 0px;
        y: root.height;
        width: 230px;
        height: 320px;
        close-policy: no-auto-close;

        Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000036;
            drop-shadow-offset-y: 4px;
            clip: true;

            VerticalLayout {
                spacing: 0px;

                // -- Search field ------------------------------------------
                Rectangle {
                    height: 34px;
                    background: Theme.bg;

                    HorizontalLayout {
                        padding: 4px;
                        spacing: 4px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 26px;
                            background: Theme.bg;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 4px;
                                spacing: 5px;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/regular-black/magnifying-glass.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: Theme.text-mute;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;

                                    search-input := TextInput {
                                        width: parent.width;
                                        font-size: 11px;
                                        font-family: Theme.font-mono;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        edited => {
                                            root.filter-search-changed(self.text);
                                        }
                                    }

                                    if search-input.text == "": Text {
                                        x: 0px;
                                        y: (parent.height - self.height) / 2;
                                        text: "Search…";
                                        font-size: 11px;
                                        color: Theme.text-faint;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-soft;
                }

                // -- (Select All) — TouchArea as root (MultiClassDropdown style)
                sel-all-ta := TouchArea {
                    height: 26px;
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.all-popup-checked) {
                            root.filter-clear-all();
                        } else {
                            root.filter-select-all();
                        }
                    }

                    Rectangle {
                        background: sel-all-ta.has-hover ? Theme.raised : transparent;
                        animate background { duration: 80ms; }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 7px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 13px;
                                    height: 13px;
                                    border-radius: 2px;
                                    border-width: 1.5px;
                                    border-color: root.all-popup-checked ? Theme.accent : Theme.border;
                                    background: root.all-popup-checked ? Theme.accent : transparent;

                                    if root.all-popup-checked: Image {
                                        source: @image-url("../icons/regular-black/check.svg");
                                        width: 9px;
                                        height: 9px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: white;
                                    }
                                }
                            }

                            Text {
                                text: "(Select All)";
                                font-size: 11px;
                                font-family: Theme.font-mono;
                                font-weight: 600;
                                color: root.all-popup-checked ? Theme.text-dim : Theme.text-mute;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-soft;
                }

                // -- Item list — ScrollView + TouchArea root per item ----------
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 2px;
                        spacing: 0px;

                        for item in (root.popup-open ? root.popup-items : []): item-ta := TouchArea {
                            height: 26px;
                            mouse-cursor: pointer;
                            clicked => {
                                root.filter-label-toggled(item.label);
                            }

                            Rectangle {
                                background: item-ta.has-hover ? Theme.raised : transparent;
                                animate background { duration: 80ms; }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 6px;
                                    spacing: 7px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 13px;
                                            height: 13px;
                                            border-radius: 2px;
                                            border-width: 1.5px;
                                            border-color: item.checked ? Theme.accent : Theme.border;
                                            background: item.checked ? Theme.accent : transparent;

                                            if item.checked: Image {
                                                source: @image-url("../icons/regular-black/check.svg");
                                                width: 9px;
                                                height: 9px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                colorize: white;
                                            }
                                        }
                                    }

                                    Text {
                                        text: item.label;
                                        font-size: 11px;
                                        font-family: Theme.font-mono;
                                        color: item.checked ? Theme.text-dim : Theme.text-mute;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }

                // -- Done button -----------------------------------------------
                Rectangle {
                    height: 1px;
                    background: Theme.border-soft;
                }

                done-ta := TouchArea {
                    height: 28px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.filter-apply();
                        root.popup-open = false;
                        filter-popup.close();
                    }

                    Rectangle {
                        background: done-ta.has-hover ? Theme.raised : transparent;
                        animate background { duration: 80ms; }

                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: "Done";
                                font-size: 11px;
                                font-family: Theme.font-sans;
                                color: Theme.accent;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// -- Row components ------------------------------------------------------------

component ResultsDataCell inherits Rectangle {
    in property <string> value;
    in property <bool> selected;
    in property <bool> mono: false;
    in property <bool> col-visible: true;
    // Explicit, pre-rounded column width shared with the header cells.
    in property <length> cell-width: 100px;

    min-width: root.col-visible ? root.cell-width : 0px;
    max-width: root.col-visible ? root.cell-width : 0px;
    horizontal-stretch: 0;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;

        Text {
            text: root.value != "" ? root.value : "–";
            font-size: 12px;
            font-family: root.mono ? Theme.font-mono : Theme.font-sans;
            color: root.selected ? Theme.text : Theme.text-dim;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border-soft;
    }
}

component ResultsDataRow inherits Rectangle {
    in property <ResultsRow> data;
    in property <bool> selected;
    // Horizontal scroll offset supplied by the parent table component.
    in property <length> h-offset: 0px;
    // Total content width, supplied by the parent so the row matches the header exactly
    // (computed once in ResultsTable; deriving it from this row's own size would diverge).
    // Per-column width comes straight from `ResultsState.columns[i].width` below, the same
    // source the header reads, so the two can never drift apart.
    in property <length> content-width: 0px;
    callback row-clicked;

    height: 32px;
    clip: true;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.row-clicked();
        }
    }

    background: root.selected ? Theme.list-select-row-bg : (ta.has-hover ? Theme.raised : (root.data.stripe ? transparent : Theme.list-row-alt-bg));

    if root.selected: Rectangle {
        x: 0px;
        width: 3px;
        height: parent.height;
        background: Theme.list-select-row-border-color;
    }

    // Content is wider than the visible area when there are many columns.
    // The clip above hides the overflow; h-offset pans the content.
    HorizontalLayout {
        x: -root.h-offset;
        width: root.content-width;
        alignment: start;
        for col[i] in ResultsState.columns: ResultsDataCell {
            visible: col.visible;
            col-visible: col.visible;
            cell-width: col.width * 1px;
            value: root.data.values.length > i ? root.data.values[i] : "";
            selected: root.selected;
            mono: i == 0;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border-soft.with-alpha(0.6);
    }
}

// -- Public export -------------------------------------------------------------

export component ResultsTable inherits Rectangle {
    // Total width is the sum of every visible column's own (user-resizable) width, kept
    // in sync by Rust whenever `columns` is rebuilt. Both the sticky header and every data
    // row read each column's width directly off `ResultsState.columns[i].width`, so the two
    // can never drift apart.
    property <length> content-width: max(table-scroll.visible-width, ResultsState.columns_total_width * 1px);
    property <int> rows-count-proxy: ResultsState.rows.length;
    changed rows-count-proxy => {
        if (ResultsState.rows.length > 0) {
            ResultsState.group_computing = false;
        }
    }

    VerticalLayout {
        spacing: 0;

        // -- Sticky column header (clips & follows horizontal scroll) ----------
        Rectangle {
            height: 32px;
            clip: true;

            HorizontalLayout {
                x: h-scroll-view.viewport-x;
                width: root.content-width;
                alignment: start;

                for col in ResultsState.columns: ResultsHeaderCell {
                    visible: col.visible;
                    col-visible: col.visible;
                    cell-width: col.width * 1px;
                    label: col.label;
                    col-id: col.id;
                    sorted: ResultsState.sort_column_id == col.id;
                    sort-asc: ResultsState.sort_ascending;
                    // `group`/`group_class` are the grouped view's stand-ins for
                    // `image`/`class` (grouping replaces those columns, but the
                    // filter still restricts which *source* ROIs are grouped —
                    // see `build_group_specs`), so they share the same image/
                    // class filter popups rather than losing filter access
                    // entirely the moment grouping is turned on.
                    property <bool> is-image-col: col.id == "image" || col.id == "group";
                    property <bool> is-class-col: col.id == "class" || col.id == "group_class";
                    filterable: col.filterable;
                    filter-active: is-image-col ? ResultsState.filter_image_active : (is-class-col ? ResultsState.filter_class_active : ResultsState.filter_coloc_active);
                    popup-items: col.filterable ? (is-image-col ? ResultsState.filter_image_popup : (is-class-col ? ResultsState.filter_class_popup : ResultsState.filter_coloc_popup)) : [];
                    all-popup-checked: is-image-col ? ResultsState.filter_image_all_popup_checked : (is-class-col ? ResultsState.filter_class_all_popup_checked : ResultsState.filter_coloc_all_popup_checked);

                    clicked => {
                        if (ResultsState.sort_column_id == col.id) {
                            ResultsState.sort_ascending = !ResultsState.sort_ascending;
                        } else {
                            ResultsState.sort_column_id = col.id;
                            ResultsState.sort_ascending = true;
                        }
                        ResultsState.sort_requested(col.id, ResultsState.sort_ascending);
                    }
                    filter-label-toggled(lbl) => {
                        if (is-image-col) {
                            ResultsState.image_filter_label_toggled(lbl);
                        }
                        if (is-class-col) {
                            ResultsState.class_filter_label_toggled(lbl);
                        }
                        if (col.id == "colocalized") {
                            ResultsState.coloc_filter_label_toggled(lbl);
                        }
                    }
                    filter-search-changed(txt) => {
                        if (is-image-col) {
                            ResultsState.image_filter_search_changed(txt);
                        }
                        if (is-class-col) {
                            ResultsState.class_filter_search_changed(txt);
                        }
                        if (col.id == "colocalized") {
                            ResultsState.coloc_filter_search_changed(txt);
                        }
                    }
                    filter-select-all => {
                        if (is-image-col) {
                            ResultsState.image_select_all();
                        }
                        if (is-class-col) {
                            ResultsState.class_select_all();
                        }
                        if (col.id == "colocalized") {
                            ResultsState.coloc_select_all();
                        }
                    }
                    filter-clear-all => {
                        if (is-image-col) {
                            ResultsState.image_clear_all();
                        }
                        if (is-class-col) {
                            ResultsState.class_clear_all();
                        }
                        if (col.id == "colocalized") {
                            ResultsState.coloc_clear_all();
                        }
                    }
                    filter-apply => {
                        ResultsState.filter_apply();
                    }
                    width-changed(new-width) => {
                        ResultsState.column_width_changed(col.id, new-width);
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        // -- Scrollable row list (horizontal + vertical) -----------------------
        Rectangle {
            vertical-stretch: 1;

            property <int> scroll_trigger: ResultsState.scroll_to_row_index;
            changed scroll_trigger => {
                if (ResultsState.scroll_to_row_index >= 0) {
                    table-scroll.viewport-y = Math.clamp(
                        -(ResultsState.scroll_to_row_index * 32px) + table-scroll.height / 2 - 16px,
                        table-scroll.height - table-scroll.viewport-height,
                        0px);
                }
            }

            // Rust sets `ResultsState.front_row_delta` right after editing the
            // front of `rows` (evicting rows scrolled past, or prepending a
            // backfilled page) — this compensates the scroll position by the
            // same number of row-heights so the edit is invisible to the user,
            // the same "scroll anchoring" technique `scroll_trigger` above uses
            // for jump-to-row.
            property <int> front_row_delta_trigger: ResultsState.front_row_delta;
            changed front_row_delta_trigger => {
                if (ResultsState.front_row_delta != 0) {
                    table-scroll.viewport-y += ResultsState.front_row_delta * 32px;
                    ResultsState.front_row_delta = 0;
                }
            }

            // ListView virtualizes rows — only visible rows are rendered.
            // No viewport-width set here: preserves Slint's virtualization.
            // Horizontal scrolling is handled by clip+translate in each row.
            table-scroll := ListView {
                width: 100%;
                height: 100%;
                horizontal-scrollbar-policy: always-off;

                changed viewport-y => {
                    if (!ResultsState.all_rows_loaded && !ResultsState.loading_more && table-scroll.viewport-height + table-scroll.viewport-y - table-scroll.height < 3 * 32px) {
                        ResultsState.load_more_rows();
                    }
                    if (!ResultsState.at_top_loaded && !ResultsState.loading_more && table-scroll.viewport-y > -3 * 32px) {
                        ResultsState.load_previous_rows();
                    }
                }

                for data in ResultsState.rows: ResultsDataRow {
                    data: data;
                    selected: ResultsState.selected_object_id == data.object_id_int;
                    h-offset: -h-scroll-view.viewport-x;
                    content-width: root.content-width;
                    row-clicked => {
                        ResultsState.selected_object_id = data.object_id_int;
                        ResultsState.object_row_selected(data.object_id);
                    }
                }
            }

            // Spinner shown while the next page is loading — centered floating card.
            if ResultsState.loading_more || ResultsState.group_computing: Rectangle {
                x: (parent.width - 52px) / 2;
                y: (parent.height - 52px) / 2;
                width: 52px;
                height: 52px;
                background: Theme.panel;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000024;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        Spinner {
                            indeterminate: true;
                            width: 24px;
                            height: 24px;
                        }
                    }
                }
            }

            if ResultsState.rows.length == 0: Rectangle {
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    Image {
                        source: @image-url("../icons/regular-black/table.svg");
                        width: 32px;
                        height: 32px;
                        colorize: Theme.text-faint;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "No results yet. Run an analysis to populate this table.";
                        font-size: 12px;
                        color: Theme.text-faint;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Horizontal scrollbar — appears only when columns overflow the viewport.
        // Rows clip their content and translate by viewport-x for smooth h-scroll.
        h-scroll-view := ScrollView {
            height: 14px;
            horizontal-scrollbar-policy: as-needed;
            vertical-scrollbar-policy: always-off;
            viewport-width: max(self.width, ResultsState.columns_total_width * 1px);
        }
    }
}
