// results/results_view_bar.slint — the bar on top of every results view
// (design canvas "Results rework", A): what is shown, as chips that open a
// popover each, then the view's own few settings; on the right how many
// rows, the pages and ⋯. One look for List, Plate, Charts, Tracks, Paths.
//
//   ViewBar { BarChip { … popover content … } … BarSpacer { } BarCount { } BarMore { … } }

import { Ink, InkIcons, InkIconButton, InkMenuFrame, InkSegmented } from "../ink/ink.slint";
import { ScrollView } from "std-widgets.slint";

// The bar's frame: a panel across the view, its parts in a row.
export component ViewBar inherits Rectangle {
    background: Ink.panel;
    border-radius: Ink.radius-lg;
    border-width: 1px;
    border-color: Ink.border;
    height: row.preferred-height;

    row := HorizontalLayout {
        padding: 8px;
        padding-left: 10px;
        spacing: 8px;
        @children
    }
}

// Pushes what follows to the bar's right end.
export component BarSpacer inherits Rectangle {
    horizontal-stretch: 1;
}

// A small grey caption before a control ("A row per").
export component BarLabel inherits Text {
    font-size: Ink.fs-secondary;
    color: Ink.text-dim;
    vertical-alignment: center;
    horizontal-stretch: 0;
}

// A picker: "Images · All ▾" - a click opens its popover (the chip's
// children). `active`: the picker narrows what is shown (outlined, and
// `badge` - e.g. how many filters - beside the name).
export component BarChip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <int> badge;
    in property <bool> active;
    in property <bool> enabled: true;
    // The popover's width; its height is its content's, up to
    // `popover-max-height` (then it scrolls).
    in property <length> popover-width: 300px;
    in property <length> popover-max-height: 520px;
    callback opened;

    height: Ink.control-h;
    width: chip-row.preferred-width;
    border-radius: Ink.radius-sm;
    background: ta.has-hover && root.enabled ? Ink.hover : Ink.field;
    border-width: 1px;
    border-color: root.active ? Ink.focus : (ta.has-hover && root.enabled ? Ink.text-faint : Ink.border);
    opacity: root.enabled ? 1.0 : 0.5;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.open();
    }

    public function open() {
        root.opened();
        popup.show();
    }

    public function close() {
        popup.close();
    }

    chip-row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        // Grey before a value ("Images · All"), alone the chip's name.
        Text {
            text: root.label;
            font-size: Ink.fs-body;
            color: root.value != "" ? Ink.text-dim : Ink.text;
            vertical-alignment: center;
        }
        if root.value != "": Text {
            text: root.value;
            font-size: Ink.fs-body;
            color: Ink.text;
            vertical-alignment: center;
        }
        if root.badge > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 16px;
                width: max(16px, badge-text.preferred-width + 10px);
                border-radius: 8px;
                background: Ink.focus;
                badge-text := Text {
                    text: root.badge;
                    font-size: Ink.fs-caption;
                    font-weight: 600;
                    color: Ink.panel;
                }
            }
        }
        Image {
            source: InkIcons.caret-down;
            width: 10px;
            colorize: Ink.text-mute;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.open();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.popover-width;
        // Explicit (an inferred height misplaces a popup): its content's.
        height: min(body.preferred-height, root.popover-max-height);
        close-policy: close-on-click-outside;

        Rectangle {
            background: Ink.panel-blur ? Ink.glass : Ink.panel;
            backdrop-blur: Ink.backdrop;
            border-width: 1px;
            border-color: Ink.border;
            border-radius: Ink.radius-md;
            drop-shadow-color: Ink.shadow;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
        }

        // Clicks on the popover stay in it.
        TouchArea { }

        Flickable {
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: parent.width;
                padding: 12px;
                spacing: 10px;
                alignment: start;
                @children
            }
        }
    }
}

// The view's left panel: what is shown (design canvas "Results rework",
// PanelSwitch A1). On top the switch between its parts - the same control
// as "A row per" - or with one part its `title`; ‹ folds it away (the bar
// then shows `BarFolded`). A panel on the ground beside the view (not
// floating: no blur); `current` is the part shown - `part` if it is one of
// `parts`, else the first. It scrolls.
export component ViewPanel inherits Rectangle {
    in property <string> title;
    in property <[string]> parts;
    in property <string> part;
    // ‹ folds it away (off: a panel that stays, e.g. the Exports tab's).
    in property <bool> foldable: true;
    callback part-picked(string);
    callback fold;
    property <int> index: root.parts[0] == root.part ? 0 : root.parts[1] == root.part ? 1
        : root.parts[2] == root.part ? 2 : root.parts[3] == root.part ? 3 : root.parts[4] == root.part ? 4 : 0;
    out property <string> current: root.parts[root.index];

    width: 400px;
    background: Ink.panel;
    border-radius: Ink.radius-lg;
    border-width: 1px;
    border-color: Ink.border;
    clip: true;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 8px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;
            if root.parts.length > 1: VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                InkSegmented {
                    equal: true;
                    label: "Show";
                    model: root.parts;
                    selected: root.index;
                    picked(i) => {
                        root.part-picked(root.parts[i]);
                    }
                }
            }
            if root.parts.length <= 1: Text {
                horizontal-stretch: 1;
                text: root.title;
                font-size: Ink.fs-heading;
                font-weight: 600;
                color: Ink.text;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.foldable: InkIconButton {
                size: 26px;
                icon: InkIcons.caret-left;
                label: "Fold the panel away";
                clicked => {
                    root.fold();
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Ink.border-soft;
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                @children
            }
        }
    }
}

// First in the bar while the view's panel is folded away: the button that
// brings it back, and what it shows in a grey line ("All images · all
// classes · 6 columns").
export component BarFolded inherits HorizontalLayout {
    in property <string> summary;
    callback unfold;
    spacing: 8px;
    horizontal-stretch: 0;
    VerticalLayout {
        alignment: center;
        InkIconButton {
            size: 26px;
            icon: InkIcons.image-controls;
            label: "Show the settings panel";
            clicked => {
                root.unfold();
            }
        }
    }
    Text {
        max-width: 420px;
        text: root.summary;
        font-size: Ink.fs-secondary;
        color: Ink.text-mute;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A caption inside a popover ("SHOW ONLY TRACKS").
export component BarCaption inherits Text {
    font-size: Ink.fs-caption;
    font-weight: 600;
    color: Ink.text-mute;
}

// How many rows, and with `pages` the page and its arrows.
export component BarCount inherits HorizontalLayout {
    in property <string> text;
    in property <bool> pages;
    in property <int> page: 1;
    in property <bool> has-previous;
    in property <bool> has-next;
    callback previous;
    callback next;

    spacing: 4px;
    horizontal-stretch: 0;

    Text {
        text: root.text;
        font-size: Ink.fs-secondary;
        color: Ink.text-dim;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.pages: VerticalLayout {
        alignment: center;
        InkIconButton {
            size: 26px;
            icon: InkIcons.caret-left;
            label: "Previous page";
            enabled: root.has-previous;
            clicked => {
                root.previous();
            }
        }
    }
    if root.pages: Text {
        text: "Page " + root.page;
        font-size: Ink.fs-secondary;
        color: Ink.text-dim;
        vertical-alignment: center;
    }
    if root.pages: VerticalLayout {
        alignment: center;
        InkIconButton {
            size: 26px;
            icon: InkIcons.caret-right;
            label: "Next page";
            enabled: root.has-next;
            clicked => {
                root.next();
            }
        }
    }
}

// ⋯: the view's rarely used settings and actions (its children:
// `InkMenuItem`s). The popup isn't a layout item - a layout would size it.
export component BarMore inherits Rectangle {
    in property <length> menu-width: 240px;
    width: 26px;

    more := InkIconButton {
        y: (root.height - self.height) / 2;
        size: 26px;
        icon: InkIcons.more;
        label: "More";
        clicked => {
            menu.show();
        }
    }

    menu := PopupWindow {
        x: root.width - root.menu-width;
        y: more.y + more.height + 4px;
        InkMenuFrame {
            open-y: root.absolute-position.y + more.y + more.height + 4px;
            menu-width: root.menu-width;
            // Forwarded children only reach the frame's item list inside
            // an element of their own.
            VerticalLayout {
                @children
            }
        }
    }
}
