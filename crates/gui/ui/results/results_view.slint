// results/results_view.slint — the results of an analysis, in the main
// window's Results mode (boards H, L, M): the view, the analysis and Export
// are in the top bar (`results_bar.slint`); here the view's panels. Before
// an analysis is open: the analyses, to pick one.

import { ResultsRailMode, ResultsState } from "../api/results.slint";
import { Ink, InkBanner, InkTone } from "../ink/ink.slint";
import { ResultsListView } from "results_list.slint";
import { ResultsMatrixView } from "results_matrix.slint";
import { ResultsChartsView } from "results_charts.slint";
import { ResultsTracksView } from "results_tracks.slint";
import { ResultsListPanel } from "../editor/results_list_panel.slint";

export component ResultsView inherits Rectangle {
    property <bool> has-analysis: ResultsState.database-name != "";

    background: Ink.ground;

    // No analysis open: the analyses (the top bar's menu has them too).
    if !root.has-analysis: Rectangle {
        x: (parent.width - self.width) / 2;
        y: 48px;
        width: min(420px, parent.width - 24px);
        height: min(480px, parent.height - 96px);
        background: Ink.panel;
        border-radius: Ink.radius-lg;
        border-width: 1px;
        border-color: Ink.border;
        clip: true;
        ResultsListPanel { }
    }

    if root.has-analysis: VerticalLayout {
        spacing: 0px;

        // The analysis that wrote this database didn't finish: say so
        // before anyone draws conclusions from the numbers.
        if ResultsState.run-warning != "": VerticalLayout {
            padding: 12px;
            padding-bottom: 0px;
            InkBanner {
                tone: InkTone.warn;
                text: ResultsState.run-warning;
            }
        }

        if ResultsState.rail-mode == ResultsRailMode.list: ResultsListView {
            vertical-stretch: 1;
        }
        if ResultsState.rail-mode == ResultsRailMode.matrix: ResultsMatrixView {
            vertical-stretch: 1;
        }
        if ResultsState.rail-mode == ResultsRailMode.charts: ResultsChartsView {
            vertical-stretch: 1;
        }
        if ResultsState.rail-mode == ResultsRailMode.tracks: ResultsTracksView {
            vertical-stretch: 1;
        }
    }
}
