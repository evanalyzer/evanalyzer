// results/results_panel.slint — the parts of the views' left panel (design
// canvas "Results rework", ColumnPanel E and PanelViews): the column picker
// every view shares - ticks where a view shows many columns (List), one
// choice where it draws one value (Plate, Charts) - with its search, the
// starting sets, the groups, intensity as a channels × values grid and the
// coloc builder; a list to pick one item from.

import { Ink, InkIcons, InkHint, InkCheckList, InkMultiSelect, InkOptionCard, InkSearchField, InkSwitch, InkTipZone, MultiSelectItem } from "../ink/ink.slint";
import { ColumnSection, ColumnPreset, ColocColumnItem, ColocGroup, ColocKind, IntensityCell, ResultsState } from "../api/results.slint";
import { CheckBox, LineEdit } from "../ink/std_compat.slint";

/// A head over a part of the panel: a foldable caption, All / None - the
/// look of `InkCheckList`'s.
export component PartHead inherits HorizontalLayout {
    in property <string> title;
    in property <bool> open;
    in property <bool> foldable: true;
    in property <bool> all-none: true;
    callback toggled;
    callback select-all;
    callback select-none;
    spacing: 8px;
    if root.foldable: Rectangle {
        width: 12px;
        Image {
            source: root.open ? InkIcons.caret-down : InkIcons.caret-right;
            width: 10px;
            height: 10px;
            colorize: Ink.text-mute;
        }
    }
    Text {
        horizontal-stretch: 1;
        min-width: 0px;
        overflow: elide;
        text: root.title;
        font-size: Ink.fs-caption;
        font-weight: 600;
        letter-spacing: 0.6px;
        color: head-ta.has-hover && root.foldable ? Ink.text : Ink.text-mute;
        vertical-alignment: center;
        accessible-role: button;
        accessible-enabled: root.foldable;
        accessible-label: root.title;
        accessible-action-default => {
            root.toggled();
        }
        head-ta := TouchArea {
            enabled: root.foldable;
            mouse-cursor: root.foldable ? pointer : default;
            clicked => {
                root.toggled();
            }
        }
    }
    if root.all-none: Text {
        text: "All";
        font-size: Ink.fs-secondary;
        color: all-ta.has-hover ? Ink.text : Ink.focus;
        all-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.select-all();
            }
        }
    }
    if root.all-none: Text {
        text: "None";
        font-size: Ink.fs-secondary;
        color: none-ta.has-hover ? Ink.text : Ink.focus;
        none-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.select-none();
            }
        }
    }
}

/// The mark before a row: a tick box, or a radio dot (`single`).
component Mark inherits Rectangle {
    in property <bool> on;
    in property <bool> single;
    // Greyed: always on, not to change.
    in property <bool> dim;
    width: 13px;
    height: 13px;
    border-radius: root.single ? 6.5px : Ink.radius-xs;
    border-width: root.on && !root.single ? 0px : root.on ? 4px : 1px;
    border-color: root.dim ? Ink.text-faint : root.on ? Ink.primary : Ink.text-faint;
    background: root.on && !root.single ? (root.dim ? Ink.text-faint : Ink.primary) : Ink.field;
    if root.on && !root.single: Image {
        source: InkIcons.check;
        width: 9px;
        colorize: Ink.on-primary;
    }
}

/// A row to tick or pick: mark, name, something after it (`note`).
component PickRow inherits Rectangle {
    in property <string> text;
    in property <string> note;
    in property <bool> on;
    in property <bool> single;
    in property <color> swatch: transparent;
    // Always on and greyed: not to untick.
    in property <bool> locked;
    callback clicked;
    height: 24px;
    background: ta.has-hover && !root.locked ? Ink.hover : transparent;
    border-radius: Ink.radius-xs;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.on || root.locked;
    accessible-enabled: !root.locked;
    accessible-action-default => {
        if !root.locked {
            root.clicked();
        }
    }
    ta := TouchArea {
        enabled: !root.locked;
        mouse-cursor: root.locked ? default : pointer;
        clicked => {
            root.clicked();
        }
    }
    // A name cut short: whole on hover.
    InkTipZone {
        wanted: ta.has-hover && row-text.preferred-width > row-text.width;
        text: root.text;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Mark {
                on: root.on || root.locked;
                single: root.single;
                dim: root.locked;
            }
        }
        if root.swatch != transparent: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 2px;
                background: root.swatch;
            }
        }
        row-text := Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.text;
            font-size: Ink.fs-secondary;
            color: root.locked ? Ink.text-dim : Ink.text;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.locked: Text {
            text: "always written";
            font-size: Ink.fs-caption;
            color: Ink.text-mute;
            vertical-alignment: center;
        }
        if root.note != "": Text {
            text: root.note;
            font-size: Ink.fs-secondary;
            font-family: Ink.font-mono;
            letter-spacing: 1px;
            color: Ink.text-dim;
            vertical-alignment: center;
        }
    }
}

/// One item of `items` to pick (a class, an aggregate): radio rows - the
/// one named `chosen` (its value) marked.
export component ChoiceList inherits VerticalLayout {
    in property <string> title;
    in property <[MultiSelectItem]> items;
    in property <string> chosen;
    callback picked(string, string);
    spacing: 4px;
    if root.title != "": PartHead {
        title: root.title;
        foldable: false;
        all-none: false;
    }
    Rectangle {
        border-radius: Ink.radius-sm;
        border-width: 1px;
        border-color: Ink.border-soft;
        VerticalLayout {
            padding: 2px;
            for item in root.items: PickRow {
                text: item.value;
                on: item.value == root.chosen;
                single: true;
                swatch: item.color.alpha > 0 ? item.color : transparent;
                clicked => {
                    root.picked(item.key, item.value);
                }
            }
        }
    }
}

/// One of `model` to pick (by index): radio rows.
export component IndexChoiceList inherits VerticalLayout {
    in property <string> title;
    in property <[string]> model;
    in property <int> current;
    callback picked(int);
    spacing: 4px;
    if root.title != "": PartHead {
        title: root.title;
        foldable: false;
        all-none: false;
    }
    Rectangle {
        border-radius: Ink.radius-sm;
        border-width: 1px;
        border-color: Ink.border-soft;
        VerticalLayout {
            padding: 2px;
            for text[i] in root.model: PickRow {
                text: text;
                on: i == root.current;
                single: true;
                clicked => {
                    root.picked(i);
                }
            }
        }
    }
}

/// Items to tick (`items`' `selected`), All / None only with `all-none`.
export component TickList inherits VerticalLayout {
    in property <string> title;
    in property <[MultiSelectItem]> items;
    in property <bool> all-none: false;
    callback picked(string, bool);
    callback select-all;
    callback select-none;
    spacing: 4px;
    if root.title != "": PartHead {
        title: root.title;
        foldable: false;
        all-none: root.all-none;
        select-all => {
            root.select-all();
        }
        select-none => {
            root.select-none();
        }
    }
    Rectangle {
        border-radius: Ink.radius-sm;
        border-width: 1px;
        border-color: Ink.border-soft;
        VerticalLayout {
            padding: 2px;
            for item in root.items: PickRow {
                text: item.value;
                on: item.selected;
                swatch: item.color.alpha > 0 ? item.color : transparent;
                clicked => {
                    root.picked(item.key, !item.selected);
                }
            }
        }
    }
}

/// Which tracks are shown (Tracks, Paths): at least so many time points,
/// from the first one, not touching the edge - each view its own values.
export component TrackFilters inherits VerticalLayout {
    in-out property <string> min;
    in-out property <bool> from-start;
    in-out property <bool> no-edge;
    in property <bool> can-reset;
    callback changed;
    callback reset;
    spacing: 10px;
    PartHead {
        title: "SHOW ONLY TRACKS";
        foldable: false;
        all-none: false;
    }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text {
            text: "At least";
            vertical-alignment: center;
            font-size: Ink.fs-secondary;
            color: Ink.text-dim;
        }
        VerticalLayout {
            alignment: center;
            LineEdit {
                width: 56px;
                horizontal-alignment: center;
                input-type: number;
                text <=> root.min;
                accepted => {
                    root.changed();
                }
                edited => {
                    root.changed();
                }
            }
        }
        Text {
            text: "time points";
            vertical-alignment: center;
            font-size: Ink.fs-secondary;
            color: Ink.text-dim;
        }
    }
    CheckBox {
        text: "From the first time point";
        checked <=> root.from-start;
        toggled => {
            root.changed();
        }
    }
    CheckBox {
        text: "Not touching the edge";
        checked <=> root.no-edge;
        toggled => {
            root.changed();
        }
    }
    HorizontalLayout {
        alignment: start;
        reset-ta := TouchArea {
            enabled: root.can-reset;
            mouse-cursor: self.enabled ? pointer : default;
            width: reset-text.preferred-width;
            height: reset-text.preferred-height;
            accessible-role: button;
            accessible-label: "Reset filters";
            accessible-action-default => {
                root.reset();
            }
            clicked => {
                root.reset();
            }
            reset-text := Text {
                text: "Reset filters";
                font-size: Ink.fs-secondary;
                color: reset-ta.enabled ? Ink.focus : Ink.text-mute;
            }
        }
    }
}

/// A group of the picker: its columns to tick or pick, foldable.
component SectionList inherits VerticalLayout {
    in property <ColumnSection> section;
    in property <bool> single;
    callback toggled(bool);
    callback picked(string, bool);
    callback select(bool);
    spacing: 4px;
    PartHead {
        title: root.section.title;
        open: root.section.open;
        all-none: !root.single;
        toggled => {
            root.toggled(!root.section.open);
        }
        select-all => {
            root.select(true);
        }
        select-none => {
            root.select(false);
        }
    }
    if root.section.open: Rectangle {
        border-radius: Ink.radius-sm;
        border-width: 1px;
        border-color: Ink.border-soft;
        VerticalLayout {
            padding: 2px;
            for item[i] in root.section.items: PickRow {
                text: item.value;
                on: item.selected;
                single: root.single;
                locked: root.section.locked[i];
                clicked => {
                    root.picked(item.key, root.single || !item.selected);
                }
            }
        }
    }
}

/// A starting set of columns: its name, what it holds; ringed while
/// exactly its columns are shown.
component PresetCard inherits Rectangle {
    in property <ColumnPreset> preset;
    callback picked;
    // Equal widths, whatever the text: the row's width shared out evenly.
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    // The row's cards share the tallest one's height.
    min-height: card-text.preferred-height;
    border-radius: Ink.radius-md;
    border-width: root.preset.active ? 1.5px : 1px;
    border-color: root.preset.active ? Ink.focus : ta.has-hover ? Ink.text-faint : Ink.border;
    background: root.preset.active ? Ink.selection-row : ta.has-hover ? Ink.hover : Ink.panel;
    accessible-role: button;
    accessible-label: root.preset.title;
    accessible-description: root.preset.description;
    accessible-action-default => {
        root.picked();
    }
    card-text := VerticalLayout {
        padding: 8px;
        spacing: 2px;
        alignment: start;
        Text {
            text: root.preset.title;
            font-size: Ink.fs-secondary;
            font-weight: 600;
            color: Ink.text;
            overflow: elide;
        }
        Text {
            text: root.preset.description;
            font-size: Ink.fs-caption;
            color: Ink.text-dim;
            wrap: word-wrap;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
        }
    }
}

/// Intensity as a grid: a row per channel, a column per value - a cell
/// ticks (or picks, `single`) one column; with ticks a channel or a value
/// ticks its whole row or column.
component IntensityGrid inherits VerticalLayout {
    in property <bool> single;
    in property <string> title;
    in property <bool> open;
    in property <[string]> channels;
    in property <[string]> stats;
    in property <[IntensityCell]> cells;
    callback toggled(bool);
    callback select(bool);
    callback picked(string, bool);
    callback line(bool, int);
    property <int> n: root.stats.length;
    property <length> label-w: 64px;
    property <length> cell-w: 30px;
    property <length> cell-h: 24px;
    spacing: 4px;

    PartHead {
        title: root.title;
        open: root.open;
        all-none: !root.single;
        toggled => {
            root.toggled(!root.open);
        }
        select-all => {
            root.select(true);
        }
        select-none => {
            root.select(false);
        }
    }

    if root.open: VerticalLayout {
        spacing: 3px;
        HorizontalLayout {
            spacing: 3px;
            alignment: start;
            Rectangle {
                width: root.label-w;
            }
            for stat[j] in root.stats: Rectangle {
                width: root.cell-w;
                height: 18px;
                Text {
                    text: stat;
                    font-size: Ink.fs-caption;
                    font-weight: 600;
                    color: stat-ta.has-hover && !root.single ? Ink.text : Ink.text-mute;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                stat-ta := TouchArea {
                    enabled: !root.single;
                    mouse-cursor: root.single ? default : pointer;
                    clicked => {
                        root.line(false, j);
                    }
                }
            }
        }
        for channel[i] in root.channels: HorizontalLayout {
            spacing: 3px;
            alignment: start;
            Rectangle {
                width: root.label-w;
                height: root.cell-h;
                Text {
                    width: 100%;
                    text: channel;
                    font-size: Ink.fs-secondary;
                    color: row-ta.has-hover && !root.single ? Ink.text : Ink.text-dim;
                    vertical-alignment: center;
                    overflow: elide;
                }
                row-ta := TouchArea {
                    enabled: !root.single;
                    mouse-cursor: root.single ? default : pointer;
                    clicked => {
                        root.line(true, i);
                    }
                }
            }
            for stat[j] in root.stats: cell-box := Rectangle {
                property <IntensityCell> cell: root.cells[i * root.n + j];
                width: root.cell-w;
                height: root.cell-h;
                border-radius: root.single ? root.cell-h / 2 : Ink.radius-xs;
                border-width: self.cell.selected ? 0px : 1px;
                border-color: cell-ta.has-hover ? Ink.text-faint : Ink.border;
                background: self.cell.key == "" ? transparent : self.cell.selected ? Ink.primary : cell-ta.has-hover ? Ink.hover : Ink.field;
                accessible-role: checkbox;
                accessible-label: stat + " " + channel;
                accessible-checked: self.cell.selected;
                if cell-box.cell.selected: Image {
                    source: InkIcons.check;
                    width: 10px;
                    colorize: Ink.on-primary;
                }
                cell-ta := TouchArea {
                    enabled: cell-box.cell.key != "";
                    mouse-cursor: pointer;
                    clicked => {
                        root.picked(cell-box.cell.key, root.single || !cell-box.cell.selected);
                    }
                }
            }
        }
        InkHint {
            text: root.single ? "A click on a cell picks that value." : "A click on a channel or a value ticks its whole row or column.";
        }
    }
}

/// A numbered step of the coloc builder ("1  Overlap with").
component StepLabel inherits HorizontalLayout {
    in property <string> number;
    in property <string> text;
    spacing: 6px;
    Text {
        text: root.number;
        font-size: Ink.fs-secondary;
        font-weight: 700;
        color: Ink.text;
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        font-size: Ink.fs-secondary;
        color: Ink.text-dim;
        wrap: word-wrap;
    }
}

/// The coloc columns in three steps (design canvas "Results rework",
/// ColumnPanel): the partner classes, what a cell counts, which columns -
/// each kind with its columns and the marks of what they need. The first
/// two are the results' coloc settings, the same in every view.
component ColocBuilder inherits VerticalLayout {
    in property <bool> single;
    in property <bool> grouped;
    in property <[ColocGroup]> groups;
    // The coloc settings (the List's: shared by its pickers) - given, and
    // changed through the callbacks below.
    in property <string> title;
    in property <bool> open;
    in property <[MultiSelectItem]> partner-items;
    in property <string> partner-summary;
    in property <string> partner-order;
    in property <int> count;
    in property <bool> only-occurring;
    callback picked(string, bool);
    callback select(string, bool);
    // A group's block folded (false) or opened.
    callback toggled(string, bool);
    callback box-toggled(bool);
    callback partner-toggled(string);
    callback partners-all(bool);
    callback count-picked(int);
    callback only-occurring-changed(bool);
    spacing: 10px;

    PartHead {
        title: root.single ? "COLOC" : root.title;
        open: root.open;
        all-none: false;
        toggled => {
            root.box-toggled(!root.open);
        }
    }

    if root.open: VerticalLayout {
        padding-left: 20px;
        spacing: 12px;

        VerticalLayout {
            spacing: 4px;
            StepLabel {
                number: "1";
                text: "Overlap with";
            }
            InkCheckList {
                title: "PARTNER CLASSES · " + root.partner-summary;
                items: root.partner-items;
                list-height: self.items.length * 24px + 4px;
                item-selected(key, value, selected) => {
                    root.partner-toggled(key);
                }
                select-all => {
                    root.partners-all(true);
                }
                select-none => {
                    root.partners-all(false);
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            StepLabel {
                number: "2";
                text: "Each cell counts";
            }
            HorizontalLayout {
                spacing: 6px;
                InkOptionCard {
                    horizontal-stretch: 1;
                    title: root.grouped ? "Objects that overlap" : "Yes / no";
                    description: root.grouped ? "How many objects overlap" : "1 if the object overlaps, else 0";
                    checked: root.count == 0;
                    picked => {
                        root.count-picked(0);
                    }
                }
                InkOptionCard {
                    horizontal-stretch: 1;
                    title: root.grouped ? "Partner objects" : "How many partners";
                    description: root.grouped ? "How many partners lie on them" : "How many partners the object overlaps";
                    checked: root.count == 1;
                    picked => {
                        root.count-picked(1);
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            StepLabel {
                number: "3";
                text: root.single ? "The column" : "Columns for";
            }
            if root.groups.length == 0: InkHint {
                text: "Pick a partner class above.";
            }
            // A block per coloc group - a Colocalize step's classes: their
            // combinations only (design canvas "Results rework", ColocGroups A).
            for block in root.groups: Rectangle {
                border-radius: Ink.radius-md;
                border-width: block.name != "" ? 1px : 0px;
                border-color: Ink.border-soft;
                background: block.name != "" ? Ink.raised : transparent;
                VerticalLayout {
                    padding: block.name != "" ? 8px : 0px;
                    spacing: 4px;
                    if block.name != "": Rectangle {
                        height: 22px;
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 12px;
                                Image {
                                    source: block.open ? InkIcons.caret-down : InkIcons.caret-right;
                                    width: 10px;
                                    height: 10px;
                                    colorize: Ink.text-mute;
                                }
                            }
                            Text {
                                text: block.name;
                                font-size: Ink.fs-body;
                                font-weight: 600;
                                color: Ink.text;
                                vertical-alignment: center;
                            }
                            // The classes: as many as fit, whole on hover.
                            block-classes := Text {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                text: block.classes;
                                font-size: Ink.fs-caption;
                                font-family: Ink.font-mono;
                                color: Ink.text-dim;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        block-ta := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: block.name;
                            accessible-expandable: true;
                            accessible-expanded: block.open;
                            accessible-action-default => {
                                root.toggled(block.key, !block.open);
                            }
                            clicked => {
                                root.toggled(block.key, !block.open);
                            }
                        }
                        InkTipZone {
                            wanted: block-ta.has-hover && block-classes.preferred-width > block-classes.width;
                            text: block.classes;
                        }
                    }
                    if block.open: VerticalLayout {
                        spacing: 6px;
                        for kind in block.kinds: VerticalLayout {
                            spacing: 2px;
                            PartHead {
                                title: root.single ? kind.title : kind.title + " · " + kind.count;
                                foldable: false;
                                all-none: !root.single;
                                select-all => {
                                    root.select(kind.group, true);
                                }
                                select-none => {
                                    root.select(kind.group, false);
                                }
                            }
                            if block.name == "" || kind.title == "EACH CLASS": InkHint {
                                text: kind.description;
                            }
                            for item in kind.items: PickRow {
                                text: item.name;
                                note: item.glyph;
                                on: item.selected;
                                single: root.single;
                                clicked => {
                                    root.picked(item.key, root.single || !item.selected);
                                }
                            }
                        }
                    }
                }
            }
            InkSwitch {
                text: "Only combinations some object has";
                checked: root.only-occurring;
                toggled(on) => {
                    root.only-occurring-changed(on);
                }
            }
            InkHint {
                text: (root.groups.length > 0 && root.groups[0].name != ""
                    ? "● overlaps · ○ must not · · either - per class in the order of its group's head. Combinations only within a group: a Colocalize step's classes."
                    : "● overlaps · ○ must not · · either - per class in this order: " + root.partner-order + ".")
                    + " \"Exactly\" columns add up to the count. One row per overlapping pair: List, a row per Coloc pair.";
            }
        }
    }
}

/// The children (Relate Objects' links) and the linked objects (parents)
/// of a table - the Results List's and an export table's lists alike;
/// shown only where the results have links.
export component RelatedPart inherits VerticalLayout {
    in-out property <[MultiSelectItem]> children;
    in property <string> children-summary;
    in-out property <[MultiSelectItem]> aggregations;
    in property <string> aggregate-summary;
    in-out property <[MultiSelectItem]> parents;
    in property <string> parent-summary;
    in property <length> pill-width: 372px;
    callback child-selected(string, bool);
    callback children-all(bool);
    callback aggregation-selected(string, bool);
    callback parent-selected(string, bool);
    callback parents-all(bool);
    spacing: 12px;

    if root.children.length > 0: InkCheckList {
        title: "CHILDREN · " + root.children-summary;
        items <=> root.children;
        list-height: 120px;
        collapsible: true;
        item-selected(key, value, selected) => {
            root.child-selected(key, selected);
        }
        select-all => {
            root.children-all(true);
        }
        select-none => {
            root.children-all(false);
        }
    }
    if root.children.length > 0: InkMultiSelect {
        label: "Of the columns";
        summary-text: root.aggregate-summary;
        items <=> root.aggregations;
        multi-select: true;
        pill-width: root.pill-width;
        item-selected(key, value, selected) => {
            root.aggregation-selected(key, selected);
        }
    }
    if root.parents.length > 0: InkCheckList {
        title: "LINKED OBJECTS · " + root.parent-summary;
        items <=> root.parents;
        list-height: 120px;
        collapsible: true;
        item-selected(key, value, selected) => {
            root.parent-selected(key, selected);
        }
        select-all => {
            root.parents-all(true);
        }
        select-none => {
            root.parents-all(false);
        }
    }
}

/// The values and the classes of a table, one after the other (design
/// canvas "Exports - table panel parts", S1/S2) - the Results List's and an
/// export table's part alike. `grouped`: a row per image, well or folder -
/// with values and the switch for classes without objects; else the classes
/// alone.
export component ValuesClassesPart inherits VerticalLayout {
    in property <bool> grouped;
    in property <string> values-title: "OF THE OBJECTS IN EACH ROW";
    in-out property <[MultiSelectItem]> values;
    in property <string> classes-title;
    in-out property <[MultiSelectItem]> classes;
    in property <string> empty-text: "Show classes without objects";
    in property <bool> empty-classes;
    // The switch for classes without objects (grouped rows of a table).
    in property <bool> show-empty: true;
    callback value-selected(string, bool);
    callback values-all();
    callback values-none();
    callback class-selected(string, bool);
    callback classes-all();
    callback classes-none();
    callback empty-classes-toggled(bool);
    spacing: 12px;

    if root.grouped: InkHint {
        text: "Each column summed up over the objects of a row - a column per value.";
        wrap: word-wrap;
    }
    if root.grouped: InkCheckList {
        title: root.values-title;
        items <=> root.values;
        list-height: self.items.length * 24px + 4px;
        item-selected(key, value, selected) => {
            root.value-selected(key, selected);
        }
        select-all => {
            root.values-all();
        }
        select-none => {
            root.values-none();
        }
    }
    if root.grouped: Rectangle {
        height: 1px;
        background: Ink.border-soft;
    }
    InkCheckList {
        title: root.classes-title;
        items <=> root.classes;
        list-height: self.items.length * 24px + 4px;
        item-selected(key, value, selected) => {
            root.class-selected(key, selected);
        }
        select-all => {
            root.classes-all();
        }
        select-none => {
            root.classes-none();
        }
    }
    // A row per image, well or folder: a class without objects there is a
    // row of zeros, or none.
    if root.grouped && root.show-empty: InkSwitch {
        text: root.empty-text;
        checked: root.empty-classes;
        toggled(on) => {
            root.empty-classes-toggled(on);
        }
    }
}

/// The column picker: search, starting sets, the groups (intensity as a
/// grid), the coloc builder. `single`: one column is the value (Plate,
/// Charts) - radio marks, no All / None, no starting sets.
export component ColumnPicker inherits VerticalLayout {
    in property <bool> single;
    in property <bool> grouped;
    in property <string> filter;
    in property <string> placeholder: "Find a column - area, mean, coloc…";
    in property <[ColumnPreset]> presets;
    in property <[ColumnSection]> sections;
    in property <string> intensity-title;
    in property <bool> intensity-open;
    in property <[string]> intensity-channels;
    in property <[string]> intensity-stats;
    in property <[IntensityCell]> intensity-cells;
    in property <bool> has-coloc;
    in property <[ColocGroup]> coloc-groups;
    // The coloc settings (see `ColocBuilder`).
    in property <string> coloc-title;
    in property <bool> coloc-open;
    in property <[MultiSelectItem]> coloc-partner-items;
    in property <string> coloc-partner-summary;
    in property <string> coloc-partner-order;
    in property <int> coloc-count;
    in property <bool> coloc-only-occurring;
    callback coloc-box-toggled(bool);
    callback coloc-partner-toggled(string);
    callback coloc-partners-all(bool);
    callback coloc-count-picked(int);
    callback coloc-only-occurring-changed(bool);
    callback filter-edited(string);
    // A column on (true) or off - `single`: always on, the others off.
    callback picked(string, bool);
    callback section-toggled(string, bool);
    callback section-select(string, bool);
    // A row (channel, true) or column (value) of the intensity grid.
    callback intensity-line(bool, int);
    callback preset(string);
    spacing: 12px;

    InkSearchField {
        text: root.filter;
        placeholder: root.placeholder;
        edited(text) => {
            root.filter-edited(text);
        }
    }
    if root.filter == "" && root.presets.length > 0: VerticalLayout {
        spacing: 6px;
        Text {
            text: "START FROM";
            font-size: Ink.fs-caption;
            font-weight: 600;
            letter-spacing: 0.6px;
            color: Ink.text-mute;
        }
        HorizontalLayout {
            spacing: 6px;
            for preset in root.presets: PresetCard {
                preset: preset;
                picked => {
                    root.preset(preset.key);
                }
            }
        }
    }
    for section in root.sections: VerticalLayout {
        if section.group == "intensity" && root.filter == "": IntensityGrid {
            single: root.single;
            title: root.intensity-title;
            open: root.intensity-open;
            channels: root.intensity-channels;
            stats: root.intensity-stats;
            cells: root.intensity-cells;
            toggled(open) => {
                root.section-toggled("intensity", open);
            }
            select(on) => {
                root.section-select("intensity", on);
            }
            picked(key, on) => {
                root.picked(key, on);
            }
            line(by-channel, index) => {
                root.intensity-line(by-channel, index);
            }
        }
        if section.group != "intensity" || root.filter != "": SectionList {
            section: section;
            single: root.single;
            toggled(open) => {
                root.section-toggled(section.group, open);
            }
            select(on) => {
                root.section-select(section.group, on);
            }
            picked(key, on) => {
                root.picked(key, on);
            }
        }
    }
    if root.has-coloc: ColocBuilder {
        single: root.single;
        grouped: root.grouped;
        groups: root.coloc-groups;
        title: root.coloc-title;
        open: root.coloc-open;
        partner-items: root.coloc-partner-items;
        partner-summary: root.coloc-partner-summary;
        partner-order: root.coloc-partner-order;
        count: root.coloc-count;
        only-occurring: root.coloc-only-occurring;
        box-toggled(open) => {
            root.coloc-box-toggled(open);
        }
        partner-toggled(key) => {
            root.coloc-partner-toggled(key);
        }
        partners-all(on) => {
            root.coloc-partners-all(on);
        }
        count-picked(index) => {
            root.coloc-count-picked(index);
        }
        only-occurring-changed(on) => {
            root.coloc-only-occurring-changed(on);
        }
        picked(key, on) => {
            root.picked(key, on);
        }
        select(group, on) => {
            root.section-select(group, on);
        }
        toggled(key, open) => {
            root.section-toggled(key, open);
        }
    }
}
