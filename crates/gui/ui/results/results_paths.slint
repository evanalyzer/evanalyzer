// results/results_paths.slint — Results › Paths: every track drawn from its
// start (a sample beyond 2000), and the motion map - a dot per track at its
// straightness and turning (or MSD α), as Measure Track Motion measured
// them. A click on the map selects the nearest track. No thresholds and no
// motion type: the user reads the map.

import { ResultsState } from "../api/results.slint";
import { Ink, InkSegmented, InkHint } from "../ink/ink.slint";
import { ViewBar, BarChip, BarLabel, BarSpacer, ViewPanel } from "results_view_bar.slint";
import { IndexChoiceList, TrackFilters } from "results_panel.slint";
import { CheckBox, ComboBox, LineEdit } from "../ink/std_compat.slint";

component PanelTitle inherits HorizontalLayout {
    in property <string> title;
    in property <string> note;
    spacing: 8px;
    Text {
        text: root.title;
        font-size: Ink.fs-body;
        font-weight: 600;
        color: Ink.text;
        vertical-alignment: center;
    }
    Text {
        text: root.note;
        font-size: Ink.fs-secondary;
        color: Ink.text-dim;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

export component ResultsPathsView inherits Rectangle {
    property <string> part: ResultsState.panel-part;
    property <bool> panel-open: root.part == "Class" || root.part == "Images" || root.part == "Filters" || root.part == "Look";
    // The filters on (the Filters badge).
    property <int> active-filters: (ResultsState.paths-min.to-float() > 1 ? 1 : 0)
        + (ResultsState.paths-from-start ? 1 : 0)
        + (ResultsState.paths-no-edge ? 1 : 0);

    function reset-filters() {
        ResultsState.paths-min = "10";
        ResultsState.paths-from-start = false;
        ResultsState.paths-no-edge = true;
        ResultsState.paths-filter-changed();
    }

    background: Ink.ground;

    // Panels on the ground: which tracks on the left (a chip opens it), the
    // bar over the paths and the motion map.
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        if root.panel-open: ViewPanel {
            title: root.part == "Images" ? "Image" : root.part == "Look" ? "Motion map" : root.part;
            if root.part == "Class": IndexChoiceList {
                title: "TRACKS OF";
                model: ResultsState.paths-classes;
                current: ResultsState.paths-class;
                picked(i) => {
                    ResultsState.paths-class = i;
                    ResultsState.paths-filter-changed();
                }
            }
            if root.part == "Images": IndexChoiceList {
                title: "TRACKS IN";
                model: ResultsState.paths-images;
                current: ResultsState.paths-image;
                picked(i) => {
                    ResultsState.paths-image = i;
                    ResultsState.paths-filter-changed();
                }
            }
            if root.part == "Filters": TrackFilters {
                min <=> ResultsState.paths-min;
                from-start <=> ResultsState.paths-from-start;
                no-edge <=> ResultsState.paths-no-edge;
                can-reset: ResultsState.paths-min != "10" || ResultsState.paths-from-start || !ResultsState.paths-no-edge;
                changed => {
                    ResultsState.paths-filter-changed();
                }
                reset => {
                    root.reset-filters();
                }
            }
            if root.part == "Look": IndexChoiceList {
                title: "Y AXIS";
                model: ["Turning", "MSD α"];
                current: ResultsState.paths-y-axis;
                picked(i) => {
                    ResultsState.paths-y-axis = i;
                    ResultsState.paths-filter-changed();
                }
            }
            if root.part == "Look": InkHint {
                text: "At most 2000 paths are drawn (an even sample) and 5000 dots shown; the header says how many there are.";
            }
        }

        VerticalLayout {
            spacing: 12px;
            horizontal-stretch: 1;

            ViewBar {
                VerticalLayout {
                    alignment: center;
                    BarChip {
                        label: "Class";
                        part: "Class";
                        value: ResultsState.paths-classes[ResultsState.paths-class];
                    }
                }
                VerticalLayout {
                    alignment: center;
                    BarChip {
                        label: "Image";
                        part: "Images";
                        value: ResultsState.paths-images[ResultsState.paths-image];
                    }
                }
                VerticalLayout {
                    alignment: center;
                    BarChip {
                        label: "Filters";
                        part: "Filters";
                        badge: root.active-filters;
                        active: root.active-filters > 0;
                    }
                }
                BarLabel {
                    text: "Colour by";
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    InkSegmented {
                        horizontal-stretch: 0;
                        label: "Colour by";
                        model: ["Track", "Well", "Class"];
                        selected: ResultsState.paths-color-by;
                        picked(i) => {
                            ResultsState.paths-color-by = i;
                            ResultsState.paths-filter-changed();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    BarChip {
                        label: "Motion map";
                        part: "Look";
                        value: ["Turning", "MSD α"][ResultsState.paths-y-axis];
                    }
                }
                BarSpacer { }
            }

            // -- The paths and the map --
            Rectangle {
                horizontal-stretch: 1;
                background: Ink.panel;
                border-radius: Ink.radius-lg;
                border-width: 1px;
                border-color: Ink.border;

                if ResultsState.paths-empty != "": Text {
                    text: ResultsState.paths-empty;
                    font-size: Ink.fs-body;
                    color: Ink.text-mute;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

                if ResultsState.paths-empty == "": HorizontalLayout {
                    padding: 16px;
                    spacing: 16px;

                    VerticalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;
                        PanelTitle {
                            title: "Paths from their start";
                            note: ResultsState.paths-header;
                        }
                        paths-box := Rectangle {
                            vertical-stretch: 1;
                            background: Ink.raised;
                            border-radius: 4px;
                            clip: true;
                            accessible-role: image;
                            accessible-label: "Every track drawn from its start, " + ResultsState.paths-header;
                            // The start: the middle.
                            Rectangle {
                                x: parent.width / 2;
                                width: 1px;
                                background: Ink.border-soft;
                            }
                            Rectangle {
                                y: parent.height / 2;
                                height: 1px;
                                background: Ink.border-soft;
                            }
                            for line in ResultsState.paths-lines: Path {
                                width: paths-box.width;
                                height: paths-box.height;
                                viewbox-width: 1000;
                                viewbox-height: 1000;
                                // Square: x and y at the same scale.
                                fit: contain;
                                commands: line.commands;
                                stroke: line.color;
                                stroke-width: 1px;
                                opacity: ResultsState.paths-has-selected ? 0.35 : 0.8;
                            }
                            if ResultsState.paths-highlight != "": Path {
                                width: paths-box.width;
                                height: paths-box.height;
                                viewbox-width: 1000;
                                viewbox-height: 1000;
                                fit: contain;
                                commands: ResultsState.paths-highlight;
                                stroke: Ink.focus;
                                stroke-width: 2.5px;
                            }
                            Text {
                                x: 6px;
                                y: parent.height - self.height - 4px;
                                text: ResultsState.paths-extent;
                                font-size: Ink.fs-caption;
                                font-family: Ink.font-mono;
                                color: Ink.text-dim;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;
                        PanelTitle {
                            title: "Motion map";
                            note: ResultsState.paths-map-header;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            vertical-stretch: 1;
                            VerticalLayout {
                                width: 48px;
                                Text {
                                    text: ResultsState.paths-y-max;
                                    font-size: Ink.fs-caption;
                                    font-family: Ink.font-mono;
                                    color: Ink.text-dim;
                                    horizontal-alignment: right;
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                    Text {
                                        width: parent.width;
                                        text: ResultsState.paths-y-title;
                                        font-size: Ink.fs-caption;
                                        color: Ink.text-dim;
                                        horizontal-alignment: right;
                                        wrap: word-wrap;
                                    }
                                }
                                Text {
                                    text: ResultsState.paths-y-min;
                                    font-size: Ink.fs-caption;
                                    font-family: Ink.font-mono;
                                    color: Ink.text-dim;
                                    horizontal-alignment: right;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                map := Rectangle {
                                    vertical-stretch: 1;
                                    background: Ink.raised;
                                    border-radius: 4px;
                                    clip: true;
                                    accessible-role: image;
                                    accessible-label: "Straightness against " + ResultsState.paths-y-title + ", a dot per track";
                                    // 0 on the y axis (turning: no turn).
                                    if ResultsState.paths-y-axis == 0: Rectangle {
                                        y: parent.height / 2;
                                        height: 1px;
                                        background: Ink.border-soft;
                                    }
                                    for dot in ResultsState.paths-dots: Rectangle {
                                        width: 5px;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        background: dot.color;
                                        opacity: 0.75;
                                        x: dot.x * (map.width - self.width);
                                        y: (1.0 - dot.y) * (map.height - self.height);
                                    }
                                    if ResultsState.paths-has-selected: Rectangle {
                                        width: 13px;
                                        height: 13px;
                                        border-radius: 6.5px;
                                        border-width: 2px;
                                        border-color: Ink.focus;
                                        x: ResultsState.paths-selected-x * (map.width - 5px) - 4px;
                                        y: (1.0 - ResultsState.paths-selected-y) * (map.height - 5px) - 4px;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            ResultsState.paths-map-clicked(
                                                (self.mouse-x - 2.5px) / max(1px, map.width - 5px),
                                                1.0 - (self.mouse-y - 2.5px) / max(1px, map.height - 5px),
                                                (map.width - 5px) / 1px,
                                                (map.height - 5px) / 1px);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    Text {
                                        text: "0";
                                        font-size: Ink.fs-caption;
                                        font-family: Ink.font-mono;
                                        color: Ink.text-dim;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Straightness (LIN)";
                                        font-size: Ink.fs-caption;
                                        color: Ink.text-dim;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "1";
                                        font-size: Ink.fs-caption;
                                        font-family: Ink.font-mono;
                                        color: Ink.text-dim;
                                    }
                                }
                            }
                        }
                        Text {
                            text: ResultsState.paths-has-selected ? ResultsState.paths-selected : "Click a dot: its track.";
                            font-size: Ink.fs-secondary;
                            font-family: ResultsState.paths-has-selected ? Ink.font-mono : Ink.font-sans;
                            color: ResultsState.paths-has-selected ? Ink.text : Ink.text-mute;
                            overflow: elide;
                        }
                    }
                }
            }

        }
    }
}
