// export_dialog.slint — modal overlay for configuring and running a
// Results export (backed by `ResultExport::start_export` in
// evanalyzer_app's results_exporter.rs). Lives on `ExportDialogState`
// rather than the main window's `GlobalAppState`/`DialogType` because
// `ResultsWindow` is its own top-level Slint component tree (see
// results_state_controller.rs) and never imports state.slint — Slint
// globals are per-tree, so the main window's dialog machinery is simply
// unreachable here.
import { ExportDialogState } from "../api/export.slint";

import { LineEdit, CheckBox, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "../style.slint";
import { AppButton } from "../components/app_button.slint";
import { Dialog, DialogFooter } from "../components/new_components/dialog.slint";
import {
    MultiSelectDropdown,
    MultiSelectItem,
} from "../components/multi_select_dropdown.slint";
component LabeledField inherits HorizontalLayout {
    in property <string> field-label;
    spacing: 8px;
    Text {
        text: root.field-label;
        vertical-alignment: center;
        color: Theme.text-dim;
        font-size: 11px;
    }

    @children
}

export component ExportDialog inherits Dialog {
    title: "Export Results";
    dialog-width: 680px;
    dialog-height: 790px;
    // No closing while the export runs (Cancel stops it first).
    closable: !ExportDialogState.is-exporting;
    close => {
        ExportDialogState.close-clicked();
        ExportDialogState.active = false;
    }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            // Room for the scroll bar.
            padding-right: 12px;
            spacing: 18px;
            alignment: start;

            // -- Output folder --
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Output Folder";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;

                    LineEdit {
                        width: 120px;
                        placeholder-text: "filename prefix_";
                        text <=> ExportDialogState.output-file-prefix;
                        font-size: 11.5px;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 32px;
                        border-radius: Theme.radius-sm;
                        background: Theme.raised;
                        border-width: 1px;
                        border-color: Theme.border-soft;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: ExportDialogState.output-dir == "" ? "Choose a folder…" : ExportDialogState.output-dir;
                            color: ExportDialogState.output-dir == "" ? Theme.text-faint : Theme.text;
                            vertical-alignment: center;
                            font-size: 11.5px;
                            overflow: elide;
                        }
                    }

                    MultiSelectDropdown {
                        pill-height: 32px;
                        summary-text: ExportDialogState.format-summary;
                        items <=> ExportDialogState.format-items;
                        multi-select: false;
                        pill-width: 70px;
                        item-selected(key, value, selected) => { if selected { ExportDialogState.format-summary = value; } }
                    }

                    AppButton {
                        height: 32px;
                        text: "Browse…";
                        enabled: !ExportDialogState.is-exporting;
                        clicked => { ExportDialogState.pick-output-dir(); }
                    }
                }
            }

            // -- What to export --
            VerticalLayout {
                spacing: 6px;
                alignment: start;

                img-title := Text {
                    text: "Images/Objects (ungrouped)";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: 125px;
                    CheckBox {
                        text: "Image list";
                        checked <=> ExportDialogState.with-grouped-by-image-list;
                    }

                    CheckBox {
                        text: "Transpond output table";
                        checked <=> ExportDialogState.transpond-output-table;
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    CheckBox {
                        text: "Object list (objects per image)";
                        checked <=> ExportDialogState.with-list-view;
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        MultiSelectDropdown {
                            summary-text: ExportDialogState.image-summary;
                            items <=> ExportDialogState.image-items;
                            multi-select: true;
                            show-select-all: true;
                            show-search: true;
                            filter-text <=> ExportDialogState.image-filter-text;
                            pill-width: 210px;
                            item-selected(key, value, selected) => { ExportDialogState.image-item-selected(key, selected); }
                            select-all => { ExportDialogState.image-select-all(); }
                            select-none => { ExportDialogState.image-select-none(); }
                            filter-changed(text) => { ExportDialogState.image-filter-changed(text); }
                            enabled: ExportDialogState.with-list-view;
                        }
                    }
                }

                CheckBox {
                    x: 20px;
                    text: "With coloc details";
                    checked <=> ExportDialogState.with-list-coloc-details;
                    enabled: ExportDialogState.with-list-view;
                }

                CheckBox {
                    x: 20px;
                    text: "Each image in a separate file";
                    checked <=> ExportDialogState.with-list-one-file-per-image;
                    enabled: ExportDialogState.with-list-view;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: 155px;
                    x: 20px;
                    CheckBox {
                        text: "Image heatmap";
                        checked <=> ExportDialogState.with-heatmap;
                        enabled: ExportDialogState.format-summary == "XLSX";
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        MultiSelectDropdown {
                            enabled: ExportDialogState.with-heatmap;
                            summary-text: ExportDialogState.square-size-summary;
                            items <=> ExportDialogState.square-size-items;
                            multi-select: false;
                            pill-width: 130px;
                            item-selected(key, value, selected) => { if selected { ExportDialogState.square-size-summary = value; } }
                        }
                    }
                }

                Rectangle { }

                Text {
                    text: "Plates/Wells";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                }

                Text {
                    text: "Grouping, plate size and well size as set in the project settings (and the Matrix view).";
                    color: Theme.text-mute;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                CheckBox {
                    text: "Plate as heatmap";
                    checked <=> ExportDialogState.with-plate-heatmap-view;
                    enabled: ExportDialogState.format-summary == "XLSX";
                }

                CheckBox {
                    text: "Plate as list";
                    checked <=> ExportDialogState.with-plate-list;
                    enabled: ExportDialogState.format-summary == "XLSX";
                }

                CheckBox {
                    text: "Wells as heatmap";
                    checked <=> ExportDialogState.with-well-heatmap-view;
                    enabled: ExportDialogState.format-summary == "XLSX";
                }

                CheckBox {
                    text: "Wells as list";
                    checked <=> ExportDialogState.with-well-list;
                    enabled: ExportDialogState.format-summary == "XLSX";
                }

                HorizontalLayout {
                    spacing: 8px;
                    MultiSelectDropdown {
                        label: "COLOR SCHEMA";
                        summary-text: ExportDialogState.color-schema-summary;
                        items <=> ExportDialogState.color-schema-items;
                        multi-select: false;
                        pill-width: 140px;
                        item-selected(key, value, selected) => { if selected { ExportDialogState.color-schema-summary = value; } }
                    }
                }
            }

            // -- Z/T range --
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: "Z / T Range";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    LabeledField {
                        field-label: "Z:";
                        LineEdit {
                            horizontal-alignment: center;
                            width: 56px;
                            input-type: number;
                            text <=> ExportDialogState.z-start;
                        }

                        Text {
                            horizontal-alignment: center;
                            text: "to";
                            vertical-alignment: center;
                            color: Theme.text-mute;
                            font-size: 11px;
                        }

                        LineEdit {
                            width: 56px;
                            input-type: number;
                            text <=> ExportDialogState.z-end;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    LabeledField {
                        field-label: "T:";
                        LineEdit {
                            horizontal-alignment: center;
                            width: 56px;
                            input-type: number;
                            text <=> ExportDialogState.t-start;
                        }

                        Text {
                            text: "to";
                            vertical-alignment: center;
                            color: Theme.text-mute;
                            font-size: 11px;
                        }

                        LineEdit {
                            horizontal-alignment: center;
                            width: 56px;
                            input-type: number;
                            text <=> ExportDialogState.t-end;
                        }
                    }
                }
            }

            // -- Filters --
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: "Filters";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 10px;

                    MultiSelectDropdown {
                        label: "CLASSES";
                        summary-text: ExportDialogState.class-summary;
                        items <=> ExportDialogState.class-items;
                        multi-select: true;
                        show-select-all: true;
                        pill-width: 190px;
                        item-selected(key, value, selected) => { ExportDialogState.class-item-selected(key, selected); }
                        select-all => { ExportDialogState.class-select-all(); }
                        select-none => { ExportDialogState.class-select-none(); }
                    }

                    MultiSelectDropdown {
                        label: "COLUMNS";
                        summary-text: ExportDialogState.column-summary;
                        items <=> ExportDialogState.column-items;
                        groups: ExportDialogState.column-groups;
                        multi-select: true;
                        show-select-all: true;
                        pill-width: 200px;
                        item-selected(key, value, selected) => { ExportDialogState.column-item-selected(key, selected); }
                        select-all => { ExportDialogState.column-select-all(); }
                        select-none => { ExportDialogState.column-select-none(); }
                    }

                    MultiSelectDropdown {
                        label: "AGGREGATIONS";
                        summary-text: ExportDialogState.aggregation-summary;
                        items <=> ExportDialogState.aggregation-items;
                        multi-select: true;
                        show-select-all: true;
                        pill-width: 140px;
                        item-selected(key, value, selected) => { ExportDialogState.aggregation-item-selected(key, selected); }
                    }
                }
            }

            // -- Progress / result --
            if ExportDialogState.is-exporting || ExportDialogState.done || ExportDialogState.has-error: VerticalLayout {
                spacing: 6px;
                Text {
                    text: ExportDialogState.has-error
                        ? "Export failed: " + ExportDialogState.error-message
                        : ExportDialogState.done
                        ? "Export complete."
                        : ExportDialogState.progress-message;
                    color: ExportDialogState.has-error ? Theme.err : (ExportDialogState.done ? Theme.ok : Theme.text);
                    font-size: 11.5px;
                    wrap: word-wrap;
                }

                if ExportDialogState.is-exporting: Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.raised;
                    Rectangle {
                        x: 0;
                        width: ExportDialogState.progress-total > 0
                            ? parent.width * (ExportDialogState.progress-current * 1.0 / ExportDialogState.progress-total)
                            : 0px;
                        height: parent.height;
                        border-radius: 4px;
                        background: Theme.accent;
                        animate width {
                            duration: 200ms;
                            easing: ease-out;
                        }
                    }
                }
            }
        }
    }

    DialogFooter {
        AppButton {
            text: "Close";
            enabled: !ExportDialogState.is-exporting;
            clicked => {
                root.close();
            }
        }

        if ExportDialogState.is-exporting: AppButton {
            text: "Cancel";
            clicked => {
                ExportDialogState.cancel-clicked();
            }
        }

        AppButton {
            text: ExportDialogState.is-exporting ? "Exporting…" : "Start Export";
            primary: true;
            enabled: !ExportDialogState.is-exporting && ExportDialogState.output-dir != "";
            clicked => {
                ExportDialogState.start-clicked();
            }
        }
    }
}
