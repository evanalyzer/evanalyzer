import { ScrollView, ComboBox, LineEdit, ProgressIndicator } from "std-widgets.slint";
import { Theme } from "../style.slint";
import { ResultsState, FilterCheckbox, FilterItem } from "results_table.slint";

// Two-way toggle for the export style ("Table" vs "Coloc details") — same
// visual shape as ChartKindButton in results_chart.slint.
component StyleToggleButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;

    width: 100px;
    height: 26px;
    border-radius: Theme.radius-sm;
    background: selected ? Theme.accent : (ta.has-hover ? Theme.hover : Theme.raised);
    animate background { duration: 80ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        font-size: 11px;
        font-family: Theme.font-sans;
        font-weight: 600;
        color: root.selected ? white : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Scrollable checklist with a "(Select All)" row on top — shared shape for
// both the Classes and Images sections below.
component ChecklistBox inherits Rectangle {
    in property <[FilterItem]> items: [];
    in property <bool> all_checked: true;
    callback item_toggled(string);
    callback select_all();
    callback clear_all();
    // Fired when a section header (e.g. "Intensity", "Coloc ClassA") is
    // clicked, to toggle every item in that section at once. No-op (never
    // fired) when `items` isn't grouped.
    callback group_toggled(string);
    // Fired when a Coloc class section's "copy to all" icon is clicked.
    callback group_apply_to_all(string);

    height: 190px;
    border-width: 1px;
    border-color: Theme.border-soft;
    border-radius: Theme.radius-sm;
    clip: true;

    ScrollView {
        VerticalLayout {
            alignment: start;

            sel-all-ta := TouchArea {
                height: 24px;
                mouse-cursor: pointer;
                clicked => {
                    if (root.all_checked) {
                        root.clear_all();
                    } else {
                        root.select_all();
                    }
                }

                Rectangle {
                    background: sel-all-ta.has-hover ? Theme.hover.with-alpha(0.3) : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 7px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;

                            Rectangle {
                                width: 13px;
                                height: 13px;
                                border-radius: 2px;
                                border-width: 1.5px;
                                border-color: root.all_checked ? Theme.accent : Theme.border;
                                background: root.all_checked ? Theme.accent : transparent;

                                if root.all_checked: Image {
                                    source: @image-url("../icons/regular-black/check.svg");
                                    width: 9px;
                                    height: 9px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: white;
                                }
                            }
                        }

                        Text {
                            text: "(Select All)";
                            font-size: 11px;
                            font-family: Theme.font-mono;
                            font-weight: 600;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            for item in root.items: VerticalLayout {
                spacing: 0px;

                // -- Section header (e.g. "Intensity") — click toggles every
                // column in this section at once, mirroring the main
                // toolbar's own Columns filter popup.
                if item.group_header: group-header-ta := TouchArea {
                    height: 22px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.group_toggled(item.group);
                    }

                    Rectangle {
                        background: group-header-ta.has-hover ? Theme.raised : Theme.bg;
                        animate background { duration: 80ms; }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 7px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 13px;
                                    height: 13px;
                                    border-radius: 2px;
                                    border-width: 1.5px;
                                    border-color: item.group_all_checked ? Theme.accent : Theme.border;
                                    background: item.group_all_checked ? Theme.accent : transparent;

                                    if item.group_all_checked: Image {
                                        source: @image-url("../icons/regular-black/check.svg");
                                        width: 9px;
                                        height: 9px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: white;
                                    }
                                }
                            }

                            Text {
                                text: item.group;
                                font-size: 10px;
                                font-family: Theme.font-sans;
                                font-weight: 700;
                                color: Theme.text-mute;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            // Stamps this Coloc class's checked pattern onto every
                            // other Coloc class section — configure one class, then
                            // copy it instead of repeating the clicks per class.
                            // Only shown for Coloc sections (Intensity is always a
                            // singleton section, so there'd be nothing to copy to).
                            if item.group != "Intensity": apply-all-ta := TouchArea {
                                width: 20px;
                                height: 20px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.group_apply_to_all(item.group);
                                }

                                Rectangle {
                                    border-radius: Theme.radius-sm;
                                    background: apply-all-ta.has-hover ? Theme.hover : transparent;

                                    Image {
                                        source: @image-url("../icons/regular-black/copy-simple.svg");
                                        width: 11px;
                                        height: 11px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: Theme.text-mute;
                                    }
                                }
                            }
                        }
                    }
                }

                FilterCheckbox {
                    label: item.label;
                    checked: item.checked;
                    toggled => {
                        root.item_toggled(item.label);
                    }
                }
            }
        }
    }
}

component DialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;

    width: 96px;
    height: 30px;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? Theme.raised : (root.primary ? (ta.has-hover ? Theme.accent.darker(15%) : Theme.accent) : (ta.has-hover ? Theme.hover : Theme.raised));
    animate background { duration: 80ms; }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    Text {
        text: root.label;
        font-size: 11px;
        font-family: Theme.font-sans;
        font-weight: 600;
        color: root.primary ? white : (root.enabled ? Theme.text-dim : Theme.text-faint);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ExportDialog inherits Rectangle {
    background: Theme.modal-overlay;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(620px, parent.width - 40px);
        height: min(860px, parent.height - 40px);
        background: Theme.panel;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 18px;
        clip: true;

        VerticalLayout {
            spacing: 0;

            // -- Header ---------------------------------------------------------
            Rectangle {
                height: 52px;
                background: Theme.panel;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 12px;

                    Text {
                        text: "Export results";
                        color: Theme.text;
                        font-size: 15px;
                        font-family: Theme.font-sans;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: close-ta.has-hover ? Theme.raised : transparent;

                        Text {
                            text: "x";
                            color: Theme.text-dim;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close-ta := TouchArea {
                            clicked => {
                                ResultsState.export_dialog_close();
                            }
                        }
                    }
                }

                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border-soft;
                }
            }

            // -- Body -------------------------------------------------------------
            // Scrollable so the dialog degrades gracefully (rather than
            // silently clipping the footer) if the window is short enough
            // that the fixed-size sections below don't all fit at once.
            body-scroll := ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;

                        Text {
                            text: "Export style:";
                            width: 74px;
                            font-size: 11px;
                            font-family: Theme.font-sans;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }

                        StyleToggleButton {
                            label: "Table";
                            selected: ResultsState.export_style == "table";
                            clicked => { ResultsState.export_style_selected("table"); }
                        }

                        StyleToggleButton {
                            label: "Coloc details";
                            selected: ResultsState.export_style == "coloc_detail";
                            clicked => { ResultsState.export_style_selected("coloc_detail"); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    if ResultsState.export_style == "table": HorizontalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;

                        Text {
                            text: "Group by:";
                            width: 74px;
                            font-size: 11px;
                            font-family: Theme.font-sans;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }

                        StyleToggleButton {
                            label: "No Grouping";
                            selected: ResultsState.export_group_by == "none";
                            clicked => { ResultsState.export_group_by = "none"; }
                        }

                        StyleToggleButton {
                            label: "Image";
                            selected: ResultsState.export_group_by == "image";
                            clicked => { ResultsState.export_group_by = "image"; }
                        }

                        StyleToggleButton {
                            label: "Regex";
                            selected: ResultsState.export_group_by == "regex";
                            clicked => { ResultsState.export_group_by = "regex"; }
                        }

                        if ResultsState.export_group_by == "regex": LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "e.g. (.*)_ch\\d+";
                            text <=> ResultsState.export_group_regex;
                        }

                        if ResultsState.export_group_by != "regex": Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        vertical-stretch: 0;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: "Classes to include:";
                                font-size: 11px;
                                font-family: Theme.font-sans;
                                font-weight: 600;
                                color: Theme.text-dim;
                            }

                            ChecklistBox {
                                items: ResultsState.export_class_items;
                                all_checked: ResultsState.export_class_all_checked;
                                item_toggled(label) => { ResultsState.export_class_item_toggled(label); }
                                select_all => { ResultsState.export_class_select_all(); }
                                clear_all => { ResultsState.export_class_clear_all(); }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: "Images to export:";
                                font-size: 11px;
                                font-family: Theme.font-sans;
                                font-weight: 600;
                                color: Theme.text-dim;
                            }

                            ChecklistBox {
                                items: ResultsState.export_image_items;
                                all_checked: ResultsState.export_image_all_checked;
                                item_toggled(label) => { ResultsState.export_image_item_toggled(label); }
                                select_all => { ResultsState.export_image_select_all(); }
                                clear_all => { ResultsState.export_image_clear_all(); }
                            }
                        }
                    }

                    each-image-ta := TouchArea {
                        height: 22px;
                        mouse-cursor: pointer;
                        clicked => {
                            ResultsState.export_each_image = !ResultsState.export_each_image;
                        }

                        HorizontalLayout {
                            padding-left: 2px;
                            spacing: 7px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 13px;
                                    height: 13px;
                                    border-radius: 2px;
                                    border-width: 1.5px;
                                    border-color: ResultsState.export_each_image ? Theme.accent : Theme.border;
                                    background: ResultsState.export_each_image ? Theme.accent : transparent;

                                    if ResultsState.export_each_image: Image {
                                        source: @image-url("../icons/regular-black/check.svg");
                                        width: 9px;
                                        height: 9px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: white;
                                    }
                                }
                            }

                            Text {
                                text: "Export each checked image as its own file (filename gets the image name)";
                                font-size: 11px;
                                font-family: Theme.font-sans;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;

                        Text {
                            text: "Columns to export:";
                            font-size: 11px;
                            font-family: Theme.font-sans;
                            font-weight: 600;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        if ResultsState.export_has_intensity: Text {
                            text: "Intensity:";
                            font-size: 10px;
                            font-family: Theme.font-sans;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                        }

                        if ResultsState.export_has_intensity: DialogButton {
                            width: 60px;
                            height: 22px;
                            label: "None";
                            clicked => { ResultsState.export_column_intensity_preset("none"); }
                        }

                        if ResultsState.export_has_intensity: DialogButton {
                            width: 76px;
                            height: 22px;
                            label: "Avg+Sum";
                            clicked => { ResultsState.export_column_intensity_preset("avg_sum"); }
                        }

                        if ResultsState.export_has_intensity: DialogButton {
                            width: 60px;
                            height: 22px;
                            label: "All";
                            clicked => { ResultsState.export_column_intensity_preset("all"); }
                        }
                    }

                    ChecklistBox {
                        height: 220px;
                        items: ResultsState.export_column_items;
                        all_checked: ResultsState.export_column_all_checked;
                        item_toggled(label) => { ResultsState.export_column_item_toggled(label); }
                        select_all => { ResultsState.export_column_select_all(); }
                        clear_all => { ResultsState.export_column_clear_all(); }
                        group_toggled(group) => { ResultsState.export_column_group_toggle(group); }
                        group_apply_to_all(group) => { ResultsState.export_column_apply_group_to_all(group); }
                    }

                    // -- Combination builder -------------------------------------
                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Name:";
                            font-size: 11px;
                            font-family: Theme.font-sans;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "e.g. GroupABC";
                            text <=> ResultsState.export_combo_name;
                        }

                        Text {
                            text: "Format:";
                            font-size: 11px;
                            font-family: Theme.font-sans;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            width: 90px;
                            model: ["CSV", "XLSX"];
                            current-value: ResultsState.export_format == "xlsx" ? "XLSX" : "CSV";
                            selected(v) => {
                                ResultsState.export_format = v == "XLSX" ? "xlsx" : "csv";
                            }
                        }

                        DialogButton {
                            label: "+ Add";
                            clicked => {
                                ResultsState.export_add_batch();
                            }
                        }

                        DialogButton {
                            width: 118px;
                            label: "Add from table";
                            clicked => {
                                ResultsState.export_add_batch_from_table();
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-soft;
                    }

                    Text {
                        text: "Combinations to export:";
                        font-size: 11px;
                        font-family: Theme.font-sans;
                        font-weight: 600;
                        color: Theme.text-dim;
                    }

                    Rectangle {
                        height: 140px;
                        border-width: 1px;
                        border-color: Theme.border-soft;
                        border-radius: Theme.radius-sm;
                        clip: true;

                        if ResultsState.export_batches.length == 0: Text {
                            x: 8px;
                            y: 6px;
                            width: parent.width - 16px;
                            text: "No combinations queued — Export All will use the classes checked above.";
                            font-size: 11px;
                            font-family: Theme.font-sans;
                            color: Theme.text-faint;
                            wrap: word-wrap;
                        }

                        if ResultsState.export_batches.length > 0: ScrollView {
                            VerticalLayout {
                                alignment: start;

                                for batch[idx] in ResultsState.export_batches: Rectangle {
                                    height: 28px;
                                    background: row-ta.has-hover ? Theme.hover.with-alpha(0.3) : transparent;

                                    row-ta := TouchArea { }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 8px;

                                        Text {
                                            text: batch.name;
                                            font-size: 11px;
                                            font-family: Theme.font-mono;
                                            font-weight: 600;
                                            color: Theme.text-dim;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: batch.classes_label;
                                            font-size: 11px;
                                            font-family: Theme.font-mono;
                                            color: Theme.text-mute;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: batch.each_image ? "each image: " + batch.images_label : batch.images_label;
                                            font-size: 11px;
                                            font-family: Theme.font-mono;
                                            color: batch.each_image ? Theme.accent : Theme.text-mute;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: batch.style_label;
                                            width: 80px;
                                            font-size: 10px;
                                            font-family: Theme.font-mono;
                                            font-weight: 600;
                                            color: Theme.text-dim;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: batch.format == "xlsx" ? "XLSX" : "CSV";
                                            font-size: 10px;
                                            font-family: Theme.font-mono;
                                            font-weight: 600;
                                            color: Theme.accent;
                                            vertical-alignment: center;
                                        }

                                        remove-ta := TouchArea {
                                            width: 18px;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                ResultsState.export_remove_batch(idx);
                                            }

                                            Text {
                                                text: "x";
                                                font-size: 12px;
                                                color: remove-ta.has-hover ? Theme.err : Theme.text-mute;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if ResultsState.export_status != "": Text {
                        text: ResultsState.export_status;
                        font-size: 11px;
                        font-family: Theme.font-sans;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                }
            }

            // -- Footer -----------------------------------------------------------
            Rectangle {
                height: ResultsState.export_running ? 64px : 56px;
                background: Theme.bg;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border-soft;
                }

                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 4px;
                    alignment: center;

                    if ResultsState.export_running: VerticalLayout {
                        spacing: 2px;

                        ProgressIndicator {
                            progress: ResultsState.export_progress_fraction;
                        }

                        Text {
                            text: ResultsState.export_progress_total > 0
                                ? "File " + ResultsState.export_progress_current + " of " + ResultsState.export_progress_total
                                : "";
                            font-size: 10px;
                            font-family: Theme.font-sans;
                            color: Theme.text-faint;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        DialogButton {
                            width: 140px;
                            label: "Export as Displayed";
                            enabled: !ResultsState.export_running;
                            clicked => {
                                ResultsState.export_as_displayed();
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        DialogButton {
                            label: "Cancel";
                            clicked => {
                                if (ResultsState.export_running) {
                                    ResultsState.export_cancel();
                                } else {
                                    ResultsState.export_dialog_close();
                                }
                            }
                        }

                        DialogButton {
                            label: ResultsState.export_running ? "Exporting…" : "Export All";
                            primary: true;
                            enabled: !ResultsState.export_running;
                            clicked => {
                                ResultsState.export_run_all();
                            }
                        }
                    }
                }
            }
        }
    }
}
