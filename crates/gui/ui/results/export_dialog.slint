// export_dialog.slint — the Results export (backed by
// `ResultExport::start_export` in evanalyzer_app's results_exporter.rs):
// grouped like the Plate settings - File, Images & objects, Plate & wells,
// Filter - one labelled line per setting.
import { InkButton, InkButtonKind, InkCaption, InkDialog, InkDialogFooter, InkHint, InkIconButton, InkIcons, InkLabel, InkProgressBar, InkTone } from "../ink/ink.slint";
import { ExportDialogState } from "../api/export.slint";

import { ScrollView } from "std-widgets.slint";
import { LineEdit, CheckBox, ComboBox } from "../ink/std_compat.slint";
import { Ink } from "../ink/palette.slint";
import { InkMultiSelect, MultiSelectItem, InkSegmented } from "../ink/ink.slint";

// A group: its caption, then its lines.
component Group inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    InkCaption {
        text: root.title;
    }

    @children
}

// "from … to …" for a Z or T range.
component RangeFields inherits HorizontalLayout {
    in-out property <string> first;
    in-out property <string> last;
    spacing: 8px;
    alignment: start;
    LineEdit {
        width: 64px;
        horizontal-alignment: center;
        input-type: number;
        text <=> root.first;
    }

    Text {
        text: "to";
        vertical-alignment: center;
        color: Ink.text-mute;
        font-size: Ink.fs-secondary;
    }

    LineEdit {
        width: 64px;
        horizontal-alignment: center;
        input-type: number;
        text <=> root.last;
    }
}

export component ExportDialog inherits InkDialog {
    // Below the Export button.
    from-right: true;
    anchor-x: 24px;
    anchor-y: 96px;
    title: "Export results";
    card-width: 380px;
    // No closing while the export runs (Cancel stops it first).
    closable: !ExportDialogState.is-exporting;
    close => {
        ExportDialogState.close-clicked();
        ExportDialogState.active = false;
    }

    property <bool> xlsx: ExportDialogState.format-summary == "XLSX";
    property <length> field-w: 220px;
    // The options most exports don't need.
    property <bool> more: false;

    ScrollView {
        vertical-stretch: 1;
        // As high as its content (the card follows; it scrolls when the
        // window is shorter). Only up and down: as wide as the card.
        preferred-height: export-body.preferred-height;
        content-width: self.visible-width;
        export-body := VerticalLayout {
            width: parent.width;
            // Room for the scroll bar.
            padding-right: 12px;
            spacing: 14px;
            alignment: start;

            // -- What (design R) --
            Group {
                title: "EXPORT";
                CheckBox {
                    text: "Objects - one row per object";
                    checked <=> ExportDialogState.with-list-view;
                }
                CheckBox {
                    text: "Per image";
                    checked <=> ExportDialogState.with-grouped-by-image-list;
                }
                CheckBox {
                    text: "Time course - per time point";
                    checked <=> ExportDialogState.with-time-course;
                }
                // Its lines, statistics and tables.
                if ExportDialogState.with-time-course: VerticalLayout {
                    padding-left: 24px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        InkLabel {
                            text: "A line per";
                        }
                        ComboBox {
                            // In by the indent: ends with the fields below.
                            width: root.field-w - 24px;
                            model: ["Class", "Image", "Well", "Track"];
                            current-index: ExportDialogState.time-lines;
                            selected(v) => {
                                ExportDialogState.time-lines = self.current-index;
                                // A wide table per track would have a column per track.
                                if self.current-index == 3 {
                                    ExportDialogState.time-layout = 0;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        InkLabel {
                            text: "Statistics";
                        }
                        InkMultiSelect {
                            summary-text: ExportDialogState.time-stat-summary;
                            items <=> ExportDialogState.time-stat-items;
                            multi-select: true;
                            pill-width: root.field-w - 24px;
                            item-selected(key, value, selected) => {
                                ExportDialogState.time-stat-item-selected(key, selected);
                            }
                        }
                    }
                    if ExportDialogState.time-lines != 3: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        InkLabel {
                            text: "Tables";
                        }
                        InkSegmented {
                            label: "Tables";
                            model: ["Long", "Wide", "Both"];
                            selected: ExportDialogState.time-layout;
                            picked(i) => {
                                ExportDialogState.time-layout = i;
                            }
                        }
                    }
                    CheckBox {
                        text: "Relative to the first time point (%)";
                        checked <=> ExportDialogState.time-relative;
                    }
                }
                CheckBox {
                    text: "Per well - plate layout (XLSX)";
                    checked <=> ExportDialogState.with-plate-heatmap-view;
                    enabled: root.xlsx;
                }
                CheckBox {
                    text: "Images with objects drawn (PNG)";
                    checked <=> ExportDialogState.with-drawn-images;
                }
            }

            Group {
                title: "SAVE";
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    InkLabel {
                        text: "Format";
                    }
                    InkMultiSelect {
                        summary-text: ExportDialogState.format-summary;
                        items <=> ExportDialogState.format-items;
                        multi-select: false;
                        pill-width: root.field-w;
                        item-selected(key, value, selected) => {
                            if selected {
                                ExportDialogState.format-summary = value;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    InkLabel {
                        text: "Classes";
                    }
                    InkMultiSelect {
                        summary-text: ExportDialogState.class-summary;
                        items <=> ExportDialogState.class-items;
                        multi-select: true;
                        show-select-all: true;
                        pill-width: root.field-w;
                        item-selected(key, value, selected) => {
                            ExportDialogState.class-item-selected(key, selected);
                        }
                        select-all => {
                            ExportDialogState.class-select-all();
                        }
                        select-none => {
                            ExportDialogState.class-select-none();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    InkLabel {
                        text: "To";
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: Ink.control-h;
                        border-radius: Ink.radius-sm;
                        background: Ink.field;
                        border-width: 1px;
                        border-color: Ink.border;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: ExportDialogState.output-dir == "" ? "Choose a folder…" : ExportDialogState.output-dir;
                            color: ExportDialogState.output-dir == "" ? Ink.text-faint : Ink.text;
                            vertical-alignment: center;
                            font-size: Ink.fs-body;
                            overflow: elide;
                        }
                    }
                    InkIconButton {
                        size: Ink.control-h;
                        icon: InkIcons.open;
                        label: "Choose the folder";
                        enabled: !ExportDialogState.is-exporting;
                        disabled-reason: "Exporting…";
                        clicked => {
                            ExportDialogState.pick-output-dir();
                        }
                    }
                }
            }

            // -- More options --
            HorizontalLayout {
                alignment: start;
                Text {
                    text: root.more ? "Fewer options ‹" : "More options ›";
                    font-size: Ink.fs-secondary;
                    color: more-ta.has-hover ? Ink.text : Ink.focus;
                    more-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.more = !root.more;
                        }
                    }
                }
            }

            if root.more: Group {
                title: "OBJECTS";
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    InkLabel {
                        text: "Images";
                    }
                    InkMultiSelect {
                        summary-text: ExportDialogState.image-summary;
                        items <=> ExportDialogState.image-items;
                        multi-select: true;
                        show-select-all: true;
                        show-search: true;
                        filter-text <=> ExportDialogState.image-filter-text;
                        pill-width: root.field-w;
                        item-selected(key, value, selected) => {
                            ExportDialogState.image-item-selected(key, selected);
                        }
                        select-all => {
                            ExportDialogState.image-select-all();
                        }
                        select-none => {
                            ExportDialogState.image-select-none();
                        }
                        filter-changed(text) => {
                            ExportDialogState.image-filter-changed(text);
                        }
                        enabled: ExportDialogState.with-list-view;
                    }
                }
                CheckBox {
                    text: "With coloc details";
                    checked <=> ExportDialogState.with-list-coloc-details;
                    enabled: ExportDialogState.with-list-view;
                }
                CheckBox {
                    text: "Each image in its own file";
                    checked <=> ExportDialogState.with-list-one-file-per-image;
                    enabled: ExportDialogState.with-list-view;
                }
                HorizontalLayout {
                    spacing: 8px;
                    CheckBox {
                        horizontal-stretch: 1;
                        text: "Image heatmap";
                        checked <=> ExportDialogState.with-heatmap;
                        enabled: root.xlsx;
                    }
                    InkMultiSelect {
                        enabled: ExportDialogState.with-heatmap && root.xlsx;
                        summary-text: ExportDialogState.square-size-summary;
                        items <=> ExportDialogState.square-size-items;
                        multi-select: false;
                        pill-width: 120px;
                        item-selected(key, value, selected) => {
                            if selected {
                                ExportDialogState.square-size-summary = value;
                            }
                        }
                    }
                }
                CheckBox {
                    text: "Transpose the tables";
                    checked <=> ExportDialogState.transpond-output-table;
                }
            }

            if root.more: Group {
                title: "PLATE & WELLS";
                InkHint {
                    text: "As in the project's plate settings." + (root.xlsx ? "" : " Only for XLSX.");
                }
                CheckBox {
                    text: "Plate as list";
                    checked <=> ExportDialogState.with-plate-list;
                    enabled: root.xlsx;
                }
                CheckBox {
                    text: "Wells as heatmap";
                    checked <=> ExportDialogState.with-well-heatmap-view;
                    enabled: root.xlsx;
                }
                CheckBox {
                    text: "Wells as list";
                    checked <=> ExportDialogState.with-well-list;
                    enabled: root.xlsx;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    InkLabel {
                        text: "Colors";
                    }
                    InkMultiSelect {
                        summary-text: ExportDialogState.color-schema-summary;
                        items <=> ExportDialogState.color-schema-items;
                        multi-select: false;
                        pill-width: root.field-w;
                        enabled: root.xlsx;
                        item-selected(key, value, selected) => {
                            if selected {
                                ExportDialogState.color-schema-summary = value;
                            }
                        }
                    }
                }
            }

            if root.more: Group {
                title: "FILE AND VALUES";
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    InkLabel {
                        text: "Name prefix";
                    }
                    LineEdit {
                        width: root.field-w;
                        placeholder-text: "e.g. experiment1_";
                        text <=> ExportDialogState.output-file-prefix;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    InkLabel {
                        text: "Measurements";
                    }
                    InkMultiSelect {
                        summary-text: ExportDialogState.column-summary;
                        items <=> ExportDialogState.column-items;
                        groups: ExportDialogState.column-groups;
                        multi-select: true;
                        show-select-all: true;
                        pill-width: root.field-w;
                        item-selected(key, value, selected) => {
                            ExportDialogState.column-item-selected(key, selected);
                        }
                        select-all => {
                            ExportDialogState.column-select-all();
                        }
                        select-none => {
                            ExportDialogState.column-select-none();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    InkLabel {
                        text: "Aggregations";
                    }
                    InkMultiSelect {
                        summary-text: ExportDialogState.aggregation-summary;
                        items <=> ExportDialogState.aggregation-items;
                        multi-select: true;
                        show-select-all: true;
                        pill-width: root.field-w;
                        item-selected(key, value, selected) => {
                            ExportDialogState.aggregation-item-selected(key, selected);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    InkLabel {
                        text: "Z planes";
                    }
                    // All by default; a range only when chosen.
                    InkSegmented {
                        label: "Z planes";
                        model: ["All", "Range"];
                        selected: ExportDialogState.z-all ? 0 : 1;
                        picked(i) => {
                            ExportDialogState.z-all = i == 0;
                        }
                    }
                    if !ExportDialogState.z-all: RangeFields {
                        first <=> ExportDialogState.z-start;
                        last <=> ExportDialogState.z-end;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    InkLabel {
                        text: "Time points";
                    }
                    InkSegmented {
                        label: "Time points";
                        model: ["All", "Range"];
                        selected: ExportDialogState.t-all ? 0 : 1;
                        picked(i) => {
                            ExportDialogState.t-all = i == 0;
                        }
                    }
                    if !ExportDialogState.t-all: RangeFields {
                        first <=> ExportDialogState.t-start;
                        last <=> ExportDialogState.t-end;
                    }
                }
            }

            // -- Progress / result --
            if ExportDialogState.is-exporting || ExportDialogState.done || ExportDialogState.has-error: VerticalLayout {
                spacing: 6px;
                Text {
                    text: ExportDialogState.has-error ? "Export failed: " + ExportDialogState.error-message : ExportDialogState.done ? "Export complete." : ExportDialogState.progress-message;
                    color: ExportDialogState.has-error ? Ink.err : (ExportDialogState.done ? Ink.ok : Ink.text);
                    font-size: Ink.fs-body;
                    wrap: word-wrap;
                }

                if ExportDialogState.is-exporting: InkProgressBar {
                    value: ExportDialogState.progress-total > 0 ? ExportDialogState.progress-current / ExportDialogState.progress-total : 0;
                }
            }
        }
    }

    InkDialogFooter {
        InkButton {
            text: "Close";
            enabled: !ExportDialogState.is-exporting;
            disabled-reason: "Wait for the export to finish";
            clicked => {
                root.close();
            }
        }

        if ExportDialogState.is-exporting: InkButton {
            text: "Cancel";
            clicked => {
                ExportDialogState.cancel-clicked();
            }
        }

        InkButton {
            kind: InkButtonKind.primary;
            text: ExportDialogState.is-exporting ? "Exporting…" : "Start export";
            enabled: !ExportDialogState.is-exporting && ExportDialogState.output-dir != "";
            disabled-reason: ExportDialogState.is-exporting ? "Exporting…" : "Choose a folder first";
            clicked => {
                ExportDialogState.start-clicked();
            }
        }
    }
}
