// results/results_tracks.slint — Results › Tracks (with tracked objects):
// one image's tracks as a table - each its time points, speed and the area
// over time - beside the image with their trails (the split pane). A row
// selects the track on the image and back.

import { ResultsState } from "../api/results.slint";
import { Ink, InkSegmented } from "../ink/ink.slint";
import { ListView } from "std-widgets.slint";

component SortHead inherits Rectangle {
    in property <string> text;
    in property <int> key;
    in property <TextHorizontalAlignment> align: TextHorizontalAlignment.left;
    property <bool> on: ResultsState.tracks-sort == root.key;

    accessible-role: button;
    accessible-label: "Sort by " + root.text;
    accessible-checked: root.on;
    accessible-action-default => {
        ResultsState.tracks-sort = root.key;
        ResultsState.tracks-sort-changed(root.key);
    }
    Text {
        width: 100%;
        text: root.text + (root.on ? (root.key == 0 ? " ↑" : " ↓") : "");
        font-size: Ink.fs-secondary;
        font-weight: 600;
        color: root.on ? Ink.text : Ink.text-dim;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        overflow: elide;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            ResultsState.tracks-sort = root.key;
            ResultsState.tracks-sort-changed(root.key);
        }
    }
}

export component ResultsTracksView inherits Rectangle {
    property <length> row-h: 32px;
    property <length> id-w: 84px;
    property <length> span-w: 92px;
    property <length> speed-w: 96px;

    background: Ink.ground;

    VerticalLayout {
        padding: 12px;
        Rectangle {
            background: Ink.panel;
            border-radius: Ink.radius-lg;
            border-width: 1px;
            border-color: Ink.border;
            clip: true;

            VerticalLayout {
                // -- The image and its tracks; the speed's unit --
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: ResultsState.tracks-image != "" ? ResultsState.tracks-image : "No image with tracks";
                            font-size: Ink.fs-body;
                            font-weight: 600;
                            color: Ink.text;
                            overflow: elide;
                        }
                        Text {
                            text: ResultsState.tracks-summary;
                            font-size: Ink.fs-caption;
                            color: Ink.text-dim;
                            overflow: elide;
                        }
                    }
                    for step in [{ t: "‹", d: -1, l: "Previous image" }, { t: "›", d: 1, l: "Next image" }]: Rectangle {
                        width: 28px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 6px;
                        background: step-ta.has-hover ? Ink.hover : transparent;
                        accessible-role: button;
                        accessible-label: step.l;
                        accessible-action-default => {
                            ResultsState.tracks-image-step(step.d);
                        }
                        Text {
                            text: step.t;
                            font-size: Ink.fs-body;
                            color: Ink.text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        step-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                ResultsState.tracks-image-step(step.d);
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        InkSegmented {
                            label: "Speed unit";
                            model: ["px/frame", "µm/min", "µm/s"];
                            selected: ResultsState.tracks-unit;
                            // µm: only with a pixel size and a frame interval.
                            enabled: ResultsState.tracks-um;
                            picked(i) => {
                                ResultsState.tracks-unit = i;
                                ResultsState.tracks-unit-changed(i);
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Ink.border-soft;
                }

                // -- The columns --
                Rectangle {
                    height: 30px;
                    background: Ink.field;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 14px;
                        SortHead {
                            width: root.id-w;
                            text: "Track";
                            key: 0;
                        }
                        SortHead {
                            width: root.span-w;
                            text: "Time points";
                            key: 1;
                        }
                        SortHead {
                            width: root.speed-w;
                            text: "Speed " + ResultsState.tracks-speed-unit;
                            key: 2;
                            align: TextHorizontalAlignment.right;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "Area over time";
                            font-size: Ink.fs-secondary;
                            font-weight: 600;
                            color: Ink.text-dim;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Ink.border-soft;
                    }
                }

                // A track selected on the image: its row scrolled into view.
                property <int> selected: ResultsState.track-selected;
                changed selected => {
                    if self.selected >= 0 {
                        if self.selected * root.row-h < -list.content-y {
                            list.content-y = -self.selected * root.row-h;
                        } else if (self.selected + 1) * root.row-h > -list.content-y + list.visible-height {
                            list.content-y = -((self.selected + 1) * root.row-h - list.visible-height);
                        }
                    }
                }

                // Only the rows in view are made: an image can have many
                // thousands of tracks.
                list := ListView {
                    vertical-stretch: 1;
                    accessible-label: "Tracks";
                    for track[index] in ResultsState.track-rows: Rectangle {
                        height: root.row-h;
                        background: index == ResultsState.track-selected ? Ink.selection : row-ta.has-hover ? Ink.hover : transparent;
                        accessible-role: list-item;
                        accessible-label: "Track " + track.id + ", " + track.frames + " time points, speed " + track.speed;
                        accessible-item-selected: index == ResultsState.track-selected;
                        accessible-action-default => {
                            ResultsState.track-row-clicked(index);
                        }
                        if index == ResultsState.track-selected: Rectangle {
                            x: 0;
                            width: 3px;
                            background: Ink.focus;
                        }
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 14px;
                            HorizontalLayout {
                                width: root.id-w;
                                spacing: 6px;
                                Rectangle {
                                    width: 8px;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: track.color;
                                    }
                                }
                                Text {
                                    text: track.id;
                                    font-size: Ink.fs-body;
                                    font-family: Ink.font-mono;
                                    color: Ink.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            Text {
                                width: root.span-w;
                                text: track.span + "  (" + track.frames + ")";
                                font-size: Ink.fs-body;
                                font-family: Ink.font-mono;
                                color: Ink.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                width: root.speed-w;
                                text: track.speed;
                                font-size: Ink.fs-body;
                                font-family: Ink.font-mono;
                                color: Ink.text;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                Path {
                                    x: 0;
                                    y: 6px;
                                    width: min(parent.width, 160px);
                                    height: parent.height - 12px;
                                    viewbox-width: 100;
                                    viewbox-height: 20;
                                    fit: fill;
                                    commands: track.curve;
                                    stroke: track.color;
                                    stroke-width: 1.4px;
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Ink.border-soft;
                        }
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                ResultsState.track-row-clicked(index);
                            }
                        }
                    }
                }
            }
        }
    }
}
