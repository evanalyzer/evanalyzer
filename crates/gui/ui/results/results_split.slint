// results/results_split.slint — Results, split with the image (board Z):
// the results left, the image right. The image is the one viewer
// (`Viewport`, moved into the right pane by the workspace); here what is
// on and around it: the head over the image, the selected object's card, the hint, the well's filmstrip, and the divider.

import { ResultsRailMode, ResultsState } from "../api/results.slint";
import { ViewportState } from "../api/viewport.slint";
import { ChannelState } from "../api/state.slint";
import { Ink, InkIcons, InkTipZone } from "../ink/ink.slint";

// Floats on the image: dark in every scheme, as the image is.
component Hud inherits Rectangle {
    background: #18181B.with-alpha(0.92);
    border-width: 1px;
    border-color: #2E2E33;
    border-radius: 8px;
}

component HudButton inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> on: false;
    in property <bool> enabled: true;
    in property <image> icon;
    // Hovered, also while disabled (for a tooltip saying why).
    out property <bool> hovered: ta.has-hover && !ta.pressed;
    callback clicked;

    height: 26px;
    border-radius: 5px;
    background: root.on ? #3F3F46 : ta.has-hover && root.enabled ? #2D2D34 : transparent;
    opacity: root.enabled ? 1.0 : 0.4;
    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-checked: root.on;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        if root.icon.width > 0: Image {
            source: root.icon;
            width: 12px;
            colorize: root.on ? #FAFAFA : #D4D4D8;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            font-size: Ink.fs-secondary;
            font-weight: root.on ? 600 : 400;
            color: root.on ? #FAFAFA : #D4D4D8;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}

// The head over the image: which image (and channel), ‹ n / total ›,
// Follow selection, Color by (plate), Open in Images.
export component SplitImageHead inherits Hud {
    property <bool> plate: ResultsState.rail-mode == ResultsRailMode.matrix;

    height: 36px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 4px;
        alignment: stretch;

        Rectangle {
            width: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 2px;
                background: ResultsState.split-sel.active ? ResultsState.split-sel.class-color : #5A5E6A;
            }
        }
        Rectangle { width: 2px; }
        Text {
            text: ResultsState.split-title != "" ? ResultsState.split-title : (root.plate ? "Click a well to see its images" : "Click a row to see its object");
            font-size: Ink.fs-body;
            font-weight: 600;
            color: #F4F4F5;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 60px;
        }
        if root.plate: Text {
            text: "Color by";
            font-size: Ink.fs-caption;
            color: #A1A1AA;
            vertical-alignment: center;
        }
        if root.plate: Rectangle {
            width: by-row.preferred-width + 4px;
            height: 30px;
            y: 3px;
            background: #1F1F23;
            border-radius: 6px;
            accessible-role: tab-list;
            accessible-label: "Color by";
            by-row := HorizontalLayout {
                padding: 2px;
                HudButton {
                    text: "Class";
                    on: !ResultsState.split-by-value || !ResultsState.split-values;
                    clicked => {
                        ResultsState.split-by-value = false;
                        ResultsState.split-by-value-changed(false);
                    }
                }
                HudButton {
                    text: "Value";
                    on: ResultsState.split-by-value && ResultsState.split-values;
                    enabled: ResultsState.split-values;
                    clicked => {
                        ResultsState.split-by-value = true;
                        ResultsState.split-by-value-changed(true);
                    }
                    // Also while disabled: why.
                    InkTipZone {
                        width: 100%;
                        height: 100%;
                        wanted: parent.hovered;
                        text: ResultsState.split-values ? "Color the objects by " + ResultsState.matrix-column-summary
                            : "Pick a value of each object in the plate (not Count) to color by it";
                    }
                }
            }
        }

        HudButton {
            text: "‹";
            label: ResultsState.rail-mode == ResultsRailMode.tracks ? "Previous track" : "Previous object";
            enabled: ResultsState.split-total > 0;
            y: (parent.height - self.height) / 2;
            clicked => {
                ResultsState.split-step(-1);
            }
        }
        Text {
            text: ResultsState.split-total == 0 ? "– / –" : (ResultsState.split-pos > 0 ? ResultsState.split-pos : "–") + " / " + ResultsState.split-total;
            font-size: Ink.fs-caption;
            font-family: Ink.font-mono;
            color: #A1A1AA;
            vertical-alignment: center;
        }
        HudButton {
            text: "›";
            label: ResultsState.rail-mode == ResultsRailMode.tracks ? "Next track" : "Next object";
            enabled: ResultsState.split-total > 0;
            y: (parent.height - self.height) / 2;
            clicked => {
                ResultsState.split-step(1);
            }
        }
        Rectangle {
            width: 9px;
            Rectangle {
                width: 1px;
                height: 18px;
                background: #2E2E33;
            }
        }
        // The image controls: channels, histogram, overlay (a drawer).
        HudButton {
            text: "Image";
            icon: InkIcons.image-controls;
            label: "Image controls";
            on: ResultsState.split-image-panel;
            y: (parent.height - self.height) / 2;
            clicked => {
                ResultsState.split-image-panel = !ResultsState.split-image-panel;
                ResultsState.split-image-panel-changed(ResultsState.split-image-panel);
            }
        }
        HudButton {
            text: "Follow selection";
            icon: InkIcons.focus;
            on: ResultsState.split-follow;
            y: (parent.height - self.height) / 2;
            clicked => {
                ResultsState.split-follow = !ResultsState.split-follow;
                ResultsState.split-follow-changed(ResultsState.split-follow);
            }
        }
        HudButton {
            text: "Open in Images ↗";
            enabled: ResultsState.split-title != "";
            y: (parent.height - self.height) / 2;
            clicked => {
                ResultsState.split-open-in-images();
            }
        }
    }
}

// A row of choices on the image's dark bars.
component HudChoice inherits Rectangle {
    in property <string> label;
    in property <[string]> model;
    in property <int> selected;
    callback picked(int);
    width: choice-row.preferred-width + 4px;
    height: 30px;
    background: #1F1F23;
    border-radius: 6px;
    accessible-role: tab-list;
    accessible-label: root.label;
    choice-row := HorizontalLayout {
        padding: 2px;
        for item[i] in root.model: HudButton {
            text: item;
            on: i == root.selected;
            clicked => {
                root.picked(i);
            }
        }
    }
}

// Tracks, on the image: how much of each path (none, the last N time
// points, whole), all tracks or the selected one, in whose color.
export component SplitTracksBar inherits Hud {
    width: bar.preferred-width;
    height: bar.preferred-height;

    bar := VerticalLayout {
        padding: 6px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            Text {
                text: "Trail";
                font-size: Ink.fs-caption;
                color: #A1A1AA;
                vertical-alignment: center;
            }
            HudChoice {
                label: "Trail";
                model: ["Off", ResultsState.trail-frames + " time points", "Whole track"];
                selected: ResultsState.trail-mode;
                picked(i) => {
                    ResultsState.trail-mode = i;
                    ResultsState.trail-changed(i, ResultsState.trail-frames);
                }
            }
            // The trail's time points: fewer / more.
            if ResultsState.trail-mode == 1: HudButton {
                text: "−";
                label: "Shorter trail";
                enabled: ResultsState.trail-frames > 1;
                y: (parent.height - self.height) / 2;
                clicked => {
                    ResultsState.trail-frames = max(1, ResultsState.trail-frames - (ResultsState.trail-frames > 20 ? 5 : 1));
                    ResultsState.trail-changed(1, ResultsState.trail-frames);
                }
            }
            if ResultsState.trail-mode == 1: HudButton {
                text: "+";
                label: "Longer trail";
                y: (parent.height - self.height) / 2;
                clicked => {
                    ResultsState.trail-frames = ResultsState.trail-frames + (ResultsState.trail-frames >= 20 ? 5 : 1);
                    ResultsState.trail-changed(1, ResultsState.trail-frames);
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            HudChoice {
                label: "Tracks shown";
                model: ["All tracks", "Selected only"];
                selected: ResultsState.tracks-only-selected ? 1 : 0;
                picked(i) => {
                    ResultsState.tracks-only-selected = i == 1;
                    ResultsState.tracks-only-selected-changed(i == 1);
                }
            }
            Text {
                text: "Color";
                font-size: Ink.fs-caption;
                color: #A1A1AA;
                vertical-alignment: center;
            }
            HudChoice {
                label: "Color by";
                model: ["Track", "Class"];
                selected: ResultsState.tracks-by-track ? 0 : 1;
                picked(i) => {
                    ResultsState.tracks-by-track = i == 0;
                    ResultsState.tracks-by-track-changed(i == 0);
                }
            }
        }
    }
}

// The selected object's facts, docked top left under the image's head -
// never over the object or its track (the viewer's yellow crosshair marks
// it). Folds to its first line; hidden while the time series plays.
// Tracks: the track's facts are under its row in the table.
export component SplitSelection inherits Rectangle {
    property <bool> folded: ResultsState.split-card-folded;

    card := Hud {
        x: 10px;
        y: 10px + 36px + 8px;
        width: clamp(card-box.preferred-width, 200px, min(320px, root.width - 20px));
        height: card-box.preferred-height;
        visible: !ChannelState.is_play_active;

        card-box := VerticalLayout {
            padding-left: 10px;
            padding-right: 4px;
            padding-top: 4px;
            padding-bottom: root.folded ? 4px : 8px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 2px;
                        background: ResultsState.split-sel.class-color;
                    }
                }
                Text {
                    text: ResultsState.split-sel.class-name;
                    font-size: Ink.fs-body;
                    font-weight: 600;
                    color: #F4F4F5;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "#" + ResultsState.split-sel.id;
                    font-size: Ink.fs-caption;
                    font-family: Ink.font-mono;
                    color: #A1A1AA;
                    vertical-alignment: center;
                }
                HudButton {
                    text: root.folded ? "⌄" : "⌃";
                    label: root.folded ? "Show the facts" : "Fold the facts";
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        ResultsState.split-card-folded = !ResultsState.split-card-folded;
                        ResultsState.split-card-folded-changed(ResultsState.split-card-folded);
                    }
                }
            }
            if !root.folded: VerticalLayout {
                spacing: 3px;
                for fact in [
                    { k: "Area", v: ResultsState.split-sel.area },
                    { k: ResultsState.split-channels.length > 0 ? "Mean " + ResultsState.split-channels[ResultsState.split-channel] : "Mean", v: ResultsState.split-sel.mean },
                    { k: "Position", v: ResultsState.split-sel.position },
                ]: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 96px;
                        text: fact.k;
                        font-size: Ink.fs-caption;
                        color: #A1A1AA;
                        overflow: elide;
                    }
                    Text {
                        text: fact.v;
                        font-size: Ink.fs-caption;
                        font-family: Ink.font-mono;
                        color: #F4F4F5;
                    }
                }
            }
        }
    }
}

// Bottom left on the image, above its bar: what a click does.
export component SplitHint inherits Hud {
    property <bool> plate: ResultsState.rail-mode == ResultsRailMode.matrix;
    height: 28px;
    width: hint-row.preferred-width;
    hint-row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        // The zoom is in the status bar.
        Text {
            text: ResultsState.rail-mode == ResultsRailMode.tracks ? "Click an object to select its track" : "Click an object to find it in the " + (root.plate ? "well" : "list");
            font-size: Ink.fs-caption;
            color: #A1A1AA;
            vertical-alignment: center;
        }
    }
}

// Plate: the well's images under the image; a click shows one.
export component SplitFilmstrip inherits Rectangle {
    background: #18181B;
    Rectangle {
        y: 0;
        height: 1px;
        background: #2E2E33;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;
        Text {
            width: 52px;
            text: "WELL " + ResultsState.active-well;
            font-size: Ink.fs-caption;
            font-weight: 600;
            letter-spacing: 0.6px;
            color: #8A8A93;
            vertical-alignment: center;
            overflow: elide;
        }
        for thumb in ResultsState.split-thumbs: Rectangle {
            property <bool> current: thumb.key == ResultsState.split-image-key;
            width: 92px;
            height: 56px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: #0B0C10;
            clip: true;
            accessible-role: button;
            accessible-label: thumb.key;
            accessible-item-selected: self.current;
            Image {
                source: thumb.image;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
            Rectangle {
                x: 0;
                y: parent.height - 16px;
                height: 16px;
                background: #000000.with-alpha(0.5);
                Text {
                    x: 4px;
                    width: parent.width - 8px;
                    text: thumb.key;
                    font-size: Ink.fs-caption;
                    font-family: Ink.font-mono;
                    color: #D4D4D8;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Rectangle {
                border-radius: 6px;
                border-width: 2px;
                border-color: parent.current ? #2A6BDF : thumb-ta.has-hover ? #3F3F46 : transparent;
            }
            thumb-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    ResultsState.split-show-image(thumb.key);
                }
            }
        }
    }
}

// Between the panes: dragged sideways, the results get wider or narrower.
export component SplitDivider inherits Rectangle {
    in property <length> min-left;
    in property <length> max-left;
    // Where the drag started (the results' width) and the pointer.
    property <length> start-w;
    property <length> start-x;

    accessible-role: slider;
    accessible-label: "Results width";

    VerticalLayout {
        alignment: center;
        spacing: 3px;
        for i in 4: Rectangle {
            width: 4px;
            height: 4px;
            x: (parent.width - self.width) / 2;
            border-radius: 2px;
            background: ta.has-hover || ta.pressed ? Ink.text-dim : Ink.border;
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.col-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.start-w = ResultsState.split-w;
                root.start-x = self.absolute-position.x + self.mouse-x;
            }
            if e.kind == PointerEventKind.up {
                ResultsState.split-width-changed(ResultsState.split-w);
            }
        }
        moved => {
            if self.pressed {
                ResultsState.split-w = clamp(root.start-w + self.absolute-position.x + self.mouse-x - root.start-x, root.min-left, root.max-left);
            }
        }
    }
}
