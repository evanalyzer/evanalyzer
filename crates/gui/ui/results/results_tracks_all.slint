// results/results_tracks_all.slint — Results › Tracks, Full: every track
// as a table (filters above, a row per track, sortable), the selected one's
// details beside it - its numbers, its area over time, its time points.
// "Show in image" goes to the split layout at that track.

import { ResultsState } from "../api/results.slint";
import { Ink, InkButton, InkButtonKind, InkIcons, InkMultiSelect, InkSegmented } from "../ink/ink.slint";
import { CheckBox, ComboBox, LineEdit } from "../ink/std_compat.slint";
import { ListView, ScrollView } from "std-widgets.slint";

component SortHead inherits Rectangle {
    in property <string> text;
    in property <int> key;
    in property <TextHorizontalAlignment> align: TextHorizontalAlignment.left;
    property <bool> on: ResultsState.tracks-all-sort == root.key;

    accessible-role: button;
    accessible-label: "Sort by " + root.text;
    accessible-checked: root.on;
    accessible-action-default => {
        ResultsState.tracks-all-sort = root.key;
        ResultsState.tracks-all-sort-changed(root.key);
    }
    Text {
        width: 100%;
        text: root.text + (root.on ? (root.key == 0 ? " ↑" : " ↓") : "");
        font-size: Ink.fs-secondary;
        font-weight: 600;
        color: root.on ? Ink.text : Ink.text-dim;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        overflow: elide;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            ResultsState.tracks-all-sort = root.key;
            ResultsState.tracks-all-sort-changed(root.key);
        }
    }
}

component Fact inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 2px;
    Text {
        text: root.label;
        font-size: Ink.fs-caption;
        color: Ink.text-dim;
    }
    Text {
        text: root.value;
        font-size: Ink.fs-body;
        font-family: Ink.font-mono;
        color: Ink.text;
    }
}

export component ResultsTracksAllView inherits Rectangle {
    property <length> row-h: 32px;
    property <length> id-w: 74px;
    property <length> class-w: 96px;
    property <length> image-w: 120px;
    property <length> span-w: 92px;
    property <length> num-w: 82px;

    // The track filters changed from their defaults (the Filters badge).
    property <int> active-filters: (ResultsState.tracks-all-min.to-float() > 1 ? 1 : 0)
        + (ResultsState.tracks-all-from-start ? 1 : 0)
        + (ResultsState.tracks-all-no-edge ? 1 : 0);

    function reset-filters() {
        ResultsState.tracks-all-min = "1";
        ResultsState.tracks-all-from-start = false;
        ResultsState.tracks-all-no-edge = false;
        ResultsState.tracks-all-filter-changed();
    }

    background: Ink.ground;

    VerticalLayout {
        padding: 12px;
        spacing: 12px;

        // -- Filters and how many --
        Rectangle {
            background: Ink.panel;
            border-radius: Ink.radius-lg;
            border-width: 1px;
            border-color: Ink.border;
            height: filters.preferred-height;
            filters := HorizontalLayout {
                padding: 10px;
                padding-left: 14px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    ComboBox {
                        width: 150px;
                        model: ResultsState.tracks-all-classes;
                        current-index: ResultsState.tracks-all-class;
                        selected(v) => {
                            ResultsState.tracks-all-class = self.current-index;
                            ResultsState.tracks-all-filter-changed();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ComboBox {
                        width: 170px;
                        model: ResultsState.tracks-all-images;
                        current-index: ResultsState.tracks-all-image;
                        selected(v) => {
                            ResultsState.tracks-all-image = self.current-index;
                            ResultsState.tracks-all-filter-changed();
                        }
                    }
                }
                // The track filters in a dropdown; the badge counts the
                // ones changed from the default (design canvas "Tracks
                // toolbar", board 3).
                filters-pill := Rectangle {
                    height: Ink.control-h;
                    width: filters-pill-row.preferred-width;
                    border-radius: Ink.radius-sm;
                    background: filters-ta.has-hover ? Ink.hover : Ink.field;
                    border-width: 1px;
                    border-color: root.active-filters > 0 ? Ink.focus : (filters-ta.has-hover ? Ink.text-faint : Ink.border);
                    accessible-role: combobox;
                    accessible-label: "Track filters";
                    accessible-value: root.active-filters + " active";
                    accessible-action-default => {
                        filters-popup.show();
                    }
                    filters-pill-row := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: "Filters";
                            font-size: Ink.fs-body;
                            color: Ink.text;
                            vertical-alignment: center;
                        }
                        if root.active-filters > 0: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 16px;
                                width: max(16px, badge.preferred-width + 10px);
                                border-radius: 8px;
                                background: Ink.focus;
                                badge := Text {
                                    text: root.active-filters;
                                    font-size: Ink.fs-caption;
                                    font-weight: 600;
                                    color: Ink.panel;
                                }
                            }
                        }
                        Image {
                            source: InkIcons.caret-down;
                            width: 10px;
                            colorize: Ink.text-mute;
                        }
                    }
                    filters-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            filters-popup.show();
                        }
                    }
                    filters-popup := PopupWindow {
                        x: 0;
                        y: filters-pill.height + 4px;
                        width: 280px;
                        // Explicit, like InkMultiSelect: an inferred height
                        // misplaces the popup.
                        height: 162px;
                        close-policy: close-on-click-outside;
                        Rectangle {
                            width: 280px;
                            height: 162px;
                            background: Ink.panel;
                            border-width: 1px;
                            border-color: Ink.border;
                            border-radius: Ink.radius-md;
                            drop-shadow-color: Ink.shadow;
                            drop-shadow-blur: 24px;
                            drop-shadow-offset-y: 8px;
                            VerticalLayout {
                                padding: 14px;
                                padding-top: 12px;
                                spacing: 10px;
                                alignment: start;
                                Text {
                                    text: "SHOW ONLY TRACKS";
                                    font-size: Ink.fs-caption;
                                    font-weight: 600;
                                    color: Ink.text-mute;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: "At least";
                                        vertical-alignment: center;
                                        font-size: Ink.fs-secondary;
                                        color: Ink.text-dim;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        LineEdit {
                                            width: 56px;
                                            horizontal-alignment: center;
                                            input-type: number;
                                            text <=> ResultsState.tracks-all-min;
                                            accepted => {
                                                ResultsState.tracks-all-filter-changed();
                                            }
                                            edited => {
                                                ResultsState.tracks-all-filter-changed();
                                            }
                                        }
                                    }
                                    Text {
                                        text: "time points";
                                        vertical-alignment: center;
                                        font-size: Ink.fs-secondary;
                                        color: Ink.text-dim;
                                    }
                                }
                                CheckBox {
                                    text: "From the first time point";
                                    checked <=> ResultsState.tracks-all-from-start;
                                    toggled => {
                                        ResultsState.tracks-all-filter-changed();
                                    }
                                }
                                CheckBox {
                                    text: "Not touching the edge";
                                    checked <=> ResultsState.tracks-all-no-edge;
                                    toggled => {
                                        ResultsState.tracks-all-filter-changed();
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    reset-ta := TouchArea {
                                        enabled: root.active-filters > 0;
                                        mouse-cursor: self.enabled ? pointer : default;
                                        width: reset-text.preferred-width;
                                        height: reset-text.preferred-height;
                                        accessible-role: button;
                                        accessible-label: "Reset filters";
                                        accessible-action-default => {
                                            root.reset-filters();
                                        }
                                        clicked => {
                                            root.reset-filters();
                                        }
                                        reset-text := Text {
                                            text: "Reset filters";
                                            font-size: Ink.fs-secondary;
                                            color: reset-ta.enabled ? Ink.focus : Ink.text-mute;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // "Columns" inline, like a label beside its field.
                HorizontalLayout {
                    width: columns-label.preferred-width + 6px + 110px;
                    spacing: 6px;
                    columns-label := Text {
                        text: "Columns";
                        vertical-alignment: center;
                        font-size: Ink.fs-secondary;
                        color: Ink.text-dim;
                    }
                    VerticalLayout {
                        alignment: center;
                        InkMultiSelect {
                            summary-text: ResultsState.tracks-all-columns-summary;
                            items <=> ResultsState.tracks-all-column-items;
                            multi-select: true;
                            pill-width: 110px;
                            item-selected(key, value, selected) => {
                                ResultsState.tracks-all-column-picked(key, selected);
                            }
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: ResultsState.tracks-all-summary;
                    horizontal-stretch: 0;
                    font-size: Ink.fs-secondary;
                    color: Ink.text-dim;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 120px;
                }
                VerticalLayout {
                    alignment: center;
                    InkSegmented {
                        horizontal-stretch: 0;
                        label: "Speed unit";
                        model: ["px/frame", "µm/min", "µm/s"];
                        selected: ResultsState.tracks-unit;
                        enabled: ResultsState.tracks-all-um;
                        picked(i) => {
                            ResultsState.tracks-unit = i;
                            ResultsState.tracks-unit-changed(i);
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            // -- The tracks --
            Rectangle {
                horizontal-stretch: 1;
                background: Ink.panel;
                border-radius: Ink.radius-lg;
                border-width: 1px;
                border-color: Ink.border;
                clip: true;
                // Many columns scroll sideways: the details stay in view.
                table-scroll := ScrollView {
                    content-width: max(self.visible-width, table.min-width);
                    content-height: self.visible-height;
                    table := VerticalLayout {
                        width: table-scroll.content-width;
                        height: table-scroll.visible-height;
                        Rectangle {
                            height: 30px;
                            background: Ink.field;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                SortHead {
                                    width: root.id-w;
                                    text: "Track";
                                    key: 0;
                                }
                                Text {
                                    width: root.class-w;
                                    text: "Class";
                                    font-size: Ink.fs-secondary;
                                    font-weight: 600;
                                    color: Ink.text-dim;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: root.image-w;
                                    text: "Image";
                                    font-size: Ink.fs-secondary;
                                    font-weight: 600;
                                    color: Ink.text-dim;
                                    vertical-alignment: center;
                                }
                                SortHead {
                                    width: root.span-w;
                                    text: "Time points";
                                    key: 1;
                                }
                                for head in ResultsState.tracks-all-heads: SortHead {
                                    width: root.num-w + 16px;
                                    text: head.label;
                                    key: head.key;
                                    align: TextHorizontalAlignment.right;
                                }
                                Text {
                                    width: root.num-w;
                                    text: "Area px";
                                    font-size: Ink.fs-secondary;
                                    font-weight: 600;
                                    color: Ink.text-dim;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Area over time";
                                    font-size: Ink.fs-secondary;
                                    font-weight: 600;
                                    color: Ink.text-dim;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Ink.border-soft;
                            }
                        }

                        // The rows in view: their area curves are read (an
                        // image's tracks at a time).
                        property <int> first-shown: max(0, floor(-list.content-y / root.row-h));
                        property <int> last-shown: self.first-shown + ceil(list.visible-height / root.row-h);
                        property <int> rows: ResultsState.tracks-all-rows.length;
                        changed first-shown => {
                            ResultsState.tracks-all-rows-shown(self.first-shown, self.last-shown);
                        }
                        changed rows => {
                            ResultsState.tracks-all-rows-shown(self.first-shown, self.last-shown);
                        }

                        list := ListView {
                            vertical-stretch: 1;
                            accessible-label: "Tracks";
                            for track[index] in ResultsState.tracks-all-rows: Rectangle {
                                height: root.row-h;
                                background: index == ResultsState.tracks-all-selected ? Ink.selection-row : row-ta.has-hover ? Ink.hover : transparent;
                                accessible-role: list-item;
                                accessible-label: "Track " + track.id + ", " + track.class-name + ", " + track.image;
                                accessible-item-selected: index == ResultsState.tracks-all-selected;
                                accessible-action-default => {
                                    ResultsState.tracks-all-row-clicked(index);
                                }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    HorizontalLayout {
                                        width: root.id-w;
                                        spacing: 6px;
                                        Rectangle {
                                            width: 8px;
                                            Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                background: track.color;
                                            }
                                        }
                                        Text {
                                            text: track.id;
                                            font-size: Ink.fs-body;
                                            font-family: Ink.font-mono;
                                            color: Ink.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    for cell in [
                                        { w: root.class-w, t: track.class-name, mono: false, right: false },
                                        { w: root.image-w, t: track.image, mono: true, right: false },
                                        { w: root.span-w, t: track.span + " (" + track.points + ")", mono: true, right: false },
                                    ]: Text {
                                        width: cell.w;
                                        text: cell.t;
                                        font-size: Ink.fs-body;
                                        font-family: cell.mono ? Ink.font-mono : Ink.font-sans;
                                        color: Ink.text;
                                        horizontal-alignment: cell.right ? right : left;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    for value in track.cells: Text {
                                        width: root.num-w + 16px;
                                        text: value;
                                        font-size: Ink.fs-body;
                                        font-family: Ink.font-mono;
                                        color: Ink.text;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        width: root.num-w;
                                        text: track.area;
                                        font-size: Ink.fs-body;
                                        font-family: Ink.font-mono;
                                        color: Ink.text;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        Path {
                                            x: 0;
                                            y: 6px;
                                            width: min(parent.width, 180px);
                                            height: parent.height - 12px;
                                            viewbox-width: 100;
                                            viewbox-height: 20;
                                            fit: fill;
                                            commands: track.curve;
                                            stroke: track.color;
                                            stroke-width: 1.4px;
                                        }
                                    }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: Ink.border-soft;
                                }
                                row-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        ResultsState.tracks-all-row-clicked(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // -- The selected track --
            Rectangle {
                width: 380px;
                background: Ink.panel;
                border-radius: Ink.radius-lg;
                border-width: 1px;
                border-color: Ink.border;
                clip: true;

                if !ResultsState.track-detail.active: Text {
                    width: parent.width - 40px;
                    text: "Click a track to see it here.";
                    font-size: Ink.fs-secondary;
                    color: Ink.text-dim;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if ResultsState.track-detail.active: VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Track " + ResultsState.track-detail.id;
                            font-size: Ink.fs-title;
                            font-weight: 700;
                            color: Ink.text;
                        }
                        Text {
                            text: ResultsState.track-detail.class-name + " · " + ResultsState.track-detail.image;
                            font-size: Ink.fs-secondary;
                            color: Ink.text-dim;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        Fact {
                            label: "Time points";
                            value: ResultsState.track-detail.span;
                        }
                        Fact {
                            label: "Moved";
                            value: ResultsState.track-detail.moved;
                        }
                        Fact {
                            label: "Speed";
                            value: ResultsState.track-detail.speed;
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        Fact {
                            label: "Straightness";
                            value: ResultsState.track-detail.straightness;
                        }
                        Fact {
                            label: "Max distance";
                            value: ResultsState.track-detail.max-distance;
                        }
                        Fact {
                            label: "MSD α";
                            value: ResultsState.track-detail.msd-alpha;
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        Fact {
                            label: "Turning";
                            value: ResultsState.track-detail.turning;
                        }
                    }
                    // How it moved, as Measure Track Motion measured it:
                    // its path from its start (drift taken away) and the
                    // MSD points α was fitted through.
                    if ResultsState.track-detail.path != "" || ResultsState.track-detail.msd != "": HorizontalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Path from its start";
                                font-size: Ink.fs-caption;
                                font-weight: 600;
                                color: Ink.text-dim;
                            }
                            path-box := Rectangle {
                                height: 120px;
                                border-width: 1px;
                                border-color: Ink.border-soft;
                                border-radius: 4px;
                                accessible-role: image;
                                accessible-label: "The track's path from its start";
                                // The start, in the middle.
                                Rectangle {
                                    x: parent.width / 2;
                                    width: 1px;
                                    background: Ink.border-soft;
                                }
                                Rectangle {
                                    y: parent.height / 2;
                                    height: 1px;
                                    background: Ink.border-soft;
                                }
                                Path {
                                    x: 4px;
                                    y: 4px;
                                    width: parent.width - 8px;
                                    height: parent.height - 8px;
                                    viewbox-width: 100;
                                    viewbox-height: 100;
                                    fit: contain;
                                    commands: ResultsState.track-detail.path != "" ? ResultsState.track-detail.path : "M 50 50";
                                    stroke: Ink.focus;
                                    stroke-width: 1.5px;
                                }
                                Text {
                                    x: 4px;
                                    y: parent.height - self.height - 2px;
                                    text: ResultsState.track-detail.path-scale;
                                    font-size: Ink.fs-caption;
                                    font-family: Ink.font-mono;
                                    color: Ink.text-dim;
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "MSD over lag (log–log)";
                                font-size: Ink.fs-caption;
                                font-weight: 600;
                                color: Ink.text-dim;
                            }
                            Rectangle {
                                height: 120px;
                                border-width: 1px;
                                border-color: Ink.border-soft;
                                border-radius: 4px;
                                accessible-role: image;
                                accessible-label: "Mean squared displacement over lag; " + ResultsState.track-detail.msd-label;
                                if ResultsState.track-detail.msd != "": Path {
                                    x: 4px;
                                    y: 4px;
                                    width: parent.width - 8px;
                                    height: parent.height - 8px;
                                    viewbox-width: 100;
                                    viewbox-height: 60;
                                    fit: fill;
                                    commands: ResultsState.track-detail.msd-ref;
                                    stroke: Ink.text-mute;
                                    stroke-width: 1px;
                                    opacity: 0.5;
                                }
                                if ResultsState.track-detail.msd != "": Path {
                                    x: 4px;
                                    y: 4px;
                                    width: parent.width - 8px;
                                    height: parent.height - 8px;
                                    viewbox-width: 100;
                                    viewbox-height: 60;
                                    fit: fill;
                                    commands: ResultsState.track-detail.msd;
                                    stroke: Ink.focus;
                                    stroke-width: 2px;
                                }
                                Text {
                                    x: 4px;
                                    y: 2px;
                                    text: ResultsState.track-detail.msd != "" ? ResultsState.track-detail.msd-label : "Too short for the MSD";
                                    font-size: Ink.fs-caption;
                                    font-family: Ink.font-mono;
                                    color: Ink.text-dim;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        vertical-stretch: 0;
                        Text {
                            text: "Area over time (px)";
                            font-size: Ink.fs-caption;
                            font-weight: 600;
                            color: Ink.text-dim;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            height: 120px;
                            VerticalLayout {
                                width: 40px;
                                Text {
                                    text: ResultsState.track-detail.area-max;
                                    font-size: Ink.fs-caption;
                                    font-family: Ink.font-mono;
                                    color: Ink.text-dim;
                                    horizontal-alignment: right;
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                }
                                Text {
                                    text: ResultsState.track-detail.area-min;
                                    font-size: Ink.fs-caption;
                                    font-family: Ink.font-mono;
                                    color: Ink.text-dim;
                                    horizontal-alignment: right;
                                }
                            }
                            Rectangle {
                                height: 120px;
                                border-width: 1px;
                                border-color: Ink.border-soft;
                                border-radius: 4px;
                                Path {
                                    x: 4px;
                                    y: 4px;
                                    width: parent.width - 8px;
                                    height: parent.height - 8px;
                                    viewbox-width: 100;
                                    viewbox-height: 40;
                                    fit: fill;
                                    commands: ResultsState.track-detail.curve;
                                    stroke: Ink.focus;
                                    stroke-width: 2px;
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 46px;
                            Text {
                                text: "T " + ResultsState.track-detail.t-first;
                                font-size: Ink.fs-caption;
                                font-family: Ink.font-mono;
                                color: Ink.text-dim;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "T " + ResultsState.track-detail.t-last;
                                font-size: Ink.fs-caption;
                                font-family: Ink.font-mono;
                                color: Ink.text-dim;
                            }
                        }
                    }
                    VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            for head in ["T", "X px", "Y px", "Area px"]: Text {
                                width: 70px;
                                text: head;
                                font-size: Ink.fs-caption;
                                font-weight: 600;
                                color: Ink.text-dim;
                            }
                        }
                        ListView {
                            vertical-stretch: 1;
                            accessible-label: "The track's time points";
                            for frame in ResultsState.track-frames: HorizontalLayout {
                                height: 22px;
                                spacing: 8px;
                                for value in [frame.t, frame.x, frame.y, frame.area]: Text {
                                    width: 70px;
                                    text: value;
                                    font-size: Ink.fs-secondary;
                                    font-family: Ink.font-mono;
                                    color: Ink.text;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        InkButton {
                            text: "Show in image";
                            kind: InkButtonKind.primary;
                            clicked => {
                                ResultsState.track-show-in-image();
                            }
                        }
                    }
                }
            }
        }
    }
}
