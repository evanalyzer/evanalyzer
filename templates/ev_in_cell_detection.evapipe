{
  "schemaVersion": 2,
  "meta": {
    "name": "EV in Cell",
    "shortDescription": "EV in cell detection",
    "description": "Detects extracellular vesicles inside cells using median background subtraction, blurring, Li thresholding and watershed splitting. The output object class can be remapped after import (default class id used during conversion: 1).",
    "authors": [
      "Melanie Schuerz"
    ],
    "authorOrganization": "University of Salzburg",
    "creationTime": "2026-06-11T00:00:00Z"
  },
  "pipelineSteps": [
    {
      "enabled": true,
      "command": {
        "type": "MEDIAN_SUBTRACT",
        "radius": 3.0
      }
    },
    {
      "enabled": true,
      "command": {
        "type": "BLUR",
        "kernelSize": 3
      }
    },
    {
      "enabled": true,
      "command": {
        "type": "THRESHOLD",
        "thresholds": [
          {
            "method": {
              "type": "LI"
            },
            "minThreshold": 0.0,
            "maxThreshold": 65535.0,
            "unit": "BIT",
            "objectClassId": 3
          }
        ]
      }
    },
    {
      "enabled": true,
      "command": {
        "type": "CONNECTED_COMPONENTS"
      }
    },
    {
      "enabled": true,
      "command": {
        "type": "WATERSHED",
        "maximumFinderTolerance": 0.5,
        "smoothingSigma": 0.0,
        "minObjectSize": 0
      }
    },
    {
      "enabled": true,
      "command": {
        "type": "EXTRACT_OBJECTS",
        "maxObjectsBeforeFail": 100000
      }
    },
    {
      "enabled": true,
      "command": {
        "type": "CLASSIFY_OBJECTS",
        "inputClasses": [
          {
            "VALID": 3
          }
        ],
        "matchHandling": "REMOVE_ALL_CLASSES_IF_NOT_MATCH",
        "originSegmentation": [],
        "outputClass": "UNSET",
        "overlappingWith": "UNSET",
        "minIntersectionArea": 0.0,
        "sizeUnit": "px",
        "minArea": 3,
        "maxArea": 2147483648.0,
        "minCircularity": 0.0,
        "maxCircularity": 1.0,
        "minSolidity": 0.0,
        "maxSolidity": 1.0,
        "minAspectRatio": 0.0,
        "maxAspectRatio": 2147483648,
        "minEccentricity": 0.0,
        "maxEccentricity": 1.0,
        "minFeret": 0.0,
        "maxFeret": 2147483648,
        "allowEdgeTouching": true
      }
    }
  ]
}