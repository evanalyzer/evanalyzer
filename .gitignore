/target
tests/fixtures/test_image_big_endian.lif
tests/fixtures/test_image_slide_scanner_rgb.vsi
backend/tests/muliple_z_stacks.nd2
lcov.info
/.claude
.claude
.claude/settings.json
.claude/settings.local.json
# Ignore the large prebuilt native deps in libs/, but keep the download scripts
# under version control (they fetch those deps - see libs/download.sh).
/libs/*
!/libs/.gitkeep
!/libs/*.sh
/crates/core/java
docs/old
docs/threshold
docs/blur
docs/rolling_ball
docs/watershed

# Bio-Formats Memoizer cache files, written next to whatever image was
# opened (including test fixtures under crates/core/tests/).
*.bfmemo

# `cargo cyclonedx` (see README's "SBOM" section) writes one *.cdx.json next
# to each crate's Cargo.toml by default - a local run easily leaves these
# scattered through crates/. The release SBOM is generated by CI into a
# separate versioned file and uploaded as a release asset, never committed.
*.cdx.json

# CI-only intermediate (ci.yml's coverage job) - the committed artifact is
# docs/coverage-badge.svg, not this.
/coverage-summary.txt

# release.yml's local packaging output, if the release steps are ever run
# outside CI (see README's "Building" section).
/dist/
/evanalyzer-*.tar.gz
/evanalyzer-*.zip
/evanalyzer-*.7z.*