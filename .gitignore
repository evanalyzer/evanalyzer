/target
tests/fixtures/test_image_big_endian.lif
tests/fixtures/test_image_slide_scanner_rgb.vsi
lcov.info
/.claude
.claude
.claude/settings.json
.claude/settings.local.json
# Ignore the large prebuilt native deps in libs/, but keep the download scripts
# under version control (they fetch those deps - see libs/download.sh).
/libs/*
!/libs/.gitkeep
!/libs/*.sh

# `cargo cyclonedx` (see README's "Development Setup") writes one *.cdx.json next
# to each crate's Cargo.toml by default - a local run easily leaves these
# scattered through crates/. The release SBOM is generated by CI into a
# separate versioned file and uploaded as a release asset, never committed.
*.cdx.json

# CI-only intermediate (ci.yml's coverage job) - the committed artifact is
# docs/coverage-badge.svg, not this.
/coverage-summary.txt

# release.yml's local packaging output, if the release steps are ever run
# outside CI (see README's "Building").
/dist/
/evanalyzer-*.tar.gz
/evanalyzer-*.zip
/evanalyzer-*.7z.*
tests/G7_03.vsi
tests/_G7_03_/stack1/frame_t_0.ets
tests/IPOD detection test.nd2
tests/performance-check/
tests/20260831_Uptake1_Exp0706_PH1.evadb
# Synthetic time series (crates/core/examples/make_time_series.rs, ~1.3GB)
tests/timeseries_96img_48t_tracked.evadb

# Real Cellpose-SAM TorchScript export (~1.2GB) used by
# crates/core/tests/cellpose_sam_real_model.rs - too large to commit.
# Regenerate locally with docs/convert_cellpose.py.
crates/core/tests/models/
tests/__pycache__
# Written by job_executor's pipeline test.
crates/core/tests/project_test/output/
# Large real slide data, local only.
tests/haut/
CLAUDE.local.md
# Java Bio-Formats memoizer caches (e.g. from Fiji/QuPath)
*.bfmemo
