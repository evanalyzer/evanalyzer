{{! Template for cargo-about: the regenerate command is in about.toml. }}
{{! Emits a compact JSON array of distinct license texts, each with the }}
{{! crates that use it - much smaller than `--format json`, which repeats }}
{{! the full dependency graph for every crate. Read by }}
{{! crates/gui/src/third_party_licenses.rs (the About dialog). }}
[
{{#each licenses}}
  {
    "id": {{json this.id}},
    "name": {{json this.name}},
    "text": {{json this.text}},
    "crates": [
      {{#each this.used_by}}
        { "name": {{json this.crate.name}}, "version": {{json this.crate.version}} }{{#unless @last}},{{/unless}}
      {{/each}}
    ]
  }{{#unless @last}},{{/unless}}
{{/each}}
]
